module

public import LeanCategories.Lattices.Valued.LatticeCone

/-!
# The Weyl group of a lattice of signature `(1, n)`: `W(M) ≤ O⁺(M)` and `W(M) ⊴ O(M)`

For an integral lattice `M` of signature `(1, n)`, the reflection group `W(M)` — the subgroup of
`O(M)` generated by the reflections in the reflective roots of `M` of negative square (the grade
`Rt_r`, `r < 0`, of the root set: the even-lattice Weyl group of `PositiveConeReflections`) —
lies in `O⁺(M)` (`weylSubgroup_le_latticePositiveConeStabilizer`) and is normal in `O(M)`
(`weylSubgroup_normal`).

Both statements are pulled back from the real form along `realFormOrthogonalHom : O(M) →
O(M ⊗ ℝ)`. The pullback rests on the square `realFormOrthogonalHom_latticeReflection`: the
scalar extension of the lattice reflection in a root `a` is the real reflection in the image
vector `1 ⊗ a`. The square is proved on pure tensors — base change commutes with
`Module.reflection` — the coroot identity `LinearMap.IsReflective.apply_self_mul_coroot_apply`
supplying the coefficient. Normality additionally uses that `realFormOrthogonalHom` is injective
(`realFormOrthogonalHom_injective`: an isometry of the lattice is determined by its scalar
extension), which reduces the lattice conjugation `g r_a g⁻¹ = r_{g a}` to Mathlib's
`conj_reflectIn` on the real form.

## The sign hypothesis is not removable

`W(M) ≤ O⁺(M)` fails for the group generated by the reflections in *all* reflective roots: in
the hyperbolic plane `U`, the vector `e + f` has square `2`, is reflective (the form is integral,
so its square divides `2 b(e + f, x)` for every `x`), and its reflection swaps the two sheets of
the positive cone, so it lies in `O(U)` and not in `O⁺(U)`; see `PositiveConeReflections` for the
real-form statement of this failure. The generators of `W(M)` are therefore the reflective roots
of negative square. An isometry `g` preserves the square of a root, `g a` is reflective when `a`
is (`isReflectiveRoot_of_isometry`), so the generating set is stable under conjugation — which
is the normality statement.

## References

* V. V. Nikulin, *Integral symmetric bilinear forms and some of their applications*, Izv. Akad.
  Nauk SSSR Ser. Mat. 43 (1979), §1.
* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 27.
-/

@[expose] public section

open QuadraticMap
open LeanCategories.Modules.Bilinear.Valued
open RootPairing

namespace LeanCategories.Lattices.Valued

variable (L : FiniteProjectiveLatticeCat ℤ ℤ)

/-- The image of a lattice vector in the real form: `1 ⊗ a`. -/
noncomputable def toRealForm (L : FiniteProjectiveLatticeCat ℤ ℤ) (a : L.obj.obj.carrier) :
    (realForm L).obj.carrier := (1 : ℝ) ⊗ₜ[ℤ] a

/-- **The lattice reflection in a reflective root**, as an element of the orthogonal group:
the image, under `reflectiveWeylOrthogonalHom`, of the Weyl-group reflection in the root. -/
noncomputable def latticeReflection
    (hL : L.obj.obj.IsNondegenerate) (h2 : IsRegular (2 : ℤ))
    {a : L.obj.obj.carrier} (ha : IsReflectiveRoot L.obj a) :
    OrthogonalGroup L.obj :=
  reflectiveWeylOrthogonalHom L hL h2
    ⟨RootPairing.Equiv.reflection (reflectiveRootPairing L hL h2) ⟨a, ha⟩,
      (reflectiveRootPairing L hL h2).reflection_mem_weylGroup ⟨a, ha⟩⟩

section RealFormValues

/-- The real form's pairing on images of lattice vectors is the image of the lattice pairing. -/
theorem realFormPairing_toRealForm (u v : L.obj.obj.carrier) :
    (realForm L).obj.pairing (toRealForm L u) (toRealForm L v)
      = (L.obj.obj.pairing u v : ℝ) := by
  change baseChangeIntegralBilinMap ℤ ℝ L.obj ((1 : ℝ) ⊗ₜ[ℤ] u)
      ((1 : ℝ) ⊗ₜ[ℤ] v) = _
  rw [baseChangeIntegralBilinMap_tmul]
  norm_num

/-- The square of the image is the image of the square: the real form of `1 ⊗ a` is the integer
square of `a`, viewed in `ℝ`. -/
theorem realFormQuadratic_toRealForm (a : L.obj.obj.carrier) :
    realFormQuadratic L (toRealForm L a) = (L.obj.obj.pairing a a : ℝ) := by
  rw [realFormQuadratic_apply, realFormPairing_toRealForm]

/-- The associated pairing of the real form on a pure tensor, against the image of a lattice
vector. -/
theorem associated_realFormQuadratic_tmul (r : ℝ) (x a : L.obj.obj.carrier) :
    (associated (realFormQuadratic L)) (r ⊗ₜ[ℤ] x) (toRealForm L a)
      = r * (L.obj.obj.pairing x a : ℝ) := by
  have hsymm : ∀ u v, (realForm L).obj.bilinMap u v = (realForm L).obj.bilinMap v u :=
    fun u v => (realForm L).property.2 u v
  have hassoc : (associated (realFormQuadratic L)) = (realForm L).obj.bilinMap :=
    QuadraticMap.associated_left_inverse (S := ℝ) hsymm
  rw [hassoc]
  change baseChangeIntegralBilinMap ℤ ℝ L.obj (r ⊗ₜ[ℤ] x) ((1 : ℝ) ⊗ₜ[ℤ] a) = _
  rw [baseChangeIntegralBilinMap_tmul]
  norm_num

end RealFormValues

section Square

/-- **The square**: the image of the lattice reflection under `realFormOrthogonalHom` is the
real reflection in the image vector `1 ⊗ a`. -/
theorem realFormOrthogonalHom_latticeReflection
    (hL : L.obj.obj.IsNondegenerate) (h2 : IsRegular (2 : ℤ))
    {a : L.obj.obj.carrier} (ha : IsReflectiveRoot L.obj a)
    (ha' : realFormQuadratic L (toRealForm L a) ≠ 0) :
    realFormOrthogonalHom L (latticeReflection L hL h2 ha) =
      reflectIn (realFormQuadratic L) (toRealForm L a) ha' := by
  apply isometryEquiv_ext
  let rhs : TensorProduct ℤ ℝ L.obj.obj.carrier ≃ₗ[ℝ]
      TensorProduct ℤ ℝ L.obj.obj.carrier :=
    (reflectIn (realFormQuadratic L) (toRealForm L a) ha').toLinearEquiv
  refine (show (latticeReflection L hL h2 ha).1.baseChange ℤ ℝ L.obj.obj.carrier
      L.obj.obj.carrier = rhs from ?_)
  refine LinearEquiv.ext fun z => ?_
  induction z using TensorProduct.induction_on with
  | zero => simp
  | add z₁ z₂ h₁ h₂ =>
      rw [map_add, map_add, h₁, h₂]
  | tmul r x =>
      have hact : (latticeReflection L hL h2 ha).1 x
          = (reflectiveRootPairing L hL h2).reflection ⟨a, ha⟩ x := by
        have h1 : (latticeReflection L hL h2 ha).1 x
            = (RootPairing.Equiv.reflection (reflectiveRootPairing L hL h2) ⟨a, ha⟩) • x :=
          rfl
        rw [h1, RootPairing.Equiv.reflection_smul]
      have hcor : (reflectiveRootPairing L hL h2).coroot' ⟨a, ha⟩ x
          = LinearMap.IsReflective.coroot L.obj.obj.bilinMap ha x := rfl
      have hne : (L.obj.obj.pairing a a : ℝ) ≠ 0 := by
        rw [← realFormQuadratic_toRealForm L a]; exact ha'
      have hc2' : (L.obj.obj.pairing a a : ℝ) * ((reflectiveRootPairing L hL h2).coroot'
          ⟨a, ha⟩ x : ℝ) = 2 * (L.obj.obj.pairing a x : ℝ) := by
        rw [hcor]
        have h := LinearMap.IsReflective.apply_self_mul_coroot_apply
          (B := L.obj.obj.bilinMap) (hx := ha) (y := x)
        rw [BilinModuleCat.bilinMap_apply L.obj.obj,
          BilinModuleCat.bilinMap_apply L.obj.obj] at h
        exact_mod_cast h
      have rhs_tmul : ∀ w : ↑(realForm L).obj.carrier,
          rhs w = w - (2 * (associated (realFormQuadratic L)) w (toRealForm L a) /
            realFormQuadratic L (toRealForm L a)) • (toRealForm L a) :=
        fun w => reflectIn_apply (realFormQuadratic L) ha' w
      rw [LinearEquiv.baseChange_tmul, hact, RootPairing.reflection_apply,
        TensorProduct.tmul_sub, TensorProduct.tmul_smul]
      refine Eq.trans ?_ (rhs_tmul (r ⊗ₜ[ℤ] x)).symm
      rw [associated_realFormQuadratic_tmul, realFormQuadratic_toRealForm]
      simp only [toRealForm]
      rw [TensorProduct.smul_tmul',
        show (reflectiveRootPairing L hL h2).root ⟨a, ha⟩ = a from rfl]
      congr 1
      congr 1
      simp only [zsmul_eq_mul, smul_eq_mul, mul_one]
      rw [L.obj.property.2 x a]
      rw [eq_div_iff hne]
      linear_combination hc2' * r

end Square

section Isometry

/-- A lattice isometry preserves the lattice pairing. -/
theorem isometry_pairing (g : OrthogonalGroup L.obj) (x y : L.obj.obj.carrier) :
    L.obj.obj.pairing (g.1 x) (g.1 y) = L.obj.obj.pairing x y :=
  g.property x y

/-- A lattice isometry carries reflective roots to reflective roots: reflectivity is a
statement about the form, and `g` preserves the form. -/
theorem isReflectiveRoot_of_isometry (g : OrthogonalGroup L.obj)
    {a : L.obj.obj.carrier} (ha : IsReflectiveRoot L.obj a) :
    IsReflectiveRoot L.obj (g.1 a) := by
  refine ⟨?_, ?_⟩
  · have h : L.obj.obj.bilinMap (g.1 a) (g.1 a) = L.obj.obj.bilinMap a a :=
      isometry_pairing L g a a
    rw [h]
    exact ha.1
  · intro y
    obtain ⟨u, rfl⟩ := (g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).surjective y
    have h : L.obj.obj.bilinMap (g.1 a) (g.1 a) = L.obj.obj.bilinMap a a :=
      isometry_pairing L g a a
    rw [h, BilinModuleCat.bilinMap_apply L.obj.obj,
      BilinModuleCat.bilinMap_apply L.obj.obj, isometry_pairing L g a u]
    exact ha.2 u

end Isometry

section Injective

/-- The scalar extension of an isometry carries the image of a lattice vector to the image of
the vector. -/
theorem realFormOrthogonalHom_toRealForm (g : OrthogonalGroup L.obj)
    (a : L.obj.obj.carrier) :
    realFormOrthogonalHom L g (toRealForm L a) = toRealForm L (g.1 a) := rfl

/-- An isometry of the lattice is determined by its scalar extension: the real-form
homomorphism is injective. -/
theorem realFormOrthogonalHom_injective (hL : L.obj.obj.IsNondegenerate) :
    Function.Injective (realFormOrthogonalHom L) := by
  intro g h heq
  have hfun : ∀ z, realFormOrthogonalHom L g z = realFormOrthogonalHom L h z :=
    fun z => DFunLike.congr_fun heq z
  have htens : ∀ x, toRealForm L (g.1 x) = toRealForm L (h.1 x) := by
    intro x
    rw [← realFormOrthogonalHom_toRealForm L g x, ← realFormOrthogonalHom_toRealForm L h x,
      hfun]
  refine Subtype.ext (LinearEquiv.ext fun x => ?_)
  have hzero : ∀ y, L.obj.obj.bilinMap (g.1 x - h.1 x) y = 0 := by
    intro y
    rw [map_sub, LinearMap.sub_apply, BilinModuleCat.bilinMap_apply,
      BilinModuleCat.bilinMap_apply]
    have h1 := realFormPairing_toRealForm L (g.1 x) y
    have h2 := realFormPairing_toRealForm L (h.1 x) y
    rw [htens x, h2] at h1
    rw [Int.cast_injective h1]
    simp
  exact sub_eq_zero.mp (hL.1 _ hzero)

end Injective

section Conjugation

/-- **Conjugating a lattice reflection by an isometry gives the lattice reflection in the image
root**: the lattice form of `conj_reflectIn`. -/
theorem conj_latticeReflection
    (hL : L.obj.obj.IsNondegenerate) (h2 : IsRegular (2 : ℤ))
    (g : OrthogonalGroup L.obj) {a : L.obj.obj.carrier} (ha : IsReflectiveRoot L.obj a)
    (ha' : realFormQuadratic L (toRealForm L a) ≠ 0) :
    g * latticeReflection L hL h2 ha * g⁻¹ =
      latticeReflection L hL h2 (isReflectiveRoot_of_isometry L g ha) := by
  apply realFormOrthogonalHom_injective L hL
  have hga' : realFormQuadratic L (toRealForm L (g.1 a)) ≠ 0 := by
    rw [← realFormOrthogonalHom_toRealForm L g a, QuadraticMap.IsometryEquiv.map_app]
    exact ha'
  rw [map_mul, map_mul, map_inv]
  rw [realFormOrthogonalHom_latticeReflection L hL h2 ha ha']
  rw [realFormOrthogonalHom_latticeReflection L hL h2
    (isReflectiveRoot_of_isometry L g ha) hga']
  exact conj_reflectIn (realFormQuadratic L) ha'

end Conjugation

section WeylGroup

/-- The reflections in the reflective roots of negative square, as a set of lattice
isometries. -/
def weylGenerators (hL : L.obj.obj.IsNondegenerate) (h2 : IsRegular (2 : ℤ)) :
    Set (OrthogonalGroup L.obj) :=
  {g | ∃ a, ∃ ha : IsReflectiveRoot L.obj a, L.obj.obj.pairing a a < 0 ∧
    latticeReflection L hL h2 ha = g}

/-- **`W(M)`**: the reflection group of the lattice — the subgroup of `O(M)` generated by the
reflections in its reflective roots of negative square (the grade `Rt_r`, `r < 0`, of the root
set, the even-lattice Weyl group). -/
noncomputable def weylSubgroup (hL : L.obj.obj.IsNondegenerate) (h2 : IsRegular (2 : ℤ)) :
    Subgroup (OrthogonalGroup L.obj) :=
  Subgroup.closure (weylGenerators L hL h2)

/-- **`W(M) ≤ O⁺(M)`**: every reflection in a reflective root of negative square preserves
each sheet of the positive cone, and so does the group it generates. -/
theorem weylSubgroup_le_latticePositiveConeStabilizer
    (hL : L.obj.obj.IsNondegenerate) (h2 : IsRegular (2 : ℤ))
    (hpos : (integralSignature L).1 = 1) {t : (realForm L).obj.carrier}
    (ht : 0 < realFormQuadratic L t) :
    weylSubgroup L hL h2 ≤ latticePositiveConeStabilizer L hpos t ht := by
  intro w hw
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨a, ha, hn, rfl⟩ := hx
      have hn' : realFormQuadratic L (toRealForm L a) < 0 := by
        rw [realFormQuadratic_toRealForm]
        exact_mod_cast hn
      rw [mem_latticePositiveConeStabilizer_iff]
      rw [realFormOrthogonalHom_latticeReflection L hL h2 ha (ne_of_lt hn')]
      exact reflectIn_mem_positiveConeStabilizer (realFormQuadratic L) hpos ht hn'
  | one => exact one_mem _
  | mul x y hx hy ihx ihy => exact mul_mem ihx ihy
  | inv x hx ih => exact inv_mem ih

/-- **`W(M) ⊴ O(M)`**: the reflection group is normal in the orthogonal group, because
conjugating the reflection in a root by an isometry `g` gives the reflection in `g a`, which is
again a reflective root of negative square. -/
theorem weylSubgroup_normal (hL : L.obj.obj.IsNondegenerate) (h2 : IsRegular (2 : ℤ)) :
    (weylSubgroup L hL h2).Normal := by
  refine ⟨?_⟩
  intro w hw g
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨a, ha, hn, rfl⟩ := hx
      have hn' : realFormQuadratic L (toRealForm L a) < 0 := by
        rw [realFormQuadratic_toRealForm]
        exact_mod_cast hn
      rw [conj_latticeReflection L hL h2 g ha (ne_of_lt hn')]
      refine Subgroup.subset_closure ⟨g.1 a, isReflectiveRoot_of_isometry L g ha, ?_, rfl⟩
      rw [isometry_pairing L g a a]
      exact hn
  | one => simp
  | mul x y hx hy ihx ihy =>
      rw [show g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) by group]
      exact mul_mem ihx ihy
  | inv x hx ih =>
      rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
      exact inv_mem ih

end WeylGroup

end LeanCategories.Lattices.Valued
