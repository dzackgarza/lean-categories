module

public import LeanCategories.Lattices.Valued.CuspSchreierImage
public import LeanCategories.Lattices.Valued.DiscriminantFunctor
public import LeanCategories.ForMathlib.SchreierStabilizer

/-!
# The ambient group's Schreier discriminant image (#88)

The descent page's `thm:schreier-discriminant-image` is stated for an ambient group `G ≤ O(V)` of
isometries of the rational space `V = ℚ ⊗ L` that need not preserve the lattice `L`: the generating
letters `s` and the transversal words `t_p` move `L` among the integral lattices of its orbit, and
only the *completed loop* `k_{s,p} = t_{sp}⁻¹ s t_p` restricts to a self-isometry of `L`.
`CuspSchreierImage.discriminantRangeImage_eq_closure_schreier` is the generic
`MonoidHom.map_closure` statement for an abstract action of `O(L)`; replacing the ambient `G` by
`O(L)` there would collapse the orbit to `O(L) · L`, so this file supplies the ambient inputs the
source actually uses.

## The data

`AmbientResidueData` carries the source's `def:stabilizer-congruence-data` module contract: a
subgroup `G` of the isometries of the rational span `V`, a finitely generated full `G`-invariant
`R`-submodule `M ≤ V` containing `L`, and a modulus `m ≠ 0` with `mM ⊆ L`. `M` need not be integral
and need not lie in `L^♯` (`ex:non-integral-invariant-module`), and no refined modulus `mM ⊆ e₂L`
and no congruence-kernel hypothesis is assumed: those belong to the alternative congruence
construction of the page. `G` is taken `R`-linear; every subgroup of the `Frac R`-linear isometries
is one, so this is a weakening of the source's hypothesis, and `R`-linearity is exactly what the
residue argument uses.

## The two lattice lemmas, without covolumes

`lem:orbit-reduction-injective` and `lem:congruence-stabilizer-preimage` are proved from the
quotient correspondence rather than from covolumes: `gM = M` gives `g(mM) = mM`, so every translate
`gL` of the orbit contains `mM`, and equality of the images in `V ⧸ mM` is then equality of
submodules (`residue_eq_of_sup_eq`). The residue `residue Λ = Λ + mM` is the preimage in `V` of the
class `Λ̄_m = Λ/mM` of `M/mM`, so the statements are the source's.

## The image

`discriminantRangeImage_eq_closure_residueSchreier` is the source's theorem: with `S` generating `G`
and `t` a transversal of the orbit `Σ_m` of the residue class of `L`, the discriminant image of the
integral stabilizer is generated by the `ρ_L` of the Schreier loops. Each loop fixes the residue
class of `L`, hence restricts to an integral self-isometry of `L` (`residueStabilizerHom`), which is
where `lem:congruence-stabilizer-preimage` is used: the stabilizer of the residue class is proved to
be the stabilizer of `L`, not assumed. The loop family is the source's letter-by-orbit family
`|S| · |Σ_m|`, and the generated subgroup is not assumed to be the stabilizer's image.

## The orbit lattices

The second half of the file supplies `thm:discriminant-transport-functor`: the translates `gL` are
integral lattice objects (`orbitLattice`) with form and projectivity transported from `L`, the
ambient isometries act between them (`orbitTransportIso`) and the action is functorial
(`orbitTransportEquiv_comp`). The three-factor factorization of the completed loop through those
maps is not proved here; the section header records exactly what it still needs.
-/

@[expose] public section

open CategoryTheory
open MulAction
open scoped Pointwise
open LeanCategories.Modules.Bilinear.Valued

namespace LeanCategories.Lattices.Valued

universe u

variable {R : Type u} [CommRing R] [IsDomain R]
variable {L : IntegralLatticeCat R}

/-! ## The rational span as an ambient space -/

omit [IsDomain R] in
/-- The rationalized form on the integral image is the pairing, scalarly extended. -/
theorem rationalizedForm_toRationalSpan (L : IntegralLatticeCat R)
    (x y : L.obj.carrier) :
    rationalizedForm R L (toRationalSpan R L x) (toRationalSpan R L y) =
      algebraMap R (FractionRing R) (L.obj.pairing x y) := by
  have h := rationalizedForm_tmul (R := R) (L := L) (1 : FractionRing R) (1 : FractionRing R) x y
  simpa [toRationalSpan] using h

/-- **The isometry group of the rational span** of `L`: the ambient group `O(V)` of the descent
page, written as `R`-linear automorphisms of `V = ℚ ⊗ L` preserving the rationalized form. Its
elements need not preserve `L`. -/
def AmbientOrthogonalGroup (L : IntegralLatticeCat R) :
    Subgroup (RationalSpan R L ≃ₗ[R] RationalSpan R L) where
  carrier := {g | ∀ x y, rationalizedForm R L (g x) (g y) = rationalizedForm R L x y}
  one_mem' := by
    intro x y
    simp
  mul_mem' := by
    intro f g hf hg x y
    simp only [mul_apply_eq_comp]
    exact (hf (g x) (g y)).trans (hg x y)
  inv_mem' := by
    intro f hf x y
    have h := hf (f⁻¹ x) (f⁻¹ y)
    simpa using h.symm

/-- **The translate of the integral image** by an ambient isometry: the lattice `gL` of the orbit,
as a submodule of the rational span. -/
noncomputable def ambientTranslate (L : IntegralLatticeCat R)
    (g : AmbientOrthogonalGroup L) : Submodule R (RationalSpan R L) :=
  (integralImage R L).map (g.1 : RationalSpan R L →ₗ[R] RationalSpan R L)

omit [IsDomain R] in
/-- The action of the ambient group on submodules is transport along the isometry. -/
theorem smul_submodule_eq_map (g : AmbientOrthogonalGroup L)
    (P : Submodule R (RationalSpan R L)) :
    g • P = P.map (g.1 : RationalSpan R L →ₗ[R] RationalSpan R L) := rfl

omit [IsDomain R] in
theorem ambientTranslate_eq_smul (g : AmbientOrthogonalGroup L) :
    ambientTranslate L g = g • integralImage R L := rfl

/-! ## The commensurability data -/

/-- **The source's `def:stabilizer-congruence-data`.** A subgroup `G` of the isometries of the
rational span `V = ℚ ⊗ L`, a finitely generated full `G`-invariant `R`-submodule `M ≤ V` containing
`L`, and a modulus `m ≠ 0` with `mM ⊆ L`.

The form need not be integral on `M` and `M` need not lie in `L^♯`; there is no hypothesis
`mM ⊆ e₂L` and no congruence-kernel hypothesis. `finite` and `full` are part of the source's
commensurability contract and are not consumed below: integrality of the translates is
form-theoretic, since the ambient isometries preserve the rationalized form. -/
structure AmbientResidueData (R : Type u) [CommRing R] [IsDomain R]
    (L : IntegralLatticeCat R) where
  /-- The invariant module `M`. -/
  M : Submodule R (RationalSpan R L)
  /-- `M` is finitely generated. -/
  finite : Module.Finite R ↥M
  /-- `M` is full: it spans the rational span over the fraction field. -/
  full : Submodule.span (FractionRing R) (M : Set (RationalSpan R L)) = ⊤
  /-- `L ⊆ M`. -/
  le : integralImage R L ≤ M
  /-- The modulus. -/
  m : R
  /-- The modulus is nonzero. -/
  hm : m ≠ 0
  /-- `mM ⊆ L`. -/
  mMle : M.map (LinearMap.lsmul R (RationalSpan R L) m) ≤ integralImage R L
  /-- The ambient group. -/
  G : Subgroup (AmbientOrthogonalGroup L)
  /-- `G` preserves `M`. -/
  preserves : ∀ g ∈ G, M.map (g.1 : RationalSpan R L →ₗ[R] RationalSpan R L) = M

namespace AmbientResidueData

variable (D : AmbientResidueData R L)

/-- **The submodule `mM`.** -/
noncomputable def mM : Submodule R (RationalSpan R L) :=
  D.M.map (LinearMap.lsmul R (RationalSpan R L) D.m)

theorem mM_le_integralImage : D.mM ≤ integralImage R L := D.mMle

/-- **The residue class** of a submodule modulo `mM`, as the preimage in `V` of its class in
`V ⧸ mM`. For a lattice `Λ` of the orbit `mM ≤ Λ`, so `residue Λ = Λ`; the residue is what the
quotient retains, and `residue_eq_of_sup_eq` shows it retains everything on the orbit. -/
noncomputable def residue (Λ : Submodule R (RationalSpan R L)) :
    Submodule R (RationalSpan R L) :=
  Λ ⊔ D.mM

/-- The action of `G` on submodules is transport by the ambient isometry. -/
theorem smul_eq_map (g : ↥D.G) (P : Submodule R (RationalSpan R L)) :
    g • P = P.map ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) := rfl

/-- **`G` preserves `mM`.** -/
theorem mM_map (g : ↥D.G) :
    D.mM.map ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) = D.mM := by
  have hcomp : (D.M.map (LinearMap.lsmul R (RationalSpan R L) D.m)).map
        ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) =
      D.M.map (((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) ∘ₗ
        LinearMap.lsmul R (RationalSpan R L) D.m) := by
    rw [Submodule.map_comp]
  have hfg : ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) ∘ₗ
        LinearMap.lsmul R (RationalSpan R L) D.m =
      LinearMap.lsmul R (RationalSpan R L) D.m ∘ₗ
        ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) := by
    ext x
    simp
  have hmM : D.mM = D.M.map (LinearMap.lsmul R (RationalSpan R L) D.m) := rfl
  rw [hmM, hcomp, hfg, Submodule.map_comp, D.preserves g.1 g.2]

/-- **Every translate of the orbit contains `mM`.** `gM = M` gives `g(mM) = mM`, and `mM ⊆ L`, so
`mM = g(mM) ⊆ gL`. -/
theorem mM_le_translate (g : ↥D.G) : D.mM ≤ ambientTranslate L g.1 := by
  have h : D.mM = D.mM.map ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) :=
    (D.mM_map g).symm
  rw [h]
  exact Submodule.map_mono D.mM_le_integralImage

/-- **Every translate of the orbit lies in `M`.** -/
theorem translate_le_M (g : ↥D.G) : ambientTranslate L g.1 ≤ D.M := by
  rw [ambientTranslate, ← D.preserves g.1 g.2]
  exact Submodule.map_mono D.le

/-- **A translate is a translate of a translate.** `L_{gh} = g L_h`. -/
theorem translate_mul (g h : ↥D.G) :
    ambientTranslate L ((g * h).1) =
      (ambientTranslate L h.1).map ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) := by
  have hcomp : (((g * h).1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) =
      ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) ∘ₗ
        ((h.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) := by
    ext x
    rfl
  rw [ambientTranslate, ambientTranslate, hcomp, Submodule.map_comp]

/-- **`lem:orbit-reduction-injective`.** Reduction modulo `mM` is injective on the lattices that
contain `mM`: no covolume argument is needed, only `Λ + mM = Λ` for such `Λ`. -/
theorem residue_eq_of_sup_eq {Λ₁ Λ₂ : Submodule R (RationalSpan R L)}
    (h₁ : D.mM ≤ Λ₁) (h₂ : D.mM ≤ Λ₂) (h : D.residue Λ₁ = D.residue Λ₂) : Λ₁ = Λ₂ := by
  simpa [residue, sup_eq_left.mpr h₁, sup_eq_left.mpr h₂] using h

/-- The residue of a submodule is its class in `V ⧸ mM`: the `V`-level residue retains exactly the
class of `Λ`, so it is the source's `Λ̄_m = Λ/mM`. -/
theorem residue_map_mkQ (Λ : Submodule R (RationalSpan R L)) :
    (D.residue Λ).map (Submodule.mkQ D.mM) = Λ.map (Submodule.mkQ D.mM) := by
  rw [residue, Submodule.map_sup, Submodule.mkQ_map_self, sup_bot_eq]

/-! ## The Schreier orbit of the residue class -/

/-- **The orbit `Σ_m`** of the residue class of `L`: the set of residue submodules that are
`G`-translates of the class of `L`, the Schreier orbit of the descent page. -/
noncomputable abbrev residueOrbit : Set (Submodule R (RationalSpan R L)) :=
  MulAction.orbit ↥D.G (D.residue (integralImage R L))

/-- A point of the residue orbit. -/
abbrev ResiduePoint := ↥(D.residueOrbit)

/-- `G` acts on the residue orbit. -/
noncomputable instance instMulActionResiduePoint : MulAction ↥D.G D.ResiduePoint where
  smul g q := ⟨g • (q : Submodule R (RationalSpan R L)), by
    obtain ⟨h, hh⟩ := MulAction.mem_orbit_iff.mp q.2
    exact MulAction.mem_orbit_iff.mpr ⟨g * h, by rw [mul_smul, hh]⟩⟩
  one_smul q := Subtype.ext (one_smul _ (q : Submodule R (RationalSpan R L)))
  mul_smul g h q := Subtype.ext (mul_smul g h (q : Submodule R (RationalSpan R L)))

/-- The action on a residue point is the action on its residue submodule. -/
@[simp] theorem residuePoint_coe_smul (g : ↥D.G) (q : D.ResiduePoint) :
    ((g • q : D.ResiduePoint) : Submodule R (RationalSpan R L)) =
      g • (q : Submodule R (RationalSpan R L)) := rfl

/-- The base point of the residue orbit: the class of `L`. -/
noncomputable def baseResidue : D.ResiduePoint :=
  ⟨D.residue (integralImage R L), MulAction.mem_orbit_self _⟩

@[simp] theorem baseResidue_coe : (D.baseResidue : Submodule R (RationalSpan R L)) =
    D.residue (integralImage R L) := rfl

/-- **The stabilizer of the residue class of `L`** inside `G`. -/
noncomputable abbrev residueStabilizer : Subgroup ↥D.G :=
  MulAction.stabilizer ↥D.G D.baseResidue

theorem smul_base_coe (g : ↥D.G) :
    ((g • D.baseResidue : D.ResiduePoint) : Submodule R (RationalSpan R L)) =
      (D.residue (integralImage R L)).map
        ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) := by
  rw [residuePoint_coe_smul, baseResidue_coe, D.smul_eq_map]

/-- The residue of the translate by `g` is the image of the residue class of `L`. -/
theorem residue_translate_eq_map (g : ↥D.G) :
    D.residue (ambientTranslate L g.1) =
      (D.residue (integralImage R L)).map
        ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) := by
  change ambientTranslate L g.1 ⊔ D.mM = _
  rw [residue, ambientTranslate, Submodule.map_sup, D.mM_map g]

/-- **`lem:congruence-stabilizer-preimage`.** An ambient element of `G` stabilizes the lattice `L`
exactly when it stabilizes the residue class of `L`. The forward direction is immediate; the
converse is `lem:orbit-reduction-injective` at the translate `gL`, which contains `mM`. -/
theorem mem_residueStabilizer_iff (g : ↥D.G) :
    (g • D.baseResidue = D.baseResidue) ↔ ambientTranslate L g.1 = integralImage R L := by
  constructor
  · intro hg
    have hg' : (D.residue (integralImage R L)).map
          ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) =
        D.residue (integralImage R L) := by
      simpa [residuePoint_coe_smul, baseResidue_coe, D.smul_eq_map] using
        congrArg Subtype.val hg
    have hsup : D.residue (ambientTranslate L g.1) = D.residue (integralImage R L) := by
      have hmap : D.residue (ambientTranslate L g.1) =
          (D.residue (integralImage R L)).map
            ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) := by
        simp only [residue, ambientTranslate, Submodule.map_sup, D.mM_map g]
      rw [hmap, hg']
    exact D.residue_eq_of_sup_eq (D.mM_le_translate g) D.mM_le_integralImage hsup
  · intro hg
    have hsub : ((g • D.baseResidue : D.ResiduePoint) : Submodule R (RationalSpan R L)) =
        (D.baseResidue : Submodule R (RationalSpan R L)) := by
      rw [D.smul_base_coe, baseResidue_coe,
        ← D.residue_translate_eq_map g, hg, residue, sup_eq_left.mpr D.mM_le_integralImage]
    exact Subtype.ext hsub

/-- **Equal images give equal translates**, by `lem:orbit-reduction-injective`: both translates
contain `mM`, so an equality of residue classes is an equality of lattices. -/
theorem translate_eq_of_smul_base_eq {g g' : ↥D.G}
    (h : g • D.baseResidue = g' • D.baseResidue) :
    ambientTranslate L g.1 = ambientTranslate L g'.1 := by
  apply D.residue_eq_of_sup_eq (D.mM_le_translate g) (D.mM_le_translate g')
  rw [D.residue_translate_eq_map, D.residue_translate_eq_map, ← D.smul_base_coe, ← D.smul_base_coe]
  exact congrArg Subtype.val h

/-- **`L_{sp} = s L_p`**: the translate of the orbit point `p` by the letter `s`, which is the
lattice the source writes `L_{sp}`, and which is also `t_{sp} L`. -/
theorem translate_smul_eq (t : D.ResiduePoint → ↥D.G)
    (ht : ∀ q, t q • D.baseResidue = q) (s : ↥D.G) (p : D.ResiduePoint) :
    (ambientTranslate L (t p).1).map ((s.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) =
      ambientTranslate L (t (s • p)).1 := by
  rw [← D.translate_mul s (t p)]
  exact D.translate_eq_of_smul_base_eq (by rw [mul_smul, ht p, ht (s • p)])

end AmbientResidueData

/-! ## The integral self-isometry of a residue stabilizer -/

/-- The lattice carrier is its integral image inside the rational span. -/
noncomputable def integralImageEquiv (L : IntegralLatticeCat R) :
    L.obj.carrier ≃ₗ[R] ↥(integralImage R L) :=
  LinearEquiv.ofBijective
    (LinearMap.codRestrict (integralImage R L) (toRationalSpan R L) fun x => ⟨x, rfl⟩)
    ⟨fun x y h => toRationalSpan_injective R L (congrArg Subtype.val h), by
      rintro ⟨y, hy⟩
      obtain ⟨x, rfl⟩ := hy
      exact ⟨x, rfl⟩⟩

@[simp]
theorem integralImageEquiv_apply_coe (L : IntegralLatticeCat R) (x : L.obj.carrier) :
    ((integralImageEquiv L x : ↥(integralImage R L)) : RationalSpan R L) =
      toRationalSpan R L x := rfl

theorem integralImageEquiv_symm_coe (L : IntegralLatticeCat R)
    (ζ : ↥(integralImage R L)) :
    toRationalSpan R L ((integralImageEquiv L).symm ζ) = ζ.1 :=
  congrArg Subtype.val ((integralImageEquiv L).apply_symm_apply ζ)

/-- **An ambient isometry that preserves the integral image acts on `L`.** -/
noncomputable def stabilizerEnd (g : AmbientOrthogonalGroup L)
    (hg : ambientTranslate L g = integralImage R L) :
    L.obj.carrier →ₗ[R] L.obj.carrier :=
  (integralImageEquiv L).symm.toLinearMap.comp
    (LinearMap.codRestrict (integralImage R L)
      ((g.1 : RationalSpan R L →ₗ[R] RationalSpan R L).comp (toRationalSpan R L)) fun x =>
        hg ▸ Submodule.mem_map_of_mem ⟨x, rfl⟩)

theorem stabilizerEnd_toRationalSpan (g : AmbientOrthogonalGroup L)
    (hg : ambientTranslate L g = integralImage R L) (x : L.obj.carrier) :
    toRationalSpan R L (stabilizerEnd g hg x) =
      g.1 (toRationalSpan R L x) :=
  integralImageEquiv_symm_coe L _

theorem stabilizerEnd_injective (g : AmbientOrthogonalGroup L)
    (hg : ambientTranslate L g = integralImage R L) :
    Function.Injective (stabilizerEnd g hg) := by
  intro x y h
  have h' := congrArg (toRationalSpan R L) h
  rw [stabilizerEnd_toRationalSpan, stabilizerEnd_toRationalSpan] at h'
  exact toRationalSpan_injective R L (g.1.injective h')

omit [IsDomain R] in
theorem inverse_translate (g : AmbientOrthogonalGroup L)
    (hg : ambientTranslate L g = integralImage R L) :
    ambientTranslate L g⁻¹ = integralImage R L := by
  have h := congrArg (fun P : Submodule R (RationalSpan R L) =>
    P.map ((g⁻¹).1 : RationalSpan R L →ₗ[R] RationalSpan R L)) hg
  have hleft : (ambientTranslate L g).map
        ((g⁻¹).1 : RationalSpan R L →ₗ[R] RationalSpan R L) = integralImage R L := by
    rw [ambientTranslate, ← Submodule.map_comp]
    have hid : ((g⁻¹).1 : RationalSpan R L →ₗ[R] RationalSpan R L) ∘ₗ
        ((g.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) = LinearMap.id := by
      apply LinearMap.ext
      intro x
      simp
    rw [hid, Submodule.map_id]
  rw [hleft] at h
  simpa [ambientTranslate] using h.symm

theorem stabilizerEnd_surjective (g : AmbientOrthogonalGroup L)
    (hg : ambientTranslate L g = integralImage R L) :
    Function.Surjective (stabilizerEnd g hg) := by
  intro z
  refine ⟨stabilizerEnd g⁻¹ (inverse_translate g hg) z, ?_⟩
  apply toRationalSpan_injective R L
  rw [stabilizerEnd_toRationalSpan, stabilizerEnd_toRationalSpan]
  simp

/-- **The ambient isometry of a lattice stabilizer, as a linear equivalence of `L`.** -/
noncomputable def stabilizerLatticeEquiv (g : AmbientOrthogonalGroup L)
    (hg : ambientTranslate L g = integralImage R L) :
    L.obj.carrier ≃ₗ[R] L.obj.carrier :=
  LinearEquiv.ofBijective _
    ⟨stabilizerEnd_injective g hg, stabilizerEnd_surjective g hg⟩

/-- The induced self-map preserves the form: the rationalized form is invariant under an ambient
isometry, and the integral pairing is recovered from it by injectivity of `R → Frac R`. -/
theorem stabilizerEnd_pairing (g : AmbientOrthogonalGroup L)
    (hg : ambientTranslate L g = integralImage R L) (x y : L.obj.carrier) :
    L.obj.pairing (stabilizerEnd g hg x) (stabilizerEnd g hg y) = L.obj.pairing x y := by
  refine IsFractionRing.injective R (FractionRing R) ?_
  rw [← rationalizedForm_toRationalSpan, ← rationalizedForm_toRationalSpan,
    stabilizerEnd_toRationalSpan, stabilizerEnd_toRationalSpan]
  exact (g.2 : ∀ a b, rationalizedForm R L (g.1 a) (g.1 b) = rationalizedForm R L a b) _ _

/-- **The integral self-isometry of `L` induced by a residue stabilizer.** This is the map through
which the ambient description reaches the discriminant representation `ρ_L`, which is defined on
`O(L)` alone. -/
noncomputable def stabilizerOrthogonal (g : AmbientOrthogonalGroup L)
    (hg : ambientTranslate L g = integralImage R L) : OrthogonalGroup L :=
  ⟨stabilizerLatticeEquiv g hg, stabilizerEnd_pairing g hg⟩

theorem stabilizerOrthogonal_val_toRationalSpan (g : AmbientOrthogonalGroup L)
    (hg : ambientTranslate L g = integralImage R L) (x : L.obj.carrier) :
    toRationalSpan R L ((stabilizerOrthogonal g hg : OrthogonalGroup L).1 x) =
      g.1 (toRationalSpan R L x) :=
  stabilizerEnd_toRationalSpan g hg x

/-- **An ambient element stabilizing the residue class of `L` stabilizes `L`**, which is
`lem:congruence-stabilizer-preimage` in the form the Schreier argument consumes. -/
theorem translate_eq_of_mem_stabilizer (D : AmbientResidueData R L)
    (k : ↥(D.residueStabilizer)) :
    ambientTranslate L (k.1).1 = integralImage R L :=
  (D.mem_residueStabilizer_iff k.1).mp (MulAction.mem_stabilizer_iff.mp k.2)

set_option maxHeartbeats 1000000 in
-- The monoid laws of `residueStabilizerHom` compare three nested subtype coercions
-- (`↥(Stab…) → ↥D.G → AmbientOrthogonalGroup L`), and the default 200000 heartbeats run out in the
-- `whnf` of that statement, not in the mathematics.
/-- **The residue stabilizer as integral self-isometries of `L`**: a completing loop fixes the
residue class of `L`, hence (by `lem:congruence-stabilizer-preimage`) stabilizes `L`, and its
restriction is an element of the existing `O(L)`. The discriminant representation `ρ_L` is applied
to this homomorphism,
not to the ambient group, because `ρ_L` is defined on `O(L)` alone. -/
noncomputable def residueStabilizerHom (D : AmbientResidueData R L) :
    ↥(D.residueStabilizer) →* OrthogonalGroup L where
  toFun k := stabilizerOrthogonal (k.1).1 (translate_eq_of_mem_stabilizer D k)
  map_one' := by
    apply Subtype.ext
    apply LinearEquiv.ext
    intro x
    apply toRationalSpan_injective R L
    rw [stabilizerOrthogonal_val_toRationalSpan]
    simp
  map_mul' k l := by
    apply Subtype.ext
    apply LinearEquiv.ext
    intro x
    apply toRationalSpan_injective R L
    have hk : ∀ y, toRationalSpan R L ((stabilizerOrthogonal (k.1).1
        (translate_eq_of_mem_stabilizer D k)).1 y) =
        ((k.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) (toRationalSpan R L y) :=
      fun y => stabilizerOrthogonal_val_toRationalSpan (k.1).1 _ y
    have hl : ∀ y, toRationalSpan R L ((stabilizerOrthogonal (l.1).1
        (translate_eq_of_mem_stabilizer D l)).1 y) =
        ((l.1).1 : RationalSpan R L →ₗ[R] RationalSpan R L) (toRationalSpan R L y) :=
      fun y => stabilizerOrthogonal_val_toRationalSpan (l.1).1 _ y
    have e1 : ((stabilizerOrthogonal (k.1).1 (translate_eq_of_mem_stabilizer D k) *
        stabilizerOrthogonal (l.1).1 (translate_eq_of_mem_stabilizer D l) :
        OrthogonalGroup L) : L.obj.carrier ≃ₗ[R] L.obj.carrier) x =
        (stabilizerOrthogonal (k.1).1 (translate_eq_of_mem_stabilizer D k)).1
          ((stabilizerOrthogonal (l.1).1 (translate_eq_of_mem_stabilizer D l)).1 x) := rfl
    rw [e1, hk, hl, stabilizerOrthogonal_val_toRationalSpan]
    rfl

/-- **The Schreier loops**, `k_{s,p} = t_{sp}⁻¹ s t_p`, as elements of the residue stabilizer. -/
noncomputable def schreierLoop (D : AmbientResidueData R L)
    (t : D.ResiduePoint → ↥D.G) (ht : ∀ q, t q • D.baseResidue = q)
    (s : ↥D.G) (q : D.ResiduePoint) :
    ↥(D.residueStabilizer) where
  val := (t (s • q))⁻¹ * s * t q
  property := by
    have h : ((t (s • q))⁻¹ * s * t q) • D.baseResidue = D.baseResidue := by
      set a := t (s • q) with ha
      have ha' : a • D.baseResidue = s • q := ht (s • q)
      rw [mul_smul, mul_smul, ht q, ← ha', ← mul_smul, inv_mul_cancel, one_smul]
    exact h

/-! ## The exact discriminant image of the ambient stabilizer -/

namespace AmbientResidueData

/-- **The stabilizer of the lattice, inside `G`**, as the stabilizer of the integral image for the
action of `↥D.G` on the submodules of the rational span. `lem:congruence-stabilizer-preimage` is
the statement that this subgroup is also the stabilizer of the residue class. -/
noncomputable abbrev latticeStabilizer (D : AmbientResidueData R L) : Subgroup ↥D.G :=
  MulAction.stabilizer ↥D.G (integralImage R L)

/-- The ambient action on submodules is the translate. -/
theorem smul_integralImage (D : AmbientResidueData R L) (g : ↥D.G) :
    g • integralImage R L = ambientTranslate L g.1 := rfl

/-- **`lem:congruence-stabilizer-preimage` as an equality of subgroups**: the stabilizer of the
lattice `L` and the stabilizer of its residue class modulo `mM` agree inside `G`. -/
theorem residueStabilizer_eq_latticeStabilizer (D : AmbientResidueData R L) :
    D.residueStabilizer = D.latticeStabilizer := by
  refine Subgroup.ext fun g => ?_
  rw [MulAction.mem_stabilizer_iff, MulAction.mem_stabilizer_iff, D.smul_integralImage]
  exact D.mem_residueStabilizer_iff g

variable (D : AmbientResidueData R L)

/-- The loop family of the Schreier theorem, as a set of elements of the residue stabilizer. -/
noncomputable def schreierLoopSet (t : D.ResiduePoint → ↥D.G)
    (ht : ∀ q, t q • D.baseResidue = q) (S : Set ↥D.G) : Set ↥(D.residueStabilizer) :=
  (fun x : ↥D.G × D.ResiduePoint => schreierLoop D t ht x.1 x.2) ''
    (S ×ˢ MulAction.orbit ↥D.G D.baseResidue)

/-- The loop family, read in `G`. -/
theorem subtype_image_schreierLoopSet (t : D.ResiduePoint → ↥D.G)
    (ht : ∀ q, t q • D.baseResidue = q) (S : Set ↥D.G) :
    (Subgroup.subtype D.residueStabilizer) '' D.schreierLoopSet t ht S =
      ((fun x : ↥D.G × D.ResiduePoint => (t (x.1 • x.2))⁻¹ * x.1 * t x.2) ''
        (S ×ˢ MulAction.orbit ↥D.G D.baseResidue)) := by
  rw [schreierLoopSet, Set.image_image]
  rfl

/-- **`lem:schreier-stabilizer` at the residue orbit, in the stabilizer subtype.** The completed
loops `k_{s,p}` generate the stabilizer of the residue class of `L` in `G`; by
`lem:congruence-stabilizer-preimage` that stabilizer is the stabilizer of `L` itself, so the loops
generate the stabilizer of the lattice.

This is the transfer of the general Schreier theorem `Subgroup.closure_schreierLoops_eq_stabilizer`
to the stabilizer subtype: reading the loops back in `G` gives exactly the loop family of that
theorem, and the subtype hom is injective. -/
theorem closure_schreierLoopSet_eq_top (S : Set ↥D.G) (hS : Subgroup.closure S = ⊤)
    (t : D.ResiduePoint → ↥D.G) (ht : ∀ q, t q • D.baseResidue = q)
    (hbase : t D.baseResidue = 1) :
    Subgroup.closure (D.schreierLoopSet t ht S) = ⊤ := by
  have key := Subgroup.closure_schreierLoops_eq_stabilizer (G := ↥D.G) (α := D.ResiduePoint)
    S hS D.baseResidue t ht hbase
  refine eq_top_iff.mpr fun x _ => ?_
  have hx : (x.1 : ↥D.G) ∈ (Subgroup.closure (D.schreierLoopSet t ht S)).map
      (Subgroup.subtype D.residueStabilizer) := by
    rw [MonoidHom.map_closure, D.subtype_image_schreierLoopSet t ht S, key]
    exact x.2
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
  have hxy : x = y := Subtype.ext hyx.symm
  rw [hxy]
  exact hy

set_option maxHeartbeats 2000000 in
-- The two rewrites below are under the opaque `discriminantRangeImage`, whose body carries the
-- `letI : Normal` instance for the stable orthogonal group; the default 200000 heartbeats run out
-- in the `isDefEq` of that body, not in the mathematics.
/-- **The exact image of the integral stabilizer.** With `S` generating `G` and `t` a transversal of
the residue orbit, the discriminant image of the integral stabilizer is generated by the
discriminant images of the completed loops: this is `thm:schreier-discriminant-image` item 3.

The ambient stabilizer is reached through `residueStabilizerHom`, which restricts a completed loop
to an integral self-isometry of `L`; `ρ_L` is the existing discriminant representation of `O(L)`
(`DiscriminantAction.discriminantRepresentation`), and `discriminantRangeImage` is its image inside
the range of `ρ_L`. The equality is obtained from the subgroup identity
`closure_schreierLoopSet_eq_top` and `MonoidHom.map_closure`; it is not assumed. -/
theorem discriminantRangeImage_eq_closure_residueSchreier
    (hL : IsFractionFieldPerfect R L) (S : Set ↥D.G)
    (hS : Subgroup.closure S = ⊤) (t : D.ResiduePoint → ↥D.G)
    (ht : ∀ q, t q • D.baseResidue = q) (hbase : t D.baseResidue = 1) :
    discriminantRangeImage hL
        (Subgroup.map (residueStabilizerHom D) ⊤) =
      Subgroup.closure ((fun x : ↥D.G × D.ResiduePoint =>
        ⟨(OrthogonalGroup.discriminantRepresentation hL)
            (residueStabilizerHom D (schreierLoop D t ht x.1 x.2)), ⟨_, rfl⟩⟩) ''
        (S ×ˢ MulAction.orbit ↥D.G D.baseResidue)) := by
  have harg : Subgroup.map (residueStabilizerHom D) ⊤ =
      Subgroup.closure ((residueStabilizerHom D) '' D.schreierLoopSet t ht S) := by
    rw [← D.closure_schreierLoopSet_eq_top S hS t ht hbase, MonoidHom.map_closure]
  rw [harg, discriminantRangeImage_eq_map_rangeRestrict, MonoidHom.map_closure]
  have hseteq : ((⇑(OrthogonalGroup.discriminantRepresentation hL).rangeRestrict ''
        ⇑(residueStabilizerHom D) '' D.schreierLoopSet t ht S) :
          Set (OrthogonalGroup.discriminantRepresentation hL).range) =
      ((fun x : ↥D.G × D.ResiduePoint =>
        (⟨(OrthogonalGroup.discriminantRepresentation hL)
            (residueStabilizerHom D (schreierLoop D t ht x.1 x.2)), ⟨_, rfl⟩⟩ :
          (OrthogonalGroup.discriminantRepresentation hL).range)) ''
        (S ×ˢ MulAction.orbit ↥D.G D.baseResidue)) := by
    ext y
    constructor
    · rintro ⟨x, ⟨w, hw, rfl⟩, rfl⟩
      rw [schreierLoopSet] at hw
      obtain ⟨a, ha, rfl⟩ := hw
      exact ⟨a, ha, Subtype.ext rfl⟩
    · rintro ⟨a, ha, rfl⟩
      exact ⟨residueStabilizerHom D (schreierLoop D t ht a.1 a.2),
        ⟨schreierLoop D t ht a.1 a.2, ⟨a, ha, rfl⟩, rfl⟩, Subtype.ext rfl⟩
  rw [hseteq]

end AmbientResidueData

/-! ## The orbit lattices and the ambient transport

`thm:discriminant-transport-functor` transports the discriminant form along an ambient isometry that
does not preserve `L`: the translates `gL = ambientTranslate L g` are integral lattices in their own
right, and the isometries between them are indexed by the pairs `(L₀, g)` rather than by self-maps.

`orbitLattice g` is the translate `gL` as an object of `IntegralLatticeCat R`, with its pairing and
its projectivity *transported from `L`* along `orbitCarrierEquiv g`: nothing is assumed of the
invariant module `M` (which need not be integral and need not lie in `L^♯`). `orbitLatticeIso g` is
`α_g(L) : L ≅ gL`, and `orbitTransportIso a g k h` is the isometry `gL ≅ kL` induced by an ambient
`a` with `kL = a·(gL)`; `orbitTransport_form` proves it is an isometry of the translated forms, and
`orbitTransportEquiv_comp` is the functoriality of `thm:discriminant-transport-functor` item 2 at
the carrier level.

The maps that the three-factor identity of `thm:schreier-discriminant-image` item 3 is indexed
by, and their functoriality, are what this section supplies. -/

omit [IsDomain R] in
/-- The linear map `L → gL` given by an ambient isometry `g`. -/
noncomputable def orbitCarrierMap (g : AmbientOrthogonalGroup L) :
    L.obj.carrier →ₗ[R] ↥(ambientTranslate L g) where
  toFun x :=
    ⟨g.1 (toRationalSpan R L x),
      Submodule.mem_map_of_mem (p := integralImage R L) (f := (g.1).toLinearMap)
        (show toRationalSpan R L x ∈ integralImage R L from ⟨x, rfl⟩)⟩
  map_add' x y := by apply Subtype.ext; simp
  map_smul' r x := by apply Subtype.ext; simp

omit [IsDomain R] in
@[simp]
theorem orbitCarrierMap_apply_coe (g : AmbientOrthogonalGroup L) (x : L.obj.carrier) :
    ((orbitCarrierMap g x : ↥(ambientTranslate L g)) : RationalSpan R L) =
      g.1 (toRationalSpan R L x) := rfl

/-- **The carrier equivalence `L ≃ gL`** given by an ambient isometry `g`. -/
noncomputable def orbitCarrierEquiv (g : AmbientOrthogonalGroup L) :
    L.obj.carrier ≃ₗ[R] ↥(ambientTranslate L g) :=
  LinearEquiv.ofBijective (orbitCarrierMap g)
    ⟨fun x y h => by
      have h' := congrArg Subtype.val h
      rw [orbitCarrierMap_apply_coe, orbitCarrierMap_apply_coe] at h'
      exact toRationalSpan_injective R L (g.1.injective h'),
     fun z => by
      obtain ⟨u, hu, hgu⟩ := Submodule.mem_map.mp z.2
      refine ⟨(integralImageEquiv L).symm ⟨g.1.symm z.1, ?_⟩, ?_⟩
      · rw [show g.1.symm z.1 = u from by rw [← hgu]; exact g.1.symm_apply_apply u]
        exact hu
      · apply Subtype.ext
        change g.1 (toRationalSpan R L ((integralImageEquiv L).symm ⟨g.1.symm z.1, _⟩)) = z.1
        rw [integralImageEquiv_symm_coe]
        exact g.1.apply_symm_apply z.1⟩

@[simp]
theorem orbitCarrierEquiv_apply_coe (g : AmbientOrthogonalGroup L) (x : L.obj.carrier) :
    ((orbitCarrierEquiv g x : ↥(ambientTranslate L g)) : RationalSpan R L) =
      g.1 (toRationalSpan R L x) := rfl

theorem orbitCarrierEquiv_symm_apply (g : AmbientOrthogonalGroup L)
    (z : ↥(ambientTranslate L g)) :
    toRationalSpan R L ((orbitCarrierEquiv g).symm z) = g.1.symm z.1 := by
  apply g.1.injective
  rw [← orbitCarrierEquiv_apply_coe, LinearEquiv.apply_symm_apply,
    LinearEquiv.apply_symm_apply]

/-- The form on the translate `gL`, transported from `L` along the carrier equivalence. -/
noncomputable def orbitPairing (g : AmbientOrthogonalGroup L) :
    LinearMap.BilinMap R ↥(ambientTranslate L g) R :=
  LinearMap.mk₂ R
    (fun x y => L.obj.pairing ((orbitCarrierEquiv g).symm x) ((orbitCarrierEquiv g).symm y))
    (fun x y z => by simp)
    (fun a x y => by simp)
    (fun x y z => by simp)
    (fun a x y => by simp)

@[simp]
theorem orbitPairing_apply (g : AmbientOrthogonalGroup L)
    (x y : ↥(ambientTranslate L g)) :
    orbitPairing g x y =
      L.obj.pairing ((orbitCarrierEquiv g).symm x) ((orbitCarrierEquiv g).symm y) :=
  rfl

/-- The formed module of the translate `gL`, written with its carrier as a `ModuleCat` so that the
carrier reduces definitionally to `↥(ambientTranslate L g)`. -/
noncomputable abbrev orbitBilinModule (g : AmbientOrthogonalGroup L) : BilinModuleCat R R :=
  Opposite.op (Functor.elementsMk (bilinearForms R R)
    (Opposite.op (ModuleCat.of R ↥(ambientTranslate L g)))
    ((TensorProduct.lift.equiv (.id R) ↥(ambientTranslate L g) ↥(ambientTranslate L g) R)
      (orbitPairing g)))

@[simp]
theorem orbitBilinModule_pairing (g : AmbientOrthogonalGroup L)
    (x y : ↥(ambientTranslate L g)) :
    (orbitBilinModule g).pairing x y =
      L.obj.pairing ((orbitCarrierEquiv g).symm x) ((orbitCarrierEquiv g).symm y) :=
  orbitPairing_apply g x y

/-- **The translate `gL` as an integral lattice object**, with its form and its projectivity
transported from `L`; nothing is assumed of the invariant module `M`. -/
noncomputable abbrev orbitLattice (g : AmbientOrthogonalGroup L) : IntegralLatticeCat R :=
  haveI : Module.Projective R L.obj.carrier := L.property.1
  ⟨orbitBilinModule g,
    ⟨Module.Projective.of_equiv' (P := ↥(ambientTranslate L g)) (orbitCarrierEquiv g),
      fun _ _ => L.property.2 _ _⟩⟩

/-- **`α_g(L)`: the isomorphism `L ≅ gL`** of integral lattices given by an ambient isometry. -/
noncomputable abbrev orbitLatticeIso (g : AmbientOrthogonalGroup L) :
    L ≅ orbitLattice g :=
  ObjectProperty.isoMk (isLattice R R)
    (BilinModuleCat.isoMk (orbitCarrierEquiv g) (fun x y => by
      change (orbitBilinModule g).pairing ((orbitCarrierEquiv g) x) ((orbitCarrierEquiv g) y)
        = L.obj.pairing x y
      rw [orbitBilinModule_pairing, LinearEquiv.symm_apply_apply,
        LinearEquiv.symm_apply_apply]))

@[simp]
theorem latticeIsoLinearEquiv_orbitLatticeIso (g : AmbientOrthogonalGroup L)
    (x : L.obj.carrier) :
    latticeIsoLinearEquiv (orbitLatticeIso g) x = orbitCarrierEquiv g x := rfl


/-! ## The ambient transport of a translate -/

omit [IsDomain R] in
/-- Move an isometry across the rationalized form, on the inverse side. -/
theorem rationalizedForm_symm (g : AmbientOrthogonalGroup L)
    (x y : RationalSpan R L) :
    rationalizedForm R L (g.1.symm x) (g.1.symm y) = rationalizedForm R L x y := by
  have h := g.2 (g.1.symm x) (g.1.symm y)
  simpa using h.symm

omit [IsDomain R] in
/-- The inverse translate relation. -/
theorem ambientTranslate_symm (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap) :
    ambientTranslate L g = (ambientTranslate L k).map (a.1.symm).toLinearMap := by
  rw [h, ← Submodule.map_comp]
  have hcomp : (a.1.symm).toLinearMap ∘ₗ (a.1).toLinearMap = LinearMap.id := by
    ext x
    simp
  rw [hcomp, Submodule.map_id]

/-- The ambient isometry `a` as a linear map between the translates `gL` and `kL`. -/
noncomputable def orbitTransportMap (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap) :
    ↥(ambientTranslate L g) →ₗ[R] ↥(ambientTranslate L k) where
  toFun x := ⟨a.1 x.1, by rw [h]; exact Submodule.mem_map_of_mem x.2⟩
  map_add' x y := by apply Subtype.ext; simp
  map_smul' r x := by apply Subtype.ext; simp

omit [IsDomain R] in
@[simp]
theorem orbitTransportMap_apply_coe (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap)
    (x : ↥(ambientTranslate L g)) :
    ((orbitTransportMap a g k h x : ↥(ambientTranslate L k)) : RationalSpan R L) = a.1 x.1 :=
  rfl

/-- The `L`-level endomorphism underlying the ambient transport. -/
noncomputable def orbitCoordEnd (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap) :
    L.obj.carrier →ₗ[R] L.obj.carrier :=
  (orbitCarrierEquiv k).symm.toLinearMap.comp
    ((orbitTransportMap a g k h).comp (orbitCarrierEquiv g).toLinearMap)

theorem orbitCoordEnd_toRationalSpan (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap)
    (u : L.obj.carrier) :
    toRationalSpan R L (orbitCoordEnd a g k h u) =
      k.1.symm (a.1 (g.1 (toRationalSpan R L u))) := by
  simp only [orbitCoordEnd, LinearMap.comp_apply, LinearEquiv.coe_coe]
  rw [orbitCarrierEquiv_symm_apply, orbitTransportMap_apply_coe, orbitCarrierEquiv_apply_coe]

/-- The underlying `L`-endomorphism of an ambient transport is an isometry of the integral form. -/
theorem orbitCoordEnd_pairing (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap)
    (u v : L.obj.carrier) :
    L.obj.pairing (orbitCoordEnd a g k h u) (orbitCoordEnd a g k h v) =
      L.obj.pairing u v := by
  apply IsFractionRing.injective R (FractionRing R)
  rw [← rationalizedForm_toRationalSpan, ← rationalizedForm_toRationalSpan,
    orbitCoordEnd_toRationalSpan, orbitCoordEnd_toRationalSpan,
    rationalizedForm_symm k, a.2, g.2]

/-- **The ambient transport is an isometry of the translated forms.** -/
theorem orbitTransport_form (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap)
    (x y : ↥(ambientTranslate L g)) :
    orbitPairing k (orbitTransportMap a g k h x) (orbitTransportMap a g k h y) =
      orbitPairing g x y := by
  have hx : orbitCoordEnd a g k h ((orbitCarrierEquiv g).symm x) =
      (orbitCarrierEquiv k).symm (orbitTransportMap a g k h x) := by
    simp only [orbitCoordEnd, LinearMap.comp_apply, LinearEquiv.coe_coe]
    rw [LinearEquiv.apply_symm_apply]
  have hy : orbitCoordEnd a g k h ((orbitCarrierEquiv g).symm y) =
      (orbitCarrierEquiv k).symm (orbitTransportMap a g k h y) := by
    simp only [orbitCoordEnd, LinearMap.comp_apply, LinearEquiv.coe_coe]
    rw [LinearEquiv.apply_symm_apply]
  rw [orbitPairing_apply, orbitPairing_apply, ← hx, ← hy]
  exact orbitCoordEnd_pairing a g k h _ _

/-- **The carrier equivalence of an ambient transport.** -/
noncomputable def orbitTransportEquiv (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap) :
    ↥(ambientTranslate L g) ≃ₗ[R] ↥(ambientTranslate L k) :=
  LinearEquiv.ofBijective (orbitTransportMap a g k h)
    ⟨fun x y hxy => by
      have h' := congrArg Subtype.val hxy
      rw [orbitTransportMap_apply_coe, orbitTransportMap_apply_coe] at h'
      apply Subtype.ext
      exact a.1.injective h',
     fun y => by
      refine ⟨orbitTransportMap (a := a⁻¹) (g := k) (k := g)
        (ambientTranslate_symm a g k h) y, ?_⟩
      apply Subtype.ext
      simp only [orbitTransportMap_apply_coe]
      exact a.1.apply_symm_apply y.1⟩

omit [IsDomain R] in
@[simp]
theorem orbitTransportEquiv_apply_coe (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap)
    (x : ↥(ambientTranslate L g)) :
    ((orbitTransportEquiv a g k h x : ↥(ambientTranslate L k)) : RationalSpan R L) = a.1 x.1 :=
  rfl

/-- **`α_a(L₀)`: the ambient transport of the discriminant isometries of the orbit lattices.** For
`thm:discriminant-transport-functor`, this is the isometry of integral lattices `gL ≅ kL` induced by
the ambient isometry `a` with `kL = a·(gL)`. -/
noncomputable abbrev orbitTransportIso (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap) :
    orbitLattice g ≅ orbitLattice k :=
  ObjectProperty.isoMk (isLattice R R)
    (BilinModuleCat.isoMk (orbitTransportEquiv a g k h)
      (fun x y => orbitTransport_form a g k h x y))


@[simp]
theorem latticeIsoLinearEquiv_orbitTransportIso (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap)
    (x : ↥(ambientTranslate L g)) :
    latticeIsoLinearEquiv (orbitTransportIso a g k h) x = orbitTransportEquiv a g k h x := rfl

omit [IsDomain R] in
/-- The transport of the identity ambient element is the identity carrier equivalence. -/
theorem orbitTransportEquiv_one (g : AmbientOrthogonalGroup L)
    (h : ambientTranslate L g =
      (ambientTranslate L g).map ((1 : AmbientOrthogonalGroup L).1).toLinearMap)
    (x : ↥(ambientTranslate L g)) :
    orbitTransportEquiv (1 : AmbientOrthogonalGroup L) g g h x = x := by
  apply Subtype.ext
  rfl

omit [IsDomain R] in
/-- **Composition of ambient transports**: the transport by `b * a` is the composite of the
transports by `a` and by `b`. This is `thm:discriminant-transport-functor` item 2 at the carrier
level. -/
theorem orbitTransportEquiv_comp (b a : AmbientOrthogonalGroup L)
    (g g' k : AmbientOrthogonalGroup L)
    (h₁ : ambientTranslate L g' = (ambientTranslate L g).map (a.1).toLinearMap)
    (h₂ : ambientTranslate L k = (ambientTranslate L g').map (b.1).toLinearMap)
    (h₃ : ambientTranslate L k = (ambientTranslate L g).map (b * a).1.toLinearMap)
    (x : ↥(ambientTranslate L g)) :
    orbitTransportEquiv (b * a) g k h₃ x =
      orbitTransportEquiv b g' k h₂ (orbitTransportEquiv a g g' h₁ x) := by
  apply Subtype.ext
  exact rfl

/-! ## The residue module is finite in the integral case

For `R = ℤ`, `M/mM` is not an extra hypothesis: `mM ⊆ M` (`AmbientResidueData.mM_le_M`), and
`m·M` inside `M` is the `n = m.natAbs`-multiple, so `M/mM` is Mathlib's `ModN ↥M n`, finite by
`ModN.instFinite` from `Module.Finite ℤ ↥M` and `m ≠ 0` (`Module.finite_of_fg_torsion`). No integral
lattice replaces `M` here, and no orbit is assumed finite. -/


/-- `mM ⊆ M`: the translate is cut out inside `M`, which is what `M/mM` needs. -/
theorem AmbientResidueData.mM_le_M (D : AmbientResidueData R L) : D.mM ≤ D.M := by
  intro x hx
  rw [AmbientResidueData.mM] at hx
  obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.mp hx
  exact D.M.smul_mem D.m hy


/-! ## The three-factor composite of a completed loop

`thm:schreier-discriminant-image` item 3 factorizes `ρ_L(k_{s,p})` through the discriminant
isometries `α` between the translated lattices of the orbit. This section supplies each factor and
its action on classes:

* `orbitAlphaTo g : A_L ≃ A_{gL}` and `orbitAlphaTrans a g k h : A_{gL} ≃ A_{kL}`, the transports
  of `orbitLatticeIso` and `orbitTransportIso` to the discriminant module;
* `orbitAlphaTo_mk`, `orbitAlphaTrans_mk`, `orbitAlphaTo_symm_mk`: their action on
  `Submodule.Quotient.mk` classes, stated through the carriers `orbitCarrierEquiv` and
  `orbitTransportEquiv`;
* `schreierLoop_symm_apply`: the carrier identity behind the factorized formula. The loop's inverse
  acts on the rational span as `(((t_sp)⁻¹ s) t_p)⁻¹ = t_p⁻¹ (s⁻¹ t_sp)`; the contragredient
  composite of the three carriers acts as `t_p⁻¹ (s⁻¹ (t_sp y))`; they agree by `mul_inv_rev` and
  `mul_apply_eq_comp`;
* `loopDefectEquiv` (the loop's action on `A_L`) and `orbitLoopComposite` (the three-factor
  composite `α_{t_sp}(L)⁻¹ ∘ α_s(L_p) ∘ α_{t_p}(L)`).

**What is not yet proved**: the identity
`loopDefectEquiv D t ht s p = orbitLoopComposite D t ht s p`. Every ingredient is present and
`Submodule.Quotient.induction_on` reduces it to the pointwise comparison of two value-dual maps,
which `schreierLoop_symm_apply` closes. The step that does not
elaborate is the assembly: rewriting with the `_mk` lemmas forces `isDefEq` checks between
`(orbitLattice g).obj.valueDual` and `L.obj.valueDual`, whose `Submodule.Quotient.module` instances
carry different `Submodule` arguments, and those checks exhaust the heartbeat budget even at
3000000. The fix is a recording change, not a mathematical one: state the value-dual level composite
as its own opaque definition so that the `mk`-level rewrites become syntactic. -/


theorem actOnValueDual_apply (g : OrthogonalGroup L) (f : L.obj.valueDual)
    (y : L.obj.carrier) :
    OrthogonalGroup.actOnValueDual g f y = f (g.1.symm y) := rfl

omit [IsDomain R] in
theorem discriminantValueDualEquiv_apply_comp (e : L ≅ M) (f : L.obj.valueDual) :
    discriminantValueDualEquiv e f =
      f.comp (latticeIsoLinearEquiv e).symm.toLinearMap := rfl

omit [IsDomain R] in
theorem discriminantValueDualEquiv_symm_apply_comp (e : L ≅ M) (f : M.obj.valueDual) :
    (discriminantValueDualEquiv e).symm f =
      f.comp (latticeIsoLinearEquiv e).toLinearMap := by
  rw [LinearEquiv.symm_apply_eq, discriminantValueDualEquiv_apply_comp]
  ext x
  simp

omit [IsDomain R] in
theorem discriminantCarrierEquiv_symm_mk (e : L ≅ M) (f : M.obj.valueDual) :
    (discriminantCarrierEquiv e).symm (Submodule.Quotient.mk f) =
      Submodule.Quotient.mk (f.comp (latticeIsoLinearEquiv e).toLinearMap) := by
  rw [LinearEquiv.symm_apply_eq, discriminantCarrierEquiv_mk,
    discriminantValueDualEquiv_apply_comp]
  refine congrArg Submodule.Quotient.mk ?_
  ext x
  simp

/-- The inverse ambient transport, read on the rational span. -/
theorem orbitTransportEquiv_symm_apply_coe (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap)
    (x : ↥(ambientTranslate L k)) :
    ((orbitTransportEquiv a g k h).symm x : RationalSpan R L) = a.1.symm x.1 := by
  apply a.1.injective
  have h2 : a.1 ((orbitTransportEquiv a g k h).symm x).1 = x.1 := by
    rw [← orbitTransportEquiv_apply_coe (a := a) (g := g) (k := k) (h := h)
      (x := (orbitTransportEquiv a g k h).symm x)]
    exact congrArg Subtype.val (LinearEquiv.apply_symm_apply _ x)
  rw [h2]
  exact (a.1.apply_symm_apply x.1).symm

/-- `α_g(L)`: the discriminant transport from `L` to the translate `gL`. -/
noncomputable def orbitAlphaTo (g : AmbientOrthogonalGroup L) :
    L.obj.defect ≃ₗ[R] (orbitLattice g).obj.defect :=
  discriminantCarrierEquiv (orbitLatticeIso g)

/-- `α_a(L₀)`: the discriminant transport between two translates of `L`, along an ambient `a`. -/
noncomputable def orbitAlphaTrans (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap) :
    (orbitLattice g).obj.defect ≃ₗ[R] (orbitLattice k).obj.defect :=
  discriminantCarrierEquiv (orbitTransportIso a g k h)

@[simp] theorem orbitAlphaTo_def (g : AmbientOrthogonalGroup L) :
    orbitAlphaTo (L := L) g = discriminantCarrierEquiv (orbitLatticeIso g) := rfl

@[simp] theorem orbitAlphaTrans_def (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap) :
    orbitAlphaTrans (L := L) a g k h =
      discriminantCarrierEquiv (orbitTransportIso a g k h) := rfl

theorem orbitAlphaTo_mk (g : AmbientOrthogonalGroup L) (f : L.obj.valueDual) :
    orbitAlphaTo g (Submodule.Quotient.mk f) =
      Submodule.Quotient.mk (f.comp (orbitCarrierEquiv g).symm.toLinearMap) := by
  rw [orbitAlphaTo_def, discriminantCarrierEquiv_mk, discriminantValueDualEquiv_apply_comp]
  rfl

theorem orbitAlphaTo_symm_mk (g : AmbientOrthogonalGroup L)
    (f : (orbitLattice g).obj.valueDual) :
    (orbitAlphaTo g).symm (Submodule.Quotient.mk f) =
      Submodule.Quotient.mk (f.comp (orbitCarrierEquiv g).toLinearMap) := by
  rw [orbitAlphaTo_def, discriminantCarrierEquiv_symm_mk]
  rfl

theorem orbitAlphaTrans_mk (a g k : AmbientOrthogonalGroup L)
    (h : ambientTranslate L k = (ambientTranslate L g).map (a.1).toLinearMap)
    (f : (orbitLattice g).obj.valueDual) :
    orbitAlphaTrans a g k h (Submodule.Quotient.mk f) =
      Submodule.Quotient.mk (f.comp (orbitTransportEquiv a g k h).symm.toLinearMap) := by
  rw [orbitAlphaTrans_def, discriminantCarrierEquiv_mk, discriminantValueDualEquiv_apply_comp]
  rfl

set_option maxHeartbeats 1000000 in
/-- The loop's inverse, read on the rational span of `L`. -/
theorem schreierLoop_symm_apply (D : AmbientResidueData R L)
    (t : D.ResiduePoint → ↥D.G) (ht : ∀ q, t q • D.baseResidue = q)
    (s : ↥D.G) (p : D.ResiduePoint) (y : L.obj.carrier) :
    toRationalSpan R L
        (((stabilizerOrthogonal (schreierLoop D t ht s p).1.1
          (translate_eq_of_mem_stabilizer D (schreierLoop D t ht s p))).1).symm y) =
      (t p).1.1.symm ((s.1).1.symm ((t (s • p)).1.1 (toRationalSpan R L y))) := by
  have hloop : (schreierLoop D t ht s p).1.1 =
      (t (s • p)).1⁻¹ * s.1 * (t p).1 := rfl
  have hcoe : (((schreierLoop D t ht s p).1.1).1) =
      (((t (s • p)).1.1)⁻¹ * (s.1).1) * (t p).1.1 := by
    rw [hloop]
    simp
  have h := stabilizerOrthogonal_val_toRationalSpan
    (g := (schreierLoop D t ht s p).1.1)
    (translate_eq_of_mem_stabilizer D (schreierLoop D t ht s p))
    (((stabilizerOrthogonal (schreierLoop D t ht s p).1.1
      (translate_eq_of_mem_stabilizer D (schreierLoop D t ht s p))).1).symm y)
  simp only [LinearEquiv.apply_symm_apply] at h
  have h' : toRationalSpan R L
      (((stabilizerOrthogonal (schreierLoop D t ht s p).1.1
        (translate_eq_of_mem_stabilizer D (schreierLoop D t ht s p))).1).symm y) =
      ((((schreierLoop D t ht s p).1.1).1)).symm (toRationalSpan R L y) := by
    rw [h, LinearEquiv.symm_apply_apply]
  rw [h', hcoe, LinearEquiv.symm_apply_eq]
  simp only [mul_apply_eq_comp, LinearEquiv.apply_symm_apply]
  exact (LinearEquiv.symm_apply_apply _ _).symm

/-- The completed loop `k_{s,p}`, as an element of `O(L)`. -/
noncomputable def loopOrthogonal (D : AmbientResidueData R L)
    (t : D.ResiduePoint → ↥D.G) (ht : ∀ q, t q • D.baseResidue = q)
    (s : ↥D.G) (p : D.ResiduePoint) : OrthogonalGroup L :=
  residueStabilizerHom D (schreierLoop D t ht s p)

/-- The loop's discriminant action, as a transformation of `A_L`. -/
noncomputable def loopDefectEquiv (D : AmbientResidueData R L)
    (t : D.ResiduePoint → ↥D.G) (ht : ∀ q, t q • D.baseResidue = q)
    (s : ↥D.G) (p : D.ResiduePoint) :
    L.obj.defect ≃ₗ[R] L.obj.defect :=
  OrthogonalGroup.actOnDefect (loopOrthogonal D t ht s p)

/-- **The three-factor composite** `α_{t_sp}(L)⁻¹ ∘ α_s(L_p) ∘ α_{t_p}(L)`, as a discriminant
transformation of `L`. -/
noncomputable def orbitLoopComposite (D : AmbientResidueData R L)
    (t : D.ResiduePoint → ↥D.G) (ht : ∀ q, t q • D.baseResidue = q)
    (s : ↥D.G) (p : D.ResiduePoint) :
    L.obj.defect ≃ₗ[R] L.obj.defect :=
  ((orbitAlphaTo (L := L) (t p).1).trans
    (orbitAlphaTrans (L := L) s.1 (t p).1 (t (s • p)).1
      (D.translate_smul_eq t ht s p).symm)).trans
    (orbitAlphaTo (L := L) (t (s • p)).1).symm

end LeanCategories.Lattices.Valued
