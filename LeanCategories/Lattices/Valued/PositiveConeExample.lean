module

public import LeanCategories.Lattices.Valued.PositiveConeReflections
public import LeanCategories.Lattices.Valued.Signature

/-!
# A signature `(1, 1)` witness: the reflection in a vector of square `2` swaps the sheets

`PositiveConeReflections` proves `W ≤ O⁺` for the reflections in vectors of *negative* square. This
file checks that the hypothesis cannot be dropped, with the smallest witness: the hyperbolic plane
`Q x = 2 x₀ x₁` on `ℝ²` has signature `(1, 1)`, and `a = (1, 1)` has `Q a = 2`, a positive square.
The reflection in `a` sends `a` to `-a` (`reflectIn_planeForm_swap`), and `a` and `-a` lie on
opposite sheets, so the reflection carries one sheet onto the other: it is an isometry of `Q` and
does not lie in `O⁺(Q)` (`reflectIn_positive_sq_notMem`).

The same phenomenon is what makes `W ≤ O⁺` a statement about a *graded* piece of the root set: the
even-lattice Weyl group is generated by the reflections in the roots of square `-2`, whereas a
reflection in a root of positive square reverses the cone.

## References

* J. G. Ratcliffe, *Foundations of Hyperbolic Manifolds*, 2nd ed., §3.1.
-/

@[expose] public section

open QuadraticMap

namespace LeanCategories.Lattices.Valued

/-- The **hyperbolic plane form** `2 x₀ x₁` on `ℝ²`. -/
noncomputable def planeForm : QuadraticForm ℝ (Fin 2 → ℝ) :=
  matrixQuadraticForm ℝ !![(0 : ℝ), 1; 1, 0]

theorem planeForm_apply (a : Fin 2 → ℝ) : planeForm a = 2 * a 0 * a 1 := by
  simp [planeForm, matrixQuadraticForm, Matrix.toBilin'_apply', Matrix.mulVec, dotProduct,
    Fin.sum_univ_two]
  ring

/-- A binary form whose value is `2 x₀ x₁` has exactly one positive square: `!![1, 1]` is positive
and `!![1, 0]` is a null vector. -/
theorem sigPos_eq_one_of_plane (Q : QuadraticForm ℝ (Fin 2 → ℝ))
    (hval : ∀ a : Fin 2 → ℝ, Q a = 2 * a 0 * a 1) : sigPos Q = 1 := by
  have hpos : 1 ≤ sigPos Q := by
    have hPD : (Q.restrict (Submodule.span ℝ {![1, 1]} : Submodule ℝ (Fin 2 → ℝ))).PosDef := by
      intro v hv
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp v.2
      rw [QuadraticMap.restrict_apply, ← hc, QuadraticMap.map_smul, hval, smul_eq_mul]
      have hv' : c ≠ 0 := by
        intro h0
        exact hv (Subtype.ext (by rw [← hc, h0]; simp))
      have h1 : (![1, 1] : Fin 2 → ℝ) 0 = 1 := rfl
      have h2 : (![1, 1] : Fin 2 → ℝ) 1 = 1 := rfl
      rw [h1, h2]
      nlinarith [mul_self_pos.mpr hv']
    have hle := le_sigPos_of_posDef (Q := Q) hPD
    rw [show Module.finrank ℝ (Submodule.span ℝ {![1, 1]} : Submodule ℝ (Fin 2 → ℝ)) = 1 from by
      rw [finrank_span_singleton]
      simp] at hle
    simpa using hle
  have hle : sigPos Q ≤ 1 := by
    have h := QuadraticForm.sigPos_add_finrank_le_of_nonpos (Q := Q)
      (V := Submodule.span ℝ {![1, 0]}) ?_
    · rw [show Module.finrank ℝ (Submodule.span ℝ {![1, 0]} : Submodule ℝ (Fin 2 → ℝ)) = 1 from by
        rw [finrank_span_singleton]; simp,
        Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at h
      simpa using h
    · intro x hx
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hx
      rw [← hc, QuadraticMap.map_smul, hval, smul_eq_mul]
      have h0 : (![1, 0] : Fin 2 → ℝ) 1 = 0 := rfl
      rw [h0]
      nlinarith [sq_nonneg c]
  omega

/-- A binary form whose value is `2 x₀ x₁` has exactly one negative square: `!![1, -1]` is
negative and `!![1, 0]` is a null vector. -/
theorem sigNeg_eq_one_of_plane (Q : QuadraticForm ℝ (Fin 2 → ℝ))
    (hval : ∀ a : Fin 2 → ℝ, Q a = 2 * a 0 * a 1) : sigNeg Q = 1 := by
  have hpos : 1 ≤ sigNeg Q := by
    have hND : ((-Q).restrict (Submodule.span ℝ {![1, -1]} : Submodule ℝ (Fin 2 → ℝ))).PosDef := by
      intro v hv
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp v.2
      rw [QuadraticMap.restrict_apply, ← hc, QuadraticMap.map_smul, neg_apply, hval,
        smul_eq_mul]
      have hv' : c ≠ 0 := by
        intro h0
        exact hv (Subtype.ext (by rw [← hc, h0]; simp))
      have h1 : (![1, -1] : Fin 2 → ℝ) 0 = 1 := rfl
      have h2 : (![1, -1] : Fin 2 → ℝ) 1 = -1 := rfl
      rw [h1, h2]
      nlinarith [mul_self_pos.mpr hv']
    have hle := le_sigNeg_of_negDef (Q := Q) hND
    rw [show Module.finrank ℝ (Submodule.span ℝ {![1, -1]} : Submodule ℝ (Fin 2 → ℝ)) = 1 from by
      rw [finrank_span_singleton]
      simp] at hle
    simpa using hle
  have hle : sigNeg Q ≤ 1 := by
    have h := QuadraticForm.sigPos_add_finrank_le_of_nonpos (Q := -Q)
      (V := Submodule.span ℝ {![1, 0]}) ?_
    · rw [show Module.finrank ℝ (Submodule.span ℝ {![1, 0]} : Submodule ℝ (Fin 2 → ℝ)) = 1 from by
        rw [finrank_span_singleton]; simp,
        Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at h
      rw [sigPos_neg] at h
      omega
    · intro x hx
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hx
      rw [← hc, QuadraticMap.map_smul, neg_apply, hval, smul_eq_mul]
      have h0 : (![1, 0] : Fin 2 → ℝ) 1 = 0 := rfl
      rw [h0]
      nlinarith [sq_nonneg c]
  omega

theorem sigPos_planeForm : sigPos planeForm = 1 :=
  sigPos_eq_one_of_plane planeForm planeForm_apply

theorem sigNeg_planeForm : sigNeg planeForm = 1 :=
  sigNeg_eq_one_of_plane planeForm planeForm_apply

/-- The plane form has signature `(1, 1)`. -/
theorem planeForm_signature : (sigPos planeForm, sigNeg planeForm) = (1, 1) := by
  rw [sigPos_planeForm, sigNeg_planeForm]

/-- The vector `(1, 1)` has square `2`: a vector of *positive* square in signature `(1, 1)`. -/
theorem planeForm_square_two : planeForm ![1, 1] = 2 := by
  rw [planeForm_apply]
  norm_num

/-- **The reflection in a vector of square `2` sends it to its negative.** -/
theorem reflectIn_planeForm_swap :
    reflectIn planeForm ![1, 1] (by rw [planeForm_square_two]; norm_num) ![1, 1] =
      -![1, 1] := by
  have h := associated_self_apply planeForm (![1, 1] : Fin 2 → ℝ)
  rw [planeForm_square_two] at h
  rw [reflectIn_apply, h]
  funext i
  fin_cases i <;> rw [planeForm_square_two] <;> norm_num

/-- **A vector of positive square lies outside `O⁺`**: the reflection in `(1, 1)` is an isometry of
the plane form, and it carries the sheet containing `(1, 1)` to the other one. -/
theorem reflectIn_positive_sq_notMem :
    reflectIn planeForm ![1, 1] (by rw [planeForm_square_two]; norm_num) ∉
      positiveConeStabilizer planeForm sigPos_planeForm (![1, 1] : Fin 2 → ℝ)
        (planeForm_square_two ▸ (by norm_num : (0 : ℝ) < 2)) := by
  intro hmem
  rw [mem_positiveConeStabilizer_iff] at hmem
  have hsheet : (![1, 1] : Fin 2 → ℝ) ∈
      positiveCone.upper planeForm (![1, 1] : Fin 2 → ℝ) := by
    refine ⟨planeForm_square_two ▸ (by norm_num : (0 : ℝ) < 2), ?_⟩
    rw [associated_self_apply, planeForm_square_two]
    norm_num
  have himg : -( ![1, 1] : Fin 2 → ℝ) ∈
      positiveCone.upper planeForm (![1, 1] : Fin 2 → ℝ) := by
    rw [← hmem]
    exact ⟨_, hsheet, reflectIn_planeForm_swap⟩
  rw [neg_mem_upper_iff] at himg
  exact absurd hsheet.2 (not_lt.mpr himg.2.le)

end LeanCategories.Lattices.Valued
