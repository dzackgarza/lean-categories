module

public import LeanCategories.Lattices.Valued.Standard
public import Mathlib.Combinatorics.SimpleGraph.CycleGraph

/-!
# Affine simply-laced ADE diagram data

Definition-level realization of Peters--Sterk FC11-C04-U005.  The source
uses the extended simply-laced A--D--E diagrams together with their positive
mark vectors.  This file records only the diagram, negative Gram, mark, and
distinguished affine-node data.

Semidefiniteness, the null-vector identity for the marks, the dimension of
the radical, deletion of the affine node, and the finite/affine
classification are result content and are not included here.
-/

@[expose] public noncomputable section

namespace LeanCategories.Lattices.Valued

open Matrix SimpleGraph

/-- The affine simply-laced ADE families.  The family parameters are left
unrestricted at the data level; `AffineADEType.Valid` records the source
range. -/
inductive AffineADEType where
  | A (n : ℕ)
  | D (n : ℕ)
  | E6
  | E7
  | E8
  deriving DecidableEq

namespace AffineADEType

/-- Number of vertices: one more than the rank of the corresponding finite
diagram. -/
def nodes : AffineADEType → ℕ
  | .A n => n + 1
  | .D n => n + 1
  | .E6 => 7
  | .E7 => 8
  | .E8 => 9

/-- The source ranges for the affine ADE names. -/
def Valid : AffineADEType → Prop
  | .A n => 1 ≤ n
  | .D n => 4 ≤ n
  | .E6 | .E7 | .E8 => True

/-- Oriented edge data for affine `Dₙ`.  `SimpleGraph.fromRel` supplies
the symmetric loopless graph generated by these edges. -/
def dRel (n : ℕ) (i j : Fin (n + 1)) : Prop :=
  ((i : ℕ) + 1 = (j : ℕ) ∧ (j : ℕ) ≤ n - 2) ∨
    ((i : ℕ) = 1 ∧ (j : ℕ) = n - 1) ∨
      ((i : ℕ) = n - 3 ∧ (j : ℕ) = n)

def e6Edges : List (Fin 7 × Fin 7) :=
  [(0, 1), (1, 2), (0, 3), (3, 4), (0, 5), (5, 6)]

def e7Edges : List (Fin 8 × Fin 8) :=
  [(0, 1), (0, 2), (2, 3), (3, 4), (0, 5), (5, 6), (6, 7)]

def e8Edges : List (Fin 9 × Fin 9) :=
  [(0, 1), (0, 2), (2, 3), (0, 4), (4, 5), (5, 6), (6, 7), (7, 8)]

/-- The underlying affine ADE graph, with the reference numbering.  At
`A 1` the graph remembers the two vertices and their adjacency; the
double-edge multiplicity is carried by `negativeGramMatrix`. -/
def graph : (t : AffineADEType) → SimpleGraph (Fin t.nodes)
  | .A n => SimpleGraph.cycleGraph (n + 1)
  | .D n => SimpleGraph.fromRel (dRel n)
  | .E6 => SimpleGraph.fromRel fun i j => (i, j) ∈ e6Edges
  | .E7 => SimpleGraph.fromRel fun i j => (i, j) ∈ e7Edges
  | .E8 => SimpleGraph.fromRel fun i j => (i, j) ∈ e8Edges

/-- The negative simply-laced affine ADE Gram matrix.  The affine
`A₁` diagram has the multiplicity-two off-diagonal pairing `2`; all
other diagrams have square `-2`, pairing `1` along an edge, and zero
otherwise. -/
noncomputable def negativeGramMatrix (t : AffineADEType) :
    Matrix (Fin t.nodes) (Fin t.nodes) ℤ := by
  classical
  exact match t with
    | .A 1 => !![-2, 2; 2, -2]
    | x => fun i j =>
        if i = j then -2 else if x.graph.Adj i j then 1 else 0

/-- The affine-D marks: `2` on the interior of the long path and `1`
on the four leaves. -/
def dMarks (n : ℕ) (i : Fin (n + 1)) : ℤ :=
  if 1 ≤ (i : ℕ) ∧ (i : ℕ) ≤ n - 3 then 2 else 1

/-- The standard mark vector attached to an affine ADE diagram. -/
def marks : (t : AffineADEType) → Fin t.nodes → ℤ
  | .A _ => fun _ => 1
  | .D n => dMarks n
  | .E6 => ![3, 2, 1, 2, 1, 2, 1]
  | .E7 => ![4, 2, 3, 2, 1, 3, 2, 1]
  | .E8 => ![6, 3, 4, 2, 5, 4, 3, 2, 1]

/-- The natural-number index of the distinguished extending vertex in the
reference numbering. -/
def affineNodeIndex : AffineADEType → ℕ
  | .A _ => 0
  | .D _ => 0
  | .E6 => 2
  | .E7 => 4
  | .E8 => 8

end AffineADEType

end LeanCategories.Lattices.Valued
