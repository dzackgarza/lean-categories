@[expose] public section

namespace LeanCategories.Lattices.Valued

open Set

variable {ι M : Type*} [Fintype ι] [DecidableEq ι] [AddCommGroup M] [Module ℝ M]

/-! ## The AET data of Definition 4.16 -/

/-- The closed fundamental chamber `K = {x | ∀ k, 0 ≤ φ_k x}` of Alexeev–Engel–Thompson,
Definition 4.16, in the form `K = ⋂_k H⁺_{r_k}` (the intersection with the positive cone `C` is
carried by the consumer, where `C` is available). -/
def aetChamber (φ : ι → M →ₗ[ℝ] ℝ) : Set M := {x | ∀ i, 0 ≤ φ i x}

@[simp] theorem mem_aetChamber {φ : ι → M →ₗ[ℝ] ℝ} {x : M} :
    x ∈ aetChamber φ ↔ ∀ i, 0 ≤ φ i x := Iff.rfl

/-- The face `F_V = K ∩ ⋂_{i ∈ V} ker φ_i` of the fundamental chamber: the face of `K` cut out
by the simple mirrors in `V` (Definition 4.16). -/
def aetChamberFace (φ : ι → M →ₗ[ℝ] ℝ) (V : Finset ι) : Set M :=
  {x | (∀ i, 0 ≤ φ i x) ∧ ∀ i ∈ V, φ i x = 0}

theorem aetChamberFace_eq_inter (φ : ι → M →ₗ[ℝ] ℝ) (V : Finset ι) :
    aetChamberFace φ V = aetChamber φ ∩ {x | ∀ i ∈ V, φ i x = 0} := rfl

@[simp] theorem mem_aetChamberFace {φ : ι → M →ₗ[ℝ] ℝ} {V : Finset ι} {x : M} :
    x ∈ aetChamberFace φ V ↔ (∀ i, 0 ≤ φ i x) ∧ ∀ i ∈ V, φ i x = 0 := Iff.rfl

/-- **AET Definition 4.16: relevant faces.** A face `F_V` of the chamber is *irrelevant* when it
is cut out by inactive mirrors alone, i.e. when `V ⊆ J`; `IsRelevant J V` is the complement of
that condition, `∃ i ∈ V, i ∉ J`. -/
def AET.IsRelevant (J V : Finset ι) : Prop := ∃ i ∈ V, i ∉ J

theorem aet_isRelevant_iff_not_subset {J V : Finset ι} :
    AET.IsRelevant J V ↔ ¬ V ⊆ J := by
  simp only [AET.IsRelevant, Finset.subset_iff, not_forall]
  exact ⟨fun ⟨i, hiV, hiJ⟩ => ⟨i, hiV, hiJ⟩, fun ⟨i, hiV, hiJ⟩ => ⟨i, hiV, hiJ⟩⟩

/-- **AET Definition 4.16: the generalized chamber** `L = ⋃_{h ∈ W_J} h(K)`. -/
noncomputable def aetGeneralizedChamber (φ : ι → M →ₗ[ℝ] ℝ)
    (WJ : Subgroup (M ≃ₗ[ℝ] M)) : Set M :=
  ⋃ g : WJ, (g : M ≃ₗ[ℝ] M) '' aetChamber φ

theorem mem_aetGeneralizedChamber {φ : ι → M →ₗ[ℝ] ℝ} {WJ : Subgroup (M ≃ₗ[ℝ] M)} {x : M} :
    x ∈ aetGeneralizedChamber φ WJ ↔ ∃ g : WJ, ∃ y ∈ aetChamber φ, (g : M ≃ₗ[ℝ] M) y = x := by
  simp only [aetGeneralizedChamber, Set.mem_iUnion, Set.mem_image]

/-- The truncation `L_V = L ∩ ⋂_{i ∈ V} ker φ_i` of the generalized chamber by the simple
mirrors in `V`: the candidate faces of a maximal cone of the semifan. -/
noncomputable def aetGeneralizedChamberFace (φ : ι → M →ₗ[ℝ] ℝ)
    (WJ : Subgroup (M ≃ₗ[ℝ] M)) (V : Finset ι) : Set M :=
  aetGeneralizedChamber φ WJ ∩ {x | ∀ i ∈ V, φ i x = 0}

@[simp] theorem mem_aetGeneralizedChamberFace {φ : ι → M →ₗ[ℝ] ℝ}
    {WJ : Subgroup (M ≃ₗ[ℝ] M)} {V : Finset ι} {x : M} :
    x ∈ aetGeneralizedChamberFace φ WJ V ↔
      x ∈ aetGeneralizedChamber φ WJ ∧ ∀ i ∈ V, φ i x = 0 := Iff.rfl

/-- **AET Proposition 4.17(4): the generalized Coxeter semifan.** The family whose members are
the `W`-translates of the generalized chamber `L` and the `W`-translates of the *relevant* faces
of the fundamental chamber. No finiteness of `W_J` and no finiteness of the family is assumed. -/
noncomputable def aetWythoffSemifan (φ : ι → M →ₗ[ℝ] ℝ) (J : Finset ι)
    (W WJ : Subgroup (M ≃ₗ[ℝ] M)) : Set (Set M) :=
  {D | ∃ g ∈ W, D = (g : M ≃ₗ[ℝ] M) '' aetGeneralizedChamber φ WJ} ∪
  {D | ∃ g ∈ W, ∃ V : Finset ι, AET.IsRelevant J V ∧ D = (g : M ≃ₗ[ℝ] M) '' aetChamberFace φ V}

theorem mem_aetWythoffSemifan {φ : ι → M →ₗ[ℝ] ℝ} {J : Finset ι} {W WJ : Subgroup (M ≃ₗ[ℝ] M)}
    {D : Set M} :
    D ∈ aetWythoffSemifan φ J W WJ ↔
      (∃ g ∈ W, D = (g : M ≃ₗ[ℝ] M) '' aetGeneralizedChamber φ WJ) ∨
      (∃ g ∈ W, ∃ V : Finset ι, AET.IsRelevant J V ∧
        D = (g : M ≃ₗ[ℝ] M) '' aetChamberFace φ V) := Iff.rfl

/-- The maximal members of the semifan: the `W`-translates of `L`. -/
def IsMaximalCone (φ : ι → M →ₗ[ℝ] ℝ) (WJ : Subgroup (M ≃ₗ[ℝ] M))
    (W : Subgroup (M ≃ₗ[ℝ] M)) (D : Set M) : Prop :=
  ∃ g ∈ W, D = (g : M ≃ₗ[ℝ] M) '' aetGeneralizedChamber φ WJ

/-! ## The face relation on sets

Mathlib's `PointedCone.IsFaceOf` (`Mathlib/Geometry/Convex/Cone/Face/Basic.lean`, © Olivia
Röhrig, Apache 2.0) is the cone-level relation this section ports: `IsConeFace Φ D` says `Φ ⊆ D`
and that `x, y ∈ D` with `x + y ∈ Φ` forces `x, y ∈ Φ`. The port is at the level of sets because
the maximal cone `L` of Definition 4.16 is not known to be a `PointedCone` without Proposition
4.17(1); `.of_isFaceOf` recovers the cone-level relation. -/

/-- `Φ` is a face of the cone `D`. -/
def IsConeFace (Φ D : Set M) : Prop :=
  Φ ⊆ D ∧ ∀ x ∈ D, ∀ y ∈ D, x + y ∈ Φ → x ∈ Φ ∧ y ∈ Φ

theorem IsConeFace.refl (D : Set M) : IsConeFace D D :=
  ⟨subset_rfl, fun x hx y hy _ => ⟨hx, hy⟩⟩

theorem IsConeFace.trans {Φ Ψ D : Set M} (h1 : IsConeFace Φ Ψ) (h2 : IsConeFace Ψ D) :
    IsConeFace Φ D := by
  refine ⟨h1.1.trans h2.1, ?_⟩
  intro x hx y hy hxy
  obtain ⟨hxΨ, hyΨ⟩ := h2.2 x hx y hy (h1.1 hxy)
  exact h1.2 x hxΨ y hyΨ hxy

/-- An intersection of faces of `D` (an arbitrary nonempty intersection) is a face of `D`. -/
theorem IsConeFace.iInter {κ : Type*} {Φ : κ → Set M} {D : Set M}
    (h : ∀ k, IsConeFace (Φ k) D) (hne : Nonempty κ) : IsConeFace (⋂ k, Φ k) D := by
  refine ⟨?_, ?_⟩
  · intro x hx
    obtain ⟨k⟩ := hne
    exact (h k).1 (Set.mem_iInter.mp hx k)
  · intro x hx y hy hxy
    exact ⟨Set.mem_iInter.mpr fun k => ((h k).2 x hx y hy (Set.mem_iInter.mp hxy k)).1,
      Set.mem_iInter.mpr fun k => ((h k).2 x hx y hy (Set.mem_iInter.mp hxy k)).2⟩

/-- The image of a face under a linear equivalence is a face of the image of the cone. -/
theorem IsConeFace.image (g : M ≃ₗ[ℝ] M) {Φ D : Set M} (h : IsConeFace Φ D) :
    IsConeFace (g '' Φ) (g '' D) := by
  refine ⟨Set.image_mono h.1, ?_⟩
  rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩ ⟨z, hz, hzy⟩
  have hsum : x + y ∈ Φ := by
    have hgz : g (x + y) = g z := by rw [map_add, hzy]
    exact g.injective hgz ▸ hz
  obtain ⟨hx', hy'⟩ := h.2 x hx y hy hsum
  exact ⟨⟨x, hx', rfl⟩, ⟨y, hy', rfl⟩⟩

/-- The preimage of a face under a linear equivalence is a face of the preimage. -/
theorem IsConeFace.preimage (g : M ≃ₗ[ℝ] M) {Φ D : Set M} (h : IsConeFace Φ D) :
    IsConeFace (g ⁻¹' Φ) (g ⁻¹' D) := by
  refine ⟨fun x hx => h.1 hx, ?_⟩
  intro x hx y hy hxy
  have hxy' : g x + g y ∈ Φ := by rw [← map_add]; exact hxy
  obtain ⟨hx', hy'⟩ := h.2 (g x) hx (g y) hy hxy'
  exact ⟨hx', hy'⟩

/-- Mathlib's cone-level face relation implies the set-level relation of this file. -/
theorem IsConeFace.of_isFaceOf {C F : PointedCone ℝ M} (h : F.IsFaceOf C) :
    IsConeFace (F : Set M) (C : Set M) :=
  ⟨fun x hx => h.le hx, fun x hx y hy hxy => ⟨h.mem_of_add_mem_left hx hy hxy,
    h.mem_of_add_mem_right hx hy hxy⟩⟩

/-! ## Faces of the fundamental chamber -/

section Chamber

variable (φ : ι → M →ₗ[ℝ] ℝ)

theorem aetChamberFace_isConeFace_chamber (V : Finset ι) :
    IsConeFace (aetChamberFace φ V) (aetChamber φ) := by
  refine ⟨fun _ hx => hx.1, ?_⟩
  intro x hx y hy hxy
  have key : ∀ i ∈ V, φ i x = 0 ∧ φ i y = 0 := by
    intro i hi
    have hsum : φ i (x + y) = 0 := hxy.2 i hi
    rw [map_add] at hsum
    have h1 : 0 ≤ φ i x := hx i
    have h2 : 0 ≤ φ i y := hy i
    constructor <;> linarith
  exact ⟨⟨hx, fun i hi => (key i hi).1⟩, ⟨hy, fun i hi => (key i hi).2⟩⟩

theorem aetChamberFace_antitone {V W : Finset ι} (h : V ⊆ W) :
    aetChamberFace φ W ⊆ aetChamberFace φ V :=
  fun _ hx => ⟨hx.1, fun i hi => hx.2 i (h hi)⟩

/-- A chamber face is a face of every chamber face that contains it. -/
theorem aetChamberFace_isConeFace_of_subset {V W : Finset ι} (h : V ⊆ W) :
    IsConeFace (aetChamberFace φ W) (aetChamberFace φ V) := by
  refine ⟨aetChamberFace_antitone φ h, ?_⟩
  intro x hx y hy hxy
  have key : ∀ i ∈ W, φ i x = 0 ∧ φ i y = 0 := by
    intro i hi
    have hsum : φ i (x + y) = 0 := hxy.2 i hi
    rw [map_add] at hsum
    have h1 : 0 ≤ φ i x := hx.1 i
    have h2 : 0 ≤ φ i y := hy.1 i
    constructor <;> linarith
  exact ⟨⟨hx.1, fun i hi => (key i hi).1⟩, ⟨hy.1, fun i hi => (key i hi).2⟩⟩

theorem aetChamberFace_inter (V W : Finset ι) :
    aetChamberFace φ (V ∪ W) = aetChamberFace φ V ∩ aetChamberFace φ W := by
  ext x
  constructor
  · intro hx
    exact ⟨⟨hx.1, fun i hi => hx.2 i (Finset.mem_union_left _ hi)⟩,
      ⟨hx.1, fun i hi => hx.2 i (Finset.mem_union_right _ hi)⟩⟩
  · rintro ⟨⟨h1, h2⟩, ⟨-, h3⟩⟩
    exact ⟨h1, fun i hi => (Finset.mem_union.mp hi).elim (h2 i) (h3 i)⟩

theorem aetChamberFace_subset_aetChamber (V : Finset ι) :
    aetChamberFace φ V ⊆ aetChamber φ := fun _ hx => hx.1

end Chamber

/-! ## The generalized chamber and its truncations -/

section Generalized

variable (φ : ι → M →ₗ[ℝ] ℝ) (J : Finset ι) (WJ : Subgroup (M ≃ₗ[ℝ] M))

theorem aetChamber_subset_aetGeneralizedChamber :
    aetChamber φ ⊆ aetGeneralizedChamber φ WJ :=
  fun _ hx => mem_aetGeneralizedChamber.mpr ⟨1, _, hx, rfl⟩

theorem aetChamberFace_subset_aetGeneralizedChamber (V : Finset ι) :
    aetChamberFace φ V ⊆ aetGeneralizedChamber φ WJ :=
  (aetChamberFace_subset_aetChamber φ V).trans (aetChamber_subset_aetGeneralizedChamber φ WJ)

/-- The generalized chamber is stable under its standard parabolic `W_J`. -/
theorem aetGeneralizedChamber_smul_mem {x : M} (hx : x ∈ aetGeneralizedChamber φ WJ)
    (g : WJ) : (g : M ≃ₗ[ℝ] M) x ∈ aetGeneralizedChamber φ WJ := by
  obtain ⟨h, y, hy, rfl⟩ := mem_aetGeneralizedChamber.mp hx
  exact mem_aetGeneralizedChamber.mpr ⟨g * h, y, hy, rfl⟩

/-- A truncation of the generalized chamber is the union, over the chambers of the parabolic
orbit, of the corresponding truncations of those chambers. -/
theorem aetGeneralizedChamberFace_eq_iUnion (V : Finset ι) :
    aetGeneralizedChamberFace φ WJ V =
      ⋃ g : WJ, (g : M ≃ₗ[ℝ] M) ''
        (aetChamber φ ∩ {y | ∀ i ∈ V, φ i ((g : M ≃ₗ[ℝ] M) y) = 0}) := by
  ext x
  simp only [aetGeneralizedChamberFace, aetGeneralizedChamber, Set.mem_inter_iff,
    Set.mem_setOf_eq, Set.mem_iUnion, Set.mem_image]
  constructor
  · rintro ⟨⟨g, y, hy, rfl⟩, hV⟩
    exact ⟨g, y, ⟨hy, fun i hi => hV i hi⟩, rfl⟩
  · rintro ⟨g, y, ⟨hy, hVy⟩, rfl⟩
    exact ⟨⟨g, y, hy, rfl⟩, fun i hi => hVy i hi⟩

theorem aetChamberFace_subset_aetGeneralizedChamberFace (V : Finset ι) :
    aetChamberFace φ V ⊆ aetGeneralizedChamberFace φ WJ V :=
  fun _ hx => ⟨aetChamberFace_subset_aetGeneralizedChamber φ WJ V hx, hx.2⟩

theorem aetGeneralizedChamberFace_antitone {V U : Finset ι} (h : V ⊆ U) :
    aetGeneralizedChamberFace φ WJ U ⊆ aetGeneralizedChamberFace φ WJ V :=
  fun _ hx => ⟨hx.1, fun i hi => hx.2 i (h hi)⟩

theorem aetGeneralizedChamberFace_inter (V U : Finset ι) :
    aetGeneralizedChamberFace φ WJ (V ∪ U) =
      aetGeneralizedChamberFace φ WJ V ∩ aetGeneralizedChamberFace φ WJ U := by
  ext x
  simp only [aetGeneralizedChamberFace, Set.mem_inter_iff, Set.mem_setOf_eq]
  constructor
  · rintro ⟨hL, hVU⟩
    exact ⟨⟨hL, fun i hi => hVU i (Finset.mem_union_left _ hi)⟩,
      ⟨hL, fun i hi => hVU i (Finset.mem_union_right _ hi)⟩⟩
  · rintro ⟨⟨hL, hV⟩, ⟨-, hU⟩⟩
    exact ⟨hL, fun i hi => (Finset.mem_union.mp hi).elim (hV i) (hU i)⟩

/-- **AET Proposition 4.17(1), forward half, in the form the face statements use**: an active
simple functional is nonnegative on the parabolic orbit of the fundamental chamber. -/
theorem nonneg_of_mem_aetGeneralizedChamber
    (hL : ∀ i, i ∉ J → ∀ g : WJ, ∀ y : M, y ∈ aetChamber φ → 0 ≤ φ i ((g : M ≃ₗ[ℝ] M) y))
    {x : M} (hx : x ∈ aetGeneralizedChamber φ WJ) {i : ι} (hi : i ∉ J) : 0 ≤ φ i x := by
  obtain ⟨g, y, hy, rfl⟩ := mem_aetGeneralizedChamber.mp hx
  exact hL i hi g y hy

/-- **The relevant-face statement (AET Proposition 4.17(4), face half).** A truncation of the
generalized chamber by *active* simple mirrors is a face of the generalized chamber. -/
theorem aetGeneralizedChamberFace_isConeFace (V : Finset ι)
    (hL : ∀ i, i ∉ J → ∀ g : WJ, ∀ y : M, y ∈ aetChamber φ → 0 ≤ φ i ((g : M ≃ₗ[ℝ] M) y))
    (hV : ∀ i ∈ V, i ∉ J) :
    IsConeFace (aetGeneralizedChamberFace φ WJ V) (aetGeneralizedChamber φ WJ) := by
  refine ⟨fun _ hx => hx.1, ?_⟩
  intro x hx y hy hxy
  have key : ∀ i ∈ V, φ i x = 0 ∧ φ i y = 0 := by
    intro i hi
    have h1 : 0 ≤ φ i x := nonneg_of_mem_aetGeneralizedChamber φ J WJ hL hx (hV i hi)
    have h2 : 0 ≤ φ i y := nonneg_of_mem_aetGeneralizedChamber φ J WJ hL hy (hV i hi)
    have hsum : φ i (x + y) = 0 := hxy.2 i hi
    rw [map_add] at hsum
    constructor <;> linarith
  exact ⟨⟨hx, fun i hi => (key i hi).1⟩, ⟨hy, fun i hi => (key i hi).2⟩⟩

/-- **The irrelevant-face exclusion (AET, proof of Proposition 4.17(4)).** A truncation of the
generalized chamber by a single *inactive* mirror is **not** a face of the generalized chamber,
whenever the generalized chamber is closed under addition (a consequence of Proposition 4.17(1))
and the inactive reflection changes the sign of its mirror while preserving `L`: for `y ∈ L` with
`φ_j y ≠ 0`, the points `y` and `s y` of `L` add up to a point of the mirror, while `y` is not on
it. This is the precise sense in which the family must consist of the *relevant* faces. -/
theorem aetGeneralizedChamberFace_singleton_not_isConeFace
    (hadd : ∀ x ∈ aetGeneralizedChamber φ WJ, ∀ y ∈ aetGeneralizedChamber φ WJ,
      x + y ∈ aetGeneralizedChamber φ WJ)
    (j : ι) (hj : j ∈ J)
    (hrefl : ∃ s : WJ, ∀ x : M, φ j ((s : M ≃ₗ[ℝ] M) x) = -φ j x)
    (y : M) (hy : y ∈ aetGeneralizedChamber φ WJ) (hy0 : φ j y ≠ 0) :
    ¬ IsConeFace (aetGeneralizedChamberFace φ WJ {j}) (aetGeneralizedChamber φ WJ) := by
  intro hface
  obtain ⟨s, hs⟩ := hrefl
  have hsy : (s : M ≃ₗ[ℝ] M) y ∈ aetGeneralizedChamber φ WJ :=
    aetGeneralizedChamber_smul_mem φ WJ hy s
  have hsum : y + (s : M ≃ₗ[ℝ] M) y ∈ aetGeneralizedChamberFace φ WJ {j} := by
    refine ⟨hadd y hy _ hsy, ?_⟩
    intro i hi
    have hij : i = j := by simpa using hi
    subst hij
    rw [map_add, hs, add_neg_cancel]
  have := hface.2 y hy ((s : M ≃ₗ[ℝ] M) y) hsy hsum
  exact hy0 (this.1.2 j (by simp))

end Generalized

/-! ## Intersections -/

section Intersection

variable (φ : ι → M →ₗ[ℝ] ℝ) (J : Finset ι) (WJ : Subgroup (M ≃ₗ[ℝ] M))

/-- The intersection of two chamber faces of one chamber translate is the chamber face of the
union — a cone of the same type. -/
theorem aetChamberFace_inter_at (g : M ≃ₗ[ℝ] M) (V U : Finset ι) :
    (g '' aetChamberFace φ V) ∩ (g '' aetChamberFace φ U) = g '' aetChamberFace φ (V ∪ U) := by
  rw [aetChamberFace_inter, Set.image_inter g.injective]

/-- **Intersection of the truncations of a maximal cone**: the truncations by active mirrors are
closed under intersections, and the intersection of two of them is a face of each. -/
theorem aetGeneralizedChamberFace_isConeFace_inter {V U : Finset ι}
    (hL : ∀ i, i ∉ J → ∀ g : WJ, ∀ y : M, y ∈ aetChamber φ → 0 ≤ φ i ((g : M ≃ₗ[ℝ] M) y))
    (hV : ∀ i ∈ V, i ∉ J) (hU : ∀ i ∈ U, i ∉ J) :
    IsConeFace (aetGeneralizedChamberFace φ WJ (V ∪ U)) (aetGeneralizedChamberFace φ WJ V) := by
  refine ⟨aetGeneralizedChamberFace_antitone φ WJ Finset.subset_union_left, ?_⟩
  intro x hx y hy hxy
  have h1 : x ∈ aetGeneralizedChamber φ WJ := hx.1
  have h2 : y ∈ aetGeneralizedChamber φ WJ := hy.1
  have key : ∀ i ∈ V ∪ U, φ i x = 0 ∧ φ i y = 0 := by
    intro i hi
    have hiJ : i ∉ J := (Finset.mem_union.mp hi).elim (hV i) (hU i)
    have hx0 : 0 ≤ φ i x := nonneg_of_mem_aetGeneralizedChamber φ J WJ hL h1 hiJ
    have hy0 : 0 ≤ φ i y := nonneg_of_mem_aetGeneralizedChamber φ J WJ hL h2 hiJ
    have hsum : φ i (x + y) = 0 := hxy.2 i hi
    rw [map_add] at hsum
    constructor <;> linarith
  exact ⟨⟨h1, fun i hi => (key i hi).1⟩, ⟨h2, fun i hi => (key i hi).2⟩⟩

end Intersection

/-! ## Full `W`-equivariance -/

section Equivariance

variable (φ : ι → M →ₗ[ℝ] ℝ) (J : Finset ι) (W WJ : Subgroup (M ≃ₗ[ℝ] M))

theorem image_mul_image (g h : M ≃ₗ[ℝ] M) (D : Set M) : g '' (h '' D) = (g * h) '' D := by
  rw [Set.image_image]
  rfl

/-- **Full `W`-equivariance, cone by cone.** The translate of a member of the semifan by an
element of the whole Weyl group `W` is again a member: the family is stable under `W`, not only
under the parabolic `W_J`. -/
theorem aetWythoffSemifan_smul_mem {D : Set M} (hD : D ∈ aetWythoffSemifan φ J W WJ)
    {g : M ≃ₗ[ℝ] M} (hg : g ∈ W) : g '' D ∈ aetWythoffSemifan φ J W WJ := by
  rcases mem_aetWythoffSemifan.mp hD with ⟨h, hh, rfl⟩ | ⟨h, hh, V, hV, rfl⟩
  · exact mem_aetWythoffSemifan.mpr
      (Or.inl ⟨g * h, W.mul_mem hg hh, image_mul_image g h _⟩)
  · exact mem_aetWythoffSemifan.mpr
      (Or.inr ⟨g * h, W.mul_mem hg hh, V, hV, image_mul_image g h _⟩)

/-- **Full `W`-equivariance**: the semifan is `W`-invariant as a family of cones. -/
theorem aetWythoffSemifan_equivariant (g : M ≃ₗ[ℝ] M) (hg : g ∈ W) :
    (fun D => g '' D) '' aetWythoffSemifan φ J W WJ = aetWythoffSemifan φ J W WJ := by
  refine Set.Subset.antisymm ?_ ?_
  · rintro _ ⟨D, hD, rfl⟩
    exact aetWythoffSemifan_smul_mem φ J W WJ hD hg
  · intro D hD
    refine ⟨g.symm '' D, aetWythoffSemifan_smul_mem φ J W WJ hD (W.inv_mem hg), ?_⟩
    show g '' (g.symm '' D) = D
    rw [Set.image_image]
    simp

end Equivariance

/-! ## Face closure of the semifan -/

section FaceClosure

variable (φ : ι → M →ₗ[ℝ] ℝ) (J : Finset ι) (W WJ : Subgroup (M ≃ₗ[ℝ] M))

theorem AET.IsRelevant.mono {V U : Finset ι} (h : V ⊆ U) (hV : AET.IsRelevant J V) :
    AET.IsRelevant J U := by
  obtain ⟨i, hiV, hiJ⟩ := hV
  exact ⟨i, h hiV, hiJ⟩

/-- The image of a member of the semifan is the union of the images of the pieces. -/
theorem image_iUnion_WJ (g : M ≃ₗ[ℝ] M) (F : WJ → Set M) :
    g '' (⋃ h : WJ, F h) = ⋃ h : WJ, g '' F h :=
  Set.image_iUnion

/-- **Face closure of the Wythoff semifan**, member by member.

(a) A cone of chamber-face type is a chamber face; every face of it cut out by simple mirrors is
again a cone of the family — face closure in the literal sense for these members.

(b) A maximal cone `g(L)` has, for each set `V` of *active* mirrors, the truncation `g(L_V)` as a
face, and that face is the union over `W_J` of the faces of the individual chambers
`g h(K ∩ ⋂_{i ∈ V} ker (φ_i ∘ h))`. Each piece is a face of the chamber `g h(K)` and hence of
`g(L)`; when `W_J` is infinite the union is infinite, so the face is not in general a cone of the
family, which is exactly what distinguishes a semifan from a fan (Remark 4.19). -/
theorem aetWythoffSemifan_faceClosure
    (hL : ∀ i, i ∉ J → ∀ g : WJ, ∀ y : M, y ∈ aetChamber φ → 0 ≤ φ i ((g : M ≃ₗ[ℝ] M) y)) :
    (∀ (g : M ≃ₗ[ℝ] M), g ∈ W → ∀ (V U : Finset ι), AET.IsRelevant J V →
        IsConeFace (g '' aetChamberFace φ (V ∪ U)) (g '' aetChamberFace φ V) ∧
          (g '' aetChamberFace φ (V ∪ U)) ∈ aetWythoffSemifan φ J W WJ) ∧
      (∀ (g : M ≃ₗ[ℝ] M), g ∈ W → ∀ V : Finset ι, (∀ i ∈ V, i ∉ J) →
        IsConeFace (g '' aetGeneralizedChamberFace φ WJ V) (g '' aetGeneralizedChamber φ WJ) ∧
          (g '' aetGeneralizedChamberFace φ WJ V) =
            ⋃ h : WJ, (g * (h : M ≃ₗ[ℝ] M)) ''
              (aetChamber φ ∩ {y | ∀ i ∈ V, φ i ((h : M ≃ₗ[ℝ] M) y) = 0})) := by
  constructor
  · intro g hg V U hV
    have hsub : V ⊆ V ∪ U := Finset.subset_union_left
    refine ⟨(aetChamberFace_isConeFace_of_subset φ hsub).image g, ?_⟩
    exact mem_aetWythoffSemifan.mpr (Or.inr ⟨g, hg, V ∪ U, AET.IsRelevant.mono (J := J) hsub hV, rfl⟩)
  · intro g hg V hV
    refine ⟨(aetGeneralizedChamberFace_isConeFace φ J WJ V hL hV).image g, ?_⟩
    rw [aetGeneralizedChamberFace_eq_iUnion]
    ext x
    simp only [Set.mem_image, Set.mem_iUnion]
    constructor
    · rintro ⟨y, ⟨h, z, hz, rfl⟩, rfl⟩
      exact ⟨h, z, hz, rfl⟩
    · rintro ⟨h, z, hz, rfl⟩
      exact ⟨_, ⟨h, z, hz, rfl⟩, rfl⟩

end FaceClosure

/-! ## Local finiteness -/

section LocalFiniteness

variable (φ : ι → M →ₗ[ℝ] ℝ) (J : Finset ι) (W WJ : Subgroup (M ≃ₗ[ℝ] M))

/-- **Local finiteness, group form**: the semifan has finitely many `W`-orbits of cones —
`L` together with the chamber faces `F_V` for the (finitely many) relevant `V`, since `ι` is
finite. Nothing here assumes that `W_J` is finite. -/
theorem aetWythoffSemifan_orbits_finite :
    ∃ T : Set (Set M), T.Finite ∧
      (∀ E ∈ T, E = aetGeneralizedChamber φ WJ ∨
        ∃ V : Finset ι, AET.IsRelevant J V ∧ E = aetChamberFace φ V) ∧
      ∀ D ∈ aetWythoffSemifan φ J W WJ, ∃ E ∈ T, ∃ g ∈ W, D = g '' E := by
  classical
  refine ⟨insert (aetGeneralizedChamber φ WJ)
      ((Finset.univ.filter (AET.IsRelevant J)).image (fun V => aetChamberFace φ V)), ?_, ?_, ?_⟩
  · exact (Finset.finite_toSet _).insert (a := aetGeneralizedChamber φ WJ)
  · intro E hE
    rcases hE with rfl | hE
    · exact Or.inl rfl
    · obtain ⟨V, hV, rfl⟩ := Finset.mem_image.mp hE
      exact Or.inr ⟨V, (Finset.mem_filter.mp hV).2, rfl⟩
  · intro D hD
    rcases mem_aetWythoffSemifan.mp hD with ⟨g, hg, rfl⟩ | ⟨g, hg, V, hV, rfl⟩
    · exact ⟨aetGeneralizedChamber φ WJ, Set.mem_insert _ _, g, hg, rfl⟩
    · refine ⟨aetChamberFace φ V, ?_, g, hg, rfl⟩
      exact Set.mem_insert_of_mem _
        (Finset.mem_image.mpr ⟨V, Finset.mem_filter.mpr ⟨Finset.mem_univ V, hV⟩, rfl⟩)

/-- **Local finiteness on the chamber tiling.** If a set `s` meets only finitely many chambers
`g(K)`, then only finitely many cones of chamber-face type meet it. This is the geometric content
of local finiteness for the semifan; for the maximal cones it fails in general (see
`WythoffInfiniteParabolicExample.mem_infinitelyMany_maximalCones`), which is why the statement is
made for the chamber-face members. -/
theorem aetWythoffSemifan_chamberFace_finite_of_chambers (s : Set M)
    (hs : ({g : M ≃ₗ[ℝ] M | g ∈ W ∧ (g '' aetChamber φ ∩ s).Nonempty}).Finite) :
    {D : Set M | D ∈ aetWythoffSemifan φ J W WJ ∧ (D ∩ s).Nonempty ∧
      ∃ (g : M ≃ₗ[ℝ] M), g ∈ W ∧ ∃ V : Finset ι,
        AET.IsRelevant J V ∧ D = g '' aetChamberFace φ V}.Finite := by
  classical
  refine Set.Finite.subset (hs.biUnion fun g _ => (Set.finite_univ (α := Finset ι)).image (fun V => g '' aetChamberFace φ V)) ?_
  rintro D ⟨-, ⟨x, hxD, hxs⟩, g, hgW, V, hV, rfl⟩
  exact Set.mem_biUnion ⟨hgW, ⟨x, Set.image_mono (aetChamberFace_subset_aetChamber φ V) hxD, hxs⟩⟩
    (Set.mem_image_of_mem _ (Set.mem_univ V))

end LocalFiniteness

/-! ## The axiom list of the generalized Coxeter semifan -/

section Axioms

variable (φ : ι → M →ₗ[ℝ] ℝ) (J : Finset ι) (W WJ : Subgroup (M ≃ₗ[ℝ] M))

/-- **The five obligations of AET Definition 4.16 / Proposition 4.17 on the cone family, as
theorems.** This is the explicit axiom list under which `aetWythoffSemifan` is a semifan; none of
the five is a field of the definition of the family, and none of them assumes that `W_J` is
finite, that `L` is finitely generated, or that the family is finite. -/
theorem aetWythoffSemifan_axioms
    (hL : ∀ i, i ∉ J → ∀ g : WJ, ∀ y : M, y ∈ aetChamber φ → 0 ≤ φ i ((g : M ≃ₗ[ℝ] M) y))
    (hadd : ∀ x ∈ aetGeneralizedChamber φ WJ, ∀ y ∈ aetGeneralizedChamber φ WJ,
      x + y ∈ aetGeneralizedChamber φ WJ)
    (hrefl : ∀ j ∈ J, ∃ s : WJ, ∀ x : M, φ j ((s : M ≃ₗ[ℝ] M) x) = -φ j x) :
    -- relevant faces are faces of the generalized chamber
    (∀ V : Finset ι, (∀ i ∈ V, i ∉ J) →
        IsConeFace (aetGeneralizedChamberFace φ WJ V) (aetGeneralizedChamber φ WJ))
    -- irrelevant faces are not
    ∧ (∀ j ∈ J, ∀ y ∈ aetGeneralizedChamber φ WJ, φ j y ≠ 0 →
        ¬ IsConeFace (aetGeneralizedChamberFace φ WJ {j}) (aetGeneralizedChamber φ WJ))
    -- the truncations of a maximal cone are closed under intersections, a face of each
    ∧ (∀ V U : Finset ι, (∀ i ∈ V, i ∉ J) → (∀ i ∈ U, i ∉ J) →
        IsConeFace (aetGeneralizedChamberFace φ WJ (V ∪ U)) (aetGeneralizedChamberFace φ WJ V))
    -- full `W`-equivariance
    ∧ (∀ (g : M ≃ₗ[ℝ] M), g ∈ W →
        (fun D => g '' D) '' aetWythoffSemifan φ J W WJ = aetWythoffSemifan φ J W WJ)
    -- face closure of the members
    ∧ ((∀ (g : M ≃ₗ[ℝ] M), g ∈ W → ∀ (V U : Finset ι), AET.IsRelevant J V →
          IsConeFace (g '' aetChamberFace φ (V ∪ U)) (g '' aetChamberFace φ V) ∧
            (g '' aetChamberFace φ (V ∪ U)) ∈ aetWythoffSemifan φ J W WJ) ∧
        (∀ (g : M ≃ₗ[ℝ] M), g ∈ W → ∀ V : Finset ι, (∀ i ∈ V, i ∉ J) →
          IsConeFace (g '' aetGeneralizedChamberFace φ WJ V)
              (g '' aetGeneralizedChamber φ WJ) ∧
            (g '' aetGeneralizedChamberFace φ WJ V) =
              ⋃ h : WJ, (g * (h : M ≃ₗ[ℝ] M)) ''
                (aetChamber φ ∩ {y | ∀ i ∈ V, φ i ((h : M ≃ₗ[ℝ] M) y) = 0}))) := by
  refine ⟨fun V hV => aetGeneralizedChamberFace_isConeFace φ J WJ V hL hV, ?_⟩
  refine ⟨fun j hj y hy hy0 =>
    aetGeneralizedChamberFace_singleton_not_isConeFace φ J WJ hadd j hj (hrefl j hj) y hy hy0, ?_⟩
  refine ⟨fun V U hV hU =>
    aetGeneralizedChamberFace_isConeFace_inter φ J WJ hL hV hU, ?_⟩
  refine ⟨fun g hg => aetWythoffSemifan_equivariant φ J W WJ g hg, ?_⟩
  exact aetWythoffSemifan_faceClosure φ J W WJ hL

end Axioms

end LeanCategories.Lattices.Valued
