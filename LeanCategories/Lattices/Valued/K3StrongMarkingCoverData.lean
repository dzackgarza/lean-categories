module

public import LeanCategories.Lattices.Valued.K3WeylChamberData
public import Mathlib.Topology.Constructions
public import Mathlib.Topology.Order

/-!
# Strong-marking cover of the K3 period domain

Definition-level realization of Peters--Sterk FC11-C19-U032.

The preceding owner constructs, over every K3 period point, the signed Weyl
chambers that label the fibre of the strong-marking cover. Peters--Sterk then
describe the topology using a continuity neighbourhood U_(u,c) x K_(u,c):
near (u,c), no new root hyperplane meeting K_(u,c) may appear. A local
sheet is glued to another precisely where the two chosen vectors lie in the
same Weyl chamber over the common period point.

This file transcribes that construction directly.

* The K3 complexification gets its finite-dimensional topology from the fixed
  integral K3 basis, hence from the coordinate space K3Index -> C.
* Its projectivization gets the ordinary quotient topology on nonzero vectors;
  the period domain inherits the subtype topology.
* A point of the strong-marking cover is a period point together with one of
  its already-constructed signed Weyl chambers.
* Instead of choosing one continuity neighbourhood and proving that it exists,
  the topology is generated by all local sheets whose open sets U,K
  satisfy exactly the source continuity condition.

The continuity theorem of Peters--Sterk/[33], the assertion that these sheets
map homeomorphically onto open subsets of the period domain, the resulting
local-homeomorphism property, and the analytic-space structure are result
content. None is proved or installed as a constructor field in Sweep III.
-/

@[expose] public noncomputable section

namespace LeanCategories.Lattices.Valued

/-- The standard finite-dimensional topology on the complexified K3 lattice,
transported through the repository's fixed K3 basis. -/
noncomputable instance k3LatticeComplexificationTopologicalSpace :
    TopologicalSpace (LatticeComplexificationData k3Lattice.obj.carrier) :=
  TopologicalSpace.induced
    ((k3Basis.baseChange ℂ).equivFun : _ -> (K3Index -> ℂ))
    inferInstance

/-- Quotient topology on the projectivization of the complexified K3 lattice,
matching the projectivization topology already used elsewhere in the project. -/
noncomputable instance k3ProjectivePeriodAmbientTopologicalSpace :
    TopologicalSpace
      (Projectivization ℂ (LatticeComplexificationData k3Lattice.obj.carrier)) :=
  inferInstanceAs
    (TopologicalSpace
      (Quotient
        (projectivizationSetoid ℂ
          (LatticeComplexificationData k3Lattice.obj.carrier))))

/-- A point of the strong-marking cover: a K3 period point together with one
of the signed Weyl chambers over that point. -/
structure K3StrongMarkingCoverPointData where
  period : K3PeriodPointData
  chamber : Set K3RealPeriodAmbientData
  isChamber : chamber ∈ k3StrongMarkingChamberFiberData period

/-- The set-theoretic projection of the strong-marking cover to the period
domain. Its local-homeomorphism property is result content. -/
def k3StrongMarkingCoverProjectionData
    (x : K3StrongMarkingCoverPointData) : K3PeriodPointData :=
  x.period

/-- The source continuity condition on a product neighbourhood U_(u,c) x K_(u,c).

For any period p in U, a reflection hyperplane belonging to a root
orthogonal to p that meets K must already come from a root orthogonal to
the central period. The fields saying that U and K are open
neighbourhoods are hypotheses in the source condition, not existence proofs. -/
def IsK3StrongMarkingContinuityNeighborhoodData
    (x : K3StrongMarkingCoverPointData)
    (c : K3RealPeriodAmbientData)
    (U : Set K3PeriodPointData)
    (K : Set K3RealPeriodAmbientData) : Prop :=
  c ∈ x.chamber ∧
    IsOpen U ∧ x.period ∈ U ∧
    IsOpen K ∧ c ∈ K ∧
    ∀ p ∈ U, ∀ r,
      r ∈ k3PeriodRootSetData p →
        (K ∩ k3PeriodRootHyperplaneData r).Nonempty →
          r ∈ k3PeriodRootSetData x.period

/-- The image in the strong-marking carrier of one source local sheet.

Over a period p in U, the sheet consists exactly of those chamber-labelled
points whose chamber contains the fixed vector c. Thus two local copies
are glued at a common period precisely when their chosen vectors lie in the
same Weyl chamber there, which is the source gluing rule. -/
def k3StrongMarkingLocalSheetData
    (c : K3RealPeriodAmbientData)
    (U : Set K3PeriodPointData) :
    Set K3StrongMarkingCoverPointData :=
  {x | x.period ∈ U ∧ c ∈ x.chamber}

/-- All source-admissible local-sheet subsets. Quantifying over every
continuity neighbourhood avoids choosing one or proving existence in the
definition layer. -/
def k3StrongMarkingTopologyGeneratorsData :
    Set (Set K3StrongMarkingCoverPointData) :=
  {S | ∃ x : K3StrongMarkingCoverPointData,
    ∃ c : K3RealPeriodAmbientData,
    ∃ U : Set K3PeriodPointData,
    ∃ K : Set K3RealPeriodAmbientData,
      IsK3StrongMarkingContinuityNeighborhoodData x c U K ∧
        S = k3StrongMarkingLocalSheetData c U}

/-- Peters--Sterk's strong-marking cover topology, generated from the local
sheets admitted by the stated Weyl-chamber continuity condition. -/
noncomputable instance k3StrongMarkingCoverTopologicalSpace :
    TopologicalSpace K3StrongMarkingCoverPointData :=
  TopologicalSpace.generateFrom k3StrongMarkingTopologyGeneratorsData

end LeanCategories.Lattices.Valued
