namespace LeanCategories.Lattices.Valued

open Set

variable {ι M : Type*} [Fintype ι] [DecidableEq ι] [AddCommGroup M] [Module ℝ M]

/-! ## The domain and the codomain of the coarsening -/

/-- The **codomain** of the Wythoff coarsening: a family of cones of the ambient space `M`.  The
cones of Definition 4.16 are subsets of `M`; a member is a face of a translate of the maximal cone,
so it carries no data beyond the subset. -/
abbrev CoarsenedConeFamily (M : Type*) := Set (Set M)

/-- The **domain** of the Wythoff coarsening: the AET data of Definition 4.16 together with every
hypothesis of that construction that is used below.

* `W` is the reflection group and `WJ` the parabolic generated by the *irrelevant* simple
  reflections, with `WJ ≤ W`;
* `active_nonneg` is the half of AET Proposition 4.17(1) that needs no finiteness of `WJ`: an active
  simple functional is nonnegative on every `WJ`-translate of the chamber;
* `convex` is the other half of Proposition 4.17(1), "In particular, `L` is convex";
* `irrelevant_flips` is the fact that an irrelevant reflection reverses the sign of its own
  functional, which is what makes an irrelevant face fail to be a face of `L`.

None of them mentions a cone family or a semifan, and none of them assumes that `WJ` is finite. -/
structure WythoffCoarseningDatum (φ : ι → M →ₗ[ℝ] ℝ) (J : Finset ι) where
  /-- The reflection group `W`. -/
  W : Subgroup (M ≃ₗ[ℝ] M)
  /-- The standard parabolic `W_irr` generated by the irrelevant simple reflections. -/
  WJ : Subgroup (M ≃ₗ[ℝ] M)
  /-- The parabolic is a subgroup of `W`. -/
  WJ_le : WJ ≤ W
  /-- AET Proposition 4.17(1), the half that needs no finiteness: the active functionals are
  nonnegative on the parabolic orbit of the chamber. -/
  active_nonneg : ∀ i, i ∉ J → ∀ g : WJ, ∀ y : M, y ∈ aetChamber φ → 0 ≤ φ i ((g : M ≃ₗ[ℝ] M) y)
  /-- AET Proposition 4.17(1): the generalized chamber is closed under addition. -/
  convex : ∀ x ∈ aetGeneralizedChamber φ WJ, ∀ y ∈ aetGeneralizedChamber φ WJ,
    x + y ∈ aetGeneralizedChamber φ WJ
  /-- An irrelevant reflection reverses the sign of its own simple functional. -/
  irrelevant_flips : ∀ j ∈ J, ∃ s ∈ WJ, ∀ x : M, φ j ((s : M ≃ₗ[ℝ] M) x) = -(φ j x)

namespace WythoffCoarseningDatum

variable {φ : ι → M →ₗ[ℝ] ℝ} {J : Finset ι} (D : WythoffCoarseningDatum φ J)

/-! ## The maximal cone and the coarsened family -/

/-- The **maximal cone modulo `W`**: `𝒞_gen = ⋃_{h ∈ W_irr} h.𝒞` of Definition 4.16, in the form
`aetGeneralizedChamber` of `WythoffSemifan`. -/
noncomputable def maximalCone : Set M := aetGeneralizedChamber φ D.WJ

/-- **O1: the general Wythoff coarsened family.**  Its members are exactly the faces of the
`W`-translates of the maximal cone — the displayed definition of `def:generalized-cox-semifan`
("all the other cones in `𝔉_gen` are the faces of `𝒞` and their `W`-translates"), with `𝒞` read as
the generalized chamber `𝒞_gen` as AET's own "relevant content" paragraph requires.

One caveat on the set-level face relation: it is satisfied vacuously by `∅`, so the family
defined here contains `∅`, which is not a cone and is not a cone of `𝔉_gen`.  The intended members
are the cones, and the codomain that excludes the vacant case is Mathlib's `PointedCone.IsFaceOf`
on the `PointedCone` built from `𝒞_gen` — available here only after `convex` is used to make `𝒞_gen`
a convex cone.  Both clauses proved below (O2 and O3) are proved for *every* member of this larger
family, so they hold a fortiori for the cone-intrinsic one; the vacant member is recorded as a
papercut in `COMPLAINTS.md` (LC-05) rather than silently excluded by the statements. -/
noncomputable def coarsenedFamily : CoarsenedConeFamily M :=
  {Φ | ∃ g ∈ D.W, IsConeFace Φ ((g : M ≃ₗ[ℝ] M) '' D.maximalCone)}

theorem mem_coarsenedFamily {Φ : Set M} :
    Φ ∈ D.coarsenedFamily ↔
      ∃ g ∈ D.W, IsConeFace Φ ((g : M ≃ₗ[ℝ] M) '' D.maximalCone) :=
  Iff.rfl

/-- The maximal cone is a member of its own coarsened family. -/
theorem maximalCone_mem : D.maximalCone ∈ D.coarsenedFamily :=
  ⟨1, D.W.one_mem, by simpa using IsConeFace.refl D.maximalCone⟩

/-! ## O2: universal face closure -/

/-- **O2: face closure, universally.**  Every face of every member of the coarsened family is again
a member: the face relation is transitive, so a face of a face of `g(𝒞_gen)` is a face of
`g(𝒞_gen)`.  Nothing here is special to the two kinds of member. -/
theorem coarsenedFamily_faceClosed {Φ Ψ : Set M} (hΦ : Φ ∈ D.coarsenedFamily)
    (hΨ : IsConeFace Ψ Φ) : Ψ ∈ D.coarsenedFamily := by
  obtain ⟨g, hg, hface⟩ := hΦ
  exact ⟨g, hg, hΨ.trans hface⟩

/-- Every translate of the maximal cone is a member. -/
theorem translate_mem {g : M ≃ₗ[ℝ] M} (hg : g ∈ D.W) :
    g '' D.maximalCone ∈ D.coarsenedFamily :=
  ⟨g, hg, IsConeFace.refl _⟩

/-! ## The general face-intersection lemma

Nothing here is special to cones: if `Φ` is a face of `A`, `Ψ` a face of `B`, and `A ∩ B` is a face
of `A`, then `Φ ∩ Ψ` is a face of `Φ`.  This is the whole of the reduction of O3 to the geometry of
the maximal cones. -/

/-- A face of each of two cones meets the other face in a face of itself, provided the two cones
meet in a face of the first. -/
theorem IsConeFace.inf_left_of_inter {A B Φ Ψ : Set M} (hΦ : IsConeFace Φ A)
    (hΨ : IsConeFace Ψ B) (hAB : IsConeFace (A ∩ B) A) : IsConeFace (Φ ∩ Ψ) Φ := by
  refine ⟨fun _ hx => hx.1, ?_⟩
  intro x hx y hy hxy
  have hxA : x ∈ A := hΦ.1 hx
  have hyA : y ∈ A := hΦ.1 hy
  have hxyA : x + y ∈ A := hΦ.1 hxy.1
  have hxyB : x + y ∈ B := hΨ.1 hxy.2
  obtain ⟨hxAB, hyAB⟩ := hAB.2 x hxA y hyA ⟨hxyA, hxyB⟩
  obtain ⟨hxΨ, hyΨ⟩ := hΨ.2 x hxAB.2 y hyAB.2 hxy.2
  exact ⟨⟨hx, hxΨ⟩, ⟨hy, hyΨ⟩⟩

/-- The symmetric form: `Φ ∩ Ψ` is a face of `Ψ` when the two cones meet in a face of the second. -/
theorem IsConeFace.inf_right_of_inter {A B Φ Ψ : Set M} (hΦ : IsConeFace Φ A)
    (hΨ : IsConeFace Ψ B) (hAB : IsConeFace (A ∩ B) B) : IsConeFace (Φ ∩ Ψ) Ψ := by
  have h := IsConeFace.inf_left_of_inter hΨ hΦ (by rwa [Set.inter_comm] at hAB)
  rwa [Set.inter_comm] at h

/-! ## O3: pairwise intersection as a common face

The single geometric input is `MaximalConesMeetInFaces`: two translates of the maximal cone meet in
a face of each.  It is a hypothesis of the O3 theorems, not a field of the datum, so that the one
open general step is visible at every use. -/

/-- **The geometric input of O3**: the intersection of two `W`-translates of the maximal cone is a
face of each of them.  This is the fan axiom for the maximal cones of the coarsening (the content of
AET Proposition 4.17(4) once the relevant content is reduced), and it is the statement that the
coarsened cones glue. -/
def MaximalConesMeetInFaces : Prop :=
  ∀ g ∈ D.W, ∀ g' ∈ D.W,
    IsConeFace ((g : M ≃ₗ[ℝ] M) '' D.maximalCone ∩ (g' : M ≃ₗ[ℝ] M) '' D.maximalCone)
        ((g : M ≃ₗ[ℝ] M) '' D.maximalCone) ∧
      IsConeFace ((g : M ≃ₗ[ℝ] M) '' D.maximalCone ∩ (g' : M ≃ₗ[ℝ] M) '' D.maximalCone)
        ((g' : M ≃ₗ[ℝ] M) '' D.maximalCone)

/-- **O3: universal pairwise intersection-as-common-face.**  The intersection of any two members of
the coarsened family is a face of each of them. -/
theorem coarsenedFamily_inf_commonFace (h : D.MaximalConesMeetInFaces) {σ τ : Set M}
    (hσ : σ ∈ D.coarsenedFamily) (hτ : τ ∈ D.coarsenedFamily) :
    IsConeFace (σ ∩ τ) σ ∧ IsConeFace (σ ∩ τ) τ := by
  obtain ⟨g, hg, hσface⟩ := hσ
  obtain ⟨g', hg', hτface⟩ := hτ
  exact ⟨IsConeFace.inf_left_of_inter hσface hτface (h g hg g' hg').1,
    IsConeFace.inf_right_of_inter hσface hτface (h g hg g' hg').2⟩

/-- The left clause of O3 on its own. -/
theorem coarsenedFamily_inf_isConeFace_left (h : D.MaximalConesMeetInFaces) {σ τ : Set M}
    (hσ : σ ∈ D.coarsenedFamily) (hτ : τ ∈ D.coarsenedFamily) : IsConeFace (σ ∩ τ) σ :=
  (D.coarsenedFamily_inf_commonFace h hσ hτ).1

/-- The intersection of two members is again a member: it is a face of the first member and O2
applies.  This is the form in which the coarsened family is closed under intersections up to
faces. -/
theorem coarsenedFamily_inf_mem (h : D.MaximalConesMeetInFaces) {σ τ : Set M}
    (hσ : σ ∈ D.coarsenedFamily) (hτ : τ ∈ D.coarsenedFamily) :
    σ ∩ τ ∈ D.coarsenedFamily :=
  D.coarsenedFamily_faceClosed hσ (D.coarsenedFamily_inf_isConeFace_left h hσ hτ)

end WythoffCoarseningDatum

/-! ## The maximal-cone invariance under normalizing elements, and the two discharged cases -/

/-- The generalized chamber is invariant under every linear equivalence that normalizes the
parabolic.  For `W_irr = ⊤` this is invariance under every linear equivalence; the normalizer form
is what the discharge below uses. -/
theorem image_eq_aetGeneralizedChamber_of_normalizes (φ : ι → M →ₗ[ℝ] ℝ)
    (WJ : Subgroup (M ≃ₗ[ℝ] M)) {g : M ≃ₗ[ℝ] M}
    (hpos : ∀ h ∈ WJ, g * h ∈ WJ) (hneg : ∀ h ∈ WJ, g⁻¹ * h ∈ WJ) :
    g '' aetGeneralizedChamber φ WJ = aetGeneralizedChamber φ WJ := by
  rw [aetGeneralizedChamber, Set.image_iUnion]
  refine le_antisymm ?_ ?_
  · refine Set.iUnion_subset fun h => ?_
    rw [Set.image_image]
    exact Set.subset_iUnion
      (fun k : WJ => (k : M ≃ₗ[ℝ] M) '' aetChamber φ) ⟨g * h, hpos h h.2⟩
  · refine Set.iUnion_subset fun h => ?_
    rintro x ⟨y, hy, rfl⟩
    have hkey : (h : M ≃ₗ[ℝ] M) y
        = g (((⟨g⁻¹ * (h : M ≃ₗ[ℝ] M), hneg h h.2⟩ : WJ) : M ≃ₗ[ℝ] M) y) := by
      rw [show ((⟨g⁻¹ * (h : M ≃ₗ[ℝ] M), hneg h h.2⟩ : WJ) : M ≃ₗ[ℝ] M)
          = g⁻¹ * (h : M ≃ₗ[ℝ] M) from rfl]
      simp
    rw [hkey]
    refine Set.mem_iUnion.mpr ⟨⟨g⁻¹ * (h : M ≃ₗ[ℝ] M), hneg h h.2⟩, ?_⟩
    exact Set.mem_image_of_mem g (Set.mem_image_of_mem _ hy)

/-- With a trivial parabolic the coarsening does nothing: the generalized chamber is the chamber. -/
theorem aetGeneralizedChamber_bot (φ : ι → M →ₗ[ℝ] ℝ) :
    aetGeneralizedChamber φ (⊥ : Subgroup (M ≃ₗ[ℝ] M)) = aetChamber φ := by
  ext x
  rw [mem_aetGeneralizedChamber]
  constructor
  · rintro ⟨g, y, hy, rfl⟩
    have h1 : (g : M ≃ₗ[ℝ] M) = 1 := Subgroup.mem_bot.mp g.2
    rw [h1]
    simpa using hy
  · intro hx
    exact ⟨1, x, hx, rfl⟩

namespace WythoffCoarseningDatum

variable {φ : ι → M →ₗ[ℝ] ℝ} {J : Finset ι} (D : WythoffCoarseningDatum φ J)

/-- **Discharge of the geometric input when every wall is irrelevant.**  If `W_irr = ⊤` then the
coarsened family has the single maximal cone `𝒞_gen` modulo `W` — `𝒞_gen` is then the union of the
translates of the chamber by *every* linear equivalence, hence invariant — so two translates of it
coincide and their intersection is a face of each by reflexivity. -/
theorem maximalConesMeetInFaces_of_WJ_eq_top (h : D.WJ = ⊤) : D.MaximalConesMeetInFaces := by
  have hinv : ∀ g : M ≃ₗ[ℝ] M, g '' D.maximalCone = D.maximalCone := by
    intro g
    have hg := image_eq_aetGeneralizedChamber_of_normalizes (φ := φ) D.WJ (g := g)
      (fun k _ => by simp [h]) (fun k _ => by simp [h])
    simpa only [maximalCone] using hg
  intro g _ g' _
  rw [hinv g, hinv g', Set.inter_self]
  exact ⟨IsConeFace.refl _, IsConeFace.refl _⟩

/-- **Discharge of the geometric input for a trivial reflection group.**  If `W` is trivial then the
coarsened family is the family of faces of the maximal cone alone, and two members are faces of one
and the same cone. -/
theorem maximalConesMeetInFaces_of_subsingleton [Subsingleton D.W] :
    D.MaximalConesMeetInFaces := by
  have hone : ∀ g ∈ D.W, (g : M ≃ₗ[ℝ] M) = 1 := by
    intro g hg
    have hsub : (⟨g, hg⟩ : D.W) = ⟨1, D.W.one_mem⟩ := Subsingleton.elim _ _
    exact congrArg Subtype.val hsub
  intro g hg g' hg'
  rw [hone g hg, hone g' hg', show ((1 : M ≃ₗ[ℝ] M) : M → M) = id from rfl, Set.image_id,
    Set.inter_self]
  exact ⟨IsConeFace.refl _, IsConeFace.refl _⟩

/-- When the reflection group is trivial the coarsened family is exactly the family of faces of the
maximal cone. -/
theorem coarsenedFamily_of_W_eq_bot (h : D.W = ⊥) :
    D.coarsenedFamily = {Φ | IsConeFace Φ D.maximalCone} := by
  ext Φ
  constructor
  · rintro ⟨g, hg, hface⟩
    have h1 : (g : M ≃ₗ[ℝ] M) = 1 := Subgroup.mem_bot.mp (h ▸ hg)
    rwa [h1, show ((1 : M ≃ₗ[ℝ] M) : M → M) = id from rfl, Set.image_id] at hface
  · intro hface
    exact ⟨1, by rw [h]; exact Subgroup.mem_bot.mpr rfl, by
      rwa [show ((1 : M ≃ₗ[ℝ] M) : M → M) = id from rfl, Set.image_id]⟩

/-! ## The relevant truncations are members

AET's cones are also described as the truncations of `𝒞_gen` by the relevant content of a vertex
set.  Those are members of the family constructed here, so the two readings of `Definition 4.16`
(cones as faces, cones as truncations with relevant content) agree on the truncations. -/

/-- A truncation of the maximal cone by a set of *active* mirrors is a member of the coarsened
family — it is a face of the maximal cone itself, by AET Proposition 4.17(1) (`active_nonneg`). -/
theorem truncation_mem {V : Finset ι} (hV : ∀ i ∈ V, i ∉ J) :
    aetGeneralizedChamberFace φ D.WJ V ∈ D.coarsenedFamily := by
  refine ⟨1, D.W.one_mem, ?_⟩
  rw [show ((1 : M ≃ₗ[ℝ] M) : M → M) = id from rfl, Set.image_id]
  exact aetGeneralizedChamberFace_isConeFace φ J D.WJ V D.active_nonneg hV

end WythoffCoarseningDatum

