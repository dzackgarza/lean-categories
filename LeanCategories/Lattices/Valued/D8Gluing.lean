module

public import LeanCategories.Lattices.Valued.EvenGluing

/-!
# The `D₈` worked instance of the overlattice correspondence (#25)

The issue's evidence standard: distinct isotropic subgroups (`D₈` → two overlattices) and the
nearby-invalid case (2-torsion not isotropic).

The lattice is the classical `D₈`: the even-sum submodule of `ℤ⁸` with the coordinate dot product.
Its discriminant group is `(ℤ/2)²`, generated by the classes of the two glue vectors
`s/2` (half the all-ones vector) and `e₀ + s/2`. The quadratic discriminant form is
`q([x]) = x · x` reduced modulo `2ℤ`, so:

* `q([s/2]) = 2 ≡ 0` — `⟨[s/2]⟩` is quadratic-isotropic, and its overlattice `D₈ + ℤ·(s/2)` is
  even;
* `q([e₀ + s/2]) = 4 ≡ 0` — `⟨[e₀ + s/2]⟩` is quadratic-isotropic, and its overlattice
  `D₈ + ℤ·(e₀ + s/2)` is even;
* `q([e₀]) = 1 ≢ 0` — `⟨[e₀]⟩` is 2-torsion but **not** quadratic-isotropic; its overlattice
  `D₈ + ℤ·e₀ = ℤ⁸` is integral but odd (it contains the norm-one element `e₀`).

The two isotropic subgroups are distinct, and by the subgroup-side inverse law
(`glue_overlatticeFromIsotropicSubgroup`) their overlattices are distinct too: equal overlattices
would glue back to equal subgroups.
-/

@[expose] public section

open LeanCategories.Modules.Bilinear.Valued

namespace LeanCategories.Lattices.Valued

/-! ## The lattice `D₈` -/

/-- The coordinate sum, as a ℤ-linear functional on `ℤ⁸`. -/
def d8Sum : (Fin 8 → ℤ) →ₗ[ℤ] ℤ where
  toFun x := ∑ i, x i
  map_add' x y := by simp [Finset.sum_add_distrib]
  map_smul' c x := by
    simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum, RingHom.id_apply, one_mul]

/-- `D₈` as a submodule: the vectors of even coordinate sum. -/
def d8Submodule : Submodule ℤ (Fin 8 → ℤ) :=
  Submodule.comap d8Sum (Ideal.span {(2 : ℤ)})

theorem mem_d8Submodule {x : Fin 8 → ℤ} :
    x ∈ d8Submodule ↔ ∃ m : ℤ, ∑ i, x i = 2 * m := by
  rw [d8Submodule, Submodule.mem_comap, Ideal.mem_span_singleton, dvd_def]
  rfl

/-- The coordinate dot product on `D₈`. -/
def d8BilinMap : LinearMap.BilinMap ℤ ↥d8Submodule ℤ :=
  LinearMap.mk₂ ℤ (fun x y => ∑ i, (x : Fin 8 → ℤ) i * (y : Fin 8 → ℤ) i)
    (fun x y z => by
      simp only [Submodule.coe_add, Pi.add_apply, add_mul]
      rw [Finset.sum_add_distrib])
    (fun c x => by
      intro n
      simp only [Submodule.coe_smul, Pi.smul_apply, smul_eq_mul, mul_assoc, Finset.mul_sum])
    (fun x y z => by
      simp only [Submodule.coe_add, Pi.add_apply, mul_add]
      rw [Finset.sum_add_distrib])
    (fun c x n => by
      simp only [Submodule.coe_smul, Pi.smul_apply, smul_eq_mul]
      rw [Finset.mul_sum Finset.univ
        (fun i => (x : Fin 8 → ℤ) i * (n : Fin 8 → ℤ) i) c]
      exact Finset.sum_congr rfl fun i _ => by ring)

/-- The standard basis vectors of `D₈`: `u i = eᵢ + e₇` for `i ≠ 7`, and `u 7 = 2 · e₇`. -/
def d8BasisVec (i : Fin 8) : Fin 8 → ℤ :=
  if i = 7 then 2 • Pi.single (7 : Fin 8) 1
  else Pi.single i 1 + Pi.single (7 : Fin 8) 1

theorem d8BasisVec_mem (i : Fin 8) : d8BasisVec i ∈ d8Submodule := by
  rw [mem_d8Submodule]
  refine ⟨1, ?_⟩
  by_cases hi : i = 7
  · subst hi
    simp [d8BasisVec, Pi.single_apply, Finset.sum_ite_eq]
  · have h1 : ∑ k, (Pi.single i 1 : Fin 8 → ℤ) k = 1 := by
      simp [Pi.single_apply, Finset.sum_ite_eq]
    have h2 : ∑ k, (Pi.single (7 : Fin 8) 1 : Fin 8 → ℤ) k = 1 := by
      simp [Pi.single_apply, Finset.sum_ite_eq]
    rw [d8BasisVec, if_neg hi]
    simp [Finset.sum_add_distrib, h1, h2]

/-- Below the last index, the basis vectors are the standard basis indicators. -/
theorem d8BasisVec_apply' {i k : Fin 8} (hk : k ≠ 7) :
    d8BasisVec i k = if k = i then 1 else 0 := by
  by_cases hi : i = 7
  · subst hi
    simp [d8BasisVec, Pi.single_apply, hk]
  · rw [d8BasisVec, if_neg hi]
    simp [Pi.single_apply, hk]

/-- At the last index, every basis vector takes value `1` except the last, which takes `2`. -/
theorem d8BasisVec_apply_seven (i : Fin 8) :
    d8BasisVec i 7 = if i = 7 then 2 else 1 := by
  by_cases hi : i = 7
  · subst hi
    simp [d8BasisVec, Pi.single_apply]
  · rw [d8BasisVec, if_neg hi]
    simp only [Pi.add_apply, Pi.single_apply]
    rw [if_neg (Ne.symm (show i ≠ 7 from hi)), if_neg hi]
    norm_num

/-- The `D₈` basis. -/
noncomputable def d8Basis : Module.Basis (Fin 8) ℤ ↥d8Submodule := by
  refine Module.Basis.mk (v := fun i => ⟨d8BasisVec i, d8BasisVec_mem i⟩) ?_ ?_
  · rw [Fintype.linearIndependent_iff]
    intro g hg
    have hfun : ((∑ i, g i • (fun i => ⟨d8BasisVec i, d8BasisVec_mem i⟩ : Fin 8 → ↥d8Submodule) i) :
        Fin 8 → ℤ) = (0 : Fin 8 → ℤ) :=
      congrArg (fun t : ↥d8Submodule => (t : Fin 8 → ℤ)) hg
    have hcoord : ∀ k : Fin 8, ∑ i, g i * d8BasisVec i k = 0 := by
      intro k
      have hk := congrFun hfun k
      simpa [Finset.sum_apply] using hk
    have hne7 : ∀ k : Fin 8, k ≠ 7 → g k = 0 := by
      intro k hk
      have hk' := hcoord k
      rw [Finset.sum_eq_single k] at hk'
      · rw [d8BasisVec_apply' hk, if_pos rfl, mul_one] at hk'
        exact hk'
      · intro b _ hb
        rw [d8BasisVec_apply' hk, if_neg (Ne.symm hb)]
        ring
      · intro hb
        exact absurd (Finset.mem_univ k) hb
    intro k
    by_cases hk : k = 7
    · subst hk
      have hk' := hcoord 7
      rw [Finset.sum_eq_single (7 : Fin 8)] at hk'
      · rw [d8BasisVec_apply_seven 7, if_pos rfl] at hk'
        have : g 7 * 2 = 0 := hk'
        omega
      · intro b _ hb
        rw [d8BasisVec_apply_seven b, if_neg hb, hne7 b hb, mul_one]
      · intro hb
        exact absurd (Finset.mem_univ 7) hb
    · exact hne7 k hk
  · intro x _
    rw [Submodule.mem_span_range_iff_exists_fun]
    obtain ⟨m, hm⟩ := (mem_d8Submodule.mp x.2)
    set c : Fin 8 → ℤ := fun i => if i = 7 then (x : Fin 8 → ℤ) 7 - m else (x : Fin 8 → ℤ) i
      with hcdef
    refine ⟨c, ?_⟩
    apply Subtype.ext
    change d8Submodule.subtype (∑ i, c i • (⟨d8BasisVec i, d8BasisVec_mem i⟩ : ↥d8Submodule)) =
      d8Submodule.subtype x
    rw [map_sum (d8Submodule.subtype : ↥d8Submodule →ₗ[ℤ] (Fin 8 → ℤ))
      (fun i => c i • (⟨d8BasisVec i, d8BasisVec_mem i⟩ : ↥d8Submodule)) Finset.univ]
    funext k
    rw [Finset.sum_apply k Finset.univ
      (fun i => d8Submodule.subtype (c i • (⟨d8BasisVec i, d8BasisVec_mem i⟩ : ↥d8Submodule)))]
    by_cases hk : k = 7
    · subst hk
      show ∑ i, c i * d8BasisVec i 7 = (x : Fin 8 → ℤ) 7
      have h1 : ∀ i : Fin 8, c i * d8BasisVec i 7 =
          (x : Fin 8 → ℤ) i +
          (if i = 7 then (x : Fin 8 → ℤ) 7 - 2 * m else 0) := by
        intro i
        have hc : c i = if i = 7 then (x : Fin 8 → ℤ) 7 - m else (x : Fin 8 → ℤ) i := rfl
        by_cases hi : i = 7
        · subst hi
          rw [hc, d8BasisVec_apply_seven 7, if_pos rfl, if_pos rfl, if_pos rfl]
          ring
        · rw [hc, d8BasisVec_apply_seven i, if_neg hi, if_neg hi, if_neg hi, mul_one]
          ring
      simp only [h1, Finset.sum_add_distrib, Finset.sum_ite_eq', if_pos (Finset.mem_univ _)]
      omega
    · show ∑ i, c i * d8BasisVec i k = (x : Fin 8 → ℤ) k
      rw [Finset.sum_eq_single k]
      · rw [d8BasisVec_apply' hk, if_pos rfl, mul_one]
        exact if_neg hk
      · intro b _ hb
        rw [d8BasisVec_apply' hk, if_neg (Ne.symm hb), mul_zero]
      · intro hb
        exact absurd (Finset.mem_univ k) hb

/-- The dot product is symmetric. -/
theorem d8_dot_symm (x y : ↥d8Submodule) :
    d8BilinMap x y = d8BilinMap y x := by
  show ∑ i, (x : Fin 8 → ℤ) i * (y : Fin 8 → ℤ) i =
    ∑ i, (y : Fin 8 → ℤ) i * (x : Fin 8 → ℤ) i
  exact Finset.sum_congr rfl fun i _ => mul_comm _ _

/-- The `D₈` lattice: the even-sum submodule of `ℤ⁸` with the dot product. -/
def d8Lattice : IntegralLatticeCat ℤ :=
  ⟨BilinModuleCat.ofBilinMap d8BilinMap, by
    change Module.Projective ℤ ↥d8Submodule
    exact @Module.Projective.of_free ℤ _ ↥d8Submodule _ _ (Module.Free.of_basis d8Basis), by
    intro x y
    have h1 : (BilinModuleCat.ofBilinMap d8BilinMap).pairing x y =
        d8BilinMap (x : ↥d8Submodule) (y : ↥d8Submodule) := rfl
    have h2 : (BilinModuleCat.ofBilinMap d8BilinMap).pairing y x =
        d8BilinMap (y : ↥d8Submodule) (x : ↥d8Submodule) := rfl
    rw [h1, h2]
    exact d8_dot_symm _ _⟩

/-- The `D₈` basis, read at the lattice's carrier type (definitionally the same space). -/
noncomputable def d8BasisC : Module.Basis (Fin 8) ℤ d8Lattice.obj.carrier :=
  d8Basis

theorem d8_pairing (x y : ↥d8Submodule) :
    d8Lattice.obj.pairing x y = ∑ i, (x : Fin 8 → ℤ) i * (y : Fin 8 → ℤ) i :=
  rfl

/-- The carrier of `D₈` carries its `ℤ`-module structure through the submodule identification. -/
instance d8CarrierModule : Module ℤ d8Lattice.obj.carrier :=
  inferInstanceAs (Module ℤ ↥d8Submodule)

theorem d8Basis_mk_apply (i : Fin 8) :
    d8Basis i = (⟨d8BasisVec i, d8BasisVec_mem i⟩ : ↥d8Submodule) :=
  Module.Basis.mk_apply _ _ i

theorem d8BasisC_apply (i : Fin 8) :
    d8BasisC i = (⟨d8BasisVec i, d8BasisVec_mem i⟩ : ↥d8Submodule) :=
  d8Basis_mk_apply i

/-- The pairing of carrier-typed vectors, in coordinates. -/
theorem d8_pairing_c (x y : d8Lattice.obj.carrier) :
    d8Lattice.obj.pairing x y =
      ∑ i, (x : ↥d8Submodule).val i * (y : ↥d8Submodule).val i :=
  rfl

/-- `D₈` is even: the square of a vector is congruent to its coordinate sum, which is even. -/
theorem d8_isEven : IsEven d8Lattice := by
  rw [IsEven, isIEven_iff_value_mem]
  intro x
  rw [Ideal.mem_span_singleton]
  let y : ↥d8Submodule := x
  have hy : (y : d8Lattice.obj.carrier) = x := rfl
  rw [← hy]
  have hquad : quadraticMap d8Lattice (y : d8Lattice.obj.carrier) =
      ∑ i, (y : Fin 8 → ℤ) i * (y : Fin 8 → ℤ) i := by
    show d8Lattice.obj.pairing (y : d8Lattice.obj.carrier) (y : d8Lattice.obj.carrier) = _
    exact d8_pairing y y
  obtain ⟨m, hm⟩ := (mem_d8Submodule.mp y.2)
  have hterm : ∀ i : Fin 8, ∃ k : ℤ,
      (y : Fin 8 → ℤ) i * (y : Fin 8 → ℤ) i - (y : Fin 8 → ℤ) i = 2 * k := by
    intro i
    rcases Int.even_or_odd ((y : Fin 8 → ℤ) i) with h | h
    · obtain ⟨k, hk⟩ := h
      exact ⟨k * (2 * k - 1), by rw [hk]; ring⟩
    · obtain ⟨k, hk⟩ := h
      exact ⟨(2 * k + 1) * k, by rw [hk]; ring⟩
  refine ⟨m + ∑ i, (hterm i).choose, ?_⟩
  rw [hquad]
  have hsplit : ∑ i, (y : Fin 8 → ℤ) i * (y : Fin 8 → ℤ) i =
      (∑ i, ((y : Fin 8 → ℤ) i * (y : Fin 8 → ℤ) i - (y : Fin 8 → ℤ) i)) +
        ∑ i, (y : Fin 8 → ℤ) i := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun i _ => by ring
  rw [hsplit]
  have hsum2 : ∑ i, ((y : Fin 8 → ℤ) i * (y : Fin 8 → ℤ) i - (y : Fin 8 → ℤ) i) =
      2 * ∑ i, (hterm i).choose := by
    rw [Finset.mul_sum Finset.univ (fun i => (hterm i).choose) 2]
    exact Finset.sum_congr rfl fun i _ => (hterm i).choose_spec
  rw [hsum2, hm]
  ring

set_option maxHeartbeats 1200000 in
-- the Gram-matrix identity runs the matrix/dot-product normalizer at scale
/-- The fraction-field form of `D₈` is perfect: the Gram matrix over `ℚ` factors as `Tᵀ T` with
`T` the basis-coordinate matrix, so a rational kernel vector of the Gram matrix would be
orthogonal to its own image, a vector of positive squared norm. -/
theorem d8_isFractionFieldPerfect : IsFractionFieldPerfect ℤ d8Lattice := by
  rw [isFractionFieldPerfect_iff_determinant_ne_zero ℤ d8Lattice d8BasisC]
  show (gramMatrix d8Lattice d8BasisC).det ≠ 0
  intro hdet
  set T : Matrix (Fin 8) (Fin 8) ℚ := Matrix.of fun k i => ((d8BasisVec i) k : ℚ) with hTdef

  have hfac : (algebraMap ℤ ℚ).mapMatrix (gramMatrix d8Lattice d8BasisC) = Matrix.transpose T * T := by
    ext i j
    have hL : (algebraMap ℤ ℚ).mapMatrix (gramMatrix d8Lattice d8BasisC) i j =
        ((∑ x, d8BasisVec i x * d8BasisVec j x : ℤ) : ℚ) := by
      rw [RingHom.mapMatrix_apply, Matrix.map_apply]
      show ((LinearMap.BilinForm.toMatrix d8BasisC d8Lattice.obj.bilinMap) i j : ℚ) = _
      rw [LinearMap.BilinForm.toMatrix_apply, BilinModuleCat.bilinMap_apply, d8_pairing_c,
        d8BasisC_apply, d8BasisC_apply]
    have hR : (Matrix.transpose T * T) i j =
        ∑ x, (d8BasisVec i x : ℚ) * (d8BasisVec j x : ℚ) := by
      simp [Matrix.mul_apply, Matrix.transpose_apply, hTdef]
    rw [hL, hR]
    push_cast
    rfl
  have h0 : ((algebraMap ℤ ℚ).mapMatrix (gramMatrix d8Lattice d8BasisC)).det = (0 : ℚ) := by
    rw [show ((algebraMap ℤ ℚ).mapMatrix (gramMatrix d8Lattice d8BasisC)).det =
        algebraMap ℤ ℚ (gramMatrix d8Lattice d8BasisC).det from (RingHom.map_det _ _).symm,
      hdet, map_zero]
  obtain ⟨v, hv0, hv⟩ := (Matrix.exists_mulVec_eq_zero_iff
    (M := (algebraMap ℤ ℚ).mapMatrix (gramMatrix d8Lattice d8BasisC))).mpr h0
  have hzero : dotProduct v (((algebraMap ℤ ℚ).mapMatrix (gramMatrix d8Lattice d8BasisC)).mulVec v) = 0 := by
    rw [hv, dotProduct_zero]
  have hTv : T.mulVec v ≠ 0 := by
    intro h
    have hcoord : ∀ i : Fin 8, ∑ x, (↑(d8BasisVec x i) : ℚ) * v x = 0 := by
      intro i
      have hi := congrFun h i
      simpa [Matrix.mulVec, dotProduct, hTdef, Matrix.of_apply] using hi
    have hne7 : ∀ i : Fin 8, i ≠ 7 → v i = 0 := by
      intro i hi
      have hi' := hcoord i
      rw [show ∑ x, (↑(d8BasisVec x i) : ℚ) * v x = v i from by
        rw [Finset.sum_eq_single i]
        · rw [d8BasisVec_apply' hi, if_pos rfl]
          norm_num
        · intro b _ hb
          rw [d8BasisVec_apply' hi, if_neg (Ne.symm hb)]
          ring
        · intro hb
          exact absurd (Finset.mem_univ i) hb] at hi'
      exact hi'
    have h7 := hcoord 7
    rw [show ∑ x, (↑(d8BasisVec x 7) : ℚ) * v x = 2 * v 7 from by
      rw [Finset.sum_eq_single 7]
      · rw [d8BasisVec_apply_seven 7, if_pos rfl]
        norm_num
      · intro b _ hb
        rw [d8BasisVec_apply_seven b, if_neg hb, hne7 b hb]
        ring
      · intro hb
        exact absurd (Finset.mem_univ 7) hb] at h7
    have hv7 : v 7 = 0 := by linarith
    exact hv0 (funext fun k => by
      by_cases hk : k = 7
      · subst hk
        exact hv7
      · exact hne7 k hk)
  have hpos : 0 < dotProduct v (((algebraMap ℤ ℚ).mapMatrix (gramMatrix d8Lattice d8BasisC)).mulVec v) := by
    have hmv : ((algebraMap ℤ ℚ).mapMatrix (gramMatrix d8Lattice d8BasisC)).mulVec v =
        (Matrix.transpose T).mulVec (T.mulVec v) := by
      rw [hfac, Matrix.mulVec_mulVec]
    have hdot : dotProduct v ((Matrix.transpose T).mulVec (T.mulVec v)) = dotProduct (T.mulVec v) (T.mulVec v) := by
      rw [Matrix.dotProduct_mulVec, Matrix.vecMul_transpose]
    rw [hmv, hdot]
    obtain ⟨k, hk⟩ : ∃ k, (T.mulVec v) k ≠ 0 := by
      by_contra hcon
      push Not at hcon
      exact hTv (funext hcon)
    rw [dotProduct]
    refine Finset.sum_pos' (fun i _ => mul_self_nonneg (T.mulVec v i))
      ⟨k, Finset.mem_univ k, ?_⟩
    have hposk : 0 < (T.mulVec v) k * (T.mulVec v) k := mul_self_pos.mpr hk
    linarith
  linarith


/-! ## The glue vectors and the discriminant classes -/

-- `FractionRing ℤ` carries two definitionally distinct `ℤ`-module structures. Raise the priority of
-- the one the typing rules use, so the tensor-product statements elaborate as written.
attribute [local instance 10000] OreLocalization.instModuleOfIsScalarTower
attribute [local instance 10000] TensorProduct.instModule

/-- The all-ones vector. -/
def d8s : Fin 8 → ℤ := fun _ => 1

theorem d8s_mem : d8s ∈ d8Submodule := by
  rw [mem_d8Submodule]
  refine ⟨4, ?_⟩
  simp [d8s, Finset.sum_const]

/-- Twice the first standard basis vector. -/
def d8twoE0 : Fin 8 → ℤ := fun k => if k = 0 then 2 else 0

theorem d8twoE0_mem : d8twoE0 ∈ d8Submodule := by
  rw [mem_d8Submodule]
  refine ⟨1, ?_⟩
  rw [Finset.sum_eq_single (0 : Fin 8)]
  · simp [d8twoE0]
  · intro b _ hb
    simp [d8twoE0, hb]
  · intro hb
    exact absurd (Finset.mem_univ 0) hb

theorem d8s_sq : d8Lattice.obj.pairing ⟨d8s, d8s_mem⟩ ⟨d8s, d8s_mem⟩ = 8 := by
  rw [d8_pairing]
  simp [d8s, Finset.sum_const]

theorem d8twoE0_sq :
    d8Lattice.obj.pairing ⟨d8twoE0, d8twoE0_mem⟩ ⟨d8twoE0, d8twoE0_mem⟩ = 4 := by
  rw [d8_pairing]
  rw [Finset.sum_eq_single (0 : Fin 8)]
  · simp [d8twoE0]
  · intro b _ hb
    simp [d8twoE0, hb]
  · intro hb
    exact absurd (Finset.mem_univ 0) hb

theorem d8s_twoE0 :
    d8Lattice.obj.pairing ⟨d8s, d8s_mem⟩ ⟨d8twoE0, d8twoE0_mem⟩ = 2 := by
  rw [d8_pairing]
  rw [Finset.sum_eq_single (0 : Fin 8)]
  · simp [d8s, d8twoE0]
  · intro b _ hb
    simp [d8s, d8twoE0, hb]
  · intro hb
    exact absurd (Finset.mem_univ 0) hb

set_option maxHeartbeats 800000 in
-- the tensor form of the rationalized pairing needs the fraction-field module route explicit
/-- The rationalized pairing of a half-integral metric-dual element with a lattice vector: the tensor
form of `rationalizedForm_tmul`, stated at the carrier type. -/
theorem d8_half_pairing (a : FractionRing ℤ) (x y : d8Lattice.obj.carrier) :
    rationalizedForm ℤ d8Lattice (a ⊗ₜ[ℤ] x) ((toRationalSpan ℤ d8Lattice) y) =
      a * algebraMap ℤ (FractionRing ℤ) (d8Lattice.obj.pairing x y) := by
  rw [show (toRationalSpan ℤ d8Lattice) y = (1 : FractionRing ℤ) ⊗ₜ[ℤ] y from rfl,
    rationalizedForm_tmul]
  ring

/-- The metric-dual lift of `s/2`. -/
noncomputable def d8Lift2 : metricDual ℤ d8Lattice := by
  refine ⟨((2 : FractionRing ℤ))⁻¹ ⊗ₜ[ℤ] (⟨d8s, d8s_mem⟩ : d8Lattice.obj.carrier), ?_⟩
  rw [LinearMap.BilinForm.mem_dualSubmodule]
  rintro y ⟨y', rfl⟩
  rw [Submodule.mem_one]
  obtain ⟨m, hm⟩ := mem_d8Submodule.mp y'.2
  refine ⟨m, ?_⟩
  rw [d8_half_pairing ((2 : FractionRing ℤ))⁻¹ (⟨d8s, d8s_mem⟩ : d8Lattice.obj.carrier) y',
    d8_pairing_c (⟨d8s, d8s_mem⟩ : d8Lattice.obj.carrier) y']
  simp only [d8s, Pi.one_apply, one_mul]
  rw [hm]
  push_cast
  have h2 : (2 : FractionRing ℤ) ≠ 0 := by
    simpa [map_zero, map_ofNat] using
      (Function.Injective.ne_iff (IsFractionRing.injective ℤ (FractionRing ℤ))).mpr
        two_ne_zero
  norm_num [Int.cast_mul, Int.cast_ofNat, ← mul_assoc, inv_mul_cancel₀ h2]

/-- The metric-dual lift of `e₀/2 = (1/2) · 2e₀`. -/
noncomputable def d8Lift1 : metricDual ℤ d8Lattice := by
  refine ⟨((2 : FractionRing ℤ))⁻¹ ⊗ₜ[ℤ] (⟨d8twoE0, d8twoE0_mem⟩ : d8Lattice.obj.carrier), ?_⟩
  rw [LinearMap.BilinForm.mem_dualSubmodule]
  rintro y ⟨y', rfl⟩
  rw [Submodule.mem_one]
  refine ⟨(y' : ↥d8Submodule).val 0, ?_⟩
  rw [d8_half_pairing ((2 : FractionRing ℤ))⁻¹ (⟨d8twoE0, d8twoE0_mem⟩ : d8Lattice.obj.carrier) y',
    d8_pairing_c (⟨d8twoE0, d8twoE0_mem⟩ : d8Lattice.obj.carrier) y']
  rw [Finset.sum_eq_single (0 : Fin 8)]
  · simp only [d8twoE0, if_pos rfl]
    push_cast
    have h2 : (2 : FractionRing ℤ) ≠ 0 := by
      simpa [map_zero, map_ofNat] using
        (Function.Injective.ne_iff (IsFractionRing.injective ℤ (FractionRing ℤ))).mpr
          two_ne_zero
    norm_num [Int.cast_mul, Int.cast_ofNat, ← mul_assoc, inv_mul_cancel₀ h2]
  · intro b _ hb
    simp [d8twoE0, hb]
  · intro hb
    exact absurd (Finset.mem_univ 0) hb


/-! ## Discriminant classes and their quadratic values -/

/-- The all-ones vector, at the lattice's carrier type. -/
def d8sC : d8Lattice.obj.carrier := ⟨d8s, d8s_mem⟩

/-- The norm-1 coordinate vector, at the lattice's carrier type. -/
def d8twoE0C : d8Lattice.obj.carrier := ⟨d8twoE0, d8twoE0_mem⟩

/-- The vector `s + 2e₀`, at the carrier type. -/
def d8sumC : d8Lattice.obj.carrier := d8sC + d8twoE0C


/-- The defect class of the glue vector `s/2`. -/
noncomputable def d8c2 : d8Lattice.obj.defect :=
  metricDualToDiscriminant ℤ d8Lattice d8Lift2

/-- The defect class of `e₀`. -/
noncomputable def d8c1 : d8Lattice.obj.defect :=
  metricDualToDiscriminant ℤ d8Lattice d8Lift1

/-- The defect class of `s/2 + e₀`. -/
noncomputable def d8c3 : d8Lattice.obj.defect :=
  metricDualToDiscriminant ℤ d8Lattice (d8Lift2 + d8Lift1)

lemma d8_lift2_coe : (d8Lift2 : RationalSpan ℤ d8Lattice) =
    (2 : FractionRing ℤ)⁻¹ ⊗ₜ[ℤ] d8sC := rfl

lemma d8_lift1_coe : (d8Lift1 : RationalSpan ℤ d8Lattice) =
    (2 : FractionRing ℤ)⁻¹ ⊗ₜ[ℤ] d8twoE0C := rfl

/-- The projection of the glue vector `s/2` has square 2, hence its discriminant quadratic value
vanishes. -/
theorem d8_q_c2 : evenDiscriminantQuadraticMap d8Lattice d8_isFractionFieldPerfect d8_isEven d8c2 = 0 := by
  rw [show d8c2 = metricDualToDiscriminant ℤ d8Lattice d8Lift2 from rfl,
    evenDiscriminantQuadraticMap_metricDualToDiscriminant, d8_lift2_coe]
  rw [rationalizedForm_tmul, show d8Lattice.obj.pairing d8sC d8sC = 8 from d8s_sq]
  have hnorm : (((2 : FractionRing ℤ)⁻¹ * (2 : FractionRing ℤ)⁻¹) *
      algebraMap ℤ (FractionRing ℤ) 8) =
      algebraMap ℤ (FractionRing ℤ) 2 * algebraMap ℤ (FractionRing ℤ) 1 := by
    have h2 : (2 : FractionRing ℤ) ≠ 0 := by
      simpa [map_zero, map_ofNat] using
        (Function.Injective.ne_iff (IsFractionRing.injective ℤ (FractionRing ℤ))).mpr
          two_ne_zero
    push_cast
    field_simp [h2]
    norm_num
  rw [hnorm]
  exact doubleFractionValueProjection_double ℤ 1

/-- The projection of `e₀` has square 1, so its discriminant quadratic value is the projection of 1. -/
theorem d8_q_c1_val : evenDiscriminantQuadraticMap d8Lattice d8_isFractionFieldPerfect d8_isEven d8c1 =
    doubleFractionValueProjection ℤ (algebraMap ℤ (FractionRing ℤ) 1) := by
  rw [show d8c1 = metricDualToDiscriminant ℤ d8Lattice d8Lift1 from rfl,
    evenDiscriminantQuadraticMap_metricDualToDiscriminant, d8_lift1_coe]
  rw [rationalizedForm_tmul, show d8Lattice.obj.pairing d8twoE0C d8twoE0C = 4 from d8twoE0_sq]
  have hnorm : (((2 : FractionRing ℤ)⁻¹ * (2 : FractionRing ℤ)⁻¹) *
      algebraMap ℤ (FractionRing ℤ) 4) =
      algebraMap ℤ (FractionRing ℤ) 1 := by
    have h2 : (2 : FractionRing ℤ) ≠ 0 := by
      simpa [map_zero, map_ofNat] using
        (Function.Injective.ne_iff (IsFractionRing.injective ℤ (FractionRing ℤ))).mpr
          two_ne_zero
    push_cast
    field_simp [h2]
    norm_num
  rw [hnorm]

lemma d8_lift_sum_coe : ((d8Lift2 + d8Lift1 : ↥(metricDual ℤ d8Lattice)) :
    RationalSpan ℤ d8Lattice) = (2 : FractionRing ℤ)⁻¹ ⊗ₜ[ℤ] d8sumC := by
  rw [Submodule.coe_add, d8_lift2_coe, d8_lift1_coe]
  exact (TensorProduct.tmul_add ((2 : FractionRing ℤ)⁻¹) d8sC d8twoE0C).symm

lemma d8_pairing_sum : d8Lattice.obj.pairing d8sumC d8sumC = 16 := by
  rw [d8_pairing_c]
  change ∑ i, ((d8sumC : ↥d8Submodule).val i) * (d8sumC : ↥d8Submodule).val i = 16
  change ∑ i, ((d8s : Fin 8 → ℤ) + d8twoE0 : Fin 8 → ℤ) i * 
    ((d8s : Fin 8 → ℤ) + d8twoE0 : Fin 8 → ℤ) i = 16
  norm_num [d8s, d8twoE0, Finset.sum_fin_eq_sum_range, Finset.sum_range_succ]

/-- The composite glue vector `s/2 + e₀` has square 4, hence its discriminant quadratic value
vanishes. -/
theorem d8_q_c3 : evenDiscriminantQuadraticMap d8Lattice d8_isFractionFieldPerfect d8_isEven d8c3 = 0 := by
  rw [show d8c3 = metricDualToDiscriminant ℤ d8Lattice (d8Lift2 + d8Lift1) from rfl,
    evenDiscriminantQuadraticMap_metricDualToDiscriminant, d8_lift_sum_coe]
  rw [rationalizedForm_tmul, d8_pairing_sum]
  have hnorm : (((2 : FractionRing ℤ)⁻¹ * (2 : FractionRing ℤ)⁻¹) *
      algebraMap ℤ (FractionRing ℤ) 16) =
      algebraMap ℤ (FractionRing ℤ) 2 * algebraMap ℤ (FractionRing ℤ) 2 := by
    have h2 : (2 : FractionRing ℤ) ≠ 0 := by
      simpa [map_zero, map_ofNat] using
        (Function.Injective.ne_iff (IsFractionRing.injective ℤ (FractionRing ℤ))).mpr
          two_ne_zero
    push_cast
    field_simp [h2]
    norm_num
  rw [hnorm]
  exact doubleFractionValueProjection_double ℤ 2

/-- The quadratic value of the projection of `e₀` is nonzero, so `<e₀>` is not quadratic-isotropic. -/
theorem d8_q_c1_ne_zero : evenDiscriminantQuadraticMap d8Lattice d8_isFractionFieldPerfect d8_isEven d8c1 ≠ 0 := by
  rw [d8_q_c1_val]
  intro h
  rw [doubleFractionValueProjection_eq_zero_iff] at h
  obtain ⟨r, hr⟩ := LinearMap.mem_range.mp h
  have hEq : (2 : ℤ) * r = 1 := by
    apply (IsFractionRing.injective ℤ (FractionRing ℤ))
    simpa [doubleAlgebraMap, map_mul, map_ofNat] using hr
  omega


/-! ## Evaluations, nontriviality and the two-torsion class -/

-- `FractionRing`/`FractionValueQuotient` quotients have two definitionally distinct `ℤ`-module
-- structures; the standard quotient-module priority keeps synthesis on the route used by typing.
-- This is the same instance-resolution device as in the cusp worked instance.
attribute [local instance 10000] Submodule.Quotient.module


lemma d8_pairing_twoE0 (z : d8Lattice.obj.carrier) :
    d8Lattice.obj.pairing z d8twoE0C = 2 * ((z : ↥d8Submodule).val 0) := by
  rw [d8_pairing_c, Finset.sum_eq_single 0]
  · simp [d8twoE0C, d8twoE0]
    ring
  all_goals intros
  all_goals simp_all [d8twoE0C, d8twoE0]

lemma d8_pairing_allones (z : d8Lattice.obj.carrier) :
    d8Lattice.obj.pairing z d8sC = ∑ i, (z : ↥d8Submodule).val i := by
  rw [d8_pairing_c]
  change ∑ i, ((z : ↥d8Submodule).val i) * (d8s : Fin 8 → ℤ) i = _
  simp only [d8s, mul_one]

/-- `s/2` evaluates to 1 against `2e₀`; this is the evaluation used to show its class is nonzero. -/
lemma d8_lift2_eval : rationalizedForm ℤ d8Lattice (d8Lift2 : RationalSpan ℤ d8Lattice)
    ((toRationalSpan ℤ d8Lattice) d8twoE0C) = 1 := by
  rw [d8_lift2_coe, d8_half_pairing]
  rw [show d8Lattice.obj.pairing d8sC d8twoE0C = 2 from d8s_twoE0]
  have h2 : (2 : FractionRing ℤ) ≠ 0 := by
    simpa [map_zero, map_ofNat] using
      (Function.Injective.ne_iff (IsFractionRing.injective ℤ (FractionRing ℤ))).mpr
        two_ne_zero
  norm_num [← mul_assoc, inv_mul_cancel₀ h2]

/-- `e₀` evaluates to 1 against `s`; this is the evaluation used to show its class is nonzero. -/
lemma d8_lift1_eval : rationalizedForm ℤ d8Lattice (d8Lift1 : RationalSpan ℤ d8Lattice)
    ((toRationalSpan ℤ d8Lattice) d8sC) = 1 := by
  rw [d8_lift1_coe, d8_half_pairing]
  have hsymm : d8Lattice.obj.pairing d8twoE0C d8sC = 2 := by
    rw [← d8s_twoE0]
    exact d8_dot_symm d8twoE0C d8sC
  rw [hsymm]
  have h2 : (2 : FractionRing ℤ) ≠ 0 := by
    simpa [map_zero, map_ofNat] using
      (Function.Injective.ne_iff (IsFractionRing.injective ℤ (FractionRing ℤ))).mpr
        two_ne_zero
  norm_num [← mul_assoc, inv_mul_cancel₀ h2]

/-- `s/2` is not in the kernel of the discriminant projection, so its class is nonzero. -/
theorem d8_c2_ne_zero : d8c2 ≠ 0 := by
  intro h
  obtain ⟨z, hz⟩ := (metricDualToDiscriminant_eq_zero_iff ℤ
    (L := d8Lattice) d8_isFractionFieldPerfect d8Lift2).mp h
  have hfun : metricDualToValueDual ℤ d8Lattice d8Lift2 = d8Lattice.obj.adjoint z := by
    rw [← hz, metricDualToValueDual_toMetricDual ℤ d8_isFractionFieldPerfect]
  have hEval := metricDualToValueDual_apply ℤ (L := d8Lattice) d8Lift2 d8twoE0C
  rw [hfun, d8_lift2_eval] at hEval
  have hint : d8Lattice.obj.adjoint z d8twoE0C = 1 := by
    apply (IsFractionRing.injective ℤ (FractionRing ℤ))
    simpa using hEval
  rw [BilinModuleCat.bilinMap_apply, d8_pairing_twoE0] at hint
  omega

/-- `e₀` is not in the kernel of the discriminant projection, so its class is nonzero. -/
theorem d8_c1_ne_zero : d8c1 ≠ 0 := by
  intro h
  obtain ⟨z, hz⟩ := (metricDualToDiscriminant_eq_zero_iff ℤ
    (L := d8Lattice) d8_isFractionFieldPerfect d8Lift1).mp h
  have hfun : metricDualToValueDual ℤ d8Lattice d8Lift1 = d8Lattice.obj.adjoint z := by
    rw [← hz, metricDualToValueDual_toMetricDual ℤ d8_isFractionFieldPerfect]
  have hEval := metricDualToValueDual_apply ℤ (L := d8Lattice) d8Lift1 d8sC
  rw [hfun, d8_lift1_eval] at hEval
  have hint : d8Lattice.obj.adjoint z d8sC = 1 := by
    apply (IsFractionRing.injective ℤ (FractionRing ℤ))
    simpa using hEval
  rw [BilinModuleCat.bilinMap_apply, d8_pairing_allones] at hint
  obtain ⟨m, hm⟩ := mem_d8Submodule.mp z.2
  omega


/-! ## Two-torsion classes -/

lemma d8Lift2_add_self : d8Lift2 + d8Lift2 = toMetricDual ℤ d8Lattice d8sC := by
  apply Subtype.ext
  change (d8Lift2 : RationalSpan ℤ d8Lattice) + (d8Lift2 : RationalSpan ℤ d8Lattice) =
    (toRationalSpan ℤ d8Lattice) d8sC
  rw [d8_lift2_coe, ← TensorProduct.add_tmul]
  have h2 : (2 : FractionRing ℤ) ≠ 0 := by
    simpa [map_zero, map_ofNat] using
      (Function.Injective.ne_iff (IsFractionRing.injective ℤ (FractionRing ℤ))).mpr
        two_ne_zero
  have hc : (2 : FractionRing ℤ)⁻¹ + (2 : FractionRing ℤ)⁻¹ = 1 := by
    rw [← two_mul, mul_inv_cancel₀ h2]
  rw [hc]
  rfl

lemma d8Lift1_add_self : d8Lift1 + d8Lift1 = toMetricDual ℤ d8Lattice d8twoE0C := by
  apply Subtype.ext
  change (d8Lift1 : RationalSpan ℤ d8Lattice) + (d8Lift1 : RationalSpan ℤ d8Lattice) =
    (toRationalSpan ℤ d8Lattice) d8twoE0C
  rw [d8_lift1_coe, ← TensorProduct.add_tmul]
  have h2 : (2 : FractionRing ℤ) ≠ 0 := by
    simpa [map_zero, map_ofNat] using
      (Function.Injective.ne_iff (IsFractionRing.injective ℤ (FractionRing ℤ))).mpr
        two_ne_zero
  have hc : (2 : FractionRing ℤ)⁻¹ + (2 : FractionRing ℤ)⁻¹ = 1 := by
    rw [← two_mul, mul_inv_cancel₀ h2]
  rw [hc]
  rfl

/-- The glue vector `s/2` is two-torsion in the discriminant group. -/
theorem d8_c2_two_torsion : (2 : ℤ) • d8c2 = 0 := by
  change (2 : ℤ) • d8c2 = 0
  rw [two_smul ℤ d8c2]
  rw [show d8c2 + d8c2 = metricDualToDiscriminant ℤ d8Lattice (d8Lift2 + d8Lift2) from by
    change (metricDualToDiscriminant ℤ d8Lattice) d8Lift2 +
      (metricDualToDiscriminant ℤ d8Lattice) d8Lift2 = _
    exact (map_add (metricDualToDiscriminant ℤ d8Lattice) d8Lift2 d8Lift2).symm]
  rw [d8Lift2_add_self]
  rw [show metricDualToDiscriminant ℤ d8Lattice
      (toMetricDual ℤ d8Lattice d8sC) = 0 from by
    exact (metricDualToDiscriminant_eq_zero_iff ℤ (L := d8Lattice)
      d8_isFractionFieldPerfect (toMetricDual ℤ d8Lattice d8sC)).mpr ⟨d8sC, rfl⟩]

/-- `e₀` is two-torsion in the discriminant group, although its quadratic value is nonzero. -/
theorem d8_c1_two_torsion : (2 : ℤ) • d8c1 = 0 := by
  change (2 : ℤ) • d8c1 = 0
  rw [two_smul ℤ d8c1]
  rw [show d8c1 + d8c1 = metricDualToDiscriminant ℤ d8Lattice (d8Lift1 + d8Lift1) from by
    change (metricDualToDiscriminant ℤ d8Lattice) d8Lift1 +
      (metricDualToDiscriminant ℤ d8Lattice) d8Lift1 = _
    exact (map_add (metricDualToDiscriminant ℤ d8Lattice) d8Lift1 d8Lift1).symm]
  rw [d8Lift1_add_self]
  rw [show metricDualToDiscriminant ℤ d8Lattice
      (toMetricDual ℤ d8Lattice d8twoE0C) = 0 from by
    exact (metricDualToDiscriminant_eq_zero_iff ℤ (L := d8Lattice)
      d8_isFractionFieldPerfect (toMetricDual ℤ d8Lattice d8twoE0C)).mpr ⟨d8twoE0C, rfl⟩]


/-! ## Two distinct quadratic-isotropic subgroups and distinct even overlattices -/

/-- The discriminant value module at the quotient's own module instance. -/
local instance d8DoubleFractionModule : Module ℤ (DoubleFractionValueQuotient ℤ) :=
  Submodule.Quotient.module (LinearMap.range (doubleAlgebraMap ℤ))

/-- The bilinear discriminant value module at the quotient's own instance. -/
local instance d8FractionModule : Module ℤ (FractionValueQuotient ℤ) :=
  Submodule.Quotient.module (LinearMap.range (Algebra.linearMap ℤ (FractionRing ℤ)))

/-- The quadratic-isotropic subgroup generated by the class of `s/2`. -/
noncomputable def d8H2 : EvenDiscriminantIsotropicSubgroup d8_isFractionFieldPerfect d8_isEven :=
  ⟨Submodule.span ℤ {d8c2},
    (evenDiscriminantQuadraticObject d8Lattice d8_isFractionFieldPerfect
      d8_isEven).span_singleton_isTotallyIsotropic d8_q_c2⟩

/-- The quadratic-isotropic subgroup generated by the class of `s/2 + e₀`. -/
noncomputable def d8H3 : EvenDiscriminantIsotropicSubgroup d8_isFractionFieldPerfect d8_isEven :=
  ⟨Submodule.span ℤ {d8c3},
    (evenDiscriminantQuadraticObject d8Lattice d8_isFractionFieldPerfect
      d8_isEven).span_singleton_isTotallyIsotropic d8_q_c3⟩

/-- The two isotropic subgroups are distinct: if they agreed, `e₀` would lie in the span of `s/2`,
forcing its quadratic value to vanish. -/
theorem d8H2_ne_d8H3 : d8H2 ≠ d8H3 := by
  intro h
  have hc2 : d8c2 ∈ (d8H3).1 := by
    rw [← h]
    exact Submodule.mem_span_singleton_self d8c2
  have hc1 : d8c1 ∈ (d8H3).1 := by
    have hc : d8c1 = d8c3 - d8c2 := by
      change (metricDualToDiscriminant ℤ d8Lattice d8Lift1) =
        (metricDualToDiscriminant ℤ d8Lattice (d8Lift2 + d8Lift1)) -
          (metricDualToDiscriminant ℤ d8Lattice d8Lift2)
      rw [← map_sub]
      congr 1
      abel
    rw [hc]
    exact (d8H3).1.sub_mem (Submodule.mem_span_singleton_self d8c3) hc2
  obtain ⟨n, hn⟩ := Submodule.mem_span_singleton.mp hc1
  have hq := congrArg (evenDiscriminantQuadraticMap d8Lattice d8_isFractionFieldPerfect d8_isEven) hn
  rw [QuadraticMap.map_smul, d8_q_c3, smul_zero] at hq
  exact d8_q_c1_ne_zero hq.symm

/-- The even overlattice glued by the subgroup of `s/2`. -/
noncomputable def d8V2 : Overlattice ℤ d8Lattice :=
  evenOverlatticeFromIsotropicSubgroup d8_isFractionFieldPerfect d8_isEven d8H2

/-- The even overlattice glued by the subgroup of `s/2 + e₀`. -/
noncomputable def d8V3 : Overlattice ℤ d8Lattice :=
  evenOverlatticeFromIsotropicSubgroup d8_isFractionFieldPerfect d8_isEven d8H3

/-- The overlattice of `s/2` is even. -/
theorem d8V2_isEven : d8V2.IsEven :=
  evenOverlatticeFromIsotropicSubgroup_isEven d8_isFractionFieldPerfect d8_isEven d8H2

/-- The overlattice of `s/2 + e₀` is even. -/
theorem d8V3_isEven : d8V3.IsEven :=
  evenOverlatticeFromIsotropicSubgroup_isEven d8_isFractionFieldPerfect d8_isEven d8H3

/-- The two even overlattices are distinct. If they agreed, the subgroup-side inverse law of the
correspondence would identify their gluing subgroups, contradicting `d8H2_ne_d8H3`. -/
theorem d8V2_ne_d8V3 : d8V2 ≠ d8V3 := by
  intro h
  apply d8H2_ne_d8H3
  apply Subtype.ext
  have hs := congrArg (fun M : Overlattice ℤ d8Lattice => M.glueSubgroup) h
  change (evenOverlatticeFromIsotropicSubgroup d8_isFractionFieldPerfect d8_isEven d8H2).glueSubgroup =
    (evenOverlatticeFromIsotropicSubgroup d8_isFractionFieldPerfect d8_isEven d8H3).glueSubgroup at hs
  rw [show (evenOverlatticeFromIsotropicSubgroup d8_isFractionFieldPerfect d8_isEven d8H2) =
      overlatticeFromIsotropicSubgroup ℤ d8_isFractionFieldPerfect d8H2.toBilinear from rfl,
    show (evenOverlatticeFromIsotropicSubgroup d8_isFractionFieldPerfect d8_isEven d8H3) =
      overlatticeFromIsotropicSubgroup ℤ d8_isFractionFieldPerfect d8H3.toBilinear from rfl,
    glue_overlatticeFromIsotropicSubgroup d8_isFractionFieldPerfect d8H2.toBilinear,
    glue_overlatticeFromIsotropicSubgroup d8_isFractionFieldPerfect d8H3.toBilinear] at hs
  exact hs


/-! ## The nearby-invalid case: 2-torsion not quadratic-isotropic -/

/-- `e₀` has bilinear discriminant self-pairing zero: its self-pairing is integral, and the
projection kills integers. Hence `⟨[e₀]⟩` is a perfectly valid bilinear isotropic subgroup. -/
theorem d8_bilin_c1 : (discriminantBilinObject ℤ d8Lattice d8_isFractionFieldPerfect).pairing d8c1 d8c1 = 0 := by
  rw [show d8c1 = metricDualToDiscriminant ℤ d8Lattice d8Lift1 from rfl,
    discriminant_pairing_metricDualToDiscriminant, d8_lift1_coe, rationalizedForm_tmul,
    show d8Lattice.obj.pairing d8twoE0C d8twoE0C = 4 from d8twoE0_sq]
  have h2 : (2 : FractionRing ℤ) ≠ 0 := by
    simpa [map_zero, map_ofNat] using
      (Function.Injective.ne_iff (IsFractionRing.injective ℤ (FractionRing ℤ))).mpr
        two_ne_zero
  have hnorm : (((2 : FractionRing ℤ)⁻¹ * (2 : FractionRing ℤ)⁻¹) *
      algebraMap ℤ (FractionRing ℤ) 4) =
      algebraMap ℤ (FractionRing ℤ) 1 := by
    push_cast
    field_simp [h2]
    norm_num
  rw [hnorm]
  exact fractionValueProjection_algebraMap ℤ 1

/-- `e₀`, typed directly in the discriminant bilinear object's carrier. -/
noncomputable def d8c1C : (discriminantBilinObject ℤ d8Lattice
    d8_isFractionFieldPerfect).carrier := d8c1

theorem d8_bilin_c1C : (discriminantBilinObject ℤ d8Lattice
    d8_isFractionFieldPerfect).pairing d8c1C d8c1C = 0 := d8_bilin_c1

/-- The subgroup generated by `e₀` is bilinear-isotropic, but is not quadratic-isotropic (its
quadratic value was proved nonzero). -/
noncomputable def d8Hbad : DiscriminantIsotropicSubgroup ℤ d8_isFractionFieldPerfect :=
  ⟨(show Submodule ℤ (discriminantBilinObject ℤ d8Lattice
      d8_isFractionFieldPerfect).carrier from Submodule.span ℤ {d8c1C}),
    (discriminantBilinObject ℤ d8Lattice d8_isFractionFieldPerfect).span_singleton_isTotallyIsotropic
      d8_bilin_c1C⟩

/-- The integral overlattice attached to `⟨[e₀]⟩`. It is integral because the subgroup is
bilinear-isotropic, but it cannot be even, because `e₀` has odd norm. -/
noncomputable def d8badV : Overlattice ℤ d8Lattice :=
  overlatticeFromIsotropicSubgroup ℤ d8_isFractionFieldPerfect d8Hbad

/-- The nearby-invalid case: the integral overlattice attached to `⟨[e₀]⟩` is not even.
If it were even, its gluing subgroup would be quadratic-isotropic by evenness transfer, so the
inverse law would make `⟨[e₀]⟩` quadratic-isotropic — contradicting the nonzero quadratic value. -/
theorem d8badV_not_even : ¬ d8badV.IsEven := by
  intro hEven
  have hq := glueSubgroup_isTotallyIsotropic_quadratic
    d8_isFractionFieldPerfect d8_isEven d8badV hEven
  have hs : d8badV.glueSubgroup = d8Hbad.1 :=
    glue_overlatticeFromIsotropicSubgroup d8_isFractionFieldPerfect d8Hbad
  rw [hs] at hq
  change ∀ x ∈ Submodule.span ℤ {d8c1C},
    evenDiscriminantQuadraticMap d8Lattice d8_isFractionFieldPerfect d8_isEven x = 0 at hq
  exact d8_q_c1_ne_zero (hq d8c1C (Submodule.mem_span_singleton_self d8c1C))

end LeanCategories.Lattices.Valued
