/-!
# Chambers, walls and Coxeter diagrams of a Lorentzian reflection group

For an integral lattice `L` of signature `(1, n)` with its reflection group `W(L)`
(`weylSubgroup`: the subgroup of `O(L)` generated by the reflections in the negative-square
reflective roots, `WeylCone.lean`), this file defines the chambers of `W(L)` in the positive
cone: the connected components of the chosen sheet `C⁺` of the positive cone minus the mirrors
of the negative reflective roots. For a root set `R` it defines the cone
`C(R) = {x ∈ C⁺ : (x, r) ≥ 0 for r ∈ R}`, its interior, the predicate `IsChamberWithWalls`
that `C(R)` is a chamber with walls `R`, the wall faces of the chamber cone through the
`PointedCone.IsFaceOf` owner, and the Coxeter diagram of a family of roots, whose edge weights
are the normalized pairing squares `(r, s)² / (r² s²)`.

## The chamber theory proved here

The layer of Bourbaki, *Groupes et algèbres de Lie*, Ch. V, §1 (printed pp. 61–69) that does
not need the properness hypothesis (D2): the pairing with a root has constant strict sign on a
chamber (the sign functions are continuous and never vanish on the regular locus), a segment
whose endpoints pair with every root with the same strict sign stays in the regular locus (the
pairing is affine along a segment, so it cannot vanish between same-sign values), hence
chambers are convex (Bourbaki V §1 no. 2, Prop. 3 (i), p. 63) and the interior cone of a wall
root set with regular interior is exactly the chamber of any of its points (Bourbaki V §1
no. 2, Prop. 5, pp. 64–65). Every isometry of the lattice permutes the mirrors, and the
elements of `W(L)` preserve the sheet, so `W(L)` permutes the chambers (Bourbaki V §3 no. 1,
p. 77: any displacement of `W` permutes the chambers, facets and walls).

The wall reflections of a chamber generate `W(L)` and `W(L)` acts simply transitively on the
chambers (Bourbaki V §3 no. 2, Th. 1, p. 78, from Lemma 2 (iii), p. 77, via the local finiteness
of Lemma 1 from the properness condition (D2), p. 77) are not proved here: in this setting (D2)
is the discreteness of `O(L)` in `O(L ⊗ ℝ)` — the matrix presentation of
`TopologicalOrthogonalGroup.lean` — and the Bourbaki chain through local finiteness, the
closest-point argument of Lemma 2 (i) and the exchange conditions of Ch. IV §1 no. 7 is future
work.

## References

* N. Bourbaki, *Lie Groups and Lie Algebras*, Chapters 4–6, Ch. V §1 (pp. 61–69) and §3
  (pp. 76–84), Springer, 2002.
* E. B. Vinberg, *The groups of units of certain quadratic forms*, Mat. Sb. 87 (1972), §1:
  the chambers of the reflection group of a lattice in the positive cone.
-/

@[expose] public section

open QuadraticMap
open LeanCategories.Algebra
open LeanCategories.Modules.Bilinear.Valued
open PointedCone
open scoped Convex

namespace LeanCategories.Lattices.Valued

variable (L : FiniteProjectiveLatticeCat ℤ ℤ)

/-! ## The topology of the real form -/

/-- The canonical topology of the real form: Mathlib's module topology, under which every
linear map out of the carrier is continuous. The real form is a finite-dimensional real vector
space with no chosen topology; this instance fixes one, once per lattice. -/
noncomputable instance realFormCarrierTopology : TopologicalSpace (realForm L).obj.carrier :=
  moduleTopology ℝ _

instance realFormCarrierIsModuleTopology : IsModuleTopology ℝ (realForm L).obj.carrier :=
  ⟨rfl⟩

instance realFormCarrierContinuousAdd : ContinuousAdd (realForm L).obj.carrier :=
  IsModuleTopology.toContinuousAdd ℝ (realForm L).obj.carrier

instance realFormCarrierContinuousSMul : ContinuousSMul ℝ (realForm L).obj.carrier :=
  IsModuleTopology.toContinuousSMul ℝ (realForm L).obj.carrier

/-- The real linear functional of a root: the pairing with the image of `r` in the real form. -/
noncomputable def rootFunctional (r : L.obj.obj.carrier) :
    (realForm L).obj.carrier →ₗ[ℝ] ℝ :=
  (realForm L).obj.rightAdjoint (toRealForm L r)

theorem rootFunctional_apply (r : L.obj.obj.carrier) (x : (realForm L).obj.carrier) :
    rootFunctional L r x = (realForm L).obj.pairing x (toRealForm L r) := rfl

/-- The root functional is continuous: the module topology makes every linear map out of the
real form continuous. -/
theorem continuous_rootFunctional (r : L.obj.obj.carrier) :
    Continuous (rootFunctional L r) :=
  IsModuleTopology.continuous_of_linearMap _

/-- The pairing of the real form is the associated bilinear form of its quadratic form, so the
`PositiveCone` API for `associated (realFormQuadratic L)` applies to it. -/
theorem realFormPairing_eq_associated (x y : (realForm L).obj.carrier) :
    (realForm L).obj.pairing x y = (associated (realFormQuadratic L)) x y := by
  have hsymm : ∀ u v, (realForm L).obj.bilinMap u v = (realForm L).obj.bilinMap v u :=
    fun u v => (realForm L).property.2 u v
  have hassoc : (associated (realFormQuadratic L)) = (realForm L).obj.bilinMap :=
    QuadraticMap.associated_left_inverse (S := ℝ) hsymm
  rw [hassoc]
  rfl

/-! ## The mirror arrangement -/

/-- The reflective roots of negative square: the roots whose reflections generate `W(L)`
(`weylGenerators` in `WeylCone.lean`). -/
def negativeReflectiveRoots : Set L.obj.obj.carrier :=
  {r | IsReflectiveRoot L.obj r ∧ L.obj.obj.pairing r r < 0}

theorem mem_negativeReflectiveRoots_iff {r : L.obj.obj.carrier} :
    r ∈ negativeReflectiveRoots L ↔
      IsReflectiveRoot L.obj r ∧ L.obj.obj.pairing r r < 0 :=
  Iff.rfl

/-- The real mirror of a root `r`: the orthogonal complement of the image of `r` in the
real form. -/
def rootMirror (r : L.obj.obj.carrier) : Set (realForm L).obj.carrier :=
  {x | (realForm L).obj.pairing x (toRealForm L r) = 0}

theorem mem_rootMirror_iff {r : L.obj.obj.carrier} {x : (realForm L).obj.carrier} :
    x ∈ rootMirror L r ↔ rootFunctional L r x = 0 :=
  Iff.rfl

/-- The mirror arrangement of `L`: the union of the root hyperplanes of all negative
reflective roots. -/
def rootMirrorArrangement : Set (realForm L).obj.carrier :=
  ⋃ r ∈ negativeReflectiveRoots L, rootMirror L r

theorem mem_rootMirrorArrangement_iff {x : (realForm L).obj.carrier} :
    x ∈ rootMirrorArrangement L ↔
      ∃ r ∈ negativeReflectiveRoots L, x ∈ rootMirror L r := by
  rw [rootMirrorArrangement, Set.mem_iUnion₂]
  constructor
  · rintro ⟨i, hi, hx⟩
    exact ⟨i, hi, hx⟩
  · rintro ⟨r, hr, hx⟩
    exact ⟨r, hr, hx⟩

/-! ## The regular locus and the chambers -/

variable (t : (realForm L).obj.carrier)

/-- The regular locus in the positive cone: the chosen sheet minus the mirror arrangement. -/
noncomputable def weylRegularLocus : Set (realForm L).obj.carrier :=
  positiveCone.upper (realFormQuadratic L) t \ rootMirrorArrangement L

theorem mem_weylRegularLocus_iff {x : (realForm L).obj.carrier} :
    x ∈ weylRegularLocus L t ↔
      x ∈ positiveCone.upper (realFormQuadratic L) t ∧
        ∀ r ∈ negativeReflectiveRoots L, (realForm L).obj.pairing x (toRealForm L r) ≠ 0 := by
  constructor
  · intro hx
    obtain ⟨hxu, hxm⟩ := hx
    refine ⟨hxu, ?_⟩
    intro r hr hpair
    exact hxm ((mem_rootMirrorArrangement_iff L).mpr ⟨r, hr, hpair⟩)
  · rintro ⟨hxu, hxr⟩
    refine ⟨hxu, ?_⟩
    intro hxm
    obtain ⟨r, hr, hpair⟩ := (mem_rootMirrorArrangement_iff L).mp hxm
    exact hxr r hr hpair

theorem weylRegularLocus_subset :
    weylRegularLocus L t ⊆ positiveCone.upper (realFormQuadratic L) t :=
  fun _ hx => hx.1

/-- The **chamber** of a regular point: the connected component of the regular locus
containing it (Bourbaki V §1 no. 3, Def. 2 and the discussion after it, p. 64: the chambers
are exactly the connected components of the complement of the hyperplanes). -/
noncomputable def chamberOf (x : (realForm L).obj.carrier) : Set (realForm L).obj.carrier :=
  connectedComponentIn (weylRegularLocus L t) x
theorem mem_chamberOf {x : (realForm L).obj.carrier} (hx : x ∈ weylRegularLocus L t) :
    x ∈ chamberOf L t x :=
  mem_connectedComponentIn hx

theorem chamberOf_subset (x : (realForm L).obj.carrier) :
    chamberOf L t x ⊆ weylRegularLocus L t :=
  connectedComponentIn_subset _ _

theorem isConnected_chamberOf {x : (realForm L).obj.carrier}
    (hx : x ∈ weylRegularLocus L t) : IsConnected (chamberOf L t x) :=
  isConnected_connectedComponentIn_iff.mpr hx

/-! ## Pairing signs on the regular locus -/

/-- The pairing with a fixed root is affine along a segment: its value on a linear combination
is the same combination of its values. -/
theorem pairing_segment (r : L.obj.obj.carrier) (x y : (realForm L).obj.carrier)
    (a b : ℝ) :
    (realForm L).obj.pairing (a • x + b • y) (toRealForm L r)
      = a * (realForm L).obj.pairing x (toRealForm L r)
        + b * (realForm L).obj.pairing y (toRealForm L r) := by
  rw [BilinModuleCat.pairing_add_left, BilinModuleCat.pairing_smul_left,
    BilinModuleCat.pairing_smul_left, smul_eq_mul, smul_eq_mul]

/-- A convex combination of two positive numbers is positive. -/
private theorem add_pos_comb {A B : ℝ} (hA : 0 < A) (hB : 0 < B) {a b : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1) : 0 < a * A + b * B := by
  rcases eq_or_lt_of_le ha with ha0 | ha0
  · subst ha0
    have hb1 : b = 1 := by linarith
    rw [zero_mul, zero_add, hb1, one_mul]
    exact hB
  · have h1 : 0 < a * A := mul_pos ha0 hA
    have h2 : 0 ≤ b * B := mul_nonneg hb hB.le
    linarith

/-- A convex combination of two negative numbers is negative. -/
private theorem add_neg_comb {A B : ℝ} (hA : A < 0) (hB : B < 0) {a b : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1) : a * A + b * B < 0 := by
  rcases eq_or_lt_of_le ha with ha0 | ha0
  · subst ha0
    have hb1 : b = 1 := by linarith
    rw [zero_mul, zero_add, hb1, one_mul]
    exact hB
  · have h1 : a * A < 0 := mul_neg_of_pos_of_neg ha0 hA
    have h2 : b * B ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hb hB.le
    linarith

/-- A convex combination of two numbers of the same strict sign has that sign: the affine
interpolation between same-sign values never vanishes. Stated in the `0 < product` form in
which the sign hypothesis is used below. -/
private theorem pos_mul_comb {A B : ℝ} (h : 0 < A * B) {a b : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hab : a + b = 1) :
    0 < A * (a * A + b * B) ∧ 0 < B * (a * A + b * B) := by
  rcases mul_pos_iff.mp h with ⟨hA, hB⟩ | ⟨hA, hB⟩
  · exact ⟨mul_pos hA (add_pos_comb hA hB ha hb hab),
      mul_pos hB (add_pos_comb hA hB ha hb hab)⟩
  · exact ⟨mul_pos_of_neg_of_neg hA (add_neg_comb hA hB ha hb hab),
      mul_pos_of_neg_of_neg hB (add_neg_comb hA hB ha hb hab)⟩

/-- Same-sign transitivity, in product form. -/
private theorem pos_mul_trans {A B C : ℝ} (h1 : 0 < A * B) (h2 : 0 < B * C) :
    0 < A * C := by
  rcases mul_pos_iff.mp h1 with ⟨hA, hB⟩ | ⟨hA, hB⟩
  · rcases mul_pos_iff.mp h2 with ⟨hB', hC⟩ | ⟨hB', hC⟩
    · exact mul_pos hA hC
    · exact absurd hB' (not_lt.mpr hB.le)
  · rcases mul_pos_iff.mp h2 with ⟨hB', hC⟩ | ⟨hB', hC⟩
    · exact absurd hB' (not_lt.mpr hB.le)
    · exact mul_pos_of_neg_of_neg hA hC

/-- A connected set on which a continuous real function never vanishes lies on one side of
zero. -/
private theorem connected_pos_or_neg {X : Type*} [TopologicalSpace X] {s : Set X}
    (hs : IsConnected s) {f : X → ℝ} (hf : Continuous f) (hf0 : ∀ z ∈ s, f z ≠ 0) :
    (∀ z ∈ s, 0 < f z) ∨ ∀ z ∈ s, f z < 0 := by
  by_contra hcon
  push Not at hcon
  obtain ⟨⟨y, hy, hyf⟩, ⟨z, hz, hzf⟩⟩ := hcon
  have hy0 : f y < 0 := lt_of_le_of_ne hyf (hf0 y hy)
  have hz0 : 0 < f z := lt_of_le_of_ne hzf (Ne.symm (hf0 z hz))
  have hord : (f '' s).OrdConnected :=
    isPreconnected_iff_ordConnected.mp (hs.image f hf.continuousOn).isPreconnected
  have h0mem : (0:ℝ) ∈ f '' s :=
    hord.out (Set.mem_image_of_mem f hy) (Set.mem_image_of_mem f hz)
      (Set.mem_Icc.mpr ⟨hy0.le, hz0.le⟩)
  obtain ⟨w, hw, hwf⟩ := h0mem
  exact hf0 w hw hwf

/-- The sign of the pairing with a root is constant on a chamber: the root functional is
continuous and never vanishes on the regular locus, and a connected set on which a continuous
real function never vanishes lies on one side of zero (Bourbaki V §1 no. 1, p. 62: points in
one facet are on the same side of every hyperplane). -/
theorem exists_chamberOf_sign {x : (realForm L).obj.carrier} (hx : x ∈ weylRegularLocus L t)
    {r : L.obj.obj.carrier} (hr : r ∈ negativeReflectiveRoots L) :
    (∀ z ∈ chamberOf L t x, 0 < (realForm L).obj.pairing z (toRealForm L r)) ∨
      (∀ z ∈ chamberOf L t x, (realForm L).obj.pairing z (toRealForm L r) < 0) := by
  have hne : ∀ z ∈ chamberOf L t x, (realForm L).obj.pairing z (toRealForm L r) ≠ 0 := by
    intro z hz
    exact ((mem_weylRegularLocus_iff L t).mp (chamberOf_subset L t x hz)).2 r hr
  simpa only [rootFunctional_apply] using
    connected_pos_or_neg (isConnected_chamberOf L t hx) (continuous_rootFunctional L r) hne

/-- Two points of the same chamber pair with every negative reflective root with the same
strict sign. -/
theorem pos_mul_of_mem_chamberOf {x y z : (realForm L).obj.carrier}
    (hx : x ∈ weylRegularLocus L t) (hy : y ∈ chamberOf L t x) (hz : z ∈ chamberOf L t x)
    {r : L.obj.obj.carrier} (hr : r ∈ negativeReflectiveRoots L) :
    0 < (realForm L).obj.pairing y (toRealForm L r) *
      (realForm L).obj.pairing z (toRealForm L r) := by
  rcases exists_chamberOf_sign L t hx hr with h | h
  · exact mul_pos (h y hy) (h z hz)
  · exact mul_pos_of_neg_of_neg (h y hy) (h z hz)

/-- If two points of the positive cone pair with every negative reflective root with the same
strict sign, the segment between them stays in the regular locus: the pairing is affine along
a segment, so it cannot vanish between same-sign values. -/
theorem segment_subset_weylRegularLocus_of_pos_mul (hpos : (integralSignature L).1 = 1)
    (ht : 0 < realFormQuadratic L t)
    (x y : (realForm L).obj.carrier)
    (hx : x ∈ positiveCone.upper (realFormQuadratic L) t)
    (hy : y ∈ positiveCone.upper (realFormQuadratic L) t)
    (hsign : ∀ r ∈ negativeReflectiveRoots L,
      0 < (realForm L).obj.pairing x (toRealForm L r) *
        (realForm L).obj.pairing y (toRealForm L r)) :
    [x -[ℝ] y] ⊆ weylRegularLocus L t := by
  have hupper : [x -[ℝ] y] ⊆ positiveCone.upper (realFormQuadratic L) t :=
    (convex_upper (realFormQuadratic L) hpos ht).segment_subset hx hy
  intro w hw
  obtain ⟨a, b, ha, hb, hab, rfl⟩ := hw
  have hmem : a • x + b • y ∈ [x -[ℝ] y] := ⟨a, b, ha, hb, hab, rfl⟩
  refine (mem_weylRegularLocus_iff L t).mpr ⟨hupper hmem, ?_⟩
  intro r hr hpair
  have hcomb := (pos_mul_comb (hsign r hr) ha hb hab).1
  rw [pairing_segment L r x y a b] at hpair
  rw [hpair, mul_zero] at hcomb
  exact absurd hcomb (not_lt.mpr (le_refl 0))

/-- Two regular points whose pairings with every negative reflective root have the same strict
sign lie in the same chamber. -/
theorem chamberOf_eq_of_pos_mul {x y : (realForm L).obj.carrier}
    (hx : x ∈ weylRegularLocus L t) (hy : y ∈ weylRegularLocus L t)
    (hpos : (integralSignature L).1 = 1) (ht : 0 < realFormQuadratic L t)
    (hsign : ∀ r ∈ negativeReflectiveRoots L,
      0 < (realForm L).obj.pairing x (toRealForm L r) *
        (realForm L).obj.pairing y (toRealForm L r)) :
    chamberOf L t x = chamberOf L t y := by
  have hseg : [x -[ℝ] y] ⊆ weylRegularLocus L t :=
    segment_subset_weylRegularLocus_of_pos_mul L t hpos ht x y hx.1 hy.1 hsign
  have hconn : IsPreconnected [x -[ℝ] y] :=
    (convex_segment (𝕜 := ℝ) x y).isPreconnected
  have hxmem : x ∈ [x -[ℝ] y] :=
    ⟨1, 0, by norm_num, by norm_num, by norm_num, by simp⟩
  have hymem : y ∈ [x -[ℝ] y] :=
    ⟨0, 1, by norm_num, by norm_num, by norm_num, by simp⟩
  exact connectedComponentIn_eq (hconn.subset_connectedComponentIn hxmem hseg hymem)

/-- **Chambers are convex** (Bourbaki V §1 no. 2, Prop. 3 (i), p. 63): the chamber of a
regular point is a convex subset of the real form. -/
theorem convex_chamberOf (hpos : (integralSignature L).1 = 1)
    (ht : 0 < realFormQuadratic L t) {x : (realForm L).obj.carrier}
    (hx : x ∈ weylRegularLocus L t) : Convex ℝ (chamberOf L t x) := by
  rw [convex_iff_add_mem]
  intro y hy z hz a b ha hb hab
  have hprod : ∀ r ∈ negativeReflectiveRoots L,
      0 < (realForm L).obj.pairing y (toRealForm L r) *
        (realForm L).obj.pairing z (toRealForm L r) :=
    fun r hr => pos_mul_of_mem_chamberOf L t hx hy hz hr
  have hwupper : a • y + b • z ∈ positiveCone.upper (realFormQuadratic L) t := by
    have hmem : a • y + b • z ∈ [y -[ℝ] z] := ⟨a, b, ha, hb, hab, rfl⟩
    exact (convex_upper (realFormQuadratic L) hpos ht).segment_subset
      (chamberOf_subset L t x hy).1 (chamberOf_subset L t x hz).1 hmem
  have hwreg : a • y + b • z ∈ weylRegularLocus L t := by
    refine (mem_weylRegularLocus_iff L t).mpr ⟨hwupper, ?_⟩
    intro r hr
    have hcomb := (pos_mul_comb (hprod r hr) ha hb hab).1
    intro hzero
    rw [pairing_segment L r y z a b] at hzero
    rw [hzero, mul_zero] at hcomb
    exact absurd hcomb (not_lt.mpr (le_refl 0))
  have hsign : ∀ r ∈ negativeReflectiveRoots L,
      0 < (realForm L).obj.pairing x (toRealForm L r) *
        (realForm L).obj.pairing (a • y + b • z) (toRealForm L r) := by
    intro r hr
    have hprodxy : 0 < (realForm L).obj.pairing x (toRealForm L r) *
        (realForm L).obj.pairing y (toRealForm L r) :=
      pos_mul_of_mem_chamberOf L t hx (mem_chamberOf L t hx) hy hr
    have hcombyw := (pos_mul_comb (hprod r hr) ha hb hab).1
    rw [pairing_segment L r y z a b]
    exact pos_mul_trans hprodxy hcombyw
  rw [chamberOf_eq_of_pos_mul L t hx hwreg hpos ht hsign]
  exact mem_chamberOf L t hwreg


/-! ## The cone of a root set -/

/-- **The cone of a root set** `C(R)`: the points of the positive cone pairing nonnegatively
with every root of `R`. -/
def weylChamberCone (R : Set L.obj.obj.carrier) : Set (realForm L).obj.carrier :=
  {z | z ∈ positiveCone.upper (realFormQuadratic L) t ∧
    ∀ r ∈ R, 0 ≤ (realForm L).obj.pairing z (toRealForm L r)}

theorem mem_weylChamberCone_iff {z : (realForm L).obj.carrier} :
    z ∈ weylChamberCone L t R ↔
      z ∈ positiveCone.upper (realFormQuadratic L) t ∧
        ∀ r ∈ R, 0 ≤ (realForm L).obj.pairing z (toRealForm L r) :=
  Iff.rfl

/-- The interior cone of a root set: the points of the positive cone pairing strictly
positively with every root of `R`. -/
def rootInteriorCone (R : Set L.obj.obj.carrier) : Set (realForm L).obj.carrier :=
  {z | z ∈ positiveCone.upper (realFormQuadratic L) t ∧
    ∀ r ∈ R, 0 < (realForm L).obj.pairing z (toRealForm L r)}

theorem mem_rootInteriorCone_iff {z : (realForm L).obj.carrier} :
    z ∈ rootInteriorCone L t R ↔
      z ∈ positiveCone.upper (realFormQuadratic L) t ∧
        ∀ r ∈ R, 0 < (realForm L).obj.pairing z (toRealForm L r) :=
  Iff.rfl

theorem rootInteriorCone_subset_weylChamberCone :
    rootInteriorCone L t R ⊆ weylChamberCone L t R := by
  intro z hz
  exact ⟨hz.1, fun r hr => le_of_lt (hz.2 r hr)⟩

/-- The interior cone of a root set is convex: the sheet is convex and the strict half-space
conditions are preserved by convex combination, the pairing being affine along segments. -/
theorem convex_rootInteriorCone (hpos : (integralSignature L).1 = 1)
    (ht : 0 < realFormQuadratic L t) (R : Set L.obj.obj.carrier) :
    Convex ℝ (rootInteriorCone L t R) := by
  rw [convex_iff_add_mem]
  intro x hx y hy a b ha hb hab
  have hmem : a • x + b • y ∈ [x -[ℝ] y] := ⟨a, b, ha, hb, hab, rfl⟩
  have hupper : a • x + b • y ∈ positiveCone.upper (realFormQuadratic L) t :=
    (convex_upper (realFormQuadratic L) hpos ht).segment_subset hx.1 hy.1 hmem
  refine ⟨hupper, ?_⟩
  intro r hr
  have h1 : 0 < a * (realForm L).obj.pairing x (toRealForm L r)
      + b * (realForm L).obj.pairing y (toRealForm L r) :=
    add_pos_comb (hx.2 r hr) (hy.2 r hr) ha hb hab
  rw [pairing_segment L r x y a b]
  exact h1

/-- The predicate that the cone `C(R)` is a chamber with walls `R`: every root of `R` is a
negative reflective root, the interior cone is nonempty, and no mirror meets the interior cone
(so the interior cone lies in the regular locus, and `R` is a complete wall set for the
chamber it cuts out). The wall-face content is carried by
`rootMirrorCone_isFaceOf_weylChamberPointedCone` and
`rootMirrorCone_ne_weylChamberPointedCone` below: the mirror section of each `r ∈ R` is a
proper face of the chamber cone. -/
structure IsChamberWithWalls (R : Set L.obj.obj.carrier) : Prop where
  roots_mem : R ⊆ negativeReflectiveRoots L
  interior_nonempty : (rootInteriorCone L t R).Nonempty
  interior_regular : rootInteriorCone L t R ⊆ weylRegularLocus L t

/-- **The chamber cut out by a wall root set** (Bourbaki V §1 no. 2, Prop. 5, pp. 64–65): if
`R` is a wall root set whose interior cone is regular, then the interior cone is exactly the
chamber of any of its points. -/
theorem IsChamberWithWalls.chamberOf_eq (hpos : (integralSignature L).1 = 1)
    (ht : 0 < realFormQuadratic L t) (hR : IsChamberWithWalls L t R)
    {z : (realForm L).obj.carrier} (hz : z ∈ rootInteriorCone L t R) :
    chamberOf L t z = rootInteriorCone L t R := by
  have hzreg : z ∈ weylRegularLocus L t := hR.interior_regular hz
  refine Set.Subset.antisymm ?_ ?_
  · intro w hw
    refine ⟨(chamberOf_subset L t z hw).1, ?_⟩
    intro r hr
    have hprod := pos_mul_of_mem_chamberOf L t hzreg (mem_chamberOf L t hzreg) hw
      (hR.roots_mem hr)
    rcases mul_pos_iff.mp hprod with ⟨-, h2⟩ | ⟨h1, -⟩
    · exact h2
    · exact absurd (hz.2 r hr) (not_lt.mpr h1.le)
  · exact (convex_rootInteriorCone L t hpos ht R).isPreconnected.subset_connectedComponentIn hz
      hR.interior_regular

/-! ## Walls as faces of the chamber cone -/

/-- The half-space cone of a root: the vectors of the real form pairing nonnegatively with
`r`, as a pointed cone. -/
noncomputable def rootHalfSpaceCone (r : L.obj.obj.carrier) :
    PointedCone ℝ (realForm L).obj.carrier where
  carrier := {z | 0 ≤ rootFunctional L r z}
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    rw [map_add]
    exact add_nonneg hx hy
  zero_mem' := by
    simp only [Set.mem_setOf_eq]
    rw [map_zero]
  smul_mem' := by
    intro c x hx
    simp only [Set.mem_setOf_eq] at hx ⊢
    rw [show c • x = (c : ℝ) • x from rfl, map_smul, smul_eq_mul]
    exact mul_nonneg c.2 hx

theorem mem_rootHalfSpaceCone (r : L.obj.obj.carrier) {z : (realForm L).obj.carrier} :
    z ∈ rootHalfSpaceCone L r ↔ 0 ≤ (realForm L).obj.pairing z (toRealForm L r) :=
  Iff.rfl

/-- The chamber cone of a root set as a pointed cone: the vectors pairing nonnegatively with
every root of `R`. -/
noncomputable def weylChamberPointedCone (R : Set L.obj.obj.carrier) :
    PointedCone ℝ (realForm L).obj.carrier :=
  ⨅ r : {r : L.obj.obj.carrier // r ∈ R}, rootHalfSpaceCone L r.1

theorem mem_weylChamberPointedCone (R : Set L.obj.obj.carrier)
    {z : (realForm L).obj.carrier} :
    z ∈ weylChamberPointedCone L R ↔
      ∀ r ∈ R, 0 ≤ (realForm L).obj.pairing z (toRealForm L r) := by
  rw [weylChamberPointedCone, Submodule.mem_iInf]
  constructor
  · intro h r hr
    have h1 : z ∈ rootHalfSpaceCone L r := h ⟨r, hr⟩
    exact (mem_rootHalfSpaceCone L r).mp h1
  · intro h i
    exact (mem_rootHalfSpaceCone L i.1).mpr (h i.1 i.2)

/-- The wall cone of `r` in the root set `R`: the face of the chamber cone on the mirror of
`r`. -/
noncomputable def rootMirrorCone (R : Set L.obj.obj.carrier) (r : L.obj.obj.carrier) :
    PointedCone ℝ (realForm L).obj.carrier where
  carrier := {z | rootFunctional L r z = 0 ∧
    ∀ s ∈ R, 0 ≤ rootFunctional L s z}
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq] at hx hy ⊢
    constructor
    · rw [map_add]
      linarith [hx.1, hy.1]
    · intro s hs
      rw [map_add]
      exact add_nonneg (hx.2 s hs) (hy.2 s hs)
  zero_mem' := by
    simp only [Set.mem_setOf_eq]
    exact ⟨map_zero _, fun _ _ => le_of_eq (map_zero _).symm⟩
  smul_mem' := by
    intro c x hx
    simp only [Set.mem_setOf_eq] at hx ⊢
    refine ⟨?_, ?_⟩
    · rw [show c • x = (c : ℝ) • x from rfl, map_smul, smul_eq_mul]
      exact mul_eq_zero_of_right _ hx.1
    · intro s hs
      rw [show c • x = (c : ℝ) • x from rfl, map_smul, smul_eq_mul]
      exact mul_nonneg c.2 (hx.2 s hs)

theorem mem_rootMirrorCone (R : Set L.obj.obj.carrier) (r : L.obj.obj.carrier)
    {z : (realForm L).obj.carrier} :
    z ∈ rootMirrorCone L R r ↔
      (realForm L).obj.pairing z (toRealForm L r) = 0 ∧
        ∀ s ∈ R, 0 ≤ (realForm L).obj.pairing z (toRealForm L s) :=
  Iff.rfl

/-- **The wall of a chamber cone is a face** (Bourbaki V §1 no. 4, p. 65–66): the mirror
section of a wall root is a face of the chamber cone of the root set. -/
theorem rootMirrorCone_isFaceOf_weylChamberPointedCone (R : Set L.obj.obj.carrier)
    (r : L.obj.obj.carrier) (hr : r ∈ R) :
    (rootMirrorCone L R r).IsFaceOf (weylChamberPointedCone L R) := by
  constructor
  · intro z hz
    exact (mem_weylChamberPointedCone L R).mpr (((mem_rootMirrorCone L R r).mp hz).2)
  · intro x y a hx hy ha hxy
    have h2 := ((mem_rootMirrorCone L R r).mp hxy).1
    have hfx : 0 ≤ rootFunctional L r x :=
      (mem_rootHalfSpaceCone L r).mpr ((mem_weylChamberPointedCone L R).mp hx r hr)
    have hfy : 0 ≤ rootFunctional L r y :=
      (mem_rootHalfSpaceCone L r).mpr ((mem_weylChamberPointedCone L R).mp hy r hr)
    have hlin : rootFunctional L r (a • x + y)
        = a * rootFunctional L r x + rootFunctional L r y := by
      rw [map_add, map_smul, smul_eq_mul]
    have heq : a * rootFunctional L r x + rootFunctional L r y = 0 := by
      rw [← hlin, rootFunctional_apply]
      exact h2
    have hax : a * rootFunctional L r x = 0 :=
      le_antisymm (by linarith) (mul_nonneg ha.le hfx)
    have hzero : rootFunctional L r x = 0 := by
      rcases mul_eq_zero.mp hax with h | h
      · exact absurd h ha.ne'
      · exact h
    refine ((mem_rootMirrorCone L R r).mpr ⟨?_, (mem_weylChamberPointedCone L R).mp hx⟩)
    exact hzero

/-- The wall face is a proper face whenever the interior cone is nonempty: a point of the
interior cone lies in the chamber cone but not on the mirror. -/
theorem rootMirrorCone_ne_weylChamberPointedCone (R : Set L.obj.obj.carrier)
    (r : L.obj.obj.carrier) (hr : r ∈ R)
    (hint : (rootInteriorCone L t R).Nonempty) :
    rootMirrorCone L R r ≠ weylChamberPointedCone L R := by
  obtain ⟨z, hz⟩ := hint
  intro heq
  have hzc : z ∈ weylChamberPointedCone L R :=
    (mem_weylChamberPointedCone L R).mpr (fun s hs => le_of_lt (hz.2 s hs))
  rw [← heq] at hzc
  have hzero := ((mem_rootMirrorCone L R r).mp hzc).1
  have hz2 : 0 < (realForm L).obj.pairing z (toRealForm L r) := hz.2 r hr
  rw [hzero] at hz2
  exact absurd hz2 (by simp)

/-! ## The Coxeter diagram of a root family -/

/-- The edge weights of the Coxeter diagram of a root family: the normalized pairing
squares `(r i, r j)² / ((r i)² (r j)²)`. -/
noncomputable def coxeterDiagramOfRootsEdges {ι : Type*} (r : ι → L.obj.obj.carrier)
    (i j : ι) : ℚ :=
  (L.obj.obj.pairing (r i) (r j) : ℚ) ^ 2 /
    ((L.obj.obj.pairing (r i) (r i) : ℚ) * (L.obj.obj.pairing (r j) (r j) : ℚ))

/-- **The Coxeter diagram of a family of roots** (#23; Vinberg 1972, §1): the edge weight
between `r i` and `r j` is the normalized pairing square
`(r i, r j)² / ((r i)² (r j)²)`, a rational number since the pairings are integral. For
negative-square roots the denominator is positive, so the weights are nonnegative. The weight
is not the Coxeter order of the edge, and neither is a Gram entry: the Gram entry of a Coxeter
diagram edge of order `m` is `−2 cos (π / m)` with diagonal `2` (#23, comment 5). -/
noncomputable def coxeterDiagramOfRoots {ι : Type*} (r : ι → L.obj.obj.carrier)
    (hr : ∀ i, L.obj.obj.pairing (r i) (r i) < 0) : CoxeterDiagram ι where
  edges := coxeterDiagramOfRootsEdges L r
  edges_nonneg i j := by
    have hi : ((L.obj.obj.pairing (r i) (r i) : ℚ)) < 0 := by exact_mod_cast hr i
    have hj : ((L.obj.obj.pairing (r j) (r j) : ℚ)) < 0 := by exact_mod_cast hr j
    simp only [coxeterDiagramOfRootsEdges]
    exact div_nonneg (sq_nonneg _) (le_of_lt (mul_pos_of_neg_of_neg hi hj))
  edges_symm i j := by
    simp only [coxeterDiagramOfRootsEdges]
    rw [L.obj.property.2 (r i) (r j)]
    ring

theorem coxeterDiagramOfRoots_edges {ι : Type*} (r : ι → L.obj.obj.carrier)
    (hr : ∀ i, L.obj.obj.pairing (r i) (r i) < 0) (i j : ι) :
    (coxeterDiagramOfRoots L r hr).edges i j = coxeterDiagramOfRootsEdges L r i j :=
  rfl

/-! ## Isometries permute the mirrors and the chambers -/

section Isometry

/-- A lattice isometry preserves the pairing of the real form. -/
theorem realFormIsometry_pairing (g : OrthogonalGroup L.obj)
    (x y : (realForm L).obj.carrier) :
    (realForm L).obj.pairing (realFormOrthogonalHom L g x) (realFormOrthogonalHom L g y)
      = (realForm L).obj.pairing x y := by
  simp only [realFormPairing_eq_associated]
  exact associated_map _ x y

/-- A lattice isometry permutes the negative reflective roots. -/
theorem image_negativeReflectiveRoots (g : OrthogonalGroup L.obj) :
    (g.1 : L.obj.obj.carrier → L.obj.obj.carrier) '' negativeReflectiveRoots L
      = negativeReflectiveRoots L := by
  have hkey : ∀ g : OrthogonalGroup L.obj, ∀ s ∈ negativeReflectiveRoots L,
      (g.1 : L.obj.obj.carrier → L.obj.obj.carrier) s ∈ negativeReflectiveRoots L := by
    intro g s ⟨hs1, hs2⟩
    exact ⟨isReflectiveRoot_of_isometry L g hs1, by
      rw [isometry_pairing L g s s]
      exact hs2⟩
  refine Set.Subset.antisymm ?_ ?_
  · rintro s ⟨r, hr, rfl⟩
    exact hkey g r hr
  · intro s hs
    refine ⟨(g⁻¹ : OrthogonalGroup L.obj).1 s, ?_, ?_⟩
    · exact hkey (g⁻¹ : OrthogonalGroup L.obj) s hs
    · have hmul : (g : OrthogonalGroup L.obj).1
          ((g⁻¹ : OrthogonalGroup L.obj).1 s) = s := by
        have h1 : ((g * g⁻¹ : OrthogonalGroup L.obj).1 :
            L.obj.obj.carrier → L.obj.obj.carrier) s = s := by
          rw [mul_inv_cancel]
          rfl
        exact h1
      rw [hmul]

/-- A lattice isometry maps the mirror of a root onto the mirror of the image root. -/
theorem realFormIsometry_image_rootMirror (g : OrthogonalGroup L.obj)
    (r : L.obj.obj.carrier) :
    (realFormOrthogonalHom L g) '' rootMirror L r = rootMirror L (g.1 r) := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    show (realForm L).obj.pairing (realFormOrthogonalHom L g x) (toRealForm L (g.1 r)) = 0
    rw [← realFormOrthogonalHom_toRealForm L g r,
      realFormIsometry_pairing L g x (toRealForm L r)]
    exact hx
  · intro hy
    refine ⟨(realFormOrthogonalHom L g).symm y, ?_,
      (realFormOrthogonalHom L g).apply_symm_apply y⟩
    show (realForm L).obj.pairing ((realFormOrthogonalHom L g).symm y) (toRealForm L r) = 0
    rw [← realFormIsometry_pairing L g ((realFormOrthogonalHom L g).symm y) (toRealForm L r),
      realFormOrthogonalHom_toRealForm L g r,
      (realFormOrthogonalHom L g).apply_symm_apply y]
    exact hy

/-- A lattice isometry carries points of the arrangement into the arrangement. -/
theorem realFormIsometry_mem_rootMirrorArrangement (g : OrthogonalGroup L.obj)
    {y : (realForm L).obj.carrier} (hy : y ∈ rootMirrorArrangement L) :
    realFormOrthogonalHom L g y ∈ rootMirrorArrangement L := by
  obtain ⟨r, hr, hyr⟩ := (mem_rootMirrorArrangement_iff L).mp hy
  refine (mem_rootMirrorArrangement_iff L).mpr ⟨g.1 r, ?_, ?_⟩
  · exact (image_negativeReflectiveRoots L g).subset ⟨r, hr, rfl⟩
  · rw [← realFormIsometry_image_rootMirror L g r]
    exact Set.mem_image_of_mem _ hyr

/-- A lattice isometry permutes the mirror arrangement. -/
theorem realFormIsometry_image_rootMirrorArrangement (g : OrthogonalGroup L.obj) :
    (realFormOrthogonalHom L g) '' rootMirrorArrangement L = rootMirrorArrangement L := by
  have hsub : (realFormOrthogonalHom L g) '' rootMirrorArrangement L
      ⊆ rootMirrorArrangement L := by
    rintro y ⟨x, hx, rfl⟩
    exact realFormIsometry_mem_rootMirrorArrangement L g hx
  refine hsub.antisymm ?_
  rintro y hy
  refine ⟨(realFormOrthogonalHom L g).symm y, ?_,
    (realFormOrthogonalHom L g).apply_symm_apply y⟩
  have hinv : (realFormOrthogonalHom L g).symm y
      = realFormOrthogonalHom L (g⁻¹ : OrthogonalGroup L.obj) y := by
    have h1 : realFormOrthogonalHom L (g⁻¹ : OrthogonalGroup L.obj)
        = (realFormOrthogonalHom L g)⁻¹ := map_inv (realFormOrthogonalHom L) g
    rw [h1]
    rfl
  rw [hinv]
  exact realFormIsometry_mem_rootMirrorArrangement L (g⁻¹ : OrthogonalGroup L.obj) hy

/-- The homeomorphism of the real form underlying a lattice isometry. -/
noncomputable def realFormIsometryHomeomorph (g : OrthogonalGroup L.obj) :
    (realForm L).obj.carrier ≃ₜ (realForm L).obj.carrier where
  toFun x := realFormOrthogonalHom L g x
  invFun x := (realFormOrthogonalHom L g).symm x
  left_inv x := (realFormOrthogonalHom L g).symm_apply_apply x
  right_inv x := (realFormOrthogonalHom L g).apply_symm_apply x
  continuous_toFun := IsModuleTopology.continuous_of_linearMap
    ((realFormOrthogonalHom L g :
      (realForm L).obj.carrier ≃ₗ[ℝ] (realForm L).obj.carrier)).toLinearMap
  continuous_invFun := IsModuleTopology.continuous_of_linearMap
    ((realFormOrthogonalHom L g :
      (realForm L).obj.carrier ≃ₗ[ℝ] (realForm L).obj.carrier).symm.toLinearMap)

/-- **The reflection group permutes the chambers** (Bourbaki V §3 no. 1, p. 77: any
displacement of `W` permutes the chambers, facets and walls): an element of `W(L)` carries
the chamber of `x` to the chamber of its image. -/
theorem weylSubgroup_chamberOf_image (hL : L.obj.obj.IsNondegenerate)
    (h2 : IsRegular (2 : ℤ)) (hpos : (integralSignature L).1 = 1)
    (ht : 0 < realFormQuadratic L t)
    {w : OrthogonalGroup L.obj} (hw : w ∈ weylSubgroup L hL h2)
    {x : (realForm L).obj.carrier} (hx : x ∈ weylRegularLocus L t) :
    (realFormIsometryHomeomorph L w) '' chamberOf L t x
      = chamberOf L t (realFormOrthogonalHom L w x) := by
  have hupper : (realFormOrthogonalHom L w) '' positiveCone.upper (realFormQuadratic L) t
      = positiveCone.upper (realFormQuadratic L) t :=
    ((mem_positiveConeStabilizer_iff (realFormQuadratic L) hpos ht)
        (realFormOrthogonalHom L w)).mp
      (((mem_latticePositiveConeStabilizer_iff L hpos t ht) w).mp
        (weylSubgroup_le_latticePositiveConeStabilizer L hL h2 hpos ht hw))
  have himg : (realFormIsometryHomeomorph L w) '' weylRegularLocus L t
      = weylRegularLocus L t := by
    have hinj : Function.Injective (realFormOrthogonalHom L w) :=
      ((realFormOrthogonalHom L w :
        (realForm L).obj.carrier ≃ₗ[ℝ] (realForm L).obj.carrier)).injective
    have hfun : ((realFormIsometryHomeomorph L w) '' weylRegularLocus L t)
        = (realFormOrthogonalHom L w) '' weylRegularLocus L t := rfl
    rw [hfun, weylRegularLocus, Set.image_sdiff hinj, hupper,
      realFormIsometry_image_rootMirrorArrangement L w]
  show (realFormIsometryHomeomorph L w) ''
      connectedComponentIn (weylRegularLocus L t) x
    = chamberOf L t (realFormOrthogonalHom L w x)
  rw [(realFormIsometryHomeomorph L w).image_connectedComponentIn hx, himg]
  rfl

end Isometry


/-! ## The discreteness of `O(L)` in `O(L ⊗ ℝ)` (Bourbaki V §3, (D2), p. 77)

The matrix of the scalar extension of a lattice isometry in the base-change basis is the
ℤ-matrix of the isometry, cast into `ℝ`: the integrality of the arithmetic orthogonal group.
The real form of `L` is presented as a real integral lattice, so that the matrix topology of
`TopologicalOrthogonalGroup.lean` applies to its orthogonal group, and the image of `O(L)`
under scalar extension is a subgroup of it. Its discreteness is condition (D2) of Bourbaki V
§3 no. 1 (p. 77), the hypothesis of Lemma 1 (local finiteness of the mirror arrangement,
p. 77) and Lemma 2 (p. 77); see the module docstring for the chain. -/

section Discreteness

variable (L : FiniteProjectiveLatticeCat ℤ ℤ)
variable {I : Type} [Fintype I] [DecidableEq I]
variable (b : Module.Basis I ℤ L.obj.obj.carrier)

/-- The carrier of a finite projective lattice over `ℤ` is a free `ℤ`-module: the fact that
makes the basis datum of the matrix presentations below well defined. -/
noncomputable instance latticeCarrierFree : Module.Free ℤ L.obj.obj.carrier :=
  L.carrier_free

/-- The carrier of a finite projective lattice over `ℤ` is finite. -/
instance latticeCarrierFinite : Module.Finite ℤ L.obj.obj.carrier :=
  L.property

/-- The finite ℤ-basis of the carrier of `L`, as data: the chosen basis of the free
ℤ-module `L.obj.obj.carrier`, reindexed over `Fin n`, `n` the rank. The existence statement
this def replaces — a basis `b` with `Submodule.span ℤ (Set.range b) = ⊤` — holds of every
basis and stated nothing, so the basis itself is the datum (the property is `span_eq` of any
basis, in `Module.Basis.span_eq`). -/
noncomputable def carrierFinBasis :
    Module.Basis (Fin (Fintype.card (Module.Free.ChooseBasisIndex ℤ L.obj.obj.carrier))) ℤ
      L.obj.obj.carrier :=
  (Module.Free.chooseBasis ℤ L.obj.obj.carrier).reindex
    (Fintype.equivFin (Module.Free.ChooseBasisIndex ℤ L.obj.obj.carrier))

theorem baseChange_toMatrix (g : OrthogonalGroup L.obj) :
    LinearMap.toMatrix (b.baseChange ℝ) (b.baseChange ℝ)
        (((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).baseChange ℤ ℝ L.obj.obj.carrier
          L.obj.obj.carrier).toLinearMap) =
      (LinearMap.toMatrix b b
        ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)).map (algebraMap ℤ ℝ) := by
  ext i j
  simp only [LinearMap.toMatrix_apply, Module.Basis.baseChange_apply,
    LinearEquiv.coe_coe, LinearEquiv.baseChange_tmul, Module.Basis.baseChange_repr_tmul,
    Matrix.map_apply, Int.smul_one_eq_cast]
  rfl

theorem realFormOrthogonalHom_toMatrix (g : OrthogonalGroup L.obj) :
    LinearMap.toMatrix (baseChangeBasis ℝ L.obj b) (baseChangeBasis ℝ L.obj b)
        ((realFormOrthogonalHom L g).toLinearEquiv.toLinearMap) =
      (LinearMap.toMatrix b b
        ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)).map (algebraMap ℤ ℝ) :=
  baseChange_toMatrix L b g

/-- The real form of `L` as a real integral lattice: the carrier and pairing of the scalar
extension, presented so that the matrix topology of `TopologicalOrthogonalGroup.lean` applies
to it. -/
noncomputable def realFormIntegralLattice : IntegralLatticeCat ℝ :=
  ⟨((baseChangeIntegral ℤ ℝ).obj L.obj).obj, ⟨inferInstance,
    ((baseChangeIntegral ℤ ℝ).obj L.obj).property.2⟩⟩

/-- The image of the orthogonal group of `L` in the orthogonal group of its real form:
the range of the scalar-extension homomorphism. -/
noncomputable def realFormOrthogonalImage :
    Subgroup (BilinModuleCat.OrthogonalGroup (realFormIntegralLattice L).obj) :=
  MonoidHom.range (orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj)

/-- The matrix of the scalar extension of an isometry in the matrix presentation of the real
form: the ℤ-matrix of the isometry, cast into `ℝ`. -/
theorem realFormOrthogonalImage_matrix (g : OrthogonalGroup L.obj) :
    LinearMap.toMatrix (baseChangeBasis ℝ L.obj b) (baseChangeBasis ℝ L.obj b)
        ((orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj g).1.toLinearMap) =
      (LinearMap.toMatrix b b
        ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)).map (algebraMap ℤ ℝ) :=
  realFormOrthogonalHom_toMatrix L b g

/-- The matrix presentation of an element of the image: the matrix of the image of `g` in the
matrix orthogonal group of the real form, cast to a matrix, is the ℤ-matrix of `g` cast
into `ℝ`. -/
theorem realFormOrthogonalImage_matrix_coe (g : OrthogonalGroup L.obj) :
    ((orthogonalGroupMatrixEquiv (realFormIntegralLattice L) (baseChangeBasis ℝ L.obj b)
        ((orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj g) :
          BilinModuleCat.OrthogonalGroup (realFormIntegralLattice L).obj) :
      Matrix.GeneralLinearGroup I ℝ) : Matrix I I ℝ) =
      (LinearMap.toMatrix b b
        ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)).map (algebraMap ℤ ℝ) :=
  realFormOrthogonalImage_matrix L b g

end Discreteness


/-! ### The isolation of the identity in the image (Bourbaki V §3, (D2), p. 77) -/

section Isolation
variable (L : FiniteProjectiveLatticeCat ℤ ℤ) {I : Type} [Fintype I] [DecidableEq I]
variable (b : Module.Basis I ℤ L.obj.obj.carrier)

/-- **The identity is isolated in the image of the orthogonal group** (Bourbaki V §3 no. 1,
p. 77, condition (D2)): there is an open neighborhood of the identity in the matrix topology
of the real form that meets the image only in the identity, because the matrix of every
element of the image is the ℤ-matrix of a lattice isometry cast into `ℝ`. -/
theorem realFormOrthogonalImage_isolated
    (T : TopologicalSpace (BilinModuleCat.OrthogonalGroup (realFormIntegralLattice L).obj))
    (hT : T = orthogonalGroupTopology (realFormIntegralLattice L) (baseChangeBasis ℝ L.obj b)) :
    ∃ U : Set (BilinModuleCat.OrthogonalGroup (realFormIntegralLattice L).obj),
      IsOpen U ∧ (1 : _) ∈ U ∧ ∀ h ∈ realFormOrthogonalImage L, h ∈ U → h = 1 := by
  subst hT
  letI : TopologicalSpace (BilinModuleCat.OrthogonalGroup (realFormIntegralLattice L).obj) :=
    orthogonalGroupTopology (realFormIntegralLattice L) (baseChangeBasis ℝ L.obj b)
  refine ⟨(fun h => LinearMap.toMatrix (baseChangeBasis ℝ L.obj b)
        (baseChangeBasis ℝ L.obj b) h.1.toLinearMap) ⁻¹'
      {M : Matrix I I ℝ | ∀ i j, |M i j - (1 : Matrix I I ℝ) i j| < 1}, ?_, ?_, ?_⟩
  · -- openness: the matrix map is continuous and the entrywise condition is open
    have hcomp : Continuous (fun h : BilinModuleCat.OrthogonalGroup
        (realFormIntegralLattice L).obj =>
        ((orthogonalGroupMatrixEquiv (realFormIntegralLattice L) (baseChangeBasis ℝ L.obj b) h :
          Matrix.GeneralLinearGroup I ℝ) : Matrix I I ℝ)) := by
      have h1 : Continuous (fun h : BilinModuleCat.OrthogonalGroup
          (realFormIntegralLattice L).obj =>
          orthogonalGroupMatrixEquiv (realFormIntegralLattice L) (baseChangeBasis ℝ L.obj b) h) :=
        continuous_induced_dom
      exact Units.continuous_val.comp (continuous_subtype_val.comp h1)
    have hcont : Continuous (fun h : BilinModuleCat.OrthogonalGroup
        (realFormIntegralLattice L).obj =>
        LinearMap.toMatrix (baseChangeBasis ℝ L.obj b) (baseChangeBasis ℝ L.obj b)
          h.1.toLinearMap) :=
      hcomp.congr (fun h => rfl)
    have hOopen : IsOpen {M : Matrix I I ℝ | ∀ i j, |M i j - (1 : Matrix I I ℝ) i j| < 1} := by
      have hEq : {M : Matrix I I ℝ | ∀ i j, |M i j - (1 : Matrix I I ℝ) i j| < 1} =
          ⋂ p : I × I, (fun M : Matrix I I ℝ => M p.1 p.2) ⁻¹'
            {t : ℝ | |t - (1 : Matrix I I ℝ) p.1 p.2| < 1} := by
        ext M
        simp only [Set.mem_iInter, Set.mem_preimage, Set.mem_setOf_eq]
        constructor
        · intro hM p; exact hM p.1 p.2
        · intro hM i j; exact hM (i, j)
      rw [hEq]
      apply isOpen_iInter_of_finite
      intro p
      have hcontp : Continuous (fun M : Matrix I I ℝ => M p.1 p.2) :=
        (continuous_apply p.2).comp (continuous_apply p.1)
      have hopenp : IsOpen {t : ℝ | |t - (1 : Matrix I I ℝ) p.1 p.2| < 1} := by
        have hrw : {t : ℝ | |t - (1 : Matrix I I ℝ) p.1 p.2| < 1} =
            Set.Ioo ((1 : Matrix I I ℝ) p.1 p.2 - 1) ((1 : Matrix I I ℝ) p.1 p.2 + 1) := by
          ext t
          simp only [Set.mem_setOf_eq, Set.mem_Ioo]
          constructor
          · intro h
            obtain ⟨h1, h2⟩ := abs_lt.mp h
            constructor <;> linarith
          · intro h
            obtain ⟨h1, h2⟩ := h
            exact abs_lt.mpr ⟨by linarith, by linarith⟩
        rw [hrw]
        exact isOpen_Ioo
      exact hopenp.preimage hcontp
    exact hOopen.preimage hcont
  · -- the identity lies in the neighborhood
    show LinearMap.toMatrix (baseChangeBasis ℝ L.obj b) (baseChangeBasis ℝ L.obj b)
        (1 : BilinModuleCat.OrthogonalGroup (realFormIntegralLattice L).obj).1.toLinearMap
      ∈ {M : Matrix I I ℝ | ∀ i j, |M i j - (1 : Matrix I I ℝ) i j| < 1}
    have hone : LinearMap.toMatrix (baseChangeBasis ℝ L.obj b) (baseChangeBasis ℝ L.obj b)
        (1 : BilinModuleCat.OrthogonalGroup (realFormIntegralLattice L).obj).1.toLinearMap = 1 :=
      LinearMap.toMatrix_one (baseChangeBasis ℝ L.obj b)
    simp only [Set.mem_setOf_eq]
    intro i j
    rw [hone]
    simp
  · -- isolation: an integral matrix within one of the identity is the identity
    rintro h ⟨g, rfl⟩ hU
    simp only [Set.mem_preimage, Set.mem_setOf_eq] at hU
    -- every entry of the ℤ-matrix of g is the corresponding entry of the identity
    have hentry : ∀ i j, (LinearMap.toMatrix b b
        ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)) i j
        = (1 : Matrix I I ℤ) i j := by
      intro i j
      have hbound : |((LinearMap.toMatrix (baseChangeBasis ℝ L.obj b)
            (baseChangeBasis ℝ L.obj b)
            (orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj g).1.toLinearMap)) i j
          - (1 : Matrix I I ℝ) i j| < 1 := hU i j
      have hcast : ∀ i j, ((LinearMap.toMatrix (baseChangeBasis ℝ L.obj b)
            (baseChangeBasis ℝ L.obj b)
            (orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj g).1.toLinearMap)) i j
          = ((LinearMap.toMatrix b b
            ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)) i j : ℝ) := by
        intro i' j'
        rw [realFormOrthogonalImage_matrix L b g, Matrix.map_apply]
        rfl
      rcases eq_or_ne i j with hij | hij
      · subst hij
        rw [hcast i i] at hbound
        obtain ⟨h1, h2⟩ := abs_lt.mp hbound
        simp only [Matrix.one_apply, if_pos rfl, if_true] at h1 h2
        have e1 : 0 < (LinearMap.toMatrix b b
            ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)) i i := by
          have h : (0:ℝ) < ((LinearMap.toMatrix b b
            ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)) i i : ℝ) := by
            linarith
          exact_mod_cast h
        have e2 : (LinearMap.toMatrix b b
            ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)) i i < 2 := by
          have h : ((LinearMap.toMatrix b b
            ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)) i i : ℝ) < 2 := by
            linarith
          exact_mod_cast h
        simp only [Matrix.one_apply, if_pos rfl, if_true]
        omega
      · rw [hcast i j] at hbound
        obtain ⟨h1, h2⟩ := abs_lt.mp hbound
        simp only [Matrix.one_apply, if_neg hij] at h1 h2
        have e1 : -1 < (LinearMap.toMatrix b b
            ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)) i j := by
          have h : (-1:ℝ) < ((LinearMap.toMatrix b b
            ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)) i j : ℝ) := by
            linarith
          exact_mod_cast h
        have e2 : (LinearMap.toMatrix b b
            ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)) i j < 1 := by
          have h : ((LinearMap.toMatrix b b
            ((g.1 : L.obj.obj.carrier ≃ₗ[ℤ] L.obj.obj.carrier).toLinearMap)) i j : ℝ) < 1 := by
            linarith
          exact_mod_cast h
        simp only [Matrix.one_apply, if_neg hij]
        omega
    -- the matrix of the image element is the identity, so its map is the identity
    have hmat : LinearMap.toMatrix (baseChangeBasis ℝ L.obj b) (baseChangeBasis ℝ L.obj b)
        (orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj g).1.toLinearMap = 1 := by
      rw [realFormOrthogonalImage_matrix L b g]
      ext i j
      simp only [Matrix.map_apply, Matrix.one_apply]
      have h := hentry i j
      simp only [Matrix.one_apply] at h
      rw [h]
      rcases eq_or_ne i j with hij | hij
      · subst hij; simp
      · simp [hij]
    have hid : (orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj g).1.toLinearMap
        = (1 : ((baseChangeIntegral ℤ ℝ).obj L.obj).obj.carrier →ₗ[ℝ]
            ((baseChangeIntegral ℤ ℝ).obj L.obj).obj.carrier) := by
      have hinj : LinearMap.toMatrix (baseChangeBasis ℝ L.obj b) (baseChangeBasis ℝ L.obj b)
          ((orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj g).1.toLinearMap)
          = LinearMap.toMatrix (baseChangeBasis ℝ L.obj b) (baseChangeBasis ℝ L.obj b)
            (1 : ((baseChangeIntegral ℤ ℝ).obj L.obj).obj.carrier →ₗ[ℝ]
              ((baseChangeIntegral ℤ ℝ).obj L.obj).obj.carrier) := by
        rw [hmat, LinearMap.toMatrix_one (baseChangeBasis ℝ L.obj b)]
      exact (LinearMap.toMatrixAlgEquiv (baseChangeBasis ℝ L.obj b)).injective hinj
    refine Subtype.ext (LinearEquiv.ext fun x => ?_)
    have hx : ((orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj g).1) x = x := by
      rw [show ((orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj g).1) x
          = ((orthogonalGroupBaseChangeHom (R := ℤ) (S := ℝ) L.obj g).1.toLinearMap) x from rfl,
        hid]
      rfl
    exact hx.trans rfl


end Isolation

/-! ### The continuity and compactness infrastructure for the discreteness theory

The pairing of the real form is jointly continuous (the real form is a finite `ℝ`-module
carrying the module topology, in which bilinear maps are continuous), so the quadratic
form is continuous, and the pairings of the points of a nonempty compact set with the
image of a fixed lattice vector are bounded. These are the compactness facts that the
finiteness argument of condition (D')2 of Bourbaki V §3 no. 1 (p. 77) rests on: for `g`
with `g x = y` and `x`, `y` in compact subsets of the chosen sheet, the pairing of the
image of a basis vector with a fixed basis vector is bounded (the spatial part of the
image relative to `y` has bounded antivalue by the reverse Cauchy-Schwarz inequality of
a form of signature `(1, n)` with the positive minimum of the quadratic form on the
second compact, and two spatial parts pair within the Cauchy-Schwarz inequality of the
negative definite orthogonal complement), so only finitely many bounded pairing
matrices of integers occur, and the pairing matrix determines the isometry. -/

section Compactness

variable (L : FiniteProjectiveLatticeCat ℤ ℤ)

noncomputable def realFormPairingCurry (L : FiniteProjectiveLatticeCat ℤ ℤ) :
    (realForm L).obj.carrier →ₗ[ℝ] (realForm L).obj.carrier →ₗ[ℝ] ℝ where
  toFun z :=
    { toFun := fun w => (realForm L).obj.pairing z w
      map_add' := fun u v => by simp [BilinModuleCat.pairing_add_right]
      map_smul' := fun r u => by simp [BilinModuleCat.pairing_smul_right] }
  map_add' := fun u v => by
    ext w
    simp [BilinModuleCat.pairing_add_left]
  map_smul' := fun r u => by
    ext w
    simp [BilinModuleCat.pairing_smul_left]

theorem continuous_realFormPairing (L : FiniteProjectiveLatticeCat ℤ ℤ) :
    Continuous (fun p : (realForm L).obj.carrier × (realForm L).obj.carrier =>
      (realForm L).obj.pairing p.1 p.2) := by
  have: Module.Finite ℝ (realForm L).obj.carrier := realFormFiniteDimensional L
  have hbil : Continuous (fun ab : (realForm L).obj.carrier × (realForm L).obj.carrier =>
      realFormPairingCurry L ab.1 ab.2) :=
    IsModuleTopology.continuous_bilinear_of_finite_left (realFormPairingCurry L)
  exact hbil

set_option maxHeartbeats 4000000 in
theorem continuous_realFormQuadratic (L : FiniteProjectiveLatticeCat ℤ ℤ) :
    Continuous (realFormQuadratic L) := by
  have hdiag : Continuous (fun z : (realForm L).obj.carrier => (z, z)) := by
    exact continuous_prodMk.mpr ⟨continuous_id, continuous_id⟩
  have hcomp : Continuous
      ((fun p : (realForm L).obj.carrier × (realForm L).obj.carrier =>
        (realForm L).obj.pairing p.1 p.2) ∘
        fun z : (realForm L).obj.carrier => (z, z)) :=
    Continuous.comp (continuous_realFormPairing L) hdiag
  exact Continuous.congr hcomp (fun z => rfl)

set_option maxHeartbeats 4000000 in
theorem bounded_pairing_of_isCompact {L : FiniteProjectiveLatticeCat ℤ ℤ}
    {J : Set (realForm L).obj.carrier} (hJ : IsCompact J) (hJne : J.Nonempty)
    (a : L.obj.obj.carrier) :
    ∃ B : ℝ, ∀ z ∈ J, |(realForm L).obj.pairing (toRealForm L a) z| ≤ B := by
  have hdiag : Continuous (fun z : (realForm L).obj.carrier => (z, z)) := by
    exact continuous_prodMk.mpr ⟨continuous_id, continuous_id⟩
  have hfix : Continuous
      ((fun p : (realForm L).obj.carrier × (realForm L).obj.carrier =>
        (realForm L).obj.pairing p.1 p.2) ∘
        fun w : (realForm L).obj.carrier => (toRealForm L a, w)) :=
    Continuous.comp (continuous_realFormPairing L)
      (continuous_prodMk.mpr ⟨continuous_const, continuous_id⟩)
  have hfun : Continuous (fun z : (realForm L).obj.carrier =>
      (realForm L).obj.pairing (toRealForm L a) z) :=
    Continuous.congr hfix (fun z => rfl)
  have habs : Continuous (fun z : (realForm L).obj.carrier =>
      |(realForm L).obj.pairing (toRealForm L a) z|) := hfun.abs
  obtain ⟨z₀, hz₀, hmax⟩ := hJ.exists_isMaxOn hJne habs.continuousOn
  exact ⟨_, fun z hz => hmax hz⟩

end Compactness

