variable {V : Type} [AddCommGroup V] [Module ℚ V] [Module.Finite ℚ V]
variable {BQ : LinearMap.BilinForm ℚ V} {Q : QuadraticForm ℝ (realified V)}

theorem rationalPoint_injective : Function.Injective (rationalPoint (V := V)) := by
  obtain ⟨κ, b⟩ := Module.Free.exists_basis ℚ V
  let tb : Module.Basis (Unit × κ) ℝ (realified V) :=
    Module.Basis.tensorProduct (Module.Basis.singleton Unit ℝ) b
  intro x y h
  have h' : rationalPoint (V := V) (x - y) = 0 := by rw [map_sub, h, sub_self]
  have hcoeff : ∀ j : κ, b.repr (x - y) j = 0 := by
    intro j
    have hh : (tb.repr (rationalPoint (V := V) (x - y)) (Unit.unit, j) : ℝ) = 0 := by
      rw [h']
      simp
    rw [rationalPoint_apply, Module.Basis.tensorProduct_repr_tmul_apply] at hh
    have hR : ((b.repr (x - y)) j : ℝ) = 0 := by simpa using hh
    exact_mod_cast hR
  have hzero : x - y = 0 := by
    have hrep : b.repr (x - y) = 0 := by
      ext j
      simpa using hcoeff j
    have := congrArg b.repr.symm hrep
    simpa using this
  exact sub_eq_zero.1 hzero

noncomputable def restrictBilinForm (BQ : LinearMap.BilinForm ℚ V) (W : Submodule ℚ V) :
    LinearMap.BilinForm ℚ ↥W :=
  BQ.comp W.subtype W.subtype

omit [Module.Finite ℚ V] in
@[simp] theorem restrictBilinForm_apply (BQ : LinearMap.BilinForm ℚ V) (W : Submodule ℚ V)
    (x y : ↥W) : restrictBilinForm BQ W x y = BQ (x : V) (y : V) := rfl

omit [Module.Finite ℚ V] in
theorem restrictBilinForm_isSymm {BQ : LinearMap.BilinForm ℚ V} (hBsym : BQ.IsSymm)
    (W : Submodule ℚ V) : (restrictBilinForm BQ W).IsSymm :=
  ⟨fun x y => hBsym.eq (x : V) (y : V)⟩

theorem restrictBilinForm_nondegenerate {BQ : LinearMap.BilinForm ℚ V}
    {Q : QuadraticForm ℝ (realified V)}
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (W : Submodule ℚ V) (hW : (fibreForm Q W).Nondegenerate) :
    (restrictBilinForm BQ W).Nondegenerate := by
  refine LinearMap.BilinForm.Nondegenerate.ofSeparatingLeft fun x hx => ?_
  have hL : ∀ w : ↥W, (associated (fibreForm Q W)) (rationalPoint (V := ↥W) x)
      (rationalPoint w) = 0 := by
    intro w
    have hw : BQ (x : V) (w : V) = 0 := by
      have := hx w
      simpa using this
    rw [associated_fibreForm, realifyMap_rationalPoint, realifyMap_rationalPoint, hBQ, hw]
    norm_num
  let L : realified ↥W →ₗ[ℝ] ℝ := associated (fibreForm Q W) (rationalPoint x)
  have hLzero : L = 0 := by
    have hle : Submodule.span ℝ (Set.range (rationalPoint (V := ↥W))) ≤ L.ker := by
      rw [Submodule.span_le]
      rintro - ⟨w, rfl⟩
      simpa [L] using hL w
    rw [span_range_rationalPoint, top_le_iff] at hle
    exact LinearMap.ext fun z => by
      have hz : z ∈ L.ker := by rw [hle]; exact Submodule.mem_top
      simpa [L] using hz
  have hrad : rationalPoint (V := ↥W) x ∈ (fibreForm Q W).radical := by
    rw [QuadraticMap.radical_eq_ker_associated, LinearMap.mem_ker]
    exact LinearMap.ext fun z => congrArg (fun f : realified ↥W →ₗ[ℝ] ℝ => f z) hLzero
  rw [QuadraticMap.nondegenerate_iff_radical_eq_bot] at hW
  rw [hW] at hrad
  exact rationalPoint_injective (by simpa using hrad)

theorem sigPos_fibreForm_eq_one
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hBsym : BQ.IsSymm) (hsig : sigPos Q = 2) (F : ConicalLine BQ Q) :
    sigPos (fibreForm Q F.space) = 1 := by
  have h := sigPos_fibreForm (Q := Q) (BQ := BQ) hBQ hBsym F.gen_iso F.partner_iso F.pairing
  have h' : sigPos (fibreForm Q F.space) =
      sigPos (fibreForm Q (planeComplement BQ F.gen F.partner)) :=
    congrArg sigPos (fibreForm_space F)
  omega

theorem fibreForm_space_nondegenerate
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hBsym : BQ.IsSymm) (hnd : Q.Nondegenerate) (F : ConicalLine BQ Q) :
    (fibreForm Q F.space).Nondegenerate :=
  fibreForm_nondegenerate (Q := Q) (BQ := BQ) hBQ hBsym F.gen_iso F.partner_iso F.pairing hnd

theorem rationalClosure_closedSheet_le {Q : QuadraticForm ℝ (realified V)}
    (hpos : sigPos Q = 1) {t : realified V} (ht : 0 < Q t) :
    rationalClosure (closedSheet Q hpos ht) ≤ closedSheet Q hpos ht := by
  have hsub : rationalBoundary (closedSheet Q hpos ht) ⊆
      (closedSheet Q hpos ht : Set (realified V)) := by
    rintro x ⟨⟨v, -, rfl⟩, hvcl⟩
    have hclosed := isClosed_closedSheet_of_moduleTopology Q hpos ht
    rw [show (closedSheet Q hpos ht).closure = closedSheet Q hpos ht from
      hclosed.submodule_topologicalClosure_eq] at hvcl
    exact hvcl
  rw [rationalClosure_eq_hull]
  exact Submodule.span_le.2 hsub


/-- **A generator for the members of a finite family, from the orbit family's generators**: the
element of `H₀` is its own orbit (`1 ∈ Γ`), so the generator of its cut with the lattice is the
orbit family's generator. -/
theorem exists_generator_of_mem_finset {W : Type} [AddCommGroup W] [Module ℚ W]
    {Λ : Submodule ℤ W} {ΓI : Set (W ≃ₗ[ℚ] W)} {H₀ : Finset (Submodule ℚ W)}
    {gen : ↥(orbitFamily H₀ ΓI) → W}
    (hgen : ∀ ℓ : ↥(orbitFamily H₀ ΓI), gen ℓ ≠ 0 ∧
      Λ ⊓ ℓ.1.restrictScalars ℤ = Submodule.span ℤ ({gen ℓ} : Set W))
    (hone : (1 : W ≃ₗ[ℚ] W) ∈ ΓI) :
    ∀ ℓ₀ ∈ H₀, ∃ v : W, v ≠ 0 ∧ Λ ⊓ ℓ₀.restrictScalars ℤ = Submodule.span ℤ ({v} : Set W) := by
  intro ℓ₀ hℓ₀
  have hmem : ℓ₀ ∈ orbitFamily H₀ ΓI := by
    rw [mem_orbitFamily]
    exact ⟨ℓ₀, hℓ₀, 1, hone, by simp⟩
  obtain ⟨hne, hspan⟩ := hgen ⟨ℓ₀, hmem⟩
  exact ⟨gen ⟨ℓ₀, hmem⟩, hne, hspan⟩



omit [Module.Finite ℚ V] in
theorem associated_fibreForm_restrict {BQ : LinearMap.BilinForm ℚ V}
    {Q : QuadraticForm ℝ (realified V)}
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (F : ConicalLine BQ Q) (u v : ↥F.space) :
    (associated (fibreForm Q F.space)) (rationalPoint u) (rationalPoint v) =
      (restrictBilinForm BQ F.space u v : ℝ) := by
  rw [associated_fibreForm, realifyMap_rationalPoint, realifyMap_rationalPoint, hBQ]
  norm_num

theorem closure_le_closedSheet (F : ConicalLine BQ Q)
    (hpos : sigPos (fibreForm Q F.space) = 1) :
    F.closure ≤ closedSheet (fibreForm Q F.space) hpos F.sheet_pos := by
  rw [ConicalLine.closure_eq_closedSheet F hpos]
  exact rationalClosure_closedSheet_le hpos F.sheet_pos

theorem cutsFinitelyOnRational_reducedLattice
    (hBQsym : BQ.IsSymm)
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hsig : sigPos Q = 2) (hnd : Q.Nondegenerate) (F : ConicalLine BQ Q)
    {κ₀ : Type} [Finite κ₀] (bs₀ : Module.Basis κ₀ ℚ V)
    (hint₀ : ∀ x ∈ Submodule.span ℤ (Set.range bs₀), ∀ y ∈ Submodule.span ℤ (Set.range bs₀),
      ∃ n : ℤ, BQ x y = (n : ℚ))
    {κ : Type} [Finite κ] (bs : Module.Basis κ ℚ ↥F.space)
    (hbs : Submodule.span ℤ (Set.range bs) =
      reducedLattice hBQsym F (Submodule.span ℤ (Set.range bs₀)))
    (ΓI : Set (↥F.space ≃ₗ[ℚ] ↥F.space))
    (hone : (1 : ↥F.space ≃ₗ[ℚ] ↥F.space) ∈ ΓI)
    (H₀ : Finset (Submodule ℚ ↥F.space))
    (hΓΛ : ∀ e ∈ ΓI, Submodule.map ((e : ↥F.space →ₗ[ℚ] ↥F.space).restrictScalars ℤ)
      (Submodule.span ℤ (Set.range bs)) = Submodule.span ℤ (Set.range bs))
    (hΓiso : ∀ e ∈ ΓI, ∀ x y : ↥F.space,
      restrictBilinForm BQ F.space (e x) (e y) = restrictBilinForm BQ F.space x y)
    (gen : ↥(orbitFamily H₀ ΓI) → ↥F.space)
    (hgen : ∀ ℓ : ↥(orbitFamily H₀ ΓI), gen ℓ ≠ 0 ∧
      Submodule.span ℤ (Set.range bs) ⊓ ℓ.1.restrictScalars ℤ =
        Submodule.span ℤ ({gen ℓ} : Set ↥F.space)) :
    CutsFinitelyOnRational F.closure
      (fun ℓ : ↥(orbitFamily H₀ ΓI) => normalForm (fibreForm Q F.space) (gen ℓ)) := by
  classical
  have : Fintype κ₀ := Fintype.ofFinite κ₀
  have : Fintype κ := Fintype.ofFinite κ
  have hpos : sigPos (fibreForm Q F.space) = 1 :=
    sigPos_fibreForm_eq_one hBQ hBQsym hsig F
  have hndF : (fibreForm Q F.space).Nondegenerate :=
    fibreForm_space_nondegenerate hBQ hBQsym hnd F
  have hBQndF : (restrictBilinForm BQ F.space).Nondegenerate :=
    restrictBilinForm_nondegenerate hBQ F.space hndF
  have hsymF : (restrictBilinForm BQ F.space).IsSymm :=
    restrictBilinForm_isSymm hBQsym F.space
  have hagree : ∀ u w : ↥F.space,
      (associated (fibreForm Q F.space)) (rationalPoint u) (rationalPoint w) =
        (restrictBilinForm BQ F.space u w : ℝ) := fun u w =>
    associated_fibreForm_restrict hBQ F u w
  have hsheetle : F.closure ≤ closedSheet (fibreForm Q F.space) hpos F.sheet_pos :=
    closure_le_closedSheet F hpos
  have hsheet : ∀ v : ↥F.space, rationalPoint v ∈ F.closure →
      0 ≤ fibreForm Q F.space (rationalPoint v) ∧
        0 ≤ (associated (fibreForm Q F.space)) (rationalPoint v) F.sheet := by
    intro v hv
    exact (mem_closedSheet hpos F.sheet_pos).1 (hsheetle hv)
  have hsal : (F.closure : ConvexCone ℝ (realified ↥F.space)).Salient := by
    rw [ConicalLine.closure_eq_closedSheet F hpos]
    exact salient_rationalClosure hpos hndF F.sheet_pos
  have hint : ∀ x ∈ Submodule.span ℤ (Set.range bs), ∀ y ∈ Submodule.span ℤ (Set.range bs),
      ∃ n : ℤ, restrictBilinForm BQ F.space x y = (n : ℚ) := by
    intro x hx y hy
    rw [hbs] at hx hy
    obtain ⟨n, hn⟩ := integral_reducedLattice hBQsym F bs₀ hint₀ x hx y hy
    exact ⟨n, hn⟩
  have hH₀ := exists_generator_of_mem_finset (Λ := Submodule.span ℤ (Set.range bs)) hgen hone
  exact cutsFinitelyOnRational_of_finiteOrbits (V := ↥F.space) hpos hndF hsymF hBQndF hagree
    hsal F.sheet_pos hsheet ΓI H₀ hΓΛ hΓiso hH₀ hint gen hgen

/-- **Condition (i) of Definition 6.1 at a fibre, with no counting hypothesis.** The members of the
decomposition are the cells of the traces of a finite `Γ_I`-orbit family of `ℚ`-hyperplanes of the
fibre, and the counting hypothesis of Example 4.3 (b) is *derived*
(`cutsFinitelyOnRational_reducedLattice`) rather than assumed. This is the statement of Example 6.4
at the fibre: the `H ∈ H` containing `I` decompose `C_{I,+}` into locally rational cones, at the
form of signature `(1, n-1)` of §1B. -/
theorem arrangementDecomposition_reducedLattice_isLocallyRational
    (hBQsym : BQ.IsSymm)
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hsig : sigPos Q = 2) (hnd : Q.Nondegenerate) (F : ConicalLine BQ Q)
    {κ₀ : Type} [Finite κ₀] (bs₀ : Module.Basis κ₀ ℚ V)
    (hint₀ : ∀ x ∈ Submodule.span ℤ (Set.range bs₀), ∀ y ∈ Submodule.span ℤ (Set.range bs₀),
      ∃ n : ℤ, BQ x y = (n : ℚ))
    {κ : Type} [Finite κ] (bs : Module.Basis κ ℚ ↥F.space)
    (hbs : Submodule.span ℤ (Set.range bs) =
      reducedLattice hBQsym F (Submodule.span ℤ (Set.range bs₀)))
    (ΓI : Set (↥F.space ≃ₗ[ℚ] ↥F.space))
    (hone : (1 : ↥F.space ≃ₗ[ℚ] ↥F.space) ∈ ΓI)
    (H₀ : Finset (Submodule ℚ ↥F.space))
    (hΓΛ : ∀ e ∈ ΓI, Submodule.map ((e : ↥F.space →ₗ[ℚ] ↥F.space).restrictScalars ℤ)
      (Submodule.span ℤ (Set.range bs)) = Submodule.span ℤ (Set.range bs))
    (hΓiso : ∀ e ∈ ΓI, ∀ x y : ↥F.space,
      restrictBilinForm BQ F.space (e x) (e y) = restrictBilinForm BQ F.space x y)
    (gen : ↥(orbitFamily H₀ ΓI) → ↥F.space)
    (hgen : ∀ ℓ : ↥(orbitFamily H₀ ΓI), gen ℓ ≠ 0 ∧
      Submodule.span ℤ (Set.range bs) ⊓ ℓ.1.restrictScalars ℤ =
        Submodule.span ℤ ({gen ℓ} : Set ↥F.space)) :
    IsLocallyRationalDecomposition F.closure
      (arrangementDecomposition (fun ℓ : ↥(orbitFamily H₀ ΓI) =>
        normalForm (fibreForm Q F.space) (gen ℓ)) F.closure) := by
  classical
  have hpos : sigPos (fibreForm Q F.space) = 1 :=
    sigPos_fibreForm_eq_one hBQ hBQsym hsig F
  have hndF : (fibreForm Q F.space).Nondegenerate :=
    fibreForm_space_nondegenerate hBQ hBQsym hnd F
  have hsal : (F.closure : ConvexCone ℝ (realified ↥F.space)).Salient := by
    rw [ConicalLine.closure_eq_closedSheet F hpos]
    exact salient_rationalClosure hpos hndF F.sheet_pos
  have hφ : ∀ ℓ : ↥(orbitFamily H₀ ΓI),
      IsRationalForm (normalForm (fibreForm Q F.space) (gen ℓ)).toLinearMap := by
    intro ℓ
    refine ⟨restrictBilinForm BQ F.space (gen ℓ), fun v => ?_⟩
    change normalForm (fibreForm Q F.space) (gen ℓ) (rationalPoint v) =
      ((restrictBilinForm BQ F.space (gen ℓ)) v : ℝ)
    rw [normalForm_apply]
    exact associated_fibreForm_restrict hBQ F (gen ℓ) v
  exact arrangementDecomposition_isLocallyRational hsal hφ
    (cutsFinitelyOnRational_reducedLattice hBQsym hBQ hsig hnd F bs₀ hint₀ bs hbs ΓI hone H₀
      hΓΛ hΓiso gen hgen)

/-! ## `Σ(H)` indexed by the fibre's own hyperplanes

Looijenga, Example 6.4, p. 29: "the `H ∈ H` containing `I` correspond to `ℚ`-hyperplanes in
`I^⊥/I ⊗ I` of signature `(1, n-2)` and so according to example 4.3-b these decompose `C_{I,+}`
into locally rational cones". The count of Example 4.3 (b) is a statement about the *fibre's*
`ℚ`-hyperplanes, and the correspondence is not injective on the ambient family: with
`V = ℚe ⊕ ℚf ⊕ W`, `I = ℚe` and `T ⊂ W` a hyperplane, every `I ⊕ T ⊕ ℚ(f + k)`, `k ∉ I ⊕ T`, is a
`ℚ`-hyperplane containing `I` with trace `T`, so an infinite ambient family can sit over one trace
and the ambient-indexed count is not the source's. Indexing `Σ(H)` at a fibre by the fibre's own
hyperplanes is what makes `arrangementDecomposition_reducedLattice_isLocallyRational` — condition
(i) with no counting hypothesis — a statement about `Σ(H)`: `arrangementCone_smul` says the
decomposition sees the hyperplanes and not the normals that represent them, so a correspondence of
the two index sets up to a nonzero scalar transfers the fibre's count to the ambient family. -/

section TracesIndex

variable {BQ : LinearMap.BilinForm ℚ V} {Q : QuadraticForm ℝ (realified V)}

omit [Module.Finite ℚ V] in
/-- **Condition (i) of Definition 6.1 for `Σ(H)`, counted at the fibre's hyperplanes.** The
decomposition `Σ(H)` of the fibre is computed from the traces of the hyperplanes of `H` containing
`I`; if those traces are the forms `φ'` of the fibre's own `ℚ`-hyperplane family, up to the naming
of the index set (`j`) and a nonzero scalar per wall (`c`), then condition (i) for the
ambient-indexed `semifanArrangement` follows from condition (i) for the fibre-indexed arrangement —
the count of Example 4.3 (b) at the fibre. -/
theorem semifanArrangement_isLocallyRational_of_traces {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ)
    (F : ConicalLine BQ Q) {ι' : Type*} {φ' : ι' → (realified ↥F.space) →L[ℝ] ℝ}
    (j : fibreWalls ψ F ≃ ι') (c : fibreWalls ψ F → ℝ) (hc : ∀ i, c i ≠ 0)
    (hforms : ∀ i : fibreWalls ψ F, fibreFormC F (ψ ↑i) = c i • φ' (j i))
    (hlr : IsLocallyRationalDecomposition F.closure (arrangementDecomposition φ' F.closure)) :
    IsLocallyRationalDecomposition F.closure (semifanArrangement ψ F) := by
  rw [semifanArrangement,
    show (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i)) = fun i => c i • φ' (j i) from
      funext hforms,
    arrangementDecomposition_smul c hc, arrangementDecomposition_reindex j]
  exact hlr

end TracesIndex

/-! ## Example 6.4: the `≥` half of `J_{Σ(ℋ)} = J_ℋ`

Looijenga, Example 6.4, p. 29 (text line 791): "the space `J_ℋ` associated to a `ℚ`-isotropic
plane `J` is the common intersection of `J^⊥` and the hyperplanes `H ∈ ℋ` containing `J`".

`supportSpace_halfLine_le_ker` is the inclusion `J_{Σ(ℋ)} ⊆ J_ℋ` at a member `τ` of `Σ(ℋ)` above
the half line of `J` meeting the open cone. The reverse inclusion asks that every vector `w` of the
fibre that is orthogonal to the ray `r` of `J` and lies in the trace of every wall through `J` be
killed by every form nonnegative on `τ` and zero on `⟨r⟩` — that is, that it lie in
`supportSpace τ ⟨r⟩`.

The forms in question are described by the dual cone of the cell `τ`: such a form is a sum of a
form nonnegative on the closed sheet and zero at `r` and of the traces of the walls through `r`
(`hspan` of `mem_supportSpace_halfLine_of_supportForms_span`). The closed-sheet part is not a
hypothesis: a form nonnegative on the fibre's closed sheet and vanishing at an isotropic vector
`r` kills `r^⊥` (`supportForms_closedSheet_apply_eq_zero_of_isotropic`), because the only such
forms are the multiples of the metric dual of `r` (Looijenga, p. 19,
`supportSpace_closedSheet_hull_eq_ker`). The remaining step — that the traces of the walls through
the ray span the dual cone of the cell modulo that form — is recorded in `COMPLAINTS.md`.
-/

section HalfLineSupportGe

variable {BQ : LinearMap.BilinForm ℚ V} {Q : QuadraticForm ℝ (realified V)}

omit [Module.Finite ℚ V] in
/-- **A generating set for the support space**: a vector killed by a set of forms whose span
contains the forms nonnegative on `τ` and zero on `σ` lies in the support space (Looijenga,
Lemma-Definition 4.5, p. 19). -/
theorem mem_supportSpace_of_supportForms_subset_span
    {σ τ : PointedCone ℝ (realified V)} {T : Set ((realified V) →ₗ[ℝ] ℝ)}
    (hsub : supportForms τ σ ⊆ Submodule.span ℝ T) {w : realified V}
    (hw : ∀ ψ ∈ T, ψ w = 0) : w ∈ supportSpace τ σ :=
  mem_supportSpace.2 fun φ hφ => forall_apply_eq_zero_span.1 hw φ (hsub hφ)

/-- **A form nonnegative on the fibre's closed sheet and zero at an isotropic vector kills the
orthogonal complement of that vector.** By Looijenga, p. 19, the support space of an isotropic ray
relative to the closed sheet is the hyperplane orthogonal to the ray, so the common zero set of
those forms contains it. -/
theorem supportForms_closedSheet_apply_eq_zero_of_isotropic
    (F : ConicalLine BQ Q)
    (hpos : sigPos (fibreForm Q F.space) = 1)
    (hnd : (fibreForm Q F.space).Nondegenerate)
    {e : realified ↥F.space} (he : fibreForm Q F.space e = 0) (he0 : e ≠ 0)
    (het : 0 ≤ (associated (fibreForm Q F.space)) e F.sheet) :
    ∀ ψ : (realified ↥F.space) →ₗ[ℝ] ℝ,
      (∀ x ∈ closedSheet (fibreForm Q F.space) hpos F.sheet_pos, 0 ≤ ψ x) → ψ e = 0 →
      ∀ w : realified ↥F.space, (associated (fibreForm Q F.space)) e w = 0 → ψ w = 0 := by
  intro ψ hψ hψe w hw
  have hψ' : ψ ∈ supportForms (closedSheet (fibreForm Q F.space) hpos F.sheet_pos)
      (PointedCone.hull ℝ ({e} : Set (realified ↥F.space))) := by
    refine mem_supportForms.2 ⟨hψ, ?_⟩
    intro x hx
    obtain ⟨c, -, rfl⟩ := PointedCone.mem_hull_singleton.1 hx
    rw [map_smul, smul_eq_mul, hψe, mul_zero]
  have hmem : w ∈ supportSpace (closedSheet (fibreForm Q F.space) hpos F.sheet_pos)
      (PointedCone.hull ℝ ({e} : Set (realified ↥F.space))) := by
    rw [supportSpace_closedSheet_hull_eq_ker hpos hnd F.sheet_pos he he0 het]
    exact hw
  exact mem_supportSpace.1 hmem ψ hψ'

/-- **Example 6.4, the `≥` half of `J_{Σ(ℋ)} = J_ℋ`, reduced to the dual cone of the cell.**

Let `σ = ⟨r⟩` be the half line of a `ℚ`-isotropic plane in the fibre of `I` and `τ` a member of
`Σ(ℋ)` above it. A vector `w` orthogonal to `r` and lying in the kernel of every trace that
vanishes on `r` — the trace of every wall of `Σ(ℋ)` containing `J` — is killed by every form
nonnegative on `τ` and zero on `⟨r⟩`, provided those forms are spanned by the forms nonnegative on
the closed sheet and zero at `r` together with the traces vanishing at `r`.

The first family kills `w` by `supportForms_closedSheet_apply_eq_zero_of_isotropic`; the second is
the hypothesis on the traces. What remains is the description of the dual cone of a cell of the
arrangement by its walls, which is recorded in `COMPLAINTS.md`. -/
theorem mem_supportSpace_halfLine_of_supportForms_span
    {F : ConicalLine BQ Q} {ι : Type*} (φ : ι → (realified ↥F.space) →L[ℝ] ℝ)
    {τ σ : PointedCone ℝ (realified ↥F.space)} {e : realified ↥F.space}
    (hσ : σ = PointedCone.hull ℝ ({e} : Set (realified ↥F.space)))
    (hpos : sigPos (fibreForm Q F.space) = 1)
    (hnd : (fibreForm Q F.space).Nondegenerate)
    (he : fibreForm Q F.space e = 0) (he0 : e ≠ 0)
    (het : 0 ≤ (associated (fibreForm Q F.space)) e F.sheet)
    (hspan : supportForms τ σ ⊆ Submodule.span ℝ
      ({ψ : (realified ↥F.space) →ₗ[ℝ] ℝ |
          (∀ x ∈ closedSheet (fibreForm Q F.space) hpos F.sheet_pos, 0 ≤ ψ x) ∧ ψ e = 0} ∪
        {ψ : (realified ↥F.space) →ₗ[ℝ] ℝ | ∃ i : ι, ψ = (φ i).toLinearMap ∧ ψ e = 0}))
    {w : realified ↥F.space}
    (hw : (associated (fibreForm Q F.space)) e w = 0)
    (hwφ : ∀ i : ι, φ i e = 0 → φ i w = 0) :
    w ∈ supportSpace τ σ := by
  subst hσ
  refine mem_supportSpace_of_supportForms_subset_span hspan fun ψ hψ => ?_
  rcases hψ with hψ | ⟨i, rfl, hψe⟩
  · exact supportForms_closedSheet_apply_eq_zero_of_isotropic F hpos hnd he he0 het ψ hψ.1 hψ.2 w hw
  · exact hwφ i hψe

/-- **Example 6.4, the `≥` half of `J_{Σ(ℋ)} = J_ℋ`, at the walls of `Σ(ℋ)`.** The generic
`mem_supportSpace_halfLine_of_supportForms_span` at the traces `fibreFormC F (ψ i)` of the walls of
`ℋ` containing `I` (`fibreWalls ψ F`): a vector of the fibre orthogonal to the ray of `J` and lying
in the trace of every wall through `J` lies in the support space of the half line relative to a
member `τ` of `Σ(ℋ)`, once the forms nonnegative on `τ` and zero on the ray are spanned by the
closed-sheet forms vanishing at the ray and the traces through the ray. -/
theorem mem_supportSpace_halfLine_of_supportForms_span_semifanArrangement
    (F : ConicalLine BQ Q) {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ)
    {τ : PointedCone ℝ (realified ↥F.space)} {r : realified ↥F.space}
    (hpos : sigPos (fibreForm Q F.space) = 1)
    (hnd : (fibreForm Q F.space).Nondegenerate)
    (hr : fibreForm Q F.space r = 0) (hr0 : r ≠ 0)
    (hrt : 0 ≤ (associated (fibreForm Q F.space)) r F.sheet)
    (hspan : supportForms τ (PointedCone.hull ℝ ({r} : Set (realified ↥F.space))) ⊆
      Submodule.span ℝ
        ({ψ' : (realified ↥F.space) →ₗ[ℝ] ℝ |
            (∀ x ∈ closedSheet (fibreForm Q F.space) hpos F.sheet_pos, 0 ≤ ψ' x) ∧ ψ' r = 0} ∪
          {ψ' : (realified ↥F.space) →ₗ[ℝ] ℝ |
            ∃ i : fibreWalls ψ F, ψ' = (fibreFormC F (ψ ↑i)).toLinearMap ∧ ψ' r = 0}))
    {w : realified ↥F.space}
    (hw : (associated (fibreForm Q F.space)) r w = 0)
    (hwφ : ∀ i : fibreWalls ψ F, fibreFormC F (ψ ↑i) r = 0 → fibreFormC F (ψ ↑i) w = 0) :
    w ∈ supportSpace τ (PointedCone.hull ℝ ({r} : Set (realified ↥F.space))) :=
  mem_supportSpace_halfLine_of_supportForms_span (F := F)
    (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i)) rfl hpos hnd hr hr0 hrt hspan hw hwφ

end HalfLineSupportGe

/-! ## The cell of the half line is a member of `Σ(ℋ)`

Example 6.4, p. 29: the members of `Σ(ℋ)` in the fibre of `I` are the cells of the traces of the
hyperplanes containing `I`, and their faces. The sign pattern of the ray `r` of a `ℚ`-isotropic
plane `J` uses the *weak* sign conditions, so `r` itself lies in the cell of its own sign pattern,
and that cell is a member of `Σ(ℋ)` above the half line `⟨r⟩`. This cell need not meet the open
cone `C_I`: walls accumulating at the ray keep every member through the ray off it. The member that
does meet `C_I` is the cell of the sign pattern of a nearby point of the cone (`COMPLAINTS.md`,
`exists_mem_semifanArrangement_halfLine_meets`).
-/

section HalfLineCell

variable {BQ : LinearMap.BilinForm ℚ V} {Q : QuadraticForm ℝ (realified V)}

omit [Module.Finite ℚ V] in
/-- **The cell of a sign pattern is a member of `Σ(ℋ)`**: it is a cell of the arrangement, and a
cell is a face of itself. -/
theorem mem_semifanArrangement_cell {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ) (F : ConicalLine BQ Q)
    (s : fibreWalls ψ F → SignType) :
    arrangementCone (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i)) s ⊓ F.closure ∈
      semifanArrangement ψ F :=
  mem_faceClosure.2 ⟨_, ⟨s, rfl⟩, PointedCone.IsFaceOf.rfl⟩

/-- **The half line of a `ℚ`-isotropic plane lies in the cell of its own sign pattern**: the weak
sign conditions of `arrangementCone` hold at the ray itself, and the ray lies in `C_{I,+}`
(`fibreRay_mem_closure`). -/
theorem hull_fibreRay_le_cell {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ) (hBsym : BQ.IsSymm)
    (F : ConicalLine BQ Q) (G : ConicalPlane BQ) (h : F.line ≤ G.plane)
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hpos : sigPos (fibreForm Q F.space) = 1) :
    PointedCone.hull ℝ ({rationalPoint (fibreRay hBsym F G)} : Set (realified ↥F.space)) ≤
      arrangementCone (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i))
          (signPattern (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i))
            (rationalPoint (fibreRay hBsym F G))) ⊓ F.closure := by
  refine le_inf ?_ ?_
  · refine Submodule.span_le.2 ?_
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact mem_arrangementCone_signPattern _ _
  · exact Submodule.span_le.2 (by
      rintro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact fibreRay_mem_closure hBQ hBsym F G h hpos)

/-- **The half line lies in a member of `Σ(ℋ)`**: the cell of its own sign pattern is a member
(`mem_semifanArrangement_cell`) and contains the ray (`hull_fibreRay_le_cell`). What item (2) of the
issue adds is that some member above the ray *meets the open cone* `C_I`, which needs the walls
off the ray to keep their signs between `r` and a nearby point of `C_I` — `COMPLAINTS.md`. -/
theorem exists_mem_semifanArrangement_halfLine_le {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ)
    (hBsym : BQ.IsSymm) (F : ConicalLine BQ Q) (G : ConicalPlane BQ) (h : F.line ≤ G.plane)
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hpos : sigPos (fibreForm Q F.space) = 1) :
    ∃ τ ∈ semifanArrangement ψ F,
      PointedCone.hull ℝ ({rationalPoint (fibreRay hBsym F G)} : Set (realified ↥F.space)) ≤ τ :=
  ⟨_, mem_semifanArrangement_cell ψ F
      (signPattern (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i))
        (rationalPoint (fibreRay hBsym F G))),
    hull_fibreRay_le_cell ψ hBsym F G h hBQ hpos⟩

omit [Module.Finite ℚ V] in
/-- **When one point lies in the cell of another's sign pattern.** The cell of `u` contains `r`
exactly when every wall through `u` passes through `r` and every other wall has the same sign at
`u` as at `r`. A wall through `r` imposes nothing at `r`: `sign (φ i r) = 0` satisfies either side
of the weak sign condition. This is what governs the members of `Σ(ℋ)` above the half line of a
plane — they are cut by the walls *off* it — and it reduces item (2) of the issue to the geometry of
the fibre. -/
theorem mem_arrangementCone_signPattern_iff {ι : Type*} {φ : ι → (realified V) →L[ℝ] ℝ}
    {r u : realified V} :
    r ∈ arrangementCone φ (signPattern φ u) ↔
      ∀ i, (φ i u = 0 → φ i r = 0) ∧
        (φ i r ≠ 0 → SignType.sign (φ i u) = SignType.sign (φ i r)) := by
  rw [mem_arrangementCone_iff_specializes]
  simp only [signPattern]
  refine forall_congr' fun i => ?_
  constructor
  · rintro (h | h)
    · exact ⟨fun _ => sign_eq_zero_iff.1 h,
        fun hr => absurd h fun h0 => hr (sign_eq_zero_iff.1 h0)⟩
    · exact ⟨fun hu0 => sign_eq_zero_iff.1 (h.trans (by rw [hu0, sign_zero])),
        fun _ => h.symm⟩
  · rintro ⟨h1, h2⟩
    by_cases hr : φ i r = 0
    · exact Or.inl (sign_eq_zero_iff.2 hr)
    · exact Or.inr (h2 hr).symm

omit [Module.Finite ℚ V] in
/-- **A point of the fibre lies in the cell of `u`'s sign pattern** from the two clauses the fibre's
geometry supplies: every wall through `u` passes through `r`, and every wall off `r` has the same
sign at `u`. -/
theorem mem_arrangementCone_signPattern_of_sign_eq {ι : Type*} {φ : ι → (realified V) →L[ℝ] ℝ}
    {r u : realified V}
    (hoff : ∀ i, φ i u = 0 → φ i r = 0)
    (hsame : ∀ i, φ i r ≠ 0 → SignType.sign (φ i u) = SignType.sign (φ i r)) :
    r ∈ arrangementCone φ (signPattern φ u) :=
  mem_arrangementCone_signPattern_iff.2 fun i => ⟨hoff i, hsame i⟩

end HalfLineCell

/-! ## The member above the half line meets the open cone

Looijenga, Example 6.4, p. 29, and the hypothesis of Lemma-Definition 4.5, p. 19
(`.tmp-sources/looijenga-math0201218v2.md:519`): the support space of the half line `C_{J,+}` is
computed over the members of the decomposition above it that meet the **open** cone `C_I`. The half
line itself is an isotropic boundary ray of `C_{I,+}`, so this does not follow from the cover of
`C_{I,+}` alone (`COMPLAINTS.md`, "The member of `Σ(ℋ)` above the half line").

Let `r` be the class of the plane's ray in the fibre and `v` a rational point of the open cone. Only
finitely many walls cut the rational cone `P = ⟨r, v⟩` (`CutsFinitelyOnRational`, the count of
Example 4.3 (b), p. 18), so a point `u = r + ε v` of `P` with `ε` small has, at every wall off `r`,
the sign it has at `r`, and lies on no wall that misses `r`
(`exists_mem_signPattern_eq_of_cutsFinitely`). Then `r` lies in the cell of `u`'s sign pattern
(`mem_arrangementCone_signPattern_of_sign_eq`), which is a member of `Σ(ℋ)` containing
`u ∈ C_I` (`exists_mem_semifanArrangement_halfLine_meets`). -/

section HalfLineMeets

variable {BQ : LinearMap.BilinForm ℚ V} {Q : QuadraticForm ℝ (realified V)}

/-- A product of two reals is positive exactly when the two factors have the same sign. -/
theorem sign_eq_of_mul_pos {a b : ℝ} (h : 0 < a * b) : SignType.sign a = SignType.sign b := by
  rcases mul_pos_iff.1 h with ⟨ha, hb⟩ | ⟨ha, hb⟩
  · rw [sign_pos ha, sign_pos hb]
  · rw [sign_neg ha, sign_neg hb]

/-- **The open cone `C_I` lies in `C_{I,+}`** (Looijenga, Definition 4.2, p. 17): the rational
closure is the cone generated by the rational points of the closed sheet, and a point of the open
sheet lies in the interior of the pointed upper sheet, whose closure is the closed sheet. This is
the `C ⊂ C₊` of the source, which `subset_rationalClosure` supplies only for a cone open as a set —
and a pointed cone carries `0`, so the pointed upper sheet is the object to apply it to. -/
theorem ConicalLine.upper_subset_closure (F : ConicalLine BQ Q)
    (hpos : sigPos (fibreForm Q F.space) = 1) :
    positiveCone.upper (fibreForm Q F.space) F.sheet ⊆ (F.closure : Set (realified ↥F.space)) := by
  intro x hx
  rw [ConicalLine.closure_eq_closedSheet F hpos]
  have hcl : (closedSheet (fibreForm Q F.space) hpos F.sheet_pos).closure
      = closedSheet (fibreForm Q F.space) hpos F.sheet_pos :=
    (isClosed_closedSheet_of_moduleTopology _ hpos F.sheet_pos).submodule_topologicalClosure_eq
  have hDC : positiveCone.upperZero hpos F.sheet_pos ≤
      (closedSheet (fibreForm Q F.space) hpos F.sheet_pos).closure := by
    rw [hcl]
    exact upperZero_le_closedSheet hpos F.sheet_pos
  exact subset_rationalClosure_of_mem (C := closedSheet (fibreForm Q F.space) hpos F.sheet_pos)
    (D := positiveCone.upperZero hpos F.sheet_pos) hDC
    (upper_subset_interior_upperZero hpos F.sheet_pos hx)

omit [Module.Finite ℚ V] in
/-- **A form vanishing on `r + ε v` with `ε > 0`, and not at `r`, cuts the cone spanned by `r` and
`v`**: the two points have values of opposite sign (`CutsOn`). -/
theorem cutsOn_of_eq_zero_add_of_ne {ψ : (realified V) →ₗ[ℝ] ℝ}
    {P : PointedCone ℝ (realified V)} {r v : realified V} (hrP : r ∈ P) (hvP : v ∈ P)
    {ε : ℝ} (hε : 0 < ε) (hr : ψ r ≠ 0) (h0 : ψ (r + ε • v) = 0) :
    CutsOn ψ P := by
  have hexp : ψ (r + ε • v) = ψ r + ε * ψ v := by
    rw [map_add, map_smul, smul_eq_mul]
  have hv : ψ v = -(ψ r) / ε := by
    field_simp
    linarith
  rcases lt_or_gt_of_ne hr with hneg | hpos
  · refine ⟨⟨v, hvP, ?_⟩, ⟨r, hrP, hneg⟩⟩
    rw [hv]
    exact div_pos (by linarith) hε
  · refine ⟨⟨r, hrP, hpos⟩, ⟨v, hvP, ?_⟩⟩
    rw [hv]
    exact div_neg_of_neg_of_pos (by linarith) hε

/-- **The germ of a fan at a boundary point of a rational cone.** If only finitely many members of
`φ` cut the rational cone `P` (`CutsFinitelyOnRational`), then for every set `U` containing the
germ of the segment `ε ↦ r + ε v` at `ε = 0⁺` there is a point `u` of `P`, in `U`, at which every
form not vanishing at `r` has the same sign as at `r`.

A form that does not cut `P` is one-signed on it, so the only walls that can disagree with `r` are
the finitely many cutting ones, and at those `ε` is taken small enough. -/
theorem exists_mem_signPattern_eq_of_cutsFinitely
    {W : Type} [AddCommGroup W] [Module ℚ W]
    {ι : Type*} {Cplus P : PointedCone ℝ (realified W)} {φ : ι → (realified W) →L[ℝ] ℝ}
    (hcut : CutsFinitelyOnRational Cplus φ) (hP : IsRationalCone P) (hPle : P ≤ Cplus)
    {r v : realified W} (hrP : r ∈ P) (hvP : v ∈ P)
    (U : Set (realified W)) (hU : ∀ᶠ ε : ℝ in nhdsWithin (0 : ℝ) (Set.Ioi 0), r + ε • v ∈ U) :
    ∃ u ∈ P, u ∈ U ∧ ∀ i : ι, φ i r ≠ 0 → SignType.sign (φ i u) = SignType.sign (φ i r) := by
  classical
  set S := hcut P hP hPle with hS
  set A : Finset ι := S.toFinset.filter (fun i => φ i r ≠ 0) with hA
  have hA_mem : ∀ i, CutsOn (φ i).toLinearMap P → φ i r ≠ 0 → i ∈ A := by
    intro i hc hr
    rw [hA, Finset.mem_filter]
    exact ⟨S.mem_toFinset.2 hc, hr⟩
  have hA_ne : ∀ i ∈ A, φ i r ≠ 0 := by
    intro i hi
    rw [hA, Finset.mem_filter] at hi
    exact hi.2
  have hcont : ContinuousAt (fun ε : ℝ => r + ε • v) (0 : ℝ) :=
    (continuous_const.add (continuous_id.smul continuous_const)).continuousAt
  have hrU' : r + (0 : ℝ) • v ∈ ⋂ i ∈ (A : Set ι), {x | 0 < φ i x * φ i r} := by
    simp only [Set.mem_iInter]
    intro i hi
    simpa using mul_self_pos.2 (hA_ne i hi)
  have hset : (fun ε : ℝ => r + ε • v) ⁻¹' (⋂ i ∈ (A : Set ι), {x | 0 < φ i x * φ i r})
      ∈ nhds (0 : ℝ) :=
    hcont.preimage_mem_nhds ((isOpen_biInter_finset fun i _ =>
      isOpen_Ioi.preimage ((φ i).continuous.mul continuous_const)).mem_nhds hrU')
  have hev : ∀ᶠ ε : ℝ in nhdsWithin (0 : ℝ) (Set.Ioi 0),
      r + ε • v ∈ ⋂ i ∈ (A : Set ι), {x | 0 < φ i x * φ i r} :=
    nhdsWithin_le_nhds hset
  have hpos : ∀ᶠ ε : ℝ in nhdsWithin (0 : ℝ) (Set.Ioi 0), (0 : ℝ) < ε :=
    self_mem_nhdsWithin
  obtain ⟨ε, hεU, hε⟩ := (hev.and hU).and hpos |>.exists
  have huP : r + ε • v ∈ P := P.add_mem hrP (P.smul_mem hε.le hvP)
  refine ⟨r + ε • v, huP, hεU.2, fun i hi => ?_⟩
  by_cases hiA : i ∈ A
  · have h1 : 0 < φ i (r + ε • v) * φ i r := by
      have hh := hεU.1
      simp only [Set.mem_iInter] at hh
      exact hh i hiA
    exact sign_eq_of_mul_pos h1
  · have hnotcut : ¬ CutsOn (φ i).toLinearMap P := fun hc => hiA (hA_mem i hc hi)
    have hone : (∀ x ∈ P, φ i x ≤ 0) ∨ ∀ x ∈ P, 0 ≤ φ i x := by
      by_cases hpos' : ∃ x ∈ P, 0 < φ i x
      · refine Or.inr fun x hx => ?_
        by_contra hneg
        push Not at hneg
        exact hnotcut ⟨hpos', ⟨x, hx, hneg⟩⟩
      · refine Or.inl fun x hx => ?_
        push Not at hpos'
        exact hpos' x hx
    have hune : φ i (r + ε • v) ≠ 0 := by
      intro h0
      have hcoe : ((φ i).toLinearMap) (r + ε • v) = 0 := h0
      exact hnotcut (cutsOn_of_eq_zero_add_of_ne hrP hvP hε hi hcoe)
    rcases hone with hle | hge
    · rw [sign_neg (lt_of_le_of_ne (hle _ huP) hune),
        sign_neg (lt_of_le_of_ne (hle r hrP) hi)]
    · rw [sign_pos (lt_of_le_of_ne (hge _ huP) (Ne.symm hune)),
        sign_pos (lt_of_le_of_ne (hge r hrP) (Ne.symm hi))]

/-- **The member of `Σ(ℋ)` above the half line of `J` meets the open cone `C_I`.**

Looijenga, Example 6.4, p. 29: the half line `C_{J,+}` is an isotropic boundary ray of `C_{I,+}`, so
a member of `Σ(ℋ)` above it need not meet the open cone; the support space of Lemma-Definition 4.5
is computed over the members that do. Take a rational point `v` of the open cone and a point
`u = r + ε v` of the cone `⟨r, v⟩` with `ε` small: only finitely many walls cut that cone, so `r`
lies in the cell of `u`'s sign pattern, and that cell is a member of `Σ(ℋ)` containing `u ∈ C_I`. -/
theorem exists_mem_semifanArrangement_halfLine_meets
    {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ) (hBsym : BQ.IsSymm) (F : ConicalLine BQ Q)
    (G : ConicalPlane BQ) (h : F.line ≤ G.plane)
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hpos : sigPos (fibreForm Q F.space) = 1)
    (hnd : (fibreForm Q F.space).Nondegenerate)
    (hcut : CutsFinitelyOnRational F.closure (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i))) :
    ∃ τ ∈ semifanArrangement ψ F,
      PointedCone.hull ℝ ({rationalPoint (fibreRay hBsym F G)} : Set (realified ↥F.space)) ≤ τ ∧
      ((τ : Set (realified ↥F.space)) ∩
        positiveCone.upper (fibreForm Q F.space) F.sheet).Nonempty := by
  classical
  set r : realified ↥F.space := rationalPoint (fibreRay hBsym F G) with hrdef
  have hr_closed : r ∈ closedSheet (fibreForm Q F.space) hpos F.sheet_pos :=
    (mem_closedSheet hpos F.sheet_pos).2
      ⟨le_of_eq (fibreRay_isotropic hBQ hBsym F G h).symm, fibreRay_sheet_nonneg hBsym F G⟩
  have hr_ne : r ≠ 0 := by
    rw [hrdef]
    exact rationalPoint_ne_zero (fibreRay_ne_zero hBsym F G h)
  have hr_closure : r ∈ F.closure := by
    rw [hrdef]
    exact fibreRay_mem_closure hBQ hBsym F G h hpos
  obtain ⟨w, hwrange, hwU⟩ := dense_range_rationalPoint.exists_mem_open
    (isOpen_positiveCone_upper_of_moduleTopology (fibreForm Q F.space) F.sheet)
    ⟨F.sheet, F.sheet_pos, by rw [associated_self_apply]; exact F.sheet_pos⟩
  obtain ⟨v, rfl⟩ := hwrange
  have hv_closure : rationalPoint v ∈ F.closure := ConicalLine.upper_subset_closure F hpos hwU
  have hrv : 0 < (associated (fibreForm Q F.space)) r (rationalPoint v) := by
    rw [associated_comm]
    exact associated_pos_of_mem_upper_of_mem_closedSheet (fibreForm Q F.space) hpos hnd
      F.sheet_pos hwU hr_closed hr_ne
  set P : PointedCone ℝ (realified ↥F.space) :=
    PointedCone.hull ℝ ({r, rationalPoint v} : Set (realified ↥F.space)) with hPdef
  have hP_rat : IsRationalCone P := by
    refine ⟨{(fibreRay hBsym F G), v}, ?_⟩
    rw [hPdef, hrdef]
    congr 1
    ext x
    simp
  have hP_le : P ≤ F.closure := by
    rw [hPdef]
    refine Submodule.span_le.2 ?_
    rintro x (rfl | rfl)
    · exact hr_closure
    · exact hv_closure
  have hrP : r ∈ P := by
    rw [hPdef]; exact PointedCone.subset_hull (by simp)
  have hvP : rationalPoint v ∈ P := by
    rw [hPdef]; exact PointedCone.subset_hull (by simp)
  have hspos : ∀ᶠ ε : ℝ in nhdsWithin (0 : ℝ) (Set.Ioi 0), (0 : ℝ) < ε :=
    self_mem_nhdsWithin
  have hUev : ∀ᶠ ε : ℝ in nhdsWithin (0 : ℝ) (Set.Ioi 0),
      r + ε • rationalPoint v ∈ positiveCone.upper (fibreForm Q F.space) F.sheet :=
    hspos.mono fun ε hε => by
      have hε0 : 0 < ε := hε
      have hQr : (fibreForm Q F.space) r = 0 := by
        rw [hrdef]; exact fibreRay_isotropic hBQ hBsym F G h
      have hrt : 0 ≤ (associated (fibreForm Q F.space)) r F.sheet := by
        rw [hrdef]; exact fibreRay_sheet_nonneg hBsym F G
      have hvt : 0 < (associated (fibreForm Q F.space)) (rationalPoint v) F.sheet := hwU.2
      refine ⟨?_, ?_⟩
      · have hexp : (fibreForm Q F.space) (r + ε • rationalPoint v)
            = (fibreForm Q F.space) r
              + 2 * ε * (associated (fibreForm Q F.space)) r (rationalPoint v)
              + ε ^ 2 * (fibreForm Q F.space) (rationalPoint v) := by
          conv_lhs => rw [show r + ε • rationalPoint v = (1 : ℝ) • r + ε • rationalPoint v by
            rw [one_smul]]
          rw [quadratic_expand]
          ring
        rw [hexp, hQr, zero_add]
        have h1 : 0 < ε ^ 2 * (fibreForm Q F.space) (rationalPoint v) :=
          mul_pos (pow_pos hε0 2) hwU.1
        have h2 : 0 < 2 * ε * (associated (fibreForm Q F.space)) r (rationalPoint v) :=
          mul_pos (by linarith) hrv
        linarith
      · rw [map_add, map_smul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul]
        nlinarith [hrt, hvt, hε0]
  obtain ⟨u, _, huU, hsign⟩ :=
    exists_mem_signPattern_eq_of_cutsFinitely (Cplus := F.closure) (P := P)
      hcut hP_rat hP_le hrP hvP _ hUev
  have hu_closure : u ∈ F.closure := ConicalLine.upper_subset_closure F hpos huU
  have hoff : ∀ i : fibreWalls ψ F,
      fibreFormC F (ψ ↑i) u = 0 → fibreFormC F (ψ ↑i) r = 0 := by
    intro i hi
    by_contra hne
    have hs : SignType.sign ((fibreFormC F (ψ ↑i)) r) = 0 := by
      rw [← hsign i hne, hi, sign_zero]
    exact sign_ne_zero_of_ne hne hs
  have hrcone : r ∈ arrangementCone (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i))
      (signPattern (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i)) u) :=
    mem_arrangementCone_signPattern_of_sign_eq hoff hsign
  have hucone : u ∈ arrangementCone (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i))
      (signPattern (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i)) u) :=
    mem_arrangementCone_signPattern (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i)) u
  refine ⟨arrangementCone (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i))
      (signPattern (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i)) u) ⊓ F.closure,
    mem_semifanArrangement_cell ψ F _, ?_, ⟨u, ⟨hucone, hu_closure⟩, huU⟩⟩
  refine Submodule.span_le.2 ?_
  rintro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  exact ⟨hrcone, hr_closure⟩

end HalfLineMeets

/-! ## Example 6.4: the `≤` half of `J_{Σ(ℋ)} = J_ℋ`

Looijenga, Example 6.4, p. 29 (`.tmp-sources/looijenga-math0201218v2.md:791`): "the space `J_ℋ`
associated to a `ℚ`-isotropic plane `J` is the common intersection of `J^⊥` and the hyperplanes
`H ∈ ℋ` containing `J`".

The support space of the half line is the intersection of the zero sets of the forms nonnegative on
a member above it and vanishing on it (Lemma-Definition 4.5, p. 19), so the two inclusions are read
on those forms. `J^⊥` is the pair of kernels `⟨gen⟩^⊥ ∩ ⟨ray⟩^⊥` of the two generators of the
plane, and the trace of every `H ⊇ J` vanishes on the member of `Σ(ℋ)` above the half line that
meets the open cone (`exists_mem_semifanArrangement_halfLine_meets`), which is
`supportSpace_halfLine_le_ker`.

### LC-09 record (2026-11-16, #162, the `J^⊥` half)

The geometric input is the sign of the pairing of two vectors of the closed sheet of a form of
signature `(1, dim − 1)` — the reversed Cauchy–Schwarz inequality of an indefinite form. The corpus
(`scripts/formalization_corpus.py search`) and Mathlib's own sources were searched first:
`light cone isotropic ray orthogonal`, `reversed Cauchy-Schwarz indefinite quadratic form`,
`Lorentzian cone self-dual`, `closed cone dual quadratic signature one`,
`isotropic vector nonnegative pairing sheet`, `sigPos`, `nonneg_associated_of_mem_closedSheet`,
`PointedCone.dual finitely generated`: no file on the light cone or on a reversed Cauchy–Schwarz
inequality (the only substantive hits are Mathlib's `Mathlib.lean` import list and TauCeti's cone
files, which are the cone API used below, not this inequality). Mathlib's `sigPos` is
`LinearAlgebra/QuadraticForm/Signature.lean`; its Cauchy–Schwarz results
(`Analysis/InnerProductSpace/Basic.lean`) are for positive definite inner product spaces and do not
apply to an indefinite form. The inequality is therefore the repository's own, and it is already
proved: `nonneg_associated_of_quadratic_eq_zero_of_mem_closedSheet` (the isotropic form of
`nonneg_associated_of_mem_closedSheet`, which pushes both vectors into the open sheet), whose fibre
form is `supportSpace_le_ker_associated_of_isotropic`. What is written here is the transport of that
statement to the ambient space, through the class of the ray in the fibre
(`fibreRayProj_val`). -/

section HalfLineSupportLe

variable {BQ : LinearMap.BilinForm ℚ V} {Q : QuadraticForm ℝ (realified V)}

/-- **The `Σ`-support space of the half line lies in `⟨gen⟩^⊥`**, the `I`-half of `J^⊥`: the fibre
of `I` is orthogonal to `I` (`realify_planeComplement_le_planePerp`), and so is the line itself. -/
theorem vSigmaPlane_semifanArrangement_le_ker_gen {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ)
    (hBsym : BQ.IsSymm) (F : ConicalLine BQ Q) (G : ConicalPlane BQ) (h : F.line ≤ G.plane)
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ)) :
    vSigmaPlane hBsym F (semifanArrangement ψ F) G h ≤
      LinearMap.ker (associated Q (rationalPoint F.gen)) := by
  rw [vSigmaPlane]
  refine sup_le ?_ ?_
  · rw [lineSpan, Submodule.span_le]
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    change (associated Q (rationalPoint F.gen)) (rationalPoint F.gen) = 0
    rw [hBQ, F.gen_iso]
    norm_num
  · intro z hz
    obtain ⟨y, -, rfl⟩ := Submodule.mem_map.1 hz
    change (associated Q (rationalPoint F.gen)) (realifyMap F.space y) = 0
    exact (mem_planePerp_iff.1 (realify_planeComplement_le_planePerp (Q := Q)
      (e := F.gen) (f := F.partner) hBQ ⟨y, rfl⟩)).1

/-- **The `Σ`-support space of the half line lies in the trace of every `H ⊇ J`**: a hyperplane
containing the plane `J` has its trace vanishing on the half line, and the support space of the half
line relative to a member of `Σ(ℋ)` above it is contained in the kernel of that trace
(`supportSpace_halfLine_le_ker`). The member is the one meeting the open cone
(`exists_mem_semifanArrangement_halfLine_meets`). -/
theorem vSigmaPlane_semifanArrangement_le_ker_wall {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ)
    (hBsym : BQ.IsSymm) (F : ConicalLine BQ Q) (G : ConicalPlane BQ) (h : F.line ≤ G.plane)
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hpos : sigPos (fibreForm Q F.space) = 1)
    (hnd : (fibreForm Q F.space).Nondegenerate)
    (hcut : CutsFinitelyOnRational F.closure (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i)))
    (i : fibreWalls ψ F)
    (hi : fibreFormC F (ψ ↑i) (rationalPoint (fibreRay hBsym F G)) = 0) :
    vSigmaPlane hBsym F (semifanArrangement ψ F) G h ≤
      LinearMap.ker (realifiedFormC (ψ (i : ι))).toLinearMap := by
  obtain ⟨τ, hτmem, hτle, hτmeet⟩ :=
    exists_mem_semifanArrangement_halfLine_meets ψ hBsym F G h hBQ hpos hnd hcut
  have hle := supportSpace_halfLine_le_ker (Q := Q) hBsym F G ⟨τ, hτmem, hτle, hτmeet⟩ i hi
  have hsub : sigmaSupportSpace (positiveCone.upper (fibreForm Q F.space) F.sheet)
      (semifanArrangement ψ F) (PointedCone.hull ℝ ({rationalPoint (fibreRay hBsym F G)})) ≤
      supportSpace τ (PointedCone.hull ℝ ({rationalPoint (fibreRay hBsym F G)})) :=
    sigmaSupportSpace_le hτmem hτle hτmeet
  rw [vSigmaPlane]
  refine sup_le ?_ ?_
  · rw [lineSpan, Submodule.span_le]
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    rw [realifiedFormC_toLinearMap]
    change realifiedForm (ψ (i : ι)) (rationalPoint F.gen) = 0
    rw [realifiedForm_rationalPoint]
    have hgen : F.gen ∈ F.line := by
      rw [F.line_eq]; exact Submodule.subset_span (Set.mem_singleton _)
    have hzero := (i.2 : F.line ≤ LinearMap.ker (ψ (i : ι))) hgen
    simpa using hzero
  · intro z hz
    obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.1 hz
    change realifiedForm (ψ (i : ι)) (realifyMap F.space y) = 0
    rw [← fibreFormC_apply F (ψ (i : ι)) y]
    exact hle (hsub hy)

/-- **The `Σ`-support space of the half line lies in the orthogonal complement of the ray.**

The form `x ↦ r · x` attached to an isotropic ray `r` of the closed sheet is nonnegative on the
whole closed sheet (`nonneg_associated_of_quadratic_eq_zero_of_mem_closedSheet`: an isotropic vector
of the sheet of a form of signature `(1, dim − 1)` pairs nonnegatively with every vector of the
sheet), so it is one of the forms of `supportForms τ ⟨r⟩` and every point of the support space is
orthogonal to `r`. This is the `⟨ray⟩^⊥` half of `J^⊥` in Example 6.4, p. 29. -/
theorem sigmaSupportSpace_halfLine_le_ker_fibreRay {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ)
    (hBsym : BQ.IsSymm) (F : ConicalLine BQ Q) (G : ConicalPlane BQ) (h : F.line ≤ G.plane)
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hpos : sigPos (fibreForm Q F.space) = 1)
    (hnd : (fibreForm Q F.space).Nondegenerate)
    (hcut : CutsFinitelyOnRational F.closure (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i))) :
    sigmaSupportSpace (positiveCone.upper (fibreForm Q F.space) F.sheet) (semifanArrangement ψ F)
        (PointedCone.hull ℝ ({rationalPoint (fibreRay hBsym F G)} : Set (realified ↥F.space))) ≤
      LinearMap.ker ((associated (fibreForm Q F.space)) (rationalPoint (fibreRay hBsym F G))) := by
  obtain ⟨τ, hτmem, hτle, hτmeet⟩ :=
    exists_mem_semifanArrangement_halfLine_meets ψ hBsym F G h hBQ hpos hnd hcut
  refine (sigmaSupportSpace_le hτmem hτle hτmeet).trans ?_
  obtain ⟨cell, hcell, hface⟩ := mem_faceClosure.1 hτmem
  obtain ⟨s, rfl⟩ := hcell
  have hτclos : τ ≤ F.closure := hface.le.trans inf_le_right
  exact supportSpace_le_ker_associated_of_isotropic (Q := fibreForm Q F.space) hpos F.sheet_pos
    (fibreRay_isotropic hBQ hBsym F G h) (fibreRay_sheet_nonneg hBsym F G) rfl
    (hτclos.trans (closure_le_closedSheet F hpos))

/-- **The `Σ`-support space of the half line lies in the orthogonal complement of the plane's
ray**: the `⟨ray⟩^⊥` half of `J^⊥` for `J = ⟨gen, ray⟩` in Example 6.4, p. 29.

A point of the fibre orthogonal to the *class* of the ray is orthogonal to the ray itself: the class
differs from the ray by a multiple of the line's generator (`fibreRayProj_val`), which the fibre is
orthogonal to. -/
theorem vSigmaPlane_semifanArrangement_le_ker_ray {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ)
    (hBsym : BQ.IsSymm) (F : ConicalLine BQ Q) (G : ConicalPlane BQ) (h : F.line ≤ G.plane)
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hpos : sigPos (fibreForm Q F.space) = 1)
    (hnd : (fibreForm Q F.space).Nondegenerate)
    (hcut : CutsFinitelyOnRational F.closure (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i))) :
    vSigmaPlane hBsym F (semifanArrangement ψ F) G h ≤
      LinearMap.ker (associated Q (rationalPoint G.ray)) := by
  rw [vSigmaPlane]
  refine sup_le ?_ ?_
  · rw [lineSpan, Submodule.span_le]
    rintro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    change (associated Q (rationalPoint G.ray)) (rationalPoint F.gen) = 0
    rw [hBQ]
    exact_mod_cast G.isotropic G.ray G.ray_mem F.gen (F.gen_mem_plane G h)
  · intro z hz
    obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.1 hz
    have hker := sigmaSupportSpace_halfLine_le_ker_fibreRay ψ hBsym F G h hBQ hpos hnd hcut hy
    change (associated Q (rationalPoint G.ray)) (realifyMap F.space y) = 0
    have hgen0 : (associated Q) (rationalPoint F.gen) (realifyMap F.space y) = 0 :=
      (mem_planePerp_iff.1 (realify_planeComplement_le_planePerp (Q := Q) (e := F.gen)
        (f := F.partner) hBQ ⟨y, rfl⟩)).1
    have hproj : rationalPoint ((fibreRayProj hBsym F G : ↥F.space) : V) =
        rationalPoint G.ray - (BQ G.ray F.partner : ℝ) • rationalPoint F.gen := by
      rw [fibreRayProj_val hBsym F G h, map_sub]
      congr 1
      exact rationalPoint_rat_smul (BQ G.ray F.partner) F.gen
    have hshift : (associated Q) (rationalPoint G.ray) (realifyMap F.space y) =
        (associated Q) (rationalPoint ((fibreRayProj hBsym F G : ↥F.space) : V))
          (realifyMap F.space y) := by
      rw [hproj, LinearMap.BilinForm.sub_left, LinearMap.BilinForm.smul_left, hgen0, mul_zero,
        sub_zero]
    rw [hshift]
    have hfib : (associated (fibreForm Q F.space)) (rationalPoint (fibreRayProj hBsym F G)) y =
        (associated Q) (rationalPoint ((fibreRayProj hBsym F G : ↥F.space) : V))
          (realifyMap F.space y) := by
      rw [associated_fibreForm, realifyMap_rationalPoint]
    rw [← hfib]
    rcases fibreRay_eq_or_neg hBsym F G with h' | h'
    · have h0 := LinearMap.mem_ker.1 hker
      rw [h'] at h0
      exact h0
    · have h0 := LinearMap.mem_ker.1 hker
      rw [h'] at h0
      simpa using h0

/-- **Looijenga, Example 6.4, p. 29: `J_{Σ(ℋ)} ⊆ J_ℋ`.** The support space of the half line of the
`ℚ`-isotropic plane `J = ⟨gen, ray⟩` is contained in `J^⊥` — the common kernel of the two forms of
its spanning pair — and in the trace of every hyperplane of `ℋ` containing `J`; that intersection
is the `J_ℋ` of the source. -/
theorem vSigmaPlane_semifanArrangement_le_JH {ι : Type*} (ψ : ι → V →ₗ[ℚ] ℚ)
    (hBsym : BQ.IsSymm) (F : ConicalLine BQ Q) (G : ConicalPlane BQ) (h : F.line ≤ G.plane)
    (hBQ : ∀ u w : V, (associated Q) (rationalPoint u) (rationalPoint w) = (BQ u w : ℝ))
    (hpos : sigPos (fibreForm Q F.space) = 1)
    (hnd : (fibreForm Q F.space).Nondegenerate)
    (hcut : CutsFinitelyOnRational F.closure (fun i : fibreWalls ψ F => fibreFormC F (ψ ↑i))) :
    vSigmaPlane hBsym F (semifanArrangement ψ F) G h ≤
      (LinearMap.ker (associated Q (rationalPoint F.gen)) ⊓
        LinearMap.ker (associated Q (rationalPoint G.ray))) ⊓
        ⨅ i : {i : fibreWalls ψ F //
            fibreFormC F (ψ ↑i) (rationalPoint (fibreRay hBsym F G)) = 0},
          LinearMap.ker (realifiedFormC (ψ ((i.1 : fibreWalls ψ F) : ι))).toLinearMap :=
  le_inf
    (le_inf (vSigmaPlane_semifanArrangement_le_ker_gen ψ hBsym F G h hBQ)
      (vSigmaPlane_semifanArrangement_le_ker_ray ψ hBsym F G h hBQ hpos hnd hcut))
    (le_iInf fun i => vSigmaPlane_semifanArrangement_le_ker_wall ψ hBsym F G h hBQ hpos hnd hcut
      i.1 i.2)

end HalfLineSupportLe

