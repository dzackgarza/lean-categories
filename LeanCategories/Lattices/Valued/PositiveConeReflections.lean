module

public import LeanCategories.Lattices.Valued.PositiveCone
public import Mathlib.LinearAlgebra.Reflection

/-!
# Reflections in spacelike vectors lie in `O⁺`, and the reflection group is normal

For a real quadratic form `Q` of signature `(1, n)` (`sigPos Q = 1`), the reflection in a
vector `a` of negative value — a *spacelike* root — preserves each sheet of the positive cone,
hence lies in `O⁺(Q)` (`reflectIn_mem_positiveConeStabilizer`). The reason is that `a^⊥` contains
a positive vector `u`: the reflection fixes `u`, so it fixes the sheet containing `u`, and an
isometry that fixes one sheet fixes both.

It follows that the reflection group generated by the spacelike roots, `realReflectionGroup`, is
contained in `O⁺(Q)` (`realReflectionGroup_le_positiveConeStabilizer`). It is moreover normal in
`O(Q)` (`realReflectionGroup_normal`): conjugating the reflection in `a` by an isometry `g`
gives the reflection in `g⁻¹ a` (`conj_reflectIn`), and `g⁻¹ a` again has negative value.

## The sign hypothesis is not removable

`W ≤ O⁺` fails without a hypothesis on the sign of the square of the roots, and the failure is
visible already in signature `(1, 1)`: on `ℝ²` with the form `Q x = x₀² - x₁²` — so `sigPos Q = 1` —
the vector `a = (√2, 0)` has `Q a = 2`, a *positive* square. Its reflection sends `a` to `-a`
(`reflectIn_positive_sq_swaps`), so it carries the sheet containing `a` to the other one: it lies in
`O(Q)` and not in `O⁺(Q)`. The statement is therefore proved for the reflections in vectors of
*negative* value — the grade `Rt_r`, `r < 0`, of the root set, which is the even-lattice Weyl group.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 27.
* V. V. Nikulin, *Integral symmetric bilinear forms and some of their applications*, Izv.
  Akad. Nauk SSSR Ser. Mat. 43 (1979), §1.
-/

@[expose] public section

open QuadraticMap

namespace LeanCategories.Lattices.Valued

universe u

section Functional

variable {V : Type u} [AddCommGroup V] [Module ℝ V]

/-- The functional `x ↦ 2 b(x, a) / Q a`, whose kernel is the hyperplane orthogonal to `a`. -/
noncomputable def quadraticReflectionFunctional (Q : QuadraticForm ℝ V) (a : V) : V →ₗ[ℝ] ℝ :=
  (2 / Q a) • (associated Q) a

theorem quadraticReflectionFunctional_apply (Q : QuadraticForm ℝ V) (a x : V) :
    quadraticReflectionFunctional Q a x = 2 * (associated Q) x a / Q a := by
  rw [quadraticReflectionFunctional, LinearMap.smul_apply, smul_eq_mul]
  change 2 / Q a * (associated Q) a x = 2 * (associated Q) x a / Q a
  rw [associated_comm Q a x]
  ring

theorem quadraticReflectionFunctional_self (Q : QuadraticForm ℝ V) {a : V} (ha : Q a ≠ 0) :
    quadraticReflectionFunctional Q a a = 2 := by
  rw [quadraticReflectionFunctional_apply, associated_self_apply]
  field_simp

/-- **The reflection in a vector of nonzero value.** It fixes the hyperplane orthogonal to `a` and
sends `a` to `-a`. -/
noncomputable def reflectIn (Q : QuadraticForm ℝ V) (a : V) (ha : Q a ≠ 0) :
    Q.IsometryEquiv Q where
  toLinearEquiv := Module.reflection (quadraticReflectionFunctional_self Q ha)
  map_app' := by
    intro y
    have hval : (Module.reflection (quadraticReflectionFunctional_self Q ha)) y
        = y - (2 * (associated Q) y a / Q a) • a := by
      rw [Module.reflection_apply (h := quadraticReflectionFunctional_self Q ha),
        quadraticReflectionFunctional_apply]
    have hexp := quadratic_expand Q (1 : ℝ) (-(2 * (associated Q) y a / Q a)) y a
    simp only [one_smul, one_pow, one_mul] at hexp
    change Q ((Module.reflection (quadraticReflectionFunctional_self Q ha)) y) = Q y
    rw [hval, sub_eq_add_neg, ← neg_smul, hexp]
    field_simp
    ring

theorem reflectIn_apply (Q : QuadraticForm ℝ V) {a : V} (ha : Q a ≠ 0) (x : V) :
    reflectIn Q a ha x = x - (2 * (associated Q) x a / Q a) • a := by
  change (Module.reflection (quadraticReflectionFunctional_self Q ha)) x
      = x - (2 * (associated Q) x a / Q a) • a
  rw [Module.reflection_apply (h := quadraticReflectionFunctional_self Q ha),
    quadraticReflectionFunctional_apply]

theorem associated_reflectIn_self (Q : QuadraticForm ℝ V) {a : V} (ha : Q a ≠ 0) {x : V}
    (hx : (associated Q) x a = 0) : reflectIn Q a ha x = x := by
  rw [reflectIn_apply, hx]
  simp

end Functional

section Spacelike

variable {V : Type u} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
variable {Q : QuadraticForm ℝ V}

/-- **Over a form of signature `(1, n)` the orthogonal complement of a negative vector contains a
positive vector.** -/
theorem exists_associated_eq_zero_pos (Q : QuadraticForm ℝ V) (hpos : sigPos Q = 1) {a : V}
    (ha : Q a < 0) : ∃ u : V, (associated Q) u a = 0 ∧ 0 < Q u := by
  obtain ⟨Vp, hrank, hPD⟩ := exists_finrank_eq_sigPos_and_posDef (Q := Q)
  have hne : Vp ≠ ⊥ := by
    intro h
    rw [h, hpos] at hrank
    simp at hrank
  have hQa : Q a ≠ 0 := ne_of_lt ha
  obtain ⟨v, hvmem, hvne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (p := Vp) hne
  have hQv : 0 < Q v := hPD ⟨v, hvmem⟩ (by simpa using hvne)
  rcases eq_or_ne ((associated Q) v a) 0 with h0 | h0
  · exact ⟨v, h0, hQv⟩
  · have hexp : Q (v - ((associated Q) v a / Q a) • a)
        = Q v - 2 * ((associated Q) v a / Q a) * (associated Q) v a
          + ((associated Q) v a / Q a) ^ 2 * Q a := by
      have h := quadratic_expand Q (1 : ℝ) (-((associated Q) v a / Q a)) v a
      simp only [one_smul, one_pow, one_mul] at h
      rw [sub_eq_add_neg, ← neg_smul, h]
      ring
    refine ⟨v - ((associated Q) v a / Q a) • a, ?_, ?_⟩
    · rw [map_sub, map_smul, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul,
        associated_self_apply]
      field_simp
      ring
    · have hsq : ((associated Q) v a / Q a) ^ 2 * Q a = (associated Q) v a ^ 2 / Q a := by
        field_simp
      have hcross : 2 * ((associated Q) v a / Q a) * (associated Q) v a
          = 2 * ((associated Q) v a ^ 2 / Q a) := by
        field_simp
      rw [hexp, hsq, hcross]
      have hsqpos : 0 < (associated Q) v a ^ 2 := by
        rcases lt_or_gt_of_ne h0 with h | h
        · nlinarith
        · nlinarith
      have hdiv : (associated Q) v a ^ 2 / Q a < 0 := div_neg_of_pos_of_neg hsqpos ha
      nlinarith [hQv, hdiv]

/-- **The reflection in a spacelike vector lies in `O⁺`.** It fixes a positive vector orthogonal to
`a`, hence fixes the sheet containing it, and permutes each sheet into itself. -/
theorem reflectIn_mem_positiveConeStabilizer (Q : QuadraticForm ℝ V) (hpos : sigPos Q = 1)
    {t : V} (ht : 0 < Q t) {a : V} (ha : Q a < 0) :
    reflectIn Q a (ne_of_lt ha) ∈ positiveConeStabilizer Q hpos t ht := by
  obtain ⟨u, hu, huPos⟩ := exists_associated_eq_zero_pos Q hpos ha
  have hfix : reflectIn Q a (ne_of_lt ha) u = u := associated_reflectIn_self Q (ne_of_lt ha) hu
  refine (mem_positiveConeStabilizer_iff Q hpos ht _).mpr ?_
  rcases image_upper_eq_upper_or_lower Q hpos ht (reflectIn Q a (ne_of_lt ha)) with h | h
  · exact h
  · exfalso
    have hlow : reflectIn Q a (ne_of_lt ha) '' positiveCone.lower Q t = positiveCone.upper Q t :=
      image_lower_of_swap Q hpos ht _ h
    rcases mem_upper_or_mem_lower Q hpos ht huPos with hu' | hu'
    · have hmem : u ∈ positiveCone.lower Q t := by
        rw [← h]
        exact ⟨u, hu', hfix⟩
      exact (Set.disjoint_left.mp (upper_disjoint_lower Q t)) hu' hmem
    · have hmem : u ∈ positiveCone.upper Q t := by
        rw [← hlow]
        exact ⟨u, hu', hfix⟩
      exact (Set.disjoint_left.mp (upper_disjoint_lower Q t)) hmem hu'

/-- The reflections in the vectors of negative value, as a set of isometries. -/
def reflectionGenerators (Q : QuadraticForm ℝ V) : Set (Q.IsometryEquiv Q) :=
  {f | ∃ a : V, ∃ ha : Q a < 0, reflectIn Q a (ne_of_lt ha) = f}

/-- **The reflection group of a form of signature `(1, n)`**: the group generated by the
reflections in the vectors of negative value (the grade `Rt_r`, `r < 0`, of the root set). -/
noncomputable def realReflectionGroup (Q : QuadraticForm ℝ V) :
    Subgroup (Q.IsometryEquiv Q) :=
  Subgroup.closure (reflectionGenerators Q)

/-- **`W ≤ O⁺`.** -/
theorem realReflectionGroup_le_positiveConeStabilizer (Q : QuadraticForm ℝ V)
    (hpos : sigPos Q = 1) {t : V} (ht : 0 < Q t) :
    realReflectionGroup Q ≤ positiveConeStabilizer Q hpos t ht := by
  intro f hf
  induction hf using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      exact reflectIn_mem_positiveConeStabilizer Q hpos ht ha
  | one => exact one_mem _
  | mul x y hx hy ihx ihy => exact mul_mem ihx ihy
  | inv x hx ih => exact inv_mem ih

omit [FiniteDimensional ℝ V] in
/-- The reflection in `a` is the identity on the orthogonal complement of `a`. -/
theorem reflectIn_associated_comm (Q : QuadraticForm ℝ V) {a : V} (ha : Q a ≠ 0) (x : V) :
    (associated Q) (reflectIn Q a ha x) a = -(associated Q) x a := by
  rw [reflectIn_apply, map_sub, map_smul, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul,
    associated_self_apply]
  field_simp
  ring

omit [FiniteDimensional ℝ V] in
/-- **Conjugating a reflection by an isometry gives the reflection in the inverse image.** -/
theorem conj_reflectIn (Q : QuadraticForm ℝ V) {g : Q.IsometryEquiv Q} {a : V} (ha : Q a ≠ 0) :
    g * reflectIn Q a ha * g⁻¹ =
      reflectIn Q (g⁻¹ a) (by rw [QuadraticMap.IsometryEquiv.map_app]; exact ha) := by
  have hQ : Q ((g⁻¹ : Q.IsometryEquiv Q) a) = Q a := QuadraticMap.IsometryEquiv.map_app g⁻¹ a
  refine DFunLike.ext _ _ (fun x => ?_)
  have hinv : (g⁻¹ : Q.IsometryEquiv Q) (g x) = x :=
    QuadraticMap.IsometryEquiv.symm_apply_apply g x
  rw [show ((g * reflectIn Q a ha * g⁻¹ : Q.IsometryEquiv Q)) x
      = (g⁻¹ : Q.IsometryEquiv Q) (reflectIn Q a ha (g x)) from rfl]
  rw [reflectIn_apply, map_sub, map_smul, hinv, reflectIn_apply, hQ]
  have hmap : (associated Q) (g x) a = (associated Q) x ((g⁻¹ : Q.IsometryEquiv Q) a) := by
    have h := associated_map (Q := Q) g x ((g⁻¹ : Q.IsometryEquiv Q) a)
    have hgg : g ((g⁻¹ : Q.IsometryEquiv Q) a) = a :=
      QuadraticMap.IsometryEquiv.apply_symm_apply g a
    rwa [hgg] at h
  rw [hmap]

omit [FiniteDimensional ℝ V] in
/-- **`W ⊴ O(Q)`**: the reflection group is normal in the orthogonal group, because conjugation
carries the reflection in `a` to the reflection in `g⁻¹ a`, which is a vector of negative value. -/
theorem realReflectionGroup_normal (Q : QuadraticForm ℝ V) :
    (realReflectionGroup Q).Normal := by
  refine ⟨?_⟩
  intro f hf g
  induction hf using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      rw [conj_reflectIn Q (ne_of_lt ha)]
      refine Subgroup.subset_closure ⟨(g⁻¹ : Q.IsometryEquiv Q) a, ?_, rfl⟩
      rw [QuadraticMap.IsometryEquiv.map_app]
      exact ha
  | one => simp
  | mul x y hx hy ihx ihy =>
      rw [show g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) by group]
      exact mul_mem ihx ihy
  | inv x hx ih =>
      rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
      exact inv_mem ih

end Spacelike

end LeanCategories.Lattices.Valued
