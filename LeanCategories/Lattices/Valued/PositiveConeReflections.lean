module

public import LeanCategories.Lattices.Valued.PositiveCone
public import Mathlib.LinearAlgebra.Reflection

/-!
# Reflections in spacelike vectors lie in `O⁺`, and the reflection group is normal

For a real quadratic form `Q` of signature `(1, n)` (`sigPos Q = 1`), the reflection in a
vector `a` of negative value — a *spacelike* root — preserves each sheet of the positive
cone, hence lies in `O⁺(Q)` (`reflectIn_mem_positiveConeStabilizer`). The reason is that `a^⊥`
contains a positive vector `u`: the reflection fixes `u`, so it fixes the sheet containing `u`,
and an isometry that fixes one sheet fixes both.

It follows that the reflection group generated by the spacelike roots, `realReflectionGroup`,
is contained in `O⁺(Q)` (`realReflectionGroup_le_positiveConeStabilizer`). It is moreover normal
in `O(Q)` (`realReflectionGroup_normal`): conjugating the reflection in `a` by an isometry `g`
gives the reflection in `g a` (`conj_reflectIn`), and `g a` has negative value again.

## The hypothesis is not removable

`W ≤ O⁺` fails without a sign hypothesis on the roots. In the rank-one lattice `⟨-2⟩` the
only reflective vector is the generator, `Q` has signature `(0, 1)`, and the reflection `x ↦ -x`
exchanges the two sheets: it lies in `O(Q)`, not in `O⁺(Q)`. So the statement is proved, as it
must be, for the reflections in vectors of *negative* value — the grade `Rt_r` of the root set
for `r < 0`, the even-lattice Weyl group — and not for an arbitrary reflective vector.

## References

* J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 27.
* V. V. Nikulin, *Integral symmetric bilinear forms and some of their applications*, Izv.
  Akad. Nauk SSSR Ser. Mat. 43 (1979), §1.
-/

@[expose] public section

open QuadraticMap

namespace LeanCategories.Lattices.Valued

universe u

section Functional

variable {V : Type u} [AddCommGroup V] [Module ℝ V]

/-- The functional `x ↦ 2 b(x, a) / Q a`, whose kernel is the hyperplane orthogonal to `a`. -/
noncomputable def quadraticReflectionFunctional (Q : QuadraticForm ℝ V) (a : V) : V →ₗ[ℝ] ℝ :=
  (2 / Q a) • (associated Q) a

theorem quadraticReflectionFunctional_apply (Q : QuadraticForm ℝ V) (a x : V) :
    quadraticReflectionFunctional Q a x = 2 * formPairing Q x a / Q a := by
  rw [quadraticReflectionFunctional, LinearMap.smul_apply, smul_eq_mul]
  change 2 / Q a * formPairing Q a x = 2 * formPairing Q x a / Q a
  rw [formPairing_comm Q a x]
  ring

theorem quadraticReflectionFunctional_self (Q : QuadraticForm ℝ V) {a : V} (ha : Q a ≠ 0) :
    quadraticReflectionFunctional Q a a = 2 := by
  rw [quadraticReflectionFunctional_apply, formPairing_self]
  field_simp

/-- **The reflection in a vector of nonzero value.** It fixes the hyperplane orthogonal to `a` and
sends `a` to `-a`. -/
noncomputable def reflectIn (Q : QuadraticForm ℝ V) (a : V) (ha : Q a ≠ 0) : V ≃ₗ[ℝ] V :=
  Module.reflection (quadraticReflectionFunctional_self Q ha)

theorem reflectIn_apply (Q : QuadraticForm ℝ V) {a : V} (ha : Q a ≠ 0) (x : V) :
    reflectIn Q a ha x = x - (2 * formPairing Q x a / Q a) • a := by
  rw [reflectIn, Module.reflection_apply, quadraticReflectionFunctional_apply]

/-- The reflection in `a` fixes every vector orthogonal to `a`. -/
theorem formPairing_reflectIn_self (Q : QuadraticForm ℝ V) {a : V} (ha : Q a ≠ 0) {x : V}
    (hx : formPairing Q x a = 0) : reflectIn Q a ha x = x := by
  rw [reflectIn_apply, hx]
  simp

end Functional

section Isometry

variable {V : Type u} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]

omit [FiniteDimensional ℝ V] in
/-- **The reflection in a non-isotropic vector is an isometry of the form.** -/
theorem reflectIn_mem_quadraticOrthogonalGroup (Q : QuadraticForm ℝ V) {a : V} (ha : Q a ≠ 0) :
    reflectIn Q a ha ∈ quadraticOrthogonalGroup Q := by
  intro y
  have hexp := quadratic_expand Q (1 : ℝ) (-(2 * formPairing Q y a / Q a)) y a
  simp only [one_smul, one_pow, one_mul] at hexp
  rw [reflectIn_apply]
  simp only [sub_eq_add_neg, ← neg_smul]
  rw [hexp]
  field_simp
  ring

/-- **Over a form of signature `(1, n)` the orthogonal complement of a negative vector contains a
positive vector.** -/
theorem exists_formPairing_eq_zero_pos (Q : QuadraticForm ℝ V) (hpos : sigPos Q = 1) {a : V}
    (ha : Q a < 0) : ∃ u : V, formPairing Q u a = 0 ∧ 0 < Q u := by
  obtain ⟨Vp, hrank, hPD⟩ := exists_finrank_eq_sigPos_and_posDef (Q := Q)
  have hne : Vp ≠ ⊥ := by
    intro h
    rw [h, hpos] at hrank
    simp at hrank
  have hQa : Q a ≠ 0 := ne_of_lt ha
  obtain ⟨v, hvmem, hvne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (p := Vp) hne
  have hQv : 0 < Q v := hPD ⟨v, hvmem⟩ (by simpa using hvne)
  rcases eq_or_ne (formPairing Q v a) 0 with h0 | h0
  · exact ⟨v, h0, hQv⟩
  · refine ⟨v - (formPairing Q v a / Q a) • a, ?_, ?_⟩
    · rw [formPairing_sub_left, formPairing_smul_left, formPairing_self]
      field_simp
      ring
    · have hexp : Q (v - (formPairing Q v a / Q a) • a)
          = Q v - 2 * (formPairing Q v a / Q a) * formPairing Q v a
            + (formPairing Q v a / Q a) ^ 2 * Q a := by
        have h := quadratic_expand Q (1 : ℝ) (-(formPairing Q v a / Q a)) v a
        simp only [one_smul, one_pow, one_mul] at h
        rw [sub_eq_add_neg, ← neg_smul, h]
        ring
      have hQaneg : Q a < 0 := ha
      have hsq : (formPairing Q v a / Q a) ^ 2 * Q a
          = formPairing Q v a ^ 2 / Q a := by
        field_simp
      have hcross : 2 * (formPairing Q v a / Q a) * formPairing Q v a
          = 2 * (formPairing Q v a ^ 2 / Q a) := by
        field_simp
      rw [hexp, hsq, hcross]
      have hsqpos : 0 < formPairing Q v a ^ 2 := by
        rcases lt_or_gt_of_ne h0 with h | h
        · nlinarith
        · nlinarith
      have hdiv : formPairing Q v a ^ 2 / Q a < 0 := div_neg_of_pos_of_neg hsqpos hQaneg
      nlinarith [hQv, hdiv]

end Isometry

section Cone

variable {V : Type u} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
variable {Q : QuadraticForm ℝ V}

/-- **The reflection in a spacelike vector lies in `O⁺`.** It fixes a positive vector
orthogonal to `a`, hence fixes the sheet containing it, and permutes each sheet into itself. -/
theorem reflectIn_mem_positiveConeStabilizer (Q : QuadraticForm ℝ V) (hpos : sigPos Q = 1)
    {t : V} (ht : 0 < Q t) {a : V} (ha : Q a < 0) :
    (⟨reflectIn Q a (ne_of_lt ha), reflectIn_mem_quadraticOrthogonalGroup Q (ne_of_lt ha)⟩ :
      quadraticOrthogonalGroup Q) ∈ positiveConeStabilizer Q hpos t ht := by
  obtain ⟨u, hu, huPos⟩ := exists_formPairing_eq_zero_pos Q hpos ha
  have hfix : reflectIn Q a (ne_of_lt ha) u = u := formPairing_reflectIn_self Q (ne_of_lt ha) hu
  have hmem := reflectIn_mem_quadraticOrthogonalGroup Q (ne_of_lt ha)
  refine (mem_positiveConeStabilizer_iff Q hpos ht _).mpr ?_
  rcases image_upper_eq_upper_or_lower Q hpos ht hmem with h | h
  · exact h
  · exfalso
    have hneg : ¬ reflectIn Q a (ne_of_lt ha) '' positiveCone.upper Q t =
        positiveCone.upper Q t := by
      rw [h]
      exact (upper_ne_lower Q t ht).symm
    have hlow : reflectIn Q a (ne_of_lt ha) '' positiveCone.lower Q t = positiveCone.upper Q t := by
      rw [image_lower_eq Q hpos ht hmem, if_neg hneg]
    rcases mem_upper_or_mem_lower Q hpos ht huPos with hu' | hu'
    · have hmem' : u ∈ positiveCone.lower Q t := by
        rw [← h]
        exact ⟨u, hu', hfix⟩
      exact (Set.disjoint_left.mp (upper_disjoint_lower Q t)) hu' hmem'
    · have hmem' : u ∈ positiveCone.upper Q t := by
        rw [← hlow]
        exact ⟨u, hu', hfix⟩
      exact (Set.disjoint_left.mp (upper_disjoint_lower Q t)) hmem' hu'

/-- The reflections in the vectors of negative value, as a set of isometries. -/
def reflectionGenerators (Q : QuadraticForm ℝ V) : Set (quadraticOrthogonalGroup Q) :=
  {f | ∃ a : V, ∃ ha : Q a < 0,
    (⟨reflectIn Q a (ne_of_lt ha), reflectIn_mem_quadraticOrthogonalGroup Q (ne_of_lt ha)⟩ :
      quadraticOrthogonalGroup Q) = f}

/-- **The reflection group of a form of signature `(1, n)`**: the group generated by the
reflections in the vectors of negative value (the grade `Rt_r`, `r < 0`, of the root set). -/
noncomputable def realReflectionGroup (Q : QuadraticForm ℝ V) :
    Subgroup (quadraticOrthogonalGroup Q) :=
  Subgroup.closure (reflectionGenerators Q)

/-- **`W ≤ O⁺`.** -/
theorem realReflectionGroup_le_positiveConeStabilizer (Q : QuadraticForm ℝ V)
    (hpos : sigPos Q = 1) {t : V} (ht : 0 < Q t) :
    realReflectionGroup Q ≤ positiveConeStabilizer Q hpos t ht := by
  intro f hf
  induction hf using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      exact reflectIn_mem_positiveConeStabilizer Q hpos ht ha
  | one => exact one_mem _
  | mul x y hx hy ihx ihy => exact mul_mem ihx ihy
  | inv x hx ih => exact inv_mem ih

omit [FiniteDimensional ℝ V] in
/-- Conjugating a reflection by an isometry gives the reflection in the image vector. -/
theorem conj_reflectIn (Q : QuadraticForm ℝ V) {g : V ≃ₗ[ℝ] V}
    (hg : g ∈ quadraticOrthogonalGroup Q) {a : V} (ha : Q a ≠ 0) :
    (⟨g, hg⟩ * ⟨reflectIn Q a ha, reflectIn_mem_quadraticOrthogonalGroup Q ha⟩ *
        ⟨g, hg⟩⁻¹ : quadraticOrthogonalGroup Q) =
      ⟨reflectIn Q (g a) (by rw [hg a]; exact ha),
        reflectIn_mem_quadraticOrthogonalGroup Q (by rw [hg a]; exact ha)⟩ := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro y
  simp only [Subgroup.coe_mul, LinearEquiv.mul_apply, Subgroup.coe_inv, LinearEquiv.coe_inv,
    reflectIn_apply, map_sub, map_smul, LinearEquiv.apply_symm_apply, hg a]
  have hpair : formPairing Q ((g.symm : V ≃ₗ[ℝ] V) y) a = formPairing Q y (g a) := by
    have h := formPairing_map Q hg ((g.symm : V ≃ₗ[ℝ] V) y) a
    rw [show g ((g.symm : V ≃ₗ[ℝ] V) y) = y from LinearEquiv.apply_symm_apply g y] at h
    exact h.symm
  rw [hpair]

omit [FiniteDimensional ℝ V] in
/-- **`W ⊴ O(Q)`**: the reflection group is normal in the orthogonal group, because conjugation
carries the reflection in `a` to the reflection in `g a`, which is a vector of negative value. -/
theorem realReflectionGroup_normal (Q : QuadraticForm ℝ V) :
    (realReflectionGroup Q).Normal := by
  refine ⟨?_⟩
  intro f hf g
  induction hf using Subgroup.closure_induction with
  | one => simp
  | mul x y hx hy ihx ihy =>
      rw [show g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) by group]
      exact mul_mem ihx ihy
  | inv x hx ih =>
      rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
      exact inv_mem ih
  | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      rw [conj_reflectIn Q (g := (g : V ≃ₗ[ℝ] V)) g.2 (ne_of_lt ha)]
      exact Subgroup.subset_closure ⟨(g : V ≃ₗ[ℝ] V) a, by rw [g.2 a]; exact ha, rfl⟩

end Cone

end LeanCategories.Lattices.Valued

