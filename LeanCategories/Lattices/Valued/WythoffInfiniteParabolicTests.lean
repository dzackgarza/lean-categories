@[expose] public section

open Matrix

namespace LeanCategories.Lattices.Valued.WythoffWitness

noncomputable section

/-- The root space. -/
abbrev V : Type := Fin 3 → ℝ

/-! ### The reflection datum -/

/-- Gram matrix of the simple roots: the symmetric generalized Cartan matrix
`!![2, -2, -1; -2, 2, 0; -1, 0, 2]`.  Its leading principal minors are `2, 0, -2`, so the
form is nondegenerate of signature `(2,1)`; the off-diagonal entries are `≤ 0`, as a
generalized Cartan matrix requires. -/
def gram : Matrix (Fin 3) (Fin 3) ℝ := !![2, -2, -1; -2, 2, 0; -1, 0, 2]

/-- **The datum is in AET's sign convention.**  With the form `-gram` (which is the form used
in arXiv:1903.09742v3 before Definition 4.16) the simple roots have negative square
`r_k² = -2 < 0` and pairwise *nonnegative* products `r_k · r_k' ≥ 0`; the form is
nondegenerate (`det = 2`) of signature `(1,2)`, and the reflections
`x ↦ x - 2⟨x,r_k⟩ / ⟨r_k,r_k⟩ • r_k` of that form are the very same matrices `s0, s1, s2`
below (the formula is invariant under `gram ↦ -gram`).  Their integer entries make `W` a
discrete subgroup of `GL₃(ℤ)`. -/
theorem aet_sign_convention :
    (∀ i : Fin 3, (-gram) i i = -2) ∧ (∀ i j : Fin 3, i ≠ j → 0 ≤ (-gram) i j) ∧
      (-gram).det = 2 := by
  refine ⟨?_, ?_, ?_⟩
  · intro i; fin_cases i <;> simp [gram]
  · intro i j hij; fin_cases i <;> fin_cases j <;> simp_all [gram]
  · rw [Matrix.det_fin_three]; norm_num [gram]

/-- Reflection `s_0 (x) = x - ⟨x, α_0⟩ α_0` in the first (inactive) simple root. -/
def s0Mat : Matrix (Fin 3) (Fin 3) ℝ := !![-1, 2, 1; 0, 1, 0; 0, 0, 1]
/-- Reflection `s_1 (x) = x - ⟨x, α_1⟩ α_1` in the second (inactive) simple root. -/
def s1Mat : Matrix (Fin 3) (Fin 3) ℝ := !![1, 0, 0; 2, -1, 0; 0, 0, 1]
/-- Reflection `s_2 (x) = x - ⟨x, α_2⟩ α_2` in the third (active) simple root. -/
def s2Mat : Matrix (Fin 3) (Fin 3) ℝ := !![1, 0, 0; 0, 1, 0; 1, 0, -1]

/-- Each `s_i` is an isometry of the form: it is the reflection with `⟨α_i, α_i⟩ = 2`. -/
lemma s0Mat_isometry : s0Matᵀ * gram * s0Mat = gram := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [s0Mat, gram, Matrix.mul_apply, Fin.sum_univ_three] <;> norm_num

lemma s1Mat_isometry : s1Matᵀ * gram * s1Mat = gram := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [s1Mat, gram, Matrix.mul_apply, Fin.sum_univ_three] <;> norm_num

lemma s2Mat_isometry : s2Matᵀ * gram * s2Mat = gram := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [s2Mat, gram, Matrix.mul_apply, Fin.sum_univ_three] <;> norm_num

lemma s0Mat_mul_self : s0Mat * s0Mat = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [s0Mat, Matrix.mul_apply, Fin.sum_univ_three]

lemma s1Mat_mul_self : s1Mat * s1Mat = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [s1Mat, Matrix.mul_apply, Fin.sum_univ_three]

lemma s2Mat_mul_self : s2Mat * s2Mat = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [s2Mat, Matrix.mul_apply, Fin.sum_univ_three]

lemma s0Mat_det : s0Mat.det = -1 := by rw [Matrix.det_fin_three]; simp [s0Mat]
lemma s1Mat_det : s1Mat.det = -1 := by rw [Matrix.det_fin_three]; simp [s1Mat]
lemma s2Mat_det : s2Mat.det = -1 := by rw [Matrix.det_fin_three]; simp [s2Mat]

/-- The first simple reflection, as an element of `GL`. -/
def s0 : GL (Fin 3) ℝ :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero s0Mat (by rw [s0Mat_det]; norm_num)
/-- The second simple reflection, as an element of `GL`. -/
def s1 : GL (Fin 3) ℝ :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero s1Mat (by rw [s1Mat_det]; norm_num)
/-- The third (active) simple reflection, as an element of `GL`. -/
def s2 : GL (Fin 3) ℝ :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero s2Mat (by rw [s2Mat_det]; norm_num)

@[simp] lemma s0_val : ((s0 : GL (Fin 3) ℝ) : Matrix (Fin 3) (Fin 3) ℝ) = s0Mat := rfl
@[simp] lemma s1_val : ((s1 : GL (Fin 3) ℝ) : Matrix (Fin 3) (Fin 3) ℝ) = s1Mat := rfl
@[simp] lemma s2_val : ((s2 : GL (Fin 3) ℝ) : Matrix (Fin 3) (Fin 3) ℝ) = s2Mat := rfl

/-- The unipotent element `g = s_0 * s_1` of the inactive parabolic. -/
def g : GL (Fin 3) ℝ := s0 * s1

lemma g_val : ((g : GL (Fin 3) ℝ) : Matrix (Fin 3) (Fin 3) ℝ) =
    !![3, -2, 1; 2, -1, 0; 0, 0, 1] := by
  simp only [g, s0_val, s1_val, Units.val_mul, s0Mat, s1Mat]
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three] ; norm_num

/-- The standard parabolic (Weyl group) of the datum. -/
def W : Subgroup (GL (Fin 3) ℝ) := Subgroup.closure ({s0, s1, s2} : Set (GL (Fin 3) ℝ))

/-- The standard parabolic generated by the inactive simple reflections, AET's `W_J`. -/
def WJ : Subgroup (GL (Fin 3) ℝ) := Subgroup.closure ({s0, s1} : Set (GL (Fin 3) ℝ))

lemma g_mem_WJ : g ∈ WJ := by
  have h0 : s0 ∈ WJ := Subgroup.subset_closure (by simp)
  have h1 : s1 ∈ WJ := Subgroup.subset_closure (by simp)
  exact Subgroup.mul_mem WJ h0 h1

lemma WJ_le_W : WJ ≤ W := by
  apply Subgroup.closure_mono
  rintro u (rfl | rfl) <;> simp

/-! ### `W_J` is infinite -/

/-- The explicit `n`-th power of `g`. -/
def gpow (n : ℕ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![1 + 2 * n, -2 * n, (n : ℝ) ^ 2; 2 * n, 1 - 2 * n, (n : ℝ) ^ 2 - n; 0, 0, 1]

lemma g_mat_pow (n : ℕ) : ((g : GL (Fin 3) ℝ) : Matrix (Fin 3) (Fin 3) ℝ) ^ n = gpow n := by
  induction n with
  | zero => ext i j; fin_cases i <;> fin_cases j <;> simp [gpow]
  | succ n ih =>
    rw [pow_succ, ih, g_val]
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [gpow, Matrix.mul_apply, Fin.sum_univ_three] <;> ring

lemma g_gl_pow (n : ℕ) : (((g ^ n : GL (Fin 3) ℝ)) : Matrix (Fin 3) (Fin 3) ℝ) = gpow n := by
  rw [Units.val_pow_eq_pow_val, g_mat_pow]

lemma gpow_apply_01 (n : ℕ) : gpow n 0 1 = -2 * (n : ℝ) := by simp [gpow]

lemma g_pow_ne_one (n : ℕ) (hn : 1 ≤ n) : (g ^ n : GL (Fin 3) ℝ) ≠ 1 := by
  intro h
  have h2 := congrArg (fun u : GL (Fin 3) ℝ => ((u : Matrix (Fin 3) (Fin 3) ℝ)) 0 1) h
  rw [g_gl_pow, Units.val_one, gpow_apply_01] at h2
  simp only [Matrix.one_apply, Fin.isValue] at h2
  rw [ite_eq_right (by decide : ¬ (0 : Fin 3) = 1)] at h2
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  linarith

/-- **The inactive parabolic is infinite**: `¬ Finite (irrelevantReflectionSubgroup)` holds
here although the inactive index set `J = {0,1}` has two elements. -/
theorem not_finite_inactiveParabolic : ¬ Finite ↥WJ := by
  intro hfin
  have := hfin
  obtain ⟨n, hnpos, hn⟩ := (isOfFinOrder_of_finite (⟨g, g_mem_WJ⟩ : WJ)).exists_pow_eq_one
  have hn' : (g ^ n : GL (Fin 3) ℝ) = 1 := by
    have h := congrArg (Subtype.val) hn
    simpa using h
  exact g_pow_ne_one n hnpos hn'

/-- The same, as a set statement. -/
theorem infinite_WJ : (WJ : Set (GL (Fin 3) ℝ)).Infinite :=
  fun hf => not_finite_inactiveParabolic hf.to_subtype

/-! ### The chamber, the active functional and the generalized chamber -/

/-- The `i`-th simple-root functional `x ↦ ⟨α_i, x⟩`. -/
def phi (i : Fin 3) (x : V) : ℝ := ∑ j, gram i j * x j

/-- The closed fundamental chamber `K` of AET Definition 4.16. -/
def K : Set V := {x | 0 ≤ phi 0 x ∧ 0 ≤ phi 1 x ∧ 0 ≤ phi 2 x}

/-- The a priori inactive simple roots (AET's `J`). -/
def inactive : Finset (Fin 3) := {0, 1}

/-- The faces of the fundamental chamber, cut out by a set of simple-root mirrors. -/
def faceOf (S : Finset (Fin 3)) : Set V := {x | x ∈ K ∧ ∀ i ∈ S, phi i x = 0}

/-- A relevant face of `K` (AET Definition 4.16): a face not cut out by inactive mirrors
alone, i.e. whose mirror set meets the active simple roots. -/
def IsRelevant (S : Finset (Fin 3)) : Prop := ∃ i ∈ S, i ∉ inactive

/-- Action of `GL (Fin 3) ℝ` on the root space. -/
def sm (u : GL (Fin 3) ℝ) (x : V) : V := ((u : Matrix (Fin 3) (Fin 3) ℝ)) *ᵥ x

@[simp] lemma sm_one (x : V) : sm 1 x = x := by simp [sm]

lemma sm_mul (u v : GL (Fin 3) ℝ) (x : V) : sm (u * v) x = sm u (sm v x) := by
  simp only [sm, Units.val_mul, ← Matrix.mulVec_mulVec]

/-- The generalized chamber `L = ⋃_{h ∈ W_J} h(K)` of AET Definition 4.16. -/
def genChamber : Set V := ⋃ u ∈ (WJ : Set (GL (Fin 3) ℝ)), sm u '' K

/-- `W_J` lies in the setwise stabiliser of `L` (AET Proposition 4.17(2)). -/
theorem genChamber_smul (u : GL (Fin 3) ℝ) (hu : u ∈ WJ) : sm u '' genChamber = genChamber := by
  have key : ∀ v ∈ WJ, u * v ∈ WJ := fun v hv => Subgroup.mul_mem WJ hu hv
  ext x
  simp only [genChamber, Set.mem_image, Set.mem_iUnion, exists_prop]
  constructor
  · rintro ⟨y, ⟨v, hv, z, hz, hzy⟩, hxy⟩
    exact ⟨u * v, key v hv, z, hz, by rw [sm_mul, hzy, hxy]⟩
  · rintro ⟨v, hv, z, hz, hxz⟩
    exact ⟨sm (u⁻¹ * v) z, ⟨u⁻¹ * v, mul_mem (inv_mem hu) hv, z, hz, rfl⟩,
      by rw [← sm_mul, mul_inv_cancel_left, hxz]⟩

/-- Nonnegativity of every simple-root functional on the chamber. -/
lemma K_nonneg {x : V} (hx : x ∈ K) (i : Fin 3) : 0 ≤ phi i x := by
  obtain ⟨h0, h1, h2⟩ := hx
  fin_cases i
  · exact h0
  · exact h1
  · exact h2

/-- `K` is contained in the generalized chamber `L = ⋃_{h ∈ W_J} h(K)`. -/
theorem K_subset_genChamber : K ⊆ genChamber := by
  intro x hx
  simp only [genChamber, Set.mem_iUnion, Set.mem_image, exists_prop]
  exact ⟨1, one_mem WJ, x, hx, sm_one x⟩

/-- Each `faceOf S` is a face of the cone `K`: a sum of two chamber points that lies on the
mirrors of `S` forces both summands to lie on them, because every functional is nonnegative
on `K`.  Thus `faceOf S` is a genuine face of the fundamental chamber and its `W`-translates
are cones of the Wythoff semifan of AET Definition 4.16. -/
theorem faceOf_isFace (S : Finset (Fin 3)) {x y : V} (hx : x ∈ K) (hy : y ∈ K)
    (hxy : x + y ∈ faceOf S) : x ∈ faceOf S ∧ y ∈ faceOf S := by
  obtain ⟨-, hS⟩ := hxy
  have key : ∀ i ∈ S, phi i x = 0 ∧ phi i y = 0 := by
    intro i hi
    have hsum : phi i (x + y) = 0 := hS i hi
    have hadd : phi i (x + y) = phi i x + phi i y := by
      simp only [phi, Pi.add_apply, mul_add, Finset.sum_add_distrib]
    have hxi := K_nonneg hx i
    have hyi := K_nonneg hy i
    constructor <;> linarith
  exact ⟨⟨hx, fun i hi => (key i hi).1⟩, ⟨hy, fun i hi => (key i hi).2⟩⟩

/-- Every `W_J`-translate of a chamber point lies in the generalized chamber. -/
lemma sm_mem_genChamber {u : GL (Fin 3) ℝ} (hu : u ∈ WJ) {x : V} (hx : x ∈ K) :
    sm u x ∈ genChamber := by
  simp only [genChamber, Set.mem_iUnion, Set.mem_image, exists_prop]
  exact ⟨u, hu, x, hx, rfl⟩

/-- **Infinite stabiliser** (AET's remark after Proposition 4.17): the setwise stabiliser of
`L` in `GL (Fin 3) ℝ` is infinite. -/
theorem infinite_stabilizer :
    Set.Infinite {u : GL (Fin 3) ℝ | sm u '' genChamber = genChamber} := by
  exact Set.Infinite.mono (fun u hu => genChamber_smul u hu) infinite_WJ

/-! ### The AET semifan of the datum has infinitely many cones -/

/-- The cone family of the Wythoff semifan of AET Definition 4.16: the `W`-translates of the
generalized chamber together with the `W`-translates of the relevant faces of `K`. -/
def SemifanCones : Set (Set V) :=
  {D | (∃ u ∈ W, D = sm u '' genChamber) ∨
    (∃ (u : GL (Fin 3) ℝ) (S : Finset (Fin 3)), u ∈ W ∧ IsRelevant S ∧ D = sm u '' faceOf S)}

/-- The active facet `F = K ∩ {φ_2 = 0}` of `K` is a relevant face. -/
lemma activeFace_isRelevant : IsRelevant {2} :=
  ⟨2, by simp, by decide⟩

/-- A rational interior point of the active facet: `φ_0 p = 1/2`, `φ_1 p = 1/2`,
`φ_2 p = 0`. -/
def p0 : V := ![-2, -7 / 4, -1]

lemma p0_mem_K : p0 ∈ K := by
  refine ⟨?_, ?_, ?_⟩ <;> simp [phi, gram, p0, Fin.sum_univ_three] <;> norm_num

lemma p0_phi2 : phi 2 p0 = 0 := by simp [phi, gram, p0, Fin.sum_univ_three]

lemma p0_mem_face : p0 ∈ faceOf {2} := by
  refine ⟨p0_mem_K, ?_⟩
  intro i hi
  have : i = 2 := by simpa using hi
  subst this
  exact p0_phi2

/-- The test points `g^n p0` lie in the generalized chamber, one in each of the distinct
semifan cones `g^n · F`. -/
lemma gpow_p0_mem_genChamber (n : ℕ) :
    sm (g ^ n : GL (Fin 3) ℝ) p0 ∈ genChamber :=
  sm_mem_genChamber (Subgroup.pow_mem WJ g_mem_WJ n) p0_mem_K

lemma phi2_gpow_p0 (n : ℕ) : phi 2 (gpow n *ᵥ p0) = (n : ℝ) ^ 2 + n / 2 := by
  simp [phi, gram, gpow, p0, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
  ring

lemma phi2_gpow_ne_zero (n : ℕ) (hn : 1 ≤ n) : phi 2 (gpow n *ᵥ p0) ≠ 0 := by
  rw [phi2_gpow_p0]
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  nlinarith

lemma phi2_sm_gpow (n : ℕ) (x : V) : phi 2 (sm (g ^ n : GL (Fin 3) ℝ) x) =
    phi 2 (gpow n *ᵥ x) := by
  simp only [sm, g_gl_pow]

/-- Powers of `g` inside the group: `(g^i)⁻¹ * g^j = g^(j-i)` for `i ≤ j`. -/
lemma inv_pow_mul_pow {i j : ℕ} (hij : i ≤ j) :
    (g ^ i : GL (Fin 3) ℝ)⁻¹ * g ^ j = g ^ (j - i) := by
  have h : (g ^ j : GL (Fin 3) ℝ) = g ^ i * g ^ (j - i) := by
    rw [← pow_add, Nat.add_sub_cancel' hij]
  rw [h, inv_mul_cancel_left]

/-- **The `W`-orbit of the active facet is infinite**: the cones `g^i · F` are pairwise
distinct, since `g^j · F` lies in the mirror of `g^{-j}φ_2` but not in that of `g^{-i}φ_2`
for `i < j` (the test point `p0 = (-2, -7/4, -1)` of the active facet satisfies
`φ_2 (g^k p0) = k² + k/2`). -/
theorem cones_pairwise_distinct {i j : ℕ} (hij : i < j) :
    sm (g ^ i : GL (Fin 3) ℝ) '' faceOf {2} ≠ sm (g ^ j : GL (Fin 3) ℝ) '' faceOf {2} := by
  intro heq
  have hmem : sm (g ^ j : GL (Fin 3) ℝ) p0 ∈ sm (g ^ i : GL (Fin 3) ℝ) '' faceOf {2} := by
    rw [heq]
    exact Set.mem_image_of_mem _ p0_mem_face
  obtain ⟨y, hy, hxy⟩ := hmem
  have hyphi : phi 2 y = 0 := hy.2 2 (by simp)
  -- applying `sm (g^i)⁻¹` to `sm (g^i) y = sm (g^j) p0`
  have h1 : sm (((g ^ i : GL (Fin 3) ℝ))⁻¹) (sm (g ^ i : GL (Fin 3) ℝ) y)
      = sm (((g ^ i : GL (Fin 3) ℝ))⁻¹) (sm (g ^ j : GL (Fin 3) ℝ) p0) := by
    rw [← hxy]
  rw [← sm_mul, inv_mul_cancel, sm_one, ← sm_mul, inv_pow_mul_pow hij.le] at h1
  have h2 : phi 2 (sm (g ^ (j - i) : GL (Fin 3) ℝ) p0) = 0 := by
    rw [← h1]
    exact hyphi
  rw [phi2_sm_gpow] at h2
  exact phi2_gpow_ne_zero (j - i) (by omega) h2

lemma cones_injective : Function.Injective
    (fun n : ℕ => sm (g ^ n : GL (Fin 3) ℝ) '' faceOf {2}) := by
  intro i j hij
  rcases lt_trichotomy i j with h | h | h
  · exact absurd hij (cones_pairwise_distinct h)
  · exact h
  · exact absurd hij.symm (cones_pairwise_distinct h)

/-- **The AET semifan of this datum has infinitely many cones.** -/
theorem not_finite_SemifanCones : ¬ Set.Finite SemifanCones := by
  intro hfin
  have hinf : (Set.range fun n : ℕ => sm (g ^ n : GL (Fin 3) ℝ) '' faceOf {2}).Infinite :=
    Set.infinite_range_of_injective cones_injective
  refine hinf (hfin.subset ?_)
  rintro D ⟨n, rfl⟩
  refine Or.inr ⟨g ^ n, {2}, ?_, activeFace_isRelevant, rfl⟩
  exact WJ_le_W (Subgroup.pow_mem WJ g_mem_WJ n)

/-- **No finite cone family can be the AET semifan of this datum.**  In particular no `Fan`
in the sense of `LeanCategories/Lattices/Valued/RationalPolyhedralCone.lean`, whose cone
family is a `Finset`, can carry it. -/
theorem no_finiteConeFamily (t : Finset (Set V)) : (t : Set (Set V)) ≠ SemifanCones := by
  intro h
  exact not_finite_SemifanCones (h ▸ t.finite_toSet)

/-- The active linear forms `φ_2 ∘ g^n` are pairwise distinct, so the active half-space
description of AET Proposition 4.17(1) is an infinite intersection in this example. -/
theorem infinite_activeForms :
    Set.Infinite (Set.range fun n : ℕ => fun x : V => phi 2 (sm (g ^ n : GL (Fin 3) ℝ) x)) := by
  apply Set.infinite_range_of_injective
  intro i j hij
  have h := congrArg (fun f : V → ℝ => f p0) hij
  simp only [phi2_sm_gpow, phi2_gpow_p0] at h
  have h' : ((i : ℝ) - (j : ℝ)) * ((i : ℝ) + (j : ℝ) + 1 / 2) = 0 := by
    nlinarith
  rcases mul_eq_zero.mp h' with h1 | h1
  · have : (i : ℝ) = j := by linarith
    exact_mod_cast this
  · have : (0 : ℝ) ≤ (i : ℝ) + (j : ℝ) := by positivity
    nlinarith

end

