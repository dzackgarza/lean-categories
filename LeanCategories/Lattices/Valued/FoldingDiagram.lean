@[expose] public section

open QuadraticMap
open LeanCategories.Modules.Bilinear.Valued

namespace LeanCategories.Lattices.Valued

variable {L : FiniteProjectiveLatticeCat ℤ ℤ}

/-! ## The diagram involution -/

/-- **A global isometry acts on a root family through a permutation of its index set.** This is the
"diagram involution" of AEGS §3.8: the automorphism of the Coxeter diagram of the root family that
the involution of the lattice induces. -/
def ActsThrough (g : OrthogonalGroup L.obj) {ι : Type*} (r : ι → L.obj.obj.carrier)
    (π : ι → ι) : Prop :=
  ∀ i, g.1 (r i) = r (π i)

/-- A diagram involution is an involution of the index set: `π ∘ π = id`, from `g * g = 1` and the
injectivity of the root family. -/
theorem actsThrough_involutive (g : OrthogonalGroup L.obj) (hg : g * g = 1)
    {ι : Type*} {r : ι → L.obj.obj.carrier} (hr : Function.Injective r) {π : ι → ι}
    (h : ActsThrough g r π) : ∀ i, π (π i) = i := by
  intro i
  apply hr
  rw [← h (π i), ← h i, isometry_apply_apply g hg]

/-- The diagram involution preserves the pairing of two roots. -/
theorem actsThrough_pairing (g : OrthogonalGroup L.obj) {ι : Type*}
    {r : ι → L.obj.obj.carrier} {π : ι → ι} (h : ActsThrough g r π) (i j : ι) :
    L.obj.obj.pairing (r (π i)) (r (π j)) = L.obj.obj.pairing (r i) (r j) := by
  rw [← h i, ← h j]
  exact g.property (r i) (r j)

/-- **A diagram involution preserves the edge weights of the Coxeter diagram**: the normalized
pairing square of a pair of roots is unchanged by `π`. -/
theorem actsThrough_edges (g : OrthogonalGroup L.obj) {ι : Type*}
    {r : ι → L.obj.obj.carrier} {π : ι → ι} (h : ActsThrough g r π) (i j : ι) :
    coxeterDiagramOfRootsEdges L r (π i) (π j) = coxeterDiagramOfRootsEdges L r i j := by
  simp only [coxeterDiagramOfRootsEdges, actsThrough_pairing g h i j,
    actsThrough_pairing g h i i, actsThrough_pairing g h j j]

/-- The folded vector is constant on the orbits of the diagram involution: the folded diagram has
one vertex per orbit, not one per root. -/
theorem actsThrough_foldedVector_eq (g : OrthogonalGroup L.obj) (hg : g * g = 1)
    {ι : Type*} {r : ι → L.obj.obj.carrier} {π : ι → ι} (h : ActsThrough g r π) (i : ι) :
    foldedVector g (r (π i)) = foldedVector g (r i) := by
  rw [← h i]
  exact foldedVector_invariant g hg (r i)

/-- **The folded diagram is invariant under the diagram involution.** -/
theorem foldedCoxeterDiagram_edges_actsThrough (g : OrthogonalGroup L.obj) {ι : Type*}
    (r : ι → L.obj.obj.carrier)
    (hr : ∀ i, L.obj.obj.pairing (foldedRootFamily g r i) (foldedRootFamily g r i) < 0)
    {π : ι → ι} (hπ : ∀ i, foldedRootFamily g r (π i) = foldedRootFamily g r i) (i j : ι) :
    (foldedCoxeterDiagram g r hr).edges (π i) (π j) =
      (foldedCoxeterDiagram g r hr).edges i j := by
  change coxeterDiagramOfRootsEdges L (foldedRootFamily g r) (π i) (π j) =
    coxeterDiagramOfRootsEdges L (foldedRootFamily g r) i j
  simp only [coxeterDiagramOfRootsEdges, hπ i, hπ j]

/-! ## The walls of the folded chamber -/

/-- **The mirror of the fold is the mirror**, in the invariant part `M^σ ⊗ ℝ` of the real form.
This is the sentence of AEGS Lemma 3.8's proof: "the intersection of the positive cone `C(T_En)`
with `α^⊥` is the same as with `α_J^⊥`". -/
theorem rootMirror_folded_inter_fixed (g : OrthogonalGroup L.obj) (y : L.obj.obj.carrier) :
    rootMirror L (foldedVector g y) ∩ (realFormFixedPart g : Set (realForm L).obj.carrier) =
      rootMirror L y ∩ (realFormFixedPart g : Set (realForm L).obj.carrier) := by
  ext z
  constructor
  · rintro ⟨hz, hz'⟩
    exact ⟨(mem_rootMirror_iff (L := L) (r := y) (x := z)).mpr
      ((realForm_pairing_folded_eq_zero_iff_part g hz' y).mp
        ((mem_rootMirror_iff (L := L) (r := foldedVector g y) (x := z)).mp hz)), hz'⟩
  · rintro ⟨hz, hz'⟩
    exact ⟨(mem_rootMirror_iff (L := L) (r := foldedVector g y) (x := z)).mpr
      ((realForm_pairing_folded_eq_zero_iff_part g hz' y).mpr
        ((mem_rootMirror_iff (L := L) (r := y) (x := z)).mp hz)), hz'⟩

/-- **The wall of the folded chamber is the trace of the wall**: in the invariant part `M^σ ⊗ ℝ` of
the real form, the mirror section of a folded root in the cone of the folded root set is the mirror
section of the root in the cone of the root set. -/
theorem rootMirrorCone_folded_iff (g : OrthogonalGroup L.obj)
    (R : Set L.obj.obj.carrier) (y : L.obj.obj.carrier)
    {z : (realForm L).obj.carrier} (hz : z ∈ realFormFixedPart g) :
    z ∈ rootMirrorCone L (foldedRootImage g R) (foldedVector g y) ↔
      z ∈ rootMirrorCone L R y := by
  rw [mem_rootMirrorCone, mem_rootMirrorCone]
  constructor
  · rintro ⟨h0, hnn⟩
    refine ⟨(realForm_pairing_folded_eq_zero_iff_part g hz y).mp h0, ?_⟩
    intro s hs
    exact (realForm_pairing_folded_nonneg_iff_part g hz s).mp (hnn (foldedVector g s) ⟨s, hs, rfl⟩)
  · rintro ⟨h0, hnn⟩
    refine ⟨(realForm_pairing_folded_eq_zero_iff_part g hz y).mpr h0, ?_⟩
    intro s hs
    obtain ⟨w, hw, rfl⟩ := hs
    exact (realForm_pairing_folded_nonneg_iff_part g hz w).mpr (hnn w hw)

/-- **Folding a chamber along an involution** (AEGS Lemma 3.8). Let `R` be the wall set of a chamber
of `W(M)` (`IsChamberWithWalls`, `#23`) and `σ` an involution of `M`. Then, inside the invariant
part `M^σ ⊗ ℝ` of the real form:

* the folded roots cut out exactly the trace of the chamber, and
* every wall of the trace is the trace of a wall: the mirror section of the folded root is the
  mirror section of the root, so the folded root set is the wall set of `C^J = C ∩ M^σ ⊗ ℝ`.

The reflections in the folded roots are those of the invariant lattice; their classification is
AEGS Lemma 3.4 and is not part of this statement (see the module docstring). -/
theorem chamberOf_folded_trace_walls (g : OrthogonalGroup L.obj)
    (t : (realForm L).obj.carrier) (hpos : (integralSignature L).1 = 1)
    (ht : 0 < realFormQuadratic L t) (R : Set L.obj.obj.carrier)
    (hR : IsChamberWithWalls L t R)
    {v : L.obj.obj.carrier} (hv : toRealForm L v ∈ rootInteriorCone L t R) :
    chamberOf L t (toRealForm L v) ∩ (realFormFixedPart g : Set (realForm L).obj.carrier) =
        rootInteriorCone L t (foldedRootImage g R) ∩
          (realFormFixedPart g : Set (realForm L).obj.carrier) ∧
      ∀ y ∈ R, ∀ z ∈ realFormFixedPart g,
        (z ∈ rootMirrorCone L (foldedRootImage g R) (foldedVector g y) ↔
          z ∈ rootMirrorCone L R y) :=
  ⟨chamberOf_folded_trace g t hpos ht hR hv, fun y _ _ hz =>
    rootMirrorCone_folded_iff g R y hz⟩

/-! ## The worked folded diagram: the `E₈` block of `T_dP` folds to `E₈(2)`

AEGS Lemma 3.9, in the block model of `FoldingEnriques.lean`: the eight `E₈` simple roots of the
first `E₈` summand are roots of `T_dP` orthogonal to their images under `I = -I_En`, so each folds
to a root of the invariant sublattice, and the folded diagram is `E₈(2)`. -/

/-- A block vector of `T_dP` supported on the first `E₈` summand. -/
def tdpFirstE8Block (x : Fin 8 → ℤ) : TdpIndex → ℤ :=
  Sum.elim (fun _ => 0) (Sum.elim x (fun _ => 0))

/-- A block vector of `T_dP` supported on the second `E₈` summand. -/
def tdpSecondE8Block (y : Fin 8 → ℤ) : TdpIndex → ℤ :=
  Sum.elim (fun _ => 0) (Sum.elim (fun _ => 0) y)

@[simp] theorem tdpFirstE8Block_inl (x : Fin 8 → ℤ) (c : Fin 2 ⊕ Fin 2) :
    tdpFirstE8Block x (Sum.inl c) = 0 := rfl

@[simp] theorem tdpFirstE8Block_inr_inl (x : Fin 8 → ℤ) (j : Fin 8) :
    tdpFirstE8Block x (Sum.inr (Sum.inl j)) = x j := rfl

@[simp] theorem tdpFirstE8Block_inr_inr (x : Fin 8 → ℤ) (j : Fin 8) :
    tdpFirstE8Block x (Sum.inr (Sum.inr j)) = 0 := rfl

@[simp] theorem tdpSecondE8Block_inl (y : Fin 8 → ℤ) (c : Fin 2 ⊕ Fin 2) :
    tdpSecondE8Block y (Sum.inl c) = 0 := rfl

@[simp] theorem tdpSecondE8Block_inr_inl (y : Fin 8 → ℤ) (j : Fin 8) :
    tdpSecondE8Block y (Sum.inr (Sum.inl j)) = 0 := rfl

@[simp] theorem tdpSecondE8Block_inr_inr (y : Fin 8 → ℤ) (j : Fin 8) :
    tdpSecondE8Block y (Sum.inr (Sum.inr j)) = y j := rfl

theorem tdpBlock_pairing_first_first (x y : Fin 8 → ℤ) :
    tdpFiniteLattice.obj.obj.pairing (tdpFirstE8Block x) (tdpFirstE8Block y)
      = Matrix.toBilin' e8GramMatrix x y := by
  change Matrix.toBilin' tdpBlockGram (tdpFirstE8Block x) (tdpFirstE8Block y)
    = Matrix.toBilin' e8GramMatrix x y
  rw [tdpBlockGram, toBilin'_fromBlocks_zero_apply]
  have hleft : Matrix.toBilin' tdpU2Gram (fun c => tdpFirstE8Block x (Sum.inl c))
      (fun c => tdpFirstE8Block y (Sum.inl c)) = 0 := by
    simp [Matrix.toBilin'_apply]
  rw [hleft, zero_add, tdpE8Gram, toBilin'_fromBlocks_zero_apply]
  have hright : Matrix.toBilin' e8GramMatrix
      (fun k => tdpFirstE8Block x (Sum.inr (Sum.inr k)))
      (fun k => tdpFirstE8Block y (Sum.inr (Sum.inr k))) = 0 := by
    simp [Matrix.toBilin'_apply]
  rw [hright, add_zero]
  rfl

theorem tdpBlock_pairing_second_second (x y : Fin 8 → ℤ) :
    tdpFiniteLattice.obj.obj.pairing (tdpSecondE8Block x) (tdpSecondE8Block y)
      = Matrix.toBilin' e8GramMatrix x y := by
  change Matrix.toBilin' tdpBlockGram (tdpSecondE8Block x) (tdpSecondE8Block y)
    = Matrix.toBilin' e8GramMatrix x y
  rw [tdpBlockGram, toBilin'_fromBlocks_zero_apply]
  have hleft : Matrix.toBilin' tdpU2Gram (fun c => tdpSecondE8Block x (Sum.inl c))
      (fun c => tdpSecondE8Block y (Sum.inl c)) = 0 := by
    simp [Matrix.toBilin'_apply]
  rw [hleft, zero_add, tdpE8Gram, toBilin'_fromBlocks_zero_apply]
  have hright : Matrix.toBilin' e8GramMatrix
      (fun k => tdpSecondE8Block x (Sum.inr (Sum.inl k)))
      (fun k => tdpSecondE8Block y (Sum.inr (Sum.inl k))) = 0 := by
    simp [Matrix.toBilin'_apply]
  rw [hright, zero_add]
  rfl

theorem tdpBlock_pairing_first_second (x y : Fin 8 → ℤ) :
    tdpFiniteLattice.obj.obj.pairing (tdpFirstE8Block x) (tdpSecondE8Block y) = 0 := by
  change Matrix.toBilin' tdpBlockGram (tdpFirstE8Block x) (tdpSecondE8Block y) = 0
  rw [tdpBlockGram, toBilin'_fromBlocks_zero_apply, tdpE8Gram,
    toBilin'_fromBlocks_zero_apply]
  simp [Matrix.toBilin'_apply]

theorem tdpBlock_pairing_second_first (x y : Fin 8 → ℤ) :
    tdpFiniteLattice.obj.obj.pairing (tdpSecondE8Block x) (tdpFirstE8Block y) = 0 := by
  change Matrix.toBilin' tdpBlockGram (tdpSecondE8Block x) (tdpFirstE8Block y) = 0
  rw [tdpBlockGram, toBilin'_fromBlocks_zero_apply, tdpE8Gram,
    toBilin'_fromBlocks_zero_apply]
  simp [Matrix.toBilin'_apply]

/-- The standard basis vector of the `E₈` coordinate lattice. -/
def e8Basis (i : Fin 8) : Fin 8 → ℤ := Pi.single i (1 : ℤ)

theorem e8Basis_pairing (i j : Fin 8) :
    Matrix.toBilin' e8GramMatrix (e8Basis i) (e8Basis j) = e8GramMatrix i j := by
  change Matrix.toBilin' e8GramMatrix (Pi.single i (1 : ℤ)) (Pi.single j (1 : ℤ))
    = e8GramMatrix i j
  rw [Matrix.toBilin'_single]

theorem e8Basis_neg_pairing (i j : Fin 8) :
    Matrix.toBilin' e8GramMatrix (fun k => -e8Basis i k) (fun k => -e8Basis j k)
      = e8GramMatrix i j := by
  rw [show (fun k => -e8Basis i k) = -e8Basis i from rfl,
    show (fun k => -e8Basis j k) = -e8Basis j from rfl,
    toBilin'_neg_left, toBilin'_neg_right, e8Basis_pairing]
  ring

/-- The `i`-th simple root of the first `E₈` summand of `T_dP`. -/
def tdpE8Root (i : Fin 8) : tdpFiniteLattice.obj.obj.carrier := tdpFirstE8Block (e8Basis i)

/-- Its image under `I = -I_En`: the `i`-th simple root of the second `E₈` summand, negated. -/
def tdpE8RootImage (i : Fin 8) : tdpFiniteLattice.obj.obj.carrier :=
  tdpSecondE8Block (fun j => -e8Basis i j)

@[simp] theorem tdpE8Root_inl (i : Fin 8) (c : Fin 2 ⊕ Fin 2) :
    tdpE8Root i (Sum.inl c) = 0 := rfl

@[simp] theorem tdpE8Root_inr_inl (i j : Fin 8) :
    tdpE8Root i (Sum.inr (Sum.inl j)) = e8Basis i j := rfl

@[simp] theorem tdpE8Root_inr_inr (i j : Fin 8) :
    tdpE8Root i (Sum.inr (Sum.inr j)) = 0 := rfl

theorem tdpSwapSign_tdpE8Root (i : Fin 8) : tdpSwapSign (tdpE8Root i) = tdpE8RootImage i := by
  funext c
  rcases c with c | j | j <;> simp [tdpE8Root, tdpE8RootImage]

theorem tdpIsometry_tdpE8Root (i : Fin 8) :
    tdpIsometry.1 (tdpE8Root i) = tdpE8RootImage i :=
  tdpSwapSign_tdpE8Root i

theorem tdpE8Root_square (i : Fin 8) :
    tdpFiniteLattice.obj.obj.pairing (tdpE8Root i) (tdpE8Root i) = -2 := by
  rw [tdpE8Root, tdpBlock_pairing_first_first, e8Basis_pairing, e8GramMatrix_eq]
  fin_cases i <;> decide

theorem tdpE8RootImage_square (i : Fin 8) :
    tdpFiniteLattice.obj.obj.pairing (tdpE8RootImage i) (tdpE8RootImage i) = -2 := by
  rw [tdpE8RootImage, tdpBlock_pairing_second_second, e8Basis_neg_pairing, e8GramMatrix_eq]
  fin_cases i <;> decide

theorem tdpE8Root_pairing_image (i : Fin 8) :
    tdpFiniteLattice.obj.obj.pairing (tdpE8Root i) (tdpE8RootImage i) = 0 := by
  rw [tdpE8Root, tdpE8RootImage, tdpBlock_pairing_first_second]

/-- The image of a first-`E₈` simple root is not the root itself, so it folds. -/
theorem tdpE8Root_not_fixed (i : Fin 8) :
    tdpIsometry.1 (tdpE8Root i) ≠ tdpE8Root i := by
  intro h
  have h' : tdpE8RootImage i = tdpE8Root i := by
    rw [← tdpIsometry_tdpE8Root]
    exact h
  have hc := congrFun h' (Sum.inr (Sum.inr i))
  simp [tdpE8RootImage, e8Basis] at hc

/-- **The fold of an `E₈` simple root has square `-4`** — the arithmetic of AEGS Lemma 3.4,
case (3), for the worked instance. -/
theorem tdpFoldedE8Root_square (i : Fin 8) :
    tdpFiniteLattice.obj.obj.pairing (foldedVector tdpIsometry (tdpE8Root i))
        (foldedVector tdpIsometry (tdpE8Root i)) = -4 := by
  rw [pairing_folded_self_of_not_fixed tdpIsometry (tdpE8Root_not_fixed i),
    tdpE8Root_square i, tdpIsometry_tdpE8Root i, tdpE8Root_pairing_image i]
  norm_num

/-- The fold lands in the invariant sublattice `T_En = T_dP^{I=1}`. -/
theorem tdpFoldedE8Root_mem_fixed (i : Fin 8) :
    foldedVector tdpIsometry (tdpE8Root i) ∈
      involutionFixedSubmodule (L := tdpFiniteLattice) tdpIsometry :=
  foldedVector_mem_fixed tdpIsometry tdpIsometry_mul_self (tdpE8Root i)

theorem tdpFoldedE8Root_pairing (i j : Fin 8) :
    tdpFiniteLattice.obj.obj.pairing (foldedVector tdpIsometry (tdpE8Root i))
        (foldedVector tdpIsometry (tdpE8Root j))
      = 2 * e8GramMatrix i j := by
  rw [pairing_folded_folded_of_not_fixed tdpIsometry tdpIsometry_mul_self
    (tdpE8Root_not_fixed i) (tdpE8Root_not_fixed j)]
  rw [show tdpFiniteLattice.obj.obj.pairing (tdpE8Root i) (tdpIsometry.1 (tdpE8Root j)) = 0 from by
    rw [tdpIsometry_tdpE8Root j, tdpE8Root, tdpE8RootImage, tdpBlock_pairing_first_second]]
  rw [tdpE8Root, tdpE8Root, tdpBlock_pairing_first_first, e8Basis_pairing]
  ring

/-- **The folded diagram of the `E₈` block** (AEGS Lemma 3.9's `E₈(2)`, in block form): the eight
folded simple roots are the vertices, and the edge weight between two of them is the normalized
pairing square `(e_ij)² / 4` of the `E₈` Gram matrix — `1/4` on the seven `E₈` edges. -/
theorem tdpFoldedE8Diagram_edges (i j : Fin 8) :
    coxeterDiagramOfRootsEdges tdpFiniteLattice
        (foldedRootFamily tdpIsometry tdpE8Root) i j
      = (e8GramMatrix i j : ℚ) ^ 2 / 4 := by
  simp only [coxeterDiagramOfRootsEdges, foldedRootFamily, tdpFoldedE8Root_pairing i j,
    tdpFoldedE8Root_square i, tdpFoldedE8Root_square j]
  push_cast
  ring

/-- The diagonal weight of the folded diagram is `1`: the folded roots all have the same square,
`-4`, which is what makes `E₈(2)` a *simply-laced* diagram with all edge weights `1/4`. -/
theorem tdpFoldedE8Diagram_edges_self (i : Fin 8) :
    coxeterDiagramOfRootsEdges tdpFiniteLattice
        (foldedRootFamily tdpIsometry tdpE8Root) i i = 1 := by
  rw [tdpFoldedE8Diagram_edges, e8GramMatrix_eq]
  fin_cases i <;> norm_num

/-- **An `E₈` edge has folded weight `1/4`**: the folded diagram is `E₈` with every edge weight
`1/4`, i.e. `E₈(2)`. -/
theorem tdpFoldedE8Diagram_edges_adjacent :
    coxeterDiagramOfRootsEdges tdpFiniteLattice
        (foldedRootFamily tdpIsometry tdpE8Root) 2 3 = 1 / 4 := by
  rw [tdpFoldedE8Diagram_edges, e8GramMatrix_eq]
  norm_num

end LeanCategories.Lattices.Valued
