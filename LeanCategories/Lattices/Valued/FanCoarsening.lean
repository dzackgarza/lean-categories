@[expose] public section

namespace LeanCategories.Lattices.Valued

universe u v

open PointedCone CategoryTheory

variable {N : Type u} [AddCommGroup N] {V : Type v} [AddCommGroup V] [Module ℚ V]

/-! ## Folding data -/

/-- The folding data of #23 as the coarsening of a fan consumes it: a finite group of `ℚ`-linear
automorphisms of the ambient space, each of which is induced by an endomorphism of the ambient
lattice. The lattice lifts are what makes the coarsening rational (`isLatticeRational_orbitJoin`);
no property of the coarsening is recorded here. -/
structure FoldingData (i : N →+ V) where
  /-- The folding group. -/
  group : Subgroup (V ≃ₗ[ℚ] V)
  /-- Folding data is finite: the group is a finite type. -/
  fintype : Fintype group
  /-- Every folding automorphism is induced by an endomorphism of the lattice. -/
  induced : ∀ g ∈ group, {e : N →+ N // ∀ n, g (i n) = i (e n)}

/-- Pushing a linear map through a finite supremum of pointed cones. -/
theorem pointedCone_map_finset_sup {ι : Type*} (s : Finset ι) (f : ι → PointedCone ℚ V)
    (k : V →ₗ[ℚ] V) :
    (s.sup f).map k = s.sup fun g => (f g).map k := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.sup_empty, Finset.sup_empty, PointedCone.map, Submodule.map_bot]
  | insert a s ha ih =>
    rw [Finset.sup_insert, Finset.sup_insert]
    have h : (f a ⊔ s.sup f).map k = (f a).map k ⊔ (s.sup f).map k := by
      rw [PointedCone.map, Submodule.map_sup]
      rfl
    rw [h, ih]

/-- Monotonicity of the image of a pointed cone under a linear map. -/
theorem pointedCone_map_mono {C D : PointedCone ℚ V} (h : C ≤ D) (k : V →ₗ[ℚ] V) :
    C.map k ≤ D.map k := by
  intro x hx
  obtain ⟨y, hy, rfl⟩ := hx
  exact ⟨y, h hy, rfl⟩

namespace FoldingData

variable {i : N →+ V} (F : FoldingData i)

instance instFintype : Fintype F.group := F.fintype

/-- The character of the folding group as a finite set, for the joins below. -/
noncomputable def finset : Finset F.group := Finset.univ

@[simp] theorem mem_finset (g : F.group) : g ∈ F.finset := Finset.mem_univ g

/-- The trivial folding: the coarsening by no symmetry at all. It is the unit of the coarsening
operation (`orbitJoin_trivial`), and it is what makes the coarsening theorems non-vacuous. -/
def trivialFolding (i : N →+ V) : FoldingData i where
  group := ⊥
  fintype :=
    { elems := {⟨1, Subgroup.one_mem ⊥⟩}
      complete := fun g => by
        rw [Finset.mem_singleton]
        exact Subtype.ext (Subgroup.mem_bot.mp g.2) }
  induced := fun g hg => ⟨AddMonoidHom.id N, fun n => by
    have h1 : (g : V ≃ₗ[ℚ] V) = 1 := Subgroup.mem_bot.mp hg
    simp [h1]⟩

theorem trivialFolding_group (i : N →+ V) : (trivialFolding i).group = ⊥ := (rfl)

/-! ## The coarsening of a single cone -/

/-- The **coarsening of a cone by the folding group**: the join of its orbit,
`G · C = ⨆ g ∈ G, g '' C`. This is the orbit-join of the standard fan coarsening; see the module
docstring for the pinned referent. -/
noncomputable def orbitJoin (C : PointedCone ℚ V) : PointedCone ℚ V :=
  F.finset.sup fun g => C.map ((g : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V)

theorem orbitJoin_def (C : PointedCone ℚ V) :
    F.orbitJoin C = F.finset.sup (fun g => C.map ((g : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V)) := (rfl)

/-- The character set of the trivial folding is the singleton of the identity. -/
theorem trivialFolding_finset (i : N →+ V) :
    (trivialFolding i).finset = {⟨1, Subgroup.one_mem ⊥⟩} := by
  refine Finset.eq_singleton_iff_unique_mem.mpr ⟨Finset.mem_univ _, fun g _ => ?_⟩
  exact Subtype.ext (Subgroup.mem_bot.mp g.2)

/-- The coarsening by the trivial folding is the identity on cones. -/
theorem orbitJoin_trivial {i : N →+ V} (C : PointedCone ℚ V) :
    (trivialFolding i).orbitJoin C = C := by
  rw [orbitJoin, trivialFolding_finset, Finset.sup_singleton]
  simp

/-- The coarsening of a cone contains the cone: the identity of the folding group is a member. -/
theorem le_orbitJoin (C : PointedCone ℚ V) : C ≤ F.orbitJoin C := by
  rw [orbitJoin]
  simpa using Finset.le_sup (s := F.finset)
    (f := fun g : F.group => C.map ((g : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V)) (F.mem_finset 1)

theorem orbitJoin_mono {C D : PointedCone ℚ V} (h : C ≤ D) : F.orbitJoin C ≤ F.orbitJoin D := by
  rw [orbitJoin, orbitJoin]
  refine Finset.sup_le fun g _ => le_trans ?_ (Finset.le_sup (F.mem_finset g))
  intro x hx
  obtain ⟨y, hy, rfl⟩ := hx
  exact ⟨y, h hy, rfl⟩

/-- The coarsening of a cone is carried into itself by each member of the folding group. -/
theorem orbitJoin_map_le (C : PointedCone ℚ V) (k : F.group) :
    (F.orbitJoin C).map ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V) ≤ F.orbitJoin C := by
  rw [orbitJoin]
  have hpush := pointedCone_map_finset_sup (V := V) F.finset
    (fun g : F.group => C.map ((g : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V)) ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V)
  rw [hpush]
  refine Finset.sup_le (s := F.finset)
    (f := fun g : F.group => (C.map ((g : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V)).map
      ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V))
    (a := F.orbitJoin C) fun g _ => ?_
  have hcomp : (C.map ((g : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V)).map
      ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V) =
      C.map (((k * g : F.group) : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V) := by
    rw [PointedCone.map_map]
    rfl
  rw [hcomp]
  exact Finset.le_sup (s := F.finset)
    (f := fun g : F.group => C.map ((g : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V))
    (b := (k * g)) (F.mem_finset (k * g))

/-- **Equivariance at a cone**: the coarsening of a cone is stable under the folding group. -/
theorem orbitJoin_map (C : PointedCone ℚ V) (k : F.group) :
    (F.orbitJoin C).map ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V) = F.orbitJoin C := by
  refine le_antisymm (F.orbitJoin_map_le C k) ?_
  have hmono : ((F.orbitJoin C).map (((k⁻¹ : F.group) : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V)).map
        ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V) ≤
      (F.orbitJoin C).map ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V) :=
    pointedCone_map_mono (F.orbitJoin_map_le C k⁻¹) _
  rw [PointedCone.map_map,
    show ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V).comp (((k⁻¹ : F.group) : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V) =
      (((k : F.group) * k⁻¹ : F.group) : V ≃ₗ[ℚ] V) from rfl,
    mul_inv_cancel k] at hmono
  simpa using hmono

end FoldingData

/-! ## Rationality of the orbit joins

The two closure lemmas are the ones TauCeti proves for `IsLatticeRational` (`Cone/Basic.lean`,
`IsLatticeRational.sup` and `IsLatticeRational.map`); they are ported, with `ℝ` replaced by `ℚ`,
because `PointedCone.hull` is Mathlib's `span` over the nonnegative scalars and the proofs go
through `Submodule.span_union` and `Submodule.map_span`. -/

/-- The join of two lattice-rational cones is lattice rational. -/
theorem IsLatticeRational.sup {i : N →+ V} {C D : PointedCone ℚ V}
    (hC : IsLatticeRational i C) (hD : IsLatticeRational i D) :
    IsLatticeRational i (C ⊔ D) := by
  classical
  obtain ⟨s, rfl⟩ := hC
  obtain ⟨t, rfl⟩ := hD
  refine ⟨s ∪ t, ?_⟩
  rw [Finset.coe_union, Set.image_union]
  exact (Submodule.span_union _ _).symm

/-- The image of a lattice-rational cone under a `ℚ`-linear map compatible with a map of lattices is
lattice rational. -/
theorem IsLatticeRational.map {N' : Type*} [AddCommGroup N'] {V' : Type*} [AddCommGroup V']
    [Module ℚ V'] {i : N →+ V} {i' : N' →+ V'} {f : N →+ N'} {g : V →ₗ[ℚ] V'}
    (hfg : ∀ n, g (i n) = i' (f n)) {C : PointedCone ℚ V} (hC : IsLatticeRational i C) :
    IsLatticeRational i' (C.map g) := by
  classical
  obtain ⟨s, rfl⟩ := hC
  refine ⟨s.image f, ?_⟩
  simp [PointedCone.map, Submodule.map_span, Set.image_image, hfg]

/-- A cone family is *locally finite* when it is finite and every point of the ambient space lies in
finitely many of its members. This is the layered predicate the audit amendment asks for: local
finiteness is a `Prop` on families, proved of the coarsening, not a field of a structure. -/
def ConeFamilyLocallyFinite (S : Set (PointedCone ℚ V)) : Prop :=
  S.Finite ∧ ∀ x : V, {C ∈ S | x ∈ (C : Set V)}.Finite

/-- A finite supremum of lattice-rational cones is lattice rational. -/
theorem IsLatticeRational.finsetSup {ι : Type*} {i : N →+ V} (s : Finset ι)
    (f : ι → PointedCone ℚ V) (hf : ∀ g, IsLatticeRational i (f g)) :
    IsLatticeRational i (s.sup f) := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.sup_empty]; exact ⟨∅, by simp⟩
  | insert a t _ ih => rw [Finset.sup_insert]; exact (hf a).sup ih

namespace FoldingData

variable {i : N →+ V} (F : FoldingData i)

/-- **Lattice rationality of the coarsening**: the coarsening of a lattice-rational cone is
lattice-rational, generated by the lattice lifts of the generators of the cone. -/
theorem isLatticeRational_orbitJoin {C : PointedCone ℚ V} (hC : IsLatticeRational i C) :
    IsLatticeRational i (F.orbitJoin C) := by
  classical
  rw [orbitJoin]
  exact IsLatticeRational.finsetSup F.finset _
    fun g => hC.map (F.induced (g : V ≃ₗ[ℚ] V) g.2).2

/-! ## The coarsened cone family of a fan -/

/-- The **coarsening of a fan** by the folding group: the family of the orbit joins `G · C` of its
cones. -/
noncomputable def coarsenedCones (Φ : Fan i) : Set (PointedCone ℚ V) :=
  F.orbitJoin '' Φ.cones

theorem mem_coarsenedCones {Φ : Fan i} {D : PointedCone ℚ V} :
    D ∈ F.coarsenedCones Φ ↔ ∃ C ∈ Φ.cones, F.orbitJoin C = D :=
  Iff.rfl

/-- Every cone of a fan lies in its coarsening: the coarsening is above the fan in the coarsening
order of CLS §3.3. -/
theorem exists_coarsenedCones_ge {Φ : Fan i} {C : PointedCone ℚ V} (hC : C ∈ Φ.cones) :
    ∃ D ∈ F.coarsenedCones Φ, C ≤ D :=
  ⟨F.orbitJoin C, ⟨C, hC, rfl⟩, F.le_orbitJoin C⟩

/-- The coarsening of a fan has finitely many cones. -/
theorem coarsenedCones_finite (Φ : Fan i) : (F.coarsenedCones Φ).Finite :=
  Φ.finite_cones.image _

/-- **Local finiteness of the coarsening**: the coarsened cone family of a fan is locally finite —
finitely many cones, and every point lies in finitely many of them. -/
theorem coarsenedCones_locallyFinite (Φ : Fan i) :
    ConeFamilyLocallyFinite (F.coarsenedCones Φ) :=
  ⟨F.coarsenedCones_finite Φ,
    fun _ => (F.coarsenedCones_finite Φ).subset fun _ h => h.1⟩

/-! ## Equivariance of the coarsening -/

/-- **Equivariance, cone by cone**: the coarsening of a fan is stable under the folding group. -/
theorem coarsenedCones_map_mem (Φ : Fan i) (k : F.group) {D : PointedCone ℚ V}
    (hD : D ∈ F.coarsenedCones Φ) :
    D.map ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V) ∈ F.coarsenedCones Φ := by
  obtain ⟨C, hC, rfl⟩ := hD
  exact ⟨C, hC, (F.orbitJoin_map C k).symm⟩

/-- **Equivariance**: the cone set of the coarsening is invariant under the folding group. -/
theorem coarsenedCones_stable (Φ : Fan i) (k : F.group) :
    (fun D : PointedCone ℚ V => D.map ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V)) ''
        F.coarsenedCones Φ = F.coarsenedCones Φ := by
  refine Set.Subset.antisymm ?_ ?_
  · rintro D ⟨E, hE, rfl⟩
    exact F.coarsenedCones_map_mem Φ k hE
  intro D hD
  refine ⟨D.map (((k⁻¹ : F.group) : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V),
    F.coarsenedCones_map_mem Φ k⁻¹ hD, ?_⟩
  change (D.map (((k⁻¹ : F.group) : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V)).map
      ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V) = D
  rw [PointedCone.map_map,
    show ((k : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V).comp (((k⁻¹ : F.group) : V ≃ₗ[ℚ] V) : V →ₗ[ℚ] V) =
      (((k : F.group) * k⁻¹ : F.group) : V ≃ₗ[ℚ] V) from rfl,
    mul_inv_cancel k]
  simp

/-! ## The coarsened fan, and the functor

The coarsened cone family is a fan under three named hypotheses about the orbit joins: salience,
that a face of an orbit join is an orbit join, and that the intersection of two orbit joins is a
face of the first. They are hypotheses of `IsFanCoarsening`, not fields, and they are *not* the
equivariance and local finiteness obligations, which are the theorems above. -/

/-- The conditions under which the coarsened cone family of a fan is again a fan. -/
def IsFanCoarsening (Φ : Fan i) : Prop :=
  (∀ C ∈ Φ.cones, (F.orbitJoin C : ConvexCone ℚ V).Salient) ∧
  (∀ C ∈ Φ.cones, ∀ τ : PointedCone ℚ V,
    τ.IsFaceOf (F.orbitJoin C) → ∃ C' ∈ Φ.cones, F.orbitJoin C' = τ) ∧
  (∀ C ∈ Φ.cones, ∀ C' ∈ Φ.cones, ∀ τ : PointedCone ℚ V,
    τ.IsFaceOf (F.orbitJoin C) → ∀ υ : PointedCone ℚ V,
      υ.IsFaceOf (F.orbitJoin C') → (τ ⊓ υ).IsFaceOf τ)

/-- The intersection of the coarsenings of two cones of a fan is a face of the first, under
`IsFanCoarsening`. -/
theorem isFanCoarsening_inf {Φ : Fan i} (h : F.IsFanCoarsening Φ) {C C' : PointedCone ℚ V}
    (hC : C ∈ Φ.cones) (hC' : C' ∈ Φ.cones) :
    (F.orbitJoin C ⊓ F.orbitJoin C').IsFaceOf (F.orbitJoin C) :=
  h.2.2 C hC C' hC' _ (PointedCone.IsFaceOf.refl _) _ (PointedCone.IsFaceOf.refl _)

/-- The coarsened fan of a fan, under `IsFanCoarsening`. -/
noncomputable def coarsenFan (Φ : Fan i) (h : F.IsFanCoarsening Φ) : Fan i where
  cones := F.coarsenedCones Φ
  finite_cones := F.coarsenedCones_finite Φ
  isToricCone := by
    rintro σ ⟨C, hC, rfl⟩
    exact ⟨F.isLatticeRational_orbitJoin (Φ.isToricCone hC).rational, h.1 C hC⟩
  mem_of_isFaceOf := by
    rintro σ τ ⟨C, hC, rfl⟩ hτ
    obtain ⟨C', hC', hEq⟩ := h.2.1 C hC τ hτ
    exact ⟨C', hC', hEq⟩
  inf_isFaceOf_left := by
    rintro σ τ ⟨C, hC, rfl⟩ ⟨C', hC', rfl⟩
    exact F.isFanCoarsening_inf h hC hC'

end FoldingData

/-! ## The coarsening is a functor -/

variable {i : N →+ V}

/-- A `PLift` of a proposition is a subsingleton; used for the category laws on the coarsening
order. -/
theorem plift_prop_subsingleton {p : Prop} (a b : PLift p) : a = b := by
  cases a with
  | up ha => cases b with | up hb => rw [Subsingleton.elim ha hb]

/-- The category of fans over a fixed lattice map, with the coarsening order of CLS §3.3 as its
morphisms: `Φ ⟶ Ψ` when every cone of `Φ` lies in a cone of `Ψ`. -/
instance fanCategory (i : N →+ V) : Category (Fan i) where
  Hom Φ Ψ := PLift (∀ C ∈ Φ.cones, ∃ D ∈ Ψ.cones, C ≤ D)
  id Φ := PLift.up fun C hC => ⟨C, hC, le_rfl⟩
  comp f g := PLift.up fun C hC => by
    obtain ⟨D, hD, hCD⟩ := f.down C hC
    obtain ⟨E, hE, hDE⟩ := g.down D hD
    exact ⟨E, hE, le_trans hCD hDE⟩
  id_comp _ := plift_prop_subsingleton _ _
  comp_id _ := plift_prop_subsingleton _ _
  assoc _ _ _ := plift_prop_subsingleton _ _

/-- A fan together with the data that its orbit joins form a fan. -/
structure CoarsenableFan (F : FoldingData i) where
  /-- The underlying fan. -/
  fan : Fan i
  /-- The coarsening is a fan. -/
  isFanCoarsening : F.IsFanCoarsening fan

namespace CoarsenableFan

variable {i : N →+ V} {F : FoldingData i}

instance category : Category (CoarsenableFan F) where
  Hom X Y := X.fan ⟶ Y.fan
  id X := 𝟙 X.fan
  comp f g := f ≫ g
  id_comp _ := Category.id_comp _
  comp_id _ := Category.comp_id _
  assoc _ _ _ := Category.assoc _ _ _

end CoarsenableFan

namespace FoldingData

variable {i : N →+ V} (F : FoldingData i)

/-- **The Wythoff coarsening functor**: fan coarsening induced by the folding data, as a functor
from the category of fans whose orbit joins form a fan to the category of fans, both on the
coarsening order of CLS §3.3. This is the #24 "Wythoff coarsening", with its domain and codomain
named. -/
noncomputable def coarsenFunctor : CoarsenableFan F ⥤ Fan i where
  obj X := F.coarsenFan X.fan X.isFanCoarsening
  map {X Y} f := PLift.up fun C hC => by
    obtain ⟨C₀, hC₀, rfl⟩ := hC
    obtain ⟨D₀, hD₀, hCD⟩ := f.down C₀ hC₀
    exact ⟨F.orbitJoin D₀, ⟨D₀, hD₀, rfl⟩, F.orbitJoin_mono hCD⟩
  map_id _ := plift_prop_subsingleton _ _
  map_comp _ _ := plift_prop_subsingleton _ _

end FoldingData

end LeanCategories.Lattices.Valued
