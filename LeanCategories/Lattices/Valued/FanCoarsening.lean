/-!
# Generalized Coxeter chambers and Wythoff coarsening (#24)

This module uses the Wythoff chamber of Alexeev–Engel–Thompson, Definition 4.16,
not a finite supremum of cone translates.  If `J` is the set of irrelevant simple
roots, the chamber is the union of the translates of the closed fundamental
chamber by the standard parabolic subgroup `W_J`.  Proposition 4.17(1) identifies
this union with the intersection of the active transformed half-spaces.

The finite-parabolic version proved here replaces the former orbit-join construction.
That construction imposed global finiteness of the folding group and was not the
locally finite, Weyl-group-equivariant Wythoff construction in the source.  Rational
polyhedrality, the fan axioms, full Weyl-group invariance, local finiteness and the
coarsening relation are separate obligations; none is asserted by this module.

## Main declarations

* `irrelevantReflectionSubgroup`: the standard parabolic subgroup `W_J`.
* `fundamentalChamber` and `generalizedChamber`: Definition 4.16.
* `activeHalfspaceIntersection`: the right-hand side of Proposition 4.17(1).
* `generalizedChamber_eq_activeHalfspaceIntersection`: Proposition 4.17(1) for
  finite `W_J`, with the coroot-interior condition used by height minimization made
  explicit.

The forward inclusion uses the coefficient of an active simple root.  Irrelevant
reflections preserve this coefficient, hence preserve positivity and exclusion of
the transformed index from `J`.  The reverse inclusion minimizes the chamber-height
`x ↦ B.form ρ x` over the finite parabolic orbit and reflects across a negative
irrelevant wall.  This is the source's reflection-descent argument; finiteness lets
us minimize directly instead of invoking its integral Northcott-finiteness argument.

## Reference

V. Alexeev, P. Engel, A. Thompson, *Stable pair compactification of moduli of
K3 surfaces of degree 2*, arXiv:1903.09742v3, Definition 4.16 and
Proposition 4.17(1).  The cited source was read at `.scratch/aet23-1903.09742v3.pdf`.

## LC-09 search record

Before implementation, the repository, pinned Mathlib, the formalization corpus and
Atlas/TauCeti results were searched for generalized Coxeter semifans, the Wythoff
construction, Coxeter/parabolic chamber convexity, parabolic subgroups, Tits cones,
inactive mirrors and relevant faces.  No declaration of AET Proposition 4.17 was
found.  Atlas contains separate Tits-cone material, not this transported-half-space
characterization.  The direct owners reused here are Mathlib's
`RootPairing.Base.IsPos.reflectionPerm`, `RootPairing.Base.exists_root_eq_sum_int`,
`RootPairing.InvariantForm.apply_weylGroup_smul`, `RootPairing.weylGroupToPerm` and
`RootPairing.weylGroup_apply_root`.  The full query log is retained at
`.scratch/wt24-lc09.txt`.
-/

@[expose] public section

namespace LeanCategories.Lattices.Valued

open scoped Pointwise

variable {ι M N : Type*} [DecidableEq ι] [Finite ι]
  [AddCommGroup M] [Module ℝ M] [AddCommGroup N] [Module ℝ N]
  (P : RootPairing ι ℝ M N) [P.IsCrystallographic] [P.IsReduced]
  (b : P.Base) (B : P.InvariantForm) (J : Finset ι)

/-- The standard parabolic subgroup generated by the irrelevant simple reflections of
Alexeev–Engel–Thompson, Definition 4.16. -/
noncomputable def irrelevantReflectionSubgroup : Subgroup P.weylGroup :=
  Subgroup.closure ((fun j ↦ RootPairing.weylGroup.ofIdx P j) '' J)

omit [DecidableEq ι] [Finite ι] [P.IsCrystallographic] [P.IsReduced] in
lemma toSubmonoid_irrelevantReflectionSubgroup :
    (irrelevantReflectionSubgroup P J).toSubmonoid =
      Submonoid.closure ((fun j ↦ RootPairing.weylGroup.ofIdx P j) '' J) := by
  classical
  suffices H : (fun j ↦ RootPairing.weylGroup.ofIdx P j) '' J =
      ((fun j ↦ RootPairing.weylGroup.ofIdx P j) '' J)⁻¹ by
    rw [irrelevantReflectionSubgroup, Subgroup.closure_toSubmonoid, ← H, Set.union_self]
  have hgen (j : ι) : (RootPairing.weylGroup.ofIdx P j)⁻¹ =
      RootPairing.weylGroup.ofIdx P j := by
    apply Subtype.ext
    simpa only [RootPairing.weylGroup.ofIdx, Subgroup.coe_inv] using
      RootPairing.Equiv.reflection_inv P j
  ext x
  constructor
  · rintro ⟨j, hj, hEq⟩
    refine ⟨j, hj, (hgen j).symm.trans ?_⟩
    exact congrArg (fun z : P.weylGroup ↦ z⁻¹) hEq
  · rintro ⟨j, hj, hEq⟩
    refine ⟨j, hj, (hgen j).symm.trans ?_⟩
    exact (congrArg (fun z : P.weylGroup ↦ z⁻¹) hEq).trans (inv_inv x)

/-- The closed fundamental chamber cut out by the simple roots. -/
def fundamentalChamber : Set M :=
  {x | ∀ i ∈ b.support, 0 ≤ B.form (P.root i) x}

/-- The generalized chamber of Alexeev–Engel–Thompson, Definition 4.16. -/
noncomputable def generalizedChamber : Set M :=
  ⋃ h : irrelevantReflectionSubgroup P J, (fun x ↦ h • x) '' fundamentalChamber P b B

/-- The intersection of the transformed active half-spaces in Proposition 4.17(1)
of Alexeev–Engel–Thompson. -/
noncomputable def activeHalfspaceIntersection : Set M :=
  {x | ∀ i ∈ b.support.filter (fun i ↦ i ∉ J), ∀ h : irrelevantReflectionSubgroup P J,
    0 ≤ B.form (P.root i) (h • x)}

omit [DecidableEq ι] [Finite ι] [P.IsCrystallographic] [P.IsReduced] in
lemma eval_root_nonneg_of_mem_fundamentalChamber {x : M}
    (hx : x ∈ fundamentalChamber P b B) {i : ι} (hi : b.IsPos i) :
    0 ≤ B.form (P.root i) x := by
  classical
  obtain ⟨f, hfSupport, hfSign, hi_eq⟩ := b.exists_root_eq_sum_int i
  rw [hi_eq]
  simp only [map_sum, LinearMap.sum_apply, map_zsmul]
  apply Finset.sum_nonneg
  intro j hj
  have hfj : 0 ≤ f j := by
    rcases hfSign with hpos | hneg
    · exact hpos.le j
    · exfalso
      have hsNeg : ∑ j ∈ b.support, f j < 0 := by
        apply Finset.sum_neg' (fun k _ ↦ hneg.le k)
        obtain ⟨i, hi⟩ := (Pi.lt_def.mp hneg).2
        exact ⟨i, hfSupport (ne_of_lt hi), hi⟩
      have hsPos : 0 < ∑ j ∈ b.support, f j := by
        rw [← b.height_eq_sum hi_eq, ← b.isPos_iff]
        exact hi
      linarith
  rw [← Int.cast_smul_eq_zsmul ℝ]
  have hfjR : (0 : ℝ) ≤ (f j : ℝ) := by exact_mod_cast hfj
  exact smul_nonneg hfjR (hx j hj)

/-- The coefficient of an index in the unique expansion of a root in a root base. -/
noncomputable def baseCoord (i k : ι) : ℤ := (b.exists_root_eq_sum_int k).choose i

omit [DecidableEq ι] [Finite ι] [P.IsCrystallographic] [P.IsReduced] in
lemma baseCoord_eq_of_eq_sum {i k : ι} {f : ι → ℤ}
    (hfSupport : f.support ⊆ b.support)
    (hf : P.root k = ∑ j ∈ b.support, f j • P.root j) :
    baseCoord P b i k = f i := by
  classical
  by_cases hi : i ∈ b.support
  · have hroot := (b.exists_root_eq_sum_int k).choose_spec.2.2
    rw [hroot, b.support.sum_subtype (p := (· ∈ b.support)) (by simp) (F := inferInstance),
      b.support.sum_subtype (p := (· ∈ b.support)) (by simp) (F := inferInstance)] at hf
    have aux := Fintype.linearIndependent_iffₛ.mp
      (b.linearIndepOn_root.restrict_scalars' ℤ)
      ((b.exists_root_eq_sum_int k).choose ∘ (↑)) (f ∘ (↑))
      hf ⟨i, hi⟩
    change (b.exists_root_eq_sum_int k).choose i = f i
    exact aux
  · have hleft : (b.exists_root_eq_sum_int k).choose i = 0 := by
      apply Function.notMem_support.mp
      intro hmem
      exact hi ((b.exists_root_eq_sum_int k).choose_spec.1 hmem)
    have hright : f i = 0 := by
      apply Function.notMem_support.mp
      intro hmem
      exact hi (hfSupport hmem)
    simp [baseCoord, hleft, hright]

omit [DecidableEq ι] [Finite ι] [P.IsReduced] in
lemma baseCoord_reflectionPerm {i j k : ι} (hiJ : i ∉ J)
    (hj : j ∈ b.support) (hjJ : j ∈ J) :
    baseCoord P b i (P.reflectionPerm j k) = baseCoord P b i k := by
  classical
  obtain ⟨f, hfSupport, -, hk⟩ := b.exists_root_eq_sum_int k
  let g := f + (-P.pairingIn ℤ k j) • (Pi.single (M := fun _ : ι => ℤ) j 1)
  have hgSupport : g.support ⊆ b.support := by
    apply (Function.support_add f _).trans
    refine Set.union_subset_iff.mpr ⟨hfSupport, ?_⟩
    intro x hx
    by_cases hxj : x = j
    · subst x; exact hj
    · simp [hxj] at hx
  apply (baseCoord_eq_of_eq_sum (P := P) (b := b) (i := i)
    (k := P.reflectionPerm j k) hgSupport ?_).trans
  · dsimp only [g, baseCoord]
    simp only [Pi.add_apply, zsmul_eq_mul]
    have hu := baseCoord_eq_of_eq_sum (P := P) (b := b) (i := i) hfSupport hk
    have hij : i ≠ j := by
      intro heq
      exact hiJ (heq ▸ hjJ)
    rw [Pi.mul_apply, Pi.single_eq_of_ne hij]
    simp only [mul_zero, add_zero]
    change f i = baseCoord P b i k
    exact hu.symm
  · rw [P.root_reflectionPerm, hk]
    have hs : ∑ x ∈ b.support,
        (-P.pairingIn ℤ k j • (Pi.single (M := fun _ : ι => ℤ) j 1) x) • P.root x =
        (-P.pairingIn ℤ k j) • P.root j := by
      rw [Finset.sum_eq_single_of_mem j hj]
      · simp
      · intro b _ hbj
        simp [hbj]
    have hc (x : ι) : (P.coroot' j) (f x • P.root x) = f x * P.pairing x j := by
      simp only [← Int.cast_smul_eq_zsmul ℝ, map_smul,
        RootPairing.root_coroot'_eq_pairing, smul_eq_mul]
    simp only [map_sum, P.reflection_apply, g, Pi.add_apply, Pi.smul_apply, hc]
    have hpair : ∑ x ∈ b.support, ((f x : ℝ) * P.pairing x j) =
        (P.pairingIn ℤ k j : ℝ) := by
      have hcroot : (P.pairing k j : ℝ) = (P.pairingIn ℤ k j : ℝ) :=
        (P.algebraMap_pairingIn ℤ k j).symm
      calc
        _ = P.coroot' j (∑ x ∈ b.support, f x • P.root x) := by
          simp only [map_sum, hc]
        _ = P.coroot' j (P.root k) := congrArg _ hk.symm
        _ = (P.pairingIn ℤ k j : ℝ) := by
          rw [RootPairing.root_coroot'_eq_pairing]
          exact hcroot
    simp only [add_smul, Finset.sum_add_distrib]
    rw [hs, hpair]
    module

omit [DecidableEq ι] [Finite ι] [P.IsCrystallographic] [P.IsReduced] in
lemma baseCoord_self {i : ι} (hi : i ∈ b.support) : baseCoord P b i i = 1 := by
  classical
  have h := baseCoord_eq_of_eq_sum (P := P) (b := b) (i := i) (k := i)
    (f := (Pi.single (M := fun _ : ι => ℤ) i 1))
    (by
      intro x hx
      by_cases hxi : x = i
      · subst x; exact hi
      · simp [hxi] at hx)
    (by
      rw [Finset.sum_eq_single_of_mem i hi (fun b _ hbi ↦ by simp [hbi])]
      simp)
  simpa using h

omit [DecidableEq ι] [Finite ι] [P.IsCrystallographic] [P.IsReduced] in
lemma baseCoord_of_mem_ne_support {i k : ι} (hk : k ∈ b.support)
    (hne : i ≠ k) : baseCoord P b i k = 0 := by
  classical
  have h := baseCoord_eq_of_eq_sum (P := P) (b := b) (i := i) (k := k)
    (f := (Pi.single (M := fun _ : ι => ℤ) k 1))
    (by
      intro x hx
      by_cases hxk : x = k
      · subst x; exact hk
      · simp [hxk] at hx)
    (by
      rw [Finset.sum_eq_single_of_mem k hk (fun b _ hbk ↦ by simp [hbk])]
      simp)
  have hz : (Pi.single (M := fun _ : ι => ℤ) k 1) i = 0 := by simp [hne]
  exact h.trans hz

omit [DecidableEq ι] [Finite ι] [P.IsReduced] in
lemma baseCoord_weylGroupToPerm_irrelevant (i : ι) (hiJ : i ∉ J) (hJ : J ⊆ b.support) (k : ι)
    (h : irrelevantReflectionSubgroup P J) :
    baseCoord P b i (P.weylGroupToPerm h k) = baseCoord P b i k := by
  classical
  have hsub : (h : P.weylGroup) ∈
      Submonoid.closure ((fun j ↦ RootPairing.weylGroup.ofIdx P j) '' J) := by
    rw [← toSubmonoid_irrelevantReflectionSubgroup]
    exact h.property
  generalize (h : P.weylGroup) = g at hsub ⊢
  induction hsub using Submonoid.closure_induction generalizing k with
  | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      exact baseCoord_reflectionPerm P b J hiJ (hJ hj) hj
  | one => rfl
  | mul x y hx hy ihx ihy =>
      change baseCoord P b i ((P.weylGroupToPerm x * P.weylGroupToPerm y) k) =
        baseCoord P b i k
      rw [Equiv.Perm.mul_apply]
      exact (ihx (P.weylGroupToPerm y k)).trans (ihy k)

omit [DecidableEq ι] [Finite ι] [P.IsReduced] in
lemma notMem_weylGroupToPerm_irrelevant {i : ι}
    (hiSupport : i ∈ b.support) (hiJ : i ∉ J) (hJ : J ⊆ b.support)
    (h : irrelevantReflectionSubgroup P J) :
    P.weylGroupToPerm h i ∉ J := by
  classical
  intro hmem
  have hzero := baseCoord_of_mem_ne_support (P := P) (b := b) (i := i) (hJ hmem)
    (by intro heq; exact hiJ (heq ▸ hmem))
  have hone := baseCoord_weylGroupToPerm_irrelevant (P := P) (b := b) (J := J)
    (i := i) (hiJ := hiJ) (hJ := hJ) (k := i) h
  rw [baseCoord_self (P := P) (b := b) hiSupport] at hone
  rw [hone] at hzero
  exact one_ne_zero hzero

omit [DecidableEq ι] in
lemma isPos_weylGroupToPerm_irrelevant {i : ι}
    (hi : b.IsPos i) (hiSupport : i ∈ b.support) (hiJ : i ∉ J) (hJ : J ⊆ b.support)
    (h : irrelevantReflectionSubgroup P J) :
    b.IsPos (P.weylGroupToPerm h i) := by
  classical
  have hsub : (h : P.weylGroup) ∈
      Submonoid.closure ((fun j ↦ RootPairing.weylGroup.ofIdx P j) '' J) := by
    rw [← toSubmonoid_irrelevantReflectionSubgroup]
    exact h.property
  have hout := notMem_weylGroupToPerm_irrelevant P b J hiSupport hiJ hJ
  clear hiSupport
  generalize (h : P.weylGroup) = g at hsub ⊢
  induction hsub using Submonoid.closure_induction generalizing i with
  | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      exact hi.reflectionPerm (hJ hj)
        (fun hji ↦ hiJ (hji ▸ hj))
  | one => exact hi
  | mul x y hx hy ihx ihy =>
      change b.IsPos ((P.weylGroupToPerm x * P.weylGroupToPerm y) i)
      rw [Equiv.Perm.mul_apply]
      have hout' : ∀ h : irrelevantReflectionSubgroup P J,
          P.weylGroupToPerm h (P.weylGroupToPerm y i) ∉ J := by
        intro h
        let z : irrelevantReflectionSubgroup P J :=
          ⟨h * y, mul_mem h.property (by
            change y ∈ (irrelevantReflectionSubgroup P J).toSubmonoid
            rw [toSubmonoid_irrelevantReflectionSubgroup]
            exact hy)⟩
        have hz := hout z
        change P.weylGroupToPerm ((h : P.weylGroup) * y) i ∉ J at hz
        simpa only [map_mul, Equiv.Perm.mul_apply] using hz
      have hyJ : P.weylGroupToPerm y i ∉ J := by
        let z : irrelevantReflectionSubgroup P J :=
          ⟨y, by
            change y ∈ (irrelevantReflectionSubgroup P J).toSubmonoid
            rw [toSubmonoid_irrelevantReflectionSubgroup]
            exact hy⟩
        exact hout z
      exact ihx (ihy hi hiJ hout) hyJ hout'

omit [DecidableEq ι] [Finite ι] [P.IsCrystallographic] [P.IsReduced] in
lemma eval_root_apply_eq_inv_smul {i : ι} (h : P.weylGroup) (x : M) :
    B.form (P.root i) (h • x) = B.form ((h⁻¹ : P.weylGroup) • P.root i) x := by
  classical
  have hinv := B.apply_weylGroup_smul (P := P) (h⁻¹) (P.root i) (h • x)
  rw [inv_smul_smul] at hinv
  exact hinv.symm

lemma generalizedChamber_subset_activeHalfspaceIntersection (hJ : J ⊆ b.support) :
    generalizedChamber P b B J ⊆ activeHalfspaceIntersection P b B J := by
  intro x hx
  simp only [generalizedChamber, Set.mem_iUnion, Set.mem_image] at hx
  obtain ⟨h, y, hy, rfl⟩ := hx
  intro i hi g
  change 0 ≤ B.form (P.root i) (((g * h : irrelevantReflectionSubgroup P J) : P.weylGroup) • y)
  rw [eval_root_apply_eq_inv_smul (P := P) (B := B) (i := i)
    (((g * h : irrelevantReflectionSubgroup P J) : P.weylGroup)), P.weylGroup_apply_root]
  exact eval_root_nonneg_of_mem_fundamentalChamber P b B hy
    (isPos_weylGroupToPerm_irrelevant P b J
      (b.isPos_of_mem_support (Finset.mem_filter.mp hi).1)
      (Finset.mem_filter.mp hi).1 (Finset.mem_filter.mp hi).2 hJ (g * h)⁻¹)

omit [Finite ι] [P.IsCrystallographic] [P.IsReduced] in
lemma subset_generalizedChamber_of_mem_activeHalfspaceIntersection
    [Finite (irrelevantReflectionSubgroup P J)] (ρ : M)
    (hρcoroot : ∀ j ∈ J, P.toLinearMap.flip (P.coroot j) ρ < 0)
    {x : M} (hx : x ∈ activeHalfspaceIntersection P b B J) :
    x ∈ generalizedChamber P b B J := by
  obtain ⟨h, -, hmin⟩ := Set.Finite.exists_minimalFor
    (fun h : irrelevantReflectionSubgroup P J ↦ B.form ρ (h • x))
    Set.univ Set.finite_univ ⟨1, Set.mem_univ 1⟩
  have hch : h • x ∈ fundamentalChamber P b B := by
    intro j hj
    by_cases hjJ : j ∈ J
    · by_contra hneg
      let hnew : irrelevantReflectionSubgroup P J :=
        ⟨RootPairing.weylGroup.ofIdx P j * h,
          mul_mem (Subgroup.subset_closure ⟨j, hjJ, rfl⟩) h.property⟩
      have hlt : B.form ρ (hnew • x) < B.form ρ (h • x) := by
        change B.form ρ ((RootPairing.weylGroup.ofIdx P j * (h : P.weylGroup)) • x) <
          B.form ρ (h • x)
        change B.form ρ (P.reflection j (h • x)) < B.form ρ (h • x)
        have hInv := B.isOrthogonal_reflection j ρ (P.reflection j (h • x))
        rw [P.reflection_same] at hInv
        rw [P.reflection_apply] at hInv
        simp only [LinearMap.map_sub, LinearMap.map_smul, LinearMap.sub_apply,
          LinearMap.smul_apply, smul_eq_mul] at hInv
        have hc : P.toLinearMap.flip (P.coroot j) ρ < 0 := hρcoroot j hjJ
        have hr : B.form (P.root j) (h • x) < 0 := lt_of_not_ge hneg
        nlinarith
      exact (not_le_of_gt hlt) (hmin (Set.mem_univ _) (le_of_lt hlt))
    · exact hx j (Finset.mem_filter.mpr ⟨hj, hjJ⟩) h
  apply Set.mem_iUnion.mpr
  refine ⟨(h⁻¹ : irrelevantReflectionSubgroup P J), h • x, hch, ?_⟩
  exact inv_smul_smul h x

/-- **Alexeev–Engel–Thompson, Proposition 4.17(1), finite standard-parabolic case.**
The union of the chambers indexed by a finite irrelevant parabolic is exactly the intersection
of the transformed active half-spaces. The coroot-interior condition is precisely the one used
by the height-minimization argument. -/
theorem generalizedChamber_eq_activeHalfspaceIntersection
    [Finite (irrelevantReflectionSubgroup P J)] (ρ : M)
    (hρcoroot : ∀ j ∈ J, P.toLinearMap.flip (P.coroot j) ρ < 0) (hJ : J ⊆ b.support) :
    generalizedChamber P b B J = activeHalfspaceIntersection P b B J := by
  apply Set.Subset.antisymm (generalizedChamber_subset_activeHalfspaceIntersection P b B J hJ)
  intro x hx
  exact subset_generalizedChamber_of_mem_activeHalfspaceIntersection P b B J ρ hρcoroot hx

end LeanCategories.Lattices.Valued
