module

public import LeanCategories.Topology.MappingCylinderData
public import LeanCategories.Topology.SmashProduct

/-!
# Sequential mapping-telescope data

Definition-level topological support for Hatcher FC07-C04-U140.

For a sequence of based spaces

`X₀ → X₁ → X₂ → ···`,

the mapping telescope is the quotient of the disjoint union of the cylinders
`Xₙ × I` by the endpoint identifications

`(n,x,1) ∼ (n+1,fₙ(x),0)`.

Only the quotient carrier, its basepoint, and the canonical stage
representatives are recorded here.  Retraction, homotopy-colimit,
tail-deletion, and weak-equivalence statements are result-layer content.
-/

@[expose] public noncomputable section

open _root_.CategoryTheory
open scoped _root_.CategoryTheory

namespace LeanCategories.Topology

universe u

/-- The disjoint union of the cylinders before imposing the telescope
endpoint identifications. -/
abbrev MappingTelescopePre
    (X : ℕ → BasedTop.{u}) :=
  Sigma fun n : ℕ => unitInterval × (X n).right

/-- The generating endpoint identifications
`(n,x,1) ∼ (n+1,fₙ(x),0)` for a sequential mapping telescope. -/
inductive MappingTelescopeGlue
    (X : ℕ → BasedTop.{u})
    (f : ∀ n : ℕ, X n ⟶ X (n + 1)) :
    MappingTelescopePre X → MappingTelescopePre X → Prop
  | step (n : ℕ) (x : (X n).right) :
      MappingTelescopeGlue X f
        ⟨n, (1, x)⟩
        ⟨n + 1, (0, (f n).right x)⟩

/-- The equivalence relation generated by the telescope endpoint
identifications. -/
def mappingTelescopeSetoid
    (X : ℕ → BasedTop.{u})
    (f : ∀ n : ℕ, X n ⟶ X (n + 1)) :
    Setoid (MappingTelescopePre X) :=
  Relation.EqvGen.setoid (MappingTelescopeGlue X f)

/-- Hatcher's topological mapping telescope of a sequential diagram. -/
abbrev MappingTelescope
    (X : ℕ → BasedTop.{u})
    (f : ∀ n : ℕ, X n ⟶ X (n + 1)) :=
  Quotient (mappingTelescopeSetoid X f)

/-- A representative in the `n`th cylinder of the mapping telescope. -/
def mappingTelescopeMk
    (X : ℕ → BasedTop.{u})
    (f : ∀ n : ℕ, X n ⟶ X (n + 1))
    (n : ℕ) (t : unitInterval) (x : (X n).right) :
    MappingTelescope X f :=
  Quotient.mk _ ⟨n, (t, x)⟩

/-- The canonical copy of the `n`th stage at the bottom of its cylinder. -/
def mappingTelescopeStageMk
    (X : ℕ → BasedTop.{u})
    (f : ∀ n : ℕ, X n ⟶ X (n + 1))
    (n : ℕ) (x : (X n).right) :
    MappingTelescope X f :=
  mappingTelescopeMk X f n 0 x

/-- The basepoint represented by the basepoint of the initial stage. -/
def mappingTelescopePoint
    (X : ℕ → BasedTop.{u})
    (f : ∀ n : ℕ, X n ⟶ X (n + 1)) :
    MappingTelescope X f :=
  mappingTelescopeStageMk X f 0 (X 0).point

/-- The sequential mapping telescope as a based topological space. -/
abbrev basedMappingTelescope
    (X : ℕ → BasedTop.{u})
    (f : ∀ n : ℕ, X n ⟶ X (n + 1)) :
    BasedTop.{u} :=
  Under.mk
    (TopCat.ofHom
      (⟨fun _ : PUnit => mappingTelescopePoint X f, continuous_const⟩ :
        C(PUnit, MappingTelescope X f)))

end LeanCategories.Topology
