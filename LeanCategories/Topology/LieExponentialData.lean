module

public import LeanCategories.Topology.CurveVelocity
public import LeanCategories.Topology.InvariantIntegralCurve
public import LeanCategories.Topology.OneParameterSubgroup

/-!
# Generated one-parameter subgroups and Lie exponential data

Definition-level realizations of Lee FC08-C20-U003 and FC08-C20-U006.

For `X` in the Lie algebra, Lee names the one-parameter subgroup whose
initial velocity is `X`.  This file now constructs that subgroup as the
canonical global integral curve of the left-invariant vector field generated by
`X`; no subgroup or family of subgroups is accepted from the caller.

The Lie exponential is then, definitionally, time-one evaluation of that
generated subgroup. The classification bijections, smoothness, local
diffeomorphism statements, and the formula `gamma_X(t)=exp(tX)` remain
result content.
-/

@[expose] public section

noncomputable section

open scoped Manifold ContDiff

namespace LeanCategories.Topology

universe u v

variable
  {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H]
  {G : Type v} [TopologicalSpace G] [ChartedSpace H G] [Group G]

/-- Characterization of the one-parameter subgroup generated by `X`: it is
a one-parameter subgroup whose velocity at time zero, transported along
`gamma(0)=1`, is `X`. -/
def IsGeneratedOneParameterSubgroup
    (I : ModelWithCorners ℝ E H) [LieGroup I ∞ G]
    (X : GroupLieAlgebra I G) (gamma : ℝ → G) : Prop :=
  IsOneParameterSubgroup I gamma ∧
    ∃ h0 : gamma 0 = 1,
      cast (congrArg (fun p : G => TangentSpace I p) h0)
        (curveVelocity I gamma 0) = X

/-- Source-faithful one-parameter-subgroup data generated by `X`: a raw
curve together with Lee's exact initial-velocity characterization. -/
abbrev GeneratedOneParameterSubgroupData
    (I : ModelWithCorners ℝ E H) [LieGroup I ∞ G]
    (X : GroupLieAlgebra I G) :=
  {gamma : ℝ → G // IsGeneratedOneParameterSubgroup I X gamma}

/-- The canonical one-parameter subgroup generated by `X`, constructed from
the invariant vector field and its unique global integral curve. -/
noncomputable def generatedOneParameterSubgroupData
    (I : ModelWithCorners ℝ E H) [LieGroup I ∞ G]
    [T2Space G] [BoundarylessManifold I G] [CompleteSpace E]
    (X : GroupLieAlgebra I G) :
    GeneratedOneParameterSubgroupData (G := G) I X := by
  letI : LieGroup I (minSmoothness ℝ 3) G :=
    LieGroup.of_le (m := minSmoothness ℝ 3) (n := ∞) (by
      rw [minSmoothness_of_isRCLikeNormedField]
      exact (inferInstance : ENat.LEInfty (3 : ℕ∞ω)).out)
  let gamma : ℝ → G :=
    fun t => mulInvariantOneParameterSubgroupData (I := I) (G := G) X
      (Multiplicative.ofAdd t)
  refine ⟨gamma, ?_⟩
  constructor
  · refine ⟨?_, by simp [gamma], ?_⟩
    · have hsmooth :=
        IsMIntegralCurve.contMDiff_data
          (isMIntegralCurve_mulInvariantIntegralCurveData (I := I) (G := G) X 1)
          (contMDiff_mulInvariantVectorField_infty_data (I := I) (G := G) X)
      simpa only [gamma, mulInvariantOneParameterSubgroupData_apply] using hsmooth
    · intro s t
      simp [gamma]
  · have h0 : gamma 0 = 1 := by simp [gamma]
    refine ⟨h0, ?_⟩
    have hcurve :=
      isMIntegralCurve_mulInvariantIntegralCurveData (I := I) (G := G) X 1
    have hder := (hcurve 0).mfderiv
    have hvel :
        curveVelocity I gamma 0 =
          mulInvariantVectorField X (gamma 0) := by
      change
        curveVelocity I (mulInvariantIntegralCurveData (I := I) (G := G) X 1) 0 =
          mulInvariantVectorField X
            (mulInvariantIntegralCurveData (I := I) (G := G) X 1 0)
      rw [curveVelocity, curveVelocityWithin,
        mfderivWithin_eq_mfderiv
          (uniqueMDiffWithinAt_univ (I := 𝓘(ℝ, ℝ)))
          (hcurve 0).mdifferentiableAt]
      have heval := congrArg (fun f => f (1 : ℝ)) hder
      change
        (mfderiv% (mulInvariantIntegralCurveData (I := I) (G := G) X 1) 0) (1 : ℝ) =
          ((1 : ℝ →L[ℝ] ℝ) (1 : ℝ)) •
            mulInvariantVectorField X
              (mulInvariantIntegralCurveData (I := I) (G := G) X 1 0) at heval
      simpa using heval
    rw [hvel]
    rw [h0]
    exact mulInvariantVectorField_one_data (I := I) X

/-- Lee's Lie-group exponential: evaluate the generated one-parameter
subgroup at time `1`. -/
noncomputable def lieExponentialData
    (I : ModelWithCorners ℝ E H) [LieGroup I ∞ G]
    [T2Space G] [BoundarylessManifold I G] [CompleteSpace E]
    (X : GroupLieAlgebra I G) : G :=
  (generatedOneParameterSubgroupData (G := G) I X).1 1

end LeanCategories.Topology
