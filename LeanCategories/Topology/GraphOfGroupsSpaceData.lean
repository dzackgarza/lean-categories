module

public import Mathlib.AlgebraicTopology.FundamentalGroupoid.FundamentalGroup
public import Mathlib.Data.Setoid.Basic
public import Mathlib.Topology.Constructions
public import Mathlib.Topology.UnitInterval

/-!
# Graph-of-groups space and graph product data

Definition-level realization of Hatcher FC07-C01-U090.

Hatcher realizes an oriented graph of groups by choosing a classifying space
at every vertex and a map realizing every oriented edge homomorphism. The
space K_Gamma is obtained by joining the vertex spaces with the corresponding
mapping cylinders. Its graph product is pi_1(K_Gamma).

This file records that graph-of-spaces quotient literally. A topological
presentation supplies the already-chosen vertex spaces and representative
edge maps. The raw carrier is the disjoint union of all vertex spaces and all
edge cylinders; the generated equivalence relation identifies the zero end of
an edge cylinder with its tail vertex and the one end with the image in its
head vertex. The quotient carries the native quotient topology.

Existence of classifying-space models, continuity and induced-pi_1 correctness
of the chosen edge maps, independence of these choices, and the subsequent
K(G,1) theorem are result content. No such proposition is proved or required
as a constructor field in Sweep III.
-/

@[expose] public noncomputable section

open scoped Topology

namespace LeanCategories.Topology

universe uV uE uG uB

/-- Data of Hatcher's oriented graph of groups together with proof-free
topological realization choices.

The group homomorphism on an edge is retained as source data. The plain map
between the chosen vertex spaces is the topological representative selected
for that homomorphism; the theorem layer verifies continuity and the induced
fundamental-group comparison. -/
structure GraphOfGroupsTopologicalPresentationData
    (Vertex : Type uV) (Edge : Type uE)
    (tail head : Edge → Vertex)
    (G : Vertex → Type uG) [∀ v, Group (G v)] where
  edgeHom : (e : Edge) → G (tail e) →* G (head e)
  vertexSpace : Vertex → Type uB
  vertexTopology : (v : Vertex) → TopologicalSpace (vertexSpace v)
  vertexBasepoint : (v : Vertex) → vertexSpace v
  root : Vertex
  edgeMap : (e : Edge) → vertexSpace (tail e) → vertexSpace (head e)

/-- The disjoint union before attaching the cylinder endpoints. -/
abbrev GraphOfGroupsSpacePre
    {Vertex : Type uV} {Edge : Type uE}
    {tail head : Edge → Vertex}
    {G : Vertex → Type uG} [∀ v, Group (G v)]
    (D : GraphOfGroupsTopologicalPresentationData Vertex Edge tail head G) :=
  (Σ v, D.vertexSpace v) ⊕
    (Σ e, D.vertexSpace (tail e) × unitInterval)

/-- Generating identifications for the graph-of-spaces construction:
the zero end is attached to the tail vertex and the one end is attached via
the chosen edge map to the head vertex. -/
inductive GraphOfGroupsGlueRelData
    {Vertex : Type uV} {Edge : Type uE}
    {tail head : Edge → Vertex}
    {G : Vertex → Type uG} [∀ v, Group (G v)]
    (D : GraphOfGroupsTopologicalPresentationData Vertex Edge tail head G) :
    GraphOfGroupsSpacePre D → GraphOfGroupsSpacePre D → Prop
  | tail (e : Edge) (x : D.vertexSpace (tail e)) :
      GraphOfGroupsGlueRelData D
        (.inl ⟨tail e, x⟩)
        (.inr ⟨e, x, (0 : unitInterval)⟩)
  | head (e : Edge) (x : D.vertexSpace (tail e)) :
      GraphOfGroupsGlueRelData D
        (.inl ⟨head e, D.edgeMap e x⟩)
        (.inr ⟨e, x, (1 : unitInterval)⟩)

/-- The equivalence relation generated by the two endpoint attachments. -/
def graphOfGroupsSpaceSetoidData
    {Vertex : Type uV} {Edge : Type uE}
    {tail head : Edge → Vertex}
    {G : Vertex → Type uG} [∀ v, Group (G v)]
    (D : GraphOfGroupsTopologicalPresentationData Vertex Edge tail head G) :
    Setoid (GraphOfGroupsSpacePre D) :=
  Relation.EqvGen.setoid (GraphOfGroupsGlueRelData D)

/-- Hatcher's graph-of-classifying-spaces carrier K_Gamma. -/
abbrev GraphOfGroupsSpaceData
    {Vertex : Type uV} {Edge : Type uE}
    {tail head : Edge → Vertex}
    {G : Vertex → Type uG} [∀ v, Group (G v)]
    (D : GraphOfGroupsTopologicalPresentationData Vertex Edge tail head G) :=
  Quotient (graphOfGroupsSpaceSetoidData D)

/-- The coproduct topology on the vertex spaces and edge cylinders before
forming K_Gamma. -/
@[instance_reducible]
def graphOfGroupsSpacePreTopologyData
    {Vertex : Type uV} {Edge : Type uE}
    {tail head : Edge → Vertex}
    {G : Vertex → Type uG} [∀ v, Group (G v)]
    (D : GraphOfGroupsTopologicalPresentationData Vertex Edge tail head G) :
    TopologicalSpace (GraphOfGroupsSpacePre D) := by
  letI (v : Vertex) : TopologicalSpace (D.vertexSpace v) :=
    D.vertexTopology v
  infer_instance

/-- The quotient topology on K_Gamma. -/
noncomputable instance graphOfGroupsSpaceTopologyData
    {Vertex : Type uV} {Edge : Type uE}
    {tail head : Edge → Vertex}
    {G : Vertex → Type uG} [∀ v, Group (G v)]
    (D : GraphOfGroupsTopologicalPresentationData Vertex Edge tail head G) :
    TopologicalSpace (GraphOfGroupsSpaceData D) := by
  letI : TopologicalSpace (GraphOfGroupsSpacePre D) :=
    graphOfGroupsSpacePreTopologyData D
  infer_instance

/-- The chosen basepoint of K_Gamma, coming from the chosen root vertex. -/
def graphOfGroupsSpaceBasepointData
    {Vertex : Type uV} {Edge : Type uE}
    {tail head : Edge → Vertex}
    {G : Vertex → Type uG} [∀ v, Group (G v)]
    (D : GraphOfGroupsTopologicalPresentationData Vertex Edge tail head G) :
    GraphOfGroupsSpaceData D :=
  Quotient.mk _
    (.inl ⟨D.root, D.vertexBasepoint D.root⟩)

/-- Hatcher's graph product, i.e. the fundamental group pi_1(K_Gamma).

For a connected graph of groups the choice of root/basepoint is immaterial up
to the standard path-induced group equivalence; that is theorem content. -/
abbrev GraphProductData
    {Vertex : Type uV} {Edge : Type uE}
    {tail head : Edge → Vertex}
    {G : Vertex → Type uG} [∀ v, Group (G v)]
    (D : GraphOfGroupsTopologicalPresentationData Vertex Edge tail head G) :=
  FundamentalGroup (GraphOfGroupsSpaceData D)
    (graphOfGroupsSpaceBasepointData D)

end LeanCategories.Topology
