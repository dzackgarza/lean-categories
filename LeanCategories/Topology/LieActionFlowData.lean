module

public import LeanCategories.Topology.LieExponentialData

/-!
# Flows generated by right Lie-group actions

Definition-level realization of Lee FC08-C20-U016.

Once the Lie exponential from FC08-C20-U006 is available, Lee's construction
is the explicit formula `theta_X(t,p) = p · exp(tX)`.  The source assumes the
right action is smooth; proving that this formula is a smooth global flow uses
the exponential/one-parameter-subgroup results and belongs to the result layer.
-/

@[expose] public noncomputable section

namespace LeanCategories.Topology

open scoped Manifold ContDiff

universe u v w

/-- The raw time-dependent map generated by `X` through a supplied right
action, using Lee's already-realized Lie exponential. -/
def rightActionGeneratedFlowData
    {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {H : Type*} [TopologicalSpace H]
    {G : Type v} [TopologicalSpace G] [ChartedSpace H G] [Group G]
    {M : Type w}
    (I : ModelWithCorners ℝ E H) [LieGroup I ∞ G]
    (rightAction : M → G → M)
    (X : GroupLieAlgebra I G) : ℝ → M → M :=
  fun t p => rightAction p (lieExponentialData I (t • X))

end LeanCategories.Topology
