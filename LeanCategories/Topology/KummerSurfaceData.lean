module

public import LeanCategories.Lattices.Valued.ComplexTorus
public import LeanCategories.Topology.ComplexSurfaceResolutionData
public import Mathlib.Topology.Constructions

/-!
# Kummer-surface data

Definition-level realization of Peters--Sterk FC11-C05-U022 and
FC11-C20-U002.

For a complex torus `A`, the source defines `Km(A)` as the minimal
resolution of `A / ⟨-1⟩`.  The quotient itself is constructed here without
introducing a proof-bearing group-action bundle: the equivalence relation is
generated by the inversion identification `x ~ -x`.

The target library has no minimal-resolution construction for singular complex
analytic surfaces.  Following the repository's data/predicate boundary,
`KummerSurfaceResolutionData` is raw resolution data and
`IsKummerSurfaceResolutionData` states the defining minimal-resolution
conditions.  A Kummer surface datum is the subtype of raw data satisfying
that predicate.  Thus no arbitrary resolution candidate is selected before
the existence theorem.
-/

@[expose] public noncomputable section

namespace LeanCategories.Topology

open LeanCategories.Lattices.Valued

universe u

/-- The generating inversion identification on a complex torus. -/
def kummerInversionIdentification
    (A : ComplexTorus.{u}) (x y : A.carrier) : Prop :=
  y = -x

/-- The equivalence relation generated by `x ~ -x`. -/
def kummerInversionSetoid (A : ComplexTorus.{u}) : Setoid A.carrier :=
  Relation.EqvGen.setoid (kummerInversionIdentification A)

/-- The quotient carrier `A / ⟨-1⟩`. -/
abbrev KummerQuotient (A : ComplexTorus.{u}) : Type u :=
  Quotient (kummerInversionSetoid A)

/-- The quotient `A / ⟨-1⟩` with its quotient topology. -/
def kummerQuotientTopCat (A : ComplexTorus.{u}) : TopCat.{u} :=
  TopCat.of (KummerQuotient A)

/-- The canonical map from the torus to its inversion quotient. -/
def kummerQuotientMk (A : ComplexTorus.{u}) :
    A.carrier → KummerQuotient A :=
  Quotient.mk (kummerInversionSetoid A)

/-- Fixed points of the inversion map on the complex torus. -/
def kummerInversionFixedLocus (A : ComplexTorus.{u}) : Set A.carrier :=
  {x | -x = x}

/-- The image in `A / ⟨-1⟩` of the inversion fixed-point locus.

For a complex two-torus these are the sixteen quotient points resolved in the
Kummer construction; the cardinality and singularity assertions are result
content and are not asserted here. -/
def kummerFixedPointImage (A : ComplexTorus.{u}) :
    Set (kummerQuotientTopCat A) :=
  kummerQuotientMk A '' kummerInversionFixedLocus A

/-- Raw resolution data for the inversion quotient of a complex torus. -/
abbrev KummerSurfaceResolutionData (A : ComplexTorus.{u}) :=
  ComplexSurfaceResolutionData (kummerQuotientTopCat A)

/-- Peters--Sterk's defining condition for Kummer-surface resolution data:
the data are a minimal complex-surface resolution of the inversion quotient,
biholomorphic away from the image of the inversion fixed points. -/
def IsKummerSurfaceResolutionData
    (I : ComplexSurfaceResolutionInterface.{u})
    (A : ComplexTorus.{u})
    (R : KummerSurfaceResolutionData A) : Prop :=
  IsMinimalComplexSurfaceResolutionData I (kummerFixedPointImage A) R

/-- Source-faithful Kummer-surface data: a minimal complex-surface resolution
of the inversion quotient together with its defining property.  Existence of
such data for every complex two-torus is theorem content; the definition does
not select an unrelated raw candidate in its absence. -/
abbrev KummerSurfaceData
    (I : ComplexSurfaceResolutionInterface.{u})
    (A : ComplexTorus.{u}) :=
  {R : KummerSurfaceResolutionData A // IsKummerSurfaceResolutionData I A R}

/-- The source surface of supplied source-faithful Kummer-resolution data,
corresponding to the source notation `Km(A)`. -/
abbrev KummerSurface
    (I : ComplexSurfaceResolutionInterface.{u})
    {A : ComplexTorus.{u}} (D : KummerSurfaceData I A) : TopCat.{u} :=
  D.1.source

/-- The resolution map from supplied Kummer-surface data to
`A / ⟨-1⟩`. -/
def kummerSurfaceResolutionMap
    (I : ComplexSurfaceResolutionInterface.{u})
    {A : ComplexTorus.{u}} (D : KummerSurfaceData I A) :
    KummerSurface I D → kummerQuotientTopCat A :=
  D.1.map

/-- The source domain on which the canonical torus-to-Kummer rational map is
represented without the sixteen inversion-fixed points.

The source later proves that these are exactly the points over which the
quotient has to be resolved.  Their cardinality and the density of this
complement are result content. -/
def kummerCanonicalRationalMapDomainData
    (A : ComplexTorus.{u}) : Set A.carrier :=
  (kummerInversionFixedLocus A)ᶜ

/-- Exact graph of the canonical rational map from a complex torus to its
selected Kummer surface.

A torus point x and a Kummer-surface point y are related precisely when they
have the same image in the inversion quotient:

    resolution(y) = quotient(x).

Restricting x to the complement of the inversion-fixed locus is the source
regular domain.  Proving that this relation is single-valued there, hence gives
the canonical rational map, and that the resulting rational map has degree two
are result-layer obligations. -/
def kummerCanonicalRationalMapGraphData
    (I : ComplexSurfaceResolutionInterface.{u})
    {A : ComplexTorus.{u}} (D : KummerSurfaceData I A) :
    Set (A.carrier × KummerSurface I D) :=
  {p |
    p.1 ∈ kummerCanonicalRationalMapDomainData A ∧
      kummerSurfaceResolutionMap I D p.2 = kummerQuotientMk A p.1}

end LeanCategories.Topology
