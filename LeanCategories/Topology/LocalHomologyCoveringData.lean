module

public import LeanCategories.Topology.OrientationData
public import Mathlib.Geometry.Manifold.Instances.Real
public import Mathlib.Topology.Bases

/-!
# Local-homology covering data

Definition-level realization of Hatcher FC07-C03-U043.

For an n-manifold M and coefficient ring R, form the disjoint union of the
local homology groups H_n(M,M minus {x};R). Hatcher topologizes this total
space using the images, over coordinate balls B, of single classes in
H_n(M,M minus B;R). The projection to M is then proved to be a covering.

The selected relative-homology maps required to write these image sets are
provided by OrientationData without a quotient-descent proof. This file
therefore realizes the carrier, the source generating sets, the generated
topology, the projection, and the definition of a section. The assertion that
the projection is a covering is a theorem and is not included in Sweep III.
-/

@[expose] public noncomputable section

open Metric

namespace LeanCategories.Topology

/-- The standard Euclidean open unit ball used to phrase Hatcher's coordinate
ball condition. -/
abbrev EuclideanCoordinateBallData (n : ℕ) :=
  Metric.ball (0 : EuclideanSpace ℝ (Fin n)) 1

/-- A coordinate ball in an n-manifold, expressed intrinsically as an open
subset homeomorphic to the standard open n-ball. -/
def IsCoordinateBallData
    (n : ℕ) (M : Type) [TopologicalSpace M] (B : Set M) : Prop :=
  IsOpen B ∧
    Nonempty (B ≃ₜ EuclideanCoordinateBallData n)

/-- The disjoint union of local homology groups over the points of M. -/
abbrev LocalHomologyCoveringCarrierData
    (R : Type) [CommRing R]
    (n : ℕ) (M : Type) [TopologicalSpace M] :=
  Σ x : M, localHomologyModule R n M x

/-- The source basic set associated to a coordinate neighborhood B and one
class in H_n(M,M minus B;R). -/
def localHomologyCoveringBasicSetData
    (R : Type) [CommRing R]
    (n : ℕ) (M : Type) [TopologicalSpace M]
    (B : Set M)
    (muB : relativeSingularHomologyModule R n M Bᶜ) :
    Set (LocalHomologyCoveringCarrierData R n M) :=
  {a |
    a.1 ∈ B ∧
      a.2 =
        (relativeSingularRestrictionHomologyMapData
          R n M Bᶜ ({a.1} : Set M)ᶜ).hom muB}

/-- Hatcher's family of generating sets for the topology of the local-homology
total space. -/
def localHomologyCoveringGeneratingSetsData
    (R : Type) [CommRing R]
    (n : ℕ) (M : Type) [TopologicalSpace M] :
    Set (Set (LocalHomologyCoveringCarrierData R n M)) :=
  {S |
    ∃ B : Set M,
      IsCoordinateBallData n M B ∧
        ∃ muB : relativeSingularHomologyModule R n M Bᶜ,
          S = localHomologyCoveringBasicSetData R n M B muB}

/-- The topology generated by Hatcher's local-homology basic sets. -/
noncomputable instance localHomologyCoveringTopologyData
    (R : Type) [CommRing R]
    (n : ℕ) (M : Type) [TopologicalSpace M] :
    TopologicalSpace (LocalHomologyCoveringCarrierData R n M) :=
  TopologicalSpace.generateFrom
    (localHomologyCoveringGeneratingSetsData R n M)

/-- Projection from the local-homology total space to M. -/
def localHomologyCoveringProjectionData
    (R : Type) [CommRing R]
    (n : ℕ) (M : Type) [TopologicalSpace M] :
    LocalHomologyCoveringCarrierData R n M → M :=
  Sigma.fst

/-- A section is exactly a continuous right inverse to the local-homology
projection. -/
def IsLocalHomologyCoveringSectionData
    (R : Type) [CommRing R]
    (n : ℕ) (M : Type) [TopologicalSpace M]
    (s : M → LocalHomologyCoveringCarrierData R n M) : Prop :=
  Continuous s ∧
    ∀ x : M, localHomologyCoveringProjectionData R n M (s x) = x

/-- Hatcher's integral local-homology total space M_Z. -/
abbrev IntegralLocalHomologyCoveringData
    (n : ℕ) (M : Type) [TopologicalSpace M] :=
  LocalHomologyCoveringCarrierData ℤ n M

/-- Hatcher's definition of a section of M_Z to M. -/
abbrev IsIntegralLocalHomologyCoveringSectionData
    (n : ℕ) (M : Type) [TopologicalSpace M]
    (s : M → IntegralLocalHomologyCoveringData n M) : Prop :=
  IsLocalHomologyCoveringSectionData ℤ n M s

end LeanCategories.Topology
