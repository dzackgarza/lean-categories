module

public import Mathlib.Analysis.Complex.Basic
public import Mathlib.RingTheory.RootsOfUnity.Basic
public import Mathlib.Topology.Category.TopCat.Basic
public import Mathlib.Topology.Constructions

/-!
# Hirzebruch--Jung quotient data

Definition-level realization of Peters--Sterk FC11-C04-U055.

The source quotient is obtained from `ℂ²` by the diagonal action
`ρ_{t,s}(ζ)(z₁,z₂) = (ζ z₁, ζ^s z₂)` of the group `μ_t` of `t`-th roots
of unity.  Its distinguished point is the orbit of the origin; the source
denotes the resulting quotient singularity by `A_{t,s}`.

The target library has roots of unity and quotient topologies but no
complex-analytic quotient-germ/surface-singularity owner.  Sweep III therefore
constructs the diagonal transformations, their orbit equivalence relation, the
topological quotient, and the distinguished origin.  The assertion that this
point is an isolated complex-analytic surface singularity is result/analytic
structure content and is not asserted here.
-/

@[expose] public noncomputable section

namespace LeanCategories.Topology

/-- The affine complex plane used in the Hirzebruch--Jung quotient. -/
abbrev HirzebruchJungPlane : Type := ℂ × ℂ

/-- The source diagonal transformation
`ρ_{t,s}(ζ)(z₁,z₂) = (ζ z₁, ζ^s z₂)`.

The parameter `t` enters through the type `rootsOfUnity t ℂ`; no choice of a
primitive root is made. -/
def hirzebruchJungRho (t s : ℕ) (ζ : rootsOfUnity t ℂ)
    (z : HirzebruchJungPlane) : HirzebruchJungPlane :=
  let ξ : ℂ := ((ζ : ℂˣ) : ℂ)
  (ξ * z.1, ξ ^ s * z.2)

/-- A generating identification for the diagonal `μ_t` quotient. -/
def hirzebruchJungIdentification (t s : ℕ)
    (z w : HirzebruchJungPlane) : Prop :=
  ∃ ζ : rootsOfUnity t ℂ, w = hirzebruchJungRho t s ζ z

/-- The orbit equivalence relation generated by the source diagonal
transformations.

Using the generated equivalence relation avoids introducing a bespoke
`MulAction` merely to obtain its law proofs; the quotient data are exactly the
orbits generated by the displayed source transformations. -/
def hirzebruchJungSetoid (t s : ℕ) : Setoid HirzebruchJungPlane :=
  Relation.EqvGen.setoid (hirzebruchJungIdentification t s)

/-- The carrier of `W_{t,s} = ℂ² / ρ_{t,s}(μ_t)`. -/
abbrev HirzebruchJungQuotient (t s : ℕ) : Type :=
  Quotient (hirzebruchJungSetoid t s)

/-- The quotient `W_{t,s}` with its quotient topology. -/
def hirzebruchJungQuotientTopCat (t s : ℕ) : TopCat :=
  TopCat.of (HirzebruchJungQuotient t s)

/-- The distinguished orbit of the origin in `W_{t,s}`. -/
def hirzebruchJungOrigin (t s : ℕ) : HirzebruchJungQuotient t s :=
  Quotient.mk (hirzebruchJungSetoid t s) (0, 0)

/-- Definition-level data underlying the source notation `A_{t,s}`:
the quotient `W_{t,s}` together with the distinguished orbit of the origin.

Calling this pointed quotient an isolated analytic surface singularity requires
the analytic result layer and is intentionally not a field of this structure. -/
structure HirzebruchJungSingularityData (t s : ℕ) where
  space : TopCat
  origin : space

/-- The canonical pointed quotient underlying the Hirzebruch--Jung
singularity `A_{t,s}`. -/
def hirzebruchJungSingularityData (t s : ℕ) :
    HirzebruchJungSingularityData t s where
  space := hirzebruchJungQuotientTopCat t s
  origin := by
    change HirzebruchJungQuotient t s
    exact hirzebruchJungOrigin t s

end LeanCategories.Topology
