/-!
# Canonical integral curves of invariant vector fields

The construction is adapted from TauCeti's Apache-2.0
`Geometry/Lie/{InvariantVectorField/Basic,IntegralCurve}.lean`.  It supplies the
actual canonical global integral curve and generated one-parameter subgroup
needed by Lee FC08-C20-U003/U006, rather than accepting either object as input.
-/

@[expose] public section

open Bundle Function Manifold Set VectorField
open scoped ContDiff Manifold Topology

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {G : Type*} [TopologicalSpace G] [ChartedSpace H G] [Group G]

namespace LeanCategories.Topology

/-- At the identity, the left-invariant vector field generated by `v` is `v`. -/
@[simp] theorem mulInvariantVectorField_one_data (v : GroupLieAlgebra I G) :
    mulInvariantVectorField v (1 : G) = v := by
  change mfderiv I I (fun x : G => 1 * x) 1 v = v
  rw [show (fun x : G => 1 * x) = id by funext x; simp, mfderiv_id]
  rfl

/-- Left translation intertwines a left-invariant vector field with itself. -/
@[simp] theorem mfderiv_mul_left_mulInvariantVectorField_data [ContMDiffMul I 1 G]
    (g x : G) (v : GroupLieAlgebra I G) :
    mfderiv I I (fun y : G => g * y) x (mulInvariantVectorField v x) =
      mulInvariantVectorField v (g * x) := by
  simp only [mulInvariantVectorField]
  rw [← mfderiv_comp_apply_of_eq (I' := I) (f := fun y : G => x * y)
    (g := fun y : G => g * y) (y := x) (1 : G)
    (mdifferentiableAt_mul_left (a := g)) (mdifferentiableAt_mul_left (a := x)) (by simp)]
  rw [show (fun y : G => g * y) ∘ (fun y : G => x * y) =
      (fun y : G => (g * x) * y) by
    funext y
    simp [mul_assoc]]

/-- The zero tangent vector over a smoothly varying point varies smoothly. -/
theorem contMDiff_tangentBundle_mk_zero_data
    {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
    {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ E' H'}
    {N : Type*} [TopologicalSpace N] [ChartedSpace H' N]
    {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 1 M]
    {n : ℕ∞ω} {f : N → M} (hf : ContMDiff J I n f) :
    ContMDiff J I.tangent n
      (fun p => TotalSpace.mk' E (f p) 0 : N → TangentBundle I M) :=
  (contMDiff_zeroSection ℝ (TangentSpace I : M → Type _)).comp hf

/-- A varying model vector over a fixed point gives a smooth tangent-bundle map. -/
theorem contMDiff_tangentBundle_mk_constBase_data
    {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
    {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ E' H'}
    {N : Type*} [TopologicalSpace N] [ChartedSpace H' N]
    {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I 1 M]
    {n : ℕ∞ω} {v : N → E} (hv : ContMDiff J 𝓘(ℝ, E) n v) (x : M) :
    ContMDiff J I.tangent n
      (fun p => TotalSpace.mk' E x (v p) : N → TangentBundle I M) := by
  intro p
  rw [Bundle.contMDiffAt_totalSpace]
  constructor
  · exact contMDiffAt_const
  · have hx : x ∈ (extChartAt I x).source := mem_extChartAt_source _
    have hfun :
        (fun q : N =>
          (trivializationAt E (TangentSpace I) x (TotalSpace.mk' E x (v q))).2) = v := by
      funext q
      rw [TangentBundle.trivializationAt_apply]
      change tangentCoordChange I x x x (v q) = v q
      rw [tangentCoordChange_self hx]
    rw [hfun]
    exact hv p

/-- The tangent map of multiplication, expressed on a pair of tangent bundles, is smooth. -/
theorem contMDiff_tangentMap_mul_prod_data {m n : ℕ∞ω}
    [ContMDiffMul I n G] (hmn : m + 1 ≤ n) :
    let _ : IsManifold I 1 G := IsManifold.of_le (le_add_self.trans hmn)
    ContMDiff (I.tangent.prod I.tangent) I.tangent m
      ((tangentMap% (fun p : G × G => p.1 * p.2)) ∘
        (equivTangentBundleProd I G I G).symm) := by
  let _ : IsManifold I 1 G := IsManifold.of_le (le_add_self.trans hmn)
  exact ((contMDiff_mul I n).contMDiff_tangentMap hmn).comp
    contMDiff_equivTangentBundleProd_symm

@[simp] theorem tangentMap_mul_prod_apply_data [ContMDiffMul I 1 G]
    (p q : TangentBundle I G) :
    (tangentMap% (fun r : G × G => r.1 * r.2))
      ((equivTangentBundleProd I G I G).symm (p, q)) =
      ⟨p.proj * q.proj,
        mfderiv% (· * q.proj) p.proj p.2 + mfderiv% (p.proj * ·) q.proj q.2⟩ := by
  simp only [tangentMap]
  rw [mfderiv_prod_eq_add_apply ((contMDiff_mul I 1).mdifferentiableAt (by simp))]
  simp +instances [equivTangentBundleProd]

/-- Feed two smoothly varying tangent vectors into the tangent map of multiplication. -/
theorem contMDiff_tangentMap_mul_prod_comp_data
    {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
    {H' : Type*} [TopologicalSpace H'] {J : ModelWithCorners ℝ E' H'}
    {M : Type*} [TopologicalSpace M] [ChartedSpace H' M]
    {m n : ℕ∞ω} [ContMDiffMul I n G] (hmn : m + 1 ≤ n)
    (f g : M → TangentBundle I G) :
    let _ : IsManifold I 1 G := IsManifold.of_le (le_add_self.trans hmn)
    ContMDiff J I.tangent m f →
      ContMDiff J I.tangent m g →
      ContMDiff J I.tangent m
        (fun p => (tangentMap% (fun q : G × G => q.1 * q.2))
          ((equivTangentBundleProd I G I G).symm (f p, g p))) := by
  dsimp only
  intro hf hg
  let _ : IsManifold I 1 G := IsManifold.of_le (le_add_self.trans hmn)
  simpa only [Function.comp_def] using
    (contMDiff_tangentMap_mul_prod_data (I := I) (G := G) hmn).comp (hf.prodMk hg)

/-- Joint smoothness of the invariant vector field in generator and group point. -/
theorem contMDiff_mulInvariantVectorField_modelSpace_data {m n : ℕ∞ω}
    [ContMDiffMul I n G] (hmn : m + 1 ≤ n) :
    let _ : IsManifold I 1 G := IsManifold.of_le (le_add_self.trans hmn)
    ContMDiff (𝓘(ℝ, E).prod I) I.tangent m
      (fun p : E × G =>
        (mulInvariantVectorField (I := I) (G := G) p.1 p.2 : TangentBundle I G)) := by
  let _ : IsManifold I 1 G := IsManifold.of_le (le_add_self.trans hmn)
  let fg : E × G → TangentBundle I G := fun p => TotalSpace.mk' E p.2 0
  have sfg : ContMDiff (𝓘(ℝ, E).prod I) I.tangent m fg := by
    simpa only [fg] using
      contMDiff_tangentBundle_mk_zero_data (I := I) (n := m) contMDiff_snd
  let fv : E × G → TangentBundle I G := fun p => TotalSpace.mk' E 1 p.1
  have sfv : ContMDiff (𝓘(ℝ, E).prod I) I.tangent m fv := by
    simpa only [fv] using
      contMDiff_tangentBundle_mk_constBase_data (I := I) (n := m) contMDiff_fst (1 : G)
  let S := contMDiff_tangentMap_mul_prod_comp_data (I := I) (G := G) hmn fg fv sfg sfv
  apply S.congr
  intro p
  let _ : ContMDiffMul I 1 G :=
    ContMDiffMul.of_le (m := 1) (n := n) (le_add_self.trans hmn)
  rw [tangentMap_mul_prod_apply_data]
  simp +instances only [mulInvariantVectorField, map_zero, zero_add, fg, fv]
  rw [mul_one]

/-- On a smooth Lie group, every invariant vector field is smooth. -/
theorem contMDiff_mulInvariantVectorField_infty_data [ContMDiffMul I ∞ G]
    (v : GroupLieAlgebra I G) :
    ContMDiff I I.tangent ∞
      (fun g : G => (mulInvariantVectorField v g : TangentBundle I G)) := by
  have h := contMDiff_mulInvariantVectorField_modelSpace_data
    (I := I) (G := G) (m := ∞) (n := ∞) (by simp)
  exact h.comp (contMDiff_const.prodMk contMDiff_id)

private theorem contDiffOn_succ_of_hasDerivAt_comp_data
    {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {n : ℕ} {f : ℝ → F} {v : F → F} {s : Set ℝ} {u : Set F}
    (hs : IsOpen s) (hv : ContDiffOn ℝ n v u) (hfu : MapsTo f s u)
    (hf : ∀ t ∈ s, HasDerivAt f (v (f t)) t) :
    ContDiffOn ℝ (n + 1 : ℕ) f s := by
  induction n generalizing f with
  | zero =>
      have h : ContDiffOn ℝ ((0 : ℕ∞ω) + 1) f s := by
        rw [contDiffOn_succ_iff_deriv_of_isOpen hs]
        refine ⟨fun t ht => (hf t ht).differentiableAt.differentiableWithinAt, by simp, ?_⟩
        apply (hv.comp (contDiffOn_zero.mpr ?_) hfu).congr
        · exact fun t ht => (hf t ht).deriv
        · exact fun t ht => (hf t ht).continuousAt.continuousWithinAt
      simpa using h
  | succ n ih =>
      have hfn : ContDiffOn ℝ (n + 1 : ℕ) f s :=
        ih (hv.of_le (by exact_mod_cast Nat.le_succ n)) hfu hf
      have h : ContDiffOn ℝ (((n + 1 : ℕ) : ℕ∞ω) + 1) f s := by
        rw [contDiffOn_succ_iff_deriv_of_isOpen hs]
        refine ⟨fun t ht => (hf t ht).differentiableAt.differentiableWithinAt, by simp, ?_⟩
        exact (hv.comp hfn hfu).congr fun t ht => (hf t ht).deriv
      simpa only [Nat.cast_add, Nat.cast_one, Nat.succ_eq_add_one] using h

namespace IsMIntegralCurve

/-- A `C^n` vector field has `C^(n+1)` integral curves. -/
theorem contMDiff_succ_data
    {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [BoundarylessManifold I M]
    (n : ℕ) [IsManifold I (n + 1 : ℕ) M]
    {γ : ℝ → M} {v : (x : M) → TangentSpace I x}
    (hγ : IsMIntegralCurve γ v)
    (hv : let _ : IsManifold I 1 M := IsManifold.of_le (n := (n + 1 : ℕ)) (by
      exact_mod_cast Nat.succ_le_succ (Nat.zero_le n));
      CMDiff n (fun x => (⟨x, v x⟩ : TangentBundle I M))) :
    ContMDiff 𝓘(ℝ, ℝ) I (n + 1 : ℕ) γ := by
  let _ : IsManifold I 1 M := IsManifold.of_le (n := (n + 1 : ℕ)) (by
    exact_mod_cast Nat.succ_le_succ (Nat.zero_le n))
  change CMDiff n (fun x => (⟨x, v x⟩ : TangentBundle I M)) at hv
  intro t₀
  rw [contMDiffAt_iff_target]
  refine ⟨hγ.continuous.continuousAt, ?_⟩
  let c : ℝ → E := (extChartAt I (γ t₀)) ∘ γ
  let v' : E → E := fun x =>
    tangentCoordChange I ((extChartAt I (γ t₀)).symm x) (γ t₀)
      ((extChartAt I (γ t₀)).symm x) (v ((extChartAt I (γ t₀)).symm x))
  have hv' : ContDiffAt ℝ n v' (extChartAt I (γ t₀) (γ t₀)) := by
    have hv₀ := hv.contMDiffAt (x := γ t₀)
    rw [contMDiffAt_iff] at hv₀
    exact (hv₀.2.contDiffAt
      (range_mem_nhds_isInteriorPoint BoundarylessManifold.isInteriorPoint)).snd
  obtain ⟨u, hxu, hvu⟩ := hv'.contDiffOn le_rfl (by simp)
  have hcsrc : ∀ᶠ t in 𝓝 t₀, γ t ∈ (extChartAt I (γ t₀)).source :=
    hγ.continuous.continuousAt.preimage_mem_nhds (extChartAt_source_mem_nhds (I := I) _)
  have hderiv : ∀ᶠ t in 𝓝 t₀, HasDerivAt c (v' (c t)) t :=
    (hγ.isMIntegralCurveAt t₀).eventually_hasDerivAt.and hcsrc |>.mono fun t ht => by
      apply ht.1.congr_deriv
      simp only [v', c, Function.comp_apply]
      rw [PartialEquiv.left_inv _ ht.2]
  have hcu : ∀ᶠ t in 𝓝 t₀, c t ∈ u :=
    ((continuousAt_extChartAt (γ t₀)).comp hγ.continuous.continuousAt).eventually hxu
  have hall : {t | HasDerivAt c (v' (c t)) t ∧ c t ∈ u} ∈ 𝓝 t₀ :=
    hderiv.and hcu
  obtain ⟨s, hsP, hsopen, hst₀⟩ := mem_nhds_iff.mp hall
  have hc : ContDiffAt ℝ (n + 1 : ℕ) c t₀ :=
    (contDiffOn_succ_of_hasDerivAt_comp_data hsopen hvu (fun t ht => (hsP ht).2)
      (fun t ht => (hsP ht).1)).contDiffAt (hsopen.mem_nhds hst₀)
  have hc' : ContDiffAt ℝ (n + 1 : ℕ) ((extChartAt I (γ t₀)) ∘ γ) t₀ :=
    by simpa only [c] using hc
  exact hc'.contMDiffAt

/-- Integral curves of smooth vector fields on boundaryless smooth manifolds are smooth. -/
theorem contMDiff_data
    {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
    [BoundarylessManifold I M] [IsManifold I ∞ M]
    {γ : ℝ → M} {v : (x : M) → TangentSpace I x}
    (hγ : IsMIntegralCurve γ v)
    (hv : CMDiff ∞ (fun x => (⟨x, v x⟩ : TangentBundle I M))) :
    ContMDiff 𝓘(ℝ, ℝ) I ∞ γ := by
  rw [contMDiff_infty]
  intro n
  let _ : IsManifold I (n + 1 : ℕ) M := IsManifold.of_le (n := ∞)
    (by exact_mod_cast le_top)
  exact (contMDiff_succ_data n hγ (hv.of_le (by exact_mod_cast le_top))).of_le
    (by exact_mod_cast Nat.le_succ n)

end IsMIntegralCurve

namespace IsMIntegralCurveOn

/-- A differentiable map intertwining vector fields sends integral curves to integral curves. -/
theorem map_of_mfderiv_eq_data
    {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
    {H' : Type*} [TopologicalSpace H'] {I' : ModelWithCorners ℝ E' H'}
    {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
    {M' : Type*} [TopologicalSpace M'] [ChartedSpace H' M']
    {f : M → M'} {V : (x : M) → TangentSpace I x}
    {W : (x : M') → TangentSpace I' x} {γ : ℝ → M} {s : Set ℝ}
    (hf : ∀ t ∈ s, MDifferentiableAt I I' f (γ t))
    (hVW : ∀ t ∈ s, mfderiv I I' f (γ t) (V (γ t)) = W (f (γ t)))
    (hγ : IsMIntegralCurveOn γ V s) : IsMIntegralCurveOn (f ∘ γ) W s := by
  intro t ht
  have hder :
      (mfderiv I I' f (γ t)).comp ((1 : ℝ →L[ℝ] ℝ).smulRight (V (γ t))) =
        (1 : ℝ →L[ℝ] ℝ).smulRight (W (f (γ t))) := by
    rw [ContinuousLinearMap.smulRight_one_eq_toSpanSingleton,
      ContinuousLinearMap.smulRight_one_eq_toSpanSingleton,
      ContinuousLinearMap.comp_toSpanSingleton, hVW t ht]
  change HasMFDerivAt[s] (f ∘ γ) t
    ((1 : ℝ →L[ℝ] ℝ).smulRight (W (f (γ t))))
  rw [← hder]
  exact (hf t ht).hasMFDerivAt.comp_hasMFDerivWithinAt t (hγ t ht)

/-- Left translation preserves integral curves of left-invariant vector fields. -/
theorem const_mul_mulInvariantVectorField_data [ContMDiffMul I 1 G]
    {v : GroupLieAlgebra I G} {γ : ℝ → G} {s : Set ℝ}
    (hγ : IsMIntegralCurveOn γ (mulInvariantVectorField v) s) (g : G) :
    IsMIntegralCurveOn (fun t => g * γ t) (mulInvariantVectorField v) s := by
  have hpush := map_of_mfderiv_eq_data (f := fun x : G => g * x)
    (fun _ _ => mdifferentiableAt_mul_left)
    (fun t _ => mfderiv_mul_left_mulInvariantVectorField_data g (γ t) v)
    hγ
  change IsMIntegralCurveOn ((fun x : G => g * x) ∘ γ)
    (mulInvariantVectorField v) s
  exact hpush

end IsMIntegralCurveOn

namespace IsMIntegralCurve

/-- Global left translation preserves invariant integral curves. -/
theorem const_mul_mulInvariantVectorField_data [ContMDiffMul I 1 G]
    {v : GroupLieAlgebra I G} {γ : ℝ → G}
    (hγ : IsMIntegralCurve γ (mulInvariantVectorField v)) (g : G) :
    IsMIntegralCurve (fun t => g * γ t) (mulInvariantVectorField v) := by
  rw [isMIntegralCurve_iff_isMIntegralCurveOn]
  exact IsMIntegralCurveOn.const_mul_mulInvariantVectorField_data
    (hγ.isMIntegralCurveOn univ) g

end IsMIntegralCurve

/-- Every left-invariant vector field has a global integral curve through every point. -/
theorem exists_isMIntegralCurve_mulInvariantVectorField_data [CompleteSpace E]
    [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G]
    [BoundarylessManifold I G] (v : GroupLieAlgebra I G) (x : G) :
    ∃ γ : ℝ → G, γ 0 = x ∧ IsMIntegralCurve γ (mulInvariantVectorField v) := by
  let V := mulInvariantVectorField v
  have hV : CMDiff 1 (fun g => (⟨g, V g⟩ : TangentBundle I G)) :=
    (contMDiff_mulInvariantVectorField v).of_le (by simp)
  obtain ⟨γ, hγ0, hγ⟩ :=
    exists_isMIntegralCurveAt_of_contMDiffAt_boundaryless (x₀ := (1 : G)) 0 hV.contMDiffAt
  obtain ⟨ε, hε, hγ⟩ := isMIntegralCurveAt_iff'.mp hγ
  rw [Real.ball_eq_Ioo] at hγ
  have hγ : IsMIntegralCurveOn γ V (Ioo (-ε) ε) := by
    simpa only [zero_sub, zero_add] using hγ
  apply exists_isMIntegralCurve_of_isMIntegralCurveOn hV hε
  intro y
  refine ⟨fun t => y * γ t, by simp [hγ0], ?_⟩
  let _ : ContMDiffMul I 1 G :=
    ContMDiffMul.of_le (m := 1) (n := minSmoothness ℝ 3) (by norm_num)
  exact IsMIntegralCurveOn.const_mul_mulInvariantVectorField_data hγ y

/-- The global invariant integral curve through a point is unique. -/
theorem existsUnique_isMIntegralCurve_mulInvariantVectorField_data [CompleteSpace E]
    [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G]
    [BoundarylessManifold I G] (v : GroupLieAlgebra I G) (x : G) :
    ∃! γ : ℝ → G, γ 0 = x ∧ IsMIntegralCurve γ (mulInvariantVectorField v) := by
  obtain ⟨γ, hγ0, hγ⟩ := exists_isMIntegralCurve_mulInvariantVectorField_data v x
  refine ⟨γ, ⟨hγ0, hγ⟩, ?_⟩
  intro δ hδ
  apply isMIntegralCurve_Ioo_eq_of_contMDiff_boundaryless (t₀ := 0)
    ((contMDiff_mulInvariantVectorField v).of_le (by simp)) hδ.2 hγ
  rw [hδ.1, hγ0]

/-- The canonical global integral curve of the invariant field generated by `v`. -/
noncomputable def mulInvariantIntegralCurveData [CompleteSpace E]
    [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G]
    [BoundarylessManifold I G] (v : GroupLieAlgebra I G) (x : G) : ℝ → G :=
  (existsUnique_isMIntegralCurve_mulInvariantVectorField_data v x).choose

@[simp] theorem mulInvariantIntegralCurveData_zero [CompleteSpace E]
    [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G]
    [BoundarylessManifold I G] (v : GroupLieAlgebra I G) (x : G) :
    mulInvariantIntegralCurveData v x 0 = x :=
  (existsUnique_isMIntegralCurve_mulInvariantVectorField_data v x).choose_spec.1.1

theorem isMIntegralCurve_mulInvariantIntegralCurveData [CompleteSpace E]
    [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G]
    [BoundarylessManifold I G] (v : GroupLieAlgebra I G) (x : G) :
    IsMIntegralCurve (mulInvariantIntegralCurveData v x) (mulInvariantVectorField v) :=
  (existsUnique_isMIntegralCurve_mulInvariantVectorField_data v x).choose_spec.1.2

/-- The canonical curve through `x` is the left translate of the identity curve. -/
theorem mulInvariantIntegralCurveData_eq_const_mul [CompleteSpace E]
    [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G]
    [BoundarylessManifold I G] (v : GroupLieAlgebra I G) (x : G) :
    mulInvariantIntegralCurveData v x =
      fun t => x * mulInvariantIntegralCurveData v 1 t := by
  symm
  apply (existsUnique_isMIntegralCurve_mulInvariantVectorField_data v x).unique
  · constructor
    · simp
    · let _ : ContMDiffMul I 1 G :=
        ContMDiffMul.of_le (m := 1) (n := minSmoothness ℝ 3) (by norm_num)
      exact IsMIntegralCurve.const_mul_mulInvariantVectorField_data
        (isMIntegralCurve_mulInvariantIntegralCurveData v 1) x
  · exact (existsUnique_isMIntegralCurve_mulInvariantVectorField_data v x).choose_spec.1

/-- The identity curve satisfies the one-parameter subgroup law. -/
@[simp] theorem mulInvariantIntegralCurveData_add [CompleteSpace E]
    [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G]
    [BoundarylessManifold I G] (v : GroupLieAlgebra I G) (s t : ℝ) :
    mulInvariantIntegralCurveData v 1 (s + t) =
      mulInvariantIntegralCurveData v 1 s * mulInvariantIntegralCurveData v 1 t := by
  let γ := mulInvariantIntegralCurveData v 1
  have hshift : γ ∘ (· + s) = mulInvariantIntegralCurveData v (γ s) := by
    apply (existsUnique_isMIntegralCurve_mulInvariantVectorField_data v (γ s)).unique
    · constructor
      · simp [γ]
      · exact (isMIntegralCurve_mulInvariantIntegralCurveData v 1).comp_add s
    · exact (existsUnique_isMIntegralCurve_mulInvariantVectorField_data v (γ s)).choose_spec.1
  calc
    γ (s + t) = (γ ∘ (· + s)) t := by simp [add_comm]
    _ = mulInvariantIntegralCurveData v (γ s) t := congrFun hshift t
    _ = γ s * γ t := congrFun (mulInvariantIntegralCurveData_eq_const_mul v (γ s)) t

/-- The canonical identity curve bundled as a continuous one-parameter subgroup. -/
noncomputable def mulInvariantOneParameterSubgroupData [CompleteSpace E]
    [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G]
    [BoundarylessManifold I G] (v : GroupLieAlgebra I G) :
    ContinuousMonoidHom (Multiplicative ℝ) G where
  toFun t := mulInvariantIntegralCurveData v 1 (Multiplicative.toAdd t)
  map_one' := by simp
  map_mul' s t := by simp
  continuous_toFun :=
    (isMIntegralCurve_mulInvariantIntegralCurveData v 1).continuous.comp continuous_toAdd

@[simp] theorem mulInvariantOneParameterSubgroupData_apply [CompleteSpace E]
    [LieGroup I (minSmoothness ℝ 3) G] [IsManifold I 1 G] [T2Space G]
    [BoundarylessManifold I G] (v : GroupLieAlgebra I G) (t : ℝ) :
    mulInvariantOneParameterSubgroupData v (Multiplicative.ofAdd t) =
      mulInvariantIntegralCurveData v 1 t := rfl

end LeanCategories.Topology
