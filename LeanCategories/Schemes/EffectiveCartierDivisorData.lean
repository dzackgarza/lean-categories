module

public import LeanCategories.Schemes.CartierLineBundleData
public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme

/-!
# Effective Cartier divisor data

Definition-level realization of Hartshorne FC06-C02-U198.

An effective Cartier divisor is a Cartier divisor admitting local equations
that are regular functions.  Since those equations represent units of the
total quotient sheaf, the corresponding regular functions are the local
non-zero-divisor generators of the associated ideal sheaf.  That ideal sheaf
defines the associated closed subscheme through Mathlib's native
`Scheme.IdealSheafData.subscheme` construction.

Sweep III records these clauses as predicates.  Compatibility of the local
generators and existence of the associated ideal sheaf are part of the later
locally-principal closed-subscheme result (FC06-C02-U199), so no ideal sheaf
is selected before that result is available.  Local principality, codimension
statements, and the bijection with locally principal closed subschemes likewise
remain result-layer content.
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry

namespace LeanCategories.Schemes

universe u

variable {X : Scheme.{u}}

/-- A local equation of a Cartier divisor is regular when it comes from a
regular section which is a non-zero-divisor in the section ring. -/
def IsRegularCartierLocalEquationData
    (K : TotalQuotientSheafCandidateData X) (D : CartierDivisorData K)
    (U : X.Opens) (a : X.sheaf.presheaf.obj (op U))
    (f : Additive (TotalQuotientUnitSectionsData K U)) : Prop :=
  IsCartierLocalEquationData K D U f ∧
    a ∈ nonZeroDivisors Γ(X, U) ∧
      (toTotalQuotientSheafData K).hom.app (op U) a =
        (↑(Additive.toMul f) :
          (totalQuotientRingSheafData K).presheaf.obj (op U))

/-- Hartshorne's effectiveness predicate for a Cartier divisor: every point
has a neighbourhood carrying a regular local equation. -/
def IsEffectiveCartierDivisorData
    (K : TotalQuotientSheafCandidateData X) (D : CartierDivisorData K) : Prop :=
  ∀ x : X,
    ∃ (U : X.Opens) (_hx : x ∈ U)
      (a : X.sheaf.presheaf.obj (op U))
      (f : Additive (TotalQuotientUnitSectionsData K U)),
      IsRegularCartierLocalEquationData K D U a f

/-- Specification of the ideal sheaf associated to an effective Cartier
divisor: on an affine neighbourhood carrying a regular local equation `a`,
the ideal is the principal ideal `(a)`.

The predicate records the source's gluing target without proving that the
locally principal presentations agree on overlaps. -/
def IsAssociatedEffectiveCartierIdealData
    (K : TotalQuotientSheafCandidateData X) (D : CartierDivisorData K)
    (I : X.IdealSheafData) : Prop :=
  ∀ x : X,
    ∃ (U : X.Opens) (hU : IsAffineOpen U) (_hx : x ∈ U)
      (a : X.sheaf.presheaf.obj (op U))
      (f : Additive (TotalQuotientUnitSectionsData K U)),
      IsRegularCartierLocalEquationData K D U a f ∧
        I.ideal ⟨U, hU⟩ = Ideal.span {a}

/-- Graph form of the associated closed-subscheme construction, retaining the
ideal-sheaf specification propositionally. -/
def IsAssociatedEffectiveCartierSubschemeData
    (K : TotalQuotientSheafCandidateData X) (D : CartierDivisorData K)
    (Y : Scheme.{u}) : Prop :=
  ∃ I : X.IdealSheafData,
    IsAssociatedEffectiveCartierIdealData K D I ∧ Y = I.subscheme

/-!
## Canonical associated ideal and closed subscheme

For the canonical total quotient sheaf, the ideal generated locally by the
regular equations of an effective Cartier divisor can be assembled without
choosing one equation or proving overlap compatibility: Mathlib's
`IdealSheafData.ofIdeals` takes an arbitrary family of affine-open ideals and
returns the largest ideal sheaf contained in that family.  The later
locally-principal result identifies its affine ideals with the expected single
principal ideal; that identification is theorem content rather than part of
this construction.
-/

/-- Hartshorne's effectiveness predicate for a Cartier divisor on the
canonical total quotient sheaf of `X`. -/
abbrev IsCanonicalEffectiveCartierDivisorData
    (D : CanonicalCartierDivisorData X) : Prop :=
  IsEffectiveCartierDivisorData (canonicalTotalQuotientCandidateData X) D

/-- The affine-open ideal generated by all regular local equations of a
canonical Cartier divisor on that affine open. -/
def effectiveCartierAffineIdealData (D : CanonicalCartierDivisorData X)
    (U : X.affineOpens) : Ideal Γ(X, U) :=
  Ideal.span {a | ∃ f : Additive (TotalQuotientUnitSectionsData
      (canonicalTotalQuotientCandidateData X) U.1),
    IsRegularCartierLocalEquationData
      (canonicalTotalQuotientCandidateData X) D U.1 a f}

/-- Hartshorne's ideal sheaf associated to a canonical effective Cartier
divisor, assembled from its regular local equations. -/
noncomputable def associatedEffectiveCartierIdealData
    (D : CanonicalCartierDivisorData X) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals (effectiveCartierAffineIdealData D)

/-- The closed subscheme associated to a canonical effective Cartier divisor. -/
noncomputable def associatedEffectiveCartierSubschemeData
    (D : CanonicalCartierDivisorData X) : Scheme.{u} :=
  (associatedEffectiveCartierIdealData D).subscheme

end LeanCategories.Schemes
