module

public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Monoidal
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import Mathlib.AlgebraicGeometry.Noetherian
public import Mathlib.CategoryTheory.GradedObject.Braiding
public import Mathlib.CategoryTheory.Limits.Preserves.Finite
public import Mathlib.CategoryTheory.Monoidal.CommMon_

/-!
# The graded algebra hypothesis for relative Proj

Hartshorne, *Algebraic Geometry*, Chapter II, Section 7, condition (+)
(`FC06-C02-U230`), fixes a noetherian scheme `X` and a graded quasi-coherent
`O_X`-algebra `S = ⊕ d, S_d` such that `S_0 = O_X`, `S_1` is coherent, and `S`
is locally generated by `S_1`.

The algebra is represented by a commutative monoid object in graded presheaves of
`O_X`-modules. Each homogeneous component is additionally required to be a sheaf.
This keeps the multiplication, unit, associativity, and commutativity data in the
native monoidal interfaces while retaining the sheaf condition degree by degree.

Local generation is stated on affine neighbourhoods. On such a neighbourhood, the
degree-`d` sections must be spanned over `O_X(U)` by products of `d` degree-one
sections. This is the standard homogeneous form of being locally generated as an
`O_X`-algebra by `S_1`.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory MonoidalCategory

namespace LeanCategories.AlgebraicGeometry

universe u

variable (X : Scheme.{u})

/-- A graded `O_X`-algebra whose homogeneous components are sheaves of modules.

The commutative monoid object supplies the graded unit and multiplication and all
their laws. The second field records the sheaf condition on every homogeneous
component. -/
structure GradedAlgebraSheaf where
  algebra : CommMon (GradedObject ℕ X.PresheafOfModules)
  isSheaf (d : ℕ) : Presheaf.IsSheaf _ (algebra.X d).presheaf

namespace GradedAlgebraSheaf

variable {X}

/-- The degree-`d` component of a graded algebra sheaf. -/
def component (S : GradedAlgebraSheaf X) (d : ℕ) : X.Modules where
  val := S.algebra.X d
  isSheaf := S.isSheaf d

/-- Sections of the degree-`d` component over an open subset. -/
abbrev Sections (S : GradedAlgebraSheaf X) (d : ℕ) (U : X.Opens) :=
  (S.algebra.X d).obj (.op U)

/-- Multiplication of homogeneous sections. -/
noncomputable def mulSections (S : GradedAlgebraSheaf X) {i j : ℕ} (U : X.Opens)
    (x : S.Sections i U) (y : S.Sections j U) : S.Sections (i + j) U :=
  (((GradedObject.Monoidal.ιTensorObj S.algebra.X S.algebra.X i j (i + j) rfl ≫
      MonObj.mul) (i + j)).app (.op U)) (x ⊗ₜ y)

end GradedAlgebraSheaf

/-- The data in Hartshorne's relative-Proj condition (+), before its local
degree-one-generation clause. -/
structure RelativeProjAlgebraData (X : Scheme.{u}) where
  algebra : GradedAlgebraSheaf X
  isNoetherian : AlgebraicGeometry.IsNoetherian X
  isQuasicoherent (d : ℕ) : (algebra.component d).IsQuasicoherent
  degreeZero : algebra.component 0 ≅ SheafOfModules.unit X.ringCatSheaf
  degreeOneCoherent : (algebra.component 1).IsFinitePresentation

namespace RelativeProjAlgebraData

variable {X}

/-- The product of a degree-indexed family of degree-one sections.

For degree zero this is the unit transported through the specified identification
`S_0 ≅ O_X`; the successor step uses the graded multiplication. -/
noncomputable def degreeOneProduct (S : RelativeProjAlgebraData X) (U : X.Opens) :
    ∀ d : ℕ, (Fin d → S.algebra.Sections 1 U) → S.algebra.Sections d U
  | 0, _ => S.degreeZero.inv.val.app (.op U) 1
  | d + 1, x =>
      S.algebra.mulSections U
        (S.degreeOneProduct U d (fun i => x i.castSucc))
        (x (Fin.last d))

/-- On `U`, every homogeneous component is generated by products of degree-one
sections. -/
def IsGeneratedInDegreeOneOn (S : RelativeProjAlgebraData X) (U : X.Opens) : Prop :=
  ∀ d : ℕ,
    Submodule.span (X.presheaf.obj (.op U))
      (Set.range (S.degreeOneProduct U d)) = ⊤

/-- The graded algebra is locally generated by its degree-one component when every
point has an affine neighbourhood on which the homogeneous degree-one products span
every component. -/
def IsLocallyGeneratedInDegreeOne (S : RelativeProjAlgebraData X) : Prop :=
  ∀ x : X, ∃ U : X.Opens,
    AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧ S.IsGeneratedInDegreeOneOn U

end RelativeProjAlgebraData

/-- Hartshorne's condition (+) on the graded algebra used to define relative Proj. -/
structure RelativeProjHypothesis (X : Scheme.{u}) extends RelativeProjAlgebraData X where
  locallyGeneratedInDegreeOne : toRelativeProjAlgebraData.IsLocallyGeneratedInDegreeOne

end LeanCategories.AlgebraicGeometry
