module

public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# Elementary subgroup data

Definition-level realization of Humphreys FC16-C12-U029.

Once the rational-point subgroups of the unipotent radicals of the minimal
`k`-parabolics are supplied, the elementary subgroup `G*` is simply the
subgroup generated by their union.  Tits simplicity of `G*/Z(G*)` and
comparisons between `G(k)` and `G*` are result-layer statements.
-/

@[expose] public section

namespace LeanCategories.AlgebraicGeometry

universe u v

variable {G : Type u} [Group G]
variable {ι : Type v}

/-- The subgroup generated by the rational-point unipotent radicals indexed
by the minimal `k`-parabolics. -/
def elementarySubgroup (unipotentRadicalPoints : ι → Subgroup G) : Subgroup G :=
  Subgroup.closure {g : G | ∃ i : ι, g ∈ unipotentRadicalPoints i}

end LeanCategories.AlgebraicGeometry
