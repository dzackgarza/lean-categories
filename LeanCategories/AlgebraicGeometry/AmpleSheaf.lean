module

public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Monoidal
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Quasicoherent
public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import Mathlib.AlgebraicGeometry.Noetherian

/-!
# Ample invertible sheaves

Hartshorne, *Algebraic Geometry*, Chapter II, Definition 7.4
(`FC06-C02-U207`).

This file records only the data entering the definition.  The tensor product of
`O_X`-modules is the sheafification of the presheaf tensor product.  Tensor
invertibility is expressed by the existence of a two-sided inverse object, and
tensor powers are defined recursively.  Ampleness then says that every coherent
module becomes globally generated after tensoring by all sufficiently large
powers of the invertible module.

No associativity, tensor-invertibility comparison, or ampleness theorem is used
in these definitions.
-/

@[expose] public section

open CategoryTheory MonoidalCategory

namespace LeanCategories.AlgebraicGeometry

universe u

variable {X : AlgebraicGeometry.Scheme.{u}}

/-- The monoidal structure on presheaves of `O_X`-modules, in the form needed
to form their pointwise tensor product before sheafification. -/
noncomputable local instance schemePresheafModulesMonoidal
    (X : AlgebraicGeometry.Scheme.{u}) : MonoidalCategory X.PresheafOfModules :=
  inferInstanceAs (MonoidalCategory
    (PresheafOfModules.{u} (X.sheaf.obj ⋙ forget₂ CommRingCat RingCat)))

/-- The structure sheaf regarded as its rank-one module over itself. -/
noncomputable def schemeModuleUnit (X : AlgebraicGeometry.Scheme.{u}) : X.Modules :=
  SheafOfModules.unit X.ringCatSheaf

/-- The tensor product of two `O_X`-modules, obtained by sheafifying their
presheaf tensor product. -/
noncomputable def schemeModuleTensor (M N : X.Modules) : X.Modules :=
  (PresheafOfModules.sheafification (𝟙 X.ringCatSheaf.obj)).obj (M.val ⊗ N.val)

/-- An `O_X`-module is tensor-invertible when it has a two-sided inverse for
the sheaf tensor product.  This is the definition-level content of an
invertible sheaf needed by Hartshorne's ampleness definition. -/
def IsTensorInvertible (L : X.Modules) : Prop :=
  ∃ LInv : X.Modules,
    Nonempty (schemeModuleTensor L LInv ≅ schemeModuleUnit X) ∧
      Nonempty (schemeModuleTensor LInv L ≅ schemeModuleUnit X)

/-- The `n`-fold tensor power of an `O_X`-module. -/
noncomputable def schemeModuleTensorPower (L : X.Modules) : ℕ → X.Modules
  | 0 => schemeModuleUnit X
  | n + 1 => schemeModuleTensor (schemeModuleTensorPower L n) L

/-- A sheaf of modules is generated by global sections when it admits a
generating family in Mathlib's native `GeneratingSections` interface. -/
def IsGeneratedByGlobalSections (M : X.Modules) : Prop :=
  Nonempty M.GeneratingSections

/-- Hartshorne's definition of an ample invertible sheaf on a noetherian
scheme: every coherent module, after tensoring with every sufficiently large
power of `L`, is generated by global sections.

`IsFinitePresentation` is the native coherent-module predicate used here; on a
noetherian scheme it is the finite-presentation form of coherence. -/
def IsAmpleInvertibleSheaf [AlgebraicGeometry.IsNoetherian X]
    (L : X.Modules) : Prop :=
  IsTensorInvertible L ∧
    ∀ F : X.Modules, F.IsFinitePresentation →
      ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n →
        IsGeneratedByGlobalSections
          (schemeModuleTensor F (schemeModuleTensorPower L n))

end LeanCategories.AlgebraicGeometry
