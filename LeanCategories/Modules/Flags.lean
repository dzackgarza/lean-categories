module

public import LeanCategories.Lattices.Valued.Sublattice
public import Mathlib.LinearAlgebra.FreeModule.PID
public import Mathlib.Algebra.Module.Projective

/-!
# Saturated flags over a PID (#90)

This is a **general-linear** theorem, not an orthogonal-stabilizer theorem. For a strict flag of
saturated submodules of a finite free module, the relevant decompositions come from projectivity of
the corresponding quotients, not from any form-preservation equation.

## Main references

* Armand Borel, *Linear Algebraic Groups*, GTM 126, 2nd ed.: the diagonal–unipotent
  factorization of a parabolic group, generated by the elementary root maps, cf. §§3–4 and §8.
* Bourbaki, *Algèbre commutative*, Ch. VII, for modules over principal ideal domains.

The admissible elementary maps below have coefficient **every** `a : R`. Coefficient-one maps alone
suffice only under additional assumptions on the ring, such as `R = ℤ`; this is the wording
correction to #90.
-/

@[expose] public section

open LeanCategories.Modules.Bilinear.Valued

namespace LeanCategories.Modules

universe u

variable {R : Type u} [CommRing R] {M : Type u} [AddCommGroup M] [Module R M]

/-- Saturation gives projectivity of the quotient: finite torsion-free modules over a PID are free,
so the quotient is projective. -/
theorem saturated_projective [IsDomain R] [IsPrincipalIdealRing R] [Module.Finite R M] (N : Submodule R M)
    (hN : Module.IsTorsionFree R (M ⧸ N)) :
    Module.Projective R (M ⧸ N) := by
  letI : Module.IsTorsionFree R (M ⧸ N) := hN
  letI : Module.Finite R (M ⧸ N) :=
    Module.Finite.of_surjective N.mkQ (Submodule.mkQ_surjective N)
  exact @Module.Projective.of_free R _ (M ⧸ N) _ _ (Module.free_iff_isTorsionFree.mpr hN)

/-- A saturated submodule of a projective quotient admits a complement. The complement is the range
of a section of `M → M ⧸ N`, so the decomposition is internal to `M`. -/
theorem exists_saturated_complement (N : Submodule R M)
    [Module.Projective R (M ⧸ N)] :
    ∃ C : Submodule R M, N ⊔ C = ⊤ ∧ N ⊓ C = ⊥ := by
  obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective N.mkQ
    (LinearMap.range_eq_top.mpr (Submodule.mkQ_surjective N))
  refine ⟨LinearMap.range s, ?_, ?_⟩
  · apply le_antisymm le_top
    intro z hz
    have hs' : ∀ a : M ⧸ N, N.mkQ (s a) = a := by
      intro a
      have h := LinearMap.congr_fun hs a
      simpa using h
    have hcalc : N.mkQ (z - s (N.mkQ z)) = 0 := by
      rw [(N.mkQ).map_sub z (s (N.mkQ z)), hs', sub_self]
    have hz : z - s (N.mkQ z) ∈ N := (Submodule.Quotient.mk_eq_zero _).mp hcalc
    exact Submodule.mem_sup.mpr
      ⟨z - s (N.mkQ z), hz, s (N.mkQ z), LinearMap.mem_range_self _ _, sub_add_cancel z _⟩
  · apply bot_unique
    intro x hx
    obtain ⟨hxN, hxC⟩ := Submodule.mem_inf.mp hx
    obtain ⟨y, rfl⟩ := hxC
    have hs' : ∀ a : M ⧸ N, N.mkQ (s a) = a := by
      intro a
      have h := LinearMap.congr_fun hs a
      simpa using h
    have hy0 : y = 0 := by
      have hn : N.mkQ (s y) = 0 := (Submodule.Quotient.mk_eq_zero _).mpr hxN
      rw [hs'] at hn
      exact hn
    simp [hy0]

/-- If `P ≤ N` and the quotient by `P` is projective, `P` has a complement inside `N`. This is the
step used to refine an adapted basis by one inclusion of a saturated flag. -/
theorem exists_flag_complement (P N : Submodule R M) (hPN : P ≤ N)
    [Module.Projective R (M ⧸ P)] :
    ∃ Q : Submodule R M, P ⊔ Q = N ∧ P ⊓ Q = ⊥ := by
  obtain ⟨C, htop, hbot⟩ := exists_saturated_complement P
  refine ⟨N ⊓ C, ?_, ?_⟩
  · apply le_antisymm
    · exact sup_le hPN inf_le_left
    intro z hzN
    have hztop : z ∈ P ⊔ C := by
      rw [htop]
      exact Submodule.mem_top
    obtain ⟨p, hp, c, hc, hzc⟩ := Submodule.mem_sup.mp hztop
    have heq : c = z - p := by
      rw [← hzc]
      module
    have hcN : c ∈ N := by
      rw [heq]
      exact N.sub_mem hzN (hPN hp)
    exact Submodule.mem_sup.mpr ⟨p, hp, c, ⟨hcN, hc⟩, hzc⟩
  · apply bot_unique
    intro x hx
    have hx' : x ∈ P ⊓ C := ⟨hx.1, hx.2.2⟩
    simpa [hbot] using hx'

end LeanCategories.Modules
