@[expose] public section

open scoped MatrixGroups Pointwise

open Matrix Matrix.SpecialLinearGroup

namespace ModularGroup

/-- The generators of lean-categories#89's presentation of `SL(2, ℤ)` as a family
`Fin 2 → SL(2, ℤ)`: index `0` is `S`, index `1` is `T`. -/
def sl2zGenVal : Fin 2 → SL(2, ℤ) := ![S, T]

lemma sl2zGenVal_zero : sl2zGenVal 0 = S := rfl

lemma sl2zGenVal_one : sl2zGenVal 1 = T := rfl

/-- `S ^ 4 = 1` in `SL(2, ℤ)`: the first relation of the presentation. -/
theorem S_pow_four : S ^ 4 = 1 := by decide

/-- `(T * S) ^ 3 = S ^ 2` in `SL(2, ℤ)`: the second relation, with `S ^ 2 = -1`. This is the
relation `(TS)³ = S²` of lean-categories#89 in the only form in which it holds, `(T * S) ^ 3`
being `-1` rather than `1`. -/
theorem T_mul_S_pow_three_eq_S_sq : (T * S) ^ 3 = S ^ 2 := by decide

/-- `(T * S) ^ 3 * S ^ (-2) = 1`: the second relator, evaluated in `SL(2, ℤ)`. -/
theorem T_mul_S_pow_three_mul_zpow : (T * S) ^ 3 * S ^ (-2 : ℤ) = 1 := by
  rw [T_mul_S_pow_three_eq_S_sq, ← zpow_natCast, zpow_neg]
  exact mul_inv_cancel _

/-- The relators of lean-categories#89's presentation `⟨S, T | S⁴, (TS)³ = S²⟩` of `SL(2, ℤ)`, as
words in the free group on `Fin 2` (`0 ↦ S`, `1 ↦ T`): `S⁴` and `(TS)³S⁻²`. -/
def sl2zRelators : Set (FreeGroup (Fin 2)) :=
  {FreeGroup.of 0 ^ 4, (FreeGroup.of 1 * FreeGroup.of 0) ^ 3 * (FreeGroup.of 0) ^ (-2 : ℤ)}

/-- Each relator of `sl2zRelators` dies in `SL(2, ℤ)`, so the presentation maps to `SL(2, ℤ)`. -/
theorem sl2zRelators_map_one : ∀ r ∈ sl2zRelators, FreeGroup.lift sl2zGenVal r = 1 := by
  intro r hr
  simp only [sl2zRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · rw [map_pow, FreeGroup.lift_apply_of, sl2zGenVal_zero, S_pow_four]
  · rw [map_mul, map_pow, map_mul, map_zpow, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of,
      sl2zGenVal_one, sl2zGenVal_zero, T_mul_S_pow_three_mul_zpow]

/-- The homomorphism `⟨S, T | S⁴, (TS)³ = S²⟩ →* SL(2, ℤ)` taking the generators to `S` and `T`. -/
def sl2zToGroup : PresentedGroup sl2zRelators →* SL(2, ℤ) :=
  PresentedGroup.toGroup sl2zRelators_map_one

theorem sl2zToGroup_of (i : Fin 2) : sl2zToGroup (PresentedGroup.of i) = sl2zGenVal i :=
  PresentedGroup.toGroup.of sl2zRelators_map_one

lemma range_sl2zGenVal : Set.range sl2zGenVal = {S, T} := by
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i
    · exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _ rfl
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

/-- `SL(2, ℤ)` is generated by the two elements `S`, `T` of lean-categories#89's presentation. -/
def sl2zGenerators : Group.Generators (SL(2, ℤ)) (Fin 2) where
  val := sl2zGenVal
  closure_eq_top := by
    rw [range_sl2zGenVal]
    exact SpecialLinearGroup.SL2Z_generators

/-- The presentation `⟨S, T | S⁴, (TS)³ = S²⟩` surjects onto `SL(2, ℤ)`. -/
theorem sl2zToGroup_surjective : Function.Surjective sl2zToGroup := by
  have hle : ({S, T} : Set (SL(2, ℤ))) ⊆ sl2zToGroup.range := by
    intro x hx
    rcases hx with rfl | rfl
    · exact ⟨PresentedGroup.of 0, sl2zToGroup_of 0⟩
    · exact ⟨PresentedGroup.of 1, sl2zToGroup_of 1⟩
  have htop : (⊤ : Subgroup (SL(2, ℤ))) ≤ sl2zToGroup.range :=
    SpecialLinearGroup.SL2Z_generators ▸
      (Subgroup.closure_le (K := sl2zToGroup.range)).mpr hle
  intro g
  exact MonoidHom.mem_range.mp (htop (Subgroup.mem_top g))

/-!
### Component 1 of the completeness proof: the Euclid descent on the first column

The completeness of item 1 splits into two statements, and this section is the first of them: the
*descent*. Writing `colHeight A` for the height `max |A 0 0| |A 1 0|` of the first column of an
integer `2 × 2` matrix, `colHeight_step` says that every `A : SL(2, ℤ)` with `2 ≤ colHeight A` is
`S ^ ε * T ^ q` times a matrix whose first column is strictly shorter, with `ε : Fin 2` and `q : ℤ`;
`exists_word_mul_colHeight_le_one` iterates it, so that every element of `SL(2, ℤ)` is a word in
`S`, `T` (as a `FreeGroup (Fin 2)` element, evaluated by `sl2zGenVal`) times a matrix of
first-column height at most one.

Both degenerate cases the descent has to dodge are dodged by the determinant: `c = 0` forces
`|a| = 1` and `a = 0` forces `|c| = 1`, so under `2 ≤ colHeight` both entries of the first column
are nonzero and the Euclidean division `a % c` resp. `c % a` is available. `|a| = |c|` likewise
forces `|c| = 1` (`abs_eq_one_of_abs_eq`), which is what makes the case split exhaustive rather than
three-way.

This is the whole of what an elementary descent can give, and it is not the completeness of the
presentation. The residual stratum `colHeight A ≤ 1` is where the theorem actually lives: the
descent's induction is on the height of the *product* of a word, so its base case quantifies over
*all* words whose product has first-column height at most one — and that base case already contains
`ker sl2zToGroup` (take the product `1`). No iteration of `colHeight_step` therefore reduces
`Sl2zPresentationComplete` to a finite check; what it does is exhibit the word that conjugates any
given matrix into the stratum where the amalgam normal form has to be consulted. See the section
"Item 1: the two cyclic factors" below for what that consultation costs, and note that the descent
is needed even for the *statement*: `colHeight` is what makes "the cusp stratum" a set of matrices
rather than a slogan.
-/

/-- The height of the first column of an integer `2 × 2` matrix: the largest of the absolute values
of its two entries. For `A : SL(2, ℤ)`, `colHeight A.1` is the height the Euclid descent of
lean-categories#89 measures, and `colHeight A.1 = 1` is its residual stratum. -/
def colHeight (A : Matrix (Fin 2) (Fin 2) ℤ) : ℤ := max |A 0 0| |A 1 0|

@[simp]
lemma colHeight_apply (A : Matrix (Fin 2) (Fin 2) ℤ) : colHeight A = max |A 0 0| |A 1 0| := rfl

lemma colHeight_nonneg (A : Matrix (Fin 2) (Fin 2) ℤ) : 0 ≤ colHeight A :=
  le_trans (abs_nonneg _) (le_max_left _ _)

/-- The entries of an `SL(2, ℤ)` matrix satisfy `a * d - b * c = 1`. -/
lemma det_entries (A : SL(2, ℤ)) : A.1 0 0 * A.1 1 1 - A.1 0 1 * A.1 1 0 = 1 := by
  have h := A.2
  rwa [Matrix.det_fin_two] at h

/-- The first column of an `SL(2, ℤ)` matrix is nonzero: its height is positive. -/
lemma colHeight_pos (A : SL(2, ℤ)) : 0 < colHeight A.1 := by
  rcases lt_or_ge 0 (colHeight A.1) with h | h
  · exact h
  have h0 : colHeight A.1 = 0 := le_antisymm h (colHeight_nonneg _)
  have hz : A.1 0 0 = 0 := by
    have hle : |A.1 0 0| ≤ 0 := by rw [← h0]; exact le_max_left _ _
    exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
  have hz2 : A.1 1 0 = 0 := by
    have hle : |A.1 1 0| ≤ 0 := by rw [← h0]; exact le_max_right _ _
    exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
  have hdet := det_entries A
  rw [hz, hz2, mul_zero, sub_zero] at hdet
  exact absurd hdet (by norm_num)

/-- The first column of `T ^ q * A`, top entry. -/
lemma T_zpow_mul_zero_zero (A : SL(2, ℤ)) (q : ℤ) :
    (T ^ q * A).1 0 0 = A.1 0 0 + q * A.1 1 0 := by
  rw [show (T ^ q * A).1 = (T ^ q).1 * A.1 from rfl, coe_T_zpow, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

/-- The first column of `T ^ q * A`, bottom entry: a power of `T` leaves it alone. -/
lemma T_zpow_mul_one_zero (A : SL(2, ℤ)) (q : ℤ) : (T ^ q * A).1 1 0 = A.1 1 0 := by
  rw [show (T ^ q * A).1 = (T ^ q).1 * A.1 from rfl, coe_T_zpow, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

lemma coe_S_inv_matrix : (S⁻¹ : SL(2, ℤ)).1 = !![0, 1; -1, 0] := by
  rw [S_inv]
  ext i j
  fin_cases i <;> fin_cases j <;> decide

lemma S_inv_mul_zero_zero (A : SL(2, ℤ)) : (S⁻¹ * A).1 0 0 = A.1 1 0 := by
  rw [show (S⁻¹ * A).1 = (S⁻¹).1 * A.1 from rfl, coe_S_inv_matrix, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

lemma S_inv_mul_one_zero (A : SL(2, ℤ)) : (S⁻¹ * A).1 1 0 = -A.1 0 0 := by
  rw [show (S⁻¹ * A).1 = (S⁻¹).1 * A.1 from rfl, coe_S_inv_matrix, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

lemma colHeight_T_zpow_mul (A : SL(2, ℤ)) (q : ℤ) :
    colHeight (T ^ q * A).1 = max |A.1 0 0 + q * A.1 1 0| |A.1 1 0| := by
  rw [colHeight_apply, T_zpow_mul_zero_zero, T_zpow_mul_one_zero]

/-- In `SL(2, ℤ)` with first-column height at least two, both entries of the first column are
nonzero: the two degenerate cases of the descent are excluded by the determinant. -/
lemma ne_zero_of_colHeight (A : SL(2, ℤ)) (hA : 2 ≤ colHeight A.1) :
    A.1 0 0 ≠ 0 ∧ A.1 1 0 ≠ 0 := by
  have hdet := det_entries A
  have hc : A.1 1 0 ≠ 0 := by
    intro h0
    rw [h0, mul_zero, sub_zero] at hdet
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hdet with h | h
    · rw [colHeight_apply] at hA
      rw [h, h0] at hA
      norm_num at hA
    · rw [colHeight_apply] at hA
      rw [h, h0] at hA
      norm_num at hA
  refine ⟨?_, hc⟩
  intro h0
  rw [h0, zero_mul, zero_sub] at hdet
  have hb : A.1 1 0 * (-A.1 0 1) = 1 := by nlinarith [hdet]
  rcases Int.eq_one_or_neg_one_of_mul_eq_one hb with h | h
  · rw [colHeight_apply] at hA
    rw [h0, h] at hA
    norm_num at hA
  · rw [colHeight_apply] at hA
    rw [h0, h] at hA
    norm_num at hA

/-- `|a| = |c|` forces `|c| = 1` for an `SL(2, ℤ)` matrix: the determinant is one. This is the
third case the descent has to exclude, `a = c` and `a = -c` both giving `c * (±1) = 1`. -/
lemma abs_eq_one_of_abs_eq (A : SL(2, ℤ)) (h : |A.1 0 0| = |A.1 1 0|) : |A.1 1 0| = 1 := by
  have hdet := det_entries A
  rcases abs_eq_abs.mp h with h' | h'
  · rw [h'] at hdet
    have hc : A.1 1 0 * (A.1 1 1 - A.1 0 1) = 1 := by
      ring_nf at hdet ⊢
      linarith
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hc with h1 | h1 <;> rw [h1] <;> norm_num
  · rw [h'] at hdet
    have hc : (-A.1 1 0) * (A.1 1 1 + A.1 0 1) = 1 := by
      ring_nf at hdet ⊢
      linarith
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hc with h1 | h1
    · rw [show A.1 1 0 = -1 by linarith]
      norm_num
    · rw [show A.1 1 0 = 1 by linarith]
      norm_num

/-- **Component 1 of lean-categories#89 item 1.** If the first column of `A : SL(2, ℤ)` has height
at least two, then for some `ε : Fin 2`, `q : ℤ` and `A' : SL(2, ℤ)`,

  `A = S ^ ε * T ^ q * A'`  and  `colHeight A' < colHeight A`,

so the Euclidean algorithm on the pair `(|A 0 0|, |A 1 0|)` is a strictly decreasing rewriting
process on `SL(2, ℤ)` that lands in the stratum `colHeight = 1`. The two multipliers are the two
branches of one Euclidean step: `T ^ q` alone when `|c| < |a|` (with `q = a / c`), and `S` followed
by `T ^ q` when `|a| < |c|` (with `q = c / a`). -/
theorem colHeight_step (A : SL(2, ℤ)) (hA : 2 ≤ colHeight A.1) :
    ∃ (ε : Fin 2) (q : ℤ) (A' : SL(2, ℤ)),
      A = S ^ (ε : ℕ) * T ^ q * A' ∧ colHeight A'.1 < colHeight A.1 := by
  obtain ⟨ha, hc⟩ := ne_zero_of_colHeight A hA
  have hne : |A.1 1 0| ≠ |A.1 0 0| := by
    intro heq
    have h1 : |A.1 1 0| = 1 := abs_eq_one_of_abs_eq A heq.symm
    have ha1 : |A.1 0 0| = 1 := heq.symm.trans h1
    have h2 : colHeight A.1 = 1 := by
      rw [colHeight_apply, ha1, h1, max_self]
    rw [h2] at hA
    norm_num at hA
  rcases lt_or_gt_of_ne hne with hlt | hlt
  · -- `|c| < |a|`: multiply by `T ^ (a / c)` on the left
    have hcolA : colHeight A.1 = |A.1 0 0| := by
      rw [colHeight_apply, max_eq_left (le_of_lt hlt)]
    have key : A.1 0 0 + (-(A.1 0 0 / A.1 1 0)) * A.1 1 0 = A.1 0 0 % A.1 1 0 := by
      have h := Int.emod_add_mul_ediv (A.1 0 0) (A.1 1 0)
      nlinarith [h]
    refine ⟨0, A.1 0 0 / A.1 1 0, T ^ (-(A.1 0 0 / A.1 1 0)) * A, ?_, ?_⟩
    · rw [show ((0 : Fin 2) : ℕ) = 0 from rfl, pow_zero, one_mul, ← mul_assoc, ← zpow_add,
        add_neg_cancel, zpow_zero, one_mul]
    · rw [colHeight_T_zpow_mul, key, max_eq_right (le_of_lt ?_)]
      · rw [hcolA]
        exact hlt
      · have h1 := Int.emod_lt_abs (A.1 0 0) hc
        have h2 := Int.emod_nonneg (A.1 0 0) hc
        rwa [abs_of_nonneg h2]
  · -- `|a| < |c|`: multiply by `T ^ (c / a)` and `S⁻¹` on the left
    have hcolA : colHeight A.1 = |A.1 1 0| := by
      rw [colHeight_apply, max_eq_right (le_of_lt hlt)]
    have key : A.1 1 0 + (A.1 1 0 / A.1 0 0) * (-A.1 0 0) = A.1 1 0 % A.1 0 0 := by
      have h := Int.emod_add_mul_ediv (A.1 1 0) (A.1 0 0)
      have hc' : A.1 1 0 = A.1 1 0 % A.1 0 0 + (A.1 1 0 / A.1 0 0) * A.1 0 0 := by
        conv_lhs => rw [← h]
        ring
      nth_rewrite 1 [hc']
      ring
    refine ⟨1, -(A.1 1 0 / A.1 0 0), T ^ (A.1 1 0 / A.1 0 0) * (S⁻¹ * A), ?_, ?_⟩
    · rw [show ((1 : Fin 2) : ℕ) = 1 from rfl, pow_one]
      group
    · rw [colHeight_T_zpow_mul, S_inv_mul_zero_zero, S_inv_mul_one_zero, key,
        max_eq_right (le_of_lt ?_)]
      · rw [hcolA, abs_neg]
        exact hlt
      · have h1 := Int.emod_lt_abs (A.1 1 0) ha
        have h2 := Int.emod_nonneg (A.1 1 0) ha
        rw [abs_of_nonneg h2, abs_neg]
        exact h1

/-- **Component 1, iterated.** Every `A : SL(2, ℤ)` is a word in the two generators — an element
`u` of the free group on `Fin 2`, evaluated through `sl2zGenVal` — times a matrix whose first column
has height at most one. The proof is the strong induction on `colHeight` that `colHeight_step`
drives; it terminates because the height drops by at least one at each step and is positive on
`SL(2, ℤ)`. -/
theorem exists_word_mul_colHeight_le_one :
    ∀ (n : ℕ) (A : SL(2, ℤ)), (colHeight A.1).toNat ≤ n →
      ∃ (u : FreeGroup (Fin 2)) (A₀ : SL(2, ℤ)),
        colHeight A₀.1 ≤ 1 ∧ A = FreeGroup.lift sl2zGenVal u * A₀ := by
  intro n
  induction n with
  | zero =>
    intro A hA
    have hpos := colHeight_pos A
    have hle : (colHeight A.1).toNat = 0 := Nat.le_zero.mp hA
    rw [Int.toNat_eq_zero] at hle
    omega
  | succ n ih =>
    intro A hA
    by_cases h : colHeight A.1 ≤ 1
    · exact ⟨1, A, h, by rw [map_one, one_mul]⟩
    · have h2 : 2 ≤ colHeight A.1 := by omega
      obtain ⟨ε, q, A', hEq, hlt⟩ := colHeight_step A h2
      have hA' : (colHeight A'.1).toNat ≤ n := by
        have hlt' : (colHeight A'.1).toNat < (colHeight A.1).toNat := by
          rw [Int.toNat_lt_toNat (colHeight_pos A)]
          exact hlt
        omega
      obtain ⟨u, A₀, hA₀, hEq₀⟩ := ih A' hA'
      exact ⟨FreeGroup.of (0 : Fin 2) ^ (ε : ℕ) * FreeGroup.of (1 : Fin 2) ^ q * u, A₀, hA₀, by
        rw [hEq, hEq₀, map_mul, map_mul, map_pow, map_zpow, FreeGroup.lift_apply_of,
          FreeGroup.lift_apply_of, sl2zGenVal_zero, sl2zGenVal_one]
        group⟩

/-- **Component 1, iterated, in the direction the presentation uses.** For every `A : SL(2, ℤ)`
there is a word `u` in the free group on the two generators whose product with `A` has first-column
height at most one. This is the form in which the descent meets the cusp stratum: the cusp stratum
has to say what the words with `colHeight ≤ 1` product are, and nothing here does. -/
theorem exists_lift_mul_colHeight_le_one (A : SL(2, ℤ)) :
    ∃ u : FreeGroup (Fin 2), colHeight (FreeGroup.lift sl2zGenVal u * A).1 ≤ 1 := by
  obtain ⟨u, A₀, hA₀, hEq⟩ := exists_word_mul_colHeight_le_one _ A le_rfl
  refine ⟨u⁻¹, ?_⟩
  rw [map_inv, hEq, ← mul_assoc, inv_mul_cancel, one_mul]
  exact hA₀

/-!
### Component 2, its arithmetic half: the cusp stratum is eight cosets of `⟨T⟩`

The descent above lands in `colHeight ≤ 1`; this section says what that stratum is. Right
multiplication by `T ^ b` fixes the first column (`colHeight_mul_T_zpow`), so the stratum is a union
of `⟨T⟩`-cosets, and the first column `(a, c)` has `|a|, |c| ≤ 1` with `det = 1`: that leaves the
eight pairs `(±1, 0)`, `(0, ±1)`, `(±1, ±1)`, each one coset. `cuspLift : Fin 8 → SL(2, ℤ)` lists
the eight representatives (`1`, `-1`, `S`, `-S`, `S T⁻¹ S⁻¹` and the sign-and-inverse variants), and
`colHeight_le_one_iff` is the exact statement

  `colHeight A ≤ 1 ↔ ∃ i b, A = cuspLift i * T ^ b`,

and `colHeight_le_one_iff_existsUnique` sharpens it to a unique pair, i.e. `Fin 8 × ℤ` bijects onto
the stratum (`cuspLift_pair_injective`).

This is the vertex-stabilizer arithmetic of the tree action: the eight are the eight `⟨T⟩`-cosets
the stratum meets. It is all of component 2 that is arithmetic, and what it does *not* give is the
word-level statement — that no word of `PresentedGroup sl2zRelators` is normal-closure equivalent to
two different `cuspLift i`, equivalently that the stratum's words form a transversal. That is the
Bass–Serre/Farey statement recorded in the module docstring, and it is why
`Sl2zPresentationComplete` stays open below.
-/

/-- The eight lifts of the cusp stratum `colHeight ≤ 1`: one representative of each of the eight
cosets of `⟨T⟩` that the stratum meets: the first column can only be one of the eight pairs
`(±1, 0)`, `(0, ±1)`, `(±1, ±1)`, and each is a single coset. -/
def cuspLift : Fin 8 → SL(2, ℤ) :=
  ![1, -1, S, -S, S * T⁻¹ * S⁻¹, -(S * T⁻¹ * S⁻¹), S * T * S⁻¹, -(S * T * S⁻¹)]

lemma cuspLift_zero : (cuspLift 0).1 = !![1, 0; 0, 1] := by decide

lemma cuspLift_one : (cuspLift 1).1 = !![-1, 0; 0, -1] := by decide

lemma cuspLift_two : (cuspLift 2).1 = !![0, -1; 1, 0] := by decide

lemma cuspLift_three : (cuspLift 3).1 = !![0, 1; -1, 0] := by decide

lemma cuspLift_four : (cuspLift 4).1 = !![1, 0; 1, 1] := by decide

lemma cuspLift_five : (cuspLift 5).1 = !![-1, 0; -1, -1] := by decide

lemma cuspLift_six : (cuspLift 6).1 = !![1, 0; -1, 1] := by decide

lemma cuspLift_seven : (cuspLift 7).1 = !![-1, 0; 1, -1] := by decide

/-- The first column of an `SL(2, ℤ)` matrix, as a pair of integers. -/
def firstColumn (X : SL(2, ℤ)) : ℤ × ℤ := (X.1 0 0, X.1 1 0)

lemma mul_T_zpow_zero_zero (X : SL(2, ℤ)) (b : ℤ) : (X * T ^ b).1 0 0 = X.1 0 0 := by
  rw [show (X * T ^ b).1 = X.1 * (T ^ b).1 from rfl, coe_T_zpow, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

lemma mul_T_zpow_one_zero (X : SL(2, ℤ)) (b : ℤ) : (X * T ^ b).1 1 0 = X.1 1 0 := by
  rw [show (X * T ^ b).1 = X.1 * (T ^ b).1 from rfl, coe_T_zpow, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

lemma firstColumn_mul_T_zpow (X : SL(2, ℤ)) (b : ℤ) :
    firstColumn (X * T ^ b) = firstColumn X := by
  rw [firstColumn, firstColumn, mul_T_zpow_zero_zero, mul_T_zpow_one_zero]

/-- Right multiplication by a power of `T` fixes the first column, so it fixes `colHeight`. -/
lemma colHeight_mul_T_zpow (X : SL(2, ℤ)) (b : ℤ) :
    colHeight (X * T ^ b).1 = colHeight X.1 := by
  rw [colHeight_apply, colHeight_apply, mul_T_zpow_zero_zero, mul_T_zpow_one_zero]

lemma colHeight_cuspLift (i : Fin 8) : colHeight (cuspLift i).1 = 1 := by
  fin_cases i <;> decide

/-- **The cusp stratum is eight cosets of `⟨T⟩`.** `A : SL(2, ℤ)` has first-column height at most
one exactly when it is one of the eight matrices `cuspLift i` times a power of `T`; the eight are
the eight possible first columns `(±1, 0)`, `(0, ±1)`, `(±1, ±1)` with `det = 1`. This is the
arithmetic
content of the vertex-stabilizer statement of lean-categories#89 item 1's component 2: it reduces
"the stratum `colHeight ≤ 1`" to a finite list of cosets; what it does not prove is the word-level
statement that no word in the presentation is normal-closure equivalent to two of them. -/
theorem colHeight_le_one_iff (A : SL(2, ℤ)) :
    colHeight A.1 ≤ 1 ↔ ∃ (i : Fin 8) (b : ℤ), A = cuspLift i * T ^ b := by
  constructor
  · intro hA
    have hdet := det_entries A
    rw [colHeight_apply] at hA
    have h1 : |A.1 0 0| ≤ 1 := le_trans (le_max_left _ _) hA
    have h2 : |A.1 1 0| ≤ 1 := le_trans (le_max_right _ _) hA
    have h1' := abs_le.mp h1
    have h2' := abs_le.mp h2
    have ha : A.1 0 0 = -1 ∨ A.1 0 0 = 0 ∨ A.1 0 0 = 1 := by omega
    have hc : A.1 1 0 = -1 ∨ A.1 1 0 = 0 ∨ A.1 1 0 = 1 := by omega
    rcases ha with ha | ha | ha <;> rcases hc with hc | hc | hc
    · -- (a, c) = (-1, -1)
      refine ⟨5, -(A.1 0 1), ?_⟩
      have hd : A.1 1 1 = A.1 0 1 - 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_five, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
      omega
    · -- (a, c) = (-1, 0)
      refine ⟨1, -(A.1 0 1), ?_⟩
      have hd : A.1 1 1 = -1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_one, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
    · -- (a, c) = (-1, 1)
      refine ⟨7, -(A.1 0 1), ?_⟩
      have hd : A.1 1 1 = -1 - A.1 0 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_seven, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
      omega
    · -- (a, c) = (0, -1)
      refine ⟨3, -(A.1 1 1), ?_⟩
      have hb : A.1 0 1 = 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_three, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hb]
    · -- (a, c) = (0, 0) is impossible: the determinant is one
      rw [ha, hc] at hdet
      norm_num at hdet
    · -- (a, c) = (0, 1)
      refine ⟨2, A.1 1 1, ?_⟩
      have hb : A.1 0 1 = -1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_two, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hb]
    · -- (a, c) = (1, -1)
      refine ⟨6, A.1 0 1, ?_⟩
      have hd : A.1 1 1 = 1 - A.1 0 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_six, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
      omega
    · -- (a, c) = (1, 0)
      refine ⟨0, A.1 0 1, ?_⟩
      have hd : A.1 1 1 = 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_zero, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
    · -- (a, c) = (1, 1)
      refine ⟨4, A.1 0 1, ?_⟩
      have hd : A.1 1 1 = A.1 0 1 + 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_four, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
  · rintro ⟨i, b, rfl⟩
    rw [colHeight_mul_T_zpow, colHeight_cuspLift]

/-- Lean-categories#89 item 1 in the form the theorem would take: the presentation
`⟨S, T | S⁴, (TS)³ = S²⟩` is *complete*, i.e. the relators generate the whole kernel of the free
group's map onto `SL(2, ℤ)`. This is **not proved** here; see the module docstring. It is what a
coset enumeration on the presentation consumes. -/
def Sl2zPresentationComplete : Prop := Function.Injective sl2zToGroup

/-!
### Item 1, second half: the presentation is the amalgam

The relators `S⁴` and `(TS)³S⁻²` are a change of generators away from the form in which the
presentation is visibly the amalgam `ℤ/4 *_{ℤ/2} ℤ/6`: with `R = TS` they read `S⁴` and `R³S⁻²`,
i.e. `S` has order dividing `4`, `R` order dividing `6`, and the two `ℤ/2`'s `⟨S²⟩ = ⟨R³⟩` are
identified. `sl2zAmalgamRelators` is that relator set on the same two generator slots, and
`sl2zAmalgamEquiv` is the change of generators, `T ↦ R S⁻¹` and `R ↦ T S`, proved inverse on both
sides by the presentations' universal property.

What is *not* here: the identification of `PresentedGroup sl2zAmalgamRelators` with Mathlib's
categorical pushout `Monoid.PushoutI` of `ℤ/4 ← ℤ/2 → ℤ/6`
(`Mathlib/GroupTheory/PushoutI.lean`), or with the coproduct modulo the base subgroup. `PushoutI`'s
universal property (`PushoutI.homEquiv`) needs a homomorphism *out of* each cyclic factor, and
Mathlib at this pin has no such homomorphism into a nonabelian group: the only general tool is the
*additive* `ZMod.lift` of `Mathlib/Data/ZMod/Basic.lean:1151`, whose target is required to be an
`AddGroup`, i.e. commutative (`Lean`'s additive groups are the commutative ones), while a map out of
`Multiplicative (ZMod 4)` into a presentation is not additive. The route that avoids it — Mathlib's
`zmodMulEquivOfGenerator` (`Mathlib/GroupTheory/SpecificGroups/Cyclic.lean:573`), which *is* an
isomorphism `Multiplicative (ZMod n) ≃* G` for a cyclic `G` with a chosen generator — applies after
`orderOf` facts about the generators of the `SL(2, ℤ)` presentation that are not proved here
(`orderOf S = 4` and `orderOf (TS) = 6` need the completeness of item 1 to move from `SL(2, ℤ)`
back, or an independent argument).
-/

/-- The same group in the generators `S` and `R = TS`: `S⁴` and `R³S⁻²`. -/
def sl2zAmalgamRelators : Set (FreeGroup (Fin 2)) :=
  {FreeGroup.of 0 ^ 4, FreeGroup.of 1 ^ 3 * (FreeGroup.of 0) ^ (-2 : ℤ)}

theorem sl2zS_pow_four : (PresentedGroup.of (rels := sl2zRelators) 0) ^ 4 = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_zpow] using
    (PresentedGroup.one_of_mem (rels := sl2zRelators) (x := FreeGroup.of 0 ^ 4)
      (by simp [sl2zRelators]))

theorem sl2zTS_relator :
    ((PresentedGroup.of (rels := sl2zRelators) 1 * PresentedGroup.of (rels := sl2zRelators) 0) ^ 3 *
        ((PresentedGroup.of (rels := sl2zRelators) 0) ^ 2)⁻¹) = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_inv] using
    (PresentedGroup.one_of_mem (rels := sl2zRelators)
      (x := (FreeGroup.of 1 * FreeGroup.of 0) ^ 3 * ((FreeGroup.of 0) ^ 2)⁻¹)
      (by simp [sl2zRelators]))

theorem amalgamS_pow_four : (PresentedGroup.of (rels := sl2zAmalgamRelators) 0) ^ 4 = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_zpow] using
    (PresentedGroup.one_of_mem (rels := sl2zAmalgamRelators) (x := FreeGroup.of 0 ^ 4)
      (by simp [sl2zAmalgamRelators]))

theorem amalgamR_relator :
    (PresentedGroup.of (rels := sl2zAmalgamRelators) 1) ^ 3 *
        ((PresentedGroup.of (rels := sl2zAmalgamRelators) 0) ^ 2)⁻¹ = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_inv] using
    (PresentedGroup.one_of_mem (rels := sl2zAmalgamRelators)
      (x := FreeGroup.of 1 ^ 3 * ((FreeGroup.of 0) ^ 2)⁻¹)
      (by simp [sl2zAmalgamRelators]))

theorem amalgamR_cube :
    (PresentedGroup.of (rels := sl2zAmalgamRelators) 1) ^ 3 =
      (PresentedGroup.of (rels := sl2zAmalgamRelators) 0) ^ 2 :=
  eq_of_mul_inv_eq_one amalgamR_relator

/-- `T ↦ R S⁻¹` in the amalgam-generator presentation. -/
def sl2zGenValAmalgam : Fin 2 → PresentedGroup sl2zAmalgamRelators :=
  ![PresentedGroup.of 0, PresentedGroup.of 1 * (PresentedGroup.of 0)⁻¹]

lemma sl2zGenValAmalgam_zero : sl2zGenValAmalgam 0 = PresentedGroup.of 0 := rfl

lemma sl2zGenValAmalgam_one :
    sl2zGenValAmalgam 1 = PresentedGroup.of 1 * (PresentedGroup.of 0)⁻¹ := rfl

theorem sl2zRelators_map_one_amalgam :
    ∀ r ∈ sl2zRelators, FreeGroup.lift sl2zGenValAmalgam r = 1 := by
  intro r hr
  simp only [sl2zRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · simpa [sl2zGenValAmalgam_zero, FreeGroup.lift_apply_of, map_pow] using amalgamS_pow_four
  · have key : (PresentedGroup.of (rels := sl2zAmalgamRelators) 1 *
          (PresentedGroup.of (rels := sl2zAmalgamRelators) 0)⁻¹) *
          PresentedGroup.of (rels := sl2zAmalgamRelators) 0 =
        PresentedGroup.of (rels := sl2zAmalgamRelators) 1 := by group
    simpa [sl2zGenValAmalgam_zero, sl2zGenValAmalgam_one, FreeGroup.lift_apply_of, map_pow,
      map_mul, map_zpow, key] using amalgamR_relator

/-- `⟨S, T | S⁴, (TS)³S⁻²⟩ →* ⟨S, R | S⁴, R³S⁻²⟩`, `T ↦ R S⁻¹`. -/
def sl2zToAmalgam : PresentedGroup sl2zRelators →* PresentedGroup sl2zAmalgamRelators :=
  PresentedGroup.toGroup sl2zRelators_map_one_amalgam

theorem sl2zToAmalgam_of (i : Fin 2) :
    sl2zToAmalgam (PresentedGroup.of i) = sl2zGenValAmalgam i :=
  PresentedGroup.toGroup.of sl2zRelators_map_one_amalgam

/-- `R ↦ T S` in the original presentation. -/
def sl2zGenValOrig : Fin 2 → PresentedGroup sl2zRelators :=
  ![PresentedGroup.of 0, PresentedGroup.of 1 * PresentedGroup.of 0]

lemma sl2zGenValOrig_zero : sl2zGenValOrig 0 = PresentedGroup.of 0 := rfl

lemma sl2zGenValOrig_one :
    sl2zGenValOrig 1 = PresentedGroup.of 1 * PresentedGroup.of 0 := rfl

theorem sl2zAmalgamRelators_map_one :
    ∀ r ∈ sl2zAmalgamRelators, FreeGroup.lift sl2zGenValOrig r = 1 := by
  intro r hr
  simp only [sl2zAmalgamRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · simpa [sl2zGenValOrig_zero, FreeGroup.lift_apply_of, map_pow] using sl2zS_pow_four
  · simpa [sl2zGenValOrig_zero, sl2zGenValOrig_one, FreeGroup.lift_apply_of, map_pow, map_mul,
      map_zpow] using sl2zTS_relator

/-- `⟨S, R | S⁴, R³S⁻²⟩ →* ⟨S, T | S⁴, (TS)³S⁻²⟩`, `R ↦ T S`. -/
def sl2zOfAmalgam : PresentedGroup sl2zAmalgamRelators →* PresentedGroup sl2zRelators :=
  PresentedGroup.toGroup sl2zAmalgamRelators_map_one

theorem sl2zOfAmalgam_of (i : Fin 2) :
    sl2zOfAmalgam (PresentedGroup.of i) = sl2zGenValOrig i :=
  PresentedGroup.toGroup.of sl2zAmalgamRelators_map_one

theorem sl2zToAmalgam_comp_ofAmalgam :
    sl2zToAmalgam.comp sl2zOfAmalgam = MonoidHom.id _ := by
  refine PresentedGroup.ext fun i => ?_
  fin_cases i
  · change sl2zToAmalgam (sl2zOfAmalgam (PresentedGroup.of 0)) = PresentedGroup.of 0
    rw [sl2zOfAmalgam_of, sl2zGenValOrig_zero, sl2zToAmalgam_of, sl2zGenValAmalgam_zero]
  · change sl2zToAmalgam (sl2zOfAmalgam (PresentedGroup.of 1)) = PresentedGroup.of 1
    rw [sl2zOfAmalgam_of, sl2zGenValOrig_one, map_mul, sl2zToAmalgam_of, sl2zToAmalgam_of,
      sl2zGenValAmalgam_one, sl2zGenValAmalgam_zero]
    group

theorem sl2zOfAmalgam_comp_toAmalgam :
    sl2zOfAmalgam.comp sl2zToAmalgam = MonoidHom.id _ := by
  refine PresentedGroup.ext fun i => ?_
  fin_cases i
  · change sl2zOfAmalgam (sl2zToAmalgam (PresentedGroup.of 0)) = PresentedGroup.of 0
    rw [sl2zToAmalgam_of, sl2zGenValAmalgam_zero, sl2zOfAmalgam_of, sl2zGenValOrig_zero]
  · change sl2zOfAmalgam (sl2zToAmalgam (PresentedGroup.of 1)) = PresentedGroup.of 1
    rw [sl2zToAmalgam_of, sl2zGenValAmalgam_one, map_mul, map_inv, sl2zOfAmalgam_of,
      sl2zOfAmalgam_of, sl2zGenValOrig_one, sl2zGenValOrig_zero]
    group

/-- lean-categories#89 item 1 in the generators `S` and `R = TS`. -/
def sl2zAmalgamEquiv : PresentedGroup sl2zRelators ≃* PresentedGroup sl2zAmalgamRelators where
  toFun := sl2zToAmalgam
  invFun := sl2zOfAmalgam
  left_inv a := by
    have := congrArg (fun f => f a) sl2zOfAmalgam_comp_toAmalgam
    simpa using this
  right_inv b := by
    have := congrArg (fun f => f b) sl2zToAmalgam_comp_ofAmalgam
    simpa using this
  map_mul' := sl2zToAmalgam.map_mul

/-!
### Item 1: the presentation *is* the amalgam `ℤ/4 *_{ℤ/2} ℤ/6`

The eight cocycle-free definitions below make the identification with Mathlib's categorical pushout
`Monoid.PushoutI` (lean-categories#89's open sketch, now closed):

* `cyclicRelators n` / `Cyclic n` / `cyclicGen n` — the one-relator presentation
  `⟨x | x ^ n⟩` of the cyclic group of order `n`. Taking the diagram's factors as
  *presented* cyclic groups is what makes a homomorphism *out of* them available:
  `PresentedGroup.toGroup` needs no `ZMod` recursion, so the missing constructor the
  earlier sketch named (`ZMod.lift` is additive, hence abelian-target) is not needed.
* `cyclicTwoToFour`, `cyclicTwoToSix` — the diagram `ℤ/2 ⇉ ℤ/4, ℤ/6` (generator to the square, resp.
  the cube), over `amalgamGroup` indexed by `Bool` and `AmalgamPushout := PushoutI amalgamMap`.
* `amalgamPushoutEquiv : PresentedGroup sl2zAmalgamRelators ≃* AmalgamPushout`, built from
  `pushoutToAmalgam` (the pushout's universal property, checked on the two generators and the base)
  and `amalgamToPushout` (`PresentedGroup.toGroup` on the two generators, the second relator being
  `pushout_gen_six_cube`: in the pushout, the cube of the `ℤ/6` generator is the square of the
  `ℤ/4` one because both are the image of the `ℤ/2` generator).

So the presented group is the amalgam, and with `Monoid.PushoutI`'s normal forms
(`NormalWord`, `equiv`, `prod_injective`, `inf_of_range_eq_base_range`) the vocabulary of reduced
words is available for it. What that does *not* give — and what `Sl2zPresentationComplete` still
asks — is that the induced map `AmalgamPushout →* SL(2, ℤ)` is injective: the normal form theorem is
about the pushout itself, not about a map out of it, and the survival of reduced words in
`SL(2, ℤ)` is the Farey/Bass–Serre statement recorded in the module docstring.
-/

def cyclicRelators (n : ℕ) : Set (FreeGroup (Fin 1)) := {FreeGroup.of 0 ^ n}

abbrev Cyclic (n : ℕ) : Type := PresentedGroup (cyclicRelators n)

def cyclicGen (n : ℕ) : Cyclic n := PresentedGroup.of 0

lemma cyclicGen_pow (n : ℕ) : cyclicGen n ^ n = 1 := by
  simpa [cyclicGen, PresentedGroup.of, ← map_pow] using
    (PresentedGroup.one_of_mem (rels := cyclicRelators n) (x := FreeGroup.of 0 ^ n)
      (by simp [cyclicRelators]))

def cyclicTwoToFour : Cyclic 2 →* Cyclic 4 :=
  PresentedGroup.toGroup (f := fun _ => cyclicGen 4 ^ 2) (by
    intro r hr
    simp only [cyclicRelators, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_pow, FreeGroup.lift_apply_of, ← pow_mul]
    norm_num
    exact cyclicGen_pow 4)

def cyclicTwoToSix : Cyclic 2 →* Cyclic 6 :=
  PresentedGroup.toGroup (f := fun _ => cyclicGen 6 ^ 3) (by
    intro r hr
    simp only [cyclicRelators, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_pow, FreeGroup.lift_apply_of, ← pow_mul]
    norm_num
    exact cyclicGen_pow 6)

theorem amalgamR_pow_six :
    (PresentedGroup.of (rels := sl2zAmalgamRelators) (1 : Fin 2)) ^ 6 = 1 := by
  have h3 := amalgamR_cube
  rw [show (6 : ℕ) = 3 * 2 by norm_num, pow_mul, h3, ← pow_mul]
  norm_num
  exact amalgamS_pow_four

def cyclicFourToAmalgam : Cyclic 4 →* PresentedGroup sl2zAmalgamRelators :=
  PresentedGroup.toGroup (f := fun _ => PresentedGroup.of (0 : Fin 2)) (by
    intro r hr
    simp only [cyclicRelators, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_pow, FreeGroup.lift_apply_of]
    exact amalgamS_pow_four)

def cyclicSixToAmalgam : Cyclic 6 →* PresentedGroup sl2zAmalgamRelators :=
  PresentedGroup.toGroup (f := fun _ => PresentedGroup.of (1 : Fin 2)) (by
    intro r hr
    simp only [cyclicRelators, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_pow, FreeGroup.lift_apply_of]
    exact amalgamR_pow_six)

def cyclicTwoToAmalgam : Cyclic 2 →* PresentedGroup sl2zAmalgamRelators :=
  PresentedGroup.toGroup (f := fun _ => (PresentedGroup.of (0 : Fin 2)) ^ 2) (by
    intro r hr
    simp only [cyclicRelators, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_pow, FreeGroup.lift_apply_of, ← pow_mul]
    norm_num
    exact amalgamS_pow_four)

lemma cyclicFourToAmalgam_gen :
    cyclicFourToAmalgam (cyclicGen 4) = PresentedGroup.of (0 : Fin 2) :=
  PresentedGroup.toGroup.of _

lemma cyclicSixToAmalgam_gen :
    cyclicSixToAmalgam (cyclicGen 6) = PresentedGroup.of (1 : Fin 2) :=
  PresentedGroup.toGroup.of _

lemma cyclicTwoToFour_gen : cyclicTwoToFour (cyclicGen 2) = cyclicGen 4 ^ 2 :=
  PresentedGroup.toGroup.of _

lemma cyclicTwoToSix_gen : cyclicTwoToSix (cyclicGen 2) = cyclicGen 6 ^ 3 :=
  PresentedGroup.toGroup.of _

lemma cyclicTwoToAmalgam_gen :
    cyclicTwoToAmalgam (cyclicGen 2) = (PresentedGroup.of (0 : Fin 2)) ^ 2 :=
  PresentedGroup.toGroup.of _

abbrev amalgamGroup : Bool → Type
  | false => Cyclic 4
  | true => Cyclic 6

instance (i : Bool) : Group (amalgamGroup i) := by
  match i with
  | false => exact inferInstanceAs (Group (Cyclic 4))
  | true => exact inferInstanceAs (Group (Cyclic 6))

abbrev amalgamMap : ∀ i, Cyclic 2 →* amalgamGroup i
  | false => cyclicTwoToFour
  | true => cyclicTwoToSix

abbrev AmalgamPushout : Type := Monoid.PushoutI amalgamMap

def pushoutToAmalgam : AmalgamPushout →* PresentedGroup sl2zAmalgamRelators :=
  Monoid.PushoutI.lift (fun i => match i with
      | false => cyclicFourToAmalgam
      | true => cyclicSixToAmalgam)
    cyclicTwoToAmalgam (by
      intro i
      match i with
      | false =>
        refine PresentedGroup.ext fun j => ?_
        fin_cases j
        change cyclicFourToAmalgam (cyclicTwoToFour (cyclicGen 2)) =
          cyclicTwoToAmalgam (cyclicGen 2)
        rw [cyclicTwoToFour_gen, cyclicTwoToAmalgam_gen, map_pow, cyclicFourToAmalgam_gen]
      | true =>
        refine PresentedGroup.ext fun j => ?_
        fin_cases j
        change cyclicSixToAmalgam (cyclicTwoToSix (cyclicGen 2)) =
          cyclicTwoToAmalgam (cyclicGen 2)
        rw [cyclicTwoToSix_gen, cyclicTwoToAmalgam_gen, map_pow, cyclicSixToAmalgam_gen,
          amalgamR_cube])

/-! ### The other direction and the equivalence -/

def amalgamToPushoutGenerators : Fin 2 → AmalgamPushout :=
  ![Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4),
    Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6)]

lemma amalgamToPushoutGenerators_zero :
    amalgamToPushoutGenerators 0 = Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4) := rfl

lemma amalgamToPushoutGenerators_one :
    amalgamToPushoutGenerators 1 = Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6) := rfl

lemma pushout_of_one_apply_base :
    Monoid.PushoutI.of (φ := amalgamMap) true (cyclicTwoToSix (cyclicGen 2)) =
      Monoid.PushoutI.base amalgamMap (cyclicGen 2) :=
  Monoid.PushoutI.of_apply_eq_base (φ := amalgamMap) true (cyclicGen 2)

lemma pushout_of_zero_apply_base :
    Monoid.PushoutI.of (φ := amalgamMap) false (cyclicTwoToFour (cyclicGen 2)) =
      Monoid.PushoutI.base amalgamMap (cyclicGen 2) :=
  Monoid.PushoutI.of_apply_eq_base (φ := amalgamMap) false (cyclicGen 2)

/-- In the pushout, the cube of the `ℤ/6` generator is the square of the `ℤ/4` one: both are the
image of the `ℤ/2` generator. -/
theorem pushout_gen_six_cube :
    (Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6)) ^ 3 =
      (Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4)) ^ 2 := by
  have e1 : (Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6)) ^ 3 =
      Monoid.PushoutI.of (φ := amalgamMap) true (cyclicTwoToSix (cyclicGen 2)) := by
    rw [← map_pow]
    exact congrArg _ cyclicTwoToSix_gen.symm
  have e0 : (Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4)) ^ 2 =
      Monoid.PushoutI.of (φ := amalgamMap) false (cyclicTwoToFour (cyclicGen 2)) := by
    rw [← map_pow]
    exact congrArg _ cyclicTwoToFour_gen.symm
  rw [e1, e0, pushout_of_one_apply_base, pushout_of_zero_apply_base]

def amalgamToPushout : PresentedGroup sl2zAmalgamRelators →* AmalgamPushout :=
  PresentedGroup.toGroup (f := amalgamToPushoutGenerators) (by
    intro r hr
    simp only [sl2zAmalgamRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
    rcases hr with rfl | rfl
    · rw [map_pow, FreeGroup.lift_apply_of, amalgamToPushoutGenerators_zero, ← map_pow,
        cyclicGen_pow, map_one]
    · rw [map_mul, map_pow, map_zpow, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of,
        amalgamToPushoutGenerators_zero, amalgamToPushoutGenerators_one, pushout_gen_six_cube]
      group)

lemma amalgamToPushout_of (i : Fin 2) :
    amalgamToPushout (PresentedGroup.of i) = amalgamToPushoutGenerators i :=
  PresentedGroup.toGroup.of _

theorem pushoutToAmalgam_comp_amalgamToPushout :
    pushoutToAmalgam.comp amalgamToPushout = MonoidHom.id _ := by
  refine PresentedGroup.ext fun i => ?_
  fin_cases i
  · change pushoutToAmalgam (amalgamToPushout (PresentedGroup.of (0 : Fin 2))) =
      PresentedGroup.of 0
    rw [amalgamToPushout_of, amalgamToPushoutGenerators_zero]
    simp only [pushoutToAmalgam, Monoid.PushoutI.lift_of]
    exact cyclicFourToAmalgam_gen
  · change pushoutToAmalgam (amalgamToPushout (PresentedGroup.of (1 : Fin 2))) =
      PresentedGroup.of 1
    rw [amalgamToPushout_of, amalgamToPushoutGenerators_one]
    simp only [pushoutToAmalgam, Monoid.PushoutI.lift_of]
    exact cyclicSixToAmalgam_gen

theorem amalgamToPushout_comp_pushoutToAmalgam :
    amalgamToPushout.comp pushoutToAmalgam = MonoidHom.id _ := by
  refine Monoid.PushoutI.hom_ext_nonempty (fun i => ?_)
  match i with
  | false =>
    refine PresentedGroup.ext fun j => ?_
    fin_cases j
    change amalgamToPushout (pushoutToAmalgam
        (Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4))) =
      Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4)
    simp only [pushoutToAmalgam, Monoid.PushoutI.lift_of, cyclicFourToAmalgam_gen,
      amalgamToPushout_of, amalgamToPushoutGenerators_zero]
  | true =>
    refine PresentedGroup.ext fun j => ?_
    fin_cases j
    change amalgamToPushout (pushoutToAmalgam
        (Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6))) =
      Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6)
    simp only [pushoutToAmalgam, Monoid.PushoutI.lift_of, cyclicSixToAmalgam_gen,
      amalgamToPushout_of, amalgamToPushoutGenerators_one]

/-- **The presented group is the amalgam.** `⟨S, R | S⁴, R³ = S²⟩` is the pushout of
`ℤ/4 ← ℤ/2 → ℤ/6` (`cyclicTwoToFour`, `cyclicTwoToSix`), which is the sense in which item 1's
presentation is the amalgam `ℤ/4 *_{ℤ/2} ℤ/6`. -/
def amalgamPushoutEquiv : PresentedGroup sl2zAmalgamRelators ≃* AmalgamPushout where
  toFun := amalgamToPushout
  invFun := pushoutToAmalgam
  left_inv a := by
    have := congrArg (fun f => f a) pushoutToAmalgam_comp_amalgamToPushout
    simpa using this
  right_inv b := by
    have := congrArg (fun f => f b) amalgamToPushout_comp_pushoutToAmalgam
    simpa using this
  map_mul' := amalgamToPushout.map_mul

/-!
### Item 1: the two cyclic factors, and exactly what is still missing

The presentation's first generator has order exactly four, and the word `T S` order exactly six —
first in `SL(2, ℤ)` (`S_sq_ne_one`, `S_ne_one`, `T_mul_S_sq_ne_one`, `T_mul_S_ne_one`,
`T_mul_S_cube_ne_one`, `T_mul_S_pow_six`) and then in the presented group itself, where the map to
`SL(2, ℤ)` detects every vanishing power: `of_zero_ne_one`, `of_zero_sq_ne_one`,
`of_one_mul_of_zero_sq_ne_one`, `of_one_mul_of_zero_cube_ne_one`, with the vanishing powers
`sl2zS_pow_four` and `of_one_mul_of_zero_pow_six`.

So the presented group contains `ℤ/4` and `ℤ/6`, generated by `S` and by `T S`, glued along
`S² = (TS)³` (`sl2zTS_relator`), and maps onto `SL(2, ℤ)`. What `Sl2zPresentationComplete` still
asks is the one remaining amalgam datum: that `⟨S⟩` and `⟨T S⟩` meet in exactly `⟨S²⟩` inside the
presented group — equivalently, that no nonempty reduced word in the two factors is trivial. The
descent above does not reach it (see the section "Component 1 of the completeness proof": the base
case of the descent's induction quantifies over all words whose product has `colHeight ≤ 1`, which
already includes `ker sl2zToGroup`), and the stratum classification below does not reach it either —
that is arithmetic about matrices, while the residue is a statement about words. The pushout
identification is done (`amalgamPushoutEquiv`, above), so the one datum left is: the induced map
`AmalgamPushout →* SL(2, ℤ)` is injective, equivalently no nonempty reduced word of the amalgam dies
there. `Monoid.PushoutI`'s normal forms (`NormalWord`, `equiv`, `prod_injective`,
`inf_of_range_eq_base_range`) are about the pushout, not about a map out of it, and there is no
Farey graph and no Bass–Serre theory at this pin. Closing it is a unit of its own, not a probe or a
repair of this file.

One measured warning for whoever builds it. The obvious height on Farey triangles — the sum
of `|p| + |q|` over the three cusps — does *not* satisfy the acyclicity criterion as it stands:
checked over the 180 bases with `|entries| ≤ 4` and `det = 1`, no triangle ever has two flips
that decrease it and none has three, but the fundamental triangle `{0, 1, ∞}` has a neighbour of
*equal* height, so "no edge joins equal heights" fails and the maximum-vertex argument does not
close. Either the height needs a tiebreak at the fundamental level, or the criterion must be
weakened to "the subgraph induced on each level is acyclic", which the same data does support.
Taking the sum at face value and expecting `omega` to finish would fail at exactly this point.
-/

theorem S_sq_ne_one : (S : SL(2, ℤ)) ^ 2 ≠ 1 := by
  rw [pow_two, S_mul_S_eq]
  decide

theorem S_ne_one : (S : SL(2, ℤ)) ≠ 1 := by decide

theorem T_mul_S_sq_ne_one : (T * S : SL(2, ℤ)) ^ 2 ≠ 1 := by decide

theorem T_mul_S_ne_one : (T * S : SL(2, ℤ)) ≠ 1 := by decide

theorem T_mul_S_cube_ne_one : (T * S : SL(2, ℤ)) ^ 3 ≠ 1 := by
  rw [T_mul_S_pow_three_eq_S_sq]
  exact S_sq_ne_one

theorem T_mul_S_pow_six : (T * S : SL(2, ℤ)) ^ 6 = 1 := by
  have hS : (S : SL(2, ℤ)) ^ 2 = -1 := by rw [pow_two, S_mul_S_eq]
  rw [show (6 : ℕ) = 3 * 2 by norm_num, pow_mul, T_mul_S_pow_three_eq_S_sq, hS]
  decide

theorem of_zero_sq_ne_one : (PresentedGroup.of (rels := sl2zRelators) 0) ^ 2 ≠ 1 := by
  intro h
  have h2 : sl2zToGroup ((PresentedGroup.of (rels := sl2zRelators) 0) ^ 2) = 1 := by
    rw [h, map_one]
  rw [map_pow, sl2zToGroup_of, sl2zGenVal_zero] at h2
  exact S_sq_ne_one h2

theorem of_zero_ne_one : (PresentedGroup.of (rels := sl2zRelators) 0) ≠ 1 := by
  intro h
  have h2 : sl2zToGroup (PresentedGroup.of (rels := sl2zRelators) 0) = 1 := by rw [h, map_one]
  rw [sl2zToGroup_of, sl2zGenVal_zero] at h2
  exact S_ne_one h2

theorem of_one_mul_of_zero_sq_ne_one :
    (PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 2 ≠ 1 := by
  intro h
  have h2 : sl2zToGroup ((PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 2) = 1 := by rw [h, map_one]
  rw [map_pow, map_mul, sl2zToGroup_of, sl2zToGroup_of, sl2zGenVal_zero, sl2zGenVal_one] at h2
  exact T_mul_S_sq_ne_one h2

theorem of_one_mul_of_zero_cube_ne_one :
    (PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 3 ≠ 1 := by
  intro h
  have h2 : sl2zToGroup ((PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 3) = 1 := by rw [h, map_one]
  rw [map_pow, map_mul, sl2zToGroup_of, sl2zToGroup_of, sl2zGenVal_zero, sl2zGenVal_one] at h2
  exact T_mul_S_cube_ne_one h2

theorem of_one_mul_of_zero_pow_six :
    (PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 6 = 1 := by
  have hcube : (PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 3 =
      (PresentedGroup.of (rels := sl2zRelators) 0) ^ 2 :=
    eq_of_mul_inv_eq_one sl2zTS_relator
  rw [show (6 : ℕ) = 3 * 2 by norm_num, pow_mul, hcube, ← pow_mul,
    show (2 * 2 : ℕ) = 4 by norm_num, sl2zS_pow_four]
/-- The first columns of the eight lifts are pairwise distinct: that is what makes the eight cosets
distinct rather than merely eight. -/
lemma cuspLift_firstColumn_injective :
    Function.Injective (fun i : Fin 8 => firstColumn (cuspLift i)) := by decide

/-- The parametric description of the stratum is injective: `cuspLift i * T ^ b` determines `i` and
`b`. The index is read off the first column (`cuspLift_firstColumn_injective`, which right
multiplication by `T` leaves alone) and then `b` is read off the `(0, 1)` entry of `T ^ b`. -/
theorem cuspLift_mul_T_zpow_injective {i i' : Fin 8} {b b' : ℤ}
    (h : cuspLift i * T ^ b = cuspLift i' * T ^ b') : i = i' ∧ b = b' := by
  have hcol : firstColumn (cuspLift i) = firstColumn (cuspLift i') := by
    have := congrArg firstColumn h
    simpa [firstColumn_mul_T_zpow] using this
  have hii : i = i' := cuspLift_firstColumn_injective hcol
  subst hii
  refine ⟨rfl, ?_⟩
  have h1 : T ^ b = T ^ b' := mul_left_cancel h
  have h2 := congrArg (fun X : SL(2, ℤ) => X.1 0 1) h1
  rw [coe_T_zpow, coe_T_zpow] at h2
  exact h2

/-- `Fin 8 × ℤ` parametrizes the stratum without repetition. -/
theorem cuspLift_pair_injective :
    Function.Injective (fun p : Fin 8 × ℤ => cuspLift p.1 * T ^ p.2) := by
  rintro ⟨i, b⟩ ⟨i', b'⟩ h
  obtain ⟨rfl, rfl⟩ := cuspLift_mul_T_zpow_injective h
  rfl

/-- **The cusp stratum, exactly.** `A : SL(2, ℤ)` has first-column height at most one exactly when
it is `cuspLift i * T ^ b` for a *unique* pair `(i, b)`. This closes the arithmetic of component 2:
the stratum is a bijective image of `Fin 8 × ℤ`. What is not arithmetic, and is what
`Sl2zPresentationComplete` still asks, is the word-level statement that the eight lifts' canonical
words are a transversal — that no word of `PresentedGroup sl2zRelators` is normal-closure equivalent
to two of them. -/
theorem colHeight_le_one_iff_existsUnique (A : SL(2, ℤ)) :
    colHeight A.1 ≤ 1 ↔ ∃! p : Fin 8 × ℤ, A = cuspLift p.1 * T ^ p.2 := by
  rw [colHeight_le_one_iff]
  constructor
  · rintro ⟨i, b, rfl⟩
    exact ⟨(i, b), rfl, fun q hq => cuspLift_pair_injective (by simpa using hq.symm)⟩
  · rintro ⟨⟨i, b⟩, h, _⟩
    exact ⟨i, b, h⟩

lemma cuspLift_zero_eq : cuspLift 0 = (1 : SL(2, ℤ)) := Subtype.ext (by decide)

lemma cuspLift_one_eq : cuspLift 1 = (-1 : SL(2, ℤ)) := Subtype.ext (by decide)

/-- Of the eight lifts, only `1` and `-1` have second first-column entry zero. -/
lemma cuspLift_snd_firstColumn_eq_zero (i : Fin 8) (h : (firstColumn (cuspLift i)).2 = 0) :
    i = 0 ∨ i = 1 := by
  fin_cases i
  · exact Or.inl rfl
  · exact Or.inr rfl
  all_goals simp [firstColumn, cuspLift_two, cuspLift_three, cuspLift_four, cuspLift_five,
    cuspLift_six, cuspLift_seven] at h

/-- **The stabilizer of the cusp `∞`.** A matrix whose first column is `(±1, 0)` — i.e. one that
fixes `∞ = 1/0` — is `±T ^ b`. This is the cusp-level vertex stabilizer that the Farey model of the
Bass–Serre tree of `⟨S⟩ *_{⟨S²⟩} ⟨TS⟩` needs: it identifies the stabilizer of `∞` with `⟨T⟩` up to
the central sign, and it is proved from the stratum classification rather than by any group theory
(`cuspLift_snd_firstColumn_eq_zero` is the finite part: of the eight lifts only `1` and `-1` have
second first-column entry zero). -/
theorem eq_T_zpow_or_neg_of_cusp_fixed (A : SL(2, ℤ)) (h : A.1 1 0 = 0) :
    ∃ b : ℤ, A = T ^ b ∨ A = -(T ^ b) := by
  have hdet := det_entries A
  rw [h, mul_zero, sub_zero] at hdet
  have hcol : colHeight A.1 ≤ 1 := by
    rw [colHeight_apply, h, abs_zero, max_le_iff]
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hdet with ha | ha
    · exact ⟨by rw [ha]; norm_num, by norm_num⟩
    · exact ⟨by rw [ha]; norm_num, by norm_num⟩
  obtain ⟨i, b, hA⟩ := (colHeight_le_one_iff A).mp hcol
  have hfirst : (firstColumn (cuspLift i)).2 = 0 := by
    rw [← firstColumn_mul_T_zpow, ← hA, firstColumn, h]
  rcases cuspLift_snd_firstColumn_eq_zero i hfirst with rfl | rfl
  · exact ⟨b, Or.inl (by rw [hA, cuspLift_zero_eq, one_mul])⟩
  · exact ⟨b, Or.inr (by rw [hA, cuspLift_one_eq, neg_one_mul])⟩

/-!
### Why the descent cannot see the survival statement

The six amalgam letters — `S`, `S³` for the `ℤ/4` factor and `R`, `R²`, `R⁴`, `R⁵` for the `ℤ/6`
factor, `R = TS` — all lie in the stratum `colHeight = 1` (`colHeight_letters`). So the measure the
descent drives down is already minimal on every generator, and its length is no lower bound for the
length of a reduced word: computed over the 37 448 reduced words of length up to ten, the
descent length is `0` on the majority of them (a length-ten example has product
`!![-1,4;1,-5]`, first column `(-1,1)`, height one). That is the precise sense in which
component 1 cannot be iterated into component 2, and why the survival statement needs the tree
rather than a better measure on matrices.
-/

/-- The six amalgam letters all already lie in the cusp stratum, so the descent's measure is
minimal on each of them. -/
theorem colHeight_letters :
    colHeight (S : SL(2, ℤ)).1 = 1
      ∧ colHeight ((S : SL(2, ℤ)) ^ 3).1 = 1
      ∧ colHeight (T * S : SL(2, ℤ)).1 = 1
      ∧ colHeight ((T * S : SL(2, ℤ)) ^ 2).1 = 1
      ∧ colHeight ((T * S : SL(2, ℤ)) ^ 4).1 = 1
      ∧ colHeight ((T * S : SL(2, ℤ)) ^ 5).1 = 1 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

/-!
### The column dictionary for the Bass–Serre tree

The tree of `⟨S⟩ *_{⟨S²⟩} ⟨TS⟩` has two kinds of vertex: `⟨S⟩`-cosets and `⟨TS⟩`-cosets. Both are
read off a matrix's columns, which is what this section starts making explicit:

* right multiplication by `S` sends the columns `(u, v)` to `(v, -u)` (`col_mul_S`), so the
  `⟨S⟩`-orbit of a matrix is its *unordered pair of columns up to sign* — a Farey edge;
* right multiplication by `S² = -1` sends `(u, v)` to `(-u, -v)` (`col_mul_S_sq`);
* right multiplication by `R = T * S` sends `(u, v)` to `(u + v, -u)` (`col_mul_R`), so the
  `⟨R⟩`-orbit is the *triple of lines* `±u`, `±v`, `±(u + v)` — a Farey triangle, of which `⟨R⟩`
  (order 6) is exactly the symmetry group;
* `⟨S²⟩ = ⟨R³⟩ = {±1}` acts trivially, which is why the edge and the triangle are the right
  coarse invariants and the amalgamated subgroup is the kernel of both readings.

The set-level form of the same two statements is `edgeLines_mul_S` and `triangleLines_mul_R`: the
Farey edge `{±u, ±v}` is fixed by right multiplication by `S` and the Farey triangle
`{±u, ±v, ±(u + v)}` by right multiplication by `R`, so the two orbit types of the tree *are* these
two sets of lines.

The local structure of the graph is `eq_pm_of_adjacent`: for a Farey basis `(u, v)`, a line adjacent
to both is one of `±u ± v`, so **the edge `{±u, ±v}` has exactly two triangular sides** and no
third.
That lemma is the basis-expansion `w = fdet w v • u - fdet w u • v` (`fdet_repr`), with the two
coefficients forced to `±1` by the two adjacency conditions.

What is *not* here: acyclicity of the incidence graph, and the bridge from acyclicity to "no
nonempty reduced word dies". Those are the rest of the tree unit; the column formulas, the two line
sets and the two-sides lemma are what it reads the vertices and edges with.
-/

/-- The `j`-th column of an `SL(2, ℤ)` matrix, as a pair of integers. -/
def col (X : SL(2, ℤ)) (j : Fin 2) : ℤ × ℤ := (X.1 0 j, X.1 1 j)

lemma col_zero (X : SL(2, ℤ)) : col X 0 = (X.1 0 0, X.1 1 0) := rfl

lemma col_one (X : SL(2, ℤ)) : col X 1 = (X.1 0 1, X.1 1 1) := rfl

/-- Right multiplication by `S` sends the columns `(u, v)` to `(v, -u)`: the `⟨S⟩`-orbit of a matrix
is its unordered pair of columns up to sign. -/
lemma col_mul_S (X : SL(2, ℤ)) :
    col (X * S) 0 = col X 1 ∧ col (X * S) 1 = -col X 0 := by
  constructor <;>
    · ext <;> simp [col, coe_mul, coe_S, Matrix.mul_apply, Fin.sum_univ_two]

lemma col_mul_S_sq (X : SL(2, ℤ)) :
    col (X * S ^ 2) 0 = -col X 0 ∧ col (X * S ^ 2) 1 = -col X 1 := by
  have hS2 : (S : SL(2, ℤ)) ^ 2 = -1 := by rw [pow_two, S_mul_S_eq]
  have h : (X * S ^ 2 : SL(2, ℤ)) = -(X : SL(2, ℤ)) := by rw [hS2, mul_neg, mul_one]
  constructor <;> · rw [h]; ext <;> simp [col]

/-- Right multiplication by `R = T * S` sends the columns `(u, v)` to `(u + v, -u)`: the `⟨R⟩`-orbit
of a matrix is the triple of lines `±u`, `±v`, `±(u + v)`, a Farey triangle. -/
lemma col_mul_R (X : SL(2, ℤ)) :
    col (X * (T * S)) 0 = col X 0 + col X 1 ∧ col (X * (T * S)) 1 = -col X 0 := by
  constructor <;>
    · ext <;> simp [col, coe_mul, coe_T, coe_S, Matrix.mul_apply, Fin.sum_univ_two]

/-- The two lines spanned by the columns of a matrix: the Farey edge that the `⟨S⟩`-coset of the
matrix fixes. -/
def edgeLines (X : SL(2, ℤ)) : Set (ℤ × ℤ) :=
  {u | u = col X 0 ∨ u = -col X 0 ∨ u = col X 1 ∨ u = -col X 1}

lemma edgeLines_mul_S (X : SL(2, ℤ)) : edgeLines (X * S) = edgeLines X := by
  have h0 := (col_mul_S X).1
  have h1 := (col_mul_S X).2
  have h2 : - -col X 0 = col X 0 := by abel
  simp only [edgeLines, h0, h1, h2]
  simp only [or_comm, or_left_comm, or_assoc]

/-- The three lines spanned by the two columns of a matrix and their sum: the Farey triangle that
the `⟨R⟩`-coset of the matrix fixes. -/
def triangleLines (X : SL(2, ℤ)) : Set (ℤ × ℤ) :=
  {u | u = col X 0 ∨ u = -col X 0 ∨ u = col X 1 ∨ u = -col X 1 ∨
    u = col X 0 + col X 1 ∨ u = -(col X 0 + col X 1)}

lemma triangleLines_mul_R (X : SL(2, ℤ)) :
    triangleLines (X * (T * S)) = triangleLines X := by
  have h0 := (col_mul_R X).1
  have h1 := (col_mul_R X).2
  have h2 : (col X 0 + col X 1) + -col X 0 = col X 1 := by abel
  have h3 : -(-col X 0) = col X 0 := by abel
  simp only [triangleLines, h0, h1, h2, h3]
  simp only [or_comm, or_left_comm, or_assoc]

/-- The determinant pairing on pairs of integer vectors. -/
def fdet (u v : ℤ × ℤ) : ℤ := u.1 * v.2 - u.2 * v.1

lemma abs_eq_one_of_abs_eq_one (x : ℤ) (h : |x| = 1) : x = 1 ∨ x = -1 := by
  have h' : |x| = |(1 : ℤ)| := by rwa [abs_one]
  exact abs_eq_abs.mp h'

/-- A vector is determined by its pairings with the members of a Farey basis: its coordinates in the
basis `(u, v)` are `fdet w v` and `-fdet w u`. -/
lemma fdet_repr (u v w : ℤ × ℤ) (h : fdet u v = 1) :
    w = (fdet w v * u.1 + (-fdet w u) * v.1, fdet w v * u.2 + (-fdet w u) * v.2) := by
  have h' : u.1 * v.2 - u.2 * v.1 = 1 := h
  have h1 : w.1 * (u.1 * v.2 - u.2 * v.1) = w.1 := by rw [h']; ring
  have h2 : w.2 * (u.1 * v.2 - u.2 * v.1) = w.2 := by rw [h']; ring
  ext <;> simp only [fdet] <;> nlinarith [h1, h2]

/-- **The two sides of an edge.** If `(u, v)` is a Farey basis, a vector adjacent to both `u`
and `v` is one of `±u ± v`: there is no third triangle on the edge `{±u, ±v}`, which is the local
input for "each edge of the tree has exactly two sides". -/
theorem eq_pm_of_adjacent (u v w : ℤ × ℤ) (h : fdet u v = 1)
    (hu : |fdet w u| = 1) (hv : |fdet w v| = 1) :
    ∃ ε₁ ε₂ : ℤ, (ε₁ = 1 ∨ ε₁ = -1) ∧ (ε₂ = 1 ∨ ε₂ = -1) ∧
      w = (ε₁ * u.1 + ε₂ * v.1, ε₁ * u.2 + ε₂ * v.2) := by
  refine ⟨fdet w v, -fdet w u, ?_, ?_, ?_⟩
  · exact abs_eq_one_of_abs_eq_one _ hv
  · have hu' : |-fdet w u| = 1 := by rwa [abs_neg]
    exact abs_eq_one_of_abs_eq_one _ hu'
  · exact fdet_repr u v w h

end ModularGroup

namespace LeanCategories.ForMathlib

open Matrix ModularGroup

/-- The matrix `diag(1, -1)` over `ℤ`. -/
def eMatrix : Matrix (Fin 2) (Fin 2) ℤ := !![1, 0; 0, -1]

theorem eMatrix_mul_self : eMatrix * eMatrix = 1 := by decide

/-- The element `e = diag(1, -1)` of `GL(2, ℤ)` of lean-categories#89 item 2. Its unit inverse is
itself, so it is built from one matrix and one product identity. -/
def eGL : GL (Fin 2) ℤ := ⟨eMatrix, eMatrix, eMatrix_mul_self, eMatrix_mul_self⟩

@[simp]
theorem coe_eGL : ((eGL : GL (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) = eMatrix := rfl

@[simp]
theorem coe_eGL_inv : ((eGL⁻¹ : GL (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) = eMatrix := rfl

/-- `det e = -1`: `e` is not in `SL(2, ℤ)`, which is the kernel of `det`. -/
theorem det_eGL : GeneralLinearGroup.det eGL = -1 := by
  apply Units.ext
  rw [GeneralLinearGroup.val_det_apply, coe_eGL, eMatrix, Units.val_neg, Units.val_one]
  decide

/-- `e ^ 2 = 1`: the first relation of the adjoined presentation. -/
theorem eGL_sq : eGL ^ 2 = 1 := by decide

/-- `e * e = 1` in the multiplicative form used by `inv_eq_of_mul_eq_one_right`. -/
theorem eGL_mul_self : eGL * eGL = 1 := by
  rw [← pow_two]
  exact eGL_sq

/-- `e S e⁻¹ = S⁻¹`: the conjugate of `S` by `e`, as a word in `S`. -/
theorem eGL_conj_S :
    eGL * SpecialLinearGroup.toGL S * eGL⁻¹ = SpecialLinearGroup.toGL S⁻¹ := by
  decide

/-- `e T e⁻¹ = T⁻¹`: the conjugate of `T` by `e`, as a word in `T`. -/
theorem eGL_conj_T :
    eGL * SpecialLinearGroup.toGL T * eGL⁻¹ = SpecialLinearGroup.toGL T⁻¹ := by
  decide

/-- The subgroup `{1, e}` of `GL(2, ℤ)`. -/
def pairSubgroup : Subgroup (GL (Fin 2) ℤ) where
  carrier := {1, eGL}
  mul_mem' := by
    rintro a b (rfl | rfl) (rfl | rfl) <;> simp [eGL_mul_self]
  one_mem' := Set.mem_insert _ _
  inv_mem' := by
    rintro a (rfl | rfl)
    · exact Set.mem_insert _ _
    · rw [inv_eq_of_mul_eq_one_right eGL_mul_self]
      exact Set.mem_insert_of_mem _ rfl

/-- The subgroup generated by `e` is `{1, e}`, because `e ^ 2 = 1`. -/
theorem closure_eGL_eq_pairSubgroup : Subgroup.closure {eGL} = pairSubgroup := by
  refine le_antisymm ?_ (fun x hx => ?_)
  · refine (Subgroup.closure_le (K := pairSubgroup)).mpr ?_
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact Set.mem_insert_of_mem _ (Set.mem_singleton eGL)
  · change x ∈ ({1, eGL} : Set (GL (Fin 2) ℤ)) at hx
    rcases hx with rfl | rfl
    · exact one_mem _
    · exact Subgroup.subset_closure (Set.mem_singleton eGL)

/-- `⟨e⟩` meets `det⁻¹(1)` only in the identity: the two factors of the semidirect product of
lean-categories#89 item 2 are independent. -/
theorem disjoint_eGL_detKer :
    Disjoint (Subgroup.closure {eGL})
      (GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker := by
  rw [disjoint_iff_inf_le]
  intro x hx
  rw [Subgroup.mem_inf, MonoidHom.mem_ker] at hx
  obtain ⟨hx1, hx2⟩ := hx
  rw [closure_eGL_eq_pairSubgroup] at hx1
  change x ∈ ({1, eGL} : Set (GL (Fin 2) ℤ)) at hx1
  rcases hx1 with rfl | rfl
  · exact Subgroup.mem_bot.mpr rfl
  · rw [det_eGL] at hx2
    exact absurd hx2 (by decide)

/-- Every element of `GL(2, ℤ)` is `c * s` with `c ∈ ⟨e⟩` and `s ∈ det⁻¹(1)`: the multiplication
map of the two factors is onto. -/
theorem mul_closure_eGL_detKer :
    ((Subgroup.closure {eGL} : Set (GL (Fin 2) ℤ)) *
        ((GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker : Set (GL (Fin 2) ℤ))) =
      Set.univ := by
  rw [Set.eq_univ_iff_forall]
  intro g
  rcases Int.units_eq_one_or (GeneralLinearGroup.det g) with h | h
  · refine Set.mem_mul.mpr ⟨1, Subgroup.one_mem _, g, MonoidHom.mem_ker.mpr h, one_mul g⟩
  · refine Set.mem_mul.mpr ⟨eGL, Subgroup.subset_closure (Set.mem_singleton eGL), eGL * g, ?_, ?_⟩
    · exact MonoidHom.mem_ker.mpr (by rw [map_mul, det_eGL, h]; decide)
    · rw [← mul_assoc, eGL_mul_self, one_mul]

/-- `SL(2, ℤ)` is normal in `GL(2, ℤ)`, being the kernel of the determinant: the normal factor of
the semidirect product of lean-categories#89 item 2. -/
theorem normal_detKer :
    (GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker.Normal :=
  MonoidHom.normal_ker _

/-- `GL(2, ℤ) = SL(2, ℤ) ⋊ ⟨e⟩` for `e = diag(1, -1)`, in internal form: the subgroup `⟨e⟩` and
the kernel of `det` (which is `SL(2, ℤ)`, see `SpecialLinearGroup.range_toGL_eq_ker_det`) are
complementary. -/
theorem gl2z_isComplement :
    (Subgroup.closure {eGL}).IsComplement'
      (GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker :=
  Subgroup.isComplement'_of_disjoint_and_mul_eq_univ disjoint_eGL_detKer mul_closure_eGL_detKer

/-- The generators of lean-categories#89 item 2's presentation of `GL(2, ℤ)` as a family
`Fin 3 → GL(2, ℤ)`: index `0` is `S`, `1` is `T`, `2` is `e = diag(1, -1)`. -/
def gl2zGenVal : Fin 3 → GL (Fin 2) ℤ :=
  ![SpecialLinearGroup.toGL S, SpecialLinearGroup.toGL T, eGL]

lemma gl2zGenVal_zero : gl2zGenVal 0 = SpecialLinearGroup.toGL S := rfl

lemma gl2zGenVal_one : gl2zGenVal 1 = SpecialLinearGroup.toGL T := rfl

lemma gl2zGenVal_two : gl2zGenVal 2 = eGL := rfl

/-- `S`, `T` and `e` generate `GL(2, ℤ)`: `S` and `T` generate `SL(2, ℤ)` and `e` completes it as
the semidirect product `gl2z_isComplement`. -/
theorem closure_gens_gl2z :
    Subgroup.closure ({SpecialLinearGroup.toGL S, SpecialLinearGroup.toGL T, eGL} :
      Set (GL (Fin 2) ℤ)) = ⊤ := by
  set gens : Set (GL (Fin 2) ℤ) := {SpecialLinearGroup.toGL S, SpecialLinearGroup.toGL T, eGL}
  have hSL : (⊤ : Subgroup (SL(2, ℤ))) ≤ Subgroup.comap SpecialLinearGroup.toGL
      (Subgroup.closure gens) := by
    rw [← SpecialLinearGroup.SL2Z_generators]
    refine (Subgroup.closure_le
      (K := Subgroup.comap SpecialLinearGroup.toGL (Subgroup.closure gens))).mpr ?_
    rintro x (rfl | rfl) <;> exact Subgroup.subset_closure (by simp [gens])
  have hker : (GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker ≤ Subgroup.closure gens := by
    intro s hs
    have hs' : s ∈ (SpecialLinearGroup.toGL (n := Fin 2) (R := ℤ)).range := by
      rw [SpecialLinearGroup.range_toGL_eq_ker_det]
      exact hs
    obtain ⟨a, rfl⟩ := hs'
    exact hSL (Subgroup.mem_top a)
  have he : Subgroup.closure {eGL} ≤ Subgroup.closure gens := by
    refine (Subgroup.closure_le (K := Subgroup.closure gens)).mpr ?_
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact Subgroup.subset_closure (by simp [gens])
  refine eq_top_iff.mpr (fun g _ => ?_)
  have hg : g ∈ ((Subgroup.closure {eGL} : Set (GL (Fin 2) ℤ)) *
      ((GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker : Set (GL (Fin 2) ℤ))) :=
    mul_closure_eGL_detKer ▸ Set.mem_univ g
  obtain ⟨c, hc, s, hs, hcs⟩ := Set.mem_mul.mp hg
  rw [← hcs]
  exact mul_mem (he hc) (hker hs)

/-- `GL(2, ℤ)` is generated by the three elements of lean-categories#89 item 2's presentation. -/
def gl2zGenerators : Group.Generators (GL (Fin 2) ℤ) (Fin 3) where
  val := gl2zGenVal
  closure_eq_top := by
    have hrange : Set.range gl2zGenVal =
        {SpecialLinearGroup.toGL S, SpecialLinearGroup.toGL T, eGL} := by
      ext x
      constructor
      · rintro ⟨i, rfl⟩
        fin_cases i
        · exact Set.mem_insert _ _
        · exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
        · exact Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton eGL))
      · rintro (rfl | rfl | rfl)
        · exact ⟨0, rfl⟩
        · exact ⟨1, rfl⟩
        · exact ⟨2, rfl⟩
    rw [hrange]
    exact closure_gens_gl2z

/-- The relators of lean-categories#89 item 2's presentation of `GL(2, ℤ)`: the two relators of the
`SL(2, ℤ)` presentation, `e²`, and the two conjugates `e S e⁻¹ S` and `e T e⁻¹ T` recording
`e S e⁻¹ = S⁻¹` and `e T e⁻¹ = T⁻¹` (`eGL_conj_S`, `eGL_conj_T`). -/
def gl2zRelators : Set (FreeGroup (Fin 3)) :=
  {FreeGroup.of 0 ^ 4,
    (FreeGroup.of 1 * FreeGroup.of 0) ^ 3 * (FreeGroup.of 0) ^ (-2 : ℤ),
    FreeGroup.of 2 ^ 2,
    FreeGroup.of 2 * FreeGroup.of 0 * (FreeGroup.of 2)⁻¹ * FreeGroup.of 0,
    FreeGroup.of 2 * FreeGroup.of 1 * (FreeGroup.of 2)⁻¹ * FreeGroup.of 1}

/-- Each relator of `gl2zRelators` dies in `GL(2, ℤ)`. -/
theorem gl2zRelators_map_one : ∀ r ∈ gl2zRelators, FreeGroup.lift gl2zGenVal r = 1 := by
  intro r hr
  simp only [gl2zRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl | rfl | rfl | rfl
  · rw [map_pow, FreeGroup.lift_apply_of, gl2zGenVal_zero, ← map_pow, S_pow_four, map_one]
  · rw [map_mul, map_pow, map_mul, map_zpow, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of,
      gl2zGenVal_one, gl2zGenVal_zero, ← map_mul, ← map_pow, ← map_zpow, ← map_mul,
      T_mul_S_pow_three_mul_zpow, map_one]
  · rw [map_pow, FreeGroup.lift_apply_of, gl2zGenVal_two, eGL_sq]
  · simp only [map_mul, map_inv, FreeGroup.lift_apply_of, gl2zGenVal_zero, gl2zGenVal_two]
    rw [eGL_conj_S, ← map_mul, inv_mul_cancel, map_one]
  · simp only [map_mul, map_inv, FreeGroup.lift_apply_of, gl2zGenVal_one, gl2zGenVal_two]
    rw [eGL_conj_T, ← map_mul, inv_mul_cancel, map_one]

/-- The homomorphism `⟨S, T, e | S⁴, (TS)³S⁻², e², eSe⁻¹S, eTe⁻¹T⟩ →* GL(2, ℤ)` of
lean-categories#89 item 2. -/
def gl2zToGroup : PresentedGroup gl2zRelators →* GL (Fin 2) ℤ :=
  PresentedGroup.toGroup gl2zRelators_map_one

theorem gl2zToGroup_of (i : Fin 3) : gl2zToGroup (PresentedGroup.of i) = gl2zGenVal i :=
  PresentedGroup.toGroup.of gl2zRelators_map_one

/-- The adjoined presentation surjects onto `GL(2, ℤ)`. -/
theorem gl2zToGroup_surjective : Function.Surjective gl2zToGroup := by
  have hle : ({SpecialLinearGroup.toGL S, SpecialLinearGroup.toGL T, eGL} :
      Set (GL (Fin 2) ℤ)) ⊆ gl2zToGroup.range := by
    rintro x (rfl | rfl | rfl)
    · exact ⟨PresentedGroup.of 0, gl2zToGroup_of 0⟩
    · exact ⟨PresentedGroup.of 1, gl2zToGroup_of 1⟩
    · exact ⟨PresentedGroup.of 2, gl2zToGroup_of 2⟩
  have htop : (⊤ : Subgroup (GL (Fin 2) ℤ)) ≤ gl2zToGroup.range :=
    closure_gens_gl2z ▸ (Subgroup.closure_le (K := gl2zToGroup.range)).mpr hle
  intro g
  exact MonoidHom.mem_range.mp (htop (Subgroup.mem_top g))

/-- Lean-categories#89 item 2 in the form the theorem would take: the presentation obtained by
adjoining `e` to the `SL(2, ℤ)` presentation is *complete*. This is **not proved** here; it reduces
to `ModularGroup.Sl2zPresentationComplete` plus the identification of `PresentedGroup gl2zRelators`
with the semidirect product `PresentedGroup sl2zRelators ⋊ ⟨e⟩`, which is not formalized. -/
def Gl2zPresentationComplete : Prop := Function.Injective gl2zToGroup

/-!
### Item 2, the `SL(2, ℤ)` part of the adjoined presentation

The adjoined presentation restricts to the `SL(2, ℤ)` one: its first two generators satisfy the two
`sl2zRelators` (`gl2zS_pow_four`, `gl2zTS_relator`), so there is a map `sl2zInGl` from
`PresentedGroup sl2zRelators` to `PresentedGroup gl2zRelators` (`S ↦ S`, `T ↦ T`). The third
generator has image of order exactly two (`gl2zToGroup_of_two_sq`, `gl2zToGroup_of_two_ne_one`),
which is the `e` half of the reduction described in the module docstring.

What is not here: the composite `gl2zToGroup ∘ sl2zInGl = toGL ∘ sl2zToGroup`, the normal form
`∀ q, ∃ a, ∃ ε, i a * e ^ ε = q`, and hence the implication
`Sl2zPresentationComplete → Gl2zPresentationComplete`. The composite fails to elaborate through
`fin_cases`, which substitutes `⟨0, ⋯⟩` for `0 : Fin 2` and so stops the `of`-lemmas from firing;
it needs `Fin.cases`-free index handling (or statements indexed by `Fin.mk` terms) rather than more
`rw` chains.
-/

theorem gl2zS_pow_four : (PresentedGroup.of (rels := gl2zRelators) 0) ^ 4 = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_zpow, ← map_inv] using
    (PresentedGroup.one_of_mem (rels := gl2zRelators) (x := FreeGroup.of 0 ^ 4)
      (by simp [gl2zRelators]))

theorem gl2zTS_relator :
    ((PresentedGroup.of (rels := gl2zRelators) 1 * PresentedGroup.of (rels := gl2zRelators) 0) ^ 3 *
        ((PresentedGroup.of (rels := gl2zRelators) 0) ^ 2)⁻¹) = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_inv] using
    (PresentedGroup.one_of_mem (rels := gl2zRelators)
      (x := (FreeGroup.of 1 * FreeGroup.of 0) ^ 3 * ((FreeGroup.of 0) ^ 2)⁻¹)
      (by simp [gl2zRelators]))

/-- The two generators of the `SL(2, ℤ)` presentation, read in the `GL(2, ℤ)` one. -/
def sl2zGenValInGl : Fin 2 → PresentedGroup gl2zRelators :=
  ![PresentedGroup.of 0, PresentedGroup.of 1]

lemma sl2zGenValInGl_zero : sl2zGenValInGl 0 = PresentedGroup.of 0 := rfl

lemma sl2zGenValInGl_one : sl2zGenValInGl 1 = PresentedGroup.of 1 := rfl

theorem sl2zRelators_map_one_gl :
    ∀ r ∈ sl2zRelators, FreeGroup.lift sl2zGenValInGl r = 1 := by
  intro r hr
  simp only [sl2zRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · simpa [sl2zGenValInGl_zero, FreeGroup.lift_apply_of, map_pow] using gl2zS_pow_four
  · simpa [sl2zGenValInGl_zero, sl2zGenValInGl_one, FreeGroup.lift_apply_of, map_pow, map_mul,
      map_zpow] using gl2zTS_relator

/-- The `SL(2, ℤ)` presentation inside the `GL(2, ℤ)` one: `S ↦ S`, `T ↦ T`. -/
def sl2zInGl : PresentedGroup sl2zRelators →* PresentedGroup gl2zRelators :=
  PresentedGroup.toGroup sl2zRelators_map_one_gl

theorem sl2zInGl_of (i : Fin 2) : sl2zInGl (PresentedGroup.of i) = sl2zGenValInGl i :=
  PresentedGroup.toGroup.of sl2zRelators_map_one_gl

/-- The `e`-direction of the `GL(2, ℤ)` presentation has order exactly two. -/
theorem gl2zToGroup_of_two_sq : gl2zToGroup ((PresentedGroup.of (rels := gl2zRelators) 2) ^ 2)
    = 1 := by
  rw [pow_two, map_mul, gl2zToGroup_of, gl2zGenVal_two, eGL_mul_self]

theorem gl2zToGroup_of_two_ne_one :
    gl2zToGroup (PresentedGroup.of (rels := gl2zRelators) 2) ≠ 1 := by
  rw [gl2zToGroup_of, gl2zGenVal_two]
  intro h
  have h1 : GeneralLinearGroup.det eGL = 1 := by rw [h, map_one]
  rw [det_eGL] at h1
  exact absurd h1 (by decide)
end LeanCategories.ForMathlib
