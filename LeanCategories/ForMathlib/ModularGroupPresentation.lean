@[expose] public section

open scoped MatrixGroups Pointwise

open Matrix Matrix.SpecialLinearGroup

namespace ModularGroup

/-- The generators of lean-categories#89's presentation of `SL(2, ℤ)` as a family
`Fin 2 → SL(2, ℤ)`: index `0` is `S`, index `1` is `T`. -/
def sl2zGenVal : Fin 2 → SL(2, ℤ) := ![S, T]

lemma sl2zGenVal_zero : sl2zGenVal 0 = S := rfl

lemma sl2zGenVal_one : sl2zGenVal 1 = T := rfl

/-- `S ^ 4 = 1` in `SL(2, ℤ)`: the first relation of the presentation. -/
theorem S_pow_four : S ^ 4 = 1 := by decide

/-- `(T * S) ^ 3 = S ^ 2` in `SL(2, ℤ)`: the second relation, with `S ^ 2 = -1`. This is the
relation `(TS)³ = S²` of lean-categories#89 in the only form in which it holds, `(T * S) ^ 3`
being `-1` rather than `1`. -/
theorem T_mul_S_pow_three_eq_S_sq : (T * S) ^ 3 = S ^ 2 := by decide

/-- `(T * S) ^ 3 * S ^ (-2) = 1`: the second relator, evaluated in `SL(2, ℤ)`. -/
theorem T_mul_S_pow_three_mul_zpow : (T * S) ^ 3 * S ^ (-2 : ℤ) = 1 := by
  rw [T_mul_S_pow_three_eq_S_sq, ← zpow_natCast, zpow_neg]
  exact mul_inv_cancel _

/-- The relators of lean-categories#89's presentation `⟨S, T | S⁴, (TS)³ = S²⟩` of `SL(2, ℤ)`, as
words in the free group on `Fin 2` (`0 ↦ S`, `1 ↦ T`): `S⁴` and `(TS)³S⁻²`. -/
def sl2zRelators : Set (FreeGroup (Fin 2)) :=
  {FreeGroup.of 0 ^ 4, (FreeGroup.of 1 * FreeGroup.of 0) ^ 3 * (FreeGroup.of 0) ^ (-2 : ℤ)}

/-- Each relator of `sl2zRelators` dies in `SL(2, ℤ)`, so the presentation maps to `SL(2, ℤ)`. -/
theorem sl2zRelators_map_one : ∀ r ∈ sl2zRelators, FreeGroup.lift sl2zGenVal r = 1 := by
  intro r hr
  simp only [sl2zRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · rw [map_pow, FreeGroup.lift_apply_of, sl2zGenVal_zero, S_pow_four]
  · rw [map_mul, map_pow, map_mul, map_zpow, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of,
      sl2zGenVal_one, sl2zGenVal_zero, T_mul_S_pow_three_mul_zpow]

/-- The homomorphism `⟨S, T | S⁴, (TS)³ = S²⟩ →* SL(2, ℤ)` taking the generators to `S` and `T`. -/
def sl2zToGroup : PresentedGroup sl2zRelators →* SL(2, ℤ) :=
  PresentedGroup.toGroup sl2zRelators_map_one

theorem sl2zToGroup_of (i : Fin 2) : sl2zToGroup (PresentedGroup.of i) = sl2zGenVal i :=
  PresentedGroup.toGroup.of sl2zRelators_map_one

lemma range_sl2zGenVal : Set.range sl2zGenVal = {S, T} := by
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    fin_cases i
    · exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _ rfl
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

/-- `SL(2, ℤ)` is generated by the two elements `S`, `T` of lean-categories#89's presentation. -/
def sl2zGenerators : Group.Generators (SL(2, ℤ)) (Fin 2) where
  val := sl2zGenVal
  closure_eq_top := by
    rw [range_sl2zGenVal]
    exact SpecialLinearGroup.SL2Z_generators

/-- The presentation `⟨S, T | S⁴, (TS)³ = S²⟩` surjects onto `SL(2, ℤ)`. -/
theorem sl2zToGroup_surjective : Function.Surjective sl2zToGroup := by
  have hle : ({S, T} : Set (SL(2, ℤ))) ⊆ sl2zToGroup.range := by
    intro x hx
    rcases hx with rfl | rfl
    · exact ⟨PresentedGroup.of 0, sl2zToGroup_of 0⟩
    · exact ⟨PresentedGroup.of 1, sl2zToGroup_of 1⟩
  have htop : (⊤ : Subgroup (SL(2, ℤ))) ≤ sl2zToGroup.range :=
    SpecialLinearGroup.SL2Z_generators ▸
      (Subgroup.closure_le (K := sl2zToGroup.range)).mpr hle
  intro g
  exact MonoidHom.mem_range.mp (htop (Subgroup.mem_top g))

/-!
### Component 1 of the completeness proof: the Euclid descent on the first column

The completeness of item 1 splits into two statements, and this section is the first of them: the
*descent*. Writing `colHeight A` for the height `max |A 0 0| |A 1 0|` of the first column of an
integer `2 × 2` matrix, `colHeight_step` says that every `A : SL(2, ℤ)` with `2 ≤ colHeight A` is
`S ^ ε * T ^ q` times a matrix whose first column is strictly shorter, with `ε : Fin 2` and `q : ℤ`;
`exists_word_mul_colHeight_le_one` iterates it, so that every element of `SL(2, ℤ)` is a word in
`S`, `T` (as a `FreeGroup (Fin 2)` element, evaluated by `sl2zGenVal`) times a matrix of
first-column height at most one.

Both degenerate cases the descent has to dodge are dodged by the determinant: `c = 0` forces
`|a| = 1` and `a = 0` forces `|c| = 1`, so under `2 ≤ colHeight` both entries of the first column
are nonzero and the Euclidean division `a % c` resp. `c % a` is available. `|a| = |c|` likewise
forces `|c| = 1` (`abs_eq_one_of_abs_eq`), which is what makes the case split exhaustive rather than
three-way.

This is the whole of what an elementary descent can give, and it is not the completeness of the
presentation. The residual stratum `colHeight A ≤ 1` is where the theorem actually lives: the
descent's induction is on the height of the *product* of a word, so its base case quantifies over
*all* words whose product has first-column height at most one — and that base case already contains
`ker sl2zToGroup` (take the product `1`). No iteration of `colHeight_step` therefore reduces
`Sl2zPresentationComplete` to a finite check; what it does is exhibit the word that conjugates any
given matrix into the stratum where the amalgam normal form has to be consulted. See the section
"Item 1: the two cyclic factors" below for what that consultation costs, and note that the descent
is needed even for the *statement*: `colHeight` is what makes "the cusp stratum" a set of matrices
rather than a slogan.
-/

/-- The height of the first column of an integer `2 × 2` matrix: the largest of the absolute values
of its two entries. For `A : SL(2, ℤ)`, `colHeight A.1` is the height the Euclid descent of
lean-categories#89 measures, and `colHeight A.1 = 1` is its residual stratum. -/
def colHeight (A : Matrix (Fin 2) (Fin 2) ℤ) : ℤ := max |A 0 0| |A 1 0|

@[simp]
lemma colHeight_apply (A : Matrix (Fin 2) (Fin 2) ℤ) : colHeight A = max |A 0 0| |A 1 0| := rfl

lemma colHeight_nonneg (A : Matrix (Fin 2) (Fin 2) ℤ) : 0 ≤ colHeight A :=
  le_trans (abs_nonneg _) (le_max_left _ _)

/-- The entries of an `SL(2, ℤ)` matrix satisfy `a * d - b * c = 1`. -/
lemma det_entries (A : SL(2, ℤ)) : A.1 0 0 * A.1 1 1 - A.1 0 1 * A.1 1 0 = 1 := by
  have h := A.2
  rwa [Matrix.det_fin_two] at h

/-- The first column of an `SL(2, ℤ)` matrix is nonzero: its height is positive. -/
lemma colHeight_pos (A : SL(2, ℤ)) : 0 < colHeight A.1 := by
  rcases lt_or_ge 0 (colHeight A.1) with h | h
  · exact h
  have h0 : colHeight A.1 = 0 := le_antisymm h (colHeight_nonneg _)
  have hz : A.1 0 0 = 0 := by
    have hle : |A.1 0 0| ≤ 0 := by rw [← h0]; exact le_max_left _ _
    exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
  have hz2 : A.1 1 0 = 0 := by
    have hle : |A.1 1 0| ≤ 0 := by rw [← h0]; exact le_max_right _ _
    exact abs_eq_zero.mp (le_antisymm hle (abs_nonneg _))
  have hdet := det_entries A
  rw [hz, hz2, mul_zero, sub_zero] at hdet
  exact absurd hdet (by norm_num)

/-- The first column of `T ^ q * A`, top entry. -/
lemma T_zpow_mul_zero_zero (A : SL(2, ℤ)) (q : ℤ) :
    (T ^ q * A).1 0 0 = A.1 0 0 + q * A.1 1 0 := by
  rw [show (T ^ q * A).1 = (T ^ q).1 * A.1 from rfl, coe_T_zpow, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

/-- The first column of `T ^ q * A`, bottom entry: a power of `T` leaves it alone. -/
lemma T_zpow_mul_one_zero (A : SL(2, ℤ)) (q : ℤ) : (T ^ q * A).1 1 0 = A.1 1 0 := by
  rw [show (T ^ q * A).1 = (T ^ q).1 * A.1 from rfl, coe_T_zpow, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

lemma coe_S_inv_matrix : (S⁻¹ : SL(2, ℤ)).1 = !![0, 1; -1, 0] := by
  rw [S_inv]
  ext i j
  fin_cases i <;> fin_cases j <;> decide

lemma S_inv_mul_zero_zero (A : SL(2, ℤ)) : (S⁻¹ * A).1 0 0 = A.1 1 0 := by
  rw [show (S⁻¹ * A).1 = (S⁻¹).1 * A.1 from rfl, coe_S_inv_matrix, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

lemma S_inv_mul_one_zero (A : SL(2, ℤ)) : (S⁻¹ * A).1 1 0 = -A.1 0 0 := by
  rw [show (S⁻¹ * A).1 = (S⁻¹).1 * A.1 from rfl, coe_S_inv_matrix, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

lemma colHeight_T_zpow_mul (A : SL(2, ℤ)) (q : ℤ) :
    colHeight (T ^ q * A).1 = max |A.1 0 0 + q * A.1 1 0| |A.1 1 0| := by
  rw [colHeight_apply, T_zpow_mul_zero_zero, T_zpow_mul_one_zero]

/-- In `SL(2, ℤ)` with first-column height at least two, both entries of the first column are
nonzero: the two degenerate cases of the descent are excluded by the determinant. -/
lemma ne_zero_of_colHeight (A : SL(2, ℤ)) (hA : 2 ≤ colHeight A.1) :
    A.1 0 0 ≠ 0 ∧ A.1 1 0 ≠ 0 := by
  have hdet := det_entries A
  have hc : A.1 1 0 ≠ 0 := by
    intro h0
    rw [h0, mul_zero, sub_zero] at hdet
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hdet with h | h
    · rw [colHeight_apply] at hA
      rw [h, h0] at hA
      norm_num at hA
    · rw [colHeight_apply] at hA
      rw [h, h0] at hA
      norm_num at hA
  refine ⟨?_, hc⟩
  intro h0
  rw [h0, zero_mul, zero_sub] at hdet
  have hb : A.1 1 0 * (-A.1 0 1) = 1 := by nlinarith [hdet]
  rcases Int.eq_one_or_neg_one_of_mul_eq_one hb with h | h
  · rw [colHeight_apply] at hA
    rw [h0, h] at hA
    norm_num at hA
  · rw [colHeight_apply] at hA
    rw [h0, h] at hA
    norm_num at hA

/-- `|a| = |c|` forces `|c| = 1` for an `SL(2, ℤ)` matrix: the determinant is one. This is the
third case the descent has to exclude, `a = c` and `a = -c` both giving `c * (±1) = 1`. -/
lemma abs_eq_one_of_abs_eq (A : SL(2, ℤ)) (h : |A.1 0 0| = |A.1 1 0|) : |A.1 1 0| = 1 := by
  have hdet := det_entries A
  rcases abs_eq_abs.mp h with h' | h'
  · rw [h'] at hdet
    have hc : A.1 1 0 * (A.1 1 1 - A.1 0 1) = 1 := by
      ring_nf at hdet ⊢
      linarith
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hc with h1 | h1 <;> rw [h1] <;> norm_num
  · rw [h'] at hdet
    have hc : (-A.1 1 0) * (A.1 1 1 + A.1 0 1) = 1 := by
      ring_nf at hdet ⊢
      linarith
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hc with h1 | h1
    · rw [show A.1 1 0 = -1 by linarith]
      norm_num
    · rw [show A.1 1 0 = 1 by linarith]
      norm_num

/-- **Component 1 of lean-categories#89 item 1.** If the first column of `A : SL(2, ℤ)` has height
at least two, then for some `ε : Fin 2`, `q : ℤ` and `A' : SL(2, ℤ)`,

  `A = S ^ ε * T ^ q * A'`  and  `colHeight A' < colHeight A`,

so the Euclidean algorithm on the pair `(|A 0 0|, |A 1 0|)` is a strictly decreasing rewriting
process on `SL(2, ℤ)` that lands in the stratum `colHeight = 1`. The two multipliers are the two
branches of one Euclidean step: `T ^ q` alone when `|c| < |a|` (with `q = a / c`), and `S` followed
by `T ^ q` when `|a| < |c|` (with `q = c / a`). -/
theorem colHeight_step (A : SL(2, ℤ)) (hA : 2 ≤ colHeight A.1) :
    ∃ (ε : Fin 2) (q : ℤ) (A' : SL(2, ℤ)),
      A = S ^ (ε : ℕ) * T ^ q * A' ∧ colHeight A'.1 < colHeight A.1 := by
  obtain ⟨ha, hc⟩ := ne_zero_of_colHeight A hA
  have hne : |A.1 1 0| ≠ |A.1 0 0| := by
    intro heq
    have h1 : |A.1 1 0| = 1 := abs_eq_one_of_abs_eq A heq.symm
    have ha1 : |A.1 0 0| = 1 := heq.symm.trans h1
    have h2 : colHeight A.1 = 1 := by
      rw [colHeight_apply, ha1, h1, max_self]
    rw [h2] at hA
    norm_num at hA
  rcases lt_or_gt_of_ne hne with hlt | hlt
  · -- `|c| < |a|`: multiply by `T ^ (a / c)` on the left
    have hcolA : colHeight A.1 = |A.1 0 0| := by
      rw [colHeight_apply, max_eq_left (le_of_lt hlt)]
    have key : A.1 0 0 + (-(A.1 0 0 / A.1 1 0)) * A.1 1 0 = A.1 0 0 % A.1 1 0 := by
      have h := Int.emod_add_mul_ediv (A.1 0 0) (A.1 1 0)
      nlinarith [h]
    refine ⟨0, A.1 0 0 / A.1 1 0, T ^ (-(A.1 0 0 / A.1 1 0)) * A, ?_, ?_⟩
    · rw [show ((0 : Fin 2) : ℕ) = 0 from rfl, pow_zero, one_mul, ← mul_assoc, ← zpow_add,
        add_neg_cancel, zpow_zero, one_mul]
    · rw [colHeight_T_zpow_mul, key, max_eq_right (le_of_lt ?_)]
      · rw [hcolA]
        exact hlt
      · have h1 := Int.emod_lt_abs (A.1 0 0) hc
        have h2 := Int.emod_nonneg (A.1 0 0) hc
        rwa [abs_of_nonneg h2]
  · -- `|a| < |c|`: multiply by `T ^ (c / a)` and `S⁻¹` on the left
    have hcolA : colHeight A.1 = |A.1 1 0| := by
      rw [colHeight_apply, max_eq_right (le_of_lt hlt)]
    have key : A.1 1 0 + (A.1 1 0 / A.1 0 0) * (-A.1 0 0) = A.1 1 0 % A.1 0 0 := by
      have h := Int.emod_add_mul_ediv (A.1 1 0) (A.1 0 0)
      have hc' : A.1 1 0 = A.1 1 0 % A.1 0 0 + (A.1 1 0 / A.1 0 0) * A.1 0 0 := by
        conv_lhs => rw [← h]
        ring
      nth_rewrite 1 [hc']
      ring
    refine ⟨1, -(A.1 1 0 / A.1 0 0), T ^ (A.1 1 0 / A.1 0 0) * (S⁻¹ * A), ?_, ?_⟩
    · rw [show ((1 : Fin 2) : ℕ) = 1 from rfl, pow_one]
      group
    · rw [colHeight_T_zpow_mul, S_inv_mul_zero_zero, S_inv_mul_one_zero, key,
        max_eq_right (le_of_lt ?_)]
      · rw [hcolA, abs_neg]
        exact hlt
      · have h1 := Int.emod_lt_abs (A.1 1 0) ha
        have h2 := Int.emod_nonneg (A.1 1 0) ha
        rw [abs_of_nonneg h2, abs_neg]
        exact h1

/-- **Component 1, iterated.** Every `A : SL(2, ℤ)` is a word in the two generators — an element
`u` of the free group on `Fin 2`, evaluated through `sl2zGenVal` — times a matrix whose first column
has height at most one. The proof is the strong induction on `colHeight` that `colHeight_step`
drives; it terminates because the height drops by at least one at each step and is positive on
`SL(2, ℤ)`. -/
theorem exists_word_mul_colHeight_le_one :
    ∀ (n : ℕ) (A : SL(2, ℤ)), (colHeight A.1).toNat ≤ n →
      ∃ (u : FreeGroup (Fin 2)) (A₀ : SL(2, ℤ)),
        colHeight A₀.1 ≤ 1 ∧ A = FreeGroup.lift sl2zGenVal u * A₀ := by
  intro n
  induction n with
  | zero =>
    intro A hA
    have hpos := colHeight_pos A
    have hle : (colHeight A.1).toNat = 0 := Nat.le_zero.mp hA
    rw [Int.toNat_eq_zero] at hle
    omega
  | succ n ih =>
    intro A hA
    by_cases h : colHeight A.1 ≤ 1
    · exact ⟨1, A, h, by rw [map_one, one_mul]⟩
    · have h2 : 2 ≤ colHeight A.1 := by omega
      obtain ⟨ε, q, A', hEq, hlt⟩ := colHeight_step A h2
      have hA' : (colHeight A'.1).toNat ≤ n := by
        have hlt' : (colHeight A'.1).toNat < (colHeight A.1).toNat := by
          rw [Int.toNat_lt_toNat (colHeight_pos A)]
          exact hlt
        omega
      obtain ⟨u, A₀, hA₀, hEq₀⟩ := ih A' hA'
      exact ⟨FreeGroup.of (0 : Fin 2) ^ (ε : ℕ) * FreeGroup.of (1 : Fin 2) ^ q * u, A₀, hA₀, by
        rw [hEq, hEq₀, map_mul, map_mul, map_pow, map_zpow, FreeGroup.lift_apply_of,
          FreeGroup.lift_apply_of, sl2zGenVal_zero, sl2zGenVal_one]
        group⟩

/-- **Component 1, iterated, in the direction the presentation uses.** For every `A : SL(2, ℤ)`
there is a word `u` in the free group on the two generators whose product with `A` has first-column
height at most one. This is the form in which the descent meets the cusp stratum: the cusp stratum
has to say what the words with `colHeight ≤ 1` product are, and nothing here does. -/
theorem exists_lift_mul_colHeight_le_one (A : SL(2, ℤ)) :
    ∃ u : FreeGroup (Fin 2), colHeight (FreeGroup.lift sl2zGenVal u * A).1 ≤ 1 := by
  obtain ⟨u, A₀, hA₀, hEq⟩ := exists_word_mul_colHeight_le_one _ A le_rfl
  refine ⟨u⁻¹, ?_⟩
  rw [map_inv, hEq, ← mul_assoc, inv_mul_cancel, one_mul]
  exact hA₀

/-!
### Component 2, its arithmetic half: the cusp stratum is eight cosets of `⟨T⟩`

The descent above lands in `colHeight ≤ 1`; this section says what that stratum is. Right
multiplication by `T ^ b` fixes the first column (`colHeight_mul_T_zpow`), so the stratum is a union
of `⟨T⟩`-cosets, and the first column `(a, c)` has `|a|, |c| ≤ 1` with `det = 1`: that leaves the
eight pairs `(±1, 0)`, `(0, ±1)`, `(±1, ±1)`, each one coset. `cuspLift : Fin 8 → SL(2, ℤ)` lists
the eight representatives (`1`, `-1`, `S`, `-S`, `S T⁻¹ S⁻¹` and the sign-and-inverse variants), and
`colHeight_le_one_iff` is the exact statement

  `colHeight A ≤ 1 ↔ ∃ i b, A = cuspLift i * T ^ b`,

and `colHeight_le_one_iff_existsUnique` sharpens it to a unique pair, i.e. `Fin 8 × ℤ` bijects onto
the stratum (`cuspLift_pair_injective`).

This is the vertex-stabilizer arithmetic of the tree action: the eight are the eight `⟨T⟩`-cosets
the stratum meets. It is all of component 2 that is arithmetic, and what it does *not* give is the
word-level statement — that no word of `PresentedGroup sl2zRelators` is normal-closure equivalent to
two different `cuspLift i`, equivalently that the stratum's words form a transversal. That is the
Bass–Serre/Farey statement recorded in the module docstring, and it is why
`Sl2zPresentationComplete` stays open below.
-/

/-- The eight lifts of the cusp stratum `colHeight ≤ 1`: one representative of each of the eight
cosets of `⟨T⟩` that the stratum meets: the first column can only be one of the eight pairs
`(±1, 0)`, `(0, ±1)`, `(±1, ±1)`, and each is a single coset. -/
def cuspLift : Fin 8 → SL(2, ℤ) :=
  ![1, -1, S, -S, S * T⁻¹ * S⁻¹, -(S * T⁻¹ * S⁻¹), S * T * S⁻¹, -(S * T * S⁻¹)]

lemma cuspLift_zero : (cuspLift 0).1 = !![1, 0; 0, 1] := by decide

lemma cuspLift_one : (cuspLift 1).1 = !![-1, 0; 0, -1] := by decide

lemma cuspLift_two : (cuspLift 2).1 = !![0, -1; 1, 0] := by decide

lemma cuspLift_three : (cuspLift 3).1 = !![0, 1; -1, 0] := by decide

lemma cuspLift_four : (cuspLift 4).1 = !![1, 0; 1, 1] := by decide

lemma cuspLift_five : (cuspLift 5).1 = !![-1, 0; -1, -1] := by decide

lemma cuspLift_six : (cuspLift 6).1 = !![1, 0; -1, 1] := by decide

lemma cuspLift_seven : (cuspLift 7).1 = !![-1, 0; 1, -1] := by decide

/-- The first column of an `SL(2, ℤ)` matrix, as a pair of integers. -/
def firstColumn (X : SL(2, ℤ)) : ℤ × ℤ := (X.1 0 0, X.1 1 0)

lemma mul_T_zpow_zero_zero (X : SL(2, ℤ)) (b : ℤ) : (X * T ^ b).1 0 0 = X.1 0 0 := by
  rw [show (X * T ^ b).1 = X.1 * (T ^ b).1 from rfl, coe_T_zpow, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

lemma mul_T_zpow_one_zero (X : SL(2, ℤ)) (b : ℤ) : (X * T ^ b).1 1 0 = X.1 1 0 := by
  rw [show (X * T ^ b).1 = X.1 * (T ^ b).1 from rfl, coe_T_zpow, Matrix.mul_apply,
    Fin.sum_univ_two]
  simp

lemma firstColumn_mul_T_zpow (X : SL(2, ℤ)) (b : ℤ) :
    firstColumn (X * T ^ b) = firstColumn X := by
  rw [firstColumn, firstColumn, mul_T_zpow_zero_zero, mul_T_zpow_one_zero]

/-- Right multiplication by a power of `T` fixes the first column, so it fixes `colHeight`. -/
lemma colHeight_mul_T_zpow (X : SL(2, ℤ)) (b : ℤ) :
    colHeight (X * T ^ b).1 = colHeight X.1 := by
  rw [colHeight_apply, colHeight_apply, mul_T_zpow_zero_zero, mul_T_zpow_one_zero]

lemma colHeight_cuspLift (i : Fin 8) : colHeight (cuspLift i).1 = 1 := by
  fin_cases i <;> decide

/-- **The cusp stratum is eight cosets of `⟨T⟩`.** `A : SL(2, ℤ)` has first-column height at most
one exactly when it is one of the eight matrices `cuspLift i` times a power of `T`; the eight are
the eight possible first columns `(±1, 0)`, `(0, ±1)`, `(±1, ±1)` with `det = 1`. This is the
arithmetic
content of the vertex-stabilizer statement of lean-categories#89 item 1's component 2: it reduces
"the stratum `colHeight ≤ 1`" to a finite list of cosets; what it does not prove is the word-level
statement that no word in the presentation is normal-closure equivalent to two of them. -/
theorem colHeight_le_one_iff (A : SL(2, ℤ)) :
    colHeight A.1 ≤ 1 ↔ ∃ (i : Fin 8) (b : ℤ), A = cuspLift i * T ^ b := by
  constructor
  · intro hA
    have hdet := det_entries A
    rw [colHeight_apply] at hA
    have h1 : |A.1 0 0| ≤ 1 := le_trans (le_max_left _ _) hA
    have h2 : |A.1 1 0| ≤ 1 := le_trans (le_max_right _ _) hA
    have h1' := abs_le.mp h1
    have h2' := abs_le.mp h2
    have ha : A.1 0 0 = -1 ∨ A.1 0 0 = 0 ∨ A.1 0 0 = 1 := by omega
    have hc : A.1 1 0 = -1 ∨ A.1 1 0 = 0 ∨ A.1 1 0 = 1 := by omega
    rcases ha with ha | ha | ha <;> rcases hc with hc | hc | hc
    · -- (a, c) = (-1, -1)
      refine ⟨5, -(A.1 0 1), ?_⟩
      have hd : A.1 1 1 = A.1 0 1 - 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_five, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
      omega
    · -- (a, c) = (-1, 0)
      refine ⟨1, -(A.1 0 1), ?_⟩
      have hd : A.1 1 1 = -1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_one, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
    · -- (a, c) = (-1, 1)
      refine ⟨7, -(A.1 0 1), ?_⟩
      have hd : A.1 1 1 = -1 - A.1 0 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_seven, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
      omega
    · -- (a, c) = (0, -1)
      refine ⟨3, -(A.1 1 1), ?_⟩
      have hb : A.1 0 1 = 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_three, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hb]
    · -- (a, c) = (0, 0) is impossible: the determinant is one
      rw [ha, hc] at hdet
      norm_num at hdet
    · -- (a, c) = (0, 1)
      refine ⟨2, A.1 1 1, ?_⟩
      have hb : A.1 0 1 = -1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_two, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hb]
    · -- (a, c) = (1, -1)
      refine ⟨6, A.1 0 1, ?_⟩
      have hd : A.1 1 1 = 1 - A.1 0 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_six, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
      omega
    · -- (a, c) = (1, 0)
      refine ⟨0, A.1 0 1, ?_⟩
      have hd : A.1 1 1 = 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_zero, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
    · -- (a, c) = (1, 1)
      refine ⟨4, A.1 0 1, ?_⟩
      have hd : A.1 1 1 = A.1 0 1 + 1 := by rw [ha, hc] at hdet; linarith
      refine Subtype.ext ?_
      rw [coe_mul, cuspLift_four, coe_T_zpow, Matrix.mul_fin_two]
      ext i j
      fin_cases i <;> fin_cases j <;> simp [ha, hc, hd]
  · rintro ⟨i, b, rfl⟩
    rw [colHeight_mul_T_zpow, colHeight_cuspLift]

/-- Lean-categories#89 item 1 in the form the theorem takes: the presentation
`⟨S, T | S⁴, (TS)³ = S²⟩` is *complete*, i.e. the relators generate the whole kernel of the free
group's map onto `SL(2, ℤ)`. Proved as `sl2zPresentationComplete` at the end of the section
`ModularGroup`; it is what a coset enumeration on the presentation consumes. -/
def Sl2zPresentationComplete : Prop := Function.Injective sl2zToGroup

/-!
### Item 1, second half: the presentation is the amalgam

The relators `S⁴` and `(TS)³S⁻²` are a change of generators away from the form in which the
presentation is visibly the amalgam `ℤ/4 *_{ℤ/2} ℤ/6`: with `R = TS` they read `S⁴` and `R³S⁻²`,
i.e. `S` has order dividing `4`, `R` order dividing `6`, and the two `ℤ/2`'s `⟨S²⟩ = ⟨R³⟩` are
identified. `sl2zAmalgamRelators` is that relator set on the same two generator slots, and
`sl2zAmalgamEquiv` is the change of generators, `T ↦ R S⁻¹` and `R ↦ T S`, proved inverse on both
sides by the presentations' universal property.

What is *not* here: the identification of `PresentedGroup sl2zAmalgamRelators` with Mathlib's
categorical pushout `Monoid.PushoutI` of `ℤ/4 ← ℤ/2 → ℤ/6`
(`Mathlib/GroupTheory/PushoutI.lean`), or with the coproduct modulo the base subgroup. `PushoutI`'s
universal property (`PushoutI.homEquiv`) needs a homomorphism *out of* each cyclic factor, and
Mathlib at this pin has no such homomorphism into a nonabelian group: the only general tool is the
*additive* `ZMod.lift` of `Mathlib/Data/ZMod/Basic.lean:1151`, whose target is required to be an
`AddGroup`, i.e. commutative (`Lean`'s additive groups are the commutative ones), while a map out of
`Multiplicative (ZMod 4)` into a presentation is not additive. The route that avoids it — Mathlib's
`zmodMulEquivOfGenerator` (`Mathlib/GroupTheory/SpecificGroups/Cyclic.lean:573`), which *is* an
isomorphism `Multiplicative (ZMod n) ≃* G` for a cyclic `G` with a chosen generator — applies after
`orderOf` facts about the generators of the `SL(2, ℤ)` presentation that are not proved here
(`orderOf S = 4` and `orderOf (TS) = 6` need the completeness of item 1 to move from `SL(2, ℤ)`
back, or an independent argument).
-/

/-- The same group in the generators `S` and `R = TS`: `S⁴` and `R³S⁻²`. -/
def sl2zAmalgamRelators : Set (FreeGroup (Fin 2)) :=
  {FreeGroup.of 0 ^ 4, FreeGroup.of 1 ^ 3 * (FreeGroup.of 0) ^ (-2 : ℤ)}

theorem sl2zS_pow_four : (PresentedGroup.of (rels := sl2zRelators) 0) ^ 4 = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_zpow] using
    (PresentedGroup.one_of_mem (rels := sl2zRelators) (x := FreeGroup.of 0 ^ 4)
      (by simp [sl2zRelators]))

theorem sl2zTS_relator :
    ((PresentedGroup.of (rels := sl2zRelators) 1 * PresentedGroup.of (rels := sl2zRelators) 0) ^ 3 *
        ((PresentedGroup.of (rels := sl2zRelators) 0) ^ 2)⁻¹) = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_inv] using
    (PresentedGroup.one_of_mem (rels := sl2zRelators)
      (x := (FreeGroup.of 1 * FreeGroup.of 0) ^ 3 * ((FreeGroup.of 0) ^ 2)⁻¹)
      (by simp [sl2zRelators]))

theorem amalgamS_pow_four : (PresentedGroup.of (rels := sl2zAmalgamRelators) 0) ^ 4 = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_zpow] using
    (PresentedGroup.one_of_mem (rels := sl2zAmalgamRelators) (x := FreeGroup.of 0 ^ 4)
      (by simp [sl2zAmalgamRelators]))

theorem amalgamR_relator :
    (PresentedGroup.of (rels := sl2zAmalgamRelators) 1) ^ 3 *
        ((PresentedGroup.of (rels := sl2zAmalgamRelators) 0) ^ 2)⁻¹ = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_inv] using
    (PresentedGroup.one_of_mem (rels := sl2zAmalgamRelators)
      (x := FreeGroup.of 1 ^ 3 * ((FreeGroup.of 0) ^ 2)⁻¹)
      (by simp [sl2zAmalgamRelators]))

theorem amalgamR_cube :
    (PresentedGroup.of (rels := sl2zAmalgamRelators) 1) ^ 3 =
      (PresentedGroup.of (rels := sl2zAmalgamRelators) 0) ^ 2 :=
  eq_of_mul_inv_eq_one amalgamR_relator

/-- `T ↦ R S⁻¹` in the amalgam-generator presentation. -/
def sl2zGenValAmalgam : Fin 2 → PresentedGroup sl2zAmalgamRelators :=
  ![PresentedGroup.of 0, PresentedGroup.of 1 * (PresentedGroup.of 0)⁻¹]

lemma sl2zGenValAmalgam_zero : sl2zGenValAmalgam 0 = PresentedGroup.of 0 := rfl

lemma sl2zGenValAmalgam_one :
    sl2zGenValAmalgam 1 = PresentedGroup.of 1 * (PresentedGroup.of 0)⁻¹ := rfl

theorem sl2zRelators_map_one_amalgam :
    ∀ r ∈ sl2zRelators, FreeGroup.lift sl2zGenValAmalgam r = 1 := by
  intro r hr
  simp only [sl2zRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · simpa [sl2zGenValAmalgam_zero, FreeGroup.lift_apply_of, map_pow] using amalgamS_pow_four
  · have key : (PresentedGroup.of (rels := sl2zAmalgamRelators) 1 *
          (PresentedGroup.of (rels := sl2zAmalgamRelators) 0)⁻¹) *
          PresentedGroup.of (rels := sl2zAmalgamRelators) 0 =
        PresentedGroup.of (rels := sl2zAmalgamRelators) 1 := by group
    simpa [sl2zGenValAmalgam_zero, sl2zGenValAmalgam_one, FreeGroup.lift_apply_of, map_pow,
      map_mul, map_zpow, key] using amalgamR_relator

/-- `⟨S, T | S⁴, (TS)³S⁻²⟩ →* ⟨S, R | S⁴, R³S⁻²⟩`, `T ↦ R S⁻¹`. -/
def sl2zToAmalgam : PresentedGroup sl2zRelators →* PresentedGroup sl2zAmalgamRelators :=
  PresentedGroup.toGroup sl2zRelators_map_one_amalgam

theorem sl2zToAmalgam_of (i : Fin 2) :
    sl2zToAmalgam (PresentedGroup.of i) = sl2zGenValAmalgam i :=
  PresentedGroup.toGroup.of sl2zRelators_map_one_amalgam

/-- `R ↦ T S` in the original presentation. -/
def sl2zGenValOrig : Fin 2 → PresentedGroup sl2zRelators :=
  ![PresentedGroup.of 0, PresentedGroup.of 1 * PresentedGroup.of 0]

lemma sl2zGenValOrig_zero : sl2zGenValOrig 0 = PresentedGroup.of 0 := rfl

lemma sl2zGenValOrig_one :
    sl2zGenValOrig 1 = PresentedGroup.of 1 * PresentedGroup.of 0 := rfl

theorem sl2zAmalgamRelators_map_one :
    ∀ r ∈ sl2zAmalgamRelators, FreeGroup.lift sl2zGenValOrig r = 1 := by
  intro r hr
  simp only [sl2zAmalgamRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · simpa [sl2zGenValOrig_zero, FreeGroup.lift_apply_of, map_pow] using sl2zS_pow_four
  · simpa [sl2zGenValOrig_zero, sl2zGenValOrig_one, FreeGroup.lift_apply_of, map_pow, map_mul,
      map_zpow] using sl2zTS_relator

/-- `⟨S, R | S⁴, R³S⁻²⟩ →* ⟨S, T | S⁴, (TS)³S⁻²⟩`, `R ↦ T S`. -/
def sl2zOfAmalgam : PresentedGroup sl2zAmalgamRelators →* PresentedGroup sl2zRelators :=
  PresentedGroup.toGroup sl2zAmalgamRelators_map_one

theorem sl2zOfAmalgam_of (i : Fin 2) :
    sl2zOfAmalgam (PresentedGroup.of i) = sl2zGenValOrig i :=
  PresentedGroup.toGroup.of sl2zAmalgamRelators_map_one

theorem sl2zToAmalgam_comp_ofAmalgam :
    sl2zToAmalgam.comp sl2zOfAmalgam = MonoidHom.id _ := by
  refine PresentedGroup.ext fun i => ?_
  fin_cases i
  · change sl2zToAmalgam (sl2zOfAmalgam (PresentedGroup.of 0)) = PresentedGroup.of 0
    rw [sl2zOfAmalgam_of, sl2zGenValOrig_zero, sl2zToAmalgam_of, sl2zGenValAmalgam_zero]
  · change sl2zToAmalgam (sl2zOfAmalgam (PresentedGroup.of 1)) = PresentedGroup.of 1
    rw [sl2zOfAmalgam_of, sl2zGenValOrig_one, map_mul, sl2zToAmalgam_of, sl2zToAmalgam_of,
      sl2zGenValAmalgam_one, sl2zGenValAmalgam_zero]
    group

theorem sl2zOfAmalgam_comp_toAmalgam :
    sl2zOfAmalgam.comp sl2zToAmalgam = MonoidHom.id _ := by
  refine PresentedGroup.ext fun i => ?_
  fin_cases i
  · change sl2zOfAmalgam (sl2zToAmalgam (PresentedGroup.of 0)) = PresentedGroup.of 0
    rw [sl2zToAmalgam_of, sl2zGenValAmalgam_zero, sl2zOfAmalgam_of, sl2zGenValOrig_zero]
  · change sl2zOfAmalgam (sl2zToAmalgam (PresentedGroup.of 1)) = PresentedGroup.of 1
    rw [sl2zToAmalgam_of, sl2zGenValAmalgam_one, map_mul, map_inv, sl2zOfAmalgam_of,
      sl2zOfAmalgam_of, sl2zGenValOrig_one, sl2zGenValOrig_zero]
    group

/-- lean-categories#89 item 1 in the generators `S` and `R = TS`. -/
def sl2zAmalgamEquiv : PresentedGroup sl2zRelators ≃* PresentedGroup sl2zAmalgamRelators where
  toFun := sl2zToAmalgam
  invFun := sl2zOfAmalgam
  left_inv a := by
    have := congrArg (fun f => f a) sl2zOfAmalgam_comp_toAmalgam
    simpa using this
  right_inv b := by
    have := congrArg (fun f => f b) sl2zToAmalgam_comp_ofAmalgam
    simpa using this
  map_mul' := sl2zToAmalgam.map_mul

/-!
### Item 1: the presentation *is* the amalgam `ℤ/4 *_{ℤ/2} ℤ/6`

The eight cocycle-free definitions below make the identification with Mathlib's categorical pushout
`Monoid.PushoutI` (lean-categories#89's open sketch, now closed):

* `cyclicRelators n` / `Cyclic n` / `cyclicGen n` — the one-relator presentation
  `⟨x | x ^ n⟩` of the cyclic group of order `n`. Taking the diagram's factors as
  *presented* cyclic groups is what makes a homomorphism *out of* them available:
  `PresentedGroup.toGroup` needs no `ZMod` recursion, so the missing constructor the
  earlier sketch named (`ZMod.lift` is additive, hence abelian-target) is not needed.
* `cyclicTwoToFour`, `cyclicTwoToSix` — the diagram `ℤ/2 ⇉ ℤ/4, ℤ/6` (generator to the square, resp.
  the cube), over `amalgamGroup` indexed by `Bool` and `AmalgamPushout := PushoutI amalgamMap`.
* `amalgamPushoutEquiv : PresentedGroup sl2zAmalgamRelators ≃* AmalgamPushout`, built from
  `pushoutToAmalgam` (the pushout's universal property, checked on the two generators and the base)
  and `amalgamToPushout` (`PresentedGroup.toGroup` on the two generators, the second relator being
  `pushout_gen_six_cube`: in the pushout, the cube of the `ℤ/6` generator is the square of the
  `ℤ/4` one because both are the image of the `ℤ/2` generator).

So the presented group is the amalgam, and with `Monoid.PushoutI`'s normal forms
(`NormalWord`, `equiv`, `prod_injective`, `inf_of_range_eq_base_range`) the vocabulary of reduced
words is available for it. What that does *not* give — and what `Sl2zPresentationComplete` still
asks — is that the induced map `AmalgamPushout →* SL(2, ℤ)` is injective: the normal form theorem is
about the pushout itself, not about a map out of it, and the survival of reduced words in
`SL(2, ℤ)` is the Farey/Bass–Serre statement recorded in the module docstring.
-/

def cyclicRelators (n : ℕ) : Set (FreeGroup (Fin 1)) := {FreeGroup.of 0 ^ n}

abbrev Cyclic (n : ℕ) : Type := PresentedGroup (cyclicRelators n)

def cyclicGen (n : ℕ) : Cyclic n := PresentedGroup.of 0

lemma cyclicGen_pow (n : ℕ) : cyclicGen n ^ n = 1 := by
  simpa [cyclicGen, PresentedGroup.of, ← map_pow] using
    (PresentedGroup.one_of_mem (rels := cyclicRelators n) (x := FreeGroup.of 0 ^ n)
      (by simp [cyclicRelators]))

def cyclicTwoToFour : Cyclic 2 →* Cyclic 4 :=
  PresentedGroup.toGroup (f := fun _ => cyclicGen 4 ^ 2) (by
    intro r hr
    simp only [cyclicRelators, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_pow, FreeGroup.lift_apply_of, ← pow_mul]
    norm_num
    exact cyclicGen_pow 4)

def cyclicTwoToSix : Cyclic 2 →* Cyclic 6 :=
  PresentedGroup.toGroup (f := fun _ => cyclicGen 6 ^ 3) (by
    intro r hr
    simp only [cyclicRelators, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_pow, FreeGroup.lift_apply_of, ← pow_mul]
    norm_num
    exact cyclicGen_pow 6)

theorem amalgamR_pow_six :
    (PresentedGroup.of (rels := sl2zAmalgamRelators) (1 : Fin 2)) ^ 6 = 1 := by
  have h3 := amalgamR_cube
  rw [show (6 : ℕ) = 3 * 2 by norm_num, pow_mul, h3, ← pow_mul]
  norm_num
  exact amalgamS_pow_four

def cyclicFourToAmalgam : Cyclic 4 →* PresentedGroup sl2zAmalgamRelators :=
  PresentedGroup.toGroup (f := fun _ => PresentedGroup.of (0 : Fin 2)) (by
    intro r hr
    simp only [cyclicRelators, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_pow, FreeGroup.lift_apply_of]
    exact amalgamS_pow_four)

def cyclicSixToAmalgam : Cyclic 6 →* PresentedGroup sl2zAmalgamRelators :=
  PresentedGroup.toGroup (f := fun _ => PresentedGroup.of (1 : Fin 2)) (by
    intro r hr
    simp only [cyclicRelators, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_pow, FreeGroup.lift_apply_of]
    exact amalgamR_pow_six)

def cyclicTwoToAmalgam : Cyclic 2 →* PresentedGroup sl2zAmalgamRelators :=
  PresentedGroup.toGroup (f := fun _ => (PresentedGroup.of (0 : Fin 2)) ^ 2) (by
    intro r hr
    simp only [cyclicRelators, Set.mem_singleton_iff] at hr
    subst hr
    rw [map_pow, FreeGroup.lift_apply_of, ← pow_mul]
    norm_num
    exact amalgamS_pow_four)

lemma cyclicFourToAmalgam_gen :
    cyclicFourToAmalgam (cyclicGen 4) = PresentedGroup.of (0 : Fin 2) :=
  PresentedGroup.toGroup.of _

lemma cyclicSixToAmalgam_gen :
    cyclicSixToAmalgam (cyclicGen 6) = PresentedGroup.of (1 : Fin 2) :=
  PresentedGroup.toGroup.of _

lemma cyclicTwoToFour_gen : cyclicTwoToFour (cyclicGen 2) = cyclicGen 4 ^ 2 :=
  PresentedGroup.toGroup.of _

lemma cyclicTwoToSix_gen : cyclicTwoToSix (cyclicGen 2) = cyclicGen 6 ^ 3 :=
  PresentedGroup.toGroup.of _

lemma cyclicTwoToAmalgam_gen :
    cyclicTwoToAmalgam (cyclicGen 2) = (PresentedGroup.of (0 : Fin 2)) ^ 2 :=
  PresentedGroup.toGroup.of _

abbrev amalgamGroup : Bool → Type
  | false => Cyclic 4
  | true => Cyclic 6

instance (i : Bool) : Group (amalgamGroup i) := by
  match i with
  | false => exact inferInstanceAs (Group (Cyclic 4))
  | true => exact inferInstanceAs (Group (Cyclic 6))

abbrev amalgamMap : ∀ i, Cyclic 2 →* amalgamGroup i
  | false => cyclicTwoToFour
  | true => cyclicTwoToSix

abbrev AmalgamPushout : Type := Monoid.PushoutI amalgamMap

def pushoutToAmalgam : AmalgamPushout →* PresentedGroup sl2zAmalgamRelators :=
  Monoid.PushoutI.lift (fun i => match i with
      | false => cyclicFourToAmalgam
      | true => cyclicSixToAmalgam)
    cyclicTwoToAmalgam (by
      intro i
      match i with
      | false =>
        refine PresentedGroup.ext fun j => ?_
        fin_cases j
        change cyclicFourToAmalgam (cyclicTwoToFour (cyclicGen 2)) =
          cyclicTwoToAmalgam (cyclicGen 2)
        rw [cyclicTwoToFour_gen, cyclicTwoToAmalgam_gen, map_pow, cyclicFourToAmalgam_gen]
      | true =>
        refine PresentedGroup.ext fun j => ?_
        fin_cases j
        change cyclicSixToAmalgam (cyclicTwoToSix (cyclicGen 2)) =
          cyclicTwoToAmalgam (cyclicGen 2)
        rw [cyclicTwoToSix_gen, cyclicTwoToAmalgam_gen, map_pow, cyclicSixToAmalgam_gen,
          amalgamR_cube])

/-! ### The other direction and the equivalence -/

def amalgamToPushoutGenerators : Fin 2 → AmalgamPushout :=
  ![Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4),
    Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6)]

lemma amalgamToPushoutGenerators_zero :
    amalgamToPushoutGenerators 0 = Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4) := rfl

lemma amalgamToPushoutGenerators_one :
    amalgamToPushoutGenerators 1 = Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6) := rfl

lemma pushout_of_one_apply_base :
    Monoid.PushoutI.of (φ := amalgamMap) true (cyclicTwoToSix (cyclicGen 2)) =
      Monoid.PushoutI.base amalgamMap (cyclicGen 2) :=
  Monoid.PushoutI.of_apply_eq_base (φ := amalgamMap) true (cyclicGen 2)

lemma pushout_of_zero_apply_base :
    Monoid.PushoutI.of (φ := amalgamMap) false (cyclicTwoToFour (cyclicGen 2)) =
      Monoid.PushoutI.base amalgamMap (cyclicGen 2) :=
  Monoid.PushoutI.of_apply_eq_base (φ := amalgamMap) false (cyclicGen 2)

/-- In the pushout, the cube of the `ℤ/6` generator is the square of the `ℤ/4` one: both are the
image of the `ℤ/2` generator. -/
theorem pushout_gen_six_cube :
    (Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6)) ^ 3 =
      (Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4)) ^ 2 := by
  have e1 : (Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6)) ^ 3 =
      Monoid.PushoutI.of (φ := amalgamMap) true (cyclicTwoToSix (cyclicGen 2)) := by
    rw [← map_pow]
    exact congrArg _ cyclicTwoToSix_gen.symm
  have e0 : (Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4)) ^ 2 =
      Monoid.PushoutI.of (φ := amalgamMap) false (cyclicTwoToFour (cyclicGen 2)) := by
    rw [← map_pow]
    exact congrArg _ cyclicTwoToFour_gen.symm
  rw [e1, e0, pushout_of_one_apply_base, pushout_of_zero_apply_base]

def amalgamToPushout : PresentedGroup sl2zAmalgamRelators →* AmalgamPushout :=
  PresentedGroup.toGroup (f := amalgamToPushoutGenerators) (by
    intro r hr
    simp only [sl2zAmalgamRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
    rcases hr with rfl | rfl
    · rw [map_pow, FreeGroup.lift_apply_of, amalgamToPushoutGenerators_zero, ← map_pow,
        cyclicGen_pow, map_one]
    · rw [map_mul, map_pow, map_zpow, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of,
        amalgamToPushoutGenerators_zero, amalgamToPushoutGenerators_one, pushout_gen_six_cube]
      group)

lemma amalgamToPushout_of (i : Fin 2) :
    amalgamToPushout (PresentedGroup.of i) = amalgamToPushoutGenerators i :=
  PresentedGroup.toGroup.of _

theorem pushoutToAmalgam_comp_amalgamToPushout :
    pushoutToAmalgam.comp amalgamToPushout = MonoidHom.id _ := by
  refine PresentedGroup.ext fun i => ?_
  fin_cases i
  · change pushoutToAmalgam (amalgamToPushout (PresentedGroup.of (0 : Fin 2))) =
      PresentedGroup.of 0
    rw [amalgamToPushout_of, amalgamToPushoutGenerators_zero]
    simp only [pushoutToAmalgam, Monoid.PushoutI.lift_of]
    exact cyclicFourToAmalgam_gen
  · change pushoutToAmalgam (amalgamToPushout (PresentedGroup.of (1 : Fin 2))) =
      PresentedGroup.of 1
    rw [amalgamToPushout_of, amalgamToPushoutGenerators_one]
    simp only [pushoutToAmalgam, Monoid.PushoutI.lift_of]
    exact cyclicSixToAmalgam_gen

theorem amalgamToPushout_comp_pushoutToAmalgam :
    amalgamToPushout.comp pushoutToAmalgam = MonoidHom.id _ := by
  refine Monoid.PushoutI.hom_ext_nonempty (fun i => ?_)
  match i with
  | false =>
    refine PresentedGroup.ext fun j => ?_
    fin_cases j
    change amalgamToPushout (pushoutToAmalgam
        (Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4))) =
      Monoid.PushoutI.of (φ := amalgamMap) false (cyclicGen 4)
    simp only [pushoutToAmalgam, Monoid.PushoutI.lift_of, cyclicFourToAmalgam_gen,
      amalgamToPushout_of, amalgamToPushoutGenerators_zero]
  | true =>
    refine PresentedGroup.ext fun j => ?_
    fin_cases j
    change amalgamToPushout (pushoutToAmalgam
        (Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6))) =
      Monoid.PushoutI.of (φ := amalgamMap) true (cyclicGen 6)
    simp only [pushoutToAmalgam, Monoid.PushoutI.lift_of, cyclicSixToAmalgam_gen,
      amalgamToPushout_of, amalgamToPushoutGenerators_one]

/-- **The presented group is the amalgam.** `⟨S, R | S⁴, R³ = S²⟩` is the pushout of
`ℤ/4 ← ℤ/2 → ℤ/6` (`cyclicTwoToFour`, `cyclicTwoToSix`), which is the sense in which item 1's
presentation is the amalgam `ℤ/4 *_{ℤ/2} ℤ/6`. -/
def amalgamPushoutEquiv : PresentedGroup sl2zAmalgamRelators ≃* AmalgamPushout where
  toFun := amalgamToPushout
  invFun := pushoutToAmalgam
  left_inv a := by
    have := congrArg (fun f => f a) pushoutToAmalgam_comp_amalgamToPushout
    simpa using this
  right_inv b := by
    have := congrArg (fun f => f b) amalgamToPushout_comp_pushoutToAmalgam
    simpa using this
  map_mul' := amalgamToPushout.map_mul

/-!
### Item 1: the two cyclic factors, and exactly what is still missing

The presentation's first generator has order exactly four, and the word `T S` order exactly six —
first in `SL(2, ℤ)` (`S_sq_ne_one`, `S_ne_one`, `T_mul_S_sq_ne_one`, `T_mul_S_ne_one`,
`T_mul_S_cube_ne_one`, `T_mul_S_pow_six`) and then in the presented group itself, where the map to
`SL(2, ℤ)` detects every vanishing power: `of_zero_ne_one`, `of_zero_sq_ne_one`,
`of_one_mul_of_zero_sq_ne_one`, `of_one_mul_of_zero_cube_ne_one`, with the vanishing powers
`sl2zS_pow_four` and `of_one_mul_of_zero_pow_six`.

So the presented group contains `ℤ/4` and `ℤ/6`, generated by `S` and by `T S`, glued along
`S² = (TS)³` (`sl2zTS_relator`), and maps onto `SL(2, ℤ)`. What `Sl2zPresentationComplete` still
asks is the one remaining amalgam datum: that `⟨S⟩` and `⟨T S⟩` meet in exactly `⟨S²⟩` inside the
presented group — equivalently, that no nonempty reduced word in the two factors is trivial. The
descent above does not reach it (see the section "Component 1 of the completeness proof": the base
case of the descent's induction quantifies over all words whose product has `colHeight ≤ 1`, which
already includes `ker sl2zToGroup`), and the stratum classification below does not reach it either —
that is arithmetic about matrices, while the residue is a statement about words. The pushout
identification is done (`amalgamPushoutEquiv`, above), so the one datum left is: the induced map
`AmalgamPushout →* SL(2, ℤ)` is injective, equivalently no nonempty reduced word of the amalgam dies
there. `Monoid.PushoutI`'s normal forms (`NormalWord`, `equiv`, `prod_injective`,
`inf_of_range_eq_base_range`) are about the pushout, not about a map out of it, and there is no
Farey graph and no Bass–Serre theory at this pin. Closing it is a unit of its own, not a probe or a
repair of this file.

One measured constraint for whoever builds it, in its final form. On the incidence graph of Farey
edges and triangles (bases with `|entries| ≤ 5`, `det = 1`: 78 triangles, 117 edges), with the
triangle height the sum of `|p| + |q|` over the three cusps:

* **no triangle has two flips that decrease its height** — the "at most one smaller neighbour" half
  holds everywhere, so the maximum-vertex argument has exactly one obstruction;
* the only two tie edges of the whole graph are the single edge between the *two* triangles of
  height four, `{0, 1, ∞}` and `{0, -1, ∞}`; there are exactly two triangles with no smaller
  neighbour, and they are those two;
* the level sets are forests (sizes `2, 4, 4, 8, 4, 12, 4, 8` at heights `4, 6, 8, …`), so the
  weaker criterion "each level is acyclic" does hold — but it is *not enough* on its own: a cycle
  whose maximum is attained on a path of two or more vertices survives it.

So the criterion to prove is "at most one smaller neighbour **and no ties**", and this height needs
exactly one tiebreak, at the height-four pair.

Both halves are now theorems, and they are the reason the naive attempt stalls only at the last step:

* the "at most one smaller neighbour" half is `no_two_flips_decrease` below, for *every* pair of
  integer vectors and not only bases;
* the "no ties" half is the classification `triH_eq_imp_std` below, in the section "The Farey height
  has no ties": an `ℓ¹` tie between the two triangles on a Farey side forces that side to be the
  standard edge `{0, ∞}`, and `stdTri_triH` computes that the tied pair is `{0, 1, ∞}`, `{0, -1, ∞}`
  with every other neighbour of height six. So the tiebreak — lowering `{0, 1, ∞}` from four to three
  — separates exactly the tied pair and disturbs nothing else: it is a theorem, not a measurement.
  The integer reason no other tie exists is that a Farey basis makes the coordinates of `u + v` and
  `u - v` congruent mod `2`, and equal `ℓ¹`-lengths with determinant `±2` and that congruence force
  every coordinate to be `±1` (`core_nonneg`).

So the pair of hypotheses for `no_closed_reduced_walk` — symmetric adjacency, no ties, at most one
smaller neighbour — holds on the triangle graph. What is still missing is the dictionary that turns a
reduced word into a closed reduced walk if it dies, and the bridge from the presented group to these
matrices; its finite core is `eight_products_avoid_zpowersR` below: the product of an `⟨S⟩`-letter
with an `⟨R⟩`-letter is never in `⟨R⟩`, which is exactly what makes the walk of a *reduced* word
non-backtracking.
-/

theorem S_sq_ne_one : (S : SL(2, ℤ)) ^ 2 ≠ 1 := by
  rw [pow_two, S_mul_S_eq]
  decide

theorem S_ne_one : (S : SL(2, ℤ)) ≠ 1 := by decide

theorem T_mul_S_sq_ne_one : (T * S : SL(2, ℤ)) ^ 2 ≠ 1 := by decide

theorem T_mul_S_ne_one : (T * S : SL(2, ℤ)) ≠ 1 := by decide

theorem T_mul_S_cube_ne_one : (T * S : SL(2, ℤ)) ^ 3 ≠ 1 := by
  rw [T_mul_S_pow_three_eq_S_sq]
  exact S_sq_ne_one

theorem T_mul_S_pow_six : (T * S : SL(2, ℤ)) ^ 6 = 1 := by
  have hS : (S : SL(2, ℤ)) ^ 2 = -1 := by rw [pow_two, S_mul_S_eq]
  rw [show (6 : ℕ) = 3 * 2 by norm_num, pow_mul, T_mul_S_pow_three_eq_S_sq, hS]
  decide

theorem of_zero_sq_ne_one : (PresentedGroup.of (rels := sl2zRelators) 0) ^ 2 ≠ 1 := by
  intro h
  have h2 : sl2zToGroup ((PresentedGroup.of (rels := sl2zRelators) 0) ^ 2) = 1 := by
    rw [h, map_one]
  rw [map_pow, sl2zToGroup_of, sl2zGenVal_zero] at h2
  exact S_sq_ne_one h2

theorem of_zero_ne_one : (PresentedGroup.of (rels := sl2zRelators) 0) ≠ 1 := by
  intro h
  have h2 : sl2zToGroup (PresentedGroup.of (rels := sl2zRelators) 0) = 1 := by rw [h, map_one]
  rw [sl2zToGroup_of, sl2zGenVal_zero] at h2
  exact S_ne_one h2

theorem of_one_mul_of_zero_sq_ne_one :
    (PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 2 ≠ 1 := by
  intro h
  have h2 : sl2zToGroup ((PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 2) = 1 := by rw [h, map_one]
  rw [map_pow, map_mul, sl2zToGroup_of, sl2zToGroup_of, sl2zGenVal_zero, sl2zGenVal_one] at h2
  exact T_mul_S_sq_ne_one h2

theorem of_one_mul_of_zero_cube_ne_one :
    (PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 3 ≠ 1 := by
  intro h
  have h2 : sl2zToGroup ((PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 3) = 1 := by rw [h, map_one]
  rw [map_pow, map_mul, sl2zToGroup_of, sl2zToGroup_of, sl2zGenVal_zero, sl2zGenVal_one] at h2
  exact T_mul_S_cube_ne_one h2

theorem of_one_mul_of_zero_pow_six :
    (PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 6 = 1 := by
  have hcube : (PresentedGroup.of (rels := sl2zRelators) 1 *
      PresentedGroup.of (rels := sl2zRelators) 0) ^ 3 =
      (PresentedGroup.of (rels := sl2zRelators) 0) ^ 2 :=
    eq_of_mul_inv_eq_one sl2zTS_relator
  rw [show (6 : ℕ) = 3 * 2 by norm_num, pow_mul, hcube, ← pow_mul,
    show (2 * 2 : ℕ) = 4 by norm_num, sl2zS_pow_four]
/-- The first columns of the eight lifts are pairwise distinct: that is what makes the eight cosets
distinct rather than merely eight. -/
lemma cuspLift_firstColumn_injective :
    Function.Injective (fun i : Fin 8 => firstColumn (cuspLift i)) := by decide

/-- The parametric description of the stratum is injective: `cuspLift i * T ^ b` determines `i` and
`b`. The index is read off the first column (`cuspLift_firstColumn_injective`, which right
multiplication by `T` leaves alone) and then `b` is read off the `(0, 1)` entry of `T ^ b`. -/
theorem cuspLift_mul_T_zpow_injective {i i' : Fin 8} {b b' : ℤ}
    (h : cuspLift i * T ^ b = cuspLift i' * T ^ b') : i = i' ∧ b = b' := by
  have hcol : firstColumn (cuspLift i) = firstColumn (cuspLift i') := by
    have := congrArg firstColumn h
    simpa [firstColumn_mul_T_zpow] using this
  have hii : i = i' := cuspLift_firstColumn_injective hcol
  subst hii
  refine ⟨rfl, ?_⟩
  have h1 : T ^ b = T ^ b' := mul_left_cancel h
  have h2 := congrArg (fun X : SL(2, ℤ) => X.1 0 1) h1
  rw [coe_T_zpow, coe_T_zpow] at h2
  exact h2

/-- `Fin 8 × ℤ` parametrizes the stratum without repetition. -/
theorem cuspLift_pair_injective :
    Function.Injective (fun p : Fin 8 × ℤ => cuspLift p.1 * T ^ p.2) := by
  rintro ⟨i, b⟩ ⟨i', b'⟩ h
  obtain ⟨rfl, rfl⟩ := cuspLift_mul_T_zpow_injective h
  rfl

/-- **The cusp stratum, exactly.** `A : SL(2, ℤ)` has first-column height at most one exactly when
it is `cuspLift i * T ^ b` for a *unique* pair `(i, b)`. This closes the arithmetic of component 2:
the stratum is a bijective image of `Fin 8 × ℤ`. What is not arithmetic, and is what
`Sl2zPresentationComplete` still asks, is the word-level statement that the eight lifts' canonical
words are a transversal — that no word of `PresentedGroup sl2zRelators` is normal-closure equivalent
to two of them. -/
theorem colHeight_le_one_iff_existsUnique (A : SL(2, ℤ)) :
    colHeight A.1 ≤ 1 ↔ ∃! p : Fin 8 × ℤ, A = cuspLift p.1 * T ^ p.2 := by
  rw [colHeight_le_one_iff]
  constructor
  · rintro ⟨i, b, rfl⟩
    exact ⟨(i, b), rfl, fun q hq => cuspLift_pair_injective (by simpa using hq.symm)⟩
  · rintro ⟨⟨i, b⟩, h, _⟩
    exact ⟨i, b, h⟩

lemma cuspLift_zero_eq : cuspLift 0 = (1 : SL(2, ℤ)) := Subtype.ext (by decide)

lemma cuspLift_one_eq : cuspLift 1 = (-1 : SL(2, ℤ)) := Subtype.ext (by decide)

/-- Of the eight lifts, only `1` and `-1` have second first-column entry zero. -/
lemma cuspLift_snd_firstColumn_eq_zero (i : Fin 8) (h : (firstColumn (cuspLift i)).2 = 0) :
    i = 0 ∨ i = 1 := by
  fin_cases i
  · exact Or.inl rfl
  · exact Or.inr rfl
  all_goals simp [firstColumn, cuspLift_two, cuspLift_three, cuspLift_four, cuspLift_five,
    cuspLift_six, cuspLift_seven] at h

/-- **The stabilizer of the cusp `∞`.** A matrix whose first column is `(±1, 0)` — i.e. one that
fixes `∞ = 1/0` — is `±T ^ b`. This is the cusp-level vertex stabilizer that the Farey model of the
Bass–Serre tree of `⟨S⟩ *_{⟨S²⟩} ⟨TS⟩` needs: it identifies the stabilizer of `∞` with `⟨T⟩` up to
the central sign, and it is proved from the stratum classification rather than by any group theory
(`cuspLift_snd_firstColumn_eq_zero` is the finite part: of the eight lifts only `1` and `-1` have
second first-column entry zero). -/
theorem eq_T_zpow_or_neg_of_cusp_fixed (A : SL(2, ℤ)) (h : A.1 1 0 = 0) :
    ∃ b : ℤ, A = T ^ b ∨ A = -(T ^ b) := by
  have hdet := det_entries A
  rw [h, mul_zero, sub_zero] at hdet
  have hcol : colHeight A.1 ≤ 1 := by
    rw [colHeight_apply, h, abs_zero, max_le_iff]
    rcases Int.eq_one_or_neg_one_of_mul_eq_one hdet with ha | ha
    · exact ⟨by rw [ha]; norm_num, by norm_num⟩
    · exact ⟨by rw [ha]; norm_num, by norm_num⟩
  obtain ⟨i, b, hA⟩ := (colHeight_le_one_iff A).mp hcol
  have hfirst : (firstColumn (cuspLift i)).2 = 0 := by
    rw [← firstColumn_mul_T_zpow, ← hA, firstColumn, h]
  rcases cuspLift_snd_firstColumn_eq_zero i hfirst with rfl | rfl
  · exact ⟨b, Or.inl (by rw [hA, cuspLift_zero_eq, one_mul])⟩
  · exact ⟨b, Or.inr (by rw [hA, cuspLift_one_eq, neg_one_mul])⟩

/-!
### Why the descent cannot see the survival statement

The six amalgam letters — `S`, `S³` for the `ℤ/4` factor and `R`, `R²`, `R⁴`, `R⁵` for the `ℤ/6`
factor, `R = TS` — all lie in the stratum `colHeight = 1` (`colHeight_letters`). So the measure the
descent drives down is already minimal on every generator, and its length is no lower bound for the
length of a reduced word: computed over the 37 448 reduced words of length up to ten, the
descent length is `0` on the majority of them (a length-ten example has product
`!![-1,4;1,-5]`, first column `(-1,1)`, height one). That is the precise sense in which
component 1 cannot be iterated into component 2, and why the survival statement needs the tree
rather than a better measure on matrices.
-/

/-- The six amalgam letters all already lie in the cusp stratum, so the descent's measure is
minimal on each of them. -/
theorem colHeight_letters :
    colHeight (S : SL(2, ℤ)).1 = 1
      ∧ colHeight ((S : SL(2, ℤ)) ^ 3).1 = 1
      ∧ colHeight (T * S : SL(2, ℤ)).1 = 1
      ∧ colHeight ((T * S : SL(2, ℤ)) ^ 2).1 = 1
      ∧ colHeight ((T * S : SL(2, ℤ)) ^ 4).1 = 1
      ∧ colHeight ((T * S : SL(2, ℤ)) ^ 5).1 = 1 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> decide

/-!
### The column dictionary for the Bass–Serre tree

The tree of `⟨S⟩ *_{⟨S²⟩} ⟨TS⟩` has two kinds of vertex: `⟨S⟩`-cosets and `⟨TS⟩`-cosets. Both are
read off a matrix's columns, which is what this section starts making explicit:

* right multiplication by `S` sends the columns `(u, v)` to `(v, -u)` (`col_mul_S`), so the
  `⟨S⟩`-orbit of a matrix is its *unordered pair of columns up to sign* — a Farey edge;
* right multiplication by `S² = -1` sends `(u, v)` to `(-u, -v)` (`col_mul_S_sq`);
* right multiplication by `R = T * S` sends `(u, v)` to `(u + v, -u)` (`col_mul_R`), so the
  `⟨R⟩`-orbit is the *triple of lines* `±u`, `±v`, `±(u + v)` — a Farey triangle, of which `⟨R⟩`
  (order 6) is exactly the symmetry group;
* `⟨S²⟩ = ⟨R³⟩ = {±1}` acts trivially, which is why the edge and the triangle are the right
  coarse invariants and the amalgamated subgroup is the kernel of both readings.

The set-level form of the same two statements is `edgeLines_mul_S` and `triangleLines_mul_R`: the
Farey edge `{±u, ±v}` is fixed by right multiplication by `S` and the Farey triangle
`{±u, ±v, ±(u + v)}` by right multiplication by `R`, so the two orbit types of the tree *are* these
two sets of lines.

The local structure of the graph is `eq_pm_of_adjacent`: for a Farey basis `(u, v)`, a line adjacent
to both is one of `±u ± v`, so **the edge `{±u, ±v}` has exactly two triangular sides** and no
third.
That lemma is the basis-expansion `w = fdet w v • u - fdet w u • v` (`fdet_repr`), with the two
coefficients forced to `±1` by the two adjacency conditions.

Coordinates in a Farey basis are unique (`fdet_repr_unique`), which is what makes distinct lines
provably distinct: `fdet_self`, `fdet_skew` and the two pairings of a combination give that a vector
written as `α • u + β • v` has `α = fdet w v` and `β = -fdet w u`, so the description of a vertex by
its two coordinates is unambiguous.

What is *not* here: acyclicity of the incidence graph, and the bridge from acyclicity to "no
nonempty reduced word dies". Those are the rest of the tree unit; the column formulas, the two line
sets, the two-sides lemma and coordinate uniqueness are what it reads the vertices and edges with.
-/

/-- The `j`-th column of an `SL(2, ℤ)` matrix, as a pair of integers. -/
def col (X : SL(2, ℤ)) (j : Fin 2) : ℤ × ℤ := (X.1 0 j, X.1 1 j)

lemma col_zero (X : SL(2, ℤ)) : col X 0 = (X.1 0 0, X.1 1 0) := rfl

lemma col_one (X : SL(2, ℤ)) : col X 1 = (X.1 0 1, X.1 1 1) := rfl

/-- Right multiplication by `S` sends the columns `(u, v)` to `(v, -u)`: the `⟨S⟩`-orbit of a matrix
is its unordered pair of columns up to sign. -/
lemma col_mul_S (X : SL(2, ℤ)) :
    col (X * S) 0 = col X 1 ∧ col (X * S) 1 = -col X 0 := by
  constructor <;>
    · ext <;> simp [col, coe_mul, coe_S, Matrix.mul_apply, Fin.sum_univ_two]

lemma col_mul_S_sq (X : SL(2, ℤ)) :
    col (X * S ^ 2) 0 = -col X 0 ∧ col (X * S ^ 2) 1 = -col X 1 := by
  have hS2 : (S : SL(2, ℤ)) ^ 2 = -1 := by rw [pow_two, S_mul_S_eq]
  have h : (X * S ^ 2 : SL(2, ℤ)) = -(X : SL(2, ℤ)) := by rw [hS2, mul_neg, mul_one]
  constructor <;> · rw [h]; ext <;> simp [col]

/-- Right multiplication by `R = T * S` sends the columns `(u, v)` to `(u + v, -u)`: the `⟨R⟩`-orbit
of a matrix is the triple of lines `±u`, `±v`, `±(u + v)`, a Farey triangle. -/
lemma col_mul_R (X : SL(2, ℤ)) :
    col (X * (T * S)) 0 = col X 0 + col X 1 ∧ col (X * (T * S)) 1 = -col X 0 := by
  constructor <;>
    · ext <;> simp [col, coe_mul, coe_T, coe_S, Matrix.mul_apply, Fin.sum_univ_two]

/-- The two lines spanned by the columns of a matrix: the Farey edge that the `⟨S⟩`-coset of the
matrix fixes. -/
def edgeLines (X : SL(2, ℤ)) : Set (ℤ × ℤ) :=
  {u | u = col X 0 ∨ u = -col X 0 ∨ u = col X 1 ∨ u = -col X 1}

lemma edgeLines_mul_S (X : SL(2, ℤ)) : edgeLines (X * S) = edgeLines X := by
  have h0 := (col_mul_S X).1
  have h1 := (col_mul_S X).2
  have h2 : - -col X 0 = col X 0 := by abel
  simp only [edgeLines, h0, h1, h2]
  simp only [or_comm, or_left_comm, or_assoc]

/-- The three lines spanned by the two columns of a matrix and their sum: the Farey triangle that
the `⟨R⟩`-coset of the matrix fixes. -/
def triangleLines (X : SL(2, ℤ)) : Set (ℤ × ℤ) :=
  {u | u = col X 0 ∨ u = -col X 0 ∨ u = col X 1 ∨ u = -col X 1 ∨
    u = col X 0 + col X 1 ∨ u = -(col X 0 + col X 1)}

lemma triangleLines_mul_R (X : SL(2, ℤ)) :
    triangleLines (X * (T * S)) = triangleLines X := by
  have h0 := (col_mul_R X).1
  have h1 := (col_mul_R X).2
  have h2 : (col X 0 + col X 1) + -col X 0 = col X 1 := by abel
  have h3 : -(-col X 0) = col X 0 := by abel
  simp only [triangleLines, h0, h1, h2, h3]
  simp only [or_comm, or_left_comm, or_assoc]

/-- The determinant pairing on pairs of integer vectors. -/
def fdet (u v : ℤ × ℤ) : ℤ := u.1 * v.2 - u.2 * v.1

lemma abs_eq_one_of_abs_eq_one (x : ℤ) (h : |x| = 1) : x = 1 ∨ x = -1 := by
  have h' : |x| = |(1 : ℤ)| := by rwa [abs_one]
  exact abs_eq_abs.mp h'

/-- A vector is determined by its pairings with the members of a Farey basis: its coordinates in the
basis `(u, v)` are `fdet w v` and `-fdet w u`. -/
lemma fdet_repr (u v w : ℤ × ℤ) (h : fdet u v = 1) :
    w = (fdet w v * u.1 + (-fdet w u) * v.1, fdet w v * u.2 + (-fdet w u) * v.2) := by
  have h' : u.1 * v.2 - u.2 * v.1 = 1 := h
  have h1 : w.1 * (u.1 * v.2 - u.2 * v.1) = w.1 := by rw [h']; ring
  have h2 : w.2 * (u.1 * v.2 - u.2 * v.1) = w.2 := by rw [h']; ring
  ext <;> simp only [fdet] <;> nlinarith [h1, h2]

/-- **The two sides of an edge.** If `(u, v)` is a Farey basis, a vector adjacent to both `u`
and `v` is one of `±u ± v`: there is no third triangle on the edge `{±u, ±v}`, which is the local
input for "each edge of the tree has exactly two sides". -/
theorem eq_pm_of_adjacent (u v w : ℤ × ℤ) (h : fdet u v = 1)
    (hu : |fdet w u| = 1) (hv : |fdet w v| = 1) :
    ∃ ε₁ ε₂ : ℤ, (ε₁ = 1 ∨ ε₁ = -1) ∧ (ε₂ = 1 ∨ ε₂ = -1) ∧
      w = (ε₁ * u.1 + ε₂ * v.1, ε₁ * u.2 + ε₂ * v.2) := by
  refine ⟨fdet w v, -fdet w u, ?_, ?_, ?_⟩
  · exact abs_eq_one_of_abs_eq_one _ hv
  · have hu' : |-fdet w u| = 1 := by rwa [abs_neg]
    exact abs_eq_one_of_abs_eq_one _ hu'
  · exact fdet_repr u v w h

lemma fdet_self (a : ℤ × ℤ) : fdet a a = 0 := by
  simp only [fdet]
  ring

lemma fdet_skew (a b : ℤ × ℤ) : fdet a b = -fdet b a := by
  simp only [fdet]
  ring

/-- Pairing a combination `α • u + β • v` against `v`. -/
lemma fdet_combo_right (u v : ℤ × ℤ) (α β : ℤ) :
    fdet (α * u.1 + β * v.1, α * u.2 + β * v.2) v = α * fdet u v := by
  simp only [fdet]
  ring

/-- Pairing a combination `α • u + β • v` against `u`. -/
lemma fdet_combo_left (u v : ℤ × ℤ) (α β : ℤ) :
    fdet (α * u.1 + β * v.1, α * u.2 + β * v.2) u = β * fdet v u := by
  simp only [fdet]
  ring

/-- Coordinates in a Farey basis are unique, and they are the two determinant pairings. -/
lemma fdet_repr_unique (u v w : ℤ × ℤ) (h : fdet u v = 1) {α β : ℤ}
    (hw : w = (α * u.1 + β * v.1, α * u.2 + β * v.2)) :
    α = fdet w v ∧ β = -fdet w u := by
  have hvu : fdet v u = -1 := by rw [fdet_skew, h]
  constructor
  · have : fdet w v = fdet (α * u.1 + β * v.1, α * u.2 + β * v.2) v := by rw [hw]
    rw [this, fdet_combo_right, h, mul_one]
  · have : fdet w u = fdet (α * u.1 + β * v.1, α * u.2 + β * v.2) u := by rw [hw]
    rw [this, fdet_combo_left, hvu]
    ring

/-- The `ℓ¹` height of an integer vector. -/
def hℓ (x : ℤ × ℤ) : ℤ := |x.1| + |x.2|

/-- `2u + v`. -/
def twoUaddV (u v : ℤ × ℤ) : ℤ × ℤ := (2 * u.1 + v.1, 2 * u.2 + v.2)

/-- `u + 2v`. -/
def UaddTwoV (u v : ℤ × ℤ) : ℤ × ℤ := (u.1 + 2 * v.1, u.2 + 2 * v.2)

lemma hℓ_add_le (x y : ℤ × ℤ) : hℓ (x + y) ≤ hℓ x + hℓ y := by
  simp only [hℓ, Prod.fst_add, Prod.snd_add]
  linarith [abs_add_le x.1 y.1, abs_add_le x.2 y.2]

lemma hℓ_sub_le (x y : ℤ × ℤ) : hℓ (x - y) ≤ hℓ x + hℓ y := by
  have := hℓ_add_le x (-y)
  simpa [hℓ, Prod.fst_sub, Prod.snd_sub, abs_neg, sub_eq_add_neg] using this

lemma hℓ_double (x : ℤ × ℤ) : hℓ ((2 * x.1, 2 * x.2) : ℤ × ℤ) = 2 * hℓ x := by
  simp only [hℓ, abs_mul]
  norm_num
  linarith

lemma double_eq_add_sub (u v : ℤ × ℤ) :
    ((2 * v.1, 2 * v.2) : ℤ × ℤ) = (u + v) + (v - u) := by
  ext <;> simp <;> ring

lemma double_eq_add_sub' (u v : ℤ × ℤ) :
    ((2 * u.1, 2 * u.2) : ℤ × ℤ) = (u + v) + (u - v) := by
  ext <;> simp <;> ring

lemma double_add_eq (u v : ℤ × ℤ) :
    ((2 * (u + v).1, 2 * (u + v).2) : ℤ × ℤ) = twoUaddV u v + v := by
  ext <;> simp only [twoUaddV, Prod.fst_add, Prod.snd_add] <;> ring

lemma double_eq_sub (u v : ℤ × ℤ) :
    ((2 * u.1, 2 * u.2) : ℤ × ℤ) = twoUaddV u v - v := by
  ext <;> simp [twoUaddV]

lemma double_add_eq' (u v : ℤ × ℤ) :
    ((2 * (u + v).1, 2 * (u + v).2) : ℤ × ℤ) = UaddTwoV u v + u := by
  ext <;> simp only [UaddTwoV, Prod.fst_add, Prod.snd_add] <;> ring

lemma double_eq_sub' (u v : ℤ × ℤ) :
    ((2 * v.1, 2 * v.2) : ℤ × ℤ) = UaddTwoV u v - u := by
  ext <;> simp only [UaddTwoV, Prod.fst_sub, Prod.snd_sub] <;> ring

/-- **At most one flip decreases the height.** For any two integer vectors, at most one of the three
neighbour triangles of `{u, v, u + v}` has smaller `ℓ¹`-height. -/
theorem no_two_flips_decrease (u v : ℤ × ℤ) :
    ¬ (hℓ (v - u) < hℓ (u + v) ∧ hℓ (twoUaddV u v) < hℓ v) ∧
    ¬ (hℓ (v - u) < hℓ (u + v) ∧ hℓ (UaddTwoV u v) < hℓ u) ∧
    ¬ (hℓ (twoUaddV u v) < hℓ v ∧ hℓ (UaddTwoV u v) < hℓ u) := by
  -- `hℓ (u + v)` above `hℓ v` from the first condition
  have ha_v : hℓ (v - u) < hℓ (u + v) → hℓ (u + v) > hℓ v := by
    intro h1
    have h2 : hℓ ((2 * v.1, 2 * v.2) : ℤ × ℤ) ≤ hℓ (u + v) + hℓ (v - u) := by
      rw [double_eq_add_sub]
      exact hℓ_add_le _ _
    rw [hℓ_double] at h2
    linarith
  have ha_u : hℓ (v - u) < hℓ (u + v) → hℓ (u + v) > hℓ u := by
    intro h1
    have h2 : hℓ ((2 * u.1, 2 * u.2) : ℤ × ℤ) ≤ hℓ (u + v) + hℓ (u - v) := by
      rw [double_eq_add_sub']
      exact hℓ_add_le _ _
    have h4 : hℓ (u - v) = hℓ (v - u) := by
      rw [show u - v = -(v - u) by abel]
      simp only [hℓ, Prod.fst_neg, Prod.snd_neg, abs_neg]
    rw [hℓ_double, h4] at h2
    linarith
  have hb_v : hℓ (twoUaddV u v) < hℓ v → hℓ (u + v) < hℓ v := by
    intro h1
    have h2 : hℓ ((2 * (u + v).1, 2 * (u + v).2) : ℤ × ℤ) ≤ hℓ (twoUaddV u v) + hℓ v := by
      rw [double_add_eq]
      exact hℓ_add_le _ _
    rw [hℓ_double] at h2
    linarith
  have hb_u : hℓ (twoUaddV u v) < hℓ v → hℓ u < hℓ v := by
    intro h1
    have h2 : hℓ ((2 * u.1, 2 * u.2) : ℤ × ℤ) ≤ hℓ (twoUaddV u v) + hℓ v := by
      rw [double_eq_sub]
      exact hℓ_sub_le _ _
    rw [hℓ_double] at h2
    linarith
  have hc_v : hℓ (UaddTwoV u v) < hℓ u → hℓ v < hℓ u := by
    intro h1
    have h2 : hℓ ((2 * v.1, 2 * v.2) : ℤ × ℤ) ≤ hℓ (UaddTwoV u v) + hℓ u := by
      rw [double_eq_sub']
      exact hℓ_sub_le _ _
    rw [hℓ_double] at h2
    linarith
  have hc_u : hℓ (UaddTwoV u v) < hℓ u → hℓ (u + v) < hℓ u := by
    intro h1
    have h2 : hℓ ((2 * (u + v).1, 2 * (u + v).2) : ℤ × ℤ) ≤ hℓ (UaddTwoV u v) + hℓ u := by
      rw [double_add_eq']
      exact hℓ_add_le _ _
    rw [hℓ_double] at h2
    linarith
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨h1, h2⟩
    linarith [ha_v h1, hb_v h2]
  · rintro ⟨h1, h2⟩
    linarith [ha_u h1, hc_u h2]
  · rintro ⟨h1, h2⟩
    linarith [hb_u h1, hc_v h2]

/-- **The maximum-vertex lemma.** Let `r` be a symmetric adjacency relation on a finite type, `h` a
height that is never equal along an edge and such that every vertex has at most one neighbour of
strictly smaller height. Then there is no closed reduced walk: no cyclic sequence of vertices, each
consecutive pair adjacent and no immediate backtracking. -/
theorem no_closed_reduced_walk {V : Type} (r : V → V → Prop) (h : V → ℤ)
    (hsym : ∀ a b, r a b → r b a)
    (htie : ∀ a b, r a b → h a ≠ h b)
    (hone : ∀ a b c, r a b → r a c → b ≠ c → ¬ (h b < h a ∧ h c < h a)) :
    ¬ ∃ (n : ℕ) (_ : NeZero n) (v : ZMod n → V),
      (∀ i, r (v i) (v (i + 1))) ∧ (∀ i, v (i - 1) ≠ v (i + 1)) := by
  rintro ⟨n, hn, v, hadj, hred⟩
  classical
  obtain ⟨i₀, -, hmax⟩ := Finset.exists_max_image (Finset.univ : Finset (ZMod n)) (fun i => h (v i))
    Finset.univ_nonempty
  have hmax' : ∀ i, h (v i) ≤ h (v i₀) := fun i => hmax i (Finset.mem_univ i)
  have h1 : r (v i₀) (v (i₀ + 1)) := hadj i₀
  have h2 : r (v i₀) (v (i₀ - 1)) := hsym _ _ (by simpa using hadj (i₀ - 1))
  have hne : v (i₀ - 1) ≠ v (i₀ + 1) := hred i₀
  have hlt1 : h (v (i₀ + 1)) < h (v i₀) :=
    lt_of_le_of_ne (hmax' _) (Ne.symm (htie _ _ h1))
  have hlt2 : h (v (i₀ - 1)) < h (v i₀) :=
    lt_of_le_of_ne (hmax' _) (Ne.symm (htie _ _ h2))
  exact hone _ _ _ h1 h2 hne.symm ⟨hlt1, hlt2⟩

/-- The six elements of `⟨T * S⟩`, as a finite set. -/
def zpowersRSet : Finset (SL(2, ℤ)) := {1, -(1 : SL(2, ℤ)), T * S, -(T * S),
  (T * S) ^ 2, -((T * S) ^ 2)}

lemma mul_mem_zpowersRSet : ∀ a ∈ zpowersRSet, ∀ b ∈ zpowersRSet, a * b ∈ zpowersRSet := by
  decide

lemma inv_mem_zpowersRSet : ∀ a ∈ zpowersRSet, a⁻¹ ∈ zpowersRSet := by decide

lemma gen_mem_zpowersRSet : (T * S : SL(2, ℤ)) ∈ zpowersRSet := by decide

lemma one_mem_zpowersRSet : (1 : SL(2, ℤ)) ∈ zpowersRSet := by decide

/-- The six listed elements form a subgroup. -/
def zpowersRSubgroup : Subgroup (SL(2, ℤ)) where
  carrier := ↑zpowersRSet
  mul_mem' := by
    intro a b ha hb
    exact mul_mem_zpowersRSet a ha b hb
  one_mem' := one_mem_zpowersRSet
  inv_mem' := by
    intro a ha
    exact inv_mem_zpowersRSet a ha

/-- `⟨T * S⟩` is contained in its six listed elements. -/
theorem zpowers_le_zpowersRSet : Subgroup.zpowers (T * S) ≤ zpowersRSubgroup := by
  rw [Subgroup.zpowers_le]
  change (T * S : SL(2, ℤ)) ∈ zpowersRSet
  exact gen_mem_zpowersRSet

theorem mem_zpowersRSet {Y : SL(2, ℤ)} (h : Y ∈ Subgroup.zpowers (T * S)) :
    Y ∈ zpowersRSet := zpowers_le_zpowersRSet h

/-- **Reducedness gives no backtracking.** A product of an `⟨S⟩`-letter (`S` or `S³`) with a
`⟨T * S⟩`-letter (`R`, `R²`, `R⁴`, `R⁵` for `R = T * S`) is never an element of `⟨R⟩`. -/
theorem eight_products_avoid_zpowersR : ∀ a b : SL(2, ℤ),
    (a = S ∨ a = S ^ 3) →
    (b = T * S ∨ b = (T * S) ^ 2 ∨ b = (T * S) ^ 4 ∨ b = (T * S) ^ 5) →
    a * b ∉ Subgroup.zpowers (T * S) := by
  intro a b ha hb hmem
  have hset : a * b ∈ zpowersRSet := mem_zpowersRSet hmem
  rcases ha with rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl <;>
    simp only [zpowersRSet, Finset.mem_insert, Finset.mem_singleton] at hset <;>
      revert hset <;> decide

/-!
### The Farey height has no ties: the tiebreak, proved

The acyclicity criterion proved above (`no_closed_reduced_walk`) needs two things of the height on the
Farey triangle graph: adjacent vertices of different height, and at most one neighbour below each
vertex. The second is `no_two_flips_decrease`. The first is the delicate one, and the module docstring
above records it as measured rather than proved: with the `ℓ¹` height `(|p| + |q|)` summed over the
three cusps of a triangle, the *only* tie in the whole graph is the edge between the two triangles of
height four, `{0, 1, ∞}` and `{0, -1, ∞}`, and lowering `{0, 1, ∞}` to three removes it.

This section proves both halves of that measurement.

* `triH_eq_imp_std` is the classification: **an `ℓ¹` tie forces the shared side to be the standard
  edge `{0, ∞}`**. Its integer core is `core_nonneg`: two integer vectors with equal `ℓ¹`-length,
  determinant `±2` and congruent coordinates mod `2` have all coordinates `±1`. The congruence is what
  makes this rigid — without it there are equal-length, determinant-`±2` pairs of every size — and it
  is exactly what a Farey basis supplies, the coordinates of `u + v` and `u - v` differing by twice
  those of `u` and `v`. The same statement for the other two sides of a triangle is
  `triH_flip_left` and `triH_flip_right`, the first by applying the side form to the basis
  `(u, u + v)` and the second to `(-v, u + v)`.
* `stdTri_triH` computes the exception: the two triangles of the tied edge both have height four, and
  the three neighbours of each have heights four, six and six. So the tie is exactly there, exactly
  once, and the tiebreak changes nothing else — the O(1) correction `{0, 1, ∞} : 4 ↦ 3` of the module
  docstring separates the tied pair without disturbing any other comparison.

What is still not here is what carries the theorem: the walk built from a reduced word's prefixes, and
the bridge from `PresentedGroup sl2zRelators` through `amalgamPushoutEquiv` to these matrices. This
section is the height half of that unit, in the form the criterion consumes it.
-/

/-- The standard vector `(1, 0)`. -/
abbrev E1 : ℤ × ℤ := (1, 0)

/-- The standard vector `(0, 1)`. -/
abbrev E2 : ℤ × ℤ := (0, 1)

/-- The two lines spanned by a Farey basis: the vertex of the tree of `⟨S⟩`-type. -/
def edgeF (u v : ℤ × ℤ) : Finset (ℤ × ℤ) := {u, -u, v, -v}

/-- The three lines spanned by a Farey basis and their sum: the vertex of the tree of `⟨R⟩`-type. -/
def triF (u v : ℤ × ℤ) : Finset (ℤ × ℤ) := {u, -u, v, -v, u + v, -(u + v)}

/-- The standard edge `{0, ∞}`. -/
def stdEdge : Finset (ℤ × ℤ) := edgeF E1 E2

/-- The standard triangle `{0, 1, ∞}`. -/
def stdTri0 : Finset (ℤ × ℤ) := triF E1 E2

/-- The other standard triangle `{0, -1, ∞}`: the second triangle of the standard edge. -/
def stdTri1 : Finset (ℤ × ℤ) := triF E1 (-E2)

/-- The `ℓ¹` height of the triangle with basis `(u, v)`. -/
def triH (u v : ℤ × ℤ) : ℤ := hℓ u + hℓ v + hℓ (u + v)

lemma hl_neg (x : ℤ × ℤ) : hℓ (-x) = hℓ x := by
  obtain ⟨p, q⟩ := x
  simp only [hℓ, Prod.fst_neg, Prod.snd_neg, abs_neg]

lemma hl_eq_zero {x : ℤ × ℤ} : hℓ x = 0 ↔ x = 0 := by
  obtain ⟨p, q⟩ := x
  simp only [hℓ, Prod.mk_eq_zero]
  constructor
  · intro h
    have h1 : |p| = 0 := by linarith [abs_nonneg p, abs_nonneg q]
    have h2 : |q| = 0 := by linarith [abs_nonneg p, abs_nonneg q]
    exact ⟨abs_eq_zero.mp h1, abs_eq_zero.mp h2⟩
  · rintro ⟨rfl, rfl⟩
    simp

lemma hl_nonneg (x : ℤ × ℤ) : 0 ≤ hℓ x := by
  obtain ⟨p, q⟩ := x
  simp only [hℓ]; positivity

lemma hl_pos {x : ℤ × ℤ} (h : x ≠ 0) : 0 < hℓ x := by
  rcases Int.lt_or_eq_of_le (hl_nonneg x) with h' | h'
  · exact h'
  · exact absurd (hl_eq_zero.mp h'.symm) h

lemma triH_comm (u v : ℤ × ℤ) : triH v u = triH u v := by
  simp only [triH, add_comm u v]; ring

/-- The height of the triangle with basis `(u, v)` is at least three. -/
lemma triH_ge_three {u v : ℤ × ℤ} (h : fdet u v = 1) : 3 ≤ triH u v := by
  have hu : u ≠ 0 := by rintro rfl; simp [fdet] at h
  have hv : v ≠ 0 := by rintro rfl; simp [fdet] at h
  have huv : u + v ≠ 0 := by
    rintro h0
    have h1 : u = -v := by
      rw [eq_neg_iff_add_eq_zero]
      simpa using h0
    rw [h1] at h
    simp only [fdet, Prod.fst_neg, Prod.snd_neg] at h
    nlinarith [mul_self_nonneg (-v.1), mul_self_nonneg v.1, mul_self_nonneg v.2]
  have h1 := hl_pos hu; have h2 := hl_pos hv; have h3 := hl_pos huv
  simp only [triH]; linarith


/-! ### The tie classification: an ℓ¹ equality forces the standard edge -/

/-- `x * y = 2` with `0 ≤ x`, `0 ≤ y`. -/
lemma zp_mul_eq_two {x y : ℤ} (h : x * y = 2) (hx : 0 ≤ x) (hy : 0 ≤ y) :
    (x = 1 ∧ y = 2) ∨ (x = 2 ∧ y = 1) := by
  have hyne : y ≠ 0 := by rintro rfl; norm_num at h
  have hxne : x ≠ 0 := by rintro rfl; norm_num at h
  have hy1 : 1 ≤ y := by omega
  have hx1 : 1 ≤ x := by omega
  have hx2 : x ≤ 2 := by nlinarith
  have hy2 : y ≤ 2 := by nlinarith
  interval_cases x <;> interval_cases y <;> omega

/-- `x * y = 1` with `0 ≤ x`, `0 ≤ y`. -/
lemma zp_mul_eq_one {x y : ℤ} (h : x * y = 1) (hx : 0 ≤ x) (hy : 0 ≤ y) : x = 1 ∧ y = 1 := by
  have hyne : y ≠ 0 := by rintro rfl; norm_num at h
  have hxne : x ≠ 0 := by rintro rfl; norm_num at h
  have hy1 : 1 ≤ y := by omega
  have hx1 : 1 ≤ x := by omega
  have hx2 : x ≤ 1 := by nlinarith
  have hy2 : y ≤ 1 := by nlinarith
  interval_cases x <;> interval_cases y <;> omega

/-- `x + y = 2` with `0 ≤ x`, `0 ≤ y`. -/
lemma zp_add_eq_two {x y : ℤ} (h : x + y = 2) (hx : 0 ≤ x) (hy : 0 ≤ y) :
    (x = 0 ∧ y = 2) ∨ (x = 1 ∧ y = 1) ∨ (x = 2 ∧ y = 0) := by
  have hx2 : x ≤ 2 := by omega
  interval_cases x <;> omega

/-- **The integer core of the tie classification**, in the two positive signs: if two integer vectors
`(P, Q)` and `(R, S)` have equal `ℓ¹`-lengths and determinant `±2`, and are congruent mod `2`, then all
four coordinates are `±1`. (Congruence mod `2` is what makes the equal-length condition rigid: without
it there are solutions of every size.) -/
theorem core_nonneg (P Q R S : ℤ) (h1 : |P| + |Q| = |R| + |S|)
    (h2 : P * S - Q * R = 2 ∨ P * S - Q * R = -2)
    (hp : Even (P - R)) (hq : Even (Q - S)) (hP : 0 ≤ P) (hR : 0 ≤ R) :
    |P| = 1 ∧ |Q| = 1 ∧ |R| = 1 ∧ |S| = 1 := by
  obtain ⟨kp, hkp⟩ := hp
  obtain ⟨kq, hkq⟩ := hq
  rcases or_comm.mp (lt_or_ge Q 0) with hQ | hQ
  · rcases or_comm.mp (lt_or_ge S 0) with hS | hS
    · -- `0 ≤ Q`, `0 ≤ S`: no solutions, by `(P - R) * (P + Q) = ±2` and parity.
      rw [abs_of_nonneg hP, abs_of_nonneg hQ, abs_of_nonneg hR, abs_of_nonneg hS] at h1
      have hkey : (kp + kp) * (P + Q) = 2 ∨ (kp + kp) * (P + Q) = -2 := by
        rcases h2 with h | h
        · left; nlinarith
        · right; nlinarith
      have hM1 : 1 ≤ P + Q := by rcases hkey with h | h <;> nlinarith
      have hkb : -1 ≤ kp ∧ kp ≤ 1 := by
        have h5 : |(kp + kp) * (P + Q)| = 2 := by
          rcases hkey with h | h
          · rw [h]; norm_num
          · rw [h]; norm_num
        rw [abs_mul, show kp + kp = 2 * kp by ring, abs_mul] at h5
        rw [show |(2 : ℤ)| = 2 by norm_num,
          abs_of_nonneg (by linarith : (0 : ℤ) ≤ P + Q)] at h5
        exact abs_le.mp (by nlinarith [abs_nonneg (kp : ℤ)])
      obtain ⟨hk1, hk2⟩ := hkb
      interval_cases kp <;> rcases hkey with h | h <;> omega
    · -- `0 ≤ Q`, `S < 0`: only `P = Q = R = 1`, `S = -1`.
      rw [abs_of_nonneg hP, abs_of_nonneg hQ, abs_of_nonneg hR, abs_of_neg hS] at h1
      have hSn : (0 : ℤ) ≤ -S := by omega
      have hsum : P * (-S) + Q * R = 2 := by
        rcases h2 with h | h
        · exfalso; nlinarith
        · nlinarith
      have hx0 : (0 : ℤ) ≤ P * (-S) := mul_nonneg hP hSn
      have hy0 : (0 : ℤ) ≤ Q * R := mul_nonneg hQ hR
      rcases zp_add_eq_two hsum hx0 hy0 with ⟨ha, hb⟩ | ⟨ha, hb⟩ | ⟨ha, hb⟩
      · rcases mul_eq_zero.mp ha with hP0 | hS0
        · rcases zp_mul_eq_two hb hQ hR with ⟨hQ1, hR2⟩ | ⟨hQ2, hR1⟩
          · omega
          · omega
        · omega
      · obtain ⟨hP1, hS1⟩ := zp_mul_eq_one ha hP hSn
        obtain ⟨hQ1, hR1⟩ := zp_mul_eq_one hb hQ hR
        refine ⟨?_, ?_, ?_, ?_⟩
        · rw [hP1]; norm_num
        · rw [hQ1]; norm_num
        · rw [hR1]; norm_num
        · rw [← abs_neg S, hS1]; norm_num
      · rcases mul_eq_zero.mp hb with hQ0 | hR0
        · rcases zp_mul_eq_two ha hP hSn with ⟨hP1, hS1⟩ | ⟨hP2, hS2⟩
          · omega
          · omega
        · rcases zp_mul_eq_two ha hP hSn with ⟨hP1, hS1⟩ | ⟨hP2, hS2⟩
          · omega
          · omega
  · rcases or_comm.mp (lt_or_ge S 0) with hS | hS
    · -- `Q < 0`, `0 ≤ S`: only `P = R = S = 1`, `Q = -1`.
      rw [abs_of_nonneg hP, abs_of_neg hQ, abs_of_nonneg hR, abs_of_nonneg hS] at h1
      have hQn : (0 : ℤ) ≤ -Q := by omega
      have hsum : P * S + (-Q) * R = 2 := by
        rcases h2 with h | h
        · nlinarith
        · exfalso; nlinarith
      have hx0 : (0 : ℤ) ≤ P * S := mul_nonneg hP hS
      have hy0 : (0 : ℤ) ≤ (-Q) * R := mul_nonneg hQn hR
      rcases zp_add_eq_two hsum hx0 hy0 with ⟨ha, hb⟩ | ⟨ha, hb⟩ | ⟨ha, hb⟩
      · rcases mul_eq_zero.mp ha with hP0 | hS0
        · rcases zp_mul_eq_two hb hQn hR with ⟨hQ1, hR2⟩ | ⟨hQ2, hR1⟩
          · omega
          · omega
        · rcases zp_mul_eq_two hb hQn hR with ⟨hQ1, hR2⟩ | ⟨hQ2, hR1⟩
          · omega
          · omega
      · obtain ⟨hP1, hS1⟩ := zp_mul_eq_one ha hP hS
        obtain ⟨hQ1, hR1⟩ := zp_mul_eq_one hb hQn hR
        refine ⟨?_, ?_, ?_, ?_⟩
        · rw [hP1]; norm_num
        · rw [← abs_neg Q, hQ1]; norm_num
        · rw [hR1]; norm_num
        · rw [hS1]; norm_num
      · rcases mul_eq_zero.mp hb with hQ0 | hR0
        · rcases zp_mul_eq_two ha hP hS with ⟨hP1, hS1⟩ | ⟨hP2, hS2⟩
          · omega
          · omega
        · rcases zp_mul_eq_two ha hP hS with ⟨hP1, hS1⟩ | ⟨hP2, hS2⟩
          · omega
          · omega
    · -- `Q < 0`, `S < 0`
      -- no solutions, by `(R - P) * (P + q) = ±2` and parity
      rw [abs_of_nonneg hP, abs_of_neg hQ, abs_of_nonneg hR, abs_of_neg hS] at h1
      have hkey : (kp + kp) * (P + (-Q)) = 2 ∨ (kp + kp) * (P + (-Q)) = -2 := by
        rcases h2 with h | h
        · right; nlinarith
        · left; nlinarith
      have hM1 : 1 ≤ P + (-Q) := by rcases hkey with h | h <;> nlinarith
      have hkb : -1 ≤ kp ∧ kp ≤ 1 := by
        have h5 : |(kp + kp) * (P + (-Q))| = 2 := by
          rcases hkey with h | h
          · rw [h]; norm_num
          · rw [h]; norm_num
        rw [abs_mul, show kp + kp = 2 * kp by ring, abs_mul] at h5
        rw [show |(2 : ℤ)| = 2 by norm_num,
          abs_of_nonneg (by linarith : (0 : ℤ) ≤ P + (-Q))] at h5
        exact abs_le.mp (by nlinarith [abs_nonneg (kp : ℤ)])
      obtain ⟨hk1, hk2⟩ := hkb
      interval_cases kp <;> rcases hkey with h | h <;> omega

/-- If a vector has `ℓ¹`-length one, it is one of the four unit coordinate vectors. -/
lemma eq_pm_of_hl_one {x : ℤ × ℤ} (h : hℓ x = 1) :
    x = E1 ∨ x = -E1 ∨ x = E2 ∨ x = -E2 := by
  obtain ⟨p, q⟩ := x
  simp only [hℓ] at h
  have hp : |p| ≤ 1 := by linarith [abs_nonneg q]
  have hq : |q| ≤ 1 := by linarith [abs_nonneg p]
  obtain ⟨hp1, hp2⟩ := abs_le.mp hp
  obtain ⟨hq1, hq2⟩ := abs_le.mp hq
  interval_cases p <;> interval_cases q <;> simp_all [E1, E2]

/-- Two distinct lines of `ℓ¹`-length one are the two coordinate axes: the standard edge. -/
lemma edgeF_eq_std_of {u v : ℤ × ℤ} (hu : hℓ u = 1) (hv : hℓ v = 1) (hd : fdet u v ≠ 0) :
    edgeF u v = stdEdge := by
  obtain ⟨p, q⟩ := u
  obtain ⟨r, s⟩ := v
  simp only [hℓ] at hu hv
  simp only [fdet] at hd
  have hp : |p| ≤ 1 := by linarith [abs_nonneg q]
  have hq : |q| ≤ 1 := by linarith [abs_nonneg p]
  have hr : |r| ≤ 1 := by linarith [abs_nonneg s]
  have hs : |s| ≤ 1 := by linarith [abs_nonneg r]
  obtain ⟨hp1, hp2⟩ := abs_le.mp hp
  obtain ⟨hq1, hq2⟩ := abs_le.mp hq
  obtain ⟨hr1, hr2⟩ := abs_le.mp hr
  obtain ⟨hs1, hs2⟩ := abs_le.mp hs
  interval_cases p <;> interval_cases q <;> interval_cases r <;> interval_cases s <;>
    (simp_all [edgeF, stdEdge, E1, E2] <;> decide)

/-- An integer of absolute value one is `±1`. -/
lemma int_eq_pm_of_abs_eq_one {x : ℤ} (h : |x| = 1) : x = 1 ∨ x = -1 := by
  have h' : |x| ≤ 1 := le_of_eq h
  obtain ⟨h1, h2⟩ := abs_le.mp h'
  interval_cases x <;> simp_all

/-- **The tie classification.** If the two triangles on the side `{u, v}` of a Farey basis `(u, v)`
have equal `ℓ¹`-height, then that side is the standard edge `{0, ∞}`. -/
theorem triH_eq_imp_std {u v : ℤ × ℤ} (hd : fdet u v = 1) (ht : triH u v = triH v (-u)) :
    edgeF u v = stdEdge := by
  obtain ⟨a, b⟩ := u
  obtain ⟨c, d⟩ := v
  simp only [fdet] at hd
  have htab : |a + c| + |b + d| = |c + -a| + |d + -b| := by
    have h := ht
    simp only [triH, hℓ, Prod.fst_add, Prod.snd_add, Prod.fst_neg, Prod.snd_neg, abs_neg] at h
    linarith
  have ht'' : |a + c| + |b + d| = |a - c| + |b - d| := by
    rw [htab, show c + -a = -(a - c) by ring, show d + -b = -(b - d) by ring, abs_neg, abs_neg]
  -- the four linear functionals of the basis
  set P : ℤ := a + c with hP
  set Q : ℤ := b + d with hQ
  set R : ℤ := a - c with hR
  set S : ℤ := b - d with hS
  have h1 : |P| + |Q| = |R| + |S| := by simpa [hP, hQ, hR, hS] using ht''
  have h2 : P * S - Q * R = 2 ∨ P * S - Q * R = -2 := by
    have h : P * S - Q * R = -(2 * (a * d - b * c)) := by
      rw [hP, hQ, hR, hS]; ring
    rw [h, hd]; norm_num
  have hp : Even (P - R) := by rw [hP, hR]; exact ⟨c, by ring⟩
  have hq : Even (Q - S) := by rw [hQ, hS]; exact ⟨d, by ring⟩
  -- normalize the signs of `P` and `R` by negating the two vectors
  have hneg2 : P * -S - Q * -R = 2 ∨ P * -S - Q * -R = -2 := by
    rcases h2 with h | h
    · right; nlinarith
    · left; nlinarith
  have hnegP : -P * S - -Q * R = 2 ∨ -P * S - -Q * R = -2 := by
    rcases h2 with h | h
    · right; nlinarith
    · left; nlinarith
  have hnegAll : -P * -S - -Q * -R = 2 ∨ -P * -S - -Q * -R = -2 := by
    rcases h2 with h | h
    · left; nlinarith
    · right; nlinarith
  have key : |P| = 1 ∧ |Q| = 1 ∧ |R| = 1 ∧ |S| = 1 := by
    rcases lt_or_ge P 0 with hPn | hPn
    · rcases lt_or_ge R 0 with hRn | hRn
      · have hp' : Even (-P - -R) := by obtain ⟨k, hk⟩ := hp; exact ⟨-k, by omega⟩
        have hq' : Even (-Q - -S) := by obtain ⟨k, hk⟩ := hq; exact ⟨-k, by omega⟩
        have := core_nonneg (-P) (-Q) (-R) (-S) (by simpa using h1) hnegAll hp' hq'
          (by linarith) (by linarith)
        simpa using this
      · have hp' : Even (-P - R) := by obtain ⟨k, hk⟩ := hp; exact ⟨-k - R, by omega⟩
        have hq' : Even (-Q - S) := by obtain ⟨k, hk⟩ := hq; exact ⟨-k - S, by omega⟩
        have := core_nonneg (-P) (-Q) R S (by simpa using h1) hnegP hp' hq' (by linarith) hRn
        simpa using this
    · rcases lt_or_ge R 0 with hRn | hRn
      · have hp' : Even (P - -R) := by obtain ⟨k, hk⟩ := hp; exact ⟨k + R, by omega⟩
        have hq' : Even (Q - -S) := by obtain ⟨k, hk⟩ := hq; exact ⟨k + S, by omega⟩
        have := core_nonneg P Q (-R) (-S) (by simpa using h1) hneg2 hp' hq' hPn (by linarith)
        simpa using this
      · exact core_nonneg P Q R S h1 h2 hp hq hPn hRn
  -- now read off the two triangles
  have hP' : P = 1 ∨ P = -1 := int_eq_pm_of_abs_eq_one key.1
  have hQ' : Q = 1 ∨ Q = -1 := int_eq_pm_of_abs_eq_one key.2.1
  have hR' : R = 1 ∨ R = -1 := int_eq_pm_of_abs_eq_one key.2.2.1
  have hS' : S = 1 ∨ S = -1 := int_eq_pm_of_abs_eq_one key.2.2.2
  have hcross : P * R + Q * S = 0 := by
    rcases hP' with h | h <;> rcases hQ' with h' | h' <;> rcases hR' with h'' | h'' <;>
      rcases hS' with h3 | h3 <;>
      rw [h, h', h'', h3] at h2 ⊢ <;> (norm_num at h2) <;> norm_num
  have h2a : 2 * a = P + R := by rw [hP, hR]; ring
  have h2b : 2 * b = Q + S := by rw [hQ, hS]; ring
  have h2c : 2 * c = P - R := by rw [hP, hR]; ring
  have h2d : 2 * d = Q - S := by rw [hQ, hS]; ring
  have habs1 : |P + R| = 1 + P * R := by
    rcases hP' with h | h <;> rcases hR' with h' | h' <;> rw [h, h'] <;> norm_num
  have habs2 : |Q + S| = 1 + Q * S := by
    rcases hQ' with h | h <;> rcases hS' with h' | h' <;> rw [h, h'] <;> norm_num
  have hsum_u : |P + R| + |Q + S| = 2 := by
    rw [habs1, habs2]; linarith
  have hsum_v : |P - R| + |Q - S| = 2 := by
    have h1' : |P - R| = 1 - P * R := by
      rcases hP' with h | h <;> rcases hR' with h' | h' <;> rw [h, h'] <;> norm_num
    have h2' : |Q - S| = 1 - Q * S := by
      rcases hQ' with h | h <;> rcases hS' with h' | h' <;> rw [h, h'] <;> norm_num
    rw [h1', h2']; linarith
  have hu : hℓ ((a, b) : ℤ × ℤ) = 1 := by
    simp only [hℓ]
    have e1 : |2 * a| = 2 * |a| := by rw [abs_mul]; norm_num
    have e2 : |2 * b| = 2 * |b| := by rw [abs_mul]; norm_num
    have hk : 2 * |a| + 2 * |b| = 2 := by rw [← e1, ← e2, h2a, h2b]; exact hsum_u
    linarith
  have hv : hℓ ((c, d) : ℤ × ℤ) = 1 := by
    simp only [hℓ]
    have e1 : |2 * c| = 2 * |c| := by rw [abs_mul]; norm_num
    have e2 : |2 * d| = 2 * |d| := by rw [abs_mul]; norm_num
    have hk : 2 * |c| + 2 * |d| = 2 := by rw [← e1, ← e2, h2c, h2d]; exact hsum_v
    linarith
  exact edgeF_eq_std_of hu hv (by simp only [fdet]; omega)

lemma edgeF_neg_left (u v : ℤ × ℤ) : edgeF (-u) v = edgeF u v := by
  ext x
  simp only [edgeF, Finset.mem_insert, Finset.mem_singleton, neg_neg]
  tauto

lemma edgeF_neg_right (u v : ℤ × ℤ) : edgeF u (-v) = edgeF u v := by
  ext x
  simp only [edgeF, Finset.mem_insert, Finset.mem_singleton, neg_neg]
  tauto

/-- **The tie classification at the other two sides of a triangle.** The flip across the side
`{u, u + v}` never ties the height unless that side is the standard edge. It is
`triH_eq_imp_std` applied to the basis `(u, u + v)`, whose tie condition is `hℓ (2u + v) = hℓ v`. -/
theorem triH_flip_left {u v : ℤ × ℤ} (hd : fdet u v = 1) (ht : triH u v = triH (u + v) u) :
    edgeF u (u + v) = stdEdge := by
  have hd' : fdet u (u + v) = 1 := by
    simp only [fdet, Prod.fst_add, Prod.snd_add] at hd ⊢; nlinarith
  refine triH_eq_imp_std hd' ?_
  simp only [triH] at ht ⊢
  have e1 : u + (u + v) = (u + v) + u := by abel
  have e2 : (u + v) + -u = v := by abel
  rw [e1, e2, hl_neg]
  linarith [ht]

/-- The flip across the side `{v, u + v}` never ties the height unless that side is the standard
edge. It is `triH_eq_imp_std` applied to the basis `(-v, u + v)`. -/
theorem triH_flip_right {u v : ℤ × ℤ} (hd : fdet u v = 1) (ht : triH u v = triH (u + v) v) :
    edgeF v (u + v) = stdEdge := by
  have hd' : fdet (-v) (u + v) = 1 := by
    simp only [fdet, Prod.fst_add, Prod.snd_add, Prod.fst_neg, Prod.snd_neg] at hd ⊢; nlinarith
  have key : triH (-v) (u + v) = triH (u + v) (- -v) := by
    simp only [triH] at ht ⊢
    have e1 : -v + (u + v) = u := by abel
    have e2 : (u + v) + - -v = (u + v) + v := by abel
    simp only [e1, e2, hl_neg]
    linarith [ht]
  have := triH_eq_imp_std hd' key
  rw [edgeF_neg_left] at this
  exact this

/-- **The neighbourhood of the two standard triangles.** The triangle `{0, 1, ∞}` (`stdTri0`) and its
mirror `{0, -1, ∞}` (`stdTri1`) both have height four, and each of their three neighbours has height
four and six and six: exactly one neighbour is as low as the triangle itself, and none is lower. This
is the one place where the `ℓ¹` height of the Farey triangle graph has a tie, and it is the reason the
maximum-vertex criterion needs the tiebreak measured in the module docstring. -/
theorem stdTri_triH {u v : ℤ × ℤ} (hd : fdet u v = 1)
    (hT : triF u v = stdTri0 ∨ triF u v = stdTri1) :
    triH u v = 4 ∧
      ((triH v (-u) = 4 ∧ triH (u + v) u = 6 ∧ triH (u + v) v = 6) ∨
       (triH v (-u) = 6 ∧ triH (u + v) u = 4 ∧ triH (u + v) v = 6) ∨
       (triH v (-u) = 6 ∧ triH (u + v) u = 6 ∧ triH (u + v) v = 4)) := by
  rcases hT with hT | hT
  · have hu : u ∈ stdTri0 := by rw [← hT]; simp [triF]
    have hv : v ∈ stdTri0 := by rw [← hT]; simp [triF]
    simp only [stdTri0, triF, E1, E2, Finset.mem_insert, Finset.mem_singleton] at hu hv
    rcases hu with rfl | rfl | rfl | rfl | rfl | rfl <;>
      rcases hv with rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp only [fdet, triH, hℓ, Prod.fst_add, Prod.snd_add, Prod.fst_neg, Prod.snd_neg] at hd ⊢ <;>
      solve | omega | norm_num | (exfalso; exact absurd hT (by decide))
  · have hu : u ∈ stdTri1 := by rw [← hT]; simp [triF]
    have hv : v ∈ stdTri1 := by rw [← hT]; simp [triF]
    simp only [stdTri1, triF, E1, E2, Finset.mem_insert, Finset.mem_singleton] at hu hv
    rcases hu with rfl | rfl | rfl | rfl | rfl | rfl <;>
      rcases hv with rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp only [fdet, triH, hℓ, Prod.fst_add, Prod.snd_add, Prod.fst_neg, Prod.snd_neg] at hd ⊢ <;>
      solve | omega | norm_num | (exfalso; exact absurd hT (by decide))

/-!
### The letters, their moves, and the heights of the walk

The walk that decides "no nonempty reduced word dies" lives on the incidence graph of Farey edges and
triangles. Its letters are the six elements `S`, `S³` of the `ℤ/4` factor and `R`, `R²`, `R⁴`, `R⁵` of
the `ℤ/6` factor (`R = T * S`) — every element of the two factors outside the amalgamated
`⟨S²⟩ = {±1}` — and each letter acts on a matrix's two columns by an explicit local move `Letter.act`:
`S` swaps and negates the columns (a Farey edge is fixed, the triangle flips), an `R`-letter leaves the
triangle fixed and moves the edge. `Letter.col_mul_val` is the dictionary between the letters and the
matrix product, by direct computation on the six concrete matrices.

The heights are the ones the module docstring describes, in the doubled normalization that makes the
criterion's two hypotheses come out as exactly `no_two_flips_decrease` plus "no ties":

* `HT` — a triangle vertex: twice the `ℓ¹` sum of its three cusps, less the tiebreak `eps`;
* `EH` — an edge vertex: the mean of the heights of its two incident triangles (`EH_mean`).

Two facts make the maximum-vertex argument run, and with the tie classification of the previous
section both are now provable for every Farey basis rather than measured:

* `HT_ne` — the two triangles on a side never have equal height: the `2·(B - B')` in the comparison
  can only be offset by the tiebreak when `B = B'`, and by `triH_eq_imp_std` that is the standard edge,
  where `eps_add_of_std` says exactly one of the two triangles is `{0, 1, ∞}`;
* `at_most_one_down` — at most one side of a triangle has a lower opposite triangle, which is
  `no_two_flips_decrease` transcribed into these heights (`downA_iff`, `downB_iff`, `downC_iff`).

What the walk still needs: the prefix products along a word and the two comparisons between
consecutive vertices, the maximum-vertex argument, and the parity split (for an odd-length word the
cyclic walk has one degenerate step, and the two seam comparisons are the only finite work there).
-/


/-! ## Letters, their columns, and the local move facts -/

/-- The six letters of the amalgam `⟨S⟩ *_{⟨S²⟩} ⟨R⟩`, `R = T * S`: `S`, `S³` in the `ℤ/4` factor and
`R`, `R²`, `R⁴`, `R⁵` in the `ℤ/6` factor, i.e. every element of the two factors outside the
amalgamated `⟨S²⟩ = {±1}`. -/
inductive Letter
  | s1 | s3 | r1 | r2 | r4 | r5
  deriving DecidableEq, Repr

namespace Letter

/-- The matrix of a letter. -/
def val (a : Letter) : SL(2, ℤ) :=
  match a with
  | s1 => (S : SL(2, ℤ))
  | s3 => S ^ 3
  | r1 => T * S
  | r2 => (T * S) ^ 2
  | r4 => (T * S) ^ 4
  | r5 => (T * S) ^ 5

/-- Whether a letter lies in the `⟨S⟩` factor. -/
def isS : Letter → Bool
  | s1 => true
  | s3 => true
  | r1 => false
  | r2 => false
  | r4 => false
  | r5 => false

/-- The local move of a letter on the columns `(u, v)` of a matrix: the columns of `Y * a`. -/
def act (a : Letter) (u v : ℤ × ℤ) : (ℤ × ℤ) × (ℤ × ℤ) :=
  match a with
  | s1 => (v, -u)
  | s3 => (-v, u)
  | r1 => (u + v, -u)
  | r2 => (v, -(u + v))
  | r4 => (-(u + v), u)
  | r5 => (-v, u + v)

lemma mat_s3 : (!![0, -1; 1, 0] : Matrix (Fin 2) (Fin 2) ℤ) ^ 3 = !![0, 1; -1, 0] := by decide

lemma mat_r2 : (!![1, -1; 1, 0] : Matrix (Fin 2) (Fin 2) ℤ) ^ 2 = !![0, -1; 1, -1] := by decide

lemma mat_r4 : (!![1, -1; 1, 0] : Matrix (Fin 2) (Fin 2) ℤ) ^ 4 = !![-1, 1; -1, 0] := by decide

lemma mat_r5 : (!![1, -1; 1, 0] : Matrix (Fin 2) (Fin 2) ℤ) ^ 5 = !![0, 1; -1, 1] := by decide

/-- The columns of `Y * a` are the local move of `a` applied to the columns of `Y`. -/
theorem col_mul_val (a : Letter) (Y : SL(2, ℤ)) :
    col (Y * a.val) 0 = (a.act (col Y 0) (col Y 1)).1 ∧
      col (Y * a.val) 1 = (a.act (col Y 0) (col Y 1)).2 := by
  cases a <;> refine ⟨?_, ?_⟩ <;> ext <;>
    simp [val, act, col, coe_mul, mat_s3, mat_r2, mat_r4, mat_r5, Matrix.mul_apply,
      Fin.sum_univ_two] <;>
    ring

end Letter


/-! ## The heights of the two kinds of vertex -/

/-- The tiebreak flag: whether the triangle is the fundamental one `{0, 1, ∞}`. -/
def eps (u v : ℤ × ℤ) : ℤ := if triF u v = stdTri0 then 1 else 0

lemma eps_nonneg (u v : ℤ × ℤ) : 0 ≤ eps u v := by
  unfold eps; split <;> norm_num

lemma eps_le_one (u v : ℤ × ℤ) : eps u v ≤ 1 := by
  unfold eps; split <;> norm_num

/-- The height of a triangle vertex: twice the `ℓ¹` sum of its three cusps, less the tiebreak. -/
def HT (u v : ℤ × ℤ) : ℤ := 4 * triH u v - 2 * eps u v

/-- The height of an edge vertex: the mean of the heights of its two incident triangles. -/
def EH (u v : ℤ × ℤ) : ℤ := 2 * triH u v + 2 * triH v (-u) - eps u v - eps v (-u)

/-- `EH` is the mean of the two incident triangle heights, in the doubled normalization. -/
lemma EH_mean (u v : ℤ × ℤ) : HT u v + HT v (-u) = 2 * EH u v := by
  simp only [HT, EH]; ring

/-- The two triangles on a Farey side are never both the fundamental one and never both not: if the
side is standard, exactly one of them is `{0, 1, ∞}`. -/
lemma eps_add_of_std {u v : ℤ × ℤ} (hd : fdet u v = 1) (he : edgeF u v = stdEdge) :
    eps u v + eps v (-u) = 1 := by
  have hmem : ∀ w : ℤ × ℤ, w ∈ edgeF u v → w = E1 ∨ w = -E1 ∨ w = E2 ∨ w = -E2 := by
    intro w hw
    rw [he] at hw
    simpa [stdEdge, edgeF, E1, E2, Finset.mem_insert, Finset.mem_singleton] using hw
  have hu := hmem u (by simp [edgeF])
  have hv := hmem v (by simp [edgeF])
  simp only [fdet, Prod.fst_add, Prod.snd_add, Prod.fst_neg, Prod.snd_neg] at hd
  rcases hu with rfl | rfl | rfl | rfl <;> rcases hv with rfl | rfl | rfl | rfl <;>
    solve
      | (exfalso; simp only [fdet, E1, E2, Prod.fst_add, Prod.snd_add, Prod.fst_neg,
          Prod.snd_neg] at hd; norm_num at hd)
      | decide

/-- **No ties.** The two triangles on a Farey side have different heights: the tiebreak `eps` is
exactly the O(1) correction that separates the one tied pair. -/
theorem HT_ne {u v : ℤ × ℤ} (hd : fdet u v = 1) : HT u v ≠ HT v (-u) := by
  intro h
  have h2 : 2 * (triH u v - triH v (-u)) = eps u v - eps v (-u) := by
    simp only [HT] at h; linarith
  have hbounds : -1 ≤ eps u v - eps v (-u) := by
    have := eps_nonneg u v; have := eps_le_one v (-u); linarith
  have hbounds2 : eps u v - eps v (-u) ≤ 1 := by
    have := eps_le_one u v; have := eps_nonneg v (-u); linarith
  have hB : triH u v = triH v (-u) := by
    rcases lt_trichotomy (triH u v) (triH v (-u)) with hlt | heq | hgt
    · exfalso; nlinarith
    · exact heq
    · exfalso; nlinarith
  have hstd : edgeF u v = stdEdge := triH_eq_imp_std hd (by rw [hB])
  have hsum := eps_add_of_std hd hstd
  rw [hB] at h2
  have hzero : eps u v - eps v (-u) = 0 := by linarith
  omega

/-! ## At most one side of a triangle is lower -/

/-- The flip across the side `{u, v}` is lower than the triangle. -/
def downA (u v : ℤ × ℤ) : Prop := triH v (-u) < triH u v

/-- The flip across the side `{u, u + v}` is lower than the triangle. -/
def downB (u v : ℤ × ℤ) : Prop := triH (u + v) u < triH u v

/-- The flip across the side `{v, u + v}` is lower than the triangle. -/
def downC (u v : ℤ × ℤ) : Prop := triH (u + v) v < triH u v

/-- The three "the flip is lower" conditions, in the `ℓ¹` language of `no_two_flips_decrease`. -/
lemma downA_iff (u v : ℤ × ℤ) : downA u v ↔ hℓ (v - u) < hℓ (u + v) := by
  have h1 : triH v (-u) = hℓ u + hℓ v + hℓ (v - u) := by
    simp only [triH, sub_eq_add_neg, hl_neg]
    ring
  have h2 : triH u v = hℓ u + hℓ v + hℓ (u + v) := by simp only [triH]
  rw [downA, h1, h2]
  constructor <;> intro h <;> linarith

lemma downB_iff (u v : ℤ × ℤ) : downB u v ↔ hℓ (twoUaddV u v) < hℓ v := by
  have h1 : triH (u + v) u = hℓ (u + v) + hℓ u + hℓ (twoUaddV u v) := by
    simp only [triH, twoUaddV]
    congr 2
    ext <;> simp <;> ring
  have h2 : triH u v = hℓ (u + v) + hℓ u + hℓ v := by simp only [triH]; ring
  rw [downB, h1, h2]
  constructor <;> intro h <;> linarith

lemma downC_iff (u v : ℤ × ℤ) : downC u v ↔ hℓ (UaddTwoV u v) < hℓ u := by
  have h1 : triH (u + v) v = hℓ (u + v) + hℓ v + hℓ (UaddTwoV u v) := by
    simp only [triH, UaddTwoV]
    congr 2
    ext <;> simp <;> ring
  have h2 : triH u v = hℓ (u + v) + hℓ v + hℓ u := by simp only [triH]; ring
  rw [downC, h1, h2]
  constructor <;> intro h <;> linarith

/-- At most one of the three sides of a triangle has a lower opposite triangle: this is
`no_two_flips_decrease` in the height's own vocabulary, and it is what makes the maximum-vertex
argument run. -/
theorem at_most_one_down (u v : ℤ × ℤ) :
    ¬ (downA u v ∧ downB u v) ∧ ¬ (downA u v ∧ downC u v) ∧ ¬ (downB u v ∧ downC u v) := by
  have h := no_two_flips_decrease u v
  have eA := downA_iff u v
  have eB := downB_iff u v
  have eC := downC_iff u v
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨h1, h2⟩
    exact h.1 ⟨eA.mp h1, eB.mp h2⟩
  · rintro ⟨h1, h2⟩
    exact h.2.1 ⟨eA.mp h1, eC.mp h2⟩
  · rintro ⟨h1, h2⟩
    exact h.2.2 ⟨eB.mp h1, eC.mp h2⟩

/-!
### The three flips of a basis: their heights, and no ties at any side

The walk's comparisons are always between a triangle vertex and one of the three triangles adjacent to
it across a side — the *flips* `flA`, `flB`, `flC` of a Farey basis `(u, v)`, being the triangles on
the sides `{u, v}`, `{u, u + v}`, `{v, u + v}`. This section is that vocabulary:

* `triH_flipA/B/C` — the `ℓ¹` height of each flip, in terms of `hℓ` of `u`, `v` and `u ± v`;
* `downA_flip/B/C` — the condition "this flip is lower", which is `downA/downB/downC`, i.e. one of the
  three mutually exclusive alternatives of `no_two_flips_decrease`;
* `HT_flipA/B/C` and `HT_congr` — `HT` of a flip, with `HT` depending only on the triangle and its
  `ℓ¹` height, not on the basis it is read in;
* `HT_ne_flipB`, `HT_ne_flipC` — the other two sides have no tie either, both obtained from `HT_ne` by
  reading the same triangle in the basis `(u, u + v)` resp. `(-v, u + v)` (`triF_uv`, `triF_vu`,
  `triF_negneg` are those changes of basis).

With `HT_ne` for the side `{u, v}` itself, all three sides of every Farey triangle are now known to
have strictly unequal height from their opposite triangle, which is what the walk's step comparison
needs.
-/


/-! ## The three flips of a basis and the invariance of the heights -/

/-- The flip across the side `{u, v}`. -/
def flA (u v : ℤ × ℤ) : (ℤ × ℤ) × (ℤ × ℤ) := (v, -u)

/-- The flip across the side `{u, u + v}`. -/
def flB (u v : ℤ × ℤ) : (ℤ × ℤ) × (ℤ × ℤ) := (u, u + v)

/-- The flip across the side `{v, u + v}`. -/
def flC (u v : ℤ × ℤ) : (ℤ × ℤ) × (ℤ × ℤ) := (u + v, v)

lemma triH_flipA (u v) : triH (flA u v).1 (flA u v).2 = hℓ u + hℓ v + hℓ (v - u) := by
  simp only [flA, triH, hl_neg, sub_eq_add_neg]; ring

lemma triH_flipB (u v) : triH (flB u v).1 (flB u v).2 = hℓ u + hℓ (u + v) + hℓ (u + u + v) := by
  have e : u + (u + v) = u + u + v := by abel
  simp only [flB, triH, e]

lemma triH_flipC (u v) : triH (flC u v).1 (flC u v).2 = hℓ (u + v) + hℓ v + hℓ (u + v + v) := by
  have e : (u + v) + v = u + v + v := by abel
  simp only [flC, triH, e]

lemma downA_flip (u v) : downA u v ↔ triH (flA u v).1 (flA u v).2 < triH u v := by
  rw [downA, triH_flipA]
  simp only [triH, hl_neg, sub_eq_add_neg]
  constructor <;> intro h <;> linarith

lemma downB_flip (u v) : downB u v ↔ triH (flB u v).1 (flB u v).2 < triH u v := by
  have e1 : triH (flB u v).1 (flB u v).2 = triH u (u + v) := by simp only [flB]
  have h2 : triH u v = hℓ (u + v) + hℓ u + hℓ v := by simp only [triH]; ring
  have h3 : triH u (u + v) = hℓ u + hℓ (u + v) + hℓ (u + u + v) := triH_flipB u v
  rw [e1, downB, triH_comm u (u + v), h3, h2]

lemma downC_flip (u v) : downC u v ↔ triH (flC u v).1 (flC u v).2 < triH u v := by
  have e1 : triH (flC u v).1 (flC u v).2 = triH (u + v) v := by simp only [flC]
  have h2 : triH u v = hℓ (u + v) + hℓ v + hℓ u := by simp only [triH]; ring
  have h3 : triH (u + v) v = hℓ (u + v) + hℓ v + hℓ (u + v + v) := triH_flipC u v
  rw [e1, downC, h3, h2]

/-- `HT` of the `A`-flip is `HT v (-u)`. -/
lemma HT_flipA (u v) : HT (flA u v).1 (flA u v).2 = HT v (-u) := rfl

/-- `HT` of the `B`-flip, in the form `HT u (u + v)`. -/
lemma HT_flipB (u v) : HT (flB u v).1 (flB u v).2 = HT u (u + v) := by
  simp only [flB]

/-- `HT` of the `C`-flip. -/
lemma HT_flipC (u v) : HT (flC u v).1 (flC u v).2 = HT (u + v) v := by
  simp only [flC]

/-- `HT` depends only on the triangle and its `ℓ¹` height, not on the basis it is read in. -/
lemma HT_congr {x y x' y' : ℤ × ℤ} (h1 : triF x y = triF x' y') (h2 : triH x y = triH x' y') :
    HT x y = HT x' y' := by
  have : eps x y = eps x' y' := by simp only [eps, h1]
  simp only [HT, h1, h2, this]

lemma triF_uv (u v : ℤ × ℤ) : triF (u + v) (-u) = triF u v := by
  have e : u + v + -u = v := by abel
  simp only [triF, e, neg_neg]
  ext x
  simp only [Finset.mem_insert, Finset.mem_singleton]
  tauto

lemma triF_vu (u v : ℤ × ℤ) : triF (-v) (u + v) = triF u v := by
  have e : -v + (u + v) = u := by abel
  simp only [triF, e, neg_neg]
  ext x
  simp only [Finset.mem_insert, Finset.mem_singleton]
  tauto

lemma triF_negneg (u v : ℤ × ℤ) : triF (-u) (-v) = triF u v := by
  have e : -u + -v = -(u + v) := by abel
  simp only [triF, e, neg_neg]
  ext x
  simp only [Finset.mem_insert, Finset.mem_singleton]
  tauto

/-- The `B`-flip's height differs from the triangle's. -/
theorem HT_ne_flipB {u v : ℤ × ℤ} (hd : fdet u v = 1) : HT u (u + v) ≠ HT u v := by
  have hd' : fdet u (u + v) = 1 := by
    simp only [fdet, Prod.fst_add, Prod.snd_add] at hd ⊢; nlinarith
  have h := HT_ne hd'
  have e : HT (u + v) (-u) = HT u v := by
    refine HT_congr (triF_uv u v) ?_
    have hh : (u + v) + -u = v := by abel
    simp only [triH, hl_neg, hh]; ring
  rwa [e] at h

/-- The `C`-flip's height differs from the triangle's. -/
theorem HT_ne_flipC {u v : ℤ × ℤ} (hd : fdet u v = 1) : HT (u + v) v ≠ HT u v := by
  have hd' : fdet (-v) (u + v) = 1 := by
    simp only [fdet, Prod.fst_add, Prod.snd_add, Prod.fst_neg, Prod.snd_neg] at hd ⊢; nlinarith
  have h := HT_ne hd'
  have e1 : HT (-v) (u + v) = HT u v := by
    refine HT_congr (triF_vu u v) ?_
    have hh : -v + (u + v) = u := by abel
    simp only [triH, hl_neg, hh]; ring
  have e2 : HT (u + v) (- -v) = HT (u + v) v := by simp
  rw [e1, e2] at h
  exact fun hh => h hh.symm

/-!
### Prefix products, and the walk's vertices and heights

The walk of a reduced word is read off the columns of its prefix products. This section builds that
data for a word `l : List Letter`:

* `Y l j` — the product of the first `j` letters, with `Y_zero`, `Y_succ`, `Y_length`, and the two
  *cyclic* forms `Y_nxt` and `Y_prv`: stepping forward across the end of the word uses that the whole
  word's product is one, and stepping back to `prv` is the same statement read backwards;
* `nxt` and `prv` — the cyclic successor and predecessor of an index;
* `cols_nxt`, `cols_prv` — the one-step column dictionary: the columns after a step are the letter's
  move `Letter.act` applied to the columns before it, and likewise backwards. These are what turn every
  comparison between two vertices of the walk into a statement about a single letter's move, one of
  whose legs is a flip `flA`/`flB`/`flC`;
* `vtx`, `hgt` — the vertex of the walk at an index (an edge over an `⟨S⟩`-letter, a triangle over an
  `⟨R⟩`-letter) and its height.

What remains for the dictionary is the two comparisons at each index — the step (`HT_ne`,
`HT_ne_flipB`, `HT_ne_flipC`) and the turn (`EH_mean` and `at_most_one_down`) — the maximum-vertex
argument, and the parity split.
-/


/-! ## Prefix products along a word -/

/-- The product of the first `j` letters of a word. -/
def Y (l : List Letter) (j : ℕ) : SL(2, ℤ) := ((l.take j).map Letter.val).prod

lemma Y_zero (l : List Letter) : Y l 0 = 1 := by simp [Y]

lemma Y_succ {l : List Letter} {j : ℕ} (h : j < l.length) :
    Y l (j + 1) = Y l j * (l[j]).val := by
  have h1 : l.take (j + 1) = l.take j ++ [l[j]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem h]
    rfl
  simp only [Y, h1, List.map_append, List.map_cons, List.map_nil, List.prod_append,
    List.prod_singleton, List.prod_nil, mul_one]

lemma Y_length (l : List Letter) : Y l l.length = (l.map Letter.val).prod := by
  simp [Y]

/-- The cyclic successor of an index modulo `n`. -/
def nxt (n k : ℕ) : ℕ := (k + 1) % n

/-- The cyclic predecessor of an index modulo `n`. -/
def prv (n k : ℕ) : ℕ := (k + n - 1) % n

/-- **The one-step dictionary**: the prefix product after a letter is the prefix product before it,
times the letter. This holds cyclically too, the wrap using that the whole word's product is one. -/
lemma Y_nxt {l : List Letter} (hprod : (l.map Letter.val).prod = 1) {k : ℕ}
    (hk : k < l.length) :
    Y l (nxt l.length k) = Y l k * (l[k]).val := by
  have hn : 0 < l.length := lt_of_le_of_lt (Nat.zero_le k) hk
  rcases Nat.lt_or_ge (k + 1) l.length with h | h
  · rw [nxt, Nat.mod_eq_of_lt h]; exact Y_succ hk
  · have hkn : k + 1 = l.length := by omega
    have h1 : Y l k * (l[k]).val = Y l l.length := by
      rw [← hkn]; exact (Y_succ hk).symm
    rw [nxt, hkn, Nat.mod_self, Y_zero, h1, Y_length, hprod]

/-- The same one step backwards: the prefix product at `k` is the one at `prv` times the letter
there. -/
lemma Y_prv {l : List Letter} (hprod : (l.map Letter.val).prod = 1) {k : ℕ}
    (hk : k < l.length) (hprv : prv l.length k < l.length) :
    Y l k = Y l (prv l.length k) * (l[prv l.length k]).val := by
  have hn : 0 < l.length := lt_of_le_of_lt (Nat.zero_le k) hk
  have key : Y l k = Y l (prv l.length k + 1) := by
    rcases Nat.eq_zero_or_pos k with hk0 | hkpos
    · subst hk0
      have e : prv l.length 0 + 1 = l.length := by
        simp only [prv, Nat.zero_add]
        rw [Nat.mod_eq_of_lt (by omega)]
        omega
      rw [e, Y_length, hprod, Y_zero]
    · have e : prv l.length k + 1 = k := by
        simp only [prv]
        rw [show k + l.length - 1 = k - 1 + l.length by omega, Nat.add_mod_right,
          Nat.mod_eq_of_lt (by omega)]
        omega
      rw [e]
  rw [key, Y_succ hprv]


/-- The columns after a step are the letter's move applied to the columns before it. -/
lemma cols_nxt {l : List Letter} (hprod : (l.map Letter.val).prod = 1) {k : ℕ}
    (hk : k < l.length) :
    col (Y l (nxt l.length k)) 0 =
        ((l[k]).act (col (Y l k) 0) (col (Y l k) 1)).1 ∧
      col (Y l (nxt l.length k)) 1 =
        ((l[k]).act (col (Y l k) 0) (col (Y l k) 1)).2 := by
  rw [Y_nxt hprod hk]
  exact Letter.col_mul_val (l[k]) (Y l k)

/-- The columns before a step are the previous letter's move applied to the columns before that. -/
lemma cols_prv {l : List Letter} (hprod : (l.map Letter.val).prod = 1) {k : ℕ}
    (hk : k < l.length) (hprv : prv l.length k < l.length) :
    col (Y l k) 0 =
        ((l[prv l.length k]).act (col (Y l (prv l.length k)) 0)
          (col (Y l (prv l.length k)) 1)).1 ∧
      col (Y l k) 1 =
        ((l[prv l.length k]).act (col (Y l (prv l.length k)) 0)
          (col (Y l (prv l.length k)) 1)).2 := by
  rw [Y_prv hprod hk hprv]
  exact Letter.col_mul_val (l[prv l.length k]) (Y l (prv l.length k))

/-- The vertex of the walk at an index: an edge over an `⟨S⟩`-letter, a triangle over an
`⟨R⟩`-letter. -/
noncomputable def vtx (l : List Letter) (k : ℕ) (hk : k < l.length) : Finset (ℤ × ℤ) :=
  if (l[k]).isS then edgeF (col (Y l k) 0) (col (Y l k) 1)
  else triF (col (Y l k) 0) (col (Y l k) 1)

/-- The height of the walk at an index, read off the columns of the prefix product. -/
noncomputable def hgt (l : List Letter) (k : ℕ) (hk : k < l.length) : ℤ :=
  if (l[k]).isS then EH (col (Y l k) 0) (col (Y l k) 1)
  else HT (col (Y l k) 0) (col (Y l k) 1)

/-!
### The columns of a matrix are a basis, the flipped bases of a triangle, and height four

The walk's turn comparison at a triangle vertex asks whether one of the two neighbouring edges is
*lower*, and an edge's height is the mean of its two incident triangles — so the question becomes
whether the triangle opposite it across that side has strictly smaller height `HT`. Off the tied pair
that is exactly a strict decrease of the `ℓ¹` height, which `no_two_flips_decrease` controls; on the
tied pair the O(1) tiebreak can make `HT` smaller while `triH` is not. This section supplies the last
pieces of that bookkeeping:

* `fdet_cols` — the columns of a matrix in `SL(2, ℤ)` are a Farey basis;
* `triF_comm'`, `triF_u_negv`, `triF_r2`, `triF_r4` — the changes of basis a letter performs on a
  triangle, so that `HT` can be read off in whichever basis is convenient;
* `HT_act_r1/2/4/5` — an `⟨R⟩`-letter does not change the height of a triangle vertex, and `HT_negv` —
  the two bases of the flip across a side give the same height;
* `triH_ge_four` — every Farey triangle has `ℓ¹` height at least four (height three would need three
  cusps of `ℓ¹`-length one, and only two lines have length one), which is what rules out the second
  "tiebreak-lowered" side in that turn comparison.
-/


/-! ## The three flips turned by a letter, and the `ℓ¹` bounds at height four -/

section FlipLemmas

/-- The columns of a matrix in `SL(2, ℤ)` are a Farey basis. -/
lemma fdet_cols (X : SL(2, ℤ)) : fdet (col X 0) (col X 1) = 1 := by
  have h := det_entries X
  simp only [fdet, col] at *
  rw [mul_comm (X.1 1 0) (X.1 0 1)]
  exact h

variable (u v : ℤ × ℤ)

lemma triF_u_negv : triF u (-v) = triF v (-u) := by
  simp only [triF, neg_neg]
  rw [show v + -u = -(u + -v) by abel]
  simp only [neg_neg]
  ext x
  simp only [Finset.mem_insert, Finset.mem_singleton]
  tauto

lemma triF_comm' : triF u v = triF v u := by
  simp only [triF]
  have e : v + u = u + v := by abel
  rw [e]
  ext x
  simp only [Finset.mem_insert, Finset.mem_singleton]
  tauto

lemma triF_r2 : triF v (-(u + v)) = triF u v := by
  have e : v + -(u + v) = -u := by abel
  simp only [triF, e, neg_neg]
  ext x
  simp only [Finset.mem_insert, Finset.mem_singleton]
  tauto

lemma triF_r4 : triF (-(u + v)) u = triF u v := by
  have e : -(u + v) + u = -v := by abel
  simp only [triF, e, neg_neg]
  ext x
  simp only [Finset.mem_insert, Finset.mem_singleton]
  tauto

end FlipLemmas

section Invariance

variable (u v : ℤ × ℤ)

lemma HT_act_r1 : HT (Letter.act Letter.r1 u v).1 (Letter.act Letter.r1 u v).2 = HT u v := by
  refine HT_congr (triF_uv u v) ?_
  have hh : (u + v) + -u = v := by abel
  simp only [Letter.act, triH, hl_neg, hh]; ring

lemma HT_act_r2 : HT (Letter.act Letter.r2 u v).1 (Letter.act Letter.r2 u v).2 = HT u v := by
  refine HT_congr (triF_r2 u v) ?_
  have hh : v + -(u + v) = -u := by abel
  simp only [Letter.act, triH, hl_neg, hh]; ring

lemma HT_act_r4 : HT (Letter.act Letter.r4 u v).1 (Letter.act Letter.r4 u v).2 = HT u v := by
  refine HT_congr (triF_r4 u v) ?_
  have hh : -(u + v) + u = -v := by abel
  simp only [Letter.act, triH, hl_neg, hh]; ring

lemma HT_act_r5 : HT (Letter.act Letter.r5 u v).1 (Letter.act Letter.r5 u v).2 = HT u v := by
  refine HT_congr (triF_vu u v) ?_
  have hh : -v + (u + v) = u := by abel
  simp only [Letter.act, triH, hl_neg, hh]; ring

/-- `HT (-v) u = HT v (-u)`: the two bases of the same triangle. -/
lemma HT_negv (u v : ℤ × ℤ) : HT (-v) u = HT v (-u) := by
  refine HT_congr ?_ ?_
  · rw [triF_comm' (-v) u, triF_u_negv u v]
  · have hh : -v + u = -(v + -u) := by abel
    simp only [triH, hl_neg, hh]

end Invariance

section Bounds

/-- Every Farey triangle has `ℓ¹` height at least four: height three would need all three cusps of
`ℓ¹`-length one, and there are only two lines of length one. -/
theorem triH_ge_four {u v : ℤ × ℤ} (hd : fdet u v = 1) : 4 ≤ triH u v := by
  have hu0 : u ≠ 0 := by rintro rfl; simp [fdet] at hd
  have hv0 : v ≠ 0 := by rintro rfl; simp [fdet] at hd
  have huv0 : u + v ≠ 0 := by
    rintro h0
    have e : u = -v := by rw [eq_neg_iff_add_eq_zero]; simpa using h0
    rw [e] at hd
    simp only [fdet, Prod.fst_neg, Prod.snd_neg] at hd
    ring_nf at hd
    omega
  have h1 := hl_pos hu0
  have h2 := hl_pos hv0
  have h3 := hl_pos huv0
  rcases lt_or_ge (triH u v) 4 with h | h
  · exfalso
    simp only [triH] at h
    have hA : hℓ u = 1 := by omega
    have hB : hℓ v = 1 := by omega
    have hC : hℓ (u + v) = 1 := by omega
    rcases eq_pm_of_hl_one hA with rfl | rfl | rfl | rfl <;>
      rcases eq_pm_of_hl_one hB with rfl | rfl | rfl | rfl <;>
      simp only [fdet, E1, E2, hℓ, Prod.fst_add, Prod.snd_add, Prod.fst_neg, Prod.snd_neg] at hd hC <;>
      ((norm_num at hd) <;> (norm_num at hC))
  · exact h

end Bounds

/-!
### At most one side of a triangle is lower in the tiebroken height

The walk's turn comparison at a triangle vertex asks whether both of the two edges adjacent to it are
*lower*, and an edge's height is the mean of its two incident triangles — so the question is whether
two of the triangle's flips are lower than the triangle itself. `no_two_flips_decrease` answers that
for the `ℓ¹` height; the tiebreak can upset it, because on the tied pair `HT` is lower while `triH` is
not. This section closes that gap:

* `HT_lt_decrease` — if `HT` of another triangle is lower, then either its `ℓ¹` height is strictly
  lower, or the two `ℓ¹` heights are equal and the tiebreak is what decided it (`eps u v = 0`,
  `eps x y = 1`);
* `triF_of_eps_one`, `triH_of_eps_one` — `eps = 1` means the triangle is `{0, 1, ∞}`, whose `ℓ¹`
  height is four;
* `fdet_flipA/B/C` — the three flips of a basis are bases;
* `triF_flA_ne_flB`, `triF_flA_ne_flC` — the flips across two sides of a triangle are two *distinct*
  triangles (so two of them cannot both be `{0, 1, ∞}`);
* `not_both_AB`, `not_both_AC` — **at most one** of the flips across the side `{u, v}` and the side
  `{u, u + v}` (resp. `{v, u + v}`) is lower in `HT`. The only way this can fail off the `ℓ¹` case is
  the tiebreak lowering one flip, which pins the triangle's `ℓ¹` height at four and then
  `triH_ge_four` rules out the second;
* `HT_other_r1`, `HT_other_r2` and `HT_act_r1'/r2'/r4'/r5'` — the "other" triangle of an edge after an
  `⟨R⟩`-move, in the unfolded form the per-letter comparison needs.
-/


section Compare

variable (u v : ℤ × ℤ)

/-- The tiebreak can only lower `HT` against a non-decrease of `ℓ¹` height by making the triangle the
fundamental one and the other not. -/
lemma HT_lt_decrease {x y : ℤ × ℤ} (h : HT x y < HT u v) :
    triH x y < triH u v ∨
      (triH x y = triH u v ∧ eps u v = 0 ∧ eps x y = 1) := by
  by_cases hB : triH x y < triH u v
  · exact Or.inl hB
  · right
    have h2 : 2 * (triH x y - triH u v) < eps x y - eps u v := by
      simp only [HT] at h; linarith
    have hge : triH u v ≤ triH x y := le_of_not_gt hB
    have hpos : 0 < eps x y - eps u v := by nlinarith
    have hx1 := eps_le_one x y
    have hx0 := eps_nonneg x y
    have hu1 := eps_le_one u v
    have hu0 := eps_nonneg u v
    have hex : eps x y = 1 := by omega
    have heu : eps u v = 0 := by omega
    have heq : triH x y = triH u v := by nlinarith
    exact ⟨heq, heu, hex⟩

/-- `eps = 1` means the triangle is the fundamental one. -/
lemma triF_of_eps_one {x y : ℤ × ℤ} (h : eps x y = 1) : triF x y = stdTri0 := by
  by_contra hc
  have h0 : eps x y = 0 := by simp only [eps, if_neg hc]
  omega

/-- `eps = 1` pins the `ℓ¹` height at four: the triangle is the fundamental one. -/
lemma triH_of_eps_one {x y : ℤ × ℤ} (hd : fdet x y = 1) (h : eps x y = 1) : triH x y = 4 := by
  have hT : triF x y = stdTri0 := by
    by_contra hc
    have h0 : eps x y = 0 := by simp only [eps, if_neg hc]
    omega
  exact (stdTri_triH hd (Or.inl hT)).1

lemma fdet_flipA (hd : fdet u v = 1) : fdet (flA u v).1 (flA u v).2 = 1 := by
  simp only [fdet] at hd ⊢
  simp only [flA, Prod.fst_neg, Prod.snd_neg]
  nlinarith

lemma fdet_flipB (hd : fdet u v = 1) : fdet (flB u v).1 (flB u v).2 = 1 := by
  simp only [fdet] at hd ⊢
  simp only [flB, Prod.fst_add, Prod.snd_add]
  nlinarith

lemma fdet_flipC (hd : fdet u v = 1) : fdet (flC u v).1 (flC u v).2 = 1 := by
  simp only [fdet] at hd ⊢
  simp only [flC, Prod.fst_add, Prod.snd_add]
  nlinarith

/-- The flips across two sides of a triangle are two distinct triangles. -/
lemma triF_flA_ne_flB (hd : fdet u v = 1) :
    triF (flA u v).1 (flA u v).2 ≠ triF (flB u v).1 (flB u v).2 := by
  intro h
  have hmem : (u + v) ∈ triF (flA u v).1 (flA u v).2 := by
    rw [h]
    simp only [flB, triF, Finset.mem_insert, Finset.mem_singleton]
    tauto
  simp only [flA, triF, Finset.mem_insert, Finset.mem_singleton] at hmem
  have hd' : u.1 * v.2 - u.2 * v.1 = 1 := hd
  rcases hmem with h1 | h1 | h1 | h1 | h1 | h1 <;>
    (rw [Prod.ext_iff] at h1
     obtain ⟨e1, e2⟩ := h1
     simp only [Prod.fst_add, Prod.snd_add, Prod.fst_neg, Prod.snd_neg, Prod.fst_sub,
       Prod.snd_sub] at e1 e2
     solve
       | (have k1 : u.1 = 0 := by omega
          have k2 : u.2 = 0 := by omega
          rw [k1, k2] at hd'
          norm_num at hd')
       | (have k1 : v.1 = 0 := by omega
          have k2 : v.2 = 0 := by omega
          rw [k1, k2] at hd'
          norm_num at hd')
       | (nlinarith [hd', e1, e2])
       | (have k1 : u.1 = -2 * v.1 := by omega
          have k2 : u.2 = -2 * v.2 := by omega
          rw [k1, k2] at hd'
          ring_nf at hd'
          omega)
       | (have k1 : v.1 = -2 * u.1 := by omega
          have k2 : v.2 = -2 * u.2 := by omega
          rw [k1, k2] at hd'
          ring_nf at hd'
          omega))

lemma triF_flA_ne_flC (hd : fdet u v = 1) :
    triF (flA u v).1 (flA u v).2 ≠ triF (flC u v).1 (flC u v).2 := by
  intro h
  have hmem : (u + v) ∈ triF (flA u v).1 (flA u v).2 := by
    rw [h]
    simp only [flC, triF, Finset.mem_insert, Finset.mem_singleton]
    tauto
  simp only [flA, triF, Finset.mem_insert, Finset.mem_singleton] at hmem
  have hd' : u.1 * v.2 - u.2 * v.1 = 1 := hd
  rcases hmem with h1 | h1 | h1 | h1 | h1 | h1 <;>
    (rw [Prod.ext_iff] at h1
     obtain ⟨e1, e2⟩ := h1
     simp only [Prod.fst_add, Prod.snd_add, Prod.fst_neg, Prod.snd_neg, Prod.fst_sub,
       Prod.snd_sub] at e1 e2
     solve
       | (have k1 : u.1 = 0 := by omega
          have k2 : u.2 = 0 := by omega
          rw [k1, k2] at hd'
          norm_num at hd')
       | (have k1 : v.1 = 0 := by omega
          have k2 : v.2 = 0 := by omega
          rw [k1, k2] at hd'
          norm_num at hd')
       | (nlinarith [hd', e1, e2])
       | (have k1 : u.1 = -2 * v.1 := by omega
          have k2 : u.2 = -2 * v.2 := by omega
          rw [k1, k2] at hd'
          ring_nf at hd'
          omega)
       | (have k1 : v.1 = -2 * u.1 := by omega
          have k2 : v.2 = -2 * u.2 := by omega
          rw [k1, k2] at hd'
          ring_nf at hd'
          omega))

/-- At most one of the flips across the side `{u, v}` and the side `{u, u + v}` is lower. -/
theorem not_both_AB (hd : fdet u v = 1)
    (hA : HT (flA u v).1 (flA u v).2 < HT u v)
    (hB : HT (flB u v).1 (flB u v).2 < HT u v) : False := by
  have hA' := HT_lt_decrease u v hA
  have hB' := HT_lt_decrease u v hB
  rcases hA' with h1 | ⟨h1, -, he1⟩
  · rcases hB' with h2 | ⟨h2, -, he2⟩
    · exact absurd ⟨(downA_flip u v).mpr h1, (downB_flip u v).mpr h2⟩ (at_most_one_down u v).1
    · -- `B` is tiebreak-lowered: its triangle is the fundamental one, so `triH = 4`,
      -- and the `A` decrease would put `triH (flA) < 4`.
      have h4 : triH u v = 4 := by
        rw [← h2]; exact triH_of_eps_one (fdet_flipB u v hd) he2
      have := triH_ge_four (fdet_flipA u v hd)
      linarith
  · -- `A` is tiebreak-lowered
    rcases hB' with h2 | ⟨h2, -, he2⟩
    · have h4 : triH u v = 4 := by
        rw [← h1]; exact triH_of_eps_one (fdet_flipA u v hd) he1
      have := triH_ge_four (fdet_flipB u v hd)
      linarith
    · exact absurd (by rw [triF_of_eps_one he1, triF_of_eps_one he2])
        (triF_flA_ne_flB u v hd)

/-- At most one of the flips across the side `{u, v}` and the side `{v, u + v}` is lower. -/
theorem not_both_AC (hd : fdet u v = 1)
    (hA : HT (flA u v).1 (flA u v).2 < HT u v)
    (hC : HT (flC u v).1 (flC u v).2 < HT u v) : False := by
  have hA' := HT_lt_decrease u v hA
  have hC' := HT_lt_decrease u v hC
  rcases hA' with h1 | ⟨h1, -, he1⟩
  · rcases hC' with h2 | ⟨h2, -, he2⟩
    · exact absurd ⟨(downA_flip u v).mpr h1, (downC_flip u v).mpr h2⟩ (at_most_one_down u v).2.1
    · have h4 : triH u v = 4 := by
        rw [← h2]; exact triH_of_eps_one (fdet_flipC u v hd) he2
      have := triH_ge_four (fdet_flipA u v hd)
      linarith
  · rcases hC' with h2 | ⟨h2, -, he2⟩
    · have h4 : triH u v = 4 := by
        rw [← h1]; exact triH_of_eps_one (fdet_flipA u v hd) he1
      have := triH_ge_four (fdet_flipC u v hd)
      linarith
    · exact absurd (by rw [triF_of_eps_one he1, triF_of_eps_one he2])
        (triF_flA_ne_flC u v hd)

end Compare


section PerLetter

variable (u v : ℤ × ℤ)

/-- The "other" triangle of the edge after the move `r1` is the flip `B`. -/
lemma HT_other_r1 : HT (-u) (-(u + v)) = HT u (u + v) := by
  refine HT_congr (triF_negneg u (u + v)) ?_
  have hh : -u + -(u + v) = -(u + u + v) := by abel
  have e : u + (u + v) = u + u + v := by abel
  simp only [triH, hl_neg, hh, e]

/-- The "other" triangle of the edge after the move `r2` is the flip `C`. -/
lemma HT_other_r2 : HT (-(u + v)) (-v) = HT (u + v) v := by
  refine HT_congr (triF_negneg (u + v) v) ?_
  have hh : -(u + v) + -v = -(u + v + v) := by abel
  have e : (u + v) + v = u + v + v := by abel
  simp only [triH, hl_neg, hh, e]

/-- The height of the flip `A` is what an `⟨S⟩`-letter moves a triangle to. -/
lemma HT_act_s1 : HT (Letter.act Letter.s1 u v).1 (Letter.act Letter.s1 u v).2 = HT v (-u) := rfl

lemma HT_act_s3 : HT (Letter.act Letter.s3 u v).1 (Letter.act Letter.s3 u v).2 = HT v (-u) := by
  simp only [Letter.act]
  exact HT_negv u v

lemma HT_act_r1' : HT (u + v) (-u) = HT u v := HT_act_r1 u v
lemma HT_act_r2' : HT v (-(u + v)) = HT u v := HT_act_r2 u v
lemma HT_act_r4' : HT (-(u + v)) u = HT u v := HT_act_r4 u v
lemma HT_act_r5' : HT (-v) (u + v) = HT u v := HT_act_r5 u v


end PerLetter

/-!
### The two comparisons of the walk: the step and the turn

Both hypotheses of the maximum-vertex criterion are now theorems about the walk's own heights, for
every letter, with the basis `(u, v)` arbitrary:

* `EH_act_s1`, `EH_act_s3` — an `⟨S⟩`-letter does not change the height of an *edge* vertex: the two
  columns swap and negate, so it is the same edge and its two incident triangles are read in the other
  order (the mirror of `HT_act_r*`, which says an `⟨R⟩`-letter does not change a *triangle's* height);
* `step_ne` — **the step**: consecutive vertices of the walk have different heights. Over an
  `⟨S⟩`-letter the vertex is the edge `(u, v)` and the next is the flip `A`, and `EH` is the mean of
  `HT` of the two, so the two differ unless the two are equal, which is `HT_ne`; over an `⟨R⟩`-letter
  the vertex is the triangle and the next is the edge of `(u+v, -u)` and its kind, and the same
  arithmetic gives `HT_ne_flipB` / `HT_ne_flipC`;
* `turn_not_both` — **the turn**: the two neighbours of a vertex are never both lower. At an edge this
  is immediate (`EH` is the mean of the two triangles, so at most one of them is below it); at a
  triangle it is exactly "at most one flip is lower", i.e. `not_both_AB` / `not_both_AC`.

What remains for the dictionary is only indexing: read these two facts at the walk's own indices (the
one-step dictionary `cols_nxt`, `cols_prv` already does the transport), run the maximum-vertex
argument, and split by the parity of the word's length.
-/


/-- An `⟨S⟩`-letter does not change the height of an edge vertex: the two columns swap and negate, so
the edge is the same edge and its two incident triangles are read in the other order. -/
theorem EH_act_s1 (u v : ℤ × ℤ) : EH v (-u) = EH u v := by
  have e1 : -u + -v = -(u + v) := by abel
  have h1 : triH (-u) (-v) = triH u v := by
    simp only [triH, hl_neg, e1]
  have h2 : eps (-u) (-v) = eps u v := by simp only [eps, triF_negneg u v]
  simp only [EH, h1, h2]
  try ring

/-- The other `⟨S⟩`-letter, likewise: `S³` is `S` composed with `S² = -1`. -/
theorem EH_act_s3 (u v : ℤ × ℤ) : EH (-v) u = EH u v := by
  have e1 : -v + u = -(v + -u) := by abel
  have h1 : triH (-v) u = triH v (-u) := by
    simp only [triH, hl_neg, e1]
  have h2 : eps (-v) u = eps v (-u) := by
    have e : triF (-v) u = triF v (-u) := by
      rw [triF_comm' (-v) u]
      exact triF_u_negv u v
    simp only [eps, e]
  simp only [EH, h1, h2, neg_neg]
  try ring

/-- In the letters' own unfolded form: the height of the edge at `act s1` is the height of the edge
at `(u, v)`. -/
theorem EH_act_s1' (u v : ℤ × ℤ) :
    EH (Letter.act Letter.s1 u v).1 (Letter.act Letter.s1 u v).2 = EH u v := by
  simpa only [Letter.act] using EH_act_s1 u v

theorem EH_act_s3' (u v : ℤ × ℤ) :
    EH (Letter.act Letter.s3 u v).1 (Letter.act Letter.s3 u v).2 = EH u v := by
  simpa only [Letter.act] using EH_act_s3 u v


/-- **The step.** Consecutive vertices of the walk have different heights, for every letter: the edge
over an `⟨S⟩`-letter against the triangle it moves to (a flip), and the triangle over an `⟨R⟩`-letter
against the edge it moves to (the mean of the triangle and a flip). -/
theorem step_ne {u v : ℤ × ℤ} (hd : fdet u v = 1) (a : Letter) :
    (if a.isS then EH u v else HT u v) ≠
      (if a.isS then HT (a.act u v).1 (a.act u v).2
        else EH (a.act u v).1 (a.act u v).2) := by
  cases a <;> simp only [Letter.isS, Bool.false_eq_true, reduceIte, Letter.act]
  · intro h
    have hm := EH_mean u v
    rw [h] at hm
    exact HT_ne hd (by linarith)
  · intro h
    rw [HT_negv u v] at h
    have hm := EH_mean u v
    rw [h] at hm
    exact HT_ne hd (by linarith)
  · intro h
    have hm := EH_mean (u + v) (-u)
    rw [HT_act_r1', HT_other_r1 u v, ← h] at hm
    exact HT_ne_flipB hd (by linarith)
  · intro h
    have hm := EH_mean v (-(u + v))
    rw [HT_act_r2', HT_other_r2 u v, ← h] at hm
    exact HT_ne_flipC hd (by linarith)
  · intro h
    have hm := EH_mean (-(u + v)) u
    rw [HT_act_r4'] at hm
    simp only [neg_neg] at hm
    rw [← h] at hm
    exact HT_ne_flipB hd (by linarith)
  · intro h
    have hm := EH_mean (-v) (u + v)
    rw [HT_act_r5'] at hm
    simp only [neg_neg] at hm
    rw [← h] at hm
    exact HT_ne_flipC hd (by linarith)

/-- **The turn.** The two neighbours of a vertex of the walk are never both lower: an edge's height is
the mean of its two incident triangles, and at most one side of a triangle is lower
(`not_both_AB`, `not_both_AC`). -/
theorem turn_not_both {u v : ℤ × ℤ} (hd : fdet u v = 1) (a : Letter) :
    ¬ ((if a.isS then HT u v else EH u v) < (if a.isS then EH u v else HT u v) ∧
        (if a.isS then HT (a.act u v).1 (a.act u v).2
          else EH (a.act u v).1 (a.act u v).2) < (if a.isS then EH u v else HT u v)) := by
  cases a <;> simp only [Letter.isS, Bool.false_eq_true, reduceIte, Letter.act]
  · rintro ⟨h1, h2⟩
    have hm := EH_mean u v
    linarith
  · rintro ⟨h1, h2⟩
    rw [HT_negv u v] at h2
    have hm := EH_mean u v
    linarith
  · rintro ⟨h1, h2⟩
    have hm := EH_mean u v
    have hm2 := EH_mean (u + v) (-u)
    rw [HT_act_r1', HT_other_r1 u v] at hm2
    exact not_both_AB u v hd (by rw [HT_flipA]; linarith) (by rw [HT_flipB]; linarith)
  · rintro ⟨h1, h2⟩
    have hm := EH_mean u v
    have hm2 := EH_mean v (-(u + v))
    rw [HT_act_r2', HT_other_r2 u v] at hm2
    exact not_both_AC u v hd (by rw [HT_flipA]; linarith) (by rw [HT_flipC]; linarith)
  · rintro ⟨h1, h2⟩
    have hm := EH_mean u v
    have hm2 := EH_mean (-(u + v)) u
    rw [HT_act_r4'] at hm2
    simp only [neg_neg] at hm2
    exact not_both_AB u v hd (by rw [HT_flipA]; linarith) (by rw [HT_flipB]; linarith)
  · rintro ⟨h1, h2⟩
    have hm := EH_mean u v
    have hm2 := EH_mean (-v) (u + v)
    rw [HT_act_r5'] at hm2
    simp only [neg_neg] at hm2
    exact not_both_AC u v hd (by rw [HT_flipA]; linarith) (by rw [HT_flipC]; linarith)

/-!
### The walk's height as a function of the index

The maximum-vertex argument wants a height that is a plain function of the index, with no index
proofs in the way. This section provides exactly that: `U l k` and `V l k` are the two columns of the
prefix product `Y l k`, `H l k` is the walk's height there (junk off the word), `H_eq` reads it off,
and `H_next` expresses the height one step on in the basis at `k` — the letter's move applied to that
basis, via `cols_nxt`. What remains for the dictionary is the same statement one step *back*
(`H_prev`, which needs the letter case analysis plus `cols_prv`), the maximum-vertex argument itself,
and the parity split.
-/


/-- The first column of the prefix product. -/
noncomputable def U (l : List Letter) (k : ℕ) : ℤ × ℤ := col (Y l k) 0

/-- The second column of the prefix product. -/
noncomputable def V (l : List Letter) (k : ℕ) : ℤ × ℤ := col (Y l k) 1

/-- The height of the walk at an index, as a total function of the index (junk off the word). -/
noncomputable def H (l : List Letter) (k : ℕ) : ℤ :=
  match l[k]? with
  | none => 0
  | some a =>
    if a.isS then EH (col (Y l k) 0) (col (Y l k) 1) else HT (col (Y l k) 0) (col (Y l k) 1)

lemma H_eq {l : List Letter} {k : ℕ} (hk : k < l.length) :
    H l k = if (l[k]).isS then EH (U l k) (V l k) else HT (U l k) (V l k) := by
  simp only [H, U, V, List.getElem?_eq_getElem hk]

/-- The height one step on, expressed in the basis at `k`: the letter's move applied to it. -/
lemma H_next {l : List Letter} (hprod : (l.map Letter.val).prod = 1) {k : ℕ}
    (hk : k < l.length) (hnx : nxt l.length k < l.length)
    (hty : (l[nxt l.length k]).isS ≠ (l[k]).isS) :
    H l (nxt l.length k) =
      (if (l[k]).isS then
          HT ((l[k]).act (U l k) (V l k)).1 ((l[k]).act (U l k) (V l k)).2
        else EH ((l[k]).act (U l k) (V l k)).1 ((l[k]).act (U l k) (V l k)).2) := by
  rw [H_eq hnx]
  simp only [U, V]
  obtain ⟨c1, c2⟩ := cols_nxt hprod hk
  rw [c1, c2]
  cases h1 : (l[k]).isS <;> cases h2 : (l[nxt l.length k]).isS <;>
    simp only [h1, h2, Bool.false_eq_true, Bool.true_eq_false, reduceIte] at hty ⊢
  all_goals first | rfl | exact absurd rfl hty

/-!
### The walk's height without index proofs

Case analysis on the letter at an index kept tripping over the index proof carried by `l[k]`, so this
section isolates that: `L l k` is the letter at `k` as a *total* function (junk off the word), `Hk l k`
is the walk's height at `k` built from `L`, and `L_eq`/`L_isS` relate the two on the word. Also here:
`bool_eq_not` (two unequal booleans are mutual negations, which is how "the next letter is the other
type" becomes an equation), `fdet_UV` (the prefix product's columns are a Farey basis), `HT_ne_EH`
(`HT` and `EH` at one basis always differ), the two generic invariance lemmas `HT_act_of_false` and
`EH_act_of_true` (an `⟨R⟩`-letter leaves triangle heights, an `⟨S⟩`-letter edge heights, decided by the
letter's type rather than by six case splits), and `Hk_next` — the height one step on, in the basis at
`k`.

Still open: the same one step back (`Hk_prev`; its direct proof exceeds the heartbeat limit because
`simp` unfolds `Y` at the `prv` index, so it needs the invariance facts restated in `U`/`V` form), the
maximum-vertex argument, and the parity split.
-/


/-- The letter at an index, total (junk off the word), so case analysis never carries a proof. -/
def L (l : List Letter) (k : ℕ) : Letter := l.getD k Letter.s1

lemma L_eq {l : List Letter} {k : ℕ} (hk : k < l.length) : L l k = l[k] := by
  simp only [L, List.getD, List.getElem?_eq_getElem hk]; rfl

lemma L_isS {l : List Letter} {k : ℕ} (hk : k < l.length) : (L l k).isS = (l[k]).isS := by
  rw [L_eq hk]

/-- Two unequal booleans are mutual negations. -/
lemma bool_eq_not {a b : Bool} (h : a ≠ b) : a = !b := by
  cases a <;> cases b <;> simp_all

/-- The walk's height at an index, total. -/
noncomputable def Hk (l : List Letter) (k : ℕ) : ℤ :=
  if (L l k).isS then EH (U l k) (V l k) else HT (U l k) (V l k)

lemma Hk_eq {l : List Letter} {k : ℕ} (hk : k < l.length) :
    Hk l k = if (l[k]).isS then EH (U l k) (V l k) else HT (U l k) (V l k) := by
  simp only [Hk, L_isS hk]

/-- The columns of a prefix product form a Farey basis. -/
lemma fdet_UV (l : List Letter) (k : ℕ) : fdet (U l k) (V l k) = 1 := fdet_cols (Y l k)

/-- `HT` and `EH` at the same Farey basis always differ. -/
lemma HT_ne_EH {u v : ℤ × ℤ} (hd : fdet u v = 1) : HT u v ≠ EH u v := by
  intro h
  have hm := EH_mean u v
  rw [h] at hm
  have hne := HT_ne hd
  exact hne (by linarith)

/-- An `⟨R⟩`-letter does not change a triangle's height. -/
lemma HT_act_of_false (b : Letter) (hb : b.isS = false) (u v : ℤ × ℤ) :
    HT (b.act u v).1 (b.act u v).2 = HT u v := by
  match b with
  | .s1 => simp [Letter.isS] at hb
  | .s3 => simp [Letter.isS] at hb
  | .r1 => exact HT_act_r1 u v
  | .r2 => exact HT_act_r2 u v
  | .r4 => exact HT_act_r4 u v
  | .r5 => exact HT_act_r5 u v

/-- An `⟨S⟩`-letter does not change an edge's height. -/
lemma EH_act_of_true (b : Letter) (hb : b.isS = true) (u v : ℤ × ℤ) :
    EH (b.act u v).1 (b.act u v).2 = EH u v := by
  match b with
  | .s1 => exact EH_act_s1' u v
  | .s3 => exact EH_act_s3' u v
  | .r1 => simp [Letter.isS] at hb
  | .r2 => simp [Letter.isS] at hb
  | .r4 => simp [Letter.isS] at hb
  | .r5 => simp [Letter.isS] at hb

set_option maxHeartbeats 1000000 in
/-- The height one step on, in the basis at `k`. -/
lemma Hk_next {l : List Letter} (hprod : (l.map Letter.val).prod = 1) {k : ℕ}
    (hk : k < l.length) (hnx : nxt l.length k < l.length)
    (hty : (L l (nxt l.length k)).isS ≠ (L l k).isS) :
    Hk l (nxt l.length k) =
      (if (L l k).isS then
          HT ((L l k).act (U l k) (V l k)).1 ((L l k).act (U l k) (V l k)).2
        else EH ((L l k).act (U l k) (V l k)).1 ((L l k).act (U l k) (V l k)).2) := by
  simp only [Hk]
  rw [bool_eq_not hty]
  obtain ⟨c1, c2⟩ := cols_nxt hprod hk
  rw [← L_eq hk] at c1 c2
  cases hb : (L l k).isS <;>
    simp only [hb, Bool.not_false, Bool.not_true, Bool.false_eq_true, reduceIte] at ⊢ <;>
    (simp only [U, V] at c1 c2 ⊢) <;> rw [c1, c2]

/-!
### The walk closes: no cyclically alternating reduced word has product one

This is the dictionary the module docstring calls the surviving unit of lean-categories#89, in the form
the walk decides it. `Hk_prev` is the height one step back in the basis at `k` (the case analysis of
the previous letter, with the invariance facts of the previous section applied by the letter's type),
`step_Hk` and `turn_Hk` are the two comparisons of the walk, `no_cycle` is the maximum-vertex argument
(on the highest vertex both neighbours are lower, which the turn forbids), and `no_reduced_word_dies`
is the statement itself: **a nonempty cyclically alternating word of the six letters cannot have
product one.**

What that does *not* yet cover is a cyclically alternating hypothesis on a word that is only linearly
alternating — i.e. an odd-length word, where the hypothesis `hcyc` above fails and the walk has one
degenerate step at the seam. That parity split, and the bridge from `PresentedGroup sl2zRelators` to
these letters, are what remain before `Sl2zPresentationComplete` follows.
-/


set_option maxHeartbeats 1000000 in
/-- The height one step back, in the basis at `k`. -/
lemma Hk_prev {l : List Letter} (hprod : (l.map Letter.val).prod = 1) {k : ℕ}
    (hk : k < l.length) (hpv : prv l.length k < l.length)
    (hty : (L l (prv l.length k)).isS ≠ (L l k).isS) :
    Hk l (prv l.length k) =
      (if (L l k).isS then HT (U l k) (V l k) else EH (U l k) (V l k)) := by
  have hL : Hk l (prv l.length k) =
      if (L l (prv l.length k)).isS then EH (U l (prv l.length k)) (V l (prv l.length k))
      else HT (U l (prv l.length k)) (V l (prv l.length k)) := rfl
  rw [hL, bool_eq_not hty]
  obtain ⟨c1, c2⟩ := cols_prv hprod hk hpv
  rw [← L_eq hpv] at c1 c2
  have hc1 : U l k = ((L l (prv l.length k)).act (U l (prv l.length k)) (V l (prv l.length k))).1 :=
    c1
  have hc2 : V l k = ((L l (prv l.length k)).act (U l (prv l.length k)) (V l (prv l.length k))).2 :=
    c2
  cases hb : (L l k).isS
  · have hb' : (L l (prv l.length k)).isS = true := by rw [bool_eq_not hty, hb]; rfl
    simp only [hb, hb', Bool.not_true, Bool.false_eq_true, reduceIte] at ⊢
    rw [hc1, hc2]
    exact (EH_act_of_true _ hb' _ _).symm
  · have hb' : (L l (prv l.length k)).isS = false := by rw [bool_eq_not hty, hb]; rfl
    simp only [hb, hb', Bool.not_false, Bool.false_eq_true, reduceIte] at ⊢
    rw [hc1, hc2]
    exact (HT_act_of_false _ hb' _ _).symm

set_option maxHeartbeats 1000000 in
/-- The step, for the walk's height. -/
lemma step_Hk {l : List Letter} (hprod : (l.map Letter.val).prod = 1) {k : ℕ}
    (hk : k < l.length) (hnx : nxt l.length k < l.length)
    (hty : (L l (nxt l.length k)).isS ≠ (L l k).isS) :
    Hk l (nxt l.length k) ≠ Hk l k := by
  rw [Hk_next hprod hk hnx hty]
  have hk' : Hk l k = (if (L l k).isS then EH (U l k) (V l k) else HT (U l k) (V l k)) := rfl
  rw [hk']
  exact (step_ne (fdet_UV l k) (L l k)).symm

set_option maxHeartbeats 1000000 in
/-- The turn, for the walk's height. -/
lemma turn_Hk {l : List Letter} (hprod : (l.map Letter.val).prod = 1) {k : ℕ}
    (hk : k < l.length) (hnx : nxt l.length k < l.length) (hpv : prv l.length k < l.length)
    (htyn : (L l (nxt l.length k)).isS ≠ (L l k).isS)
    (htyp : (L l (prv l.length k)).isS ≠ (L l k).isS) :
    ¬ (Hk l (prv l.length k) < Hk l k ∧ Hk l (nxt l.length k) < Hk l k) := by
  rw [Hk_prev hprod hk hpv htyp, Hk_next hprod hk hnx htyn]
  have hk' : Hk l k = (if (L l k).isS then EH (U l k) (V l k) else HT (U l k) (V l k)) := rfl
  rw [hk']
  exact turn_not_both (fdet_UV l k) (L l k)


set_option maxHeartbeats 1000000 in
/-- **The walk.** A cyclically alternating word of letters with product one cannot exist: on the
highest vertex of the walk the two neighbours are lower, which is what the turn forbids. -/
theorem no_cycle {l : List Letter} (hne : l ≠ [])
    (hprod : (l.map Letter.val).prod = 1)
    (htyn : ∀ (k : ℕ) (_ : k < l.length), (L l (nxt l.length k)).isS ≠ (L l k).isS)
    (htyp : ∀ (k : ℕ) (_ : k < l.length), (L l (prv l.length k)).isS ≠ (L l k).isS) : False := by
  have hn : 0 < l.length := List.length_pos_iff.mpr hne
  obtain ⟨k₀, hk₀mem, hmax⟩ :=
    Finset.exists_max_image (Finset.range l.length) (Hk l) ⟨0, Finset.mem_range.mpr hn⟩
  have hk₀ : k₀ < l.length := Finset.mem_range.mp hk₀mem
  have hnx : nxt l.length k₀ < l.length := by
    simp only [nxt]; exact Nat.mod_lt _ hn
  have hpv : prv l.length k₀ < l.length := by
    simp only [prv]; exact Nat.mod_lt _ (by omega)
  have h1 : Hk l (nxt l.length k₀) ≤ Hk l k₀ := hmax _ (Finset.mem_range.mpr hnx)
  have h2 : Hk l (prv l.length k₀) ≤ Hk l k₀ := hmax _ (Finset.mem_range.mpr hpv)
  have e1 : Hk l (nxt l.length k₀) ≠ Hk l k₀ := step_Hk hprod hk₀ hnx (htyn k₀ hk₀)
  have e2 : Hk l (prv l.length k₀) ≠ Hk l k₀ := by
    rw [Hk_prev hprod hk₀ hpv (htyp k₀ hk₀)]
    have hk' : Hk l k₀ =
        (if (L l k₀).isS then EH (U l k₀) (V l k₀) else HT (U l k₀) (V l k₀)) := rfl
    rw [hk']
    cases hb : (L l k₀).isS <;> simp only [Bool.false_eq_true, reduceIte]
    · exact fun hh => HT_ne_EH (fdet_UV l k₀) hh.symm
    · exact fun hh => HT_ne_EH (fdet_UV l k₀) hh
  exact turn_Hk hprod hk₀ hnx hpv (htyn k₀ hk₀) (htyp k₀ hk₀)
    ⟨lt_of_le_of_ne h2 e2, lt_of_le_of_ne h1 e1⟩

set_option maxHeartbeats 1000000 in
/-- **The dictionary.** No nonempty cyclically alternating word of the six letters has product one:
the walk of its prefixes is a closed reduced walk in the incidence graph of Farey edges and triangles,
whose height has no local maximum. -/
theorem no_reduced_word_dies (l : List Letter) (hne : l ≠ [])
    (hprod : (l.map Letter.val).prod = 1)
    (halt : ∀ (i : ℕ), 0 < i → i < l.length → (L l i).isS ≠ (L l (i - 1)).isS)
    (hcyc : (L l 0).isS ≠ (L l (l.length - 1)).isS) : False := by
  have hn : 0 < l.length := List.length_pos_iff.mpr hne
  have htyn : ∀ (k : ℕ) (hk : k < l.length), (L l (nxt l.length k)).isS ≠ (L l k).isS := by
    intro k hk
    rcases Nat.lt_or_ge (k + 1) l.length with h | h
    · rw [nxt, Nat.mod_eq_of_lt h]
      simpa using halt (k + 1) (by omega) (by omega)
    · have hkn : k + 1 = l.length := by omega
      rw [nxt, hkn, Nat.mod_self]
      have hk' : k = l.length - 1 := by omega
      rw [hk']
      exact hcyc
  have htyp : ∀ (k : ℕ) (hk : k < l.length), (L l (prv l.length k)).isS ≠ (L l k).isS := by
    intro k hk
    rcases Nat.eq_zero_or_pos k with hk0 | hkpos
    · subst hk0
      have e : prv l.length 0 = l.length - 1 := by
        simp only [prv]
        rw [Nat.zero_add, Nat.mod_eq_of_lt (by omega)]
      rw [e]
      exact hcyc.symm
    · have e : prv l.length k = k - 1 := by
        simp only [prv]
        rw [show k + l.length - 1 = k - 1 + l.length by omega, Nat.add_mod_right,
          Nat.mod_eq_of_lt (by omega)]
      rw [e]
      exact (halt k hkpos hk).symm
  exact no_cycle hne hprod htyn htyp

/-!
### The two ends of the walk

For the parity split the odd-length case needs the two ends of the walk pinned down: at index `0` the
basis is the identity, so `Hk_zero` (`Hk l 0` is `EH` or `HT` of `(E1, E2)`), and those two numbers are
`EH_std = 15` and `HT_std = 14` — which is what makes the first step of the walk strictly go up at one
end (`16` resp. `19` there). The mirror statement at the last index needs the columns of the inverse
of the last letter, which is the part still open.
-/


/-- The height at the start of the walk: the basis there is the identity. -/
lemma Hk_zero (l : List Letter) : Hk l 0 = if (L l 0).isS then EH E1 E2 else HT E1 E2 := by
  have h : Hk l 0 = if (L l 0).isS then EH (U l 0) (V l 0) else HT (U l 0) (V l 0) := rfl
  rw [h]
  have hU : U l 0 = E1 := by simp [U, Y_zero, col, E1]
  have hV : V l 0 = E2 := by simp [V, Y_zero, col, E2]
  rw [hU, hV]

/-- The two heights at the two ends, numerically. -/
lemma EH_std : EH E1 E2 = 15 := by decide
lemma HT_std : HT E1 E2 = 14 := by decide

/-!
### The two seam comparisons at the near end of the walk

For the odd-length case of the parity split the walk's ends must be pinned down. At index `0` the
basis is the identity (`Hk_zero`, `EH_std = 15`, `HT_std = 14`); this section adds index `1`:

* `Hk_one` — the height at index `1`, in terms of the first letter's matrix;
* `Hk_zero_lt_one` — **the first step goes strictly up**: `15` against `16` for the two `⟨S⟩`-letters,
  and `14` against `19`, `19`, `19`, `23` for the four `⟨R⟩`-letters (six `decide`s);
* `Hk_last` — the last step comes back to the *same* height when both ends carry the same type, which
  is the odd-length seam: the columns at index `0` are the last letter's move applied to the columns at
  `n - 1`, so the invariance lemmas identify the two heights.

So neither end can be the highest vertex of an odd-length walk, and the maximum-vertex argument applies
at an interior index — which is the remaining step.
-/


/-- The height at index `1` of the walk, in terms of the first letter's matrix. -/
lemma Hk_one {l : List Letter} (hne : l ≠ []) (hty : (L l 1).isS ≠ (L l 0).isS) :
    Hk l 1 = (if (L l 0).isS then HT (col ((L l 0).val) 0) (col ((L l 0).val) 1)
      else EH (col ((L l 0).val) 0) (col ((L l 0).val) 1)) := by
  have hY1 : Y l 1 = (L l 0).val := by
    rw [Y_succ (by have := List.length_pos_iff.mpr hne; omega : 0 < l.length), Y_zero, one_mul]
    congr 1
    exact (L_eq (by have := List.length_pos_iff.mpr hne; omega : 0 < l.length)).symm
  have hH1 : Hk l 1 = if (L l 1).isS then EH (U l 1) (V l 1) else HT (U l 1) (V l 1) := rfl
  rw [hH1, bool_eq_not hty]
  have hU : U l 1 = col ((L l 0).val) 0 := by simp only [U, hY1]
  have hV : V l 1 = col ((L l 0).val) 1 := by simp only [V, hY1]
  rw [hU, hV]
  cases hb : (L l 0).isS <;>
    simp only [hb, Bool.not_true, Bool.not_false, Bool.false_eq_true, reduceIte]

set_option maxHeartbeats 1000000 in
/-- The first step of the walk goes strictly up: `15` against `16` for the two `⟨S⟩`-letters, and `14`
against `19`, `19`, `19`, `23` for the four `⟨R⟩`-letters. -/
theorem Hk_zero_lt_one {l : List Letter} (hne : l ≠ []) (hty : (L l 1).isS ≠ (L l 0).isS) :
    Hk l 0 < Hk l 1 := by
  rw [Hk_zero, Hk_one hne hty]
  rcases hc : (L l 0) with a1 | a2 | a3 | a4 | a5 | a6 <;>
    simp only [hc, Letter.isS, Letter.val, reduceIte, EH_std, HT_std] <;>
    decide

set_option maxHeartbeats 1000000 in
/-- The last step comes back to the same height when both ends carry the same type — the odd-length
case of the parity split. -/
theorem Hk_last {l : List Letter} (hprod : (l.map Letter.val).prod = 1) (hne : l ≠ [])
    (hty : (L l 0).isS = (L l (l.length - 1)).isS) :
    Hk l (l.length - 1) = Hk l 0 := by
  have hn : 0 < l.length := List.length_pos_iff.mpr hne
  have hk : l.length - 1 < l.length := by omega
  have hz : nxt l.length (l.length - 1) = 0 := by
    simp only [nxt]; rw [Nat.sub_add_cancel hn, Nat.mod_self]
  have hLk : Hk l (l.length - 1) =
      (if (L l (l.length - 1)).isS then EH (U l (l.length - 1)) (V l (l.length - 1))
        else HT (U l (l.length - 1)) (V l (l.length - 1))) := rfl
  rw [hLk, Hk_zero, hty]
  obtain ⟨c1, c2⟩ := cols_nxt hprod hk
  rw [← L_eq hk] at c1 c2
  rw [hz] at c1 c2
  have hc1 : U l 0 = ((L l (l.length - 1)).act (U l (l.length - 1)) (V l (l.length - 1))).1 := c1
  have hc2 : V l 0 = ((L l (l.length - 1)).act (U l (l.length - 1)) (V l (l.length - 1))).2 := c2
  have hU0 : U l 0 = E1 := by simp [U, Y_zero, col, E1]
  have hV0 : V l 0 = E2 := by simp [V, Y_zero, col, E2]
  rw [hU0] at hc1
  rw [hV0] at hc2
  cases hb : (L l (l.length - 1)).isS
  · simp only [hb, Bool.false_eq_true, reduceIte]
    rw [hc1, hc2]
    exact (HT_act_of_false _ hb _ _).symm
  · simp only [hb, reduceIte]
    rw [hc1, hc2]
    exact (EH_act_of_true _ hb _ _).symm

/-!
### No nonempty reduced word dies

This closes the statement the module docstring names as the surviving half of lean-categories#89: **a
nonempty word of the six letters `S`, `S³`, `R`, `R²`, `R⁴`, `R⁵` whose consecutive letters lie in
different factors has product one only if it is empty.**

* `isS_parity` — in a linearly alternating word the type of a letter depends only on the parity of its
  index;
* `no_die_odd` — the odd-length case: by the two seam comparisons (`Hk_zero_lt_one`, `Hk_last`) neither
  end of the walk is its highest vertex, so the highest vertex is interior, where both neighbours are
  lower — which `turn_Hk` forbids;
* `no_die` — both parities: for even length the word is also cyclically alternating and the closed
  reduced walk of `no_reduced_word_dies` applies.

This is the second stage of `sl2zToGroup_injective`; the first stage — that a shortest word for an
element is such a word, or empty, or a single base entry — is `reduced_aux` in the bridge below.
-/


/-- In a linearly alternating word the type of a letter depends only on the parity of its index. -/
theorem isS_parity {l : List Letter}
    (halt : ∀ (i : ℕ), 0 < i → i < l.length → (L l i).isS ≠ (L l (i - 1)).isS) :
    ∀ (i : ℕ), i < l.length →
      (L l i).isS = if i % 2 = 0 then (L l 0).isS else !(L l 0).isS := by
  intro i
  induction i using Nat.strong_induction_on with
  | _ i ih =>
    intro hi
    match i with
    | 0 => simp
    | 1 =>
      have h : (L l 1).isS = !(L l 0).isS := bool_eq_not (halt 1 (by omega) (by omega))
      rw [h]
      simp
    | i + 2 =>
      have e1 : i + 2 - 1 = i + 1 := by omega
      have hstep : (L l (i + 2)).isS = (L l i).isS := by
        rw [bool_eq_not (halt (i + 2) (by omega) (by omega)), e1,
          bool_eq_not (halt (i + 1) (by omega) (by omega)), show i + 1 - 1 = i from by omega,
          Bool.not_not]
      rw [hstep, ih i (by omega) (by omega)]
      congr 1
      rw [Nat.add_mod]
      norm_num

set_option maxHeartbeats 1000000 in
/-- **The odd-length case of the walk.** A nonempty linearly alternating word of odd length cannot have
product one: by the two seam comparisons neither end of the walk is its highest vertex, so the highest
vertex is interior, where both neighbours are lower — which the turn forbids. -/
theorem no_die_odd {l : List Letter} (hne : l ≠ [])
    (hodd : ∃ m, l.length = 2 * m + 1) (hbig : 1 < l.length)
    (hprod : (l.map Letter.val).prod = 1)
    (halt : ∀ (i : ℕ), 0 < i → i < l.length → (L l i).isS ≠ (L l (i - 1)).isS) : False := by
  have hn : 0 < l.length := List.length_pos_iff.mpr hne
  -- the two ends carry the same type
  have hsame : (L l 0).isS = (L l (l.length - 1)).isS := by
    obtain ⟨m, hm⟩ := hodd
    have hel : l.length - 1 = 2 * m := by omega
    have hl := isS_parity halt (l.length - 1) (by omega)
    rw [hel, Nat.mod_eq_zero_of_dvd ⟨m, by ring⟩] at hl
    rw [hel]
    exact hl.symm
  obtain ⟨k₀, hk₀mem, hmax⟩ :=
    Finset.exists_max_image (Finset.range l.length) (Hk l) ⟨0, Finset.mem_range.mpr hn⟩
  have hk₀ : k₀ < l.length := Finset.mem_range.mp hk₀mem
  -- the first step goes up, so `0` is not the highest index
  have hstep1 : Hk l 0 < Hk l 1 := by
    refine Hk_zero_lt_one hne ?_
    have h1n : (L l 1).isS = !(L l 0).isS := bool_eq_not (halt 1 (by omega) (by omega))
    rw [h1n]
    exact fun hh => absurd hh (by simp)
  have hmax1 : Hk l 1 ≤ Hk l k₀ := hmax _ (Finset.mem_range.mpr hbig)
  have hpos : 0 < k₀ := by
    rcases Nat.eq_zero_or_pos k₀ with h | h
    · subst h; omega
    · exact h
  -- the last step returns to the first height, so `l.length - 1` is not the highest index either
  have hlast : Hk l (l.length - 1) = Hk l 0 := Hk_last hprod hne hsame
  have hlt : k₀ + 1 < l.length := by
    rcases Nat.lt_or_ge (k₀ + 1) l.length with h | h
    · exact h
    · exfalso
      have hk₀l : k₀ + 1 = l.length := by omega
      have he : Hk l k₀ = Hk l (l.length - 1) := by
        rw [show l.length - 1 = k₀ from by omega]
      rw [he, hlast] at hmax1
      omega
  -- so the highest index is interior, where the turn forbids both neighbours being lower
  have hnx : nxt l.length k₀ < l.length := by
    simp only [nxt]; rw [Nat.mod_eq_of_lt hlt]; omega
  have hpv : prv l.length k₀ < l.length := by
    simp only [prv]; exact Nat.mod_lt _ hn
  have htyn : (L l (nxt l.length k₀)).isS ≠ (L l k₀).isS := by
    rw [show nxt l.length k₀ = k₀ + 1 from by simp only [nxt]; exact Nat.mod_eq_of_lt hlt]
    exact halt (k₀ + 1) (by omega) (by omega)
  have htyp : (L l (prv l.length k₀)).isS ≠ (L l k₀).isS := by
    rw [show prv l.length k₀ = k₀ - 1 from by
      simp only [prv]
      rw [show k₀ + l.length - 1 = k₀ - 1 + l.length by omega, Nat.add_mod_right,
        Nat.mod_eq_of_lt (by omega)]]
    exact (halt k₀ hpos hk₀).symm
  have h1 : Hk l (nxt l.length k₀) ≤ Hk l k₀ := hmax _ (Finset.mem_range.mpr hnx)
  have h2 : Hk l (prv l.length k₀) ≤ Hk l k₀ := hmax _ (Finset.mem_range.mpr hpv)
  have e1 : Hk l (nxt l.length k₀) ≠ Hk l k₀ := step_Hk hprod hk₀ hnx htyn
  have e2 : Hk l (prv l.length k₀) ≠ Hk l k₀ := by
    rw [Hk_prev hprod hk₀ hpv htyp]
    have hk' : Hk l k₀ =
        (if (L l k₀).isS then EH (U l k₀) (V l k₀) else HT (U l k₀) (V l k₀)) := rfl
    rw [hk']
    cases hb : (L l k₀).isS <;> simp only [Bool.false_eq_true, reduceIte]
    · exact fun hh => HT_ne_EH (fdet_UV l k₀) hh.symm
    · exact fun hh => HT_ne_EH (fdet_UV l k₀) hh
  exact turn_Hk hprod hk₀ hnx hpv htyn htyp
    ⟨lt_of_le_of_ne h2 e2, lt_of_le_of_ne h1 e1⟩


/-- No letter is the identity. -/
theorem val_ne_one (a : Letter) : a.val ≠ 1 := by
  cases a <;> decide

set_option maxHeartbeats 1000000 in
/-- **No nonempty reduced word dies.** A nonempty word of the six letters `S`, `S³`, `R`, `R²`, `R⁴`,
`R⁵` whose consecutive letters lie in different factors has product one only if it is empty. The
even-length case is the closed reduced walk of `no_reduced_word_dies`; the odd-length case
`no_die_odd` is the same walk with its two ends pinned down. -/
theorem no_die {l : List Letter} (hne : l ≠ [])
    (hprod : (l.map Letter.val).prod = 1)
    (halt : ∀ (i : ℕ), 0 < i → i < l.length → (L l i).isS ≠ (L l (i - 1)).isS) : False := by
  have hn : 0 < l.length := List.length_pos_iff.mpr hne
  rcases Nat.even_or_odd l.length with ⟨m, hm⟩ | ⟨m, hm⟩
  · -- even length: the word is also cyclically alternating
    refine no_reduced_word_dies l hne hprod halt ?_
    have hmpos : 0 < m := by omega
    have hodd : l.length - 1 = 2 * (m - 1) + 1 := by omega
    have hpar := isS_parity halt (l.length - 1) (by omega)
    rw [hodd] at hpar
    have h1 : (2 * (m - 1)) % 2 = 0 := Nat.mod_eq_zero_of_dvd ⟨m - 1, by ring⟩
    have h2 : (2 * (m - 1) + 1) % 2 = 1 := by
      rw [Nat.add_mod, h1, Nat.zero_add]
    rw [h2] at hpar
    rw [ite_eq_right (by omega : ¬ ((1 : ℕ) = 0))] at hpar
    rw [hodd, hpar]
    cases (L l 0).isS <;> simp
  · rcases Nat.eq_zero_or_pos m with hm0 | hmpos
    · -- a single letter
      have hl1 : l.length = 1 := by omega
      obtain ⟨a, rfl⟩ : ∃ a, l = [a] := by
        match l with
        | [] => simp at hl1
        | [b] => exact ⟨b, rfl⟩
        | b :: c :: t => simp at hl1
      simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one] at hprod
      exact val_ne_one a hprod
    · refine no_die_odd hne ⟨m, hm⟩ ?_ hprod halt
      rw [hm]
      omega

/-!
### The bridge, I: words over the two factors

The last step to `Sl2zPresentationComplete` is the glue from the presented group. Working in the
amalgam presentation `⟨S, R | S⁴, R³S⁻²⟩` (`sl2zAmalgamRelators`, reached from the issue's presentation
by `sl2zAmalgamEquiv`), this section sets up the dictionary:

* `sGen`, `rGen` — the two generators, with `sGen_pow_four`, `rGen_cube` and `rGen_pow_six` (the third
  from the first two: `(R³)² = (S²)² = S⁴`);
* `WP` — the element of the presented group read off a word over `(factor, exponent)` pairs (`false` is
  the `⟨S⟩` factor, `true` the `⟨R⟩` one), and `WS` the same word read in `SL(2, ℤ)`;
* `phiSL` — the map `S ↦ S`, `R ↦ T * S` (the composite of the issue's `sl2zToGroup` with
  `sl2zOfAmalgam`), and `phiSL_WP` — **the dictionary**: `phiSL (WP w) = WS w`, so a word's two readings
  agree. With `phiSL_s`/`phiSL_r` giving `phiSL` on the powers of each generator.

The three pieces of `sl2zToGroup_injective` are `WP_surjective` (every element is a word),
`reduced_aux` (a shortest word is alternating with no base entries, from the local rewritings
`WP_zero_head_false/true`, `WP_merge_false/true`, `WP_base_false/true`, `WP_absorb_s/r`), and `no_die`
(such a word cannot have product one).
-/


/-- The two generators of the amalgam presentation: `S` and `R = T * S`. -/
abbrev sGen : PresentedGroup sl2zAmalgamRelators := PresentedGroup.of (0 : Fin 2)

abbrev rGen : PresentedGroup sl2zAmalgamRelators := PresentedGroup.of (1 : Fin 2)

lemma sGen_pow_four : (sGen : PresentedGroup sl2zAmalgamRelators) ^ 4 = 1 := amalgamS_pow_four

lemma rGen_cube : (rGen : PresentedGroup sl2zAmalgamRelators) ^ 3 = sGen ^ 2 := amalgamR_cube

lemma rGen_pow_six : (rGen : PresentedGroup sl2zAmalgamRelators) ^ 6 = 1 := by
  rw [show (6 : ℕ) = 3 * 2 from rfl, pow_mul, rGen_cube, ← pow_mul,
    show (2 : ℕ) * 2 = 4 from rfl, sGen_pow_four]

/-- The element of the amalgam presentation read off a word over `(factor, exponent)`: `false` is the
`⟨S⟩` factor, `true` the `⟨R⟩` one. -/
def WP (w : List (Bool × ℤ)) : PresentedGroup sl2zAmalgamRelators :=
  (w.map (fun p => (if p.1 then rGen else sGen) ^ p.2)).prod

/-- The same word read in `SL(2, ℤ)`. -/
def WS (w : List (Bool × ℤ)) : SL(2, ℤ) :=
  (w.map (fun p => (if p.1 then (T * S : SL(2, ℤ)) ^ p.2 else (S : SL(2, ℤ)) ^ p.2))).prod

/-- The map from the amalgam presentation to `SL(2, ℤ)`: `S ↦ S`, `R ↦ T * S`. -/
def phiSL : PresentedGroup sl2zAmalgamRelators →* SL(2, ℤ) :=
  sl2zToGroup.comp sl2zOfAmalgam

lemma phiSL_s (n : ℤ) : phiSL (sGen ^ n) = (S : SL(2, ℤ)) ^ n := by
  have h : phiSL sGen = (S : SL(2, ℤ)) := by
    simp [phiSL, sGen, sl2zOfAmalgam_of, sl2zGenValOrig_zero, sl2zToGroup_of, sl2zGenVal]
  rw [← h, map_zpow]

lemma phiSL_r (n : ℤ) : phiSL (rGen ^ n) = (T * S : SL(2, ℤ)) ^ n := by
  have h : phiSL rGen = (T * S : SL(2, ℤ)) := by
    simp [phiSL, rGen, sl2zOfAmalgam_of, sl2zGenValOrig_one, sl2zToGroup_of, sl2zGenVal, map_mul]
  rw [← h, map_zpow]

/-- The dictionary between the two readings of a word. -/
lemma phiSL_WP (w : List (Bool × ℤ)) : phiSL (WP w) = WS w := by
  simp only [WP, WS, List.map_map]
  rw [map_list_prod, List.map_map]
  congr 1
  apply List.map_congr_left
  intro p _
  by_cases hp : p.1 <;> simp [hp, phiSL_r, phiSL_s]

/-!
### The bridge, II: words, and the subgroup they sweep out

* `WP_nil`, `WP_cons`, `WP_append` — `WP` is a list product, so it is multiplicative under
  concatenation;
* `WP_map_rev_neg` — reversing a word and negating its exponents inverts its value, which closes
  `WPsub` under inverses;
* `WP_surjective` — **every** element of the amalgam presentation is `WP w` for some word.

With this the remaining task is exactly the normal-form problem: a word `w` with `phiSL (WP w) = 1`
must be shortened, preserving its value, until it is either empty or an alternating word of the six
letters — at which point `no_die` applies.
-/

@[simp] lemma WP_nil : WP ([] : List (Bool × ℤ)) = 1 := by simp [WP]

@[simp] lemma WP_cons (p : Bool × ℤ) (w : List (Bool × ℤ)) :
    WP (p :: w) = (if p.1 then rGen else sGen) ^ p.2 * WP w := by
  simp [WP]

lemma WP_append (a b : List (Bool × ℤ)) : WP (a ++ b) = WP a * WP b := by
  simp [WP, List.map_append, List.prod_append]

/-- Reversing a word and negating its exponents inverts its value. -/
lemma WP_map_rev_neg (w : List (Bool × ℤ)) :
    WP ((w.reverse).map (fun p => (p.1, -p.2))) = (WP w)⁻¹ := by
  induction w with
  | nil => simp
  | cons p t ih =>
    simp only [List.reverse_cons, List.map_append, WP_append, ih, List.map_cons, List.map_nil,
      WP_cons, WP_nil, mul_one, _root_.mul_inv_rev, zpow_neg]

/-- The subgroup of the amalgam presentation swept out by words over the two factors. -/
def WPsub : Subgroup (PresentedGroup sl2zAmalgamRelators) where
  carrier := {q | ∃ w : List (Bool × ℤ), WP w = q}
  mul_mem' := by
    rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    exact ⟨a ++ b, WP_append a b⟩
  one_mem' := ⟨[], WP_nil⟩
  inv_mem' := by
    rintro _ ⟨a, rfl⟩
    exact ⟨(a.reverse).map (fun p => (p.1, -p.2)), WP_map_rev_neg a⟩

lemma sGen_mem_WPsub : sGen ∈ WPsub :=
  ⟨[(false, 1)], by simp [WP_cons]⟩

lemma rGen_mem_WPsub : rGen ∈ WPsub :=
  ⟨[(true, 1)], by simp [WP_cons]⟩

/-- **Surjectivity of `WP`.** Every element of the amalgam presentation is a word over the two
factors: the words form a subgroup containing both generators, and those generate. -/
theorem WP_surjective (q : PresentedGroup sl2zAmalgamRelators) :
    ∃ w : List (Bool × ℤ), WP w = q := by
  have hle :
      Subgroup.closure (Set.range (PresentedGroup.of (rels := sl2zAmalgamRelators))) ≤ WPsub := by
    rw [Subgroup.closure_le]
    rintro x ⟨i, rfl⟩
    fin_cases i
    · exact sGen_mem_WPsub
    · exact rGen_mem_WPsub
  rw [PresentedGroup.closure_range_of] at hle
  exact hle (Subgroup.mem_top q)

/-!
### The bridge, III: minimal words and the six letters

The remaining half of the bridge is a normal-form argument, run as a minimal-counterexample proof
rather than as a rewriting algorithm:

* `gp`, `period`, `modp`, `modw` — the generator of an entry's factor and the reduction of an exponent
  into the factor's period (`S⁴ = R⁶ = 1`, `zpow_eq_zpow_emod'`), applied entrywise by `modw`, which
  does not change the word's value (`WP_modw`);
* the six *local rewritings* (`WP_zero_head_false/true`, `WP_merge_false/true`, `WP_base_false/true`,
  `WP_absorb_s/r`) — each replaces one or two entries by fewer entries with the same value;
* `zero_shorter`, `pair_shorter` — those rewritings, applied at any position, make a word strictly
  shorter; `splice` is the index-to-split dictionary they are applied through.

Consequently a *shortest* word for an element has no zero exponent, no two adjacent entries in the same
factor, and, unless it has length one, no entry equal to the base element `±1` of either factor: it is
a word of the six letters `S, S³, R, R², R⁴, R⁵` with adjacent letters in different factors —
precisely the input of `no_die`.
-/

/-- The generator of an entry's factor: `false` is `S`, `true` is `R = T * S`. -/
def gp (p : Bool × ℤ) : PresentedGroup sl2zAmalgamRelators := if p.1 then rGen else sGen

lemma WP_cons_false (m : ℤ) (t : List (Bool × ℤ)) :
    WP ((false, m) :: t) = (sGen : PresentedGroup sl2zAmalgamRelators) ^ m * WP t := rfl

lemma WP_cons_true (m : ℤ) (t : List (Bool × ℤ)) :
    WP ((true, m) :: t) = (rGen : PresentedGroup sl2zAmalgamRelators) ^ m * WP t := rfl

/-- The exponent period of a factor: `S⁴ = 1` and `R⁶ = 1`. -/
def period (b : Bool) : ℤ := if b then 6 else 4

lemma period_pos (b : Bool) : 0 < period b := by cases b <;> decide

/-- The base element `±1`, read in either factor: `S² = R³`. -/
lemma base_r : (sGen : PresentedGroup sl2zAmalgamRelators) ^ (2 : ℤ) = rGen ^ (3 : ℤ) := by
  rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) by norm_num, show (3 : ℤ) = ((3 : ℕ) : ℤ) by norm_num,
    zpow_natCast, zpow_natCast]
  exact rGen_cube.symm

/-! #### The local rewritings -/

lemma WP_zero_head_false (t : List (Bool × ℤ)) : WP ((false, 0) :: t) = WP t := by
  rw [WP_cons_false, zpow_zero, one_mul]

lemma WP_zero_head_true (t : List (Bool × ℤ)) : WP ((true, 0) :: t) = WP t := by
  rw [WP_cons_true, zpow_zero, one_mul]

lemma WP_merge_false (m n : ℤ) (t : List (Bool × ℤ)) :
    WP ((false, m) :: (false, n) :: t) = WP ((false, m + n) :: t) := by
  rw [WP_cons_false, WP_cons_false, WP_cons_false, ← mul_assoc, ← zpow_add]

lemma WP_merge_true (m n : ℤ) (t : List (Bool × ℤ)) :
    WP ((true, m) :: (true, n) :: t) = WP ((true, m + n) :: t) := by
  rw [WP_cons_true, WP_cons_true, WP_cons_true, ← mul_assoc, ← zpow_add]

lemma WP_base_false (n : ℤ) (t : List (Bool × ℤ)) :
    WP ((false, 2) :: (true, n) :: t) = WP ((true, 3 + n) :: t) := by
  rw [WP_cons_false, WP_cons_true, WP_cons_true, base_r, ← mul_assoc, ← zpow_add]

lemma WP_base_true (m : ℤ) (t : List (Bool × ℤ)) :
    WP ((true, 3) :: (false, m) :: t) = WP ((false, 2 + m) :: t) := by
  rw [WP_cons_true, WP_cons_false, WP_cons_false, ← base_r, ← mul_assoc, ← zpow_add]

lemma WP_absorb_s (m : ℤ) (t : List (Bool × ℤ)) :
    WP ((false, m) :: (true, 3) :: t) = WP ((false, m + 2) :: t) := by
  rw [WP_cons_false, WP_cons_true, WP_cons_false, ← base_r, ← mul_assoc, ← zpow_add]

lemma WP_absorb_r (m : ℤ) (t : List (Bool × ℤ)) :
    WP ((true, m) :: (false, 2) :: t) = WP ((true, m + 3) :: t) := by
  rw [WP_cons_true, WP_cons_false, WP_cons_true, base_r, ← mul_assoc, ← zpow_add]

/-! #### Shortening a word at any position -/

/-- An entry equal to the base element `±1`. -/
def IsBase (p : Bool × ℤ) : Prop := p = (false, 2) ∨ p = (true, 3)

instance (p : Bool × ℤ) : Decidable (IsBase p) := by unfold IsBase; infer_instance

/-- A zero exponent can be deleted. -/
lemma zero_shorter (a : List (Bool × ℤ)) (b : Bool) (t : List (Bool × ℤ)) :
    ∃ u, WP u = WP (a ++ (b, 0) :: t) ∧ u.length < (a ++ (b, 0) :: t).length := by
  induction a with
  | nil =>
    refine ⟨t, ?_, by simp⟩
    cases b
    · exact (WP_zero_head_false t).symm
    · exact (WP_zero_head_true t).symm
  | cons r a ih =>
    obtain ⟨u, hu, hlen⟩ := ih
    refine ⟨r :: u, ?_, by simp at hlen ⊢; omega⟩
    rw [List.cons_append, WP_cons, WP_cons, hu]

/-- Two adjacent entries either in the same factor, or one of them the base element, can be replaced
by a single entry: the word gets strictly shorter. -/
lemma pair_shorter : ∀ (a : List (Bool × ℤ)) (p q : Bool × ℤ) (t : List (Bool × ℤ)),
    (p.1 = q.1 ∨ IsBase p ∨ IsBase q) →
      ∃ u, WP u = WP (a ++ p :: q :: t) ∧ u.length < (a ++ p :: q :: t).length
  | [], p, q, t, h => by
    rcases p with ⟨bp, mp⟩
    rcases q with ⟨bq, mq⟩
    simp only [IsBase, Prod.mk.injEq] at h
    cases bp <;> cases bq <;> simp at h
    · exact ⟨(false, mp + mq) :: t, (WP_merge_false mp mq t).symm, by simp⟩
    · rcases h with h | h
      · obtain rfl : mp = 2 := h
        exact ⟨(true, 3 + mq) :: t, (WP_base_false mq t).symm, by simp⟩
      · obtain rfl : mq = 3 := h
        exact ⟨(false, mp + 2) :: t, (WP_absorb_s mp t).symm, by simp⟩
    · rcases h with h | h
      · obtain rfl : mp = 3 := h
        exact ⟨(false, 2 + mq) :: t, (WP_base_true mq t).symm, by simp⟩
      · obtain rfl : mq = 2 := h
        exact ⟨(true, mp + 3) :: t, (WP_absorb_r mp t).symm, by simp⟩
    · exact ⟨(true, mp + mq) :: t, (WP_merge_true mp mq t).symm, by simp⟩
  | r :: a, p, q, t, h => by
    obtain ⟨u, hu, hlen⟩ := pair_shorter a p q t h
    refine ⟨r :: u, ?_, by simp at hlen ⊢; omega⟩
    rw [List.cons_append, WP_cons, WP_cons, hu]

/-- Every index with a successor in a list splits it as `a ++ p :: q :: b`, with `p` and `q` the
entries at that index and the next one. -/
lemma splice {w : List (Bool × ℤ)} {i : ℕ} (h : i + 1 < w.length) :
    ∃ a b, w = a ++ w[i]'(by omega) :: w[i + 1]'h :: b := by
  refine ⟨w.take i, w.drop (i + 2), ?_⟩
  have h1 : w.drop i = w[i]'(by omega) :: w[i + 1]'h :: w.drop (i + 2) := by
    rw [List.drop_eq_getElem_cons (show i < w.length by omega), List.drop_eq_getElem_cons h]
  calc w = w.take i ++ w.drop i := (List.take_append_drop i w).symm
    _ = w.take i ++ (w[i]'(by omega) :: w[i + 1]'h :: w.drop (i + 2)) := by rw [h1]

/-- The exponent of an entry, reduced into the factor's period. -/
def modp (p : Bool × ℤ) : Bool × ℤ := (p.1, p.2 % period p.1)

/-- The word with every exponent reduced into the factor's period. -/
def modw (w : List (Bool × ℤ)) : List (Bool × ℤ) := w.map modp

lemma WP_cons_gp (p : Bool × ℤ) (t : List (Bool × ℤ)) :
    WP (p :: t) = gp p ^ p.2 * WP t := rfl

lemma gp_zpow_emod (p : Bool × ℤ) : gp p ^ p.2 = gp p ^ (p.2 % period p.1) := by
  rcases p with ⟨b, n⟩
  cases b
  · exact zpow_eq_zpow_emod' n sGen_pow_four
  · exact zpow_eq_zpow_emod' n rGen_pow_six

lemma gp_modp_pow (p : Bool × ℤ) : gp (modp p) ^ (modp p).2 = gp p ^ p.2 := by
  rw [gp_zpow_emod p]
  rfl

lemma modw_nil : modw ([] : List (Bool × ℤ)) = [] := rfl

lemma modw_cons (p : Bool × ℤ) (t : List (Bool × ℤ)) : modw (p :: t) = modp p :: modw t := rfl

lemma WP_modw (w : List (Bool × ℤ)) : WP (modw w) = WP w := by
  induction w with
  | nil => rfl
  | cons p t ih => rw [modw_cons, WP_cons_gp, ih, WP_cons_gp, gp_modp_pow]

lemma modw_length (w : List (Bool × ℤ)) : (modw w).length = w.length := List.length_map ..

lemma modp_nonneg (p : Bool × ℤ) : 0 ≤ (modp p).2 :=
  Int.emod_nonneg _ (ne_of_gt (period_pos p.1))

lemma modp_lt (p : Bool × ℤ) : (modp p).2 < period (modp p).1 := by
  have h := Int.emod_lt_of_pos p.2 (period_pos p.1)
  simpa [modp] using h

/-! #### The six letters -/

/-- An entry is one of the six letters `S, S³, R, R², R⁴, R⁵`. -/
def Six (p : Bool × ℤ) : Prop :=
  p = (false, 1) ∨ p = (false, 3) ∨ p = (true, 1) ∨ p = (true, 2) ∨ p = (true, 4) ∨
    p = (true, 5)

instance (p : Bool × ℤ) : Decidable (Six p) := by unfold Six; infer_instance

/-- The letter of a six-letter entry. -/
def ofPair (p : Bool × ℤ) : Letter :=
  if p.1 then
    (if p.2 = 2 then Letter.r2 else if p.2 = 4 then Letter.r4 else if p.2 = 5 then Letter.r5
      else Letter.r1)
  else (if p.2 = 3 then Letter.s3 else Letter.s1)

/-- The matrix of a six-letter entry, read in `SL(2, ℤ)`. -/
lemma val_ofPair {p : Bool × ℤ} (hp : Six p) :
    (ofPair p).val =
      (if p.1 then (T * S : SL(2, ℤ)) ^ p.2 else (S : SL(2, ℤ)) ^ p.2) := by
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> decide

/-- A six-letter entry lies in the `⟨S⟩` factor exactly when its flag is `false`. -/
lemma isS_ofPair {p : Bool × ℤ} (hp : Six p) : (ofPair p).isS = !p.1 := by
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> decide

lemma WS_map_ofPair (w : List (Bool × ℤ)) (h : ∀ p ∈ w, Six p) :
    WS w = ((w.map ofPair).map Letter.val).prod := by
  induction w with
  | nil => simp [WS]
  | cons p t ih =>
    have hp : Six p := h p (by simp)
    have ht : ∀ q ∈ t, Six q := fun q hq => h q (by simp [hq])
    have hstep : WS (p :: t) =
        (if p.1 then (T * S : SL(2, ℤ)) ^ p.2 else (S : SL(2, ℤ)) ^ p.2) * WS t := rfl
    rw [hstep, ih ht, List.map_cons, List.map_cons, List.prod_cons, val_ofPair hp]

lemma WS_base_false : WS ([(false, 2)] : List (Bool × ℤ)) = (S : SL(2, ℤ)) ^ 2 := by
  simp [WS]

lemma WS_base_true : WS ([(true, 3)] : List (Bool × ℤ)) = (S : SL(2, ℤ)) ^ 2 := by
  have h : (T * S : SL(2, ℤ)) ^ (3 : ℤ) = (S : SL(2, ℤ)) ^ 2 := by
    rw [show (3 : ℤ) = ((3 : ℕ) : ℤ) by norm_num, zpow_natCast, T_mul_S_pow_three_eq_S_sq]
  simpa [WS] using h

lemma isS_L_ofPair {v : List (Bool × ℤ)} (hsix : ∀ p ∈ v, Six p) {i : ℕ} (hi : i < v.length) :
    (L (v.map ofPair) i).isS = !(v[i]'hi).1 := by
  have h1 : i < (v.map ofPair).length := by simpa using hi
  rw [L_eq h1, List.getElem_map]
  exact isS_ofPair (hsix _ (List.getElem_mem hi))

lemma six_of {p : Bool × ℤ} (h1 : 0 < p.2) (h2 : p.2 < period p.1) (h3 : ¬ IsBase p) :
    Six p := by
  rcases p with ⟨b, m⟩
  have h1' : 0 < m := h1
  have h2' : m < period b := h2
  cases b
  · have h2'' : m < 4 := by simpa [period] using h2'
    have h3' : m ≠ 2 := fun h => h3 (Or.inl (by rw [h]))
    simp only [Six, Prod.mk.injEq, Bool.false_eq_true, true_and, false_and, or_false, false_or,
      and_false]
    omega
  · have h2'' : m < 6 := by simpa [period] using h2'
    have h3' : m ≠ 3 := fun h => h3 (Or.inr (by rw [h]))
    simp only [Six, Prod.mk.injEq, Bool.false_eq_true, true_and, false_and, or_false, false_or,
      and_false]
    omega

lemma getD_eq_getElem' {l : List (Bool × ℤ)} {i : ℕ} (h : i < l.length) (d : Bool × ℤ) :
    l.getD i d = l[i]'h := by
  simp only [List.getD, List.getElem?_eq_getElem h]; rfl

/-! ## A minimal word has no zero exponent, no adjacent pair in one factor, no base entry -/

lemma ne_zero_of_min {w : List (Bool × ℤ)}
    (hmin : ∀ u, WP u = WP w → w.length ≤ u.length) {p : Bool × ℤ} (hp : p ∈ w) :
    p.2 ≠ 0 := by
  intro h0
  obtain ⟨a, b, hw⟩ := List.append_of_mem hp
  obtain ⟨u, hu, hlen⟩ := zero_shorter a p.1 b
  have hpe : (p.1, (0 : ℤ)) = p := by rw [← h0]
  rw [hpe] at hu hlen
  have h1 : u.length < w.length := by rw [hw]; exact hlen
  have h2 := hmin u (by rw [hu, hw])
  omega

lemma not_bad_of_min {w : List (Bool × ℤ)}
    (hmin : ∀ u, WP u = WP w → w.length ≤ u.length) {p q : Bool × ℤ} {t : List (Bool × ℤ)}
    (hw : w = p :: q :: t) : ¬(p.1 = q.1 ∨ IsBase p ∨ IsBase q) := by
  intro hbad
  obtain ⟨u, hu, hlen⟩ := pair_shorter [] p q t hbad
  have h2 : WP u = WP w := by
    simp only [List.nil_append] at hu
    rw [hu, hw]
  have h1 := hmin u h2
  rw [hw] at h1
  simp only [List.length_cons] at h1
  simp only [List.nil_append, List.length_cons] at hlen
  omega

lemma min_of_tail {w : List (Bool × ℤ)} (hmin : ∀ u, WP u = WP w → w.length ≤ u.length)
    (p : Bool × ℤ) (t : List (Bool × ℤ)) (hw : w = p :: t) :
    ∀ u, WP u = WP t → t.length ≤ u.length := by
  intro u hu
  by_contra hlt
  have hlt' : u.length < t.length := by omega
  have h1 : WP (p :: u) = WP w := by rw [hw, WP_cons, WP_cons, hu]
  have h2 := hmin (p :: u) h1
  rw [hw] at h2
  simp only [List.length_cons] at h2
  omega

/-- A word with adjacent entries in different factors. -/
inductive AltW : List (Bool × ℤ) → Prop
  | nil : AltW []
  | single (p : Bool × ℤ) : AltW [p]
  | cons {p q : Bool × ℤ} {t : List (Bool × ℤ)} (h : p.1 ≠ q.1) (ht : AltW (q :: t)) :
      AltW (p :: q :: t)

/-- **The shape of a shortest word.** A word of minimal length for its value, with every exponent
already reduced into its factor's period, is empty, or a word of six letters with adjacent letters in
different factors, or a single base entry. -/
theorem reduced_aux (w : List (Bool × ℤ))
    (hmin : ∀ u, WP u = WP w → w.length ≤ u.length)
    (hcan : ∀ p ∈ w, 0 ≤ p.2 ∧ p.2 < period p.1) :
    w = [] ∨ ((∀ p ∈ w, Six p) ∧ AltW w) ∨ (∃ p, w = [p] ∧ IsBase p) := by
  induction w with
  | nil => exact Or.inl rfl
  | cons p t ih =>
    have hshift : ∀ u, WP u = WP t → t.length ≤ u.length := min_of_tail hmin p t rfl
    have hcant : ∀ r ∈ t, 0 ≤ r.2 ∧ r.2 < period r.1 := fun r hr => hcan r (by simp [hr])
    rcases t with _ | ⟨q, t'⟩
    · -- the word is the single entry `p`
      by_cases hb : IsBase p
      · exact Or.inr (Or.inr ⟨p, rfl, hb⟩)
      · have hp1 : 0 < p.2 := by
          have h1 := (hcan p (by simp)).1
          have h0 := ne_zero_of_min hmin (p := p) (by simp)
          omega
        refine Or.inr (Or.inl ⟨?_, AltW.single p⟩)
        intro x hx
        simp only [List.mem_singleton] at hx
        rw [hx]
        exact six_of hp1 (hcan p (by simp)).2 hb
    · -- the word has at least two entries
      have hpq : ¬(p.1 = q.1 ∨ IsBase p ∨ IsBase q) := not_bad_of_min hmin rfl
      have hcant' : ∀ r ∈ (q :: t'), 0 ≤ r.2 ∧ r.2 < period r.1 :=
        fun r hr => hcan r (by simp [hr])
      have hp1 : 0 < p.2 := by
        have h1 := (hcan p (by simp)).1
        have h0 := ne_zero_of_min hmin (p := p) (by simp)
        omega
      have hp6 : Six p := six_of hp1 (hcan p (by simp)).2 (fun hb => hpq (Or.inr (Or.inl hb)))
      rcases ih hshift hcant' with h0 | ⟨hsix, halt⟩ | ⟨r, hr, hb⟩
      · exact absurd h0 (by simp)
      · refine Or.inr (Or.inl ⟨?_, AltW.cons (fun h => hpq (Or.inl h)) halt⟩)
        intro x hx
        rcases List.mem_cons.mp hx with rfl | hx'
        · exact hp6
        · exact hsix x hx'
      · exact (not_bad_of_min hmin (p := p) (q := r) (t := []) (by rw [hr])
          (Or.inr (Or.inr hb))).elim

lemma altW_getD {w : List (Bool × ℤ)} (h : AltW w) :
    ∀ (i : ℕ), 0 < i → i < w.length →
      (w.getD i ((false, 0) : Bool × ℤ)).1 ≠
        (w.getD (i - 1) ((false, 0) : Bool × ℤ)).1 := by
  induction h with
  | nil => intro i hi hil; simp at hil
  | single p => intro i hi hil; simp only [List.length_cons, List.length_nil] at hil; omega
  | @cons p q t hp hq ih =>
    intro i hi hil
    match i with
    | 0 => omega
    | 1 => intro h; exact hp h.symm
    | k + 2 =>
      have h1 : 0 < k + 1 := by omega
      have h2 : k + 1 < (q :: t).length := by
        simp only [List.length_cons] at hil
        simp only [List.length_cons]
        omega
      simpa using ih (k + 1) h1 h2

lemma isS_alt_L {v : List (Bool × ℤ)} (hsix : ∀ p ∈ v, Six p)
    (halt : ∀ (i : ℕ), 0 < i → i < v.length →
      (v.getD i ((false, 0) : Bool × ℤ)).1 ≠
        (v.getD (i - 1) ((false, 0) : Bool × ℤ)).1) :
    ∀ (i : ℕ), 0 < i → i < (v.map ofPair).length →
      (L (v.map ofPair) i).isS ≠ (L (v.map ofPair) (i - 1)).isS := by
  intro i hi hil
  have hi' : i < v.length := by simpa using hil
  have h1 : i - 1 < v.length := by omega
  rw [isS_L_ofPair hsix hi', isS_L_ofPair hsix h1]
  have e1 : (v[i]'hi').1 = (v.getD i ((false, 0) : Bool × ℤ)).1 := by
    rw [getD_eq_getElem' hi']
  have e2 : (v[i - 1]'h1).1 = (v.getD (i - 1) ((false, 0) : Bool × ℤ)).1 := by
    rw [getD_eq_getElem' h1]
  rw [e1, e2]
  intro h
  exact halt i hi hi' (Bool.not_inj h)

set_option maxHeartbeats 2000000 in
/-- **No word dies in the amalgam presentation.** If an element of `⟨S, R | S⁴, R³S⁻²⟩` maps to `1`
in `SL(2, ℤ)`, it is `1`. -/
theorem phiSL_eq_one {g : PresentedGroup sl2zAmalgamRelators} (hg : phiSL g = 1) : g = 1 := by
  classical
  obtain ⟨w₀, hw₀⟩ := WP_surjective g
  have hex : ∃ n, ∃ w : List (Bool × ℤ), WP w = g ∧ w.length = n := ⟨_, w₀, hw₀, rfl⟩
  let n₀ := Nat.find hex
  obtain ⟨w, hw, hwlen⟩ : ∃ w : List (Bool × ℤ), WP w = g ∧ w.length = n₀ := Nat.find_spec hex
  have hmin : ∀ u : List (Bool × ℤ), WP u = g → n₀ ≤ u.length := by
    intro u hu
    by_contra hlt
    exact Nat.find_min hex (by omega) ⟨u, hu, rfl⟩
  have hvWP : WP (modw w) = g := by rw [WP_modw, hw]
  have hvlen : (modw w).length = n₀ := by rw [modw_length, hwlen]
  have hminv : ∀ u : List (Bool × ℤ), WP u = WP (modw w) → (modw w).length ≤ u.length := by
    intro u hu
    rw [hvlen]
    exact hmin u (by rw [hu, hvWP])
  have hWS : WS (modw w) = 1 := by rw [← phiSL_WP (modw w), hvWP]; exact hg
  have hcan : ∀ p ∈ modw w, 0 ≤ p.2 ∧ p.2 < period p.1 := by
    intro p hp
    obtain ⟨q, -, rfl⟩ := List.mem_map.mp hp
    exact ⟨modp_nonneg q, modp_lt q⟩
  rcases reduced_aux (modw w) hminv hcan with h0 | ⟨hsix, halt⟩ | ⟨p, hp, hb⟩
  · rw [h0] at hvWP
    rw [← hvWP]; rfl
  · by_cases hv0 : modw w = []
    · rw [hv0] at hvWP
      rw [← hvWP]; rfl
    · have hprod : (((modw w).map ofPair).map Letter.val).prod = 1 := by
        rw [← WS_map_ofPair (modw w) hsix, hWS]
      have halt' := isS_alt_L hsix (altW_getD halt)
      refine (no_die ?_ hprod halt').elim
      intro h
      exact hv0 (List.map_eq_nil_iff.mp h)
  · rw [hp] at hWS
    rcases hb with rfl | rfl
    · rw [WS_base_false] at hWS
      exact absurd hWS S_sq_ne_one
    · rw [WS_base_true] at hWS
      exact absurd hWS S_sq_ne_one

/-! ### The presentation is complete

`phiSL_eq_one` says a word over the two factors that dies in `SL(2, ℤ)` is already trivial in the
amalgam presentation. Injectivity of `phiSL` follows, and then injectivity of `sl2zToGroup` through
the equivalence `sl2zAmalgamEquiv` between the issue's presentation and the amalgam one.
-/

/-- **`phiSL` is injective.** -/
theorem phiSL_injective : Function.Injective phiSL := by
  intro a b hab
  have h : phiSL (a * b⁻¹) = 1 := by rw [map_mul, map_inv, hab, mul_inv_cancel]
  have h1 : a * b⁻¹ = 1 := phiSL_eq_one h
  rwa [mul_inv_eq_one] at h1

/-- The two maps between the issue's presentation and the amalgam one are mutually inverse. -/
theorem sl2zOfAmalgam_sl2zToAmalgam (z : PresentedGroup sl2zRelators) :
    sl2zOfAmalgam (sl2zToAmalgam z) = z := by
  have := congrArg (fun f => f z) sl2zOfAmalgam_comp_toAmalgam
  simpa using this

/-- **lean-categories#89 item 1, completeness.** The map from the presentation
`⟨S, T | S⁴, (TS)³S⁻²⟩` to `SL(2, ℤ)` is injective, so the presentation is the group. -/
theorem sl2zToGroup_injective : Function.Injective sl2zToGroup := by
  intro x y hxy
  have hx : phiSL (sl2zToAmalgam x) = sl2zToGroup x := by
    show sl2zToGroup (sl2zOfAmalgam (sl2zToAmalgam x)) = sl2zToGroup x
    rw [sl2zOfAmalgam_sl2zToAmalgam]
  have hy : phiSL (sl2zToAmalgam y) = sl2zToGroup y := by
    show sl2zToGroup (sl2zOfAmalgam (sl2zToAmalgam y)) = sl2zToGroup y
    rw [sl2zOfAmalgam_sl2zToAmalgam]
  have h1 : sl2zToAmalgam x = sl2zToAmalgam y := phiSL_injective (by rw [hx, hy, hxy])
  have h2 : sl2zOfAmalgam (sl2zToAmalgam x) = sl2zOfAmalgam (sl2zToAmalgam y) := by rw [h1]
  rwa [sl2zOfAmalgam_sl2zToAmalgam, sl2zOfAmalgam_sl2zToAmalgam] at h2

/-- **lean-categories#89 item 1.** `⟨S, T | S⁴, (TS)³ = S²⟩` presents `SL(2, ℤ)`. -/
noncomputable def sl2zPresentation : PresentedGroup sl2zRelators ≃* SL(2, ℤ) :=
  MulEquiv.ofBijective sl2zToGroup ⟨sl2zToGroup_injective, sl2zToGroup_surjective⟩

/-- Lean-categories#89 item 1's completeness, in the form the issue names it. -/
theorem sl2zPresentationComplete : Sl2zPresentationComplete := sl2zToGroup_injective

end ModularGroup

namespace LeanCategories.ForMathlib

open Matrix ModularGroup

/-- The matrix `diag(1, -1)` over `ℤ`. -/
def eMatrix : Matrix (Fin 2) (Fin 2) ℤ := !![1, 0; 0, -1]

theorem eMatrix_mul_self : eMatrix * eMatrix = 1 := by decide

/-- The element `e = diag(1, -1)` of `GL(2, ℤ)` of lean-categories#89 item 2. Its unit inverse is
itself, so it is built from one matrix and one product identity. -/
def eGL : GL (Fin 2) ℤ := ⟨eMatrix, eMatrix, eMatrix_mul_self, eMatrix_mul_self⟩

@[simp]
theorem coe_eGL : ((eGL : GL (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) = eMatrix := rfl

@[simp]
theorem coe_eGL_inv : ((eGL⁻¹ : GL (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) = eMatrix := rfl

/-- `det e = -1`: `e` is not in `SL(2, ℤ)`, which is the kernel of `det`. -/
theorem det_eGL : GeneralLinearGroup.det eGL = -1 := by
  apply Units.ext
  rw [GeneralLinearGroup.val_det_apply, coe_eGL, eMatrix, Units.val_neg, Units.val_one]
  decide

/-- `e ^ 2 = 1`: the first relation of the adjoined presentation. -/
theorem eGL_sq : eGL ^ 2 = 1 := by decide

/-- `e * e = 1` in the multiplicative form used by `inv_eq_of_mul_eq_one_right`. -/
theorem eGL_mul_self : eGL * eGL = 1 := by
  rw [← pow_two]
  exact eGL_sq

/-- `e S e⁻¹ = S⁻¹`: the conjugate of `S` by `e`, as a word in `S`. -/
theorem eGL_conj_S :
    eGL * SpecialLinearGroup.toGL S * eGL⁻¹ = SpecialLinearGroup.toGL S⁻¹ := by
  decide

/-- `e T e⁻¹ = T⁻¹`: the conjugate of `T` by `e`, as a word in `T`. -/
theorem eGL_conj_T :
    eGL * SpecialLinearGroup.toGL T * eGL⁻¹ = SpecialLinearGroup.toGL T⁻¹ := by
  decide

/-- The subgroup `{1, e}` of `GL(2, ℤ)`. -/
def pairSubgroup : Subgroup (GL (Fin 2) ℤ) where
  carrier := {1, eGL}
  mul_mem' := by
    rintro a b (rfl | rfl) (rfl | rfl) <;> simp [eGL_mul_self]
  one_mem' := Set.mem_insert _ _
  inv_mem' := by
    rintro a (rfl | rfl)
    · exact Set.mem_insert _ _
    · rw [inv_eq_of_mul_eq_one_right eGL_mul_self]
      exact Set.mem_insert_of_mem _ rfl

/-- The subgroup generated by `e` is `{1, e}`, because `e ^ 2 = 1`. -/
theorem closure_eGL_eq_pairSubgroup : Subgroup.closure {eGL} = pairSubgroup := by
  refine le_antisymm ?_ (fun x hx => ?_)
  · refine (Subgroup.closure_le (K := pairSubgroup)).mpr ?_
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact Set.mem_insert_of_mem _ (Set.mem_singleton eGL)
  · change x ∈ ({1, eGL} : Set (GL (Fin 2) ℤ)) at hx
    rcases hx with rfl | rfl
    · exact one_mem _
    · exact Subgroup.subset_closure (Set.mem_singleton eGL)

/-- `⟨e⟩` meets `det⁻¹(1)` only in the identity: the two factors of the semidirect product of
lean-categories#89 item 2 are independent. -/
theorem disjoint_eGL_detKer :
    Disjoint (Subgroup.closure {eGL})
      (GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker := by
  rw [disjoint_iff_inf_le]
  intro x hx
  rw [Subgroup.mem_inf, MonoidHom.mem_ker] at hx
  obtain ⟨hx1, hx2⟩ := hx
  rw [closure_eGL_eq_pairSubgroup] at hx1
  change x ∈ ({1, eGL} : Set (GL (Fin 2) ℤ)) at hx1
  rcases hx1 with rfl | rfl
  · exact Subgroup.mem_bot.mpr rfl
  · rw [det_eGL] at hx2
    exact absurd hx2 (by decide)

/-- Every element of `GL(2, ℤ)` is `c * s` with `c ∈ ⟨e⟩` and `s ∈ det⁻¹(1)`: the multiplication
map of the two factors is onto. -/
theorem mul_closure_eGL_detKer :
    ((Subgroup.closure {eGL} : Set (GL (Fin 2) ℤ)) *
        ((GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker : Set (GL (Fin 2) ℤ))) =
      Set.univ := by
  rw [Set.eq_univ_iff_forall]
  intro g
  rcases Int.units_eq_one_or (GeneralLinearGroup.det g) with h | h
  · refine Set.mem_mul.mpr ⟨1, Subgroup.one_mem _, g, MonoidHom.mem_ker.mpr h, one_mul g⟩
  · refine Set.mem_mul.mpr ⟨eGL, Subgroup.subset_closure (Set.mem_singleton eGL), eGL * g, ?_, ?_⟩
    · exact MonoidHom.mem_ker.mpr (by rw [map_mul, det_eGL, h]; decide)
    · rw [← mul_assoc, eGL_mul_self, one_mul]

/-- `SL(2, ℤ)` is normal in `GL(2, ℤ)`, being the kernel of the determinant: the normal factor of
the semidirect product of lean-categories#89 item 2. -/
theorem normal_detKer :
    (GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker.Normal :=
  MonoidHom.normal_ker _

/-- `GL(2, ℤ) = SL(2, ℤ) ⋊ ⟨e⟩` for `e = diag(1, -1)`, in internal form: the subgroup `⟨e⟩` and
the kernel of `det` (which is `SL(2, ℤ)`, see `SpecialLinearGroup.range_toGL_eq_ker_det`) are
complementary. -/
theorem gl2z_isComplement :
    (Subgroup.closure {eGL}).IsComplement'
      (GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker :=
  Subgroup.isComplement'_of_disjoint_and_mul_eq_univ disjoint_eGL_detKer mul_closure_eGL_detKer

/-- The generators of lean-categories#89 item 2's presentation of `GL(2, ℤ)` as a family
`Fin 3 → GL(2, ℤ)`: index `0` is `S`, `1` is `T`, `2` is `e = diag(1, -1)`. -/
def gl2zGenVal : Fin 3 → GL (Fin 2) ℤ :=
  ![SpecialLinearGroup.toGL S, SpecialLinearGroup.toGL T, eGL]

lemma gl2zGenVal_zero : gl2zGenVal 0 = SpecialLinearGroup.toGL S := rfl

lemma gl2zGenVal_one : gl2zGenVal 1 = SpecialLinearGroup.toGL T := rfl

lemma gl2zGenVal_two : gl2zGenVal 2 = eGL := rfl

/-- `S`, `T` and `e` generate `GL(2, ℤ)`: `S` and `T` generate `SL(2, ℤ)` and `e` completes it as
the semidirect product `gl2z_isComplement`. -/
theorem closure_gens_gl2z :
    Subgroup.closure ({SpecialLinearGroup.toGL S, SpecialLinearGroup.toGL T, eGL} :
      Set (GL (Fin 2) ℤ)) = ⊤ := by
  set gens : Set (GL (Fin 2) ℤ) := {SpecialLinearGroup.toGL S, SpecialLinearGroup.toGL T, eGL}
  have hSL : (⊤ : Subgroup (SL(2, ℤ))) ≤ Subgroup.comap SpecialLinearGroup.toGL
      (Subgroup.closure gens) := by
    rw [← SpecialLinearGroup.SL2Z_generators]
    refine (Subgroup.closure_le
      (K := Subgroup.comap SpecialLinearGroup.toGL (Subgroup.closure gens))).mpr ?_
    rintro x (rfl | rfl) <;> exact Subgroup.subset_closure (by simp [gens])
  have hker : (GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker ≤ Subgroup.closure gens := by
    intro s hs
    have hs' : s ∈ (SpecialLinearGroup.toGL (n := Fin 2) (R := ℤ)).range := by
      rw [SpecialLinearGroup.range_toGL_eq_ker_det]
      exact hs
    obtain ⟨a, rfl⟩ := hs'
    exact hSL (Subgroup.mem_top a)
  have he : Subgroup.closure {eGL} ≤ Subgroup.closure gens := by
    refine (Subgroup.closure_le (K := Subgroup.closure gens)).mpr ?_
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact Subgroup.subset_closure (by simp [gens])
  refine eq_top_iff.mpr (fun g _ => ?_)
  have hg : g ∈ ((Subgroup.closure {eGL} : Set (GL (Fin 2) ℤ)) *
      ((GeneralLinearGroup.det (n := Fin 2) (R := ℤ)).ker : Set (GL (Fin 2) ℤ))) :=
    mul_closure_eGL_detKer ▸ Set.mem_univ g
  obtain ⟨c, hc, s, hs, hcs⟩ := Set.mem_mul.mp hg
  rw [← hcs]
  exact mul_mem (he hc) (hker hs)

/-- `GL(2, ℤ)` is generated by the three elements of lean-categories#89 item 2's presentation. -/
def gl2zGenerators : Group.Generators (GL (Fin 2) ℤ) (Fin 3) where
  val := gl2zGenVal
  closure_eq_top := by
    have hrange : Set.range gl2zGenVal =
        {SpecialLinearGroup.toGL S, SpecialLinearGroup.toGL T, eGL} := by
      ext x
      constructor
      · rintro ⟨i, rfl⟩
        fin_cases i
        · exact Set.mem_insert _ _
        · exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
        · exact Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton eGL))
      · rintro (rfl | rfl | rfl)
        · exact ⟨0, rfl⟩
        · exact ⟨1, rfl⟩
        · exact ⟨2, rfl⟩
    rw [hrange]
    exact closure_gens_gl2z

/-- The relators of lean-categories#89 item 2's presentation of `GL(2, ℤ)`: the two relators of the
`SL(2, ℤ)` presentation, `e²`, and the two conjugates `e S e⁻¹ S` and `e T e⁻¹ T` recording
`e S e⁻¹ = S⁻¹` and `e T e⁻¹ = T⁻¹` (`eGL_conj_S`, `eGL_conj_T`). -/
def gl2zRelators : Set (FreeGroup (Fin 3)) :=
  {FreeGroup.of 0 ^ 4,
    (FreeGroup.of 1 * FreeGroup.of 0) ^ 3 * (FreeGroup.of 0) ^ (-2 : ℤ),
    FreeGroup.of 2 ^ 2,
    FreeGroup.of 2 * FreeGroup.of 0 * (FreeGroup.of 2)⁻¹ * FreeGroup.of 0,
    FreeGroup.of 2 * FreeGroup.of 1 * (FreeGroup.of 2)⁻¹ * FreeGroup.of 1}

/-- Each relator of `gl2zRelators` dies in `GL(2, ℤ)`. -/
theorem gl2zRelators_map_one : ∀ r ∈ gl2zRelators, FreeGroup.lift gl2zGenVal r = 1 := by
  intro r hr
  simp only [gl2zRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl | rfl | rfl | rfl
  · rw [map_pow, FreeGroup.lift_apply_of, gl2zGenVal_zero, ← map_pow, S_pow_four, map_one]
  · rw [map_mul, map_pow, map_mul, map_zpow, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of,
      gl2zGenVal_one, gl2zGenVal_zero, ← map_mul, ← map_pow, ← map_zpow, ← map_mul,
      T_mul_S_pow_three_mul_zpow, map_one]
  · rw [map_pow, FreeGroup.lift_apply_of, gl2zGenVal_two, eGL_sq]
  · simp only [map_mul, map_inv, FreeGroup.lift_apply_of, gl2zGenVal_zero, gl2zGenVal_two]
    rw [eGL_conj_S, ← map_mul, inv_mul_cancel, map_one]
  · simp only [map_mul, map_inv, FreeGroup.lift_apply_of, gl2zGenVal_one, gl2zGenVal_two]
    rw [eGL_conj_T, ← map_mul, inv_mul_cancel, map_one]

/-- The homomorphism `⟨S, T, e | S⁴, (TS)³S⁻², e², eSe⁻¹S, eTe⁻¹T⟩ →* GL(2, ℤ)` of
lean-categories#89 item 2. -/
def gl2zToGroup : PresentedGroup gl2zRelators →* GL (Fin 2) ℤ :=
  PresentedGroup.toGroup gl2zRelators_map_one

theorem gl2zToGroup_of (i : Fin 3) : gl2zToGroup (PresentedGroup.of i) = gl2zGenVal i :=
  PresentedGroup.toGroup.of gl2zRelators_map_one

/-- The adjoined presentation surjects onto `GL(2, ℤ)`. -/
theorem gl2zToGroup_surjective : Function.Surjective gl2zToGroup := by
  have hle : ({SpecialLinearGroup.toGL S, SpecialLinearGroup.toGL T, eGL} :
      Set (GL (Fin 2) ℤ)) ⊆ gl2zToGroup.range := by
    rintro x (rfl | rfl | rfl)
    · exact ⟨PresentedGroup.of 0, gl2zToGroup_of 0⟩
    · exact ⟨PresentedGroup.of 1, gl2zToGroup_of 1⟩
    · exact ⟨PresentedGroup.of 2, gl2zToGroup_of 2⟩
  have htop : (⊤ : Subgroup (GL (Fin 2) ℤ)) ≤ gl2zToGroup.range :=
    closure_gens_gl2z ▸ (Subgroup.closure_le (K := gl2zToGroup.range)).mpr hle
  intro g
  exact MonoidHom.mem_range.mp (htop (Subgroup.mem_top g))

/-- Lean-categories#89 item 2 in the form the theorem would take: the presentation obtained by
adjoining `e` to the `SL(2, ℤ)` presentation is *complete*. This is **not proved** here; it reduces
to `ModularGroup.Sl2zPresentationComplete` plus the identification of `PresentedGroup gl2zRelators`
with the semidirect product `PresentedGroup sl2zRelators ⋊ ⟨e⟩`, which is not formalized. -/
def Gl2zPresentationComplete : Prop := Function.Injective gl2zToGroup

/-!
### Item 2, the `SL(2, ℤ)` part of the adjoined presentation

The adjoined presentation restricts to the `SL(2, ℤ)` one: its first two generators satisfy the two
`sl2zRelators` (`gl2zS_pow_four`, `gl2zTS_relator`), so there is a map `sl2zInGl` from
`PresentedGroup sl2zRelators` to `PresentedGroup gl2zRelators` (`S ↦ S`, `T ↦ T`). The third
generator has image of order exactly two (`gl2zToGroup_of_two_sq`, `gl2zToGroup_of_two_ne_one`),
which is the `e` half of the reduction described in the module docstring.

What is not here: the composite `gl2zToGroup ∘ sl2zInGl = toGL ∘ sl2zToGroup`, the normal form
`∀ q, ∃ a, ∃ ε, i a * e ^ ε = q`, and hence the implication
`Sl2zPresentationComplete → Gl2zPresentationComplete`. The composite fails to elaborate through
`fin_cases`, which substitutes `⟨0, ⋯⟩` for `0 : Fin 2` and so stops the `of`-lemmas from firing;
it needs `Fin.cases`-free index handling (or statements indexed by `Fin.mk` terms) rather than more
`rw` chains.
-/

theorem gl2zS_pow_four : (PresentedGroup.of (rels := gl2zRelators) 0) ^ 4 = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_zpow, ← map_inv] using
    (PresentedGroup.one_of_mem (rels := gl2zRelators) (x := FreeGroup.of 0 ^ 4)
      (by simp [gl2zRelators]))

theorem gl2zTS_relator :
    ((PresentedGroup.of (rels := gl2zRelators) 1 * PresentedGroup.of (rels := gl2zRelators) 0) ^ 3 *
        ((PresentedGroup.of (rels := gl2zRelators) 0) ^ 2)⁻¹) = 1 := by
  simpa [PresentedGroup.of, ← map_mul, ← map_pow, ← map_inv] using
    (PresentedGroup.one_of_mem (rels := gl2zRelators)
      (x := (FreeGroup.of 1 * FreeGroup.of 0) ^ 3 * ((FreeGroup.of 0) ^ 2)⁻¹)
      (by simp [gl2zRelators]))

/-- The two generators of the `SL(2, ℤ)` presentation, read in the `GL(2, ℤ)` one. -/
def sl2zGenValInGl : Fin 2 → PresentedGroup gl2zRelators :=
  ![PresentedGroup.of 0, PresentedGroup.of 1]

lemma sl2zGenValInGl_zero : sl2zGenValInGl 0 = PresentedGroup.of 0 := rfl

lemma sl2zGenValInGl_one : sl2zGenValInGl 1 = PresentedGroup.of 1 := rfl

theorem sl2zRelators_map_one_gl :
    ∀ r ∈ sl2zRelators, FreeGroup.lift sl2zGenValInGl r = 1 := by
  intro r hr
  simp only [sl2zRelators, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · simpa [sl2zGenValInGl_zero, FreeGroup.lift_apply_of, map_pow] using gl2zS_pow_four
  · simpa [sl2zGenValInGl_zero, sl2zGenValInGl_one, FreeGroup.lift_apply_of, map_pow, map_mul,
      map_zpow] using gl2zTS_relator

/-- The `SL(2, ℤ)` presentation inside the `GL(2, ℤ)` one: `S ↦ S`, `T ↦ T`. -/
def sl2zInGl : PresentedGroup sl2zRelators →* PresentedGroup gl2zRelators :=
  PresentedGroup.toGroup sl2zRelators_map_one_gl

theorem sl2zInGl_of (i : Fin 2) : sl2zInGl (PresentedGroup.of i) = sl2zGenValInGl i :=
  PresentedGroup.toGroup.of sl2zRelators_map_one_gl

/-- The `e`-direction of the `GL(2, ℤ)` presentation has order exactly two. -/
theorem gl2zToGroup_of_two_sq : gl2zToGroup ((PresentedGroup.of (rels := gl2zRelators) 2) ^ 2)
    = 1 := by
  rw [pow_two, map_mul, gl2zToGroup_of, gl2zGenVal_two, eGL_mul_self]

theorem gl2zToGroup_of_two_ne_one :
    gl2zToGroup (PresentedGroup.of (rels := gl2zRelators) 2) ≠ 1 := by
  rw [gl2zToGroup_of, gl2zGenVal_two]
  intro h
  have h1 : GeneralLinearGroup.det eGL = 1 := by rw [h, map_one]
  rw [det_eGL] at h1
  exact absurd h1 (by decide)
end LeanCategories.ForMathlib
