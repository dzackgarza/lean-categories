/-!
# Schreier generators for the stabilizer of a point

Let a group `G` act on a set `α`, let `S` generate `G`, let `p : α`, and let `t : α → G` choose a
transversal of the orbit of `p`: `t q • p = q` for every `q` in the orbit, with `t p = 1`. Then the
stabilizer of `p` is generated by the **Schreier loops**

  `k (s, q) = (t (s • q))⁻¹ * s * t q`,  `s ∈ S`, `q ∈ G • p`,

each of which carries `p` to `p`: `t (s • q) • p = s • q = s • (t q • p)`.

The statement is the point-stabilizer form of Schreier's lemma, the form in which the theorem is
used to compute the exact image of an integral stabilizer from finite orbit data: the transversal is
indexed by the orbit and the generators by the pairs `(s, q)`. Mathlib's Schreier lemma
(`Subgroup.closure_mul_image_eq`, `Mathlib/GroupTheory/Schreier.lean`) is stated for a right
transversal `R` of a subgroup with the generators `g * (toRightFun g)⁻¹` at `g ∈ R * S`. The proof
below is the telescoping argument on the transversal instead, because it needs no `IsComplement`
structure and no `toRightFun` computation: it inducts on the word in `S` read from the left,
maintaining `x = t (x • p) * u` with `u` in the closure of the loops, and concludes at `x = p`
where `t p = 1`.

## Search record (LC-09)

`scripts/formalization_corpus.py search` at the manifest head `6d97e8ad`, under the formulations
`Schreier lemma stabilizer generators`, `closure_mul_image_eq` and `point stabilizer Schreier
transversal`. Hits used: `Mathlib/GroupTheory/Schreier.lean` (the subgroup form, cited above) and
TauCeti `GroupTheory/Schreier.lean` (predecessor transversals and the sharp index formula, which
sharpens the same lemma and is not needed here). Hits inspected and not used: `kim-em/hex-dev`
`HexPermGroup/Orbit/Schreier.lean`, which proves the same loop family for `Equiv.Perm` inside its
own orbit-table machinery (`schreier`, `stabilizerGens`); it is a computable permutation-group
implementation, not a statement about an arbitrary `G`-set, so it does not subsume this theorem.

Symmetry of `S` (the hypothesis `S⁻¹ = S` under which the theorem is usually quoted) is not needed:
`Subgroup.closure_induction_left` handles the inverse letters directly. No finiteness of `S` or of
the orbit is needed either; with both finite, the loop family is finite, which is
`fg_stabilizer_of_finite_orbit`.
-/

@[expose] public section

open MulAction

namespace Subgroup

variable {G : Type*} [Group G] {α : Type*} [MulAction G α]

/-- **Schreier generators for a point stabilizer.** If `S` generates `G`, `t` is a transversal of
the orbit of `p` (`t q • p = q`, `t p = 1`), then the stabilizer of `p` is generated by the loops
`(t (s • q))⁻¹ * s * t q` for `s ∈ S` and `q` in the orbit of `p`. -/
theorem closure_schreierLoops_eq_stabilizer (S : Set G) (hS : closure S = ⊤) (p : α) (t : α → G)
    (ht : ∀ q, t q • p = q) (hp : t p = 1) :
    closure ((fun x : G × α => (t (x.1 • x.2))⁻¹ * x.1 * t x.2) '' (S ×ˢ orbit G p)) =
      stabilizer G p := by
  have hmem_orbit : ∀ q ∈ orbit G p, ∀ s ∈ S,
      (t (s • q))⁻¹ * s * t q ∈
        (fun x : G × α => (t (x.1 • x.2))⁻¹ * x.1 * t x.2) '' (S ×ˢ orbit G p) :=
    fun q hq s hs => ⟨(s, q), ⟨hs, hq⟩, rfl⟩
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    rintro - ⟨⟨s, q⟩, ⟨hs, hq⟩, rfl⟩
    simp only [SetLike.mem_coe, MulAction.mem_stabilizer_iff]
    -- the loop carries `p` to `p`: `t (s • q) • p = s • q = s • (t q • p)`
    set a := t (s • q) with ha
    have ha' : a • p = s • q := ht (s • q)
    rw [mul_smul, mul_smul, ht q, ← ha', ← mul_smul, inv_mul_cancel, one_smul]
  · intro g hg
    have hgen : g ∈ closure S := hS ▸ Subgroup.mem_top g
    -- Every element of the generated group is a loop word times the transversal element above the
    -- translate of `p` it reaches.
    have key : ∀ x ∈ closure S, ∀ q : α, x • p = q →
        ∃ u ∈ closure ((fun x : G × α => (t (x.1 • x.2))⁻¹ * x.1 * t x.2) '' (S ×ˢ orbit G p)),
          x = t q * u := by
      intro x hx
      induction hx using Subgroup.closure_induction_left with
      | one =>
        intro q hq
        refine ⟨1, one_mem _, ?_⟩
        rw [← hq, one_smul, hp, one_mul]
      | mul_left s hs x hx ih =>
        intro q hq
        have hxq : x • p = s⁻¹ • q := by
          rw [← hq, mul_smul, inv_smul_smul]
        obtain ⟨u, hu, hxu⟩ := ih (s⁻¹ • q) hxq
        refine ⟨((t q)⁻¹ * s * t (s⁻¹ • q)) * u, mul_mem (subset_closure ?_) hu, ?_⟩
        · refine ⟨(s, s⁻¹ • q), ⟨hs, mem_orbit_iff.mpr ⟨x, hxq⟩⟩, ?_⟩
          beta_reduce
          rw [smul_inv_smul]
        · rw [hxu]
          group
      | inv_mul_cancel s hs x hx ih =>
        intro q hq
        have hxq : x • p = s • q := by
          rw [← hq, mul_smul, smul_inv_smul]
        obtain ⟨u, hu, hxu⟩ := ih (s • q) hxq
        refine ⟨((t (s • q))⁻¹ * s * t q)⁻¹ * u, mul_mem (inv_mem (subset_closure ?_)) hu, ?_⟩
        · refine ⟨(s, q), ⟨hs, ?_⟩, ?_⟩
          · simpa using hq ▸ mem_orbit_iff.mpr ⟨s⁻¹ * x, rfl⟩
          · rfl
        · rw [hxu]
          group
    obtain ⟨u, hu, hgu⟩ := key g hgen p (MulAction.mem_stabilizer_iff.mp hg)
    rw [hp, one_mul] at hgu
    exact hgu ▸ hu

end Subgroup
