module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice

@[expose] public section

/-!
# Endomorphism-realization data for a generic Hecke algebra

Humphreys, *Reflection Groups and Coxeter Groups*, Section 7.3, p. 149
(FC15-C07-U010), takes the subalgebra of `End_A(E)` generated by the operators `lambda_s` and
evaluates an endomorphism at the distinguished basis vector `T_1`.

This file records those two definitions for supplied operators. The statements that evaluation is
an `A`-module isomorphism, that reduced-word products are independent of the word, and that the
transported multiplication realizes the generic algebra are results about this data.
-/

namespace LeanCategories.Hecke

variable {A E S : Type*} [CommRing A] [AddCommGroup E] [Module A E]

/-- The subalgebra of `End_A(E)` generated by the source's simple operators `lambda_s`. -/
def generatedEndomorphismAlgebra (lambda : S → Module.End A E) :
    Subalgebra A (Module.End A E) :=
  Algebra.adjoin A (Set.range lambda)

/-- Evaluation of the generated endomorphism algebra at the distinguished vector `T_1`. -/
def evaluationAt (lambda : S → Module.End A E) (T_one : E) :
    generatedEndomorphismAlgebra lambda →ₗ[A] E where
  toFun f := f.1 T_one
  map_add' f g := by simp
  map_smul' a f := by simp

end LeanCategories.Hecke
