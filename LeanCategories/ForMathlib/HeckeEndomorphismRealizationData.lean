module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.GroupTheory.Coxeter.Length
public import Mathlib.LinearAlgebra.Finsupp.LSum
public import Mathlib.LinearAlgebra.Finsupp.VectorSpace

@[expose] public section

/-!
# Generic helpers for endomorphism-realization data

Humphreys, *Reflection Groups and Coxeter Groups*, Section 7.3, p. 149
(FC15-C07-U010), takes the subalgebra of `End_A(E)` generated by the operators `lambda_s` and
evaluates an endomorphism at the distinguished basis vector `T_1`.

This file records the generic generated-subalgebra and evaluation operations for supplied
endomorphisms. It does not by itself realize FC15-C07-U010: that unit must apply these operations to
the specific operators `lambda_s` of FC15-C07-U007 and the basis vector `T_1` in the source's free
module. The statements that evaluation is an `A`-module isomorphism, that reduced-word products are
independent of the word, and that the transported multiplication realizes the generic algebra are
results about that specialized data.
-/

namespace LeanCategories.Hecke

variable {A E S : Type*} [CommRing A] [AddCommGroup E] [Module A E]

/-- The subalgebra of `End_A(E)` generated by the source's simple operators `lambda_s`. -/
def generatedEndomorphismAlgebra (lambda : S → Module.End A E) :
    Subalgebra A (Module.End A E) :=
  Algebra.adjoin A (Set.range lambda)

/-- Evaluation of the generated endomorphism algebra at the distinguished vector `T_1`. -/
def evaluationAt (lambda : S → Module.End A E) (T_one : E) :
    generatedEndomorphismAlgebra lambda →ₗ[A] E where
  toFun f := f.1 T_one
  map_add' f g := by simp
  map_smul' a f := by simp

/-- The free parameter module `E` with basis `T_w`. -/
abbrev GenericModule (A W : Type*) [CommRing A] := W →₀ A

noncomputable def genericLeftOnBasis
    {B W A : Type*} [Group W] [CommRing A] {M : CoxeterMatrix B}
    (cs : CoxeterSystem M W) (a b : B → A) (s : B) (w : W) : GenericModule A W := by
  classical
  let sw := cs.simple s * w
  exact if cs.length sw > cs.length w then
    Finsupp.single sw 1
  else
    Finsupp.single w (a s) + Finsupp.single sw (b s)

noncomputable def genericRightOnBasis
    {B W A : Type*} [Group W] [CommRing A] {M : CoxeterMatrix B}
    (cs : CoxeterSystem M W) (a b : B → A) (t : B) (w : W) : GenericModule A W := by
  classical
  let wt := w * cs.simple t
  exact if cs.length wt > cs.length w then
    Finsupp.single wt 1
  else
    Finsupp.single w (a t) + Finsupp.single wt (b t)

/-- Linear extension of the left generic basis rule, recorded as raw function data. -/
noncomputable def genericLeftOperator
    {B W A : Type*} [Group W] [CommRing A] {M : CoxeterMatrix B}
    (cs : CoxeterSystem M W) (a b : B → A) (s : B) (x : GenericModule A W) :
    GenericModule A W :=
  x.sum fun w c => c • genericLeftOnBasis cs a b s w

/-- Linear extension of the right generic basis rule, recorded as raw function data. -/
noncomputable def genericRightOperator
    {B W A : Type*} [Group W] [CommRing A] {M : CoxeterMatrix B}
    (cs : CoxeterSystem M W) (a b : B → A) (t : B) (x : GenericModule A W) :
    GenericModule A W :=
  x.sum fun w c => c • genericRightOnBasis cs a b t w

/-- Humphreys' left generic multiplication endomorphism `lambda_s`.

This is the native basis-linear extension of `genericLeftOnBasis`, so
its A-linearity is construction data rather than a separate theorem. -/
noncomputable def genericLeftEndomorphism
    {B W A : Type*} [Group W] [CommRing A] {M : CoxeterMatrix B}
    (cs : CoxeterSystem M W) (a b : B → A) (s : B) :
    Module.End A (GenericModule A W) :=
  (Finsupp.basisSingleOne (R := A)).constr A (genericLeftOnBasis cs a b s)

/-- Humphreys' right generic multiplication endomorphism `rho_t`. -/
noncomputable def genericRightEndomorphism
    {B W A : Type*} [Group W] [CommRing A] {M : CoxeterMatrix B}
    (cs : CoxeterSystem M W) (a b : B → A) (t : B) :
    Module.End A (GenericModule A W) :=
  (Finsupp.basisSingleOne (R := A)).constr A (genericRightOnBasis cs a b t)

end LeanCategories.Hecke
