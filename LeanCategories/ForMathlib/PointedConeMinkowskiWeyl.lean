/-!
# The Minkowski–Weyl theorem for finitely generated cones over `ℚ`

This file proves the Minkowski–Weyl theorem for pointed cones over the rationals: a cone is
finitely generated if and only if it is dually finitely generated, i.e. cut out by finitely many
linear inequalities. Both directions are proved.

## The mathematics

One direction is by the "add one inequality" lemma: if `C` is generated by a finite set `G` of
vectors and `φ` is a functional, then `C ∩ {x | φ x ≥ 0}` is generated by the elements of `G`
nonnegative under `φ`, together with the Fourier–Motzkin combinations
`φ(g_i) g_j - φ(g_j) g_i` of pairs on which `φ` has opposite signs. Iterating this over a finite
constraint set proves that every dually finitely generated cone is finitely generated.

The converse is by Fourier–Motzkin elimination of one variable at a time: the image of a dually
finitely generated cone under the projection forgetting one coordinate is again dually finitely
generated, the new constraints being the pairwise Fourier–Motzkin combinations of the old ones
with opposite sign in the eliminated coordinate. Since a finitely generated cone is the image of
the nonnegative orthant — a dually finitely generated cone — under a linear map, iterating the
elimination exhibits every finitely generated cone as dually finitely generated.

## References

* Günter M. Ziegler, *Lectures on Polytopes*, Graduate Texts in Mathematics 152, Springer, 1995,
  revised edition 1998, seventh updated printing 2007, Theorem 1.3, p. 30: the Minkowski–Weyl
  theorem for cones, by Fourier–Motzkin elimination.
* David Cox, John Little, Hal Schenck, *Toric Varieties*, Graduate Studies in Mathematics 124,
  American Mathematical Society, 2011, Definition 1.2.3 and Proposition 1.2.4, p. 24.
-/

@[expose] public section

open Submodule PointedCone Matrix

namespace LeanCategories.ForMathlib

section FMComb

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The Fourier–Motzkin combination of the coordinates `i` and `j` of `c` (with `c i > 0` and
`c j < 0`): the nonnegative vector with `c ⬝ᵥ w = 0`, supported on `i` (value `-c j`) and `j`
(value `c i`). -/
def fmComb (c : ι → ℚ) (i j : ι) : ι → ℚ :=
  fun k => if k = i then -c j else if k = j then c i else 0

theorem fmComb_left (c : ι → ℚ) (i j : ι) : fmComb c i j i = -c j := by
  show (if i = i then -c j else if i = j then c i else 0) = -c j
  rw [if_pos rfl]

theorem fmComb_right (c : ι → ℚ) (i j : ι) (hij : i ≠ j) : fmComb c i j j = c i := by
  show (if j = i then -c j else if j = j then c i else 0) = c i
  rw [if_neg (Ne.symm hij), if_pos rfl]

theorem fmComb_other (c : ι → ℚ) (i j k : ι) (hik : k ≠ i) (hkj : k ≠ j) :
    fmComb c i j k = 0 := by
  show (if k = i then -c j else if k = j then c i else 0) = 0
  rw [if_neg hik, if_neg hkj]

theorem fmComb_nonneg {c : ι → ℚ} {i j : ι} (hi : 0 < c i) (hj : c j < 0) :
    ∀ k, 0 ≤ fmComb c i j k := by
  have hij : i ≠ j := fun h => absurd hj (by rw [← h]; exact not_lt.2 (le_of_lt hi))
  intro k
  rcases eq_or_ne k i with hki | hki
  · rw [hki, fmComb_left]
    exact le_of_lt (neg_pos.mpr hj)
  · rcases eq_or_ne k j with hkj | hkj
    · rw [hkj, fmComb_right c i j hij]
      exact le_of_lt hi
    · rw [fmComb_other c i j k hki hkj]

end FMComb

section Kernel

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The Fourier–Motzkin combination is the combination of the unit vectors. -/
theorem fmComb_eq_combination (c : ι → ℚ) (i j : ι) (hij : i ≠ j) :
    fmComb c i j = (-c j) • Pi.single i (1 : ℚ) + (c i) • Pi.single j (1 : ℚ) := by
  funext k
  rcases eq_or_ne k i with hki | hki
  · rw [hki, fmComb_left]
    simp [Pi.single_apply, hij]
  · rcases eq_or_ne k j with hkj | hkj
    · rw [hkj, fmComb_right c i j hij]
      simp [Pi.single_apply, Ne.symm hij]
    · rw [fmComb_other c i j k hki hkj]
      simp [Pi.single_apply, hki, hkj]

/-- The Fourier–Motzkin combination lies in the kernel of `c`. -/
theorem fmComb_kernel (c : ι → ℚ) (i j : ι) (hij : i ≠ j) : c ⬝ᵥ fmComb c i j = 0 := by
  rw [fmComb_eq_combination c i j hij, dotProduct_add, dotProduct_smul,
    dotProduct_smul, dotProduct_single, dotProduct_single]
  rw [smul_eq_mul, smul_eq_mul]
  ring

end Kernel

section FMGen

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The generating set of the Fourier–Motzkin generators for `c`: the combinations of pairs of
coordinates with opposite signs, and the unit vectors of the nonnegative-`c` coordinates. -/
def fmGen (c : ι → ℚ) : Set (ι → ℚ) :=
  {w | ∃ i j, 0 < c i ∧ c j < 0 ∧ w = fmComb c i j} ∪
    {w | ∃ i, 0 ≤ c i ∧ w = Pi.single i (1 : ℚ)}

theorem fmComb_mem_fmGen {c : ι → ℚ} {i j : ι} (hi : 0 < c i) (hj : c j < 0) :
    fmComb c i j ∈ fmGen c :=
  Or.inl ⟨i, j, hi, hj, rfl⟩

theorem single_mem_fmGen {c : ι → ℚ} {i : ι} (hi : 0 ≤ c i) :
    Pi.single i (1 : ℚ) ∈ fmGen c :=
  Or.inr ⟨i, hi, rfl⟩

end FMGen

section LambdaLemma

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- **The λ-lemma, auxiliary form** (Ziegler, *Lectures on Polytopes*, Graduate Texts in
Mathematics 152, Springer, 1995, revised edition 1998, seventh updated printing 2007,
Theorem 1.3, p. 30, by Fourier–Motzkin elimination): every vector nonnegative on all
coordinates and under `c`, of support size at most `n`, lies in the cone generated by the
Fourier–Motzkin generators. The proof is a greedy induction: subtract a multiple of a
Fourier–Motzkin combination to reduce the support. -/
theorem lambda_lemma_aux (c : ι → ℚ) :
    ∀ (n : ℕ) (lam : ι → ℚ), (∀ i, 0 ≤ lam i) → 0 ≤ c ⬝ᵥ lam →
      (Finset.univ.filter (fun k => lam k ≠ 0)).card ≤ n →
      lam ∈ PointedCone.hull ℚ (fmGen c) := by
  intro n
  induction n with
  | zero =>
    intro lam h1 h2 hn
    have hfil : (Finset.univ.filter (fun k => lam k ≠ 0)) = ∅ :=
      Finset.card_eq_zero.mp (Nat.le_zero.mp hn)
    have h0 : ∀ k, lam k = 0 := by
      intro k
      have hk : ¬(lam k ≠ 0) := by
        intro hne
        exact absurd (Finset.mem_filter.mpr ⟨Finset.mem_univ k, hne⟩)
          (by rw [hfil]; exact Finset.notMem_empty k)
      exact not_not.mp hk
    have hlam0 : lam = 0 := funext h0
    rw [hlam0]
    exact Submodule.zero_mem _
  | succ n ih =>
    intro lam h1 h2 hn
    by_cases hbad : (Finset.univ.filter (fun k => lam k ≠ 0 ∧ c k < 0)).Nonempty
    · -- the greedy move
      obtain ⟨j₀, hj₀⟩ := hbad
      have hmem := Finset.mem_filter.mp hj₀
      have hlj : 0 < lam j₀ := lt_of_le_of_ne' (h1 j₀) hmem.2.1
      have hcj : c j₀ < 0 := hmem.2.2
      -- find a coordinate positive under both c and lam
      have hi₀ : ∃ i, 0 < c i ∧ 0 < lam i := by
        by_contra hno
        have hle : ∀ k, c k * lam k ≤ 0 := by
          intro k
          by_cases hck : 0 < c k
          · have hlk : lam k = 0 := by
              by_contra hne
              have hne2 : 0 < lam k := lt_of_le_of_ne' (h1 k) hne
              exact hno ⟨k, hck, hne2⟩
            rw [hlk, mul_zero]
          · have hck' : c k ≤ 0 := le_of_not_gt hck
            rcases eq_or_lt_of_le (h1 k) with h0 | hpos
            · rw [← h0, mul_zero]
            · have h3 : 0 ≤ -c k := neg_nonneg.mpr hck'
              have h4 : 0 ≤ (-c k) * lam k := mul_nonneg h3 (h1 k)
              have h5 : c k * lam k = -((-c k) * lam k) := by ring
              linarith
        have hrest : ∀ k ∈ (Finset.univ.erase j₀), c k * lam k ≤ 0 := by
          intro k _
          exact hle k
        have h1' : ∑ k ∈ (Finset.univ.erase j₀), c k * lam k ≤ 0 := Finset.sum_nonpos hrest
        have h2' : c j₀ * lam j₀ < 0 := by
          have h3 : 0 < -c j₀ := neg_pos.mpr hcj
          have h4 : 0 < (-c j₀) * lam j₀ := mul_pos h3 hlj
          have h5 : c j₀ * lam j₀ = -((-c j₀) * lam j₀) := by ring
          linarith
        have hsum : c ⬝ᵥ lam < 0 := by
          have hEq : ∑ k ∈ Finset.univ, c k * lam k =
              (∑ k ∈ (Finset.univ.erase j₀), c k * lam k) + c j₀ * lam j₀ :=
            (Finset.sum_erase_add Finset.univ (fun k => c k * lam k)
              (Finset.mem_univ j₀)).symm
          have hdot : c ⬝ᵥ lam = ∑ k ∈ Finset.univ, c k * lam k := rfl
          rw [hdot, hEq]
          linarith
        exact absurd h2 (not_le.2 hsum)
      obtain ⟨i₀, hci₀, hli₀⟩ := hi₀
      have hij₀ : i₀ ≠ j₀ := by
        intro h
        rw [h] at hci₀
        exact absurd hci₀ (not_lt.2 (le_of_lt hcj))
      -- the Fourier–Motzkin combination and the scaling
      set ν : ℚ := min (lam i₀ / (-c j₀)) (lam j₀ / c i₀) with hνdef
      have hνpos : 0 < ν :=
        lt_min_iff.mpr ⟨div_pos hli₀ (neg_pos.mpr hcj), div_pos hlj hci₀⟩
      set w : ι → ℚ := fmComb c i₀ j₀ with hwdef
      have hwmem : w ∈ fmGen c := fmComb_mem_fmGen hci₀ hcj
      have hwkernel : c ⬝ᵥ w = 0 := fmComb_kernel c i₀ j₀ hij₀
      have hwleft : w i₀ = -c j₀ := by rw [hwdef]; exact fmComb_left c i₀ j₀
      have hwright : w j₀ = c i₀ := by rw [hwdef]; exact fmComb_right c i₀ j₀ hij₀
      have hwother : ∀ k, k ≠ i₀ → k ≠ j₀ → w k = 0 := fun k hki hkj =>
        by rw [hwdef]; exact fmComb_other c i₀ j₀ k hki hkj
      set lam' : ι → ℚ := lam - ν • w with hlam'def
      -- (i) the new vector is nonnegative
      have hkey1 : ν * (-c j₀) ≤ lam i₀ :=
        (le_div_iff₀ (neg_pos.mpr hcj)).mp (min_le_left _ _)
      have hkey2 : ν * c i₀ ≤ lam j₀ := (le_div_iff₀ hci₀).mp (min_le_right _ _)
      have hl' : ∀ k, 0 ≤ lam' k := by
        intro k
        rcases eq_or_ne k i₀ with hki | hki
        · rw [hki, hlam'def]
          show lam i₀ - ν * w i₀ ≥ 0
          rw [hwleft]
          linarith
        · rcases eq_or_ne k j₀ with hkj | hkj
          · rw [hkj, hlam'def]
            show lam j₀ - ν * w j₀ ≥ 0
            rw [hwright]
            linarith
          · rw [hlam'def]
            show lam k - ν * w k ≥ 0
            rw [hwother k hki hkj]
            simp only [mul_zero, sub_zero]
            exact h1 k
      -- (ii) the new vector satisfies the constraint
      have hc' : 0 ≤ c ⬝ᵥ lam' := by
        rw [hlam'def, dotProduct_sub, dotProduct_smul, smul_eq_mul, hwkernel, mul_zero, sub_zero]
        exact h2
      -- (iii) the support shrinks
      have hnonnegw : ∀ k, 0 ≤ ν * w k := fun k =>
        mul_nonneg (le_of_lt hνpos) (fmComb_nonneg hci₀ hcj k)
      have hle : ∀ k, lam' k ≤ lam k := by
        intro k
        rw [hlam'def]
        show lam k - ν * w k ≤ lam k
        linarith [hnonnegw k]
      have hkill : ∃ killed, lam' killed = 0 ∧ 0 < lam killed := by
        rcases min_choice (lam i₀ / (-c j₀)) (lam j₀ / c i₀) with hch | hch
        · refine ⟨i₀, ?_, hli₀⟩
          rw [hlam'def]
          show lam i₀ - ν * w i₀ = 0
          rw [hwleft, hνdef, hch, div_mul_cancel₀ _ (neg_ne_zero.mpr (ne_of_lt hcj))]
          ring
        · refine ⟨j₀, ?_, hlj⟩
          rw [hlam'def]
          show lam j₀ - ν * w j₀ = 0
          rw [hwright, hνdef, hch, div_mul_cancel₀ _ (ne_of_gt hci₀)]
          ring
      obtain ⟨killed, hkilled, hklam⟩ := hkill
      have hsub : (Finset.univ.filter (fun k => lam' k ≠ 0)) ⊆
          (Finset.univ.filter (fun k => lam k ≠ 0)).erase killed := by
        intro k hk
        have hklam' : lam' k ≠ 0 := by
          rw [Finset.mem_filter] at hk
          exact hk.2
        rw [Finset.mem_erase, Finset.mem_filter]
        refine ⟨?_, Finset.mem_univ k, ?_⟩
        · intro h
          rw [h] at hklam'
          exact hklam' hkilled
        · intro hne
          have hpos' : 0 < lam' k := lt_of_le_of_ne' (hl' k) hklam'
          have hkltp : 0 < lam k := lt_of_lt_of_le hpos' (hle k)
          exact (ne_of_gt hkltp) hne
      have hcard := Finset.card_le_card hsub
      rw [Finset.card_erase_of_mem
        (Finset.mem_filter.mpr ⟨Finset.mem_univ killed,
          (ne_of_gt hklam : lam killed ≠ 0)⟩)] at hcard
      -- the representation
      have hrep : lam = ν • w + lam' := by
        rw [hlam'def]
        funext k
        show lam k = ν * w k + (lam k - ν * w k)
        ring
      have hwinspan : w ∈ PointedCone.hull ℚ (fmGen c) := Submodule.subset_span hwmem
      have hm1sub : (⟨ν, le_of_lt hνpos⟩ : {c : ℚ // 0 ≤ c}) • w ∈
          PointedCone.hull ℚ (fmGen c) := by
        apply Submodule.smul_mem
        exact hwinspan
      have hm1 : ν • w ∈ PointedCone.hull ℚ (fmGen c) := by
        rw [Nonneg.mk_smul] at hm1sub
        exact hm1sub
      have hm2 := ih lam' hl' hc' (by omega)
      rw [hrep]
      apply Submodule.add_mem
      · exact hm1
      · exact hm2
    · -- the base case: no bad coordinates
      have hkmem : ∀ k, ¬(lam k ≠ 0 ∧ c k < 0) := by
        intro k hpair
        exact hbad ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_univ k, hpair⟩⟩
      have hck : ∀ k, lam k ≠ 0 → 0 ≤ c k := by
        intro k hk
        by_contra hc
        exact hkmem k ⟨hk, lt_of_not_ge hc⟩
      -- the sum decomposition
      have hval : ∀ k j, (lam k • (Pi.single k (1 : ℚ) : ι → ℚ)) j =
          if j = k then lam k else 0 := by
        intro k j
        show lam k * ((Pi.single k (1 : ℚ) : ι → ℚ) j) = if j = k then lam k else 0
        by_cases hk : j = k
        · simp [Pi.single_apply, hk]
        · simp [Pi.single_apply, hk]
      have hdec : lam = ∑ k, lam k • Pi.single k (1 : ℚ) := by
        funext j
        rw [Finset.sum_apply, Finset.sum_congr rfl (fun k _ => hval k j)]
        rw [Finset.sum_eq_single_of_mem j (Finset.mem_univ j)
          (by intro k _ hk; rw [if_neg (Ne.symm hk)])]
        simp
      rw [hdec]
      refine Submodule.sum_mem _ ?_
      intro k _hk
      by_cases hk : lam k = 0
      · rw [hk, zero_smul]
        exact Submodule.zero_mem _
      · have hgen : Pi.single k (1 : ℚ) ∈ fmGen c := single_mem_fmGen (hck k hk)
        have hwinspan : Pi.single k (1 : ℚ) ∈ PointedCone.hull ℚ (fmGen c) :=
          Submodule.subset_span hgen
        have hmem : (⟨lam k, h1 k⟩ : {c : ℚ // 0 ≤ c}) • Pi.single k (1 : ℚ) ∈
            PointedCone.hull ℚ (fmGen c) := by
          apply Submodule.smul_mem
          exact hwinspan
        rw [Nonneg.mk_smul] at hmem
        exact hmem

/-- **The λ-lemma** (Ziegler, *Lectures on Polytopes*, Graduate Texts in Mathematics 152,
Springer, 1995, revised edition 1998, seventh updated printing 2007, Theorem 1.3, p. 30, by
Fourier–Motzkin elimination): every vector that is nonnegative on all coordinates and under
`c` lies in the cone generated by the Fourier–Motzkin generators. -/
theorem lambda_lemma (c : ι → ℚ) (lam : ι → ℚ) (h1 : ∀ i, 0 ≤ lam i) (h2 : 0 ≤ c ⬝ᵥ lam) :
    lam ∈ PointedCone.hull ℚ (fmGen c) :=
  lambda_lemma_aux c (Finset.univ.filter (fun k => lam k ≠ 0)).card lam h1 h2 (le_refl _)

end LambdaLemma

end LeanCategories.ForMathlib
