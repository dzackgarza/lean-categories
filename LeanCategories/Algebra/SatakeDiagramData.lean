/-!
# Satake diagrams as admissible pairs of a finite-type Cartan matrix (#86)

S. Kolb, *Quantum symmetric Kac--Moody pairs*, Adv. Math. 267 (2014), Definition 2.3
(arXiv:1207.6036v2, p. 9):
a pair `(X, τ)` consisting of a subset `X` of the vertex set `I` of a Dynkin diagram and an
element `τ ∈ Aut(A, X)` is **admissible** when

1. `X` is of finite type;
2. `τ ∈ Aut(A, X)` and `τ² = id_I` (source conditions (i)-(1));
3. the action of `τ` on `X` coincides with that of `-w_X`, where `w_X` is the longest element of
   the parabolic subgroup `W_X` (source condition (2));
4. `α_j(ρ^∨_X) ∈ ℤ` for every `τ`-fixed `j ∈ I \ X`, with `2ρ^∨_X` the sum of the positive
   coroots of `Φ_X` (source condition (3), and Proposition 2.2.(2)).

These are Araki's Satake diagrams (S. Araki, *On root systems and an infinitesimal classification
of irreducible symmetric spaces*, J. Math. Osaka City Univ. 13 (1962), pp. 32--33) in the form used
for symmetric pairs; Kolb, *op. cit.*, Example 2.4 (arXiv:1207.6036v2, p. 10) computes four of them
for `sl₄` and the
probes at the end of this file reproduce that example.

## What is formalized here, and at what level

`A : Matrix ι ι ℤ` is the Cartan matrix of a finite-type root basis (issue #86), `X : Finset ι`
its black nodes and `τ : Equiv.Perm ι` the diagram permutation. The presentation is combinatorial,
as in the source: no Lie algebra, root system or Weyl group of `A` itself is built, only

* the root lattice `ℤΠ` (`CartanRootLattice`), its simple roots and the simple reflections of `A`
  (`cartanReflection`), hence the parabolic Weyl group `W_X` (`subdiagramWeylGroup`), as the
  subgroup of `GL(ℤΠ)` generated by the reflections `s_i`, `i ∈ X`;
* the longest element `w_X`, through the characterization used in the source's own proof
  (Bourbaki, *Lie Groups and Lie Algebras*, Ch. IV--VI, V §6.2, Cor. 3 and its proof): `w_X` is the
  unique element of `W_X` sending every simple root of `X` to a negative root.  Uniqueness is
  cited, not reproved: `IsLongestElementOfSubdiagram` is the *predicate*, and the source's
  condition (2) is stated with an existential witness of it, which is equivalent to condition (2)
  only because of that cited uniqueness.

`ρ^∨_X` is the sum of the fundamental coweights of the sub-diagram, characterized by
`α_k(ρ^∨_X) = 1` for `k ∈ X`; `HasIntegralParabolicZeroWeight` states source condition (3) with
that characterization (`m`) as data rather than through a matrix inverse, so no total convention of
a partial operation (`Matrix.nonsingular_inv` off `GL`) is used anywhere (CONTRIBUTING.md, LC-14).

The category of Satake diagrams (issue #86, item 1) is at the end of the file: its objects carry
the admissible-pair datum, and its morphisms are the diagram isomorphisms preserving the black
nodes and commuting with `τ`.
-/

@[expose] public noncomputable section

open scoped BigOperators

namespace LeanCategories.Algebra

universe u

variable {ι : Type u}

/-! ## The root lattice, its simple roots and the simple reflections -/

/-- Simple-root coordinates: the root lattice `ℤΠ` of a Cartan matrix on the index set `ι`. -/
abbrev CartanRootLattice (ι : Type u) : Type u := ι → ℤ

/-- The `i`-th simple root `α_i`, in simple-root coordinates. -/
def cartanSimpleRoot [DecidableEq ι] (i : ι) : CartanRootLattice ι :=
  Pi.single i 1

@[simp]
theorem cartanSimpleRoot_apply [DecidableEq ι] (i j : ι) :
    cartanSimpleRoot (ι := ι) i j = if j = i then (1 : ℤ) else 0 :=
  Pi.single_apply i 1 j

/-- The coroot pairing `⟨v, α_i^∨⟩` of a root-lattice vector with the `i`-th simple coroot,
computed from the Cartan matrix: `⟨v, α_i^∨⟩ = Σ_j v_j a_{ji}`. -/
def cartanCorootPairing [Fintype ι] (A : Matrix ι ι ℤ) (v : CartanRootLattice ι) (i : ι) : ℤ :=
  ∑ j, v j * A j i

/-- The coroot pairing is additive in the vector. -/
theorem cartanCorootPairing_sub [Fintype ι] (A : Matrix ι ι ℤ) (v w : CartanRootLattice ι)
    (i : ι) :
    cartanCorootPairing A (v - w) i = cartanCorootPairing A v i - cartanCorootPairing A w i := by
  simp [cartanCorootPairing, sub_mul, Finset.sum_sub_distrib]

/-- The `i`-th simple reflection of the root lattice, `s_i v = v - ⟨v, α_i^∨⟩ α_i`. -/
def cartanReflection [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) (i : ι) :
    CartanRootLattice ι →ₗ[ℤ] CartanRootLattice ι where
  toFun v := v - cartanCorootPairing A v i • cartanSimpleRoot i
  map_add' v w := by
    simp only [Pi.add_apply, cartanCorootPairing, add_mul, Finset.sum_add_distrib, add_smul,
      add_sub_add_comm]
  map_smul' c v := by
    funext k
    have hsum : (∑ x, (c * v x) * A x i) = c * ∑ x, v x * A x i := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun x _ => by ring
    simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, cartanCorootPairing,
      cartanSimpleRoot_apply, hsum, RingHom.id_apply]
    ring

@[simp]
theorem cartanReflection_apply [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) (i : ι)
    (v : CartanRootLattice ι) :
    cartanReflection A i v = v - cartanCorootPairing A v i • cartanSimpleRoot i :=
  rfl

/-- The coroot pairing of a vector supported at `i` reads off the `i`-th Cartan entry. -/
theorem cartanCorootPairing_smul_single [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ)
    (i : ι) (c : ℤ) :
    cartanCorootPairing A (c • cartanSimpleRoot i) i = c * A i i := by
  rw [cartanCorootPairing]
  rw [Finset.sum_eq_single i]
  · simp
  · intro b _ hb
    simp [hb]
  · intro hi
    exact absurd (Finset.mem_univ i) hi

/-- A simple reflection is an involution when the diagonal Cartan entry is `2`. -/
theorem cartanReflection_involutive [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ)
    {i : ι} (hdiag : A i i = 2) :
    Function.Involutive (cartanReflection A i) := by
  intro v
  have hpair : cartanCorootPairing A (cartanReflection A i v) i =
      -cartanCorootPairing A v i := by
    rw [cartanReflection_apply, cartanCorootPairing_sub, cartanCorootPairing_smul_single, hdiag]
    ring
  rw [cartanReflection_apply, hpair, neg_smul]
  simp [cartanReflection_apply]

/-- The `i`-th simple reflection, as an automorphism of the root lattice. -/
def cartanReflectionEquiv [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) (i : ι)
    (hdiag : A i i = 2) : CartanRootLattice ι ≃ₗ[ℤ] CartanRootLattice ι :=
  LinearEquiv.ofInvolutive (cartanReflection A i) (cartanReflection_involutive A hdiag)

@[simp]
theorem cartanReflectionEquiv_apply [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) (i : ι)
    (hdiag : A i i = 2) (v : CartanRootLattice ι) :
    cartanReflectionEquiv A i hdiag v = cartanReflection A i v :=
  rfl


/-! ## The Weyl group of a sub-diagram and its longest element -/

/-- The parabolic Weyl group `W_X`: the subgroup of `GL(ℤΠ)` generated by the simple reflections
at the vertices of the black nodes `X`. -/
def subdiagramWeylGroup [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) (X : Finset ι)
    (hdiag : ∀ i ∈ X, A i i = 2) :
    Subgroup (CartanRootLattice ι ≃ₗ[ℤ] CartanRootLattice ι) :=
  Subgroup.closure {w | ∃ i, ∃ hi : i ∈ X, w = cartanReflectionEquiv A i (hdiag i hi)}

/-- A simple reflection at a black node lies in `W_X`. -/
theorem cartanReflectionEquiv_mem_subdiagramWeylGroup [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℤ) {X : Finset ι} {hdiag : ∀ i ∈ X, A i i = 2} {i : ι} (hi : i ∈ X) :
    cartanReflectionEquiv A i (hdiag i hi) ∈ subdiagramWeylGroup A X hdiag :=
  Subgroup.subset_closure ⟨i, hi, rfl⟩

/-- The longest element `w_X` of the parabolic Weyl group, presented by the characterization used in
the proof of Bourbaki, *Lie Groups and Lie Algebras*, Ch. IV--VI, V §6.2, Cor. 3: `w_X` is the
element of `W_X` that sends every simple root of `X` to a negative root.  (Loc. cit. also states
that this element exists and is unique; existence and uniqueness are cited, not reproved.)

In simple-root coordinates "negative root" is "every coordinate `≤ 0`", because the roots of a
finite-type diagram are exactly the non-negative or non-positive integer combinations of its
simple roots, and a Weyl group element carries simple roots to roots. -/
def IsLongestElementOfSubdiagram [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) (X : Finset ι)
    (hdiag : ∀ i ∈ X, A i i = 2) (w : CartanRootLattice ι ≃ₗ[ℤ] CartanRootLattice ι) : Prop :=
  w ∈ subdiagramWeylGroup A X hdiag ∧ ∀ i ∈ X, ∀ k, w (cartanSimpleRoot i) k ≤ 0

/-- Source condition (2) of Kolb's Definition 2.3: the action of `τ` on `X` coincides with the
action of `-w_X`.  Both sides are endomorphisms of the span of `X`; the condition is the equality
of their values on the basis `{α_i : i ∈ X}`, namely `-w_X(α_i) = α_{τ i}` for every `i ∈ X`. -/
def AgreesWithNegativeLongestElement [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ)
    (X : Finset ι) (hdiag : ∀ i ∈ X, A i i = 2) (τ : Equiv.Perm ι) : Prop :=
  ∃ w, IsLongestElementOfSubdiagram A X hdiag w ∧
    ∀ i ∈ X, w (cartanSimpleRoot i) = -cartanSimpleRoot (τ i)

/-! ## Diagram automorphisms and the black nodes -/

/-- A diagram automorphism of `A`: a permutation of the vertices with `a_{τ i, τ j} = a_{ij}`
(Kolb, *op. cit.*, §2.2). -/
def IsDiagramAutomorphism (A : Matrix ι ι ℤ) (τ : Equiv.Perm ι) : Prop :=
  ∀ i j, A (τ i) (τ j) = A i j

/-- `τ ∈ Aut(A, X)`: the diagram automorphism preserves the set of black nodes, `τ(X) = X`. -/
def PreservesSubdiagram (τ : Equiv.Perm ι) (X : Finset ι) : Prop :=
  ∀ i, (i ∈ X ↔ τ i ∈ X)

/-- For a permutation, preservation of the black-node set is stability under both `τ` and `τ⁻¹`. -/
theorem preservesSubdiagram_iff (τ : Equiv.Perm ι) (X : Finset ι) :
    PreservesSubdiagram τ X ↔ (∀ i ∈ X, τ i ∈ X) ∧ ∀ i ∈ X, τ⁻¹ i ∈ X := by
  constructor
  · intro h
    exact ⟨fun i hi => (h i).mp hi, fun i hi => (h (τ⁻¹ i)).mpr (by simpa using hi)⟩
  · rintro ⟨h₁, h₂⟩ i
    refine ⟨h₁ i, fun hi => ?_⟩
    have := h₂ (τ i) hi
    simpa using this

/-- A diagram automorphism is inverted by applying it to the other factor. -/
theorem isDiagramAutomorphism_inv {A : Matrix ι ι ℤ} {τ : Equiv.Perm ι}
    (h : IsDiagramAutomorphism A τ) : IsDiagramAutomorphism A τ⁻¹ := by
  intro i j
  have := h (τ⁻¹ i) (τ⁻¹ j)
  simpa using this.symm

/-! ## Finite-type Cartan matrices and their sub-diagrams -/

/-- A generalized Cartan matrix in Kac's sense (Kac, *Infinite-dimensional Lie algebras*, §1.1):
`a_{ii} = 2`, `a_{ij} ≤ 0` for `i ≠ j`, and `a_{ij} = 0` if and only if `a_{ji} = 0`. -/
structure IsGeneralizedCartanMatrix (A : Matrix ι ι ℤ) : Prop where
  diagonal : ∀ i, A i i = 2
  offDiagonal_nonpos : ∀ i j, i ≠ j → A i j ≤ 0
  vanishes_iff : ∀ i j, A i j = 0 ↔ A j i = 0

/-- The quadratic form of the diagonal rescaling `A · diag d`, namely
`q(v) = Σ_i Σ_j v_i v_j a_{ij} d_j`.  For a symmmetrizable generalized Cartan matrix, `q` (with the
symmetrizing `d`) is positive definite exactly in finite type (Kac, *op. cit.*, Ch. 4, Thm. 4.3). -/
def cartanQuadraticForm [Fintype ι] (A : Matrix ι ι ℤ) (d : ι → ℚ) (v : ι → ℚ) : ℚ :=
  ∑ i, ∑ j, v i * v j * ((A i j : ℚ) * d j)

/-- A finite-type Cartan matrix: a generalized Cartan matrix that becomes positive definite after a
positive diagonal rescaling (Kac, *op. cit.*, Ch. 4, Thm. 4.3). -/
structure IsFiniteTypeCartanMatrix [Fintype ι] (A : Matrix ι ι ℤ) : Prop where
  gcm : IsGeneralizedCartanMatrix A
  positiveDefinite : ∃ d : ι → ℚ, (∀ i, 0 < d i) ∧
    ∀ v : ι → ℚ, v ≠ 0 → 0 < cartanQuadraticForm A d v

/-- `X` is of finite type: its principal submatrix is a finite-type Cartan matrix, i.e. it satisfies
the generalized Cartan matrix axioms on `X` and its rescaled form is positive definite on the
coordinate subspace of `X`.  The subspace of `ℚ^ι` is used instead of the subtype `↥X` so that the
sums stay over the ambient index set, which is what makes the criterion pass to sub-diagrams and
transport along diagram automorphisms. -/
structure IsFiniteTypeSubdiagram [Fintype ι] (A : Matrix ι ι ℤ) (X : Finset ι) : Prop where
  diagonal : ∀ i ∈ X, A i i = 2
  offDiagonal_nonpos : ∀ i ∈ X, ∀ j ∈ X, i ≠ j → A i j ≤ 0
  vanishes_iff : ∀ i ∈ X, ∀ j ∈ X, A i j = 0 ↔ A j i = 0
  positiveDefinite : ∃ d : ι → ℚ, (∀ i, 0 < d i) ∧
    ∀ v : ι → ℚ, (∀ i, i ∉ X → v i = 0) → v ≠ 0 → 0 < cartanQuadraticForm A d v

/-- In a finite-type Cartan matrix every sub-diagram is of finite type (a principal submatrix of a
positive definite matrix is positive definite). -/
theorem IsFiniteTypeCartanMatrix.isFiniteTypeSubdiagram [Fintype ι] {A : Matrix ι ι ℤ}
    (h : IsFiniteTypeCartanMatrix A) (X : Finset ι) : IsFiniteTypeSubdiagram A X where
  diagonal i _ := h.gcm.diagonal i
  offDiagonal_nonpos i _ j _ hij := h.gcm.offDiagonal_nonpos i j hij
  vanishes_iff i _ j _ := h.gcm.vanishes_iff i j
  positiveDefinite := by
    obtain ⟨d, hd, hpd⟩ := h.positiveDefinite
    exact ⟨d, hd, fun v _ hv => hpd v hv⟩

/-- The empty sub-diagram is of finite type. -/
theorem isFiniteTypeSubdiagram_empty [Fintype ι] (A : Matrix ι ι ℤ) :
    IsFiniteTypeSubdiagram A ∅ where
  diagonal i hi := absurd hi (Finset.notMem_empty i)
  offDiagonal_nonpos i hi := absurd hi (Finset.notMem_empty i)
  vanishes_iff i hi := absurd hi (Finset.notMem_empty i)
  positiveDefinite := by
    refine ⟨fun _ => 1, fun _ => one_pos, fun v hv hv0 => ?_⟩
    exact absurd (funext fun i => hv i (Finset.notMem_empty i)) hv0

/-! ## The parabolic Weyl vector `ρ^∨_X` -/

/-- The coefficients `m` of the parabolic Weyl vector on the simple coroots of `X`:
`ρ^∨_X = Σ_k m_k α_k^∨` is characterized by `α_k(ρ^∨_X) = 1` for every `k ∈ X`, i.e.
`Σ_l a_{kl} m_l = 1`.  This is the element of Kolb, *op. cit.*, Proposition 2.2.(2), where `2ρ^∨_X`
is the sum of the positive coroots of `Φ_X`. -/
def IsParabolicWeylVectorCoefficient [Fintype ι] (A : Matrix ι ι ℤ) (X : Finset ι)
    (m : ↥X → ℚ) : Prop :=
  ∀ k : ↥X, ∑ l : ↥X, ((A k.1 l.1 : ℚ) * m l) = 1

/-- Source condition (3) of Kolb's Definition 2.3: `α_j(ρ^∨_X) ∈ ℤ` for every `τ`-fixed vertex
`j ∉ X`.  `ρ^∨_X` is presented by its defining equations (`IsParabolicWeylVectorCoefficient`)
rather than by the inverse of the parabolic Cartan matrix, which is not defined off `GL`. -/
def HasIntegralParabolicWeylPairing [Fintype ι] (A : Matrix ι ι ℤ) (X : Finset ι)
    (τ : Equiv.Perm ι) : Prop :=
  ∃ m : ↥X → ℚ, IsParabolicWeylVectorCoefficient A X m ∧
    ∀ j, j ∉ X → τ j = j → ∃ z : ℤ, (z : ℚ) = ∑ k : ↥X, m k * (A j k.1 : ℚ)

/-! ## Admissible pairs -/

/-- **A Satake diagram**, in Kolb's form: an admissible pair `(X, τ)` of a finite-type Cartan
matrix `A` (Kolb, *Quantum symmetric Kac--Moody pairs*, Adv. Math. 267 (2014), Definition 2.3,
arXiv:1207.6036v2, p. 9; the finite-type case of Araki, *On root systems and an infinitesimal
classification of irreducible symmetric spaces*, J. Math. Osaka City Univ. 13 (1962),
pp. 32--33). -/
structure IsAdmissiblePair [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) (X : Finset ι)
    (τ : Equiv.Perm ι) : Prop where
  /-- Condition (i): the black nodes are of finite type. -/
  finiteType : IsFiniteTypeSubdiagram A X
  /-- `τ` is a diagram automorphism and preserves the black nodes: `τ ∈ Aut(A, X)`. -/
  preservesCartan : IsDiagramAutomorphism A τ
  preservesSubdiagram : PreservesSubdiagram τ X
  /-- Source condition (1): `τ² = id`. -/
  involutive : τ * τ = 1
  /-- Source condition (2): `τ` agrees with `-w_X` on `X`. -/
  agreesWithLongestElement : AgreesWithNegativeLongestElement A X finiteType.diagonal τ
  /-- Source condition (3): `α_j(ρ^∨_X) ∈ ℤ` for every `τ`-fixed `j ∉ X`. -/
  integralZeroWeight : HasIntegralParabolicWeylPairing A X τ

/-- **The split Satake diagram**: no black nodes and trivial `τ`.  Conditions (2) and (3) are
vacuous because `X = ∅` and `ρ^∨_∅ = 0`, and condition (i) is `isFiniteTypeSubdiagram_empty`; no
hypothesis on the ambient matrix is used, which is why the theorem is stated without the issue's
standing hypothesis that `A` is of finite type. -/
theorem isAdmissiblePair_empty [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) :
    IsAdmissiblePair A ∅ 1 where
  finiteType := isFiniteTypeSubdiagram_empty A
  preservesCartan := fun i j => by simp
  preservesSubdiagram := fun i => by simp
  involutive := by simp
  agreesWithLongestElement := by
    refine ⟨1, ⟨one_mem _, fun i hi => absurd hi (Finset.notMem_empty i)⟩, ?_⟩
    intro i hi
    exact absurd hi (Finset.notMem_empty i)
  integralZeroWeight := by
    have : IsEmpty ↥(∅ : Finset ι) := ⟨fun x => absurd x.2 (Finset.notMem_empty x.1)⟩
    refine ⟨fun _ => 0, fun k => absurd k.2 (Finset.notMem_empty k.1), ?_⟩
    intro j _ _
    exact ⟨0, by simp⟩


/-! ## Smallest diagrams: Kolb's Example 2.4 and the split and compact forms -/

/-- The coroot pairing against a simple root reads off a Cartan entry, `<α_j, α_i^∨> = a_{ji}`. -/
theorem cartanCorootPairing_simpleRoot [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) (i j : ι) :
    cartanCorootPairing A (cartanSimpleRoot j) i = A j i := by
  rw [cartanCorootPairing]
  rw [Finset.sum_eq_single j]
  · simp
  · intro b _ hb
    simp [hb]
  · intro h
    exact absurd (Finset.mem_univ j) h

/-- A simple reflection acts on a simple root by the coroot pairing. -/
theorem cartanReflection_simpleRoot [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) (i j : ι) :
    cartanReflection A i (cartanSimpleRoot j) =
      cartanSimpleRoot j - (A j i) • cartanSimpleRoot i := by
  rw [cartanReflection_apply, cartanCorootPairing_simpleRoot]

/-- A simple reflection sends its own simple root to its negative. -/
theorem cartanReflection_simpleRoot_self [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) {i : ι}
    (h : A i i = 2) : cartanReflection A i (cartanSimpleRoot i) = -cartanSimpleRoot i := by
  rw [cartanReflection_simpleRoot, h, two_smul]
  abel

/-- On a pair of unjoined nodes the product of the two simple reflections negates each of the two
simple roots; this is the longest element of `W_X` for `X = {i, j}` with `a_{ij} = a_{ji} = 0`, the
diagram being `A₁ ⊕ A₁`. -/
theorem cartanReflection_mul_simpleRoot_of_disjoint [Fintype ι] [DecidableEq ι]
    (A : Matrix ι ι ℤ) {i j : ι} (hii : A i i = 2) (hjj : A j j = 2) (hij : A i j = 0)
    (hji : A j i = 0) :
    (cartanReflectionEquiv A i hii * cartanReflectionEquiv A j hjj) (cartanSimpleRoot i) =
        -cartanSimpleRoot i ∧
      (cartanReflectionEquiv A i hii * cartanReflectionEquiv A j hjj) (cartanSimpleRoot j) =
        -cartanSimpleRoot j := by
  constructor
  · rw [mul_apply_eq_comp, cartanReflectionEquiv_apply, cartanReflectionEquiv_apply,
      cartanReflection_simpleRoot, hij, zero_smul, sub_zero, cartanReflection_simpleRoot_self _ hii]
  · rw [mul_apply_eq_comp, cartanReflectionEquiv_apply, cartanReflectionEquiv_apply,
      cartanReflection_simpleRoot_self _ hjj, map_neg, cartanReflection_simpleRoot, hji, zero_smul,
      sub_zero]

/-- A sum supported in a single coordinate is the value at that coordinate. -/
theorem sum_eq_of_support_singleton [Fintype ι] {f : ι → ℚ} {i : ι}
    (h : ∀ k, k ∉ ({i} : Finset ι) → f k = 0) : ∑ k, f k = f i := by
  rw [← Finset.sum_subset (Finset.subset_univ _) (fun x _ hx => h x hx),
    Finset.sum_singleton]

/-- A sum supported in a pair of coordinates is the sum of the two values. -/
theorem sum_eq_of_support_pair [Fintype ι] [DecidableEq ι] {f : ι → ℚ} {i j : ι} (hij : i ≠ j)
    (h : ∀ k, k ∉ ({i, j} : Finset ι) → f k = 0) : ∑ k, f k = f i + f j := by
  rw [← Finset.sum_subset (Finset.subset_univ _) (fun x _ hx => h x hx), Finset.sum_pair hij]

/-- A single black node with Cartan entry `2` is of finite type. -/
theorem isFiniteTypeSubdiagram_singleton [Fintype ι] (A : Matrix ι ι ℤ) {i : ι}
    (h : A i i = 2) : IsFiniteTypeSubdiagram A {i} where
  diagonal k hk := by rw [Finset.mem_singleton.mp hk]; exact h
  offDiagonal_nonpos k hk l hl hkl := by
    rw [Finset.mem_singleton.mp hk, Finset.mem_singleton.mp hl] at hkl
    exact absurd rfl hkl
  vanishes_iff k hk l hl := by
    rw [Finset.mem_singleton.mp hk, Finset.mem_singleton.mp hl]
  positiveDefinite := by
    refine ⟨fun _ => 1, fun _ => one_pos, fun v hv hv0 => ?_⟩
    have hvi : v i ≠ 0 := by
      intro h0
      apply hv0
      funext k
      by_cases hk : k = i
      · rw [hk, h0]; rfl
      · exact hv k (by simpa using hk)
    have key : cartanQuadraticForm A (fun _ => 1) v = 2 * v i ^ 2 := by
      rw [cartanQuadraticForm]
      have hinner : ∀ k, (∑ l, v k * v l * ((A k l : ℚ) * 1)) = v k * v i * ((A k i : ℚ) * 1) := by
        intro k
        exact sum_eq_of_support_singleton fun t ht => by rw [hv t ht]; ring
      simp only [hinner]
      rw [sum_eq_of_support_singleton (i := i) (fun t ht => by rw [hv t ht]; ring),
        show ((A i i : ℤ) : ℚ) = 2 from by rw [h]; norm_num]
      ring
    rw [key]
    nlinarith [mul_self_pos.mpr hvi]

/-- Two black nodes with diagonal entries `2` and no edge between them are of finite type. -/
theorem isFiniteTypeSubdiagram_pair [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℤ) {i j : ι}
    (hij : i ≠ j)
    (hi : A i i = 2) (hj : A j j = 2) (hij0 : A i j = 0) (hji0 : A j i = 0) :
    IsFiniteTypeSubdiagram A {i, j} where
  diagonal k hk := by
    have hk' : k = i ∨ k = j := by
      rcases Finset.mem_insert.mp hk with h | h
      · exact Or.inl h
      · exact Or.inr (Finset.mem_singleton.mp h)
    rcases hk' with rfl | rfl
    · exact hi
    · exact hj
  offDiagonal_nonpos k hk l hl hkl := by
    have hk' : k = i ∨ k = j := by
      rcases Finset.mem_insert.mp hk with h | h
      · exact Or.inl h
      · exact Or.inr (Finset.mem_singleton.mp h)
    have hl' : l = i ∨ l = j := by
      rcases Finset.mem_insert.mp hl with h | h
      · exact Or.inl h
      · exact Or.inr (Finset.mem_singleton.mp h)
    rcases hk' with rfl | rfl <;> rcases hl' with rfl | rfl
    · exact absurd rfl hkl
    · rw [hij0]
    · rw [hji0]
    · exact absurd rfl hkl
  vanishes_iff k hk l hl := by
    have hk' : k = i ∨ k = j := by
      rcases Finset.mem_insert.mp hk with h | h
      · exact Or.inl h
      · exact Or.inr (Finset.mem_singleton.mp h)
    have hl' : l = i ∨ l = j := by
      rcases Finset.mem_insert.mp hl with h | h
      · exact Or.inl h
      · exact Or.inr (Finset.mem_singleton.mp h)
    rcases hk' with rfl | rfl <;> rcases hl' with rfl | rfl
    · exact Iff.rfl
    · rw [hij0, hji0]
    · rw [hji0, hij0]
    · exact Iff.rfl
  positiveDefinite := by
    refine ⟨fun _ => 1, fun _ => one_pos, fun v hv hv0 => ?_⟩
    have hvne : v i ≠ 0 ∨ v j ≠ 0 := by
      by_contra hall
      push Not at hall
      apply hv0
      funext k
      by_cases hk : k = i
      · rw [hk]; exact hall.1
      · by_cases hk' : k = j
        · rw [hk']; exact hall.2
        · exact hv k (by simp [hk, hk'])
    have key : cartanQuadraticForm A (fun _ => 1) v = 2 * v i ^ 2 + 2 * v j ^ 2 := by
      rw [cartanQuadraticForm]
      have hinner : ∀ k, (∑ l, v k * v l * ((A k l : ℚ) * 1)) =
          v k * v i * ((A k i : ℚ) * 1) + v k * v j * ((A k j : ℚ) * 1) := by
        intro k
        exact sum_eq_of_support_pair hij fun t ht => by rw [hv t ht]; ring
      simp only [hinner]
      rw [sum_eq_of_support_pair hij (fun t ht => by rw [hv t ht]; ring),
        show ((A i i : ℤ) : ℚ) = 2 from by rw [hi]; norm_num,
        show ((A j j : ℤ) : ℚ) = 2 from by rw [hj]; norm_num,
        show ((A i j : ℤ) : ℚ) = 0 from by rw [hij0]; norm_num,
        show ((A j i : ℤ) : ℚ) = 0 from by rw [hji0]; norm_num]
      ring
    rw [key]
    rcases hvne with h | h
    · nlinarith [mul_self_pos.mpr h, mul_self_nonneg (v j)]
    · nlinarith [mul_self_pos.mpr h, mul_self_nonneg (v i)]

/-- A sum over the subtype of a pair, of a summand which factors through the projection, is the sum
of the two terms. -/
theorem sum_pair_subtype {M : Type*} [AddCommMonoid M] {ι : Type u} [DecidableEq ι] {i j : ι}
    (hij : i ≠ j) (f : ι → M) :
    ∑ l : ↥({i, j} : Finset ι), f ↑l = f i + f j := by
  rw [Finset.sum_coe_sort]
  exact Finset.sum_pair hij

/-- A sum over the subtype of a singleton `Finset` is its single term. -/
theorem sum_singleton_subtype {M : Type*} [AddCommMonoid M] {ι : Type u} (i : ι)
    (f : ↥({i} : Finset ι) → M) :
    ∑ l : ↥({i} : Finset ι), f l = f ⟨i, Finset.mem_singleton_self i⟩ := by
  refine Finset.sum_eq_single (⟨i, Finset.mem_singleton_self i⟩ : ↥({i} : Finset ι)) ?_ ?_
  · intro b _ hb
    exact absurd (Subtype.ext (Finset.mem_singleton.mp b.2)) hb
  · intro h'
    exact absurd (Finset.mem_univ _) h'

/-- For a single black node `{i}` with `a_{ii} = 2`, the parabolic Weyl vector has coefficient
`1/2` at `i`. -/
theorem parabolicWeylVectorCoefficient_singleton [Fintype ι] {A : Matrix ι ι ℤ} {i : ι}
    (hii : A i i = 2) {m : ↥({i} : Finset ι) → ℚ}
    (hm : IsParabolicWeylVectorCoefficient A {i} m) :
    m ⟨i, Finset.mem_singleton_self i⟩ = 1 / 2 := by
  have h := hm ⟨i, Finset.mem_singleton_self i⟩
  rw [sum_singleton_subtype] at h
  rw [show ((A i i : ℤ) : ℚ) = 2 from by rw [hii]; norm_num] at h
  linarith

/-- For a single black node, source condition (3) reduces to `a_{ji} / 2 ∈ ℤ`. -/
theorem exists_int_eq_half_mul_of_singleton [Fintype ι] {A : Matrix ι ι ℤ} {i j : ι}
    {τ : Equiv.Perm ι} (hii : A i i = 2) (hj : j ∉ ({i} : Finset ι)) (hfix : τ j = j)
    (h : HasIntegralParabolicWeylPairing A {i} τ) :
    ∃ z : ℤ, (z : ℚ) = (1 / 2) * (A j i : ℚ) := by
  obtain ⟨m, hm, hint⟩ := h
  have hm2 := parabolicWeylVectorCoefficient_singleton hii hm
  obtain ⟨z, hz⟩ := hint j hj hfix
  refine ⟨z, ?_⟩
  rw [hz, sum_singleton_subtype, hm2]

/-- **The compact diagram of `A₁`** (the Satake diagram of `su(2)`): one black node, `τ = id`. -/
theorem satakeA1_compact_admissible :
    IsAdmissiblePair (CartanMatrix.A 1) Finset.univ 1 where
  finiteType := by
    have huniv : (Finset.univ : Finset (Fin 1)) = {0} := by
      ext k
      simp [Subsingleton.elim k 0]
    rw [huniv]
    exact isFiniteTypeSubdiagram_singleton _ (by decide)
  preservesCartan := fun i j => by simp
  preservesSubdiagram := fun i => by simp
  involutive := by simp
  agreesWithLongestElement := by
    refine ⟨cartanReflectionEquiv (CartanMatrix.A 1) 0 (by decide), ?_, ?_⟩
    · refine ⟨cartanReflectionEquiv_mem_subdiagramWeylGroup _ (i := 0) (by simp), ?_⟩
      intro i _ k
      have hi : i = 0 := Subsingleton.elim i 0
      subst hi
      rw [cartanReflectionEquiv_apply, cartanReflection_simpleRoot_self _ (by decide)]
      by_cases hk : k = 0 <;> simp [hk]
    · intro i _
      have hi : i = 0 := Subsingleton.elim i 0
      subst hi
      rw [cartanReflectionEquiv_apply, cartanReflection_simpleRoot_self _ (by decide)]
      simp
  integralZeroWeight := by
    refine ⟨fun _ => 1 / 2, ?_, ?_⟩
    · intro k
      rw [Finset.sum_eq_single k]
      · rw [show ((CartanMatrix.A 1 k.1 k.1 : ℤ) : ℚ) = 2 from by
          rw [show k.1 = 0 from Subsingleton.elim k.1 0]; norm_num [CartanMatrix.A]]
        norm_num
      · intro b _ hb
        exact absurd (Subsingleton.elim b k) hb
      · intro h'
        exact absurd (Finset.mem_univ k) h'
    · intro j hj _
      exact absurd (Finset.mem_univ j) hj


/-- **Kolb's Example 2.4, third case**: for `sl₄` the pair `({2}, (13))` is admissible, because
condition (3) is empty: `τ` moves both white nodes, so no white node is `τ`-fixed. -/
theorem satakeA3_blackMiddle_swapped_admissible :
    IsAdmissiblePair (CartanMatrix.A 3) ({1} : Finset (Fin 3)) (Equiv.swap 0 2) where
  finiteType := isFiniteTypeSubdiagram_singleton _ (by decide)
  preservesCartan := by
    intro i j
    fin_cases i <;> fin_cases j <;> decide
  preservesSubdiagram := by
    intro i
    fin_cases i <;> decide
  involutive := by
    ext i
    fin_cases i <;> decide
  agreesWithLongestElement := by
    refine ⟨cartanReflectionEquiv (CartanMatrix.A 3) 1 (by decide), ?_, ?_⟩
    · refine ⟨cartanReflectionEquiv_mem_subdiagramWeylGroup _ (i := 1) (by simp), ?_⟩
      intro i hi k
      rw [Finset.mem_singleton.mp hi, cartanReflectionEquiv_apply,
        cartanReflection_simpleRoot_self _ (by decide)]
      by_cases hk : k = 1 <;> simp [hk]
    · intro i hi
      rw [Finset.mem_singleton.mp hi, cartanReflectionEquiv_apply,
        cartanReflection_simpleRoot_self _ (by decide)]
      have h1 : (Equiv.swap (0 : Fin 3) 2) 1 = 1 := by decide
      rw [h1]
  integralZeroWeight := by
    refine ⟨fun _ => 1 / 2, ?_, ?_⟩
    · intro k
      obtain rfl : k = ⟨1, Finset.mem_singleton_self (1 : Fin 3)⟩ :=
        Subtype.ext (Finset.mem_singleton.mp k.2)
      rw [sum_singleton_subtype,
        show ((CartanMatrix.A 3 1 1 : ℤ) : ℚ) = 2 from by decide]
      norm_num
    · intro j hj hfix
      exfalso
      fin_cases j
      · simp at hfix
      · exact hj (by simp)
      · simp at hfix

/-- **Kolb's Example 2.4, first case**: for `sl₄` the pair `({1,3}, id)` *is* admissible.  The black
nodes span `A₁ ⊕ A₁`, whose longest element is the product of the two commuting reflections
(`cartanReflection_mul_simpleRoot_of_disjoint`), so `-w_X` is the identity on `X`.  With
`ρ^∨_X = (h₁ + h₃)/2` the source's Example 2.4 computes `α₁(ρ^∨_X) = α₃(ρ^∨_X) = 1` and
`α₂(ρ^∨_X) = -1`; the second value is the one condition (3) needs, at the `τ`-fixed white node. -/
theorem satakeA3_blackEnds_admissible :
    IsAdmissiblePair (CartanMatrix.A 3) ({0, 2} : Finset (Fin 3)) 1 where
  finiteType :=
    isFiniteTypeSubdiagram_pair _ (by decide) (by decide) (by decide) (by decide) (by decide)
  preservesCartan := fun i j => by simp
  preservesSubdiagram := fun i => by simp
  involutive := by simp
  agreesWithLongestElement := by
    have hw := cartanReflection_mul_simpleRoot_of_disjoint (CartanMatrix.A 3) (i := 0) (j := 2)
      (by decide) (by decide) (by decide) (by decide)
    refine ⟨cartanReflectionEquiv (CartanMatrix.A 3) 0 (by decide) *
      cartanReflectionEquiv (CartanMatrix.A 3) 2 (by decide), ⟨?_, ?_⟩, ?_⟩
    · exact Subgroup.mul_mem _
        (cartanReflectionEquiv_mem_subdiagramWeylGroup _ (i := 0) (by simp))
        (cartanReflectionEquiv_mem_subdiagramWeylGroup _ (i := 2) (by simp))
    · intro i hi k
      have hi' : i = 0 ∨ i = 2 := by
        rcases Finset.mem_insert.mp hi with h | h
        · exact Or.inl h
        · exact Or.inr (Finset.mem_singleton.mp h)
      rcases hi' with rfl | rfl
      · rw [hw.1]; by_cases hk : k = 0 <;> simp [hk]
      · rw [hw.2]; by_cases hk : k = 2 <;> simp [hk]
    · intro i hi
      have hi' : i = 0 ∨ i = 2 := by
        rcases Finset.mem_insert.mp hi with h | h
        · exact Or.inl h
        · exact Or.inr (Finset.mem_singleton.mp h)
      rcases hi' with rfl | rfl
      · rw [hw.1]; simp
      · rw [hw.2]; simp
  integralZeroWeight := by
    refine ⟨fun _ => 1 / 2, ?_, ?_⟩
    · intro k
      have hk' : k = ⟨0, by simp⟩ ∨ k = ⟨2, by simp⟩ := by
        rcases Finset.mem_insert.mp k.2 with h | h
        · exact Or.inl (Subtype.ext h)
        · exact Or.inr (Subtype.ext (Finset.mem_singleton.mp h))
      rcases hk' with rfl | rfl <;>
        rw [sum_pair_subtype (i := (0 : Fin 3)) (j := 2) (by decide)
          (f := fun x => ((CartanMatrix.A 3 _ x : ℤ) : ℚ) * (1 / 2))] <;>
        norm_num [CartanMatrix.A, Matrix.of_apply]
    · intro j hj _
      have hj' : j = 0 ∨ j = 1 ∨ j = 2 := by
        fin_cases j <;> simp
      rcases hj' with rfl | rfl | rfl
      · exact absurd (by simp) hj
      · refine ⟨-1, ?_⟩
        rw [show (∑ k : ↥({0, 2} : Finset (Fin 3)), (fun _ => 1 / 2) k *
            ((CartanMatrix.A 3 1 k.1 : ℤ) : ℚ)) =
            ∑ k : ↥({0, 2} : Finset (Fin 3)),
              ((CartanMatrix.A 3 1 k.1 : ℤ) : ℚ) * (1 / 2) from
          Finset.sum_congr rfl fun k _ => by ring]
        rw [sum_pair_subtype (i := (0 : Fin 3)) (j := 2) (by decide)
          (f := fun x => ((CartanMatrix.A 3 1 x : ℤ) : ℚ) * (1 / 2))]
        norm_num [CartanMatrix.A, Matrix.of_apply]
      · exact absurd (by simp) hj

/-- **Kolb's Example 2.4, second case**: for `sl₄` the pair `({1}, id)` is *not* admissible:
`ρ^∨_{X} = h₁/2` gives `α₂(ρ^∨_{X}) = -1/2 ∉ ℤ`, so condition (3) fails at the `τ`-fixed white
node `2`. -/
theorem satakeA3_blackFirst_not_admissible :
    ¬ IsAdmissiblePair (CartanMatrix.A 3) ({0} : Finset (Fin 3)) 1 := by
  intro h
  obtain ⟨z, hz⟩ := exists_int_eq_half_mul_of_singleton (A := CartanMatrix.A 3) (i := 0) (j := 1)
    (τ := 1) (by decide) (by decide) (by simp) h.integralZeroWeight
  have hA : ((CartanMatrix.A 3 1 0 : ℤ) : ℚ) = -1 := by decide
  rw [hA] at hz
  have h2 : (2 * z : ℚ) = -1 := by rw [hz]; norm_num
  have h3 : (2 * z : ℤ) = -1 := by exact_mod_cast h2
  omega


/-- The same reduction for `B₂`, where the two nodes are not symmetric: the black **short** node
`1` gives `α_0(ρ^∨_X) = a_{01}/2 = -1 ∈ ℤ`. -/
theorem satakeB2_blackShort_admissible :
    IsAdmissiblePair (CartanMatrix.B 2) ({1} : Finset (Fin 2)) 1 where
  finiteType := isFiniteTypeSubdiagram_singleton _ (by decide)
  preservesCartan := fun i j => by simp
  preservesSubdiagram := fun i => by simp
  involutive := by simp
  agreesWithLongestElement := by
    refine ⟨cartanReflectionEquiv (CartanMatrix.B 2) 1 (by decide), ?_, ?_⟩
    · refine ⟨cartanReflectionEquiv_mem_subdiagramWeylGroup _ (i := 1) (by simp), ?_⟩
      intro i hi k
      rw [Finset.mem_singleton.mp hi, cartanReflectionEquiv_apply,
        cartanReflection_simpleRoot_self _ (by decide)]
      by_cases hk : k = 1 <;> simp [hk]
    · intro i hi
      rw [Finset.mem_singleton.mp hi, cartanReflectionEquiv_apply,
        cartanReflection_simpleRoot_self _ (by decide)]
      simp
  integralZeroWeight := by
    refine ⟨fun _ => 1 / 2, ?_, ?_⟩
    · intro k
      obtain rfl : k = ⟨1, Finset.mem_singleton_self (1 : Fin 2)⟩ :=
        Subtype.ext (Finset.mem_singleton.mp k.2)
      rw [sum_singleton_subtype, show ((CartanMatrix.B 2 1 1 : ℤ) : ℚ) = 2 from by decide]
      norm_num
    · intro j hj _
      have hj' : j = 0 ∨ j = 1 := by fin_cases j <;> simp
      rcases hj' with rfl | rfl
      · refine ⟨-1, ?_⟩
        rw [sum_singleton_subtype, show ((CartanMatrix.B 2 0 1 : ℤ) : ℚ) = -2 from by decide]
        norm_num
      · exact absurd (by simp) hj

/-- The black **long** node of `B₂` is *not* admissible: `α_1(ρ^∨_X) = a_{10}/2 = -1/2 ∉ ℤ`. -/
theorem satakeB2_blackLong_not_admissible :
    ¬ IsAdmissiblePair (CartanMatrix.B 2) ({0} : Finset (Fin 2)) 1 := by
  intro h
  obtain ⟨z, hz⟩ := exists_int_eq_half_mul_of_singleton (A := CartanMatrix.B 2) (i := 0) (j := 1)
    (τ := 1) (by decide) (by decide) (by simp) h.integralZeroWeight
  have hA : ((CartanMatrix.B 2 1 0 : ℤ) : ℚ) = -1 := by decide
  rw [hA] at hz
  have h2 : (2 * z : ℚ) = -1 := by rw [hz]; norm_num
  have h3 : (2 * z : ℤ) = -1 := by exact_mod_cast h2
  omega


/-! ## The category of Satake diagrams -/

/-- An object of the category of Satake diagrams: a finite-type Cartan matrix with an admissible
pair, i.e. a black-node set `X` and a diagram permutation `τ` satisfying `IsAdmissiblePair`
(issue #86, item 1). -/
structure SatakeDiagram where
  /-- The vertex set of the Dynkin diagram. -/
  index : Type u
  [fintypeIndex : Fintype index]
  [decEqIndex : DecidableEq index]
  /-- The Cartan matrix of the diagram. -/
  cartan : Matrix index index ℤ
  /-- The black nodes. -/
  black : Finset index
  /-- The diagram permutation. -/
  tau : Equiv.Perm index
  /-- The pair is admissible. -/
  admissible : IsAdmissiblePair cartan black tau

attribute [instance] SatakeDiagram.fintypeIndex SatakeDiagram.decEqIndex

namespace SatakeDiagram

/-- A morphism of Satake diagrams: a reindexing preserving the Cartan matrix and the black nodes
and commuting with `τ` (issue #86, item 1). -/
structure Hom (D E : SatakeDiagram.{u}) where
  /-- The underlying reindexing. -/
  toEquiv : D.index ≃ E.index
  cartan_preserved : ∀ i j, E.cartan (toEquiv i) (toEquiv j) = D.cartan i j
  black_preserved : ∀ i, (i ∈ D.black ↔ toEquiv i ∈ E.black)
  tau_comm : ∀ i, toEquiv (D.tau i) = E.tau (toEquiv i)

@[ext]
theorem Hom.ext {D E : SatakeDiagram} {f g : Hom D E} (h : ∀ i, f.toEquiv i = g.toEquiv i) :
    f = g := by
  have hfe : f.toEquiv = g.toEquiv := Equiv.ext h
  obtain ⟨fe, fc, fb, ft⟩ := f
  obtain ⟨ge, gc, gb, gt⟩ := g
  obtain rfl : fe = ge := hfe
  rfl

/-- The identity morphism of a Satake diagram. -/
def Hom.id (D : SatakeDiagram.{u}) : Hom D D where
  toEquiv := Equiv.refl D.index
  cartan_preserved _ _ := rfl
  black_preserved _ := Iff.rfl
  tau_comm _ := rfl

/-- Composition of morphisms of Satake diagrams. -/
def Hom.comp {D E F : SatakeDiagram.{u}} (f : Hom D E) (g : Hom E F) : Hom D F where
  toEquiv := f.toEquiv.trans g.toEquiv
  cartan_preserved i j := by
    rw [Equiv.trans_apply, Equiv.trans_apply, g.cartan_preserved, f.cartan_preserved]
  black_preserved i := (f.black_preserved i).trans (g.black_preserved (f.toEquiv i))
  tau_comm i := by
    rw [Equiv.trans_apply, Equiv.trans_apply, f.tau_comm i, g.tau_comm (f.toEquiv i)]

/-- The inverse of a morphism of Satake diagrams; every morphism of the category is invertible. -/
def Hom.symm {D E : SatakeDiagram.{u}} (f : Hom D E) : Hom E D where
  toEquiv := f.toEquiv.symm
  cartan_preserved i j := by
    have h := f.cartan_preserved (f.toEquiv.symm i) (f.toEquiv.symm j)
    simpa using h.symm
  black_preserved i := by
    have h := f.black_preserved (f.toEquiv.symm i)
    simpa using h.symm
  tau_comm i := by
    have h := f.tau_comm (f.toEquiv.symm i)
    simp only [Equiv.apply_symm_apply] at h
    exact (congrArg f.toEquiv.symm h).symm.trans (Equiv.symm_apply_apply f.toEquiv _)

instance : CategoryTheory.Category SatakeDiagram.{u} where
  Hom D E := Hom D E
  id D := Hom.id D
  comp f g := Hom.comp f g
  id_comp _ := Hom.ext fun _ => rfl
  comp_id _ := Hom.ext fun _ => rfl
  assoc _ _ _ := Hom.ext fun _ => rfl

instance : CategoryTheory.Groupoid SatakeDiagram.{u} where
  inv f := Hom.symm f
  inv_comp f := Hom.ext fun i => by
    change (Hom.comp (Hom.symm f) f).toEquiv i = i
    simp [Hom.comp, Hom.symm]
  comp_inv f := Hom.ext fun i => by
    change (Hom.comp f (Hom.symm f)).toEquiv i = i
    simp [Hom.comp, Hom.symm]

end SatakeDiagram

end LeanCategories.Algebra
