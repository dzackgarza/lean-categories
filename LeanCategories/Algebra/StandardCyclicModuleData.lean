module

public import LeanCategories.Algebra.MaximalWeightVector

/-!
# Standard cyclic highest-weight modules

Definition-level realization of Humphreys FC14-C06-U005.  A module is
standard cyclic of highest weight `λ` when it is generated by a maximal
vector of weight `λ`.  Structural consequences of this definition belong to
the result layer and are not included here.
-/

@[expose] public section

namespace LeanCategories.Algebra

open LieAlgebra LieModule Module

universe u v w

variable
  {K : Type u} {L : Type v} [Field K] [CharZero K]
  [LieRing L] [LieAlgebra K L]
  [LieAlgebra.IsKilling K L] [FiniteDimensional K L]
  {H : LieSubalgebra K L} [H.IsCartanSubalgebra]
  [LieModule.IsTriangularizable K H L]
  {M : Type w} [AddCommGroup M] [Module K M]
  [LieRingModule L M] [LieModule K L M]

/-- Humphreys' predicate that `M` is a standard cyclic module of highest
weight `lam` for the positive system determined by `b`. -/
def IsStandardCyclicModule
    (b : (LieAlgebra.IsKilling.rootSystem H).Base)
    (lam : Module.Dual K H) : Prop :=
  ∃ v : M,
    IsMaximalWeightVector (M := M) b lam v ∧
      LieSubmodule.lieSpan K L ({v} : Set M) = ⊤

end LeanCategories.Algebra
