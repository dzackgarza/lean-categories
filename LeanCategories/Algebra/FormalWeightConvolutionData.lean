module

public import LeanCategories.Algebra.RootSystemData

/-!
# Cone-supported formal-weight convolution data

Definition-level realization of Humphreys FC14-C06-U059.

Humphreys' algebra `X` is larger than a group algebra: its elements are
functions on the weight space whose support is contained in a finite union of
sets of the form `mu - Q⁺`. Such a function can have infinite support.

The carrier and its support condition are definition-level data. Convolution
requires the theorem that, for fixed `lambda`, only finitely many terms

  `f(mu) * g(lambda - mu)`

are nonzero. Sweep III therefore records multiplication by its exact
coefficient graph rather than by a partial sum or a finite-support
approximation. The remaining pointwise algebra operations are recorded by
equally exact graphs so that no support-closure proof is hidden in a
constructor. Sweep IV proves the graphs total and single-valued and packages
them as Humphreys' commutative algebra.
-/

@[expose] public noncomputable section

namespace LeanCategories.Algebra

universe u v

/-- The nonnegative monoid generated by the chosen simple roots; this is the
`Q⁺` cone defining Humphreys' root order from FC14-C03-U014. -/
def rootOrderConeData
    {E : Type u} [AddCommMonoid E]
    (simpleRoots : Finset E) (nu : E) : Prop :=
  (kostantPartitionSet simpleRoots nu).Nonempty

/-- The source support condition for Humphreys' completed character algebra:
the support is contained in finitely many downward translates
`top - Q⁺`. -/
def IsConeSupportedWeightFunctionData
    {E : Type u} {F : Type v} [AddCommGroup E] [Zero F]
    (simpleRoots : Finset E) (f : E → F) : Prop :=
  ∃ tops : Finset E, ∀ lambda : E, f lambda ≠ 0 →
    ∃ top ∈ tops, rootOrderConeData simpleRoots (top - lambda)

/-- Raw carrier of Humphreys' convolution algebra `X`.

No finite-support hypothesis is imposed: an element may have infinitely many
nonzero coefficients inside its finitely many downward cones. -/
abbrev ConeSupportedWeightFunctionData
    (E : Type u) (F : Type v) [AddCommGroup E] [Zero F]
    (simpleRoots : Finset E) :=
  {f : E → F // IsConeSupportedWeightFunctionData simpleRoots f}

/-- Exact graph of the additive zero of `X`. -/
def IsConeSupportedWeightZeroData
    {E : Type u} {F : Type v} [AddCommGroup E] [CommRing F]
    {simpleRoots : Finset E}
    (z : ConeSupportedWeightFunctionData E F simpleRoots) : Prop :=
  ∀ lambda, z.1 lambda = 0

/-- Exact graph of pointwise addition in `X`. -/
def IsConeSupportedWeightAddData
    {E : Type u} {F : Type v} [AddCommGroup E] [CommRing F]
    {simpleRoots : Finset E}
    (f g h : ConeSupportedWeightFunctionData E F simpleRoots) : Prop :=
  ∀ lambda, h.1 lambda = f.1 lambda + g.1 lambda

/-- Exact graph of pointwise additive inversion in `X`. -/
def IsConeSupportedWeightNegData
    {E : Type u} {F : Type v} [AddCommGroup E] [CommRing F]
    {simpleRoots : Finset E}
    (f h : ConeSupportedWeightFunctionData E F simpleRoots) : Prop :=
  ∀ lambda, h.1 lambda = -f.1 lambda

/-- Exact graph of coefficient-field scalar multiplication in `X`. -/
def IsConeSupportedWeightSMulData
    {E : Type u} {F : Type v} [AddCommGroup E] [CommRing F]
    {simpleRoots : Finset E}
    (c : F) (f h : ConeSupportedWeightFunctionData E F simpleRoots) : Prop :=
  ∀ lambda, h.1 lambda = c * f.1 lambda

/-- Exact graph of the delta function `e_mu`.

The multiplicative unit is the specialization `mu = 0`. Keeping the
general graph also supplies Humphreys' exponential notation used immediately
after the definition of `X`. -/
def IsConeSupportedWeightDeltaData
    {E : Type u} {F : Type v} [AddCommGroup E] [CommRing F]
    {simpleRoots : Finset E}
    (mu : E) (e : ConeSupportedWeightFunctionData E F simpleRoots) : Prop :=
  e.1 mu = 1 ∧ ∀ lambda, lambda ≠ mu → e.1 lambda = 0

/-- Exact graph of the multiplicative unit `e_0`. -/
def IsConeSupportedWeightOneData
    {E : Type u} {F : Type v} [AddCommGroup E] [CommRing F]
    {simpleRoots : Finset E}
    (e : ConeSupportedWeightFunctionData E F simpleRoots) : Prop :=
  IsConeSupportedWeightDeltaData 0 e

/-- Exact coefficient graph of Humphreys' convolution product.

For each output weight `lambda`, the witness `S` contains every index
`mu` giving a nonzero summand. It may contain extra indices, but those
contribute zero by the first clause, so any such finite witness computes the
same source coefficient once local finiteness is established.

Existence of `S` and preservation of cone support are precisely the
well-definedness results deferred to Sweep IV. -/
def IsConeSupportedWeightMulData
    {E : Type u} {F : Type v} [AddCommGroup E] [CommRing F]
    {simpleRoots : Finset E}
    (f g h : ConeSupportedWeightFunctionData E F simpleRoots) : Prop := by
  classical
  exact ∀ lambda : E, ∃ S : Finset E,
    (∀ mu : E, f.1 mu * g.1 (lambda - mu) ≠ 0 → mu ∈ S) ∧
    h.1 lambda = ∑ mu ∈ S, f.1 mu * g.1 (lambda - mu)

end LeanCategories.Algebra
