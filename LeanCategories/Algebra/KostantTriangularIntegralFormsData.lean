module

public import LeanCategories.Algebra.KostantIntegralFormData

/-!
# Triangular integral forms in the universal enveloping algebra

Definition-level realization of Humphreys FC14-C07-U028.

Humphreys denotes by `U^-_ℤ`, `U^0_ℤ`, and `U^+_ℤ` the integral
subrings generated respectively by negative-root divided powers, Cartan
binomial coefficients, and positive-root divided powers.

The claims that the corresponding `f_A`, `h_B`, and `e_C` families
are `ℤ`-bases and that `U(L)_ℤ = U^-_ℤ U^0_ℤ U^+_ℤ` are result
content.  This file records only the three generated subrings.
-/

@[expose] public noncomputable section

namespace LeanCategories.Algebra

universe u v w x

variable (K : Type u) (L : Type v)
variable [Field K] [CharZero K] [LieRing L] [LieAlgebra K L]

/-- The negative-root integral form `U^-_ℤ`. -/
def kostantNegativeIntegralFormData {Phi : Type w} (xNeg : Phi → L) :
    Subring (UniversalEnvelopingAlgebra K L) :=
  kostantIntegralFormData K L xNeg

/-- The Cartan-binomial generator set
`{binom(h_i,n) | i, n}` inside `U(L)`. -/
def kostantCartanBinomialGenerators {I : Type x} (h : I → L) :
    Set (UniversalEnvelopingAlgebra K L) :=
  Set.range fun p : I × ℕ => ueaCartanBinomial K L (h p.1) p.2

/-- The Cartan integral form `U^0_ℤ`: the subring generated by all
binomial coefficients of the supplied Cartan basis elements. -/
def kostantCartanIntegralFormData {I : Type x} (h : I → L) :
    Subring (UniversalEnvelopingAlgebra K L) :=
  Subring.closure (kostantCartanBinomialGenerators K L h)

/-- The positive-root integral form `U^+_ℤ`. -/
def kostantPositiveIntegralFormData {Phi : Type w} (xPos : Phi → L) :
    Subring (UniversalEnvelopingAlgebra K L) :=
  kostantIntegralFormData K L xPos

end LeanCategories.Algebra
