module

public import LeanCategories.Algebra.GlobalRayConductorData
public import Mathlib.RingTheory.DedekindDomain.Factorization

/-!
# Alternate global ray-class data

Definition-level realization of the ray-class convention in Neukirch
FC09-C06-U069, following the checked Atlas implementation while keeping
Sweep-III proof obligations separate.

The Minkowski metric used in this convention is already owned by the earlier
FC09-C01-U047 route.  Here we record only the new finite/infinite modulus and
ray-class data: fractional ideals prime to the finite support, principal ray
generators satisfying the finite congruence and infinite positivity
conditions, the subgroup they generate, and the quotient carrier.

Closure of the coprime carrier under multiplication/inversion, equivalence of
the quotient relation, its group structure, and comparison with the idèlic
ray-class quotient are result-layer statements.
-/

@[expose] public noncomputable section

open IsDedekindDomain NumberField
open scoped nonZeroDivisors

namespace LeanCategories

universe u

/-- Fractional ideals of a number field, on the ring of integers. -/
abbrev GlobalRayFracIdeal
    (K : Type u) [Field K] [NumberField K] :=
  FractionalIdeal (nonZeroDivisors (𝓞 K)) K

/-- A nonzero fractional ideal is prime to the finite part of the ray modulus
when its exponent is zero at every finite place occurring in the modulus. -/
def IsGlobalRayFracIdealCoprimeData
    (K : Type u) [Field K] [NumberField K]
    (m : GlobalRayModulusData K)
    (I : (GlobalRayFracIdeal K)ˣ) : Prop :=
  ∀ v : HeightOneSpectrum (𝓞 K),
    m (.finite v) ≠ 0 →
      FractionalIdeal.count K v I.val = 0

/-- Raw carrier of the fractional ideals prime to a ray modulus.

The subgroup laws are deliberately not bundled here. -/
abbrev GlobalRayFracIdealsCoprimeData
    (K : Type u) [Field K] [NumberField K]
    (m : GlobalRayModulusData K) :=
  {I : (GlobalRayFracIdeal K)ˣ //
    IsGlobalRayFracIdealCoprimeData K m I}

/-- Atlas/Neukirch ray-generator condition.

The fractional ideal must be principal, its generator is congruent to one to
the prescribed finite orders, and it is positive at each real infinite place
selected by the modulus.  Valid global ray moduli have zero exponent at
complex places, so no complex positivity condition occurs. -/
def IsGlobalRayGeneratorData
    (K : Type u) [Field K] [NumberField K]
    (m : GlobalRayModulusData K)
    (I : (GlobalRayFracIdeal K)ˣ) : Prop :=
  IsGlobalRayFracIdealCoprimeData K m I ∧
    ∃ α : Kˣ,
      I.val =
        FractionalIdeal.spanSingleton
          (nonZeroDivisors (𝓞 K)) (α : K) ∧
      (∀ v : HeightOneSpectrum (𝓞 K),
        m (.finite v) ≠ 0 →
          v.valuation K ((α : K) - 1) ≤
            ↑(Multiplicative.ofAdd (-(m (.finite v) : ℤ)))) ∧
      ∀ w : InfinitePlace K,
        m (.infinite w) ≠ 0 →
          0 < (w.embedding (α : K)).re

/-- The ray subgroup generated by the principal ray generators.

`Subgroup.closure` records the generated subgroup without requiring Sweep III
to prove closure of the source generator predicate. -/
def globalRayGroupData
    (K : Type u) [Field K] [NumberField K]
    (m : GlobalRayModulusData K) :
    Subgroup ((GlobalRayFracIdeal K)ˣ) :=
  Subgroup.closure {I | IsGlobalRayGeneratorData K m I}

/-- Raw ray-class equivalence relation on ideals prime to the modulus:
two classes differ by an element of the generated ray subgroup.

Reflexivity/symmetry/transitivity on the coprime carrier are result-layer
facts, so the relation is not bundled as a `Setoid` here. -/
def GlobalRayClassRelData
    (K : Type u) [Field K] [NumberField K]
    (m : GlobalRayModulusData K)
    (I J : GlobalRayFracIdealsCoprimeData K m) : Prop :=
  I.1 * J.1⁻¹ ∈ globalRayGroupData K m

/-- The raw quotient carrier of the alternate ray class group.

Once the preceding relation is proved to be the usual subgroup equivalence,
this is the ordinary quotient of ideals prime to `m` by the ray subgroup.
No quotient-group law is asserted in Sweep III. -/
abbrev GlobalRayClassGroupCarrierData
    (K : Type u) [Field K] [NumberField K]
    (m : GlobalRayModulusData K) :=
  Quot (GlobalRayClassRelData K m)

end LeanCategories
