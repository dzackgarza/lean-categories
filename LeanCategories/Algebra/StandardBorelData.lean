module

public import Mathlib.Algebra.Lie.Basis.Basic

/-!
# Standard Borel carrier data

Humphreys FC14-C04-U029. Mathlib's `LieAlgebra.Basis.borelUpper` is the
positive nilpotent part generated by the simple positive-root vectors. This
file records that carrier and its join with the Cartan subalgebra; closure,
nilpotence, derived-algebra and solvability assertions remain result content.
-/

@[expose] public noncomputable section

namespace LeanCategories.Algebra

universe u v w

variable {I : Type u} {R : Type v} {L : Type w}
variable [Finite I] [CommRing R] [LieRing L] [LieAlgebra R L]
variable {H : LieSubalgebra R L}

/-- The positive nilradical carrier attached to a semisimple Lie basis. -/
abbrev standardPositiveNilradical (b : LieAlgebra.Basis I H) : LieSubmodule R H L :=
  b.borelUpper

/-- The underlying `H`-stable module of the standard Borel `H ⊕ N⁺`. -/
def standardBorelCarrier (b : LieAlgebra.Basis I H) : LieSubmodule R H L :=
  H.toLieSubmodule ⊔ b.borelUpper

end LeanCategories.Algebra
