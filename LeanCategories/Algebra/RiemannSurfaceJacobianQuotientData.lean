module

public import LeanCategories.Algebra.RiemannSurfacePeriodIntegralData
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.GroupTheory.QuotientGroup.Defs

/-!
# The quotient by integral loop periods

Definition-level assembly toward Peters--Sterk FC11-C16-U026 from the native
holomorphic-form dual and the scalar integrals adapted from
mrdouglasny/jacobian-challenge at
8ce1ec28aed1c78b3b39d0bae26e2858c82f5143 (Apache-2.0).

A period generator is a complex-linear functional whose value on every
holomorphic one-form is the integral along an actual analytic loop. The
integral-period subgroup is generated by these functionals using Mathlib's
algebraic `AddSubgroup.closure`; this is neither a topological closure nor a
complex-linear span. Its additive quotient and projection are native owners.
No period subgroup, lattice, or Jacobian is supplied as an input.

This construction does not prove that every loop integral is linear, construct
the descended homology pairing, or identify the subgroup with the source's
`ι(H₁(C, ℤ))`. Those comparison obligations are recorded separately, so the
quotient model alone does not close U026 or assert a complex-torus structure.
-/

@[expose] public noncomputable section

open scoped Manifold ContDiff

namespace LeanCategories.Algebra

universe u

variable (X : Type u) [TopologicalSpace X] [ChartedSpace ℂ X]
  [IsManifold 𝓘(ℂ) ω X]

/-- Linear functionals specified by integrals over actual closed analytic
arcs. This is a subset of the native complex dual, not of all functions. -/
def curveIntegralPeriodGeneratorsData : Set (CurveJacobianDualData X) :=
  {φ | ∃ x₀ : X, ∃ γ : CurveAnalyticLoopData x₀,
    ∀ form : CurveHolomorphicOneFormData X,
      φ form = curveCanonicalArcIntegralData γ.arc form}

/-- The integral additive subgroup generated by the loop-period equations.
Its closure is algebraic: no complex scalar multiples are introduced. -/
def curveIntegralPeriodSubgroupData : AddSubgroup (CurveJacobianDualData X) :=
  AddSubgroup.closure (curveIntegralPeriodGeneratorsData X)

/-- Additive quotient model of the holomorphic-form dual by integral
loop periods. The identification with the homology-image presentation of
the Jacobian remains a separate source-comparison obligation. -/
abbrev CurveJacobianPeriodQuotientData :=
  CurveJacobianDualData X ⧸ curveIntegralPeriodSubgroupData X

/-- Native additive quotient projection to the integral-period quotient. -/
def curveJacobianPeriodClassData :
    CurveJacobianDualData X →+ CurveJacobianPeriodQuotientData X :=
  QuotientAddGroup.mk' (curveIntegralPeriodSubgroupData X)

end LeanCategories.Algebra
