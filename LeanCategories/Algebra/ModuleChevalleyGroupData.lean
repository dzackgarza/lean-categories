module

public import LeanCategories.Algebra.ModuleRootElementData

/-!
# Chevalley groups attached to admissible modules

Definition-level realization of Humphreys FC14-C07-U042.

For an admissible lattice `M` in a faithful module `V`, Humphreys defines
`G_V(K)` to be the subgroup generated by all root elements `x_α(c)` on the
reduced module `V(K)`.  The root-element graph is FC14-C07-U041; this file
performs only the subgroup closure and records the source terminology for
adjoint and universal type in terms of the module weight lattice `A(V)`.

That every root element has determinant one, and hence that this subgroup may
be viewed inside `SL(V(K))`, is result content rather than constructor data.
-/

@[expose] public noncomputable section

namespace LeanCategories.Algebra

universe u v w x y z

/-- Humphreys' Chevalley group `G_V(K)`: the subgroup generated by all
specialized root elements on the reduced admissible module. -/
def moduleChevalleyGroupData
    {F : Type u} {L : Type v} {V : Type w} {Phi : Type x} {K : Type y}
    [Field F] [CharZero F] [LieRing L] [LieAlgebra F L]
    [AddCommGroup V] [Module F V] [LieRingModule L V] [LieModule F L V]
    [CommRing K]
    (rootVector : Phi → L) (M : Submodule ℤ V) :
    Subgroup (LinearMap.GeneralLinearGroup K (reducedModuleData K M)) :=
  Subgroup.closure
    {g | ∃ alpha : Phi, ∃ c : K,
      IsModuleRootElementData
        (F := F) (L := L) (V := V) (Phi := Phi) (K := K)
        rootVector M alpha c g}

/-- The source terminology “adjoint type”: the module weight lattice is the
root lattice. -/
def IsAdjointTypeWeightLatticeData
    {W : Type z} [AddCommGroup W]
    (moduleWeightLattice rootLattice : Submodule ℤ W) : Prop :=
  moduleWeightLattice = rootLattice

/-- The source terminology “universal type”: the module weight lattice is the
full weight lattice. -/
def IsUniversalTypeWeightLatticeData
    {W : Type z} [AddCommGroup W]
    (moduleWeightLattice fullWeightLattice : Submodule ℤ W) : Prop :=
  moduleWeightLattice = fullWeightLattice

end LeanCategories.Algebra
