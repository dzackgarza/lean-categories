module

public import LeanCategories.Algebra.ChevalleyIntegralFormData
public import Mathlib.Algebra.Lie.Weights.Chain
public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import Mathlib.Data.ZMod.Basic
public import Mathlib.RingTheory.Nilpotent.Exp

/-!
# Integral root exponentials and reduction data

Definition-level realization of Humphreys FC14-C07-U012.

For a chosen root vector `x_α`, the characteristic-zero adjoint exponential
`exp(ad (c x_α))` is a finite algebraic expression because the root-space
adjoint is nilpotent.  Humphreys uses the preceding divided-power integrality
result to restrict these exponentials to the integral Chevalley form, generate
the integral inner transformations, and reduce their integral matrices modulo
`p`.

Sweep III records those constructions by exact graphs.  It does not prove that
the ambient exponential preserves the integral form, that the generated
carrier is closed under inverses, or that the reduced maps are Lie
automorphisms.  Those are precisely the result clauses supplied by the
divided-power stability and reduction arguments.
-/

@[expose] public noncomputable section

namespace LeanCategories.Algebra

open LieAlgebra LieModule TensorProduct

universe u v w

/-- The finite adjoint exponential `exp(ad (c x_α))` attached to a nonzero
root vector.  Nilpotence comes from the native root-space theorem, not from a
caller-supplied truncation proof. -/
def rootAdjointExponentialData
    {K : Type u} {L : Type v} [Field K] [CharZero K] [Algebra ℚ K]
    [LieRing L] [LieAlgebra K L]
    [Module ℚ L] [IsScalarTower ℚ K L]
    (H : LieSubalgebra K L) [LieRing.IsNilpotent H]
    [IsTriangularizable K H L] [FiniteDimensional K L]
    {alpha : H → K} (_halpha : alpha ≠ 0) {x : L}
    (_hx : x ∈ rootSpace H alpha) (c : ℤ) : Module.End K L :=
  IsNilpotent.exp (ad K L ((c : K) • x))

/-- Exact graph saying that an integral endomorphism of the Chevalley-form
carrier is the restriction of the corresponding characteristic-zero root
exponential.

Existence of such an integral restriction is the divided-power integrality
result; it is not a constructor field here. -/
def IsIntegralRootExponentialValueData
    {K : Type u} {L : Type v} [Field K] [CharZero K] [Algebra ℚ K]
    [LieRing L] [LieAlgebra K L]
    [Module ℚ L] [IsScalarTower ℚ K L]
    (B : Set L)
    (H : LieSubalgebra K L) [LieRing.IsNilpotent H]
    [IsTriangularizable K H L] [FiniteDimensional K L]
    {alpha : H → K} (halpha : alpha ≠ 0) {x : L}
    (hx : x ∈ rootSpace H alpha) (c : ℤ)
    (f : Module.End ℤ (integralChevalleySpan B)) : Prop :=
  ∀ z : integralChevalleySpan B,
    ((f z : integralChevalleySpan B) : L) =
      rootAdjointExponentialData H halpha hx c (z : L)

/-- Carrier generated by all integral root-exponential restrictions.

The generators allow every integer parameter `c`, hence the source subgroup
carrier is obtained once the result `x_α(c)⁻¹ = x_α(-c)` is established.  No
inverse theorem is needed to define this generated carrier. -/
def integralInnerTransformationData
    {K : Type u} {L : Type v} {Phi : Type w}
    [Field K] [CharZero K] [Algebra ℚ K] [LieRing L] [LieAlgebra K L]
    [Module ℚ L] [IsScalarTower ℚ K L]
    (B : Set L)
    (H : LieSubalgebra K L) [LieRing.IsNilpotent H]
    [IsTriangularizable K H L] [FiniteDimensional K L]
    (root : Phi → (H → K)) (hroot : ∀ a, root a ≠ 0)
    (x : Phi → L) (hx : ∀ a, x a ∈ rootSpace H (root a)) :
    Submonoid (Module.End ℤ (integralChevalleySpan B)) :=
  Submonoid.closure
    {f | ∃ a : Phi, ∃ c : ℤ,
      IsIntegralRootExponentialValueData B H (hroot a) (hx a) c f}

/-- Exact graph of reducing an integral linear endomorphism modulo `p`.

The target candidate is a `ZMod p`-linear endomorphism of the scalar extension;
the displayed pure-tensor formula is exactly entrywise matrix reduction in any
integral basis.  Invertibility and Lie-bracket compatibility are result-layer
properties. -/
def IsModPReductionData
    {M : Type u} [AddCommGroup M] [Module ℤ M]
    (p : ℕ) (f : Module.End ℤ M)
    (g : Module.End (ZMod p) (ZMod p ⊗[ℤ] M)) : Prop :=
  ∀ (a : ZMod p) (m : M),
    g (a ⊗ₜ[ℤ] m) = a ⊗ₜ[ℤ] f m

end LeanCategories.Algebra
