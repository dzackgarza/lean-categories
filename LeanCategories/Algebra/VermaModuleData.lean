module

public import LeanCategories.Algebra.OneDimensionalBorelActionData
public import Mathlib.Algebra.Lie.UniversalEnveloping

/-!
# Verma-module presentation data

Definition-level realization of Humphreys FC14-C06-U010, adapted from
TauCetiProject/TauCeti at
74b1b2b2a25467497550234a92ddfc1322a5903f (Apache-2.0),
TauCeti/Algebra/Lie/HighestWeight/Verma.lean.

The classical induced module Z(lambda)=U(L) tensor_{U(B)} D_lambda is
represented by the equivalent quotient presentation used in the reference:
take the left submodule of U(L) generated by the Cartan weight relations and
the positive-nilradical generators, then quotient U(L) by it.

This file records only that carrier, its quotient map, and the canonical class
of 1. The statements that the generator has weight lambda, is annihilated by
the positive nilradical, generates the quotient as a Lie module, and that the
quotient is canonically U(N^-) are result/PBW clauses and are not imported
into Sweep III.
-/

@[expose] public noncomputable section

open UniversalEnvelopingAlgebra

namespace LeanCategories.Algebra

universe u v w

variable {I : Type u} {K : Type v} {L : Type w}
variable [Finite I] [Field K] [LieRing L] [LieAlgebra K L]
variable {H : LieSubalgebra K L}

local notation "U" => UniversalEnvelopingAlgebra K L

/-- The two families of defining Verma relations of weight lam. -/
def vermaRelationsData
    (b : LieAlgebra.Basis I H) (lam : Module.Dual K H) : Set U :=
  Set.range
      (fun h : H =>
        (UniversalEnvelopingAlgebra.ι K (h : L) : U) -
          algebraMap K U (lam h)) ∪
    (fun n : L => (UniversalEnvelopingAlgebra.ι K n : U)) ''
      (standardPositiveNilradical b : Set L)

/-- The left U(L)-submodule generated by the Verma relations.

Using a left submodule of the regular module is exactly the reference's left
ideal presentation, and needs no separate ideal-closure proof. -/
def vermaIdealData
    (b : LieAlgebra.Basis I H) (lam : Module.Dual K H) :
    Submodule U U :=
  Submodule.span U (vermaRelationsData b lam)

/-- Humphreys' Verma-module carrier in quotient presentation. -/
abbrev VermaModuleData
    (b : LieAlgebra.Basis I H) (lam : Module.Dual K H) :=
  U ⧸ vermaIdealData b lam

/-- Canonical quotient map from U(L) to Z(lambda). -/
def vermaMkData
    (b : LieAlgebra.Basis I H) (lam : Module.Dual K H) :
    U →ₗ[U] VermaModuleData b lam :=
  Submodule.mkQ (vermaIdealData b lam)

/-- Canonical cyclic vector, the class of 1 in the Verma quotient. -/
def vermaGeneratorData
    (b : LieAlgebra.Basis I H) (lam : Module.Dual K H) :
    VermaModuleData b lam :=
  vermaMkData b lam 1

end LeanCategories.Algebra
