module

public import LeanCategories.Algebra.IntegralInnerReductionData
public import Mathlib.Algebra.Polynomial.Eval.Defs
public import Mathlib.LinearAlgebra.Matrix.Basis
public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
public import Mathlib.LinearAlgebra.Matrix.ToLin

/-!
# Adjoint Chevalley-group data

Definition-level realization of Humphreys FC14-C07-U013.

Humphreys first writes each root exponential as an integral polynomial
matrix `x_α(T)`, then specializes `T` to `c ∈ K`, and defines `G(K)` to be
the subgroup generated by those root elements.  The definitions below keep
exactly that order.

The polynomial-matrix graph is stated against the integral root-exponential
endomorphisms of FC14-C07-U012.  After specialization, a root element is
represented by an exact graph on a candidate element of `GL`; hence no
invertibility proof is needed merely to state the construction.  Existence of
those `GL` lifts and the finite-field finiteness/simplicity assertions remain
result content.
-/

@[expose] public noncomputable section

namespace LeanCategories.Algebra

universe u v w

/-- Exact graph saying that `P_α(T)` is the integral polynomial matrix whose
integer specializations are the supplied integral root exponentials. -/
def IsIntegralRootPolynomialMatrixData
    {I : Type u} {M : Type v} {Phi : Type w}
    [Fintype I] [DecidableEq I]
    [AddCommGroup M] [Module ℤ M]
    (b : Module.Basis I ℤ M)
    (rootExp : Phi → ℤ → Module.End ℤ M)
    (P : Phi → Matrix I I (Polynomial ℤ)) : Prop :=
  ∀ alpha : Phi, ∀ c : ℤ,
    (P alpha).map (Polynomial.evalRingHom c) =
      LinearMap.toMatrix b b (rootExp alpha c)

/-- Specialization of the integral root polynomial matrix `P_α(T)` at
`T = c` over a commutative coefficient ring `K`. -/
def specializedRootMatrixData
    {I : Type u} {Phi : Type v} {K : Type w}
    [Fintype I] [DecidableEq I] [CommRing K]
    (P : Phi → Matrix I I (Polynomial ℤ))
    (alpha : Phi) (c : K) : Matrix I I K :=
  (P alpha).map (Polynomial.eval₂RingHom (Int.castRingHom K) c)

/-- Exact graph of a specialized root element as a candidate element of
`GL(I,K)`.  Invertibility is carried by the candidate and is not proved by
this definition. -/
def IsAdjointChevalleyRootElementData
    {I : Type u} {Phi : Type v} {K : Type w}
    [Fintype I] [DecidableEq I] [CommRing K]
    (P : Phi → Matrix I I (Polynomial ℤ))
    (alpha : Phi) (c : K) (g : Matrix.GeneralLinearGroup I K) : Prop :=
  (g : Matrix I I K) = specializedRootMatrixData P alpha c

/-- Humphreys' adjoint Chevalley group `G(K)`: the subgroup of `GL(I,K)`
generated by every specialized root element whose underlying matrix is the
specialization of `P_α(T)`.

If a specialization has not yet been proved invertible, it contributes no
candidate `GL` lift to the generator set.  The theorem that every root
specialization has such a lift is therefore a totality obligation for this
exact graph, not a hidden constructor proof. -/
def adjointChevalleyGroupData
    {I : Type u} {Phi : Type v} {K : Type w}
    [Fintype I] [DecidableEq I] [CommRing K]
    (P : Phi → Matrix I I (Polynomial ℤ)) :
    Subgroup (Matrix.GeneralLinearGroup I K) :=
  Subgroup.closure
    {g | ∃ alpha : Phi, ∃ c : K,
      IsAdjointChevalleyRootElementData P alpha c g}

end LeanCategories.Algebra
