/-!
# TorExercise3A2: Hatcher §3.A Exercise 2 for arbitrary abelian groups

Card `E-HAT-3.A-2` of the qualifying-exam corpus.  Source: Hatcher, *Algebraic
Topology* (2002), §3.A Exercise 2 (printed p. 267): `Tor(A, ℚ/ℤ)` is isomorphic
to the torsion subgroup of `A`, and `A` is torsion-free if and only if
`Tor(A, B) = 0` for all `B`.  Text version read:
`.tmp-sources/hatcher-2002-algebraic-topology.md`, the exercise at line 5704,
Proposition 3A.5 (printed p. 265) from line 5624 — item (3), Tor vanishes when a
variable is torsion-free, is cited at the `flat_of_torsionFree` step of the second
statement — and the proof of Corollary 3A.7 at lines 5686-5696, which is Hatcher's
own use of the six-term sequence for `0 → ℤ → ℚ → ℚ/ℤ → 0`.

LC-09 search record (formalization corpus, `scripts/formalization_corpus.py`,
2026-11-18, plus local Mathlib): queries `torsion subgroup Tor Q/Z`,
`Tor torsion subgroup abelian group`, `torsionFree Tor vanish`,
`content:torsion ker tensor Rat`, `content:IsLocalization torsion`,
`content:QuotientAddGroup Rat Int`.  Hits used: TauCeti's
`TauCeti/Algebra/Module/Torsion/Localization.lean` (`module`-docstring statement
that an abelian group is torsion exactly when its base change to `ℚ` vanishes;
its proof is `IsLocalizedModule.subsingleton_iff` on
`TensorProduct.mk R A M 1`), ported here in the elementwise form
`mem_torsion_iff_toRatTensor` — the `Subsingleton` form the file states is not
enough for the kernel statement this card needs.  Mathlib's
`Algebra/Module/LocalizedModule/Basic.lean:1145` (`IsLocalizedModule.eq_zero_iff`)
and `Algebra/Module/Torsion/Basic.lean:750` (`Submodule.mem_torsion_iff`) are the
two lemmas the port turns on.  Mathlib's `CategoryTheory.Tor` supplies no
long-exact-sequence, balancing or colimit API, so the comparison is carried
elementwise through the presentation-level kernels of `TorReductions` and the canonical
presentation of `TorExercise3A6`, as in the sibling cards.

## The route

Hatcher's own proof of Corollary 3A.7 (printed pp. 265-266) reads the first statement off the
six-term sequence of `0 → ℤ → ℚ → ℚ/ℤ → 0` (Proposition 3A.5(6)): the connecting map identifies
`Tor(A, ℚ/ℤ)` with the kernel of `A → A ⊗ ℚ`, which is the torsion subgroup.  That route is the one
taken here, since Mathlib's `CategoryTheory.Tor` carries no long-exact-sequence API: the six-term
sequence is not invoked, and the two kernels are compared at the presentation
`0 → ker π → (A → 0 ℤ) → A → 0` of the first variable.

* `mem_torsion_iff_toRatTensor` / `torsion_eq_ker_toRatTensor`: the torsion subgroup of `A` is the
  kernel of the coefficient change `A → ℚ ⊗ A` (the `TauCeti` port recorded above).
* `torsionToSyzKernel`: the connecting map, elementwise — an element of order `n` goes to
  `n • single a 1 ⊗ 1/n` in `ker π ⊗ ℚ/ℤ` (`syzClass`).
* `torsionToSyzKernel_injective` via `syzClass_ne_zero`: the cyclic subgroup generated by the
  syzygy element is pure, so the quotient of the syzygy by it is torsion-free and flat, and
  `ℤ z ⊗ ℚ/ℤ → ker π ⊗ ℚ/ℤ` is injective (the technique of
  `TorExercise3A6.exists_torOne_of_addOrderOf`, here for an arbitrary additive order).
* `torsionToSyzKernel_surjective`: a class `k ⊗ 1/N` over `ℚ/ℤ`'s divisibility — the coordinates of
  `k` in the free module are divisible by `N`, so `k = N • f` and `f + ker π` is the torsion
  element wanted.
* `torOneQzAddEquivTorsion` assembles those with the presentation bridge
  `TorExercise3A6.torOneTorKernelAddEquiv`; `isTorsionFree_iff_forall_subsingleton_torOne` is the
  second statement, by flatness of a torsion-free group in the forward direction and the first
  statement at `B = ℚ/ℤ` backwards.
-/

namespace LeanCategories.Homological.TorExercise3A2

open TensorProduct

/-! ## `ℚ / ℤ` as a `ℤ`-module

The exercise's coefficient group, as the quotient of `ℚ` by the subgroup `ℤ`, with the class of
`1 / n` named: `Tor(A, ℚ/ℤ)` is computed from the classes `1 / n`, which generate `ℚ/ℤ` as the
union of its finite cyclic subgroups. -/

/-- The subgroup `ℤ` of `ℚ`, as a `ℤ`-submodule. -/
def intSpan : Submodule ℤ ℚ := Submodule.span ℤ {(1 : ℚ)}

/-- `ℚ / ℤ`: Hatcher's coefficient group of §3.A Exercise 2. -/
abbrev QZ : Type := ℚ ⧸ intSpan

/-- The class of `1 / n` in `ℚ / ℤ`. -/
def qzInv (n : ℕ) : QZ := Submodule.Quotient.mk ((n : ℚ)⁻¹)

theorem mk_smul_apply (c : ℤ) (q : ℚ) :
    (Submodule.Quotient.mk (c • q) : QZ) = c • Submodule.Quotient.mk q :=
  Submodule.Quotient.mk_smul intSpan c q

theorem qzInv_zsmul_self (n : ℕ) (hn : n ≠ 0) : (n : ℤ) • qzInv n = 0 := by
  have h : ((n : ℚ)) ≠ 0 := by exact_mod_cast hn
  have hmem : ((n : ℤ) • ((n : ℚ)⁻¹)) ∈ intSpan := by
    rw [intSpan, Submodule.mem_span_singleton]
    refine ⟨1, ?_⟩
    rw [one_smul, zsmul_eq_mul, Int.cast_natCast]
    exact (mul_inv_cancel₀ h).symm
  show (n : ℤ) • Submodule.Quotient.mk ((n : ℚ)⁻¹) = 0
  rw [← mk_smul_apply, Submodule.Quotient.mk_eq_zero]
  exact hmem

theorem qzInv_zsmul_eq_zero {c : ℤ} {n : ℕ} (hn : n ≠ 0) :
    c • qzInv n = 0 ↔ (n : ℤ) ∣ c := by
  have h : ((n : ℚ)) ≠ 0 := by exact_mod_cast hn
  constructor
  · intro hc
    have hmem : c • ((n : ℚ)⁻¹) ∈ intSpan := by
      rw [← Submodule.Quotient.mk_eq_zero, mk_smul_apply]
      exact hc
    rw [intSpan, Submodule.mem_span_singleton] at hmem
    obtain ⟨r, hr⟩ := hmem
    have hcr : (c : ℚ) = (r : ℚ) * n := by
      have h2 : (r : ℚ) = (c : ℚ) * ((n : ℚ))⁻¹ := by
        have hh := hr
        simp only [zsmul_eq_mul, mul_one] at hh
        exact hh
      rw [h2]
      field_simp
    refine ⟨r, ?_⟩
    have hq : ((c : ℚ)) = (((n : ℤ) * r : ℤ) : ℚ) := by
      push_cast
      rw [mul_comm]
      linarith
    exact_mod_cast hq
  · rintro ⟨k, rfl⟩
    rw [mul_smul, smul_comm (n : ℤ) k, qzInv_zsmul_self n hn, smul_zero]

theorem qzInv_mul_zsmul {j n : ℕ} (hj : j ≠ 0) (_hn : n ≠ 0) :
    (j : ℤ) • qzInv (j * n) = qzInv n := by
  have hcast : (((j * n : ℕ)) : ℚ)⁻¹ = ((j : ℚ))⁻¹ * ((n : ℚ))⁻¹ := by
    rw [Nat.cast_mul, mul_inv]
  have hkey : ((j : ℚ)) * (((j * n : ℕ)) : ℚ)⁻¹ = ((n : ℚ))⁻¹ := by
    rw [hcast, ← mul_assoc, mul_inv_cancel₀, one_mul]
    exact_mod_cast hj
  rw [qzInv, qzInv, ← mk_smul_apply, Submodule.Quotient.eq, intSpan,
    Submodule.mem_span_singleton]
  refine ⟨0, ?_⟩
  simp only [zsmul_eq_mul, Int.cast_natCast, hkey, sub_self, Int.cast_zero, zero_mul]

theorem qzInv_ne_zero {n : ℕ} (hn : n ≠ 0) (hn1 : n ≠ 1) : qzInv n ≠ 0 := by
  intro h
  have hm : ((n : ℚ)⁻¹) ∈ intSpan := (Submodule.Quotient.mk_eq_zero _).mp h
  rw [intSpan, Submodule.mem_span_singleton] at hm
  obtain ⟨r, hr⟩ := hm
  have hq : ((n : ℚ)⁻¹) = (r : ℚ) := by
    have := hr.symm
    simpa only [zsmul_eq_mul, mul_one] using this
  have hnr : (n : ℚ) * r = 1 := by
    rw [← hq]
    exact mul_inv_cancel₀ (by exact_mod_cast hn)
  have hz : ((n : ℤ) * r : ℤ) = 1 := by exact_mod_cast hnr
  have hnat : n ∣ 1 := Int.natCast_dvd_natCast.mp ⟨r, hz.symm⟩
  have := Nat.le_of_dvd one_pos hnat
  omega

theorem exists_smul_qzInv (d : QZ) : ∃ (n : ℕ) (_ : n ≠ 0) (m : ℤ), d = m • qzInv n := by
  induction d using Submodule.Quotient.induction_on with
  | _ q =>
    refine ⟨q.den, q.den_pos.ne', q.num, ?_⟩
    rw [qzInv, ← mk_smul_apply, Submodule.Quotient.eq]
    rw [intSpan, Submodule.mem_span_singleton]
    refine ⟨0, ?_⟩
    have hnum : ((q.num : ℚ)) * (((q.den : ℕ)) : ℚ)⁻¹ = (q : ℚ) := by
      rw [← div_eq_mul_inv]
      exact Rat.num_div_den q
    simp only [zsmul_eq_mul, hnum, sub_self, Int.cast_zero, mul_one]

/-! ## The torsion subgroup as the kernel of `A → ℚ ⊗ A`

Hatcher's proof of Corollary 3A.7 (printed pp. 265-266) reads the torsion of `A` off the
coefficient change `A → A ⊗ ℚ`: the kernel of that map is the torsion subgroup.  The
formalization follows `TauCeti/Algebra/Module/Torsion/Localization.lean`, whose
`isAddTorsion_iff_subsingleton_rat_tensorProduct` records the module-level form of the same
fact; the elementwise form below is what the Tor comparison needs. -/

/-- The coefficient change `A → ℚ ⊗[ℤ] A`, `a ↦ 1 ⊗ a`.  Its kernel is the torsion subgroup. -/
noncomputable def toRatTensor (A : Type) [AddCommGroup A] :
    A →ₗ[ℤ] TensorProduct ℤ ℚ A :=
  TensorProduct.mk ℤ ℚ A (1 : ℚ)

theorem toRatTensor_apply (A : Type) [AddCommGroup A] (a : A) :
    toRatTensor A a = (1 : ℚ) ⊗ₜ[ℤ] a := rfl

/-- **Hatcher, §3.A Exercise 2, the identification behind the first statement.**  An element of
`A` is torsion exactly when it dies in `ℚ ⊗[ℤ] A`.  Proven by the localization criterion: `ℚ` is
the localization of `ℤ` away from the non-zero-divisors, so `IsLocalizedModule.eq_zero_iff`
turns vanishing in the base change into being killed by a non-zero integer. -/
theorem mem_torsion_iff_toRatTensor (A : Type) [AddCommGroup A] (x : A) :
    x ∈ Submodule.torsion ℤ A ↔ toRatTensor A x = 0 := by
  have : IsLocalization (nonZeroDivisors ℤ) ℚ := inferInstance
  rw [Submodule.mem_torsion_iff]
  exact (IsLocalizedModule.eq_zero_iff (nonZeroDivisors ℤ) (TensorProduct.mk ℤ ℚ A 1)).symm

/-- **Hatcher, §3.A Exercise 2, the first statement's target.**  The torsion subgroup of `A` is
the kernel of the coefficient change `A → ℚ ⊗[ℤ] A`. -/
theorem torsion_eq_ker_toRatTensor (A : Type) [AddCommGroup A] :
    Submodule.torsion ℤ A = LinearMap.ker (toRatTensor A) := by
  ext x
  rw [LinearMap.mem_ker, mem_torsion_iff_toRatTensor]

/-! ## The comparison map `T(A) → ker (ker π → (A →₀ ℤ)) ⊗ ℚ/ℤ`

For an element `a` of `A` killed by `n`, the syzygy of the canonical presentation
`π : (A →₀ ℤ) → A` contains `n • single a 1`, and `n • single a 1 ⊗ 1/n` dies in
`(A →₀ ℤ) ⊗ ℚ/ℤ`.  This is the connecting map of Hatcher's six-term sequence (Proposition
3A.5(6)) at the presentation.  The value does not depend on the choice of `n` (the coherence
lemma) nor on the chosen lift of `a` (`syzElem_tmul_congr`), which is what makes the map additive
and lets the surjectivity argument feed it an arbitrary lift. -/

/-- The syzygy element `n • single a 1` of an element `a` killed by `n`. -/
noncomputable def syzElem (A : Type) [AddCommGroup A] (a : A) (n : ℤ) (h : n • a = 0) :
    ↥(LinearMap.ker (TorExercise3A6.pres A)) :=
  ⟨n • Finsupp.single a 1, by
    rw [LinearMap.mem_ker, map_zsmul, TorExercise3A6.pres_single]
    simpa using h⟩

theorem syzElem_val {A : Type} [AddCommGroup A] {a : A} {n : ℤ}
    (h : n • a = 0) : (syzElem A a n h : A →₀ ℤ) = n • Finsupp.single a 1 := rfl

/-- The syzygy element of `n * k` is `k` times the syzygy element of `n`. -/
theorem syzElem_natCast_mul {A : Type} [AddCommGroup A] {a : A} {n k : ℕ}
    (ha : (n : ℤ) • a = 0) :
    syzElem A a (((n * k : ℕ)) : ℤ) (by
        rw [Nat.cast_mul, mul_smul, smul_comm (n : ℤ) (k : ℤ), ha, smul_zero])
      = (k : ℤ) • syzElem A a ((n : ℤ)) ha := by
  apply Subtype.ext
  show (((n * k : ℕ)) : ℤ) • Finsupp.single a 1 = (k : ℤ) • ((n : ℤ) • Finsupp.single a 1)
  rw [Nat.cast_mul, mul_comm]
  exact mul_smul (k : ℤ) (n : ℤ) _

/-- **Coherence of the comparison:** the classes `1/n` and `1/(n * k)` give the same element of
`ker π ⊗ ℚ/ℤ`. -/
theorem syzElem_tmul_coherence {A : Type} [AddCommGroup A] {a : A} {n k : ℕ}
    (hn : n ≠ 0) (hk : k ≠ 0) (ha : (n : ℤ) • a = 0) :
    (syzElem A a (((n * k : ℕ)) : ℤ) (by
        rw [Nat.cast_mul, mul_smul, smul_comm (n : ℤ) (k : ℤ), ha, smul_zero]) ⊗ₜ[ℤ]
        qzInv (n * k))
      = (syzElem A a ((n : ℤ)) ha ⊗ₜ[ℤ] qzInv n) := by
  rw [syzElem_natCast_mul ha, TensorProduct.smul_tmul, Nat.mul_comm n k,
    qzInv_mul_zsmul hk hn]

/-- **Independence of the lift.**  Two lifts of the same element of `A` give the same element of
`ker π ⊗ ℚ/ℤ` after multiplication by the denominator, because their difference lies in the
syzygy and `n • (1/n) = 0` there. -/
theorem syzElem_tmul_congr {A : Type} [AddCommGroup A] {n : ℕ} (hn : n ≠ 0) {x : A}
    (hx : (n : ℤ) • x = 0) {f' : A →₀ ℤ} (hf' : TorExercise3A6.pres A f' = x) :
    (syzElem A x ((n : ℤ)) hx ⊗ₜ[ℤ] qzInv n)
      = (⟨(n : ℤ) • f', by
          rw [LinearMap.mem_ker, map_zsmul, hf']
          simpa using hx⟩ :
            ↥(LinearMap.ker (TorExercise3A6.pres A))) ⊗ₜ[ℤ] qzInv n := by
  rw [← sub_eq_zero]
  have hsub : (syzElem A x ((n : ℤ)) hx : ↥(LinearMap.ker (TorExercise3A6.pres A)))
      - ⟨(n : ℤ) • f', by
          rw [LinearMap.mem_ker, map_zsmul, hf']
          simpa using hx⟩
      = (n : ℤ) • ⟨Finsupp.single x 1 - f', by
          rw [LinearMap.mem_ker, map_sub, TorExercise3A6.pres_single, hf']
          simp⟩ := by
    apply Subtype.ext
    show (n : ℤ) • Finsupp.single x 1 - (n : ℤ) • f' = (n : ℤ) • (Finsupp.single x 1 - f')
    rw [smul_sub]
  rw [← TensorProduct.sub_tmul, hsub, TensorProduct.smul_tmul, qzInv_zsmul_self n hn,
    TensorProduct.tmul_zero]

theorem qzInv_one : qzInv 1 = 0 := by
  rw [qzInv, Nat.cast_one, inv_one, Submodule.Quotient.mk_eq_zero, intSpan]
  exact Submodule.subset_span (Set.mem_singleton 1)

/-! ## The comparison map `T(A) → Tor(A, ℚ/ℤ)` as a syzygy kernel -/

/-- A torsion element has finite additive order. -/
theorem isOfFinAddOrder_of_mem_torsion {A : Type} [AddCommGroup A] {a : A}
    (h : a ∈ Submodule.torsion ℤ A) : IsOfFinAddOrder a := by
  rw [Submodule.mem_torsion_iff] at h
  obtain ⟨r, hr⟩ := h
  refine isOfFinAddOrder_iff_zsmul_eq_zero.mpr ⟨(r : ℤ), ?_, hr⟩
  simp

theorem addOrderOf_ne_zero_of_mem_torsion {A : Type} [AddCommGroup A] {a : A}
    (h : a ∈ Submodule.torsion ℤ A) : addOrderOf a ≠ 0 :=
  addOrderOf_ne_zero_iff.mpr (isOfFinAddOrder_of_mem_torsion h)

theorem addOrderOf_zsmul_self {A : Type} [AddCommGroup A] (a : A) :
    ((addOrderOf a : ℕ) : ℤ) • a = 0 :=
  addOrderOf_dvd_iff_zsmul_eq_zero.mp dvd_rfl

/-- **Additivity of the syzygy class at a common denominator.**  The extra `single 0 1` that the
Finsupp identity `single (x + y) 1 = single x 1 + single y 1` leaves behind (it fails for `y = 0`)
is killed by the class `1/N`, which is why the identity is stated after tensoring. -/
theorem syzElem_add_tmul {A : Type} [AddCommGroup A] {x y : A} {N : ℕ} (hN : N ≠ 0)
    (hx : (N : ℤ) • x = 0) (hy : (N : ℤ) • y = 0) :
    (syzElem A (x + y) ((N : ℤ)) (by rw [smul_add, hx, hy, add_zero]) ⊗ₜ[ℤ] qzInv N)
      = (syzElem A x ((N : ℤ)) hx ⊗ₜ[ℤ] qzInv N)
        + (syzElem A y ((N : ℤ)) hy ⊗ₜ[ℤ] qzInv N) := by
  have hsum : (N : ℤ) • (x + y) = 0 := by rw [smul_add, hx, hy, add_zero]
  have hpres : TorExercise3A6.pres A (Finsupp.single x 1 + Finsupp.single y 1) = x + y := by
    rw [map_add]
    simp [TorExercise3A6.pres_single]
  rw [syzElem_tmul_congr hN hsum hpres]
  have hsplit : (⟨(N : ℤ) • (Finsupp.single x 1 + Finsupp.single y 1), by
      rw [LinearMap.mem_ker, map_zsmul, hpres]
      simpa using hsum⟩ : ↥(LinearMap.ker (TorExercise3A6.pres A)))
      = (⟨(N : ℤ) • Finsupp.single x 1, by
            rw [LinearMap.mem_ker, map_zsmul, TorExercise3A6.pres_single]
            simp [hx]⟩ : ↥(LinearMap.ker (TorExercise3A6.pres A)))
        + (⟨(N : ℤ) • Finsupp.single y 1, by
            rw [LinearMap.mem_ker, map_zsmul, TorExercise3A6.pres_single]
            simp [hy]⟩ : ↥(LinearMap.ker (TorExercise3A6.pres A))) := by
    apply Subtype.ext
    show (N : ℤ) • (Finsupp.single x 1 + Finsupp.single y 1)
      = (N : ℤ) • Finsupp.single x 1 + (N : ℤ) • Finsupp.single y 1
    rw [smul_add]
  rw [hsplit, TensorProduct.add_tmul]
  rfl

/-- The class of `d • single a 1 ⊗ 1/d` in the syzygy tensor, as a total function of `(a, d)`:
zero when `d` does not kill `a`.  Totality keeps the denominators out of the statement's
hypotheses, so the coherence and additivity lemmas below are equations between plain terms. -/
noncomputable def syzClass (A : Type) [AddCommGroup A] (a : A) (d : ℕ) :
    TensorProduct ℤ ↥(LinearMap.ker (TorExercise3A6.pres A)) QZ := by
  classical
  exact if h : ((d : ℤ) • a = 0) ∧ d ≠ 0 then syzElem A a ((d : ℕ) : ℤ) h.1 ⊗ₜ[ℤ] qzInv d else 0

theorem syzClass_of {A : Type} [AddCommGroup A] {a : A} {d : ℕ}
    (h1 : (d : ℤ) • a = 0) (h2 : d ≠ 0) :
    syzClass A a d = syzElem A a ((d : ℕ) : ℤ) h1 ⊗ₜ[ℤ] qzInv d := by
  rw [syzClass, dite_eq_left ⟨h1, h2⟩]

/-- The class lies in the presentation kernel: multiplying by `d` and then tensoring with `1/d`
kills the syzygy element. -/
theorem syzClass_mem_ker {A : Type} [AddCommGroup A] {a : A} {d : ℕ} :
    syzClass A a d ∈
      LinearMap.ker (((LinearMap.ker (TorExercise3A6.pres A)).subtype).rTensor QZ) := by
  by_cases h : ((d : ℤ) • a = 0) ∧ d ≠ 0
  · rw [syzClass, dite_eq_left h, LinearMap.mem_ker, LinearMap.rTensor_tmul, Submodule.coe_subtype,
      syzElem_val, TensorProduct.smul_tmul, qzInv_zsmul_self d h.2, TensorProduct.tmul_zero]
  · rw [syzClass, dite_eq_right h]
    exact Submodule.zero_mem _

/-- **Coherence of the comparison:** the classes `1/d` and `1/(d * k)` agree. -/
theorem syzClass_coherence {A : Type} [AddCommGroup A] {a : A} {d k : ℕ} (hd : d ≠ 0)
    (hk : k ≠ 0) (hm : (d : ℤ) • a = 0) :
    syzClass A a (d * k) = syzClass A a d := by
  have hN : (((d * k : ℕ)) : ℤ) • a = 0 := by
    rw [Nat.cast_mul, mul_smul, smul_comm (d : ℤ) (k : ℤ), hm, smul_zero]
  rw [syzClass_of hN (Nat.mul_ne_zero hd hk), syzClass_of hm hd]
  exact syzElem_tmul_coherence hd hk hm

/-- The same coherence with the factors of the denominator interchanged. -/
theorem syzClass_comm {A : Type} [AddCommGroup A] {a : A} {d k : ℕ} (hd : d ≠ 0) (hk : k ≠ 0)
    (hm : (d : ℤ) • a = 0) :
    syzClass A a (k * d) = syzClass A a d := by
  rw [Nat.mul_comm k d]
  exact syzClass_coherence hd hk hm

/-- **Additivity at a common denominator.** -/
theorem syzClass_add {A : Type} [AddCommGroup A] {x y : A} {d : ℕ} (hd : d ≠ 0)
    (hx : (d : ℤ) • x = 0) (hy : (d : ℤ) • y = 0) :
    syzClass A (x + y) d = syzClass A x d + syzClass A y d := by
  have hsum : (d : ℤ) • (x + y) = 0 := by rw [smul_add, hx, hy, add_zero]
  rw [syzClass_of hsum hd, syzClass_of hx hd, syzClass_of hy hd]
  exact syzElem_add_tmul hd hx hy

/-- **The comparison map `T(A) → ker (ker π → (A →₀ ℤ)) ⊗ ℚ/ℤ`.**  A torsion element of additive
order `n` goes to the class of `n • single a 1 ⊗ 1/n`. -/
noncomputable def torsionToSyzKernel (A : Type) [AddCommGroup A] :
    ↥(Submodule.torsion ℤ A) →+
      ↥(LinearMap.ker (((LinearMap.ker (TorExercise3A6.pres A)).subtype).rTensor QZ)) where
  toFun x := ⟨syzClass A (x : A) (addOrderOf (x : A)), syzClass_mem_ker⟩
  map_zero' := by
    refine Subtype.ext ?_
    show syzClass A (((0 : ↥(Submodule.torsion ℤ A)) : A))
      (addOrderOf (((0 : ↥(Submodule.torsion ℤ A)) : A))) = (0 : TensorProduct ℤ _ QZ)
    rw [AddSubmonoid.coe_zero, addOrderOf_zero, syzClass_of (by simp) one_ne_zero,
      qzInv_one, TensorProduct.tmul_zero]
  map_add' := fun x y => by
    refine Subtype.ext ?_
    show syzClass A (((x : ↥(Submodule.torsion ℤ A)) : A) + ((y : ↥(Submodule.torsion ℤ A)) : A))
        (addOrderOf (((x : ↥(Submodule.torsion ℤ A)) : A) + ((y : ↥(Submodule.torsion ℤ A)) : A)))
      = syzClass A ((x : ↥(Submodule.torsion ℤ A)) : A)
          (addOrderOf ((x : ↥(Submodule.torsion ℤ A)) : A))
        + syzClass A ((y : ↥(Submodule.torsion ℤ A)) : A)
          (addOrderOf ((y : ↥(Submodule.torsion ℤ A)) : A))
    have hx0 : addOrderOf ((x : ↥(Submodule.torsion ℤ A)) : A) ≠ 0 :=
      addOrderOf_ne_zero_of_mem_torsion x.2
    have hy0 : addOrderOf ((y : ↥(Submodule.torsion ℤ A)) : A) ≠ 0 :=
      addOrderOf_ne_zero_of_mem_torsion y.2
    have hN0 : addOrderOf ((x : ↥(Submodule.torsion ℤ A)) : A)
        * addOrderOf ((y : ↥(Submodule.torsion ℤ A)) : A) ≠ 0 := Nat.mul_ne_zero hx0 hy0
    have hxm : (((addOrderOf ((x : ↥(Submodule.torsion ℤ A)) : A)
        * addOrderOf ((y : ↥(Submodule.torsion ℤ A)) : A) : ℕ)) : ℤ)
        • ((x : ↥(Submodule.torsion ℤ A)) : A) = 0 :=
      addOrderOf_dvd_iff_zsmul_eq_zero.mp (by exact_mod_cast Nat.dvd_mul_right _ _)
    have hym : (((addOrderOf ((x : ↥(Submodule.torsion ℤ A)) : A)
        * addOrderOf ((y : ↥(Submodule.torsion ℤ A)) : A) : ℕ)) : ℤ)
        • ((y : ↥(Submodule.torsion ℤ A)) : A) = 0 :=
      addOrderOf_dvd_iff_zsmul_eq_zero.mp (by exact_mod_cast Nat.dvd_mul_left _ _)
    have hsum : (((addOrderOf ((x : ↥(Submodule.torsion ℤ A)) : A)
        * addOrderOf ((y : ↥(Submodule.torsion ℤ A)) : A) : ℕ)) : ℤ)
        • (((x : ↥(Submodule.torsion ℤ A)) : A) + ((y : ↥(Submodule.torsion ℤ A)) : A)) = 0 := by
      rw [smul_add, hxm, hym, add_zero]
    have hdiv : addOrderOf (((x : ↥(Submodule.torsion ℤ A)) : A)
          + ((y : ↥(Submodule.torsion ℤ A)) : A))
        ∣ addOrderOf ((x : ↥(Submodule.torsion ℤ A)) : A)
          * addOrderOf ((y : ↥(Submodule.torsion ℤ A)) : A) := by
      have h := addOrderOf_dvd_iff_zsmul_eq_zero.mpr hsum
      exact_mod_cast h
    obtain ⟨k, hk⟩ := hdiv
    have hk0 : k ≠ 0 := by
      rintro rfl
      rw [Nat.mul_zero] at hk
      exact hN0 hk
    have hm0 : addOrderOf (((x : ↥(Submodule.torsion ℤ A)) : A)
          + ((y : ↥(Submodule.torsion ℤ A)) : A)) ≠ 0 :=
      addOrderOf_ne_zero_of_mem_torsion (x + y).2
    rw [← syzClass_coherence hm0 hk0 (addOrderOf_zsmul_self _), ← hk,
      ← syzClass_coherence hx0 hy0 (addOrderOf_zsmul_self _),
      ← syzClass_comm hy0 hx0 (addOrderOf_zsmul_self _),
      syzClass_add hN0 hxm hym]

/-- The comparison map, evaluated: the class of the syzygy tensor at the additive order. -/
theorem torsionToSyzKernel_apply (A : Type) [AddCommGroup A]
    (x : ↥(Submodule.torsion ℤ A)) :
    (torsionToSyzKernel A x : TensorProduct ℤ ↥(LinearMap.ker (TorExercise3A6.pres A)) QZ)
      = syzClass A (x : A) (addOrderOf (x : A)) := rfl

/-! ## Injectivity: a nonzero torsion element gives a nonzero syzygy class

The cyclic subgroup generated by `z = n • single a 1` is *pure* in the syzygy — a multiple of an
element landing in `ℤ z` puts the element there, because `z` is supported at the single index `a`
and the `a`-coordinate is pinned by the order of `a` — so the quotient of the syzygy by `ℤ z` is
torsion-free, hence flat, and `ℤ z ⊗ ℚ/ℤ → ker π ⊗ ℚ/ℤ` is injective.  This is the argument of
`TorExercise3A6.exists_torOne_of_addOrderOf` (Hatcher §3.A Exercise 6) with an arbitrary additive
order in place of a prime power. -/
theorem syzClass_ne_zero {A : Type} [AddCommGroup A] {a : A} (hfin : IsOfFinAddOrder a)
    (ha : a ≠ 0) : syzClass A a (addOrderOf a) ≠ 0 := by
  classical
  have h0 : addOrderOf a ≠ 0 := addOrderOf_ne_zero_iff.mpr hfin
  have h1 : addOrderOf a ≠ 1 := by
    intro h
    refine ha ?_
    have hdvd : ((addOrderOf a : ℕ) : ℤ) ∣ (1 : ℤ) := by rw [h]; norm_num
    have hsm := addOrderOf_dvd_iff_zsmul_eq_zero.mp hdvd
    simpa using hsm
  -- the syzygy element and its support
  set z : ↥(LinearMap.ker (TorExercise3A6.pres A)) :=
    syzElem A a ((addOrderOf a : ℕ) : ℤ) (addOrderOf_zsmul_self a) with hzdef
  have hzval : (z : A →₀ ℤ) = Finsupp.single a ((addOrderOf a : ℕ) : ℤ) := by
    rw [hzdef, syzElem_val, Finsupp.smul_single_one]
  -- a multiple of `z` vanishing in the free module is zero
  have hzm : ∀ m : ℤ, m • z = 0 → m = 0 := by
    intro m hm
    have h1' : m • (z : A →₀ ℤ) = 0 := congrArg Subtype.val hm
    rw [hzval, Finsupp.smul_single'] at h1'
    have h2 : m * ((addOrderOf a : ℕ) : ℤ) = 0 := by
      by_contra hne
      exact hne (Finsupp.single_eq_zero.mp h1')
    exact (mul_eq_zero.mp h2).resolve_right (by exact_mod_cast h0)
  set f₀ : ℤ →ₗ[ℤ] ↥(LinearMap.ker (TorExercise3A6.pres A)) :=
    LinearMap.toSpanSingleton ℤ ↥(LinearMap.ker (TorExercise3A6.pres A)) z with hf₀
  have hf₀app : ∀ c : ℤ, f₀ c = c • z := fun c =>
    LinearMap.toSpanSingleton_apply ℤ ↥(LinearMap.ker (TorExercise3A6.pres A)) z c
  have hf₀inj : Function.Injective f₀ := by
    intro m n hmn
    have h : f₀ (m - n) = 0 := by rw [map_sub, hmn, sub_self]
    rw [hf₀app] at h
    exact sub_eq_zero.mp (hzm (m - n) h)
  -- purity: a multiple in the cyclic subgroup is already there
  have hpure : ∀ (m : ℤ) (y : ↥(LinearMap.ker (TorExercise3A6.pres A))), m ≠ 0 →
      m • y ∈ LinearMap.range f₀ → y ∈ LinearMap.range f₀ := by
    intro m y hm hmem
    rw [LinearMap.range_toSpanSingleton, Submodule.mem_span_singleton] at hmem
    obtain ⟨c, hc⟩ := hmem
    rw [LinearMap.range_toSpanSingleton, Submodule.mem_span_singleton]
    have hcoe : m • (y : A →₀ ℤ) = c • (z : A →₀ ℤ) := by
      have h := congrArg Subtype.val hc
      simpa only [Submodule.coe_smul] using h.symm
    have hsingle : (y : A →₀ ℤ) = Finsupp.single a ((y : A →₀ ℤ) a) := by
      ext x
      by_cases hx : x = a
      · rw [hx, Finsupp.single_eq_same]
      · rw [Finsupp.single_eq_of_ne hx]
        have hx0 : (m • (y : A →₀ ℤ)) x = 0 := by
          rw [hcoe, Finsupp.smul_apply, hzval, Finsupp.single_eq_of_ne hx, smul_zero]
        rw [Finsupp.smul_apply] at hx0
        exact (mul_eq_zero.mp hx0).resolve_left hm
    have hdvd : ((addOrderOf a : ℕ) : ℤ) ∣ (y : A →₀ ℤ) a := by
      have hy : (TorExercise3A6.pres A) (Finsupp.single a ((y : A →₀ ℤ) a)) = 0 := by
        rw [← hsingle]
        exact y.2
      rw [TorExercise3A6.pres_single] at hy
      exact addOrderOf_dvd_iff_zsmul_eq_zero.mpr (by simpa using hy)
    obtain ⟨c', hc'⟩ := hdvd
    refine ⟨c', ?_⟩
    apply Subtype.ext
    show c' • (z : A →₀ ℤ) = (y : A →₀ ℤ)
    rw [hzval, Finsupp.smul_single', hsingle, hc', mul_comm]
  -- the quotient is torsion-free, hence flat
  have htors : Submodule.torsion ℤ
      (↥(LinearMap.ker (TorExercise3A6.pres A)) ⧸ LinearMap.range f₀) = ⊥ := by
    rw [Submodule.eq_bot_iff]
    rintro x hx
    obtain ⟨r, hr⟩ := hx
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective (p := LinearMap.range f₀) x
    have hr0 : (r : ℤ) ≠ 0 := by simp
    have hmem : (r : ℤ) • y ∈ LinearMap.range f₀ := by
      refine (Submodule.Quotient.mk_eq_zero _).mp ?_
      rw [← Submodule.mkQ_apply, map_zsmul, Submodule.mkQ_apply]
      exact hr
    exact (Submodule.Quotient.mk_eq_zero _).mpr (hpure (r : ℤ) y hr0 hmem)
  haveI hTF : Module.IsTorsionFree ℤ
      (↥(LinearMap.ker (TorExercise3A6.pres A)) ⧸ LinearMap.range f₀) :=
    Submodule.isTorsionFree_iff_torsion_eq_bot.mpr htors
  have hinj : Function.Injective (LinearMap.rTensor QZ f₀) :=
    TorReductions.rTensor_injective_of_flat_cokernel (B := QZ) f₀ hf₀inj
  -- the value of the comparison map is `z ⊗ 1/n`
  have hval : syzClass A a (addOrderOf a) = z ⊗ₜ[ℤ] qzInv (addOrderOf a) := by
    rw [syzClass_of (addOrderOf_zsmul_self a) h0]
  intro hzero
  rw [hval] at hzero
  have hf0one : f₀ (1 : ℤ) = z := by rw [hf₀app, one_smul]
  have h2 : ((1 : ℤ) ⊗ₜ[ℤ] qzInv (addOrderOf a)) = 0 := by
    apply hinj
    rw [LinearMap.rTensor_tmul, hf0one, hzero]
    exact (map_zero (LinearMap.rTensor QZ f₀)).symm
  have h3 : qzInv (addOrderOf a) = 0 := by
    have := congrArg (TensorProduct.lid ℤ QZ) h2
    simpa using this
  exact absurd h3 (qzInv_ne_zero h0 h1)

/-- **The comparison map is injective.** -/
theorem torsionToSyzKernel_injective (A : Type) [AddCommGroup A] :
    Function.Injective (torsionToSyzKernel A) := by
  intro x y hxy
  have hz : x - y = 0 := by
    by_contra hne
    have hmem : (((x - y : ↥(Submodule.torsion ℤ A))) : A) ∈ Submodule.torsion ℤ A := (x - y).2
    have hne' : ((x - y : ↥(Submodule.torsion ℤ A)) : A) ≠ 0 := by
      intro h
      exact hne (Subtype.ext h)
    have h := syzClass_ne_zero (isOfFinAddOrder_of_mem_torsion hmem) hne'
    apply h
    have hdiff : torsionToSyzKernel A (x - y)
        = torsionToSyzKernel A x - torsionToSyzKernel A y := map_sub (torsionToSyzKernel A) x y
    rw [← torsionToSyzKernel_apply, hdiff, hxy]
    simp
  exact sub_eq_zero.mp hz

/-! ## Surjectivity: reading a torsion element off a syzygy class

Every element of the syzygy kernel is a finite sum of classes; a common denominator writes it as
`k ⊗ 1/N`.  The coordinates of `k` in the free module `A →₀ ℤ` are then divisible by `N` (apply the
coordinate functional and use `1/N`'s exact order), so `k = N • f` for some `f`, and `f + ker π` is
the torsion element whose class is the one we started from.  This is where the divisibility of
`ℚ/ℤ` enters. -/

/-- The coordinate functional at `a` of the free module `A →₀ ℤ`, at the `AddCommGroup`-synthesized
module structure used by `pres`. -/
def coordHom (A : Type) [AddCommGroup A] (a : A) : (A →₀ ℤ) →+ ℤ where
  toFun s := s a
  map_zero' := rfl
  map_add' s t := by
    show (s + t) a = s a + t a
    rw [Finsupp.add_apply]

/-- The coordinate functional, as a `ℤ`-linear map. -/
def coord (A : Type) [AddCommGroup A] (a : A) :
    @LinearMap ℤ ℤ _ _ (RingHom.id ℤ) (A →₀ ℤ) ℤ _ _
      (AddCommGroup.toIntModule (A →₀ ℤ)) (AddCommGroup.toIntModule ℤ) where
  toFun := coordHom A a
  map_add' := (coordHom A a).map_add
  map_smul' := (coordHom A a).map_zsmul

theorem coord_apply (A : Type) [AddCommGroup A] (a : A) (s : A →₀ ℤ) :
    coord A a s = s a := rfl

/-- A syzygy class vanishing in `(A →₀ ℤ) ⊗ ℚ/ℤ` has all coordinates divisible by its
denominator. -/
theorem dvd_apply_of_tmul_eq_zero {A : Type} [AddCommGroup A] {k : A →₀ ℤ} {N : ℕ}
    (hN : N ≠ 0) (h : k ⊗ₜ[ℤ] qzInv N = 0) : ∀ a, (N : ℤ) ∣ k a := by
  intro a
  have h1 : (LinearMap.rTensor QZ (coord A a)) (k ⊗ₜ[ℤ] qzInv N) = 0 := by rw [h, map_zero]
  rw [LinearMap.rTensor_tmul, coord_apply] at h1
  have h2 : (k a) • qzInv N = 0 := by
    have := congrArg (TensorProduct.lid ℤ QZ) h1
    simpa using this
  exact (qzInv_zsmul_eq_zero hN).mp h2

/-- An element of `A →₀ ℤ` all of whose coordinates are divisible by `N` is `N` times an
element. -/
theorem exists_eq_zsmul_of_dvd_apply {A : Type} [AddCommGroup A] {k : A →₀ ℤ} {N : ℕ}
    (h : ∀ a, (N : ℤ) ∣ k a) : ∃ f : A →₀ ℤ, k = (N : ℤ) • f := by
  classical
  refine ⟨Finsupp.onFinset k.support (fun a => k a / (N : ℤ)) ?_, ?_⟩
  · intro a ha
    by_contra hmem
    refine ha ?_
    have h0 : k a = 0 := by
      by_contra hne
      exact hmem (Finsupp.mem_support_iff.mpr hne)
    rw [h0]
    simp
  · ext a
    rw [Finsupp.smul_apply, Finsupp.onFinset_apply]
    show k a = (N : ℤ) * (k a / (N : ℤ))
    exact (Int.mul_ediv_cancel' (h a)).symm

/-- Pushing a syzygy class to a multiple of its denominator. -/
theorem tmul_qzInv_mul {A : Type} [AddCommGroup A] {N j : ℕ} (hN : N ≠ 0) (hj : j ≠ 0)
    (k : ↥(LinearMap.ker (TorExercise3A6.pres A))) :
    k ⊗ₜ[ℤ] qzInv N = ((j : ℤ) • k) ⊗ₜ[ℤ] qzInv (N * j) := by
  rw [TensorProduct.smul_tmul, Nat.mul_comm N j, qzInv_mul_zsmul hj hN]

/-- **Every element of the syzygy tensor is a syzygy class at some denominator.** -/
theorem exists_syzElem_tmul_eq (A : Type) [AddCommGroup A]
    (ξ : TensorProduct ℤ ↥(LinearMap.ker (TorExercise3A6.pres A)) QZ) :
    ∃ (N : ℕ) (_ : N ≠ 0) (k : ↥(LinearMap.ker (TorExercise3A6.pres A))),
      ξ = k ⊗ₜ[ℤ] qzInv N := by
  induction ξ using TensorProduct.inductionOn with
  | tmul k d =>
      obtain ⟨N, hN, m, hm⟩ := exists_smul_qzInv d
      refine ⟨N, hN, m • k, ?_⟩
      rw [hm, ← TensorProduct.smul_tmul]
  | add x y hx hy =>
      obtain ⟨N₁, hN₁, k₁, hk₁⟩ := hx
      obtain ⟨N₂, hN₂, k₂, hk₂⟩ := hy
      refine ⟨N₁ * N₂, Nat.mul_ne_zero hN₁ hN₂, ((N₂ : ℤ) • k₁ + (N₁ : ℤ) • k₂), ?_⟩
      rw [hk₁, hk₂, tmul_qzInv_mul hN₁ hN₂ k₁, tmul_qzInv_mul hN₂ hN₁ k₂,
        Nat.mul_comm N₂ N₁, TensorProduct.add_tmul]

/-- **The comparison map is surjective.** -/
theorem torsionToSyzKernel_surjective (A : Type) [AddCommGroup A] :
    Function.Surjective (torsionToSyzKernel A) := by
  classical
  rintro ⟨ξ, hξ⟩
  obtain ⟨N, hN, k, hk⟩ := exists_syzElem_tmul_eq A ξ
  have hzero : (k : A →₀ ℤ) ⊗ₜ[ℤ] qzInv N = 0 := by
    have h := LinearMap.mem_ker.mp hξ
    rw [hk, LinearMap.rTensor_tmul, Submodule.coe_subtype] at h
    exact h
  obtain ⟨f, hf⟩ := exists_eq_zsmul_of_dvd_apply (dvd_apply_of_tmul_eq_zero hN hzero)
  have hpres : (N : ℤ) • (TorExercise3A6.pres A f) = 0 := by
    rw [← map_zsmul, ← hf]
    exact k.2
  have hmem : (TorExercise3A6.pres A f) ∈ Submodule.torsion ℤ A := by
    rw [Submodule.mem_torsion_iff]
    exact ⟨⟨(N : ℤ), mem_nonZeroDivisors_iff_ne_zero.mpr (by exact_mod_cast hN)⟩, hpres⟩
  refine ⟨⟨TorExercise3A6.pres A f, hmem⟩, ?_⟩
  refine Subtype.ext ?_
  show syzClass A (TorExercise3A6.pres A f) (addOrderOf (TorExercise3A6.pres A f)) = ξ
  have hm0 : addOrderOf (TorExercise3A6.pres A f) ≠ 0 :=
    addOrderOf_ne_zero_of_mem_torsion hmem
  have hdiv : addOrderOf (TorExercise3A6.pres A f) ∣ N := by
    have h := addOrderOf_dvd_iff_zsmul_eq_zero.mpr hpres
    exact_mod_cast h
  obtain ⟨j, hj⟩ := hdiv
  have hj0 : j ≠ 0 := by
    rintro rfl
    rw [Nat.mul_zero] at hj
    exact hN hj
  rw [← syzClass_coherence hm0 hj0 (addOrderOf_zsmul_self _), ← hj, syzClass_of hpres hN,
    syzElem_tmul_congr hN hpres rfl, hk]
  congr 1
  exact Subtype.ext hf.symm

/-! ## Hatcher §3.A Exercise 2: the two statements -/

/-- **Hatcher, *Algebraic Topology* (2002), §3.A Exercise 2, printed p. 267, first statement.**
For every abelian group `A`, `Tor(A, ℚ/ℤ)` is isomorphic to the torsion subgroup of `A`.

The isomorphism is the connecting map of Hatcher's six-term sequence (Proposition 3A.5(6)) for
`0 → ℤ → ℚ → ℚ/ℤ → 0`, read at the presentation `0 → ker π → (A →₀ ℤ) → A → 0`: an element of
order `n` goes to `n • single a 1 ⊗ 1/n`, whose class in `ker π ⊗ ℚ/ℤ` is nonzero because the
cyclic subgroup it generates is pure in the syzygy (`syzClass_ne_zero`), and every class arises
this way because the coordinates of a vanishing class are divisible by its denominator
(`torsionToSyzKernel_surjective`). -/
noncomputable def torOneQzAddEquivTorsion (A : Type) [AddCommGroup A] :
    ↥(TorBridge.torOne (ModuleCat.of ℤ A) (ModuleCat.of ℤ QZ)) ≃+ ↥(Submodule.torsion ℤ A) := by
  letI : Module.Free ℤ (A →₀ ℤ) := Module.Free.of_basis (TorExercise3A6.presBasis A)
  exact (TorExercise3A6.torOneTorKernelAddEquiv (B := QZ) (TorExercise3A6.pres A)
      (TorExercise3A6.pres_surjective A)).trans
    (AddEquiv.ofBijective (torsionToSyzKernel A)
      ⟨torsionToSyzKernel_injective A, torsionToSyzKernel_surjective A⟩).symm

/-- **Hatcher, *Algebraic Topology* (2002), §3.A Exercise 2, printed p. 267, second statement.**
`A` is torsion-free if and only if `Tor(A, B) = 0` for every abelian group `B`.

Forward: a torsion-free group is flat (`TorReductions.flat_of_torsionFree`), so the syzygy
inclusion of the canonical presentation tensored with `B` is injective
(`CyclicTor.torKernel_eq_bot_of_flat_cokernel`), and `Tor(A, B)` is its kernel.  Backward: take
`B = ℚ/ℤ` and the first statement. -/
theorem isTorsionFree_iff_forall_subsingleton_torOne (A : Type) [AddCommGroup A] :
    Module.IsTorsionFree ℤ A ↔
      ∀ (B : Type) [AddCommGroup B],
        Subsingleton ↥(TorBridge.torOne (ModuleCat.of ℤ A) (ModuleCat.of ℤ B)) := by
  constructor
  · intro hTF B _
    haveI := hTF
    haveI : Module.Flat ℤ A := inferInstance
    letI : Module.Free ℤ (A →₀ ℤ) := Module.Free.of_basis (TorExercise3A6.presBasis A)
    have hiso : ((A →₀ ℤ) ⧸ LinearMap.ker (TorExercise3A6.pres A)) ≃ₗ[ℤ] A :=
      LinearMap.quotKerEquivOfSurjective (TorExercise3A6.pres A)
        (TorExercise3A6.pres_surjective A)
    haveI : Module.Flat ℤ ((A →₀ ℤ) ⧸ LinearMap.range
        ((LinearMap.ker (TorExercise3A6.pres A)).subtype)) := by
      rw [Submodule.range_subtype]
      exact Module.Flat.of_linearEquiv hiso
    have hbot : LinearMap.ker (((LinearMap.ker (TorExercise3A6.pres A)).subtype).rTensor B) = ⊥ :=
      LinearMap.ker_eq_bot.mpr (TorReductions.rTensor_injective_of_flat_cokernel (B := B)
        ((LinearMap.ker (TorExercise3A6.pres A)).subtype) (fun a b h => Subtype.ext h))
    haveI : Subsingleton ↥(LinearMap.ker (((LinearMap.ker
        (TorExercise3A6.pres A)).subtype).rTensor B)) := by
      rw [hbot]
      infer_instance
    refine ⟨fun u v => ?_⟩
    exact (TorExercise3A6.torOneTorKernelAddEquiv (B := B) (TorExercise3A6.pres A)
      (TorExercise3A6.pres_surjective A)).injective (Subsingleton.elim _ _)
  · intro h
    haveI hQZ : Subsingleton ↥(TorBridge.torOne (ModuleCat.of ℤ A) (ModuleCat.of ℤ QZ)) := h QZ
    rw [Submodule.isTorsionFree_iff_torsion_eq_bot, Submodule.eq_bot_iff]
    intro x hx
    have h := hQZ.elim ((torOneQzAddEquivTorsion A).symm ⟨x, hx⟩) 0
    have h2 : (⟨x, hx⟩ : ↥(Submodule.torsion ℤ A)) = 0 := by
      rw [← (torOneQzAddEquivTorsion A).apply_symm_apply ⟨x, hx⟩, h]
      exact (torOneQzAddEquivTorsion A).map_zero
    exact congrArg Subtype.val h2

end LeanCategories.Homological.TorExercise3A2
