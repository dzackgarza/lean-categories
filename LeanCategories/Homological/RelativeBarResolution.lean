module

public import LeanCategories.Homological.CotripleResolution
public import LeanCategories.Homological.NoncommutativeTensor
public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings
public import Mathlib.CategoryTheory.Monad.Adjunction
public import Mathlib.LinearAlgebra.TensorProduct.Tower

/-!
# The relative bar cotriple

Weibel, *An Introduction to Homological Algebra*, Construction 8.6.12,
pp. 278--285 (FC05-C08-U069).

For an arbitrary homomorphism of rings `f : k →+* R`, induction
`R ⊗ₖ -` is left adjoint to restriction of scalars. Mathlib's native
`ModuleCat.extendScalars` has commutative-ring hypotheses, so here induction is
realized by the same balanced-quotient model used in
`LeanCategories.Homological.NoncommutativeTensor`: start from `R ⊗_ℤ N` and
quotient by the `R`-span of `(r f(a)) ⊗ n - r ⊗ (a n)`.

The induced comonad on `R`-modules is Weibel's relative bar cotriple. Applying
the canonical cotriple construction in each degree gives the underlying degree,
face, degeneracy, and augmentation data of the relative bar resolution.

That these data assemble to an augmented simplicial object and that its
underlying restricted simplicial object is contractible/aspherical are
result-level assertions and are not included here.
-/

@[expose] public noncomputable section

open CategoryTheory
open scoped TensorProduct

namespace LeanCategories.Homological

universe u v w

variable {k : Type u} {R : Type v} [Ring k] [Ring R]

/-- The elementary balancing relations defining `R ⊗ₖ N`, written in the
integral tensor product so that no commutativity hypothesis is imposed on `k`
or `R`. -/
def relativeInductionRelationSet (f : k →+* R) (N : ModuleCat.{max w v} k) :
    Set (R ⊗[ℤ] N) :=
  {x | ∃ (r : R) (a : k) (n : N),
    x = (r * f a) ⊗ₜ[ℤ] n - r ⊗ₜ[ℤ] (a • n)}

/-- The `R`-submodule generated by the balancing relations for induction along
`f : k →+* R`. -/
def relativeInductionRelations (f : k →+* R) (N : ModuleCat.{max w v} k) :
    Submodule R (R ⊗[ℤ] N) :=
  Submodule.span R (relativeInductionRelationSet f N)

/-- The induced `R`-module `R ⊗ₖ N`, for arbitrary associative rings. -/
def relativeInductionModule (f : k →+* R) (N : ModuleCat.{max w v} k) :
    ModuleCat.{max w v} R :=
  ModuleCat.of R ((R ⊗[ℤ] N) ⨸ relativeInductionRelations f N)

/-- The `R`-linear map on integral tensor products induced by a `k`-linear map
in the second variable. -/
def relativeInductionUnderlyingMap (f : k →+* R)
    {N N' : ModuleCat.{max w v} k} (g : N ⟶ N') :
    R ⊗[ℤ] N →ₗ[R] R ⊗[ℤ] N' :=
  TensorProduct.AlgebraTensorModule.map
    (LinearMap.id : R →ₗ[R] R) g.hom.toAddMonoidHom.toIntLinearMap

/-- The map `R ⊗ₖ N → R ⊗ₖ N'` induced by a `k`-linear map
`N → N'`. -/
def relativeInductionMap (f : k →+* R)
    {N N' : ModuleCat.{max w v} k} (g : N ⟶ N') :
    relativeInductionModule f N ⟶ relativeInductionModule f N' :=
  ModuleCat.ofHom <|
    Submodule.mapQ (relativeInductionRelations f N) (relativeInductionRelations f N')
      (relativeInductionUnderlyingMap f g) <| by
        rw [relativeInductionRelations]
        apply Submodule.span_le.2
        intro x hx
        rcases hx with ⟨r, a, n, rfl⟩
        change relativeInductionUnderlyingMap f g
            ((r * f a) ⊗ₜ[ℤ] n - r ⊗ₜ[ℤ] (a • n)) ∈
          relativeInductionRelations f N'
        simp only [map_sub, relativeInductionUnderlyingMap,
          TensorProduct.AlgebraTensorModule.map_tmul, LinearMap.id_apply]
        rw [g.hom.map_smul]
        apply Submodule.subset_span
        exact ⟨r, a, g.hom n, rfl⟩

/-- Induction of modules along an arbitrary ring homomorphism. -/
def relativeInductionFunctor (f : k →+* R) :
    ModuleCat.{max w v} k ⥤ ModuleCat.{max w v} R where
  obj N := relativeInductionModule f N
  map g := relativeInductionMap f g
  map_id N := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction x using Submodule.Quotient.induction_on with
    | _ x =>
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul r n => rfl
        | add x y hx hy =>
            simpa only [Submodule.Quotient.mk_add, map_add] using congrArg₂ (· + ·) hx hy
  map_comp g h := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction x using Submodule.Quotient.induction_on with
    | _ x =>
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul r n => rfl
        | add x y hx hy =>
            simpa only [Submodule.Quotient.mk_add, map_add] using congrArg₂ (· + ·) hx hy

/-- The `R`-linear map on the unquotiented tensor product corresponding to a
`k`-linear map `N → U(M)`. -/
def relativeInductionTensorDesc (f : k →+* R)
    {N : ModuleCat.{max w v} k} {M : ModuleCat.{max w v} R}
    (g : N ⟶ (ModuleCat.restrictScalars.{max w v} f).obj M) :
    R ⊗[ℤ] N →ₗ[R] M :=
  TensorProduct.AlgebraTensorModule.lift
    { toFun := fun r =>
        { toFun := fun n => r • g.hom n
          map_add' := by
            intro x y
            rw [g.hom.map_add, smul_add]
          map_smul' := by
            intro z n
            change r • g.hom (z • n) = z • (r • g.hom n)
            simpa only [map_zsmul] using (smul_comm r z (g.hom n)) }
      map_add' := by
        intro r s
        ext n
        exact add_smul r s (g.hom n)
      map_smul' := by
        intro r s
        ext n
        exact mul_smul r s (g.hom n) }

/-- Descend the tensor formula `r ⊗ n ↦ r g(n)` through the balancing
relations. -/
def relativeInductionDesc (f : k →+* R)
    {N : ModuleCat.{max w v} k} {M : ModuleCat.{max w v} R}
    (g : N ⟶ (ModuleCat.restrictScalars.{max w v} f).obj M) :
    relativeInductionModule f N ⟶ M :=
  ModuleCat.ofHom <|
    (relativeInductionRelations f N).liftQ (relativeInductionTensorDesc f g) <| by
      rw [relativeInductionRelations]
      apply Submodule.span_le.2
      intro x hx
      rcases hx with ⟨r, a, n, rfl⟩
      rw [LinearMap.mem_ker]
      simp only [map_sub, relativeInductionTensorDesc,
        TensorProduct.AlgebraTensorModule.lift_tmul]
      change (r * f a) • g.hom n - r • g.hom (a • n) = 0
      rw [g.hom.map_smul]
      change (r * f a) • g.hom n - r • (f a • g.hom n) = 0
      rw [mul_smul, sub_self]

/-- Restrict an `R`-linear map `R ⊗ₖ N → M` to the copy of `N` given by
`n ↦ 1 ⊗ n`. -/
def relativeInductionRestrict (f : k →+* R)
    {N : ModuleCat.{max w v} k} {M : ModuleCat.{max w v} R}
    (h : relativeInductionModule f N ⟶ M) :
    N ⟶ (ModuleCat.restrictScalars.{max w v} f).obj M :=
  ModuleCat.ofHom
    { toFun := fun n => h.hom (Submodule.Quotient.mk ((1 : R) ⊗ₜ[ℤ] n))
      map_add' := by
        intro x y
        simp only [TensorProduct.tmul_add, Submodule.Quotient.mk_add, map_add]
      map_smul' := by
        intro a n
        change h.hom (Submodule.Quotient.mk ((1 : R) ⊗ₜ[ℤ] (a • n))) =
          f a • h.hom (Submodule.Quotient.mk ((1 : R) ⊗ₜ[ℤ] n))
        rw [← h.hom.map_smul]
        apply congrArg h.hom
        rw [← Submodule.Quotient.mk_smul]
        apply (Submodule.Quotient.eq _).2
        have hrel :
            (1 * f a) ⊗ₜ[ℤ] n - (1 : R) ⊗ₜ[ℤ] (a • n) ∈
              relativeInductionRelations f N :=
          Submodule.subset_span ⟨1, a, n, rfl⟩
        simpa [TensorProduct.smul_tmul', smul_eq_mul, one_mul, mul_one] using
          (relativeInductionRelations f N).neg_mem hrel }

/-- The tensor-Hom equivalence for induction and restriction of scalars over
arbitrary associative rings. -/
def relativeInductionHomEquiv (f : k →+* R)
    (N : ModuleCat.{max w v} k) (M : ModuleCat.{max w v} R) :
    (relativeInductionModule f N ⟶ M) ≃
      (N ⟶ (ModuleCat.restrictScalars.{max w v} f).obj M) where
  toFun := relativeInductionRestrict f
  invFun := relativeInductionDesc f
  left_inv h := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    induction x using Submodule.Quotient.induction_on with
    | _ x =>
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul r n =>
            change r • h.hom (Submodule.Quotient.mk ((1 : R) ⊗ₜ[ℤ] n)) =
              h.hom (Submodule.Quotient.mk (r ⊗ₜ[ℤ] n))
            rw [← h.hom.map_smul]
            apply congrArg h.hom
            rw [← Submodule.Quotient.mk_smul]
            apply congrArg Submodule.Quotient.mk
            simp [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        | add x y hx hy =>
            simpa only [Submodule.Quotient.mk_add, map_add] using congrArg₂ (· + ·) hx hy
  right_inv g := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro n
    change (1 : R) • g.hom n = g.hom n
    rw [one_smul]

/-- The induction-restriction adjunction for an arbitrary ring homomorphism
`f : k →+* R`. -/
noncomputable def relativeBarAdjunction (f : k →+* R) :
    relativeInductionFunctor f ⊣ ModuleCat.restrictScalars.{max w v} f :=
  Adjunction.mkOfHomEquiv
    { homEquiv := fun N M => relativeInductionHomEquiv f N M
      homEquiv_naturality_left_symm := by
        intro N' N M g h
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro x
        induction x using Submodule.Quotient.induction_on with
        | _ x =>
            induction x using TensorProduct.induction_on with
            | zero => simp
            | tmul r n => rfl
            | add x y hx hy =>
                simpa only [Submodule.Quotient.mk_add, map_add] using congrArg₂ (· + ·) hx hy
      homEquiv_naturality_right := by
        intro N M M' g h
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro n
        rfl }

/-- The comonad on `R`-modules induced by induction/restriction of scalars
along `f : k →+* R`. This is Weibel's relative bar cotriple.

Source: Weibel, Construction 8.6.12 (FC05-C08-U069). -/
noncomputable def relativeBarComonad (f : k →+* R) :
    Comonad (ModuleCat.{max w v} R) :=
  (relativeBarAdjunction f).toComonad

/-- Degree `n` of the canonical relative bar construction on an `R`-module
`M`, namely the `(n+1)`-fold iterate of the bar cotriple. -/
abbrev relativeBarDegree (f : k →+* R) (M : ModuleCat.{max w v} R) (n : ℕ) :
    ModuleCat.{max w v} R :=
  (relativeBarComonad f).simplicialDegree M n

/-- The `i`th face of the canonical relative bar construction. -/
def relativeBarFace (f : k →+* R) (M : ModuleCat.{max w v} R)
    (n : ℕ) (i : Fin (n + 1)) :
    relativeBarDegree f M n ⟶
      (relativeBarComonad f).iterObj M n :=
  (relativeBarComonad f).face M n i

/-- The `i`th degeneracy of the canonical relative bar construction. -/
def relativeBarDegeneracy (f : k →+* R) (M : ModuleCat.{max w v} R)
    (n : ℕ) (i : Fin (n + 1)) :
    relativeBarDegree f M n ⟶
      (relativeBarComonad f).iterObj M (n + 2) :=
  (relativeBarComonad f).degeneracy M n i

/-- The canonical augmentation from bar degree zero to `M`. -/
def relativeBarAugmentation (f : k →+* R) (M : ModuleCat.{max w v} R) :
    relativeBarDegree f M 0 ⟶ M :=
  (relativeBarComonad f).augmentation M

end LeanCategories.Homological
