module

public import LeanCategories.Homological.HochschildComplex

/-!
# The I-adic filtration of the cyclic module of an algebra

Weibel, *An Introduction to Homological Algebra* (1994), §9.9,
pp. 358--359 (FC05-C09-U146).

For `Z_p(R)=R^{⊗(p+1)}`, Weibel lets `F_p^i` be generated by tensor products

`I^{i₀} ⊗ ⋯ ⊗ I^{iₚ}`, with `i₀+⋯+iₚ=i`.

The structure maps of the cyclic module preserve these submodules, producing
a decreasing filtration by cyclic submodules; moreover `F_*^1=Z(R,I)`.
This file records the generators exactly and packages those preservation and
kernel-identification clauses.  Nilpotent-invariance consequences are later
result-level units.
-/

@[expose] public noncomputable section

namespace LeanCategories.Homological

open CategoryTheory Opposite Simplicial
open scoped TensorProduct

universe u v

variable (k : Type u) [CommRing k]
variable (R : Type v) [Ring R] [Algebra k R]
variable (I : Ideal R) [I.IsTwoSided]

/-- A pure tensor generator of `F_p^i`: each factor is supplied together with
an exponent `i_j` and a proof that it lies in `I^{i_j}`, while the exponents
sum to `i`. -/
structure IAdicHochschildGenerator (p i : ℕ) where
  /-- The exponent attached to each of the `p+1` tensor factors. -/
  exponent : Fin (p + 1) → ℕ
  /-- The exponents have total `i`. -/
  exponent_sum : ∑ j, exponent j = i
  /-- The tensor factors. -/
  factor : Fin (p + 1) → R
  /-- The `j`th factor lies in `I^(i_j)`. -/
  factor_mem : ∀ j, factor j ∈ I ^ exponent j

/-- The pure Hochschild tensor represented by an `I`-adic generator. -/
def iAdicHochschildPure {p i : ℕ}
    (g : IAdicHochschildGenerator R I p i) :
    HochschildChainDegree (k := k) (R := R) (M := R) p :=
  hochschildChainPure (k := k) (R := R) (M := R)
    (g.factor 0) (fun j => g.factor j.succ)

/-- Weibel's degree-`p`, filtration-`i` submodule `F_p^i`. -/
def iAdicHochschildFiltration (p i : ℕ) :
    Submodule k (HochschildChainDegree (k := k) (R := R) (M := R) p) :=
  Submodule.span k
    (Set.range (iAdicHochschildPure (k := k) (R := R) (I := I) (p := p) (i := i)))

end LeanCategories.Homological
